{"tool_name":"bioconductor-celltrails","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-celltrails","identifiers":["doi:10.18129/b9.bioc.celltrails"],"license":"Artistic-2.0","summary":"Reconstruction, visualization and analysis of branching trajectories","home_url":"https://bioconductor.org/packages/3.11/bioc/html/CellTrails.html","keywords":["Clustering"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-celltrails","home":"https://bioconductor.org/packages/CellTrails","license":"Artistic-2.0","summary":"CellTrails is an unsupervised algorithm for the de novo chronological ordering, visualization and analysis of single-cell expression data. CellTrails makes use of a geometrically motivated concept of lower-dimensional manifold learning, which exhibits a multitude of virtues that counteract intrinsic noise of single cell data caused by drop-outs, technical variance, and redundancy of predictive variables. CellTrails enables the reconstruction of branching trajectories and provides an intuitive graphical representation of expression patterns along all branches simultaneously. It allows the user to define and infer the expression dynamics of individual and multiple pathways towards distinct phenotypes.","tool_type":["Command-line tool","Library"],"version":["1.30.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-celltrails","credit":[{"name":"Daniel Ellwanger","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/CellTrails"}],"name":"CellTrails","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1016/j.celrep.2018.05.002"}]},"bioschemas":{"name":"CellTrails","home":"https://bio.tools/bioconductor-celltrails","license":"Artistic-2.0","version":"1.30.0","summary":"CellTrails is an unsupervised algorithm for the de novo 