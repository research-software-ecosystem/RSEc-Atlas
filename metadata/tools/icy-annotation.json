{"tool_name":"icy-annotation","contents":["neubias"],"fetched_metadata":{"neubias":{"body":[{"format":"markdown","processed":"","summary":"","value":"This plugin (Icy Tool) allows the user to create and edit annotations. Annotations are blocks of text that the user can put anywhere in the sequence. Run the plugin to get the GUI with all the features. Once a note is added to a sequence, left click on it to edit this one. If you closed your GUI and you have some notes on your sequence, right click and select \"edit\" to display the GUI.\r\n\r\nAs of now, the annotations are saved when the sequence is closed, but you have to run the plugin at least once to be able to see all the annotations in the image."}],"changed":[{"format":"Y-m-d\\TH:i:sP","value":"2020-03-02T13:51:37+00:00"}],"created":[{"format":"Y-m-d\\TH:i:sP","value":"2013-10-11T13:08:40+00:00"}],"default_langcode":[{"value":true}],"attribution_instructions":[],"comments_2023":[],"free_tagging":[{"target_id":4917,"target_type":"taxonomy_term","target_uuid":"2055a300-5fe8-4994-a044-c219f5f2af7c","url":"/taxonomy/term/4917"},{"target_id":4918,"target_type":"taxonomy_term","target_uuid":"cdc56ce2-c1f6-40ee-ae22-4c53f0716507","url":"/taxonomy/term/4918"},{"target_id":4919,"target_type":"taxonomy_term","target_uuid":"a819b539-12ca-4289-a056-1daf71395473","url":"/taxonomy/term/4919"},{"target_id":4920,"target_type":"taxonomy_term","target_uuid":"d27ef7b5-f61f-4d2d-b2d1-1fe13d34677d","url":"/taxonomy/term/4920"},{"target_id":4921,"target_type":"taxonomy_term","target_uuid":"e4e88b37-d745-4918-8dd7-7afa1b1dd713","url":"/taxonomy/term/4921"},{"target_id":4922,"target_type":"taxonomy_term","target_uuid":"9e7de144-b8ad-4519-a660-b727a329abc3","url":"/taxonomy/term/4922"}],"give_feedback_on_this_soft":[{"cid":0,"comment_count":0,"last_comment_name":null,"last_comment_timestamp":1505205829,"last_comment_uid":164,"status":2}],"has_author":[{"value":"Thomas Provoost"},{"value":"St\u00e9phane Dallongeville"}],"has_biological