{"tool_name":"krepp","contents":["biotools"],"identifiers":["biotools:krepp"],"fetched_metadata":{"biotools":{"id":"krepp","home":"https://registry.opendata.aws/kreppref/","summary":"krepp is an alignment-free, k-mer-based method for performing distance calculation and genome-wide phylogenetic placement of reads against large reference genome sets. It enables analyzing reads from anywhere on the genome, not just marker genes.","addition_date":"2026-11-04T10:31:12.078422Z","last_update_date":"2026-11-04T10:31:12.080336Z","biotools_curie":"biotools:krepp","credit":[{"email":"smirarabbaygi@ucsd.edu","name":"Siavash Mirarab","typeEntity":"Person"}],"documentation":[{"type":["User manual"],"url":"https://github.com/bo1929/krepp/wiki/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"De-novo assembly","uri":"http://edamontology.org/operation_0524"},{"term":"Expression analysis","uri":"http://edamontology.org/operation_2495"},{"term":"Genome indexing","uri":"http://edamontology.org/operation_3211"},{"term":"Phylogenetic reconstruction","uri":"http://edamontology.org/operation_3478"},{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"}]}],"name":"krepp","owner":"pub2tools2024","publication":[{"doi":"10.1186/S13059-026-03999-Y","pmcid":"PMC13032499","pmid":"41723514"}],"topic":[{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Microbial ecology","uri":"http://edamontology.org/topic_3697"},{"term":"Phylogenetics","uri":"http://edamontology.org/topic_3293"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}]}}}