{"tool_name":"detonate","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"detonate","identifiers":["biotools:detonate","doi:10.1186/s13059-014-0553-5"],"license":"GPL","summary":"Detonate (de novo transcriptome rna-seq assembly with or without the truth evaluation) consists of two component packages, rsem-eval and ref-eval.","home_url":"https://github.com/deweylab/detonate","keywords":["Animals","Computational Biology","Computer Simulation","Gene Expression Profiling","Sequence Analysis, RNA","Transcriptome","RNA","Assembly","RNA-seq","Sequences","RNA-Seq"],"manually_check":true,"total_pulls":0},"biotools":{"id":"detonate","home":"http://deweylab.biostat.wisc.edu/detonate/","summary":"DETONATE consists of two component packages, RSEM-EVAL and REF-EVAL. Both packages are mainly intended to be used to evaluate de novo transcriptome assemblies, although REF-EVAL can be used to compare sets of any kinds of genomic sequences.","addition_date":"2017-12-18T00:05:32Z","last_update_date":"2021-04-17T18:42:16Z","tool_type":["Command-line tool"],"version":["1.10"],"biotools_curie":"biotools:detonate","credit":[{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.biostat.wisc.edu/~cdewey/"}],"documentation":[{"type":["General"],"url":"http://deweylab.biostat.wisc.edu/detonate/ref-eval.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Sequence assembly","uri":"http://edamontology.org/operation_0310"}]}],"name":"DETONATE","operating_system":["Linux"],"owner":"mbs_import","publication":[{"doi":"10.1186/s13059-014-0553-5","metadata":{"abstract":"\u00a9 Li et al.De novo RNA-Seq assembly facilitates the study of transcriptomes for species without sequenced genomes, but it is challenging to select the most accurate assembly in this context. To address this challenge, we developed a model-based score, RSEM-EVAL, for evaluating assemblies when the ground truth is unknown. We show that RSEM-EVAL correctly reflects assembly accuracy, as measured by REF-EVAL, a refined set of ground-truth-based scores that we also developed. Guided by RSEM-EVAL, we assembled the transcriptome of the regenerating axolotl limb; this assembly compares favorably to a previous assembly. A software package implementing our methods, DETONATE, is freely available at http://deweylab.biostat.wisc.edu/detonate.","authors":[{"name":"Bai Y."},{"name":"Collins M."},{"name":"Dewey C.N."},{"name":"Fillmore N."},{"name":"Li B."},{"name":"Stewart R."},{"name":"Thomson J.A."}],"citationCount":142,"date":"2014-12-21T00:00:00Z","journal":"Genome Biology","title":"Evaluation of de novo transcriptome assemblies from RNA-Seq data"},"type":["Primary"]}],"topic":[{"term":"Assembly","uri":"http://edamontology.org/topic_0196"},{"term":"RNA","uri":"http://edamontology.org/topic_0099"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Sequences","uri":"http://edamontology.org/topic_0080"},{"term":"Transcriptome","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"DETONATE","home":"https://bio.tools/detonate","version":"1.10","summary":"DETONATE consists of two component packages, RSEM-EVAL and REF-EVAL. Both packages are mainly intended to be used to evaluate de novo transcriptome assemblies, although REF-EVAL can be used to compare sets of any kinds of genomic sequences.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:detonate:1.10/cmd/deweylab.biostat.wisc.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":139,"citations":[{"count":1,"year":"2014"},{"count":2,"year":"2025"},{"count":3,"year":"2026"},{"count":4,"year":"2023"},{"count":7,"yea