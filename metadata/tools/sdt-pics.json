{"tool_name":"sdt-pics","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"sdt-pics","home":"https://github.com/wimthiels/SDT-PICS","license":"Not licensed","summary":"Cell Tracking and Shape Retrieval in Membrane-labeled Embryos.","addition_date":"2021-11-20T18:24:41.951993Z","last_update_date":"2024-11-24T20:16:15.226453Z","tool_type":["Library"],"accessibility":"Open access","biotools_curie":"biotools:sdt-pics","cost":"Free of charge","credit":[{"email":"rob.jelier@kuleuven.com","name":"Rob Jelier","orcidid":"https://orcid.org/0000-0002-6395-1407","typeEntity":"Person"},{"email":"wim.thiels@kuleuven.com","name":"Wim Thiels","orcidid":"https://orcid.org/0000-0003-3183-6209","typeEntity":"Person"},{"name":"Bart Smeets","orcidid":"https://orcid.org/0000-0001-8753-781X"},{"name":"Francesca Caroti","orcidid":"https://orcid.org/0000-0003-4049-2663"},{"name":"Maxim Cuvelier","orcidid":"https://orcid.org/0000-0003-1534-4247"}],"documentation":[{"type":["User manual"],"url":"https://github.com/wimthiels/SDT-PICS/blob/main/user_manual_SDT-PICS.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Data retrieval","uri":"http://edamontology.org/operation_2422"},{"term":"Molecular dynamics","uri":"http://edamontology.org/operation_2476"}]}],"name":"SDT-PICS","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1093/bioinformatics/btab557","metadata":{"abstract":"Motivation: Uncovering the cellular and mechanical processes that drive embryo formation requires an accurate read out of cell geometries over time. However, automated extraction of 3D cell shapes from time-lapse microscopy remains challenging, especially when only membranes are labeled. Results: We present an image analysis framework for automated tracking and three-dimensional cell segmentation in confocal time lapses. A sphere clustering approach allows for local thresholding and application of logical rules to facilitate tracking and unseeded segmentation of variable cell shapes. Next, the segmentation is refined by a discrete element method simulation where cell shapes are constrained by a biomechanical cell shape model. We apply the framework on Caenorhabditis elegans embryos in various stages of early development and analyze the geometry of the 7- and 8-cell stage embryo, looking at volume, contact area and shape over time.","authors":[{"name":"Caroti F."},{"name":"Cuvelier M."},{"name":"Jelier R."},{"name":"Smeets B."},{"name":"Thiels W."}],"citationCount":8,"date":"2021-12-15T00:00:00Z","journal":"Bioinformatics","title":"SpheresDT/Mpacts-PiCS: Cell tracking and shape retrieval in membrane-labeled embryos"},"pmcid":"PMC8665764","pmid":"34329378"}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Molecular dynamics","uri":"http://edamontology.org/topic_0176"}],"validated":1},"bioschemas":{"name":"SDT-PICS","home":"https://bio.tools/sdt-pics","license":"Not licensed","summary":"Cell Tracking and Shape Retrieval in Membrane-labeled Embryos.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:sdt-pics/lib/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":13,"citations":[{"count":1,"year":"2021"},{"count":1,"year":"2022"},{"count":1,"year":"2026"},{"count":2,"year":"2025"},{"count":3,"year":"2023"},{"count":5,"year":"2024"}],"doi":"10.1093/bioinformatics/btab557"