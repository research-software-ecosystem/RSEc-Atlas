{"tool_name":"wincoot","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"wincoot","home":"http://www.ysbl.york.ac.uk/~lohkamp/coot/wincoot.html","summary":"Windows version of Coot (Crystallographic Object)-Oriented Toolkit.","addition_date":"2015-02-16T10:06:15Z","last_update_date":"2024-11-25T16:02:30.293709Z","tool_type":["Workbench"],"version":["1"],"collections":["Instruct"],"biotools_curie":"biotools:wincoot","cost":"Free of charge","credit":[{"email":"ccisb@stfc.ac.uk","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"Instruct","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["General"],"url":"http://www.ysbl.york.ac.uk/~lohkamp/coot/wincoot.html"}],"edit_permission":{"authors":["ELIXIR-EE"],"type":"group"},"function":[{"note":"For macromolecular model building, model completion and validation, particularly suitable for protein modelling using X-ray data. Coot displays maps and models and allows model manipulations such as idealization, real space refinement, manual rotation/translation, rigid-body fitting, ligand search, solvation, mutations, rotamers, Ramachandran plots, skeletonization, non-crystallographic symmetry and more.Interactive model (re)building with numerous tools. Internal validation tools as well as interaction with Molprobity. Download of PDB files and electron density maps.","operation":[{"term":"3D profile generation","uri":"http://edamontology.org/operation_0297"},{"term":"Protein modelling","uri":"http://edamontology.org/operation_0477"},{"term":"Structure visualisation","uri":"http://edamontology.org/operation_0570"},{"term":"Validation","uri":"http://edamontology.org/operation_2428"}]}],"name":"WinCoot","operating_system":["Windows"],"owner":"EMD","publication":[{"doi":"10.1107/s0907444904019158","pmid":"15572765","type":["Primary"]}],"topic":[{"term":"Structural biology","uri":"http://edamontology.org/topic_1317"},{"term":"X-ray diffraction","uri":"http://edamontolo