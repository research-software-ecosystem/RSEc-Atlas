{"tool_name":"gene-tidy","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"gene-tidy","home":"https://github.com/MargoSolo/gene-tidy","license":"MIT","summary":"Offline tool for cleaning tables of human gene and protein identifiers (TXT, CSV, TSV, XLSX). It maps approved symbols, aliases, previous symbols, Ensembl gene, UniProt, Entrez, RefSeq and HGNC identifiers to current HGNC approved symbols with cross-references, using a bundled HGNC snapshot. Excel date-corrupted symbols are recovered where the original is unambiguous and flagged for manual review otherwise; no input row is dropped. Each run records the tool version and HGNC release and writes a per-row audit table.","addition_date":"2026-09-15T18:47:53.732540Z","last_update_date":"2026-09-15T18:51:45.950473Z","tool_type":["Command-line tool","Library"],"version":["0.2.0"],"accessibility":"Open access","biotools_curie":"biotools:gene-tidy","cost":"Free of charge","credit":[{"name":"Margarita Soloshenko","orcidid":"https://orcid.org/0000-0002-6150-0880","typeRole":["Developer","Primary contact"]}],"documentation":[{"type":["Citation instructions"],"url":"https://github.com/MargoSolo/gene-tidy/blob/main/CITATION.cff"},{"type":["General"],"url":"https://github.com/MargoSolo/gene-tidy#readme"}],"edit_permission":{"type":"private"},"function":[{"cmd":"gene-tidy genes.csv --out outputs/","input":[{"data":{"term":"Gene identifier","uri":"http://edamontology.org/data_1025"},"format":[{"term":"CSV","uri":"http://edamontology.org/format_3752"},{"term":"TSV","uri":"http://edamontology.org/format_3475"},{"term":"xlsx","uri":"http://edamontology.org/format_3620"}]}],"note":"Map a table of mixed human gene identifiers to current HGNC approved symbols; ambiguous and unmatched rows are written to separate files.","operation":[{"term":"ID mapping","uri":"http://edamontology.org/operation_3282"}],"output":[{"data":{"term":"Gene identifier","uri":"http://edamontology.org/data_1025"},"format":[{"term":"CSV","uri":"http://edamontology.org/format_3752"},{"term":"xlsx","uri":"http://edamontology.org/format_3620"}]}]}],"maturity":"Emerging","name":"gene-tidy","operating_system":["Linux","Mac","Windows"],"owner":"margarita","publication":[{"doi":"10.5281/zenodo.22285392","type":["Primary"]}],"topic":[{"term":"Data management","uri":"http://edamontology.org/topic_3071"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:gene-tidy:0.2.0/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","project":{"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.5281/zenodo.22285392","pmcid":null,"pmid":null,"ref_count":0,"refs":[],"title":null,"year":null}]}]}},{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:gene-tidy:0.2.0/lib/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","project":{"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.5281/zenodo.22285392","pmcid":null,"pmid":null,"ref_count":0,"refs":[],"title":null,"year":null}]}]}}]}}}