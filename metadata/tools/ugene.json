{"tool_name":"ugene","contents":["oeb","bioschemas","debian","biotools"],"fetched_metadata":{"biotools":{"id":"ugene","home":"http://ugene.unipro.ru","license":"GPL-3.0","summary":"UGENE is a free cross-platform genome analysis suite that combines popular bioinformatics tools within a single user friendly interface.","addition_date":"2017-01-13T13:16:55Z","last_update_date":"2024-11-24T15:18:27.470046Z","tool_type":["Desktop application"],"collections":["JIB.tools"],"biotools_curie":"biotools:ugene","credit":[{"email":"ugene@unipro.ru","name":"UGENE Tech Support","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://ugene.net/documentation.html"}],"edit_permission":{"authors":["alexcorm","bjsommer"],"type":"group"},"function":[{"operation":[{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"maturity":"Mature","name":"UGENE","operating_system":["Linux","Mac","Windows"],"owner":"seqwiki_import","publication":[{"doi":"10.7717/peerj.644","metadata":{"abstract":"The advent of Next Generation Sequencing (NGS) technologies has opened new possibilities for researchers. However, the more biology becomes a data-intensive field, the more biologists have to learn how to process and analyze NGS data with complex computational tools. Even with the availability of common pipeline specifications, it is often a time-consuming and cumbersome task for a bench scientist to install and configure the pipeline tools. We believe that a unified, desktop and biologist-friendly front end to NGS data analysis tools will substantially improve productivity in this field. Here we present NGS pipelines \"Variant Calling with SAMtools\", \"Tuxedo Pipeline for RNA-seq Data Analysis\" and \"Cistrome Pipeline for ChIP-seq Data Analysis\" integrated into the Unipro UGENE desktop toolkit. We describe the available UGENE infrastructure that helps researchers run these pipelines on different datasets, store and investigate the results and re-run the pipelines with the same parameters. These pipeline tools are included in the UGENE NGS package. Individual blocks of these pipelines are also available for expert users to create their own advanced workflows.","authors":[{"name":"Fursov M."},{"name":"Gabrielian A."},{"name":"Golosova O."},{"name":"Grekhov G."},{"name":"Henderson R."},{"name":"Hurt D."},{"name":"Huyen Y."},{"name":"Nagarajan V."},{"name":"Oler A.J."},{"name":"Quinones M."},{"name":"Vaskin Y."}],"citationCount":76,"date":"2014-01-01T00:00:00Z","journal":"PeerJ","title":"Unipro UGENE NGS pipelines and components for variant calling, RNA-seq and ChIP-seq data analyses"},"pmcid":"PMC4226638","pmid":"25392756","type":["Primary"]}],"topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Phylogenetics","uri":"http://edamontology.org/topic_3293"},{"term":"Protein structure analysis","uri":"http://edamontology.org/topic_2814"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"bioschemas":{"name":"UGENE","home":"https://bio.tools/ugene","license":"GPL-3.0","summary":"UGENE is a free cross-platform genome analysis suite that combines popular bioinformatics tools within a single user friendly interface.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ugene/app/ugene.unipro.ru","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":60,"citations":[{"count":2,"year":"2015"},{"count":3,"year":"2016"},{"count":3,"year":"2017"},{"count":3,"year":"2018"},{"count":3,"year":"2020"},{"count":4,"year":"2022"},{"count":4,"year":"2024"},{"count":6,"year":"2026"},{"count":7,"year":"2023"},{"count":8,"year":"2021"},{