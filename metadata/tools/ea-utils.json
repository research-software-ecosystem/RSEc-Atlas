"function":[{"operation":[{"term":"Sequence merging","uri":"http://edamontology.org/operation_0232"},{"term":"Sequence trimming","uri":"http://edamontology.org/operation_3192"},{"term":"Sequencing quality control","uri":"http://edamontology.org/operation_3218"}]}],"maturity":"Mature","name":"Ea-utils","owner":"seqwiki_import","publication":[{"doi":"10.2174/1875036201307010001","metadata":{"abstract":"High throughput sequencing (HTS) has resulted in extreme growth rates of sequencing data. At our lab, we generate terabytes of data every day. It is usually seen as required for data output to be \"cleaned\" and processed in various ways prior to use for common tasks such as variant calling, expression quantification and assembly. Two common tasks associated with HTS are adapter trimming and paired-end joining. I have developed two tools at Expression Analysis, Inc. to address these common tasks. The names of these programs are fastq-mcf and fastq-join. I compared the performance of these tools to similar open-source utilities, both in terms of resource efficiency, and effectiveness. \u00a9 Erik Aronesty.","authors":[{"name":"Aronesty E."}],"citationCount":621,"date":"2013-03-22T00:00:00Z","journal":"Open Bioinformatics Journal","title":"Comparison of sequencing utility programs"},"type":["Other"]}],"topic":[{"term":"Data management","uri":"http://edamontology.org/topic_3071"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"bioschemas":{"name":"Ea-utils","home":"https://bio.tools/ea-utils","license":"MIT","summary":"FASTQ processing utilities","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ea-utils/cmd/expressionanalysis.github.io","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration