{"tool_name":"cant-hyd","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"cant-hyd","home":"https://github.com/dgittins/CANT-HYD-HydrocarbonBiodegradation","license":"GPL-3.0","summary":"Calgary approach to ANnoTating HYDrocarbon degradation genes (CANT-HYD), a database of 37 HMMs of marker genes involved in anaerobic and aerobic degradation pathways of aliphatic and aromatic hydrocarbons.","addition_date":"2022-06-09T08:49:18.043271Z","last_update_date":"2022-06-09T08:49:18.045798Z","tool_type":["Database portal"],"accessibility":"Open access","biotools_curie":"biotools:cant-hyd","cost":"Free of charge","credit":[{"email":"sbhatnagar@athabascau.ca","name":"Srijak Bhatnagar","typeEntity":"Person"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Genome annotation","uri":"http://edamontology.org/operation_0362"},{"term":"Pathway analysis","uri":"http://edamontology.org/operation_3928"},{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"}]}],"name":"CANT-HYD","operating_system":["Linux","Mac","Windows"],"owner":"Chan019","publication":[{"doi":"10.3389/FMICB.2021.764058","metadata":{"abstract":"Copyright \u00a9 2022 Khot, Zorz, Gittins, Chakraborty, Bell, Bautista, Paquette, Hawley, Novotnik, Hubert, Strous and Bhatnagar.Many pathways for hydrocarbon degradation have been discovered, yet there are no dedicated tools to identify and predict the hydrocarbon degradation potential of microbial genomes and metagenomes. Here we present the Calgary approach to ANnoTating HYDrocarbon degradation genes (CANT-HYD), a database of 37 HMMs of marker genes involved in anaerobic and aerobic degradation pathways of aliphatic and aromatic hydrocarbons. Using this database, we identify understudied or overlooked hydrocarbon degradation potential in many phyla. We also demonstrate its application in analyzing high-throughput sequence data by predicting hydrocarbon utilization in large metagenomic datasets from diverse environments. CANT-HYD is available at https://github.com/dgittins/CANT-HYD-HydrocarbonBiodegradation.","authors":[{"name":"Bautista M.A."},{"name":"Bell E."},{"name":"Bhatnagar S."},{"name":"Chakraborty A."},{"name":"Gittins D.A."},{"name":"Hawley A.K."},{"name":"Hubert C.R.J."},{"name":"Khot V."},{"name":"Novotnik B."},{"name":"Paquette A.J."},{"name":"Strous M."},{"name":"Zorz J."}],"citationCount":1,"date":"2022-01-07T00:00:00Z","journal":"Frontiers in Microbiology","title":"CANT-HYD: A Curated Database of Phylogeny-Derived Hidden Markov Models for Annotation of Marker Genes Involved in Hydrocarbon Degradation"},"pmcid":"PMC8767102","pmid":"35069469"}],"topic":[{"term":"Data submission, annotation and curation","uri":"http://edamontology.org/topic_0219"},{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Sequence sites, features and motifs","uri":"http://edamontology.org/topic_0160"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"bioschemas":{"name":"CANT-HYD","home":"https://bio.tools/cant-hyd","license":"GPL-3.0","summary":"Calgary approach to ANnoTating HYDrocarbon degradation genes (CANT-HYD), a database of 37 HMMs of marker genes involved in anaerobic and aerobic degradation pathways of aliphatic and aromatic hydrocarbons.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:cant-hyd/db/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publ