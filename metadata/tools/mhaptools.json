{"tool_name":"mhaptools","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"mhaptools","home":"https://jiantaoshi.github.io/mHap/index.html","license":"MIT","summary":"A simple DNA methylation haplotype format for storing DNA methylation BS-seq data. It reduces the size of a BAM file by 40 to 140-fold while keeps all read-level CpG methylation information. It\u2019s also compatible with the Tabix tool for fast and random access. We implemented a command-line tool mHapTools for converting BAM/SAM files from existing platforms to mHap files as well as postprocessing DNA methylation in mHap format. With this tool, we pro-cessed all publicly available human reduced representation bisulfite sequencing (RRBS) data and provided as a comprehensive mHap database.","addition_date":"2021-11-06T18:23:10.278896Z","last_update_date":"2021-11-06T18:23:10.281584Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:mhaptools","cost":"Free of charge","credit":[{"email":"xqzheng@shnu.edu.cn","name":"Jiantao Shi","orcidid":"https://orcid.org/0000-0002-0039-8800","typeEntity":"Person"},{"email":"jtshi@sibcb.ac.cn","name":"Xiaoqi Zheng","typeEntity":"Person"},{"name":"Jiarui Zhang"},{"name":"Yaochen Xu"},{"name":"Yuhao Dan"},{"name":"Zhiqiang Zhang"}],"documentation":[{"type":["User manual"],"url":"https://jiantaoshi.github.io/mHap/Manual.html"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"DNA sequence","uri":"http://edamontology.org/data_3494"},"format":[{"term":"BAM","uri":"http://edamontology.org/format_2572"},{"term":"SAM","uri":"http://edamontology.org/format_2573"}]}],"operation":[{"term":"DNA profiling","uri":"http://edamontology.org/operation_3894"},{"term":"Formatting","uri":"http://edamontology.org/operation_0335"},{"term":"Gene methylation analysis","uri":"http://edamontology.org/operation_3207"}]}],"name":"mHapTools","operating_system":["Linux"],"owner":"Jennifer","publicatio