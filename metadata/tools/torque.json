{"tool_name":"torque","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"torque","home":"http://www.cs.tau.ac.il/~bnet/torque.html","summary":"Web server for querying of protein-protein interaction networks or pathways across species. Networks of up to 25 proteins may be input.","addition_date":"2017-03-24T14:34:15Z","last_update_date":"2018-12-10T12:58:54Z","tool_type":["Web application"],"biotools_curie":"biotools:torque","credit":[{"name":"Sharon Bruckner","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://page.mi.fu-berlin.de/sharonb/"}],"documentation":[{"type":["General"],"url":"http://www.cs.tau.ac.il/%7Ebnet/TORQUE_Input_format.htm"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Pathway or network comparison","uri":"http://edamontology.org/operation_0277"},{"term":"Pathway or network prediction","uri":"http://edamontology.org/operation_3439"},{"term":"Pathway or network visualisation","uri":"http://edamontology.org/operation_3083"},{"term":"Protein interaction network analysis","uri":"http://edamontology.org/operation_0276"},{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"}]}],"name":"Torque","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"metadata":{"abstract":"Torque is a tool for cross-species querying of protein-protein interaction networks. It aims to answer the following question: given a set of proteins constituting a known complex or a pathway in one species, can a similar complex or pathway be found in the protein network of another species? To this end, Torque seeks a matching set of proteins that are sequence similar to the query proteins and span a connected region of the target network, while allowing for both insertions and deletions. Unlike existing approaches, Torque does not require knowledge of the interconnections among the query proteins. It can handle large queries of up to 25 proteins. The Torque web server is freely available for use at http://www.cs.tau.ac.il/~bnet/ torque.html.","authors":[{"name":"Bruckner S."},{"name":"Huffner F."},{"name":"Karp R.M."},{"name":"Shamir R."},{"name":"Sharan R."}],"citationCount":28,"date":"2009-08-04T00:00:00Z","journal":"Nucleic Acids Research","title":"Torque: Topology-free querying of protein interaction networks"},"pmid":"19491310"}],"topic":[{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Protein interaction experiment","uri":"http://edamontology.org/topic_3557"},{"term":"Protein interactions","uri":"http://edamontology.org/topic_0128"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:torque/web/www.cs.tau.ac.il","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true,"help":true},"publications":[{"entries":[{"cit_count":5,"citations":[{"count":1,"year":"2011"},{"count":1,"year":"2013"},{"count":1,"year":"2015"},{"count":2,"year":"2012"}],"doi":"10.1093/nar/gkp474","pmcid":"PMC2703961","pmid":"19491310","ref_count":7,"refs":[{"count":1,"year":"-1"},{"count":1,"year":"2003"},{"count":1,"year":"2004"},{"count":1,"year":"2005"},{"count":3,"year":"2008"}],"title":"TORQUE: topology-free querying of protein interaction networks.","year":2009}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":408,"redirects":[{"status":301,"url":"https://www.cs.tau.ac.il//~bnet/torque.html"}],"ssl":null,"ssl_err":null}},"support":{"email":false}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:torque:1.0.2/cmd/changeo.readthedocs.io","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type"