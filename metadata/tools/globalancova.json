ns from the null hypothesis. In combination with a permutation approach, empirical significance levels can be approximated. Alternatively, an approximation yields asymptotic p-values. The framework is generalized to groups of categorical variables or even mixed data by a likelihood ratio approach. Closed and hierarchical testing procedures are supported. This work was supported by the NGFN grant 01 GR 0459, BMBF, Germany and BMBF grant 01ZX1309B, Germany.","addition_date":"2017-01-17T15:02:14Z","last_update_date":"2024-11-25T15:30:02.956276Z","tool_type":["Command-line tool","Library"],"version":["4.30.0"],"collections":["BioConductor"],"biotools_curie":"biotools:globalancova","credit":[{"name":"M. Hummel"},{"name":"R. Meister"},{"name":"R. Scheufele"},{"name":"U. Mansmann"},{"name":"with contributions from S. Knueppel"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/GlobalAncova"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Differential gene expression analysis","uri":"http://edamontology.org/operation_3223"}]}],"name":"GlobalAncova","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:globalancova:3.42.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":68,"citations":[{"count":1,"year":"2017"},{"count":1,"year":"2024"},{"count":2,"year":"2018"},{"count":2,"year":"2019"},{"count":2,"year":"2021"},{"count":2,"year":"2022"},{"count":2,"year":"2023"},{"count":2,"year":"2025"},{"count":3,"year":"2020"},{"count":4,