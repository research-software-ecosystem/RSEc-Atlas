{"tool_name":"bamm","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bamm","identifiers":["biotools:bamm","doi:10.1093/nar/gky431"],"license":"LGPL-3.0","summary":"Metagenomics-focused BAM file manipulation","home_url":"https://github.com/Ecogenomics/BamM","keywords":["Animals","Bayes Theorem","Databases, Nucleic Acid","Humans","Internet","Markov Chains","Mice","Nucleotide Motifs","Rats","Regulatory Sequences, Nucleic Acid","Sequence Analysis","Transcription Factors","Sequence sites, features and motifs","ChIP-seq","Genomics","Metagenomics"],"manually_check":true,"total_pulls":1},"biotools":{"id":"bamm","home":"https://bammmotif.mpibpc.mpg.de","license":"AGPL-3.0","summary":"de-novo motif discovery and regulatory sequence analysis.\nDiscovery of regulatory motifs with higher-order Bayesian Markov Models (BaMMs)","addition_date":"2018-07-01T14:36:13Z","last_update_date":"2024-11-25T14:45:28.668092Z","tool_type":["Web application"],"version":["1.2.1"],"biotools_curie":"biotools:bamm","credit":[{"email":"bamm@mpibpc.mpg.de","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://bammserver.readthedocs.io/en/latest/index.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Enrichment analysis","uri":"http://edamontology.org/operation_3501"}]},{"operation":[{"term":"Sequence motif discovery","uri":"http://edamontology.org/operation_0238"}]},{"operation":[{"term":"Sequence motif recognition","uri":"http://edamontology.org/operation_0239"}]}],"name":"BaMM","owner":"aotamendi.1","publication":[{"doi":"10.1093/nar/gky431","metadata":{"abstract":"The BaMM web server offers four tools: (i) de-novo discovery of enriched motifs in a set of nucleotide sequences, (ii) scanning a set of nucleotide sequences with motifs to find motif occurrences, (iii) searching with an input motif for similar motifs in our BaMM database with motifs for >1000 transcription factors, trained from the GTRD ChIP-seq database and (iv) browsing and keyword searching the motif database. In contrast to most other servers, we represent sequence motifs not by position weight matrices (PWMs) but by Bayesian Markov Models (BaMMs) of order 4, which we showed previously to perform substantially better in ROC analyses than PWMs or first order models. To address the inadequacy of P- and E-values as measures of motif quality, we introduce the AvRec score, the average recall over the TP-to-FP ratio between 1 and 100. The BaMM server is freely accessible without registration at https://bammmotif.mpibpc.mpg.de.","authors":[{"name":"Ge W."},{"name":"Kiesel A."},{"name":"Meier M."},{"name":"Roth C."},{"name":"Soding J."},{"name":"Wess M."}],"citationCount":25,"date":"2018-07-02T00:00:00Z","journal":"Nucleic Acids Research","title":"The BaMM web server for de-novo motif discovery and regulatory sequence analysis"},"pmcid":"PMC6030882","pmid":"29846656"}],"topic":[{"term":"ChIP-seq","uri":"http://edamontology.org/topic_3169"},{"term":"Sequence sites, features and motifs","uri":"http://edamontology.org/topic_0160"}],"validated":1},"bioschemas":{"name":"BaMM","home":"https://bio.tools/bamm","license":"AGPL-3.0","version":"1.2.1","summary":"de-novo motif discovery and regulatory sequence analysis.\nDiscovery of regulatory motifs with higher-order Bayesian Markov Models (BaMMs)","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:bamm:1.2.1/web/bammmotif.mpibpc.mpg.de","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{