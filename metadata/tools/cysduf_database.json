{"tool_name":"cysduf_database","contents":["biotools"],"identifiers":["biotools:cysduf_database"],"fetched_metadata":{"biotools":{"id":"cysduf_database","home":"https://cysduf.bits-hyderabad.ac.in/","summary":"CysDuF is a web database that annotates and characterizes cysteine residues in domains of unknown function (DUF) proteins, integrating predicted cysteine post-translational modifications (via DeepCys), protein microenvironments, biochemical pathways, taxonomy, and disease associations, retrievable by DUF, PFAM, or PDB ID in CSV, JSON, or TXT formats.","addition_date":"2026-11-04T09:54:00.595850Z","last_update_date":"2026-11-04T09:54:00.599158Z","biotools_curie":"biotools:cysduf_database","credit":[{"email":"banerjee.debi@hyderabad.bits-pilani.ac.in","name":"Debashree Bandyopadhyay","orcidid":"https://orcid.org/0000-0003-4131-907X","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Disulfide bond prediction","uri":"http://edamontology.org/operation_0471"},{"term":"Free cysteine detection","uri":"http://edamontology.org/operation_1830"},{"term":"Metal-binding site prediction","uri":"http://edamontology.org/operation_3898"},{"term":"Post-translational modification site prediction","uri":"http://edamontology.org/operation_0417"}]}],"name":"CysDuF","owner":"pub2tools2024","publication":[{"doi":"10.1093/DATABASE/BAAG002","pmcid":"PMC12828279","pmid":"41574459"}],"topic":[{"term":"Enzymes","uri":"http://edamontology.org/topic_0821"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Protein folds and structural domains","uri":"http://edamontology.org/topic_0736"},{"term":"Protein modifications","uri":"http://edamontology.org/topic_0601"},{"term":"Taxonomy","uri":"http://edamontology.org/topic_0637"}]}}}