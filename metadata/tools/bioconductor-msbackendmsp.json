{"tool_name":"bioconductor-msbackendmsp","contents":["bioconda","bioconductor","bioschemas","biotools","oeb"],"identifiers":["biotools:bioconductor-msbackendmsp","bioconductor:msbackendmsp","bioconda:bioconductor-msbackendmsp"],"fetched_metadata":{"biotools":{"id":"bioconductor-msbackendmsp","home":"https://bioconductor.org/packages/CompoundDb","license":"Artistic-2.0","summary":"CompoundDb provides functionality to create and use (chemical) compound annotation databases from a variety of different sources such as LipidMaps, HMDB, ChEBI or MassBank. The database format allows to store in addition MS/MS spectra along with compound information. The package provides also a backend for Bioconductor's Spectra package and allows thus to match experimetal MS/MS spectra against MS/MS spectra in the database. Databases can be stored in SQLite format and are thus portable.","addition_date":"2026-08-30T02:46:53.257977Z","last_update_date":"2026-10-11T01:43:47.846704Z","tool_type":["Command-line tool","Library"],"version":["1.16.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-msbackendmsp","credit":[{"name":"Andrea Vicini","typeEntity":"Person","typeRole":["Developer"]},{"name":"Jan Stanstrup","typeEntity":"Person","typeRole":["Developer"]},{"name":"Johannes Rainer","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Josep M. Badia","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Prateek Arora","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Roger Gine","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/CompoundDb"}],"edit_permission":{"type":"private"},"name":"MsBackendMsp","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.3390/metabo12020173"}]},"bioschemas":{"name":"MsBackendMsp","home":"https://bio.tools/bioconductor-msbackendmsp","license":"Artistic-2.0","version":"1.16.0","summary":"Co