{"tool_name":"diversitytaxonnames","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"DiversityTaxonNames","home":"https://diversityworkbench.net/Portal/DiversityTaxonNames","license":"GPL-2.0","summary":"DiversityTaxonNames (DWB-DTN) is an application of Diversity Workbench (DWB). It might be installed as part of a DWB environment, but also as a stand-alone application, e. g., in a local installation. Each DWB module is devoted to a specific data domain. DTN is focused on the management of taxon names. Next to nomenclatural information on zoological, botanical, mycological, palaeontological, bacteriological taxon names like typification with type specimens, homotypic synonyms, basionyms, protologues and references according to the rules of the respective International Codes, it is designed to document taxonomic information. This includes accepted names (current names), heterotypic synonyms, name concepts and classifications as well as the history of changing taxonomic relations. DTN is also used to organise common names in various languages and regional taxon checklists with information on red list status and other taxon-based (ecological and nature conservation) parameters.","addition_date":"2019-06-13T14:23:38Z","last_update_date":"2020-06-16T10:55:23Z","tool_type":["Desktop application","Web API","Web service"],"accessibility":"Open access","biotools_curie":"biotools:DiversityTaxonNames","cost":"Free of charge","credit":[{"email":"triebel@snsb.de","name":"Dagmar Triebel","orcidid":"https://orcid.org/0000-0003-1980-3148","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.snsb.info/staff_triebel.html"},{"email":"it-center@snsb.de","name":"SNSB IT Center","typeEntity":"Division","typeRole":["Maintainer","Provider","Support"],"url":"http://www.snsb.info/"},{"name":"Deutsche Forschungsgemeinschaft (DFG)","typeEntity":"Funding agency"}],"documentation":[{"note":"database model","type":["Other"],"url":"https://diversityworkbench.net/Portal/DiversityTaxonNames_Information_Models"},{"type":["Training material"],"url":"https://diversityworkbench.net/Portal/Training_materials"},{"type":["User manual"],"url":"https://diversityworkbench.net/Portal/DWB_user_manuals"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Taxonomy","uri":"http://edamontology.org/data_3028"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"},{"term":"XML","uri":"http://edamontology.org/format_2332"}]}],"operation":[{"term":"Analysis","uri":"http://edamontology.org/operation_2945"},{"term":"Classification","uri":"http://edamontology.org/operation_2990"},{"term":"Conversion","uri":"http://edamontology.org/operation_3434"},{"term":"Data handling","uri":"http://edamontology.org/operation_2409"}],"output":[{"data":{"term":"Taxonomy","uri":"http://edamontology.org/data_3028"},"format":[{"term":"RDF format","uri":"http://edamontology.org/format_2376"},{"term":"Textual format","uri":"http://edamontology.org/format_2330"},{"term":"XML","uri":"http://edamontology.org/format_2332"}]}]}],"maturity":"Mature","name":"DiversityTaxonNames","operating_system":["Windows"],"owner":"SNSB","topic":[{"term":"Biology","uri":"http://edamontology.org/topic_3070"},{"term":"Data management","uri":"http://edamontology.org/topic_3071"},{"term":"Ontology and terminology","uri":"http://edamontology.org/topic_0089"}],"validated":1},"bioschemas":{"name":"DiversityTaxonNames","home":"https://bio.tools/DiversityTaxonNames","license":"GPL-2.0","summary":"DiversityTaxonNames (DWB-DTN) is an application of Diversity Workbench (DWB). It might be installed as part of a DWB environment, but also as a stand-alone application, e. g., in a local installation. Each DWB module is devoted to a specific data domain. DTN is focused on the management of taxon names. Next to nomenclatural information on zoological, botanical, mycological, palaeontological, bacteriological taxon names like typification with