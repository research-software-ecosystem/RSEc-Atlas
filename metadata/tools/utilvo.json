{"tool_name":"utilvo","contents":["biotools","oeb"],"identifiers":["biotools:utilvo"],"fetched_metadata":{"biotools":{"id":"utilvo","home":"https://utilvo.com","license":"MIT","summary":"Utilvo is a privacy-preserving client-side biomedical imaging and scientific information processing suite developed by Islam Ayoub (ORCID: 0009-0002-1503-5639). Executed entirely within the browser sandbox using WebAssembly (Wasm), WebGL2, Web Workers, and the Web Cryptography API, Utilvo enables zero-trust local inspection of clinical DICOM (.dcm) radiology studies, 3D NIfTI (.nii / .nii.gz) neuroimaging volumes, 12-lead ECG/EKG waveform recordings, and structured research documents without transmitting raw patient data (PHI) to external servers.","addition_date":"2026-11-07T21:39:04.215436Z","last_update_date":"2026-11-09T16:30:59.106656Z","tool_type":["Suite","Web application","Workbench"],"version":["2.4.0"],"accessibility":"Open access","biotools_curie":"biotools:utilvo","cost":"Free of charge","credit":[{"email":"info@utilvo.com","name":"Islam Ayoub","orcidid":"https://orcid.org/0009-0002-1503-5639","typeEntity":"Person","typeRole":["Developer","Maintainer","Primary contact"],"url":"https://utilvo.com/about-us"},{"name":"Utilvo Research","typeEntity":"Institute","typeRole":["Provider"],"url":"https://utilvo.com/labs"}],"documentation":[{"note":"Architecture whitepaper and empirical evaluation of browser-based local information processing","type":["General"],"url":"https://utilvo.com/research/privacy-preserving-client-side-information-processing"},{"note":"Comprehensive technical guides, workflows, and user documentation for Utilvo browser tools","type":["User manual"],"url":"https://utilvo.com/guides"},{"note":"Utilvo Medical Viewers & Clinical Diagnostic Calculators Documentation Suite","type":["General"],"url":"https://utilvo.com/medical-viewers"}],"edit_permission":{"type":"private"},"function":[{"note":"Zero-trust client-side DICOM Part 10 (PS3.5), 3D NIfTI (.nii/.nii.gz) 