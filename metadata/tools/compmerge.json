{"tool_name":"compmerge","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"compmerge","home":"http://big.crg.cat/services/compmerge","summary":"compmerge is a program that tries to solve the same problem as cuffmerge. It is not limited to cufflinks/stringtie models and transcripts, but can work with any GTF file. It merges the spliced transcripts that have a compatible intron structure and merges the monoexonic transcripts based on simple stranded overlap.The output is a GTF file of merged transcripts.","addition_date":"2016-04-22T13:34:37Z","last_update_date":"2018-12-10T12:58:56Z","tool_type":["Command-line tool"],"version":["1.3"],"biotools_curie":"biotools:compmerge","credit":[{"email":"sarahqd@gmail.com","name":"Sarah Djebali","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"Lab Roderic Guigo Group","note":"Computational Biology of RNA processing @ Centre for Genomic Regulation Parc de Recerca Biomedica: Dr. Aiguader, 88, 08003 Barcelona","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Sarah Djebali","typeEntity":"Person","typeRole":["Developer"]},{"name":"crg.eu","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["General"],"url":"http://big.crg.cat/services/compmerge"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Nucleic acid sequence analysis","uri":"http://edamontology.org/operation_2478"}],"output":[{"data":{"term":"Sequence features","uri":"http://edamontology.org/data_1255"},"format":[{"term":"GTF","uri":"http://edamontology.org/format_2306"}]}]}],"name":"compmerge","operating_system":["Linux"],"owner":"francisco.camara@crg.eu","topic":[{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"bioschemas":{"name":"compmerge","home":"https://bio.tools/compmerge","version":"1.3","summary":"compmerge is a program that tries to solve the same problem as cuffmerge. It is not limited to cufflinks/stringtie models and tran