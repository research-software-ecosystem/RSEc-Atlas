{"tool_name":"sequoia","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"sequoia","home":"https://github.com/meta-logic/sequoia","license":"GPL-3.0","summary":"A Playground for Logicians.\n\nSequent calculus proof construction tool.\n\ngit clone git@github.com:meta-logic/sequoia.git.\n\nThese instructions will get you a copy of the project up and running on your local machine for development and testing purposes.\n\nDesign, play with, and analyze sequent calculus proof systems.\n\nInvestigate meta-theoretical properties for your calculus systems (such as identity expansion, weakening admissibility, and permutability of rules). Sequoia is able to infer most of the trivial cases automatically.\n\nCreate, save, modify, and manage your own calculi.\n\nBower (note that Bower can be installed via npm once Node.js is installed).","addition_date":"2021-01-18T10:07:43Z","last_update_date":"2024-11-24T20:38:43.551263Z","biotools_curie":"biotools:sequoia","credit":[{"email":"giselle@cmu.edu","name":"Giselle Reis","orcidid":"https://orcid.org/0000-0002-5145-9829","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"Sequoia","owner":"zsmag19","publication":[{"pmcid":"PMC7324041"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:sequoia/undefined/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"pmcid":"PMC7324041","ref_count":0,"refs":[]}]}],"readme":false,"summary":{"d