{"tool_name":"bnpc","contents":["biotools","oeb"],"identifiers":["biotools:bnpc"],"fetched_metadata":{"biotools":{"id":"bnpc","home":"https://github.com/cbg-ethz/BnpC","license":"MIT","summary":"BnpC is a non-parametric method to cluster individual cells into clones and infer their genotypes based on their noisy mutation profiles. BnpC employs a Chinese Restaurant Process prior to handle the unknown number of clonal populations. The model introduces a combination of Gibbs sampling, a modified non-conjugate split-merge move and Metropolis-Hastings updates to explore the joint posterior space of all parameters. Furthermore, it employs a novel estimator, which accounts for the shape of the posterior distribution, to predict the clones and genotypes.","addition_date":"2021-01-18T07:00:21Z","last_update_date":"2026-11-12T14:26:22.910489Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:bnpc","credit":[{"email":"niko.beerenwinkel@bsse.ethz.ch","name":"Niko Beerenwinkel","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"},{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Statistical calculation","uri":"http://edamontology.org/operation_2238"}]}],"name":"BnpC","owner":"Kigaard","publication":[{"doi":"10.1093/bioinformatics/btaa599","type":["Primary"]},{"doi":"10.1101/2020.01.15.907345","type":["Preprint"]}],"topic":[{"term":"Exome sequencing","uri":"http://edamontology.org/topic_3676"},{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Phylogeny","uri":"http://edamontology.org/topic_0084"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:bnpc/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{