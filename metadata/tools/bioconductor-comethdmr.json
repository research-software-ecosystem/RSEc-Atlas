{"tool_name":"bioconductor-comethdmr","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-comethdmr","home":"https://bioconductor.org/packages/coMethDMR","license":"GPL-3.0","summary":"coMethDMR identifies genomic regions associated with continuous phenotypes by optimally leverages covariations among CpGs within predefined genomic regions. Instead of testing all CpGs within a genomic region, coMethDMR carries out an additional step that selects co-methylated sub-regions first without using any outcome information. Next, coMethDMR tests association between methylation within the sub-region and continuous phenotype using a random coefficient mixed effects model, which models both variations between CpG sites within the region and differential methylation simultaneously.","tool_type":["Command-line tool","Library"],"version":["1.16.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-comethdmr","credit":[{"name":"Boissel Mathilde","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Fernanda Veitzman","typeEntity":"Person","typeRole":["Maintainer"]},{"name":"Gabriel Odom","typeEntity":"Person","typeRole":["Developer"]},{"name":"Lily Wang","typeEntity":"Person","typeRole":["Developer"]},{"name":"Lissette Gomez","typeEntity":"Person","typeRole":["Developer"]},{"name":"Ning Lijiao","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Tiago Silva","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/coMethDMR"}],"name":"coMethDMR","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.18129/B9.bioc.coMethDMR"}]},"bioschemas":{"name":"coMethDMR","home":"https://bio.tools/bioconductor-comethdmr","license":"GPL-3.0-only","version":"1.16.0","summary":"coMethDMR identifies genomic regions associated with continuous phenotypes by optimally leverages covariations among CpGs within pr