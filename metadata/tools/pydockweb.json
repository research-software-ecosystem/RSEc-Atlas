{"tool_name":"pydockweb","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"pydockweb","home":"https://life.bsc.es/pid/pydockweb","summary":"Web server for the structural prediction of protein-protein interactions. Given the 3D coordinates of two interacting proteins, it returns the best rigid-body docking orientations generated by FTDock (Gabb HA. et al. J Mol Biol 1997;272:106-120) and evaluated by pyDock scoring function (Cheng et al. 2007 Proteins 68, 503-515), which includes electrostatics, desolvation energy and limited van der Waals contribution.","addition_date":"2016-10-11T07:52:25Z","last_update_date":"2024-11-24T14:37:10.750234Z","tool_type":["Web application"],"version":["3.5.1"],"biotools_curie":"biotools:pydockweb","cost":"Free of charge (with restrictions)","credit":[{"email":"b.jimenezgarcia@uu.nl","name":"Brian Jim\u00e9nez-Garc\u00ed\u00ada","orcidid":"http://orcid.org/0000-0001-7786-2109","typeEntity":"Person","typeRole":["Developer"]},{"email":"luis.rodriguez@bsc.es","name":"Luis \u00c1ngel Rodriguez Lumbreras","orcidid":"https://orcid.org/0000-0002-7502-3157","typeEntity":"Person","typeRole":["Developer","Maintainer"],"url":"https://www.bsc.es/rodriguez-lumbreras-luis-angel"},{"email":"pydock.services@gmail.com","typeEntity":"Project","typeRole":["Primary contact"],"url":"https://life.bsc.es/pid/pydockweb/info/contactus"},{"name":"Barcelona Supercomputing Center","typeEntity":"Institute","typeRole":["Provider"],"url":"https://www.bsc.es/"}],"documentation":[{"type":["General"],"url":"https://life.bsc.es/pid/pydockweb/info/faq_and_help"},{"type":["Terms of use"],"url":"https://life.bsc.es/pid/pydockweb/info/terms"}],"edit_permission":{"authors":["lrodrigu"],"type":"group"},"function":[{"input":[{"data":{"term":"Protein structure","uri":"http://edamontology.org/data_1460"},"format":[{"term":"PDB","uri":"http://edamontology.org/format_1476"}]}],"operation":[{"term":"Protein-protein docking","uri":"http://edamontology.o