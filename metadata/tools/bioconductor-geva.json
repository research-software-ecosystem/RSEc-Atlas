{"tool_name":"bioconductor-geva","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-geva","home":"https://bioconductor.org/packages/geva","license":"LGPL-3.0","summary":"Statistic methods to evaluate variations of differential expression (DE) between multiple biological conditions. It takes into account the fold-changes and p-values from previous differential expression (DE) results that use large-scale data (*e.g.*, microarray and RNA-seq) and evaluates which genes would react in response to the distinct experiments. This evaluation involves an unique pipeline of statistical methods, including weighted summarization, quantile detection, cluster analysis, and ANOVA tests, in order to classify a subset of relevant genes whose DE is similar or dependent to certain biological factors.","addition_date":"2026-09-01T07:20:57.403590Z","last_update_date":"2026-09-01T07:20:57.406302Z","tool_type":["Command-line tool","Library"],"version":["1.20.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-geva","credit":[{"name":"Bruno C\u00e9sar Feltes","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Itamar Jos\u00e9 Guimar\u00e3es Nunes","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Marcio Dorn","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Murilo Zanini David","typeEntity":"Person","typeRole":["Contributor"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/geva"}],"edit_permission":{"type":"private"},"name":"geva","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.18129/B9.bioc.geva"}]},"bioschemas":{"name":"geva","home":"https://bio.tools/bioconductor-geva","license":"LGPL-3.0-only","version":"1.20.0","summary":"Statistic methods to evaluate variations of differential expression (DE) between multiple biological conditions. It takes into account the fold-changes and p-values from previous diffe