{"tool_name":"2struccompare","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"2StrucCompare","home":"http://2struccompare.cryst.bbk.ac.uk/index.php","license":"Unlicense","summary":"Webserver for the comparison of secondary structure algorithms and the secondary structure of protein structures.","addition_date":"2019-08-09T13:08:45Z","last_update_date":"2020-06-16T10:55:25Z","tool_type":["Web application","Web service"],"accessibility":"Open access","biotools_curie":"biotools:2StrucCompare","cost":"Free of charge","credit":[{"email":"e.drew@qmul.ac.uk","name":"Elliot Drew","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"r.w.janes@qmul.ac.uk","name":"Robert W. Janes","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://2struccompare.cryst.bbk.ac.uk/help.php"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Protein secondary structure assignment","uri":"http://edamontology.org/operation_0319"},{"term":"Protein secondary structure comparison","uri":"http://edamontology.org/operation_2488"},{"term":"Protein secondary structure prediction","uri":"http://edamontology.org/operation_0267"}]}],"maturity":"Mature","name":"2StrucCompare","operating_system":["Linux","Mac","Windows"],"owner":"hans","publication":[{"doi":"10.1093/NAR/GKZ456","metadata":{"abstract":"\u00a9 2019 The Author(s).2StrucCompare is a webserver whose primary aim is to visualize subtle but functionally important differences between two related protein structures, either of the same protein or related homologues, with similar or functionally different tertiary structures. At the heart of the package is identifying and visualizing differences between conformations at the secondary structure and at the residue level, such as contact differences or side chain conformational differences found between two protein chains. The protein secondary structures are determined according to four established methods (DSSP, STRIDE, P-SEA and STICKS), and as each employs different assignment strategies, small conformational differences between the two structures can give rise to paired residues being denoted as having different secondary structure features with the different methods. 2StrucCompare captures both the large and more subtle differences found between structures, enabling visualization of these differences that could be key to an understanding of a proteins' function. 2StrucCompare is freely accessible at http://2struccompare.cryst.bbk.ac.uk/index.php.","authors":[{"name":"Drew E.D."},{"name":"Janes R.W."}],"citationCount":6,"date":"2019-07-01T00:00:00Z","journal":"Nucleic Acids Research","title":"2StrucCompare: a webserver for visualizing small but noteworthy differences between protein tertiary structures through interrogation of the secondary structure content"},"pmcid":"PMC6602421","pmid":"31114904","type":["Primary"]}],"topic":[{"term":"Protein folds and structural domains","uri":"http://edamontology.org/topic_0736"},{"term":"Protein secondary structure","uri":"http://edamontology.org/topic_3542"},{"term":"Protein structural motifs and surfaces","uri":"http://edamontology.org/topic_0166"}],"validated":1},"bioschemas":{"name":"2StrucCompare","home":"https://bio.tools/2StrucCompare","license":"Unlicense","summary":"Webserver for the comparison of secondary structure algorithms and the secondary structure of protein structures.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:2struccompare/soap/2struccompare.cryst.bbk.ac.uk","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":13,"citations":[{"count":1,"year":"2020"},{"c