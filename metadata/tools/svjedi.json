{"tool_name":"svjedi","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"svjedi","identifiers":["doi:10.1101/849208"],"license":"GNU Affero General Public License v3.0","summary":"Svjedi is a structural variation (sv) genotyper for long read data.","home_url":"https://github.com/llecompte/SVJedi","keywords":[],"manually_check":true,"total_pulls":4},"biotools":{"id":"SVJedi","home":"https://github.com/llecompte/SVJedi.git","license":"AGPL-3.0","summary":"Genotyping structural variations with long reads.\n\nSVJedi : Genotyping structural variations with long read data.\n\nSVJedi is a structural variation (SV) genotyper for long read data. Based on a representation of the different alleles, it estimates the genotype of each variant in a given individual sample based on allele-specific alignment counts. SVJedi takes as input a variant file (VCF), a reference genome (fasta) and a long read file (fasta/fastq) and outputs the initial variant file with an additional column containing genotyping information (VCF)","addition_date":"2020-01-14T09:03:03Z","last_update_date":"2020-12-27T12:34:25Z","biotools_curie":"biotools:SVJedi","edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Read mapping","uri":"http://edamontology.org/operation_3198"},{"term":"SNP detection","uri":"http://edamontology.org/operation_0484"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"}]}],"name":"SVJedi","owner":"Pub2Tools","publication":[{"doi":"10.1101/849208"}],"topic":[{"term":"DNA structural variation","uri":"http://edamontology.org/topic_3175"},{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"b