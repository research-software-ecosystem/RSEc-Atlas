{"tool_name":"flyode","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"flyode","home":"http://flyode.boun.edu.tr","license":"MIT","summary":"Systematic assembly of data on Drosophila melanogaster eye development. It consists of data on eye development obtained from the literature, and a web interface for users to interactively display these data as a gene regulatory network.","addition_date":"2018-08-31T10:13:59Z","last_update_date":"2019-01-13T00:59:21Z","tool_type":["Web application"],"biotools_curie":"biotools:flyode","credit":[{"email":"bgmalay@gmail.com","name":"Begum Alaybeyoglu","orcidid":"http://orcid.org/0000-0001-6785-3719","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"stevekoestler@gmail.com","name":"Stefan A. Koestler","orcidid":"http://orcid.org/0000-0002-7223-8291","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://flyode.boun.edu.tr/description.html"},{"type":["General"],"url":"http://flyode.boun.edu.tr/overview.html"},{"type":["General"],"url":"http://flyode.boun.edu.tr/quickguide.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene regulatory network analysis","uri":"http://edamontology.org/operation_1781"},{"term":"Pathway or network analysis","uri":"http://edamontology.org/operation_2497"}]}],"name":"FLyOde","owner":"aotamendi.1","publication":[{"doi":"10.12688/f1000research.7556.1","metadata":{"abstract":"\u00a9 2015 Koestler SA et al.Motivation: Understanding the regulatory mechanisms governing eye development of the model organism Drosophila melanogaster (D. m.) requires structured knowledge of the involved genes and proteins, their interactions, and dynamic expression patterns. Especially the latter information is however to a large extent scattered throughout the literature. Results: FlyOde is an online platform for the systematic assembly of data on D. m. eye development. It consists of data on eye development obtained from the literature, and a web interface for users to interactively display these data as a gene regulatory network. Our manual curation process provides high standard structured data, following a specifically designed ontology. Visualization of gene interactions provides an overview of network topology, and filtering according to user-defined expression patterns makes it a versatile tool for daily tasks, as demonstrated by usage examples. Users are encouraged to submit additional data via a simple online form.","authors":[{"name":"Alaybeyoglu B."},{"name":"Celik A."},{"name":"Koestler S.A."},{"name":"Weichenberger C.X."}],"citationCount":2,"date":"2015-01-01T00:00:00Z","journal":"F1000Research","title":"FlyOde - a platform for community curation and interactive visualization of dynamic gene regulatory networks in Drosophila eye development"},"pmcid":"PMC4786896","pmid":"26998229","type":["Primary"]}],"topic":[{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Ontology and terminology","uri":"http://edamontology.org/topic_0089"}],"validated":1},"bioschemas":{"name":"FLyOde","home":"https://bio.tools/flyode","license":"MIT","summary":"Systematic assembly of data on Drosophila melanogaster eye development. It consists of data on eye development obtained from the literature, and a web interface for users to interactively display these data as a gene regulatory network.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:flyode/web/flyode.boun.edu.tr","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"an