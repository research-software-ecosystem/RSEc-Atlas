{"tool_name":"infernal_cmscan","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"infernal_cmscan","home":"https://www.ebi.ac.uk/jdispatcher/rna/infernal_cmscan","summary":"Infernal (\"INFERence of RNA ALignment\") is for searching DNA sequence databases (e.g. Rfam) for RNA structure and sequence similarities.","addition_date":"2015-08-03T09:35:17Z","last_update_date":"2024-11-24T13:57:39.479268Z","tool_type":["Web application","Web service"],"version":["1"],"collections":["EBI Tools","Job Dispatcher Tools"],"biotools_curie":"biotools:infernal_cmscan","credit":[{"name":"EMBL-EBI","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Sean Eddy","typeEntity":"Person","typeRole":["Developer"]},{"name":"Job Dispatcher","typeEntity":"Project","typeRole":["Primary contact"],"url":"http://www.ebi.ac.uk/jdispatcher"}],"documentation":[{"type":["General"],"url":"http://eddylab.org/infernal/"},{"type":["General"],"url":"https://www.ebi.ac.uk/jdispatcher/help"},{"type":["Terms of use"],"url":"http://www.ebi.ac.uk/about/terms-of-use"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Sequence analysis","uri":"http://edamontology.org/operation_2403"}]}],"name":"Infernal cmscan (EBI)","operating_system":["Linux","Mac","Windows"],"owner":"jdispatcher","publication":[{"doi":"10.1093/bioinformatics/btt509","metadata":{"abstract":"Summary: Infernal builds probabilistic profiles of the sequence and secondary structure of an RNA family called covariance models (CMs) from structurally annotated multiple sequence alignments given as input. Infernal uses CMs to search for new family members in sequence databases and to create potentially large multiple sequence alignments. Version 1.1 of Infernal introduces a new filter pipeline for RNA homology search based on accelerated profile hidden Markov model (HMM) methods and HMM-banded CM alignment methods. This enables \u223c100-fold acceleration over the previous version and \u223c10 000-fold acceleration over exhaustive non-filtered CM searches. \u00a9 The Author 2013. Published by Oxford University Press. All rights reserved.","authors":[{"name":"Eddy S.R."},{"name":"Nawrocki E.P."}],"citationCount":2024,"date":"2013-11-15T00:00:00Z","journal":"Bioinformatics","title":"Infernal 1.1: 100-fold faster RNA homology searches"},"pmcid":"PMC3810854","pmid":"24008419","type":["Primary"]},{"doi":"10.1093/nar/gkac240","metadata":{"abstract":"The EMBL-EBI search and sequence analysis tools frameworks provide integrated access to EMBL-EBI's data resources and core bioinformatics analytical tools. EBI Search (https://www.ebi.ac.uk/ebisearch) provides a full-text search engine across nearly 5 billion entries, while the Job Dispatcher tools framework (https://www.ebi.ac.uk/services) enables the scientific community to perform a diverse range of sequence analysis using popular bioinformatics applications. Both allow users to interact through user-friendly web applications, as well as via RESTful and SOAP-based APIs. Here, we describe recent improvements to these services and updates made to accommodate the increasing data requirements during the COVID-19 pandemic.","authors":[{"name":"Basutkar P."},{"name":"Edbali O."},{"name":"Kolesnikov A."},{"name":"Lee J."},{"name":"Lopez R."},{"name":"Madeira F."},{"name":"Madhusoodanan N."},{"name":"Pearce M."},{"name":"Tivey A.R.N."}],"citationCount":1248,"date":"2022-07-05T00:00:00Z","journal":"Nucleic Acids Research","title":"Search and sequence analysis tools services from EMBL-EBI in 2022"},"pmcid":"PMC9252731","pmid":"35412617","type":["Other"]},{"doi":"10.1093/nar/gkae241","metadata":{"abstract":"The EMBL-EBI Job Dispatcher sequence analysis tools framework (https://www.ebi.ac.uk/jdispatcher) enables the scientific community to perform a diverse range of sequence analyses using popular bioinformatics applications. Free access to the tools and required sequence datasets is provided through user-friendly web applications, as well as via RESTful and SOAP-based APIs. These are integrated into popular EMBL-EBI resources such as UniProt, InterPro, ENA and Ensembl Genomes. This paper overviews recent improvements to Job Dispatcher, including its brand new website and documentation, enhanced visualisations, improved job management, and a rising trend of user reliance on the service from low- and middle-income regions.","authors":[{"name":"Butcher S."},{"name":"Eusebi A."},{"name":"Lee J."},{"name":"Lopez R."},{"name":"Madeira F."},{"name":"Madhusoodanan N."},{"name":"Niewielska A."},{"name":"Tivey A.R.N."}],"citationCount":60,"date":"2024-07-05T00:00:00Z","journal":"Nucleic Acids Research","title":"The EMBL-EBI Job Dispatcher sequence analysis tools framework in 2024"},"pmcid":"PMC11223882","pmid":"38597606","type":["Other"]}],"topic":[{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"bioschemas":{"name":"Infernal cmscan (EBI)","home":"https://bio.tools/infernal_cmscan","version":"1","summary":"Infernal (\"INFERence of RNA ALignment\") is for searching DNA sequence databases (e.g. Rfam) for RNA structure and sequence similarities.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:infernal_cmscan:1/soap/www.ebi.ac.uk","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true,"terms_of_use":true},"publications":[{"entries":[{"cit_count":946,"citations":[{"count":1,"year":"-1"},{"count":103,"year":"2024"},{"count":365,"year":"2026"},{"count":477,"year":"2025"}],"doi":"10.1093/nar/gkae241","pmcid":"PMC11223882","pmid":"38597606","ref_count":21,"refs":[{"count":1,"year":"1988"},{"count":1,"year":"2000"},{"count":1,"year":"2013"},{"count":1,"year":"2014"},{"count":1,"year":"2015"},{"count":1,"year":"2016"},{"count":1,"year":"2017"},{"count":1,"year":"2018"},{"coun