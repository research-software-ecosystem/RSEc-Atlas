{"tool_name":"eqtlbma","contents":["biocontainers","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"eqtlbma","version":"1.3.3","home":"https://github.com/timflutre/eqtlbma","license":"GPLv3","summary":"Package to detect eQTLs jointly in multiple subgroups (e.g. tissues) via Bayesian Model Averaging.","identifiers":["biotools:eQtlBma"],"license_file":"COPYING","build":{"number":4,"skip":true},"requirements":{"build":["make",null,null,"autoconf","automake","libtool"],"host":["gsl 2.4","openblas","zlib","texinfo","perl"],"run":["gsl 2.4","openblas","zlib","r-base","r-mass","bioconductor-genomicranges"]},"source_url":"https://github.com/timflutre/eqtlbma/archive/v1.3.3.tar.gz","test":{"commands":["eqtlbma_bf -h","eqtlbma_hm -h","eqtlbma_avg_bfs -h"]}},"biocontainers":{"name":"eqtlbma","identifiers":["biotools:eQtlBma","doi:10.1371/journal.pgen.1003486"],"license":"GPL-3.0","summary":"Package to detect eQTLs jointly in multiple subgroups (e.g. tissues) via Bayesian Model Averaging.","home_url":"https://github.com/timflutre/eqtlbma","keywords":["Chromosome Mapping","Gene Expression","Genome-Wide Association Study","Models, Theoretical","Organ Specificity","Quantitative Trait Loci","Mapping","Genetics"],"manually_check":true,"total_pulls":0},"biotools":{"id":"eqtlbma","home":"https://github.com/timflutre/eqtlbma/wiki","license":"GPL-3.0","summary":"eQtlBma: software to detect eQTLs by Bayesian Model Averaging. The software detects quantitative trait loci for gene expression levels (\"eQTLs\") jointly in multiple subgroups (e.g. multiple tissues).","addition_date":"2017-08-20T15:39:29Z","last_update_date":"2024-11-25T14:05:45.336433Z","tool_type":["Command-line tool"],"collections":["Animal and Crop Genomics"],"biotools_curie":"biotools:eqtlbma","credit":[{"email":"eqtlbma-users@googlegroups.com","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/timflutre/eqtlbma/wiki#usage"},{"type":["User manual"],"url":"https://github.com/timflutre/eqtlbma/blob/master/doc/manual_eqtlbma.pdf?raw=true"}],"edit_permission":{"authors":["animalandcropgenomics"],"type":"group"},"function":[{"operation":[{"term":"Gene expression QTL analysis","uri":"http://edamontology.org/operation_3232"},{"term":"Genetic mapping","uri":"http://edamontology.org/operation_0282"}]}],"name":"eQtlBma","operating_system":["Linux","Mac"],"owner":"admin","publication":[{"doi":"10.1371/journal.pgen.1003486","metadata":{"abstract":"Mapping expression Quantitative Trait Loci (eQTLs) represents a powerful and widely adopted approach to identifying putative regulatory variants and linking them to specific genes. Up to now eQTL studies have been conducted in a relatively narrow range of tissues or cell types. However, understanding the biology of organismal phenotypes will involve understanding regulation in multiple tissues, and ongoing studies are collecting eQTL data in dozens of cell types. Here we present a statistical framework for powerfully detecting eQTLs in multiple tissues or cell types (or, more generally, multiple subgroups). The framework explicitly models the potential for each eQTL to be active in some tissues and inactive in others. By modeling the sharing of active eQTLs among tissues, this framework increases power to detect eQTLs that are present in more than one tissue compared with \"tissue-by-tissue\" analyses that examine each tissue separately. Conversely, by modeling the inactivity of eQTLs in some tissues, the framework allows the proportion of eQTLs shared across different tissues to be formally estimated as parameters of a model, addressing the difficulties of accounting for incomplete power when comparing overlaps of eQTLs identified by tissue-by-tissue analyses. Applying our framework to re-analyze data from transformed B cells, T cells, and fibroblasts, we find that it substantially increases power compared with tissue-by-tissue analysis, identifying 63% more genes with eQTLs (at FDR = 0.05). Further, the results suggest that, in contrast to previous analyses of the same data, the majority of eQTLs detectable in these data are shared among all three tissues. \u00a9 2013 Flutre et al.","authors":[{"name":"Flutre T."},{"name":"Pritchard J."},{"name":"Stephens M."},{"name":"Wen X."}],"citationCount":175,"date":"2013-05-01T00:00:00Z","journal":"PLoS Genetics","title":"A Statistical Framework for Joint eQTL Analysis in Multiple Tissues"},"pmcid":"PMC3649995","pmid":"23671422","type":["Primary"]}],"topic":[{"term":"Mapping","uri":"http://edamontology.org/topic_0102"}],"validated":1},"bioschemas":{"name":"eQtlBma","home":"https://bio.tools/eqtlbma","license":"GPL-3.0","summary":"eQtlBma: software to detect eQTLs by Bayesian Model Averaging. The software detects quantitative trait loci for gene expression levels (\"eQTLs\") jointly in multiple subgroups (e.g. multiple tissues).","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:eqtlbma/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"documentation":{"general":true,"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":147,"citations":[{"count":1,"year":"-1"},{"count":1,"year":"2024"},{"count":3,"year":"2026"},{"count":4,"year":"2013"},{"count":4,"year":"2025"},{"count":5,"year":"2019"},{"count":8,"year":"2023"},{"count":9,"year":"2022"},{"count":11,"year":"2020"},{"count":11,"year":"2021"},{"count":16,"year":"2014"},{"count":16,"year":"2018"},{"count":17,"year":"2017"},{"count":20,"year":"2015"},{"count":21,"yea