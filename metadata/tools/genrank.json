{"tool_name":"genrank","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"genrank","home":"http://bioconductor.org/packages/release/bioc/html/GenRank.html","license":"Artistic-2.0","summary":"Methods for ranking genes based on convergent evidence obtained from multiple independent evidence layers. This package adapts three methods that are popular for meta-analysis.","addition_date":"2017-01-17T14:55:51Z","last_update_date":"2018-12-10T12:58:54Z","tool_type":["Command-line tool","Library"],"version":["1.2.0"],"collections":["BioConductor"],"biotools_curie":"biotools:genrank","credit":[{"email":"chakra.kanduri@gmail.com","name":"Chakravarthi Kanduri","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/html/GenRank.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Sequence feature comparison","uri":"http://edamontology.org/operation_0256"}]}],"name":"GenRank","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.12688/f1000research.11223.1","metadata":{"abstract":"\u00a9 2017 Kanduri C and J\u00e4rvel\u00e4 I.Modern high-throughput studies often yield long lists of genes, a fraction of which are of high relevance to the phenotype of interest. To prioritize the candidate genes of complex genetic traits, our R/Bioconductor package GenRank ranks genes based on convergent evidence obtained from multiple layers of independent evidence. We implemented three methods to rank genes that integrate gene-level data generated from multiple layers of evidence: (a) the convergent evidence (CE) method aggregates evidence based on a weighted vote counting method; (b) the rank product (RP) method performs a meta-analysis of microarray-based gene expression data, and (c) the traditional method combines p-values. The methods are implemented in R and are available as a package in the Bioconductor repository. (http://bioconductor.org/packages/GenRank/).","authors":[{"name":"Jarvela I."},{"name":"Kanduri C."}],"date":"2017-01-01T00:00:00Z","journal":"F1000Research","title":"GenRank: A R/Bioconductor package for prioritization of candidate genes"},"type":["Primary"]}],"topic":[{"term":"Genetics","uri":"http://edamontology.org/topic_3053"}],"validated":1},"bioschemas":{"name":"GenRank","home":"https://bio.tools/genrank","license":"Artistic-2.0","version":"1.2.0","summary":"Methods for ranking genes based on convergent evidence obtained from multiple independent evidence layers. This package adapts three methods that are popular for meta-analysis.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:genrank:1.2.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.12688/f1000research.11223.1","ref_count":0,"refs":[]}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":404,"redirects":[{"status":301,"url":"https://bioconductor.org/packages/release/bioc/html/GenRank.html"}],"ssl":true,"ssl_err":null}},"support":{"email":true}},{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:genrank:1.2.0/lib/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.12688/f1000research.11223.1","ref_count":0,"refs":[]}]}],"