{"tool_name":"mhcflurry","contents":["biocontainers","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"mhcflurry","version":"2.2.1","home":"https://github.com/openvax/mhcflurry","documentation":"https://openvax.github.io/mhcflurry","license":"Apache-2.0","summary":"MHC Binding Predictor","identifiers":["doi:10.1016/j.cels.2020.06.010","doi:10.1016/j.cels.2018.05.014","biotools:mhcflurry"],"license_file":"LICENSE","build":{"entry_points":["mhcflurry-downloads = mhcflurry.downloads_command:run","mhcflurry-predict = mhcflurry.predict_command:run","mhcflurry-predict-scan = mhcflurry.predict_scan_command:run","mhcflurry-class1-train-allele-specific-models = mhcflurry.train_allele_specific_models_command:run","mhcflurry-class1-train-pan-allele-models = mhcflurry.train_pan_allele_models_command:run","mhcflurry-class1-train-processing-models = mhcflurry.train_processing_models_command:run","mhcflurry-class1-select-allele-specific-models = mhcflurry.select_allele_specific_models_command:run","mhcflurry-class1-select-pan-allele-models = mhcflurry.select_pan_allele_models_command:run","mhcflurry-class1-select-processing-models = mhcflurry.select_processing_models_command:run","mhcflurry-calibrate-percentile-ranks = mhcflurry.calibrate_percentile_ranks_command:run","mhcflurry-class1-train-presentation-models = mhcflurry.train_presentation_models_command:run","mhcflurry-cluster-worker-entry-point = mhcflurry.cluster_parallelism:worker_entry_point"],"noarch":"python","number":0,"run_exports":[null],"script":"-m pip install . --no-deps --no-build-isolation --no-cache-dir -vvv"},"requirements":{"host":["python >=3.10,<3.13","pip","setuptools"],"run":["python >=3.10,<3.13","pandas >=2.0","appdirs","scikit-learn","mhcgnomes >=3.0.1","numpy >=1.22.4","pytorch >=2.0.0","pyyaml","tqdm"]},"source_url":"https://pypi.org/packages/source/m/mhcflurry/mhcflurry-2.2.1.tar.gz","test":{"commands":["mhcflurry-downloads --help","mhcflurry-predict --help","mhcflurry-predict-scan --help","mhcflurry-class1-train-allele-specific-models --help","mhcflurry-class1-train-pan-allele-models --help","mhcflurry-class1-train-processing-models --help","mhcflurry-class1-select-allele-specific-models --help","mhcflurry-class1-select-pan-allele-models --help","mhcflurry-class1-select-processing-models --help","mhcflurry-calibrate-percentile-ranks --help","mhcflurry-class1-train-presentation-models --help","mhcflurry-cluster-worker-entry-point --help"],"imports":["mhcflurry"]},"recipe_maintainers":["jonasscheid"]},"biocontainers":{"name":"mhcflurry","identifiers":["biotools:mhcflurry","doi:10.1016/j.cels.2018.05.014"],"license":"Apache-2.0","summary":"Peptide-MHC I binding affinity prediction","home_url":"https://github.com/hammerlab/mhcflurry","keywords":["Animals","Forecasting","Genes, MHC Class I","Histocompatibility Antigens Class I","Humans","Ligands","Neural Networks, Computer","Peptides","Protein Binding","Immunology","Immunoproteins, genes and antigens","Protein interactions","Protein Sequences"],"manually_check":true,"total_pulls":7},"biotools":{"id":"mhcflurry","home":"https://github.com/openvax/mhcflurry","license":"Apache-2.0","summary":"A software package that can predict peptide binding affinity to major histocompatability complex I. The software implements allele-specific neural networks that use a novel architecture and peptide encoding scheme.","addition_date":"2018-08-06T04:08:56Z","last_update_date":"2018-12-10T12:59:01Z","tool_type":["Command-line tool"],"version":["1.2.0"],"biotools_curie":"biotools:mhcflurry","credit":[{"email":"timothy.odonnell@icahn.mssm.edu","name":"Timothy J. O'Donnell","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"https://openvax.github.io/mhcflurry/index.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Peptide immunogenicity prediction","uri":"http://edamontology.org/operation_0252"}]}],"name":"MHCflurry","operating_system":["Mac","Windows"],"owner":"daniel_stefan","publication":[{"doi":"10.1016/j.cels.2018.05.014","metadata":{"abstract":"\u00a9 2018 The AuthorsPredicting the binding affinity of major histocompatibility complex I (MHC I) proteins and their peptide ligands is important for vaccine design. We introduce an open-source package for MHC I binding prediction, MHCflurry. The software implements allele-specific neural networks that use a novel architecture and peptide encoding scheme. When trained on affinity measurements, MHCflurry outperformed the standard predictors NetMHC 4.0 and NetMHCpan 3.0 overall and particularly on non-9-mer peptides in a benchmark of ligands identified by mass spectrometry. The released predictor, MHCflurry 1.2.0, uses mass spectrometry datasets for model selection and showed competitive accuracy with standard tools, including the recently released NetMHCpan 4.0, on a small benchmark of affinity measurements. MHCflurry's prediction speed exceeded 7,000 predictions per second, 396 times faster than NetMHCpan 4.0. MHCflurry is freely available to use, retrain, or extend, includes Python library and command line interfaces, may be installed using package managers, and applies software development best practices. Accurate prediction servers for MHC I ligands have been in wide use for some time, but these tools are typically closed source, may be trained only by their developers, and can be challenging to integrate into high-throughput workflows required for tumor neoantigen discovery. We introduce a prediction package that exposes a programmatic interface, may be modified and re-retrained, and is much faster than existing tools.","authors":[{"name":"Bonsack M."},{"name":"Hammerbacher J."},{"name":"Laserson U."},{"name":"O'Donnell T.J."},{"name":"Riemer A.B."},{"name":"Rubinsteyn A."}],"citationCount":126,"date":"2018-07-25T00:00:00Z","journal":"Cell Systems","title":"MHCflurry: Open-Source Class I MHC Binding Affinity Prediction"},"pmid":"29960884","type":["Primary"]}],"topic":[{"term":"Immunology","uri":"http://edamontology.org/topic_0804"},{"term":"Immunoproteins, genes and antigens","uri":"http://edamontology.org/topic_2830"},{"term":"Protein interactions","uri":"http://edamontology.org/topic_0128"}],"validated":1},"bioschemas":{"name":"MHCflurry","home":"https://bio.tools/mhcflurry","license":"Apache-2.0","version":"1.2.0","summary":"A software package that can predict peptide binding affinity to major histocompatability complex I. The software implements allele-specific neural networks that use a novel architecture and peptide encoding scheme.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mhcflurry:1.2.0/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":244,"citations":[{"count":1,"year":"-1"},{"count":6,"year":"2018"},{"count":14,"year":"2026"},{"count":28,"year":"2019"},{"count":28,"year":"2022"},{"count":28,"year":"2023"},{"count":29,"year":"2021"},{"count":30,"year":"2025"},{"count":34,"year":"2024"},{"count":46,"year":"2020"}],"doi":"10.1016/j.cels.2018.05.014","pmid":"29960884","ref_count":0,"refs":[],"title":"MHCflurry: Open-Source Class I MHC Binding Affinity Prediction.","year":2018}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://github.com/openvax/mhcflurry"}],"ssl":true,"ssl_err":null}},"support":{"email":true,"issue_trac