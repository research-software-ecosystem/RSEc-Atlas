d 3D video and is able to correct drift in all x-, y- and/or z-directions. Fast4DReg creates intensity projections along both axes and estimates their drift using cross-correlation based drift correction, and then translates the video frame by frame. Additionally, Fast4DReg can be used for alignment multi-channel 2D or 3D images which is particularly useful for instruments that suffer from a misalignment of channels.</p>\r\n"}],"changed":[{"format":"Y-m-d\\TH:i:sP","value":"2024-10-25T13:19:56+00:00"}],"created":[{"format":"Y-m-d\\TH:i:sP","value":"2024-10-25T13:00:57+00:00"}],"default_langcode":[{"value":true}],"attribution_instructions":[],"comments_2023":[{"cid":0,"comment_count":0,"last_comment_name":null,"last_comment_timestamp":1729861706,"last_comment_uid":4010,"status":2}],"free_tagging":[],"give_feedback_on_this_soft":[{"cid":0,"comment_count":0,"last_comment_name":null,"last_comment_timestamp":1729861706,"last_comment_uid":4010,"status":2}],"has_author":[{"value":"Pylv\u00e4n\u00e4inen W. Joanna orcid.org/0000-0002-3540-5150"},{"value":"Jacquemet Guillaume orcid.org/0000-0002-9286-920X"}],"has_biological_terms":[],"has_comparison":[],"has_documentation":[{"options":[],"title":"Documentation","uri":"https://github.com/CellMigrationLab/Fast4DReg"}],"has_doi":[],"has_entry_curator":[{"target_id":4010,"target_type":"user","target_uuid":"8e486342-1b2d-4946-a1c7-e1ac83a37c90","url":"/user/4010"}],"has_function":[{"target_id":4055,"target_type":"taxonomy_term","target_uuid":"http://edamontology.org/operation_Image_registration","url":"/image-registration"}],"has_implementation":[{"target_id":4340,"target_type":"taxonomy_term","target_uuid":"6077b127-35d6-45a8-ac32-b321e9bd18f2","url":"/taxonomy/term/4340"}],"has_interaction_level":[{"target_id":3574,"target_type":"taxonomy_term","target_uuid":"a22a3a50-0fbb-41ee-944a-38e0b86ac077","url":"/taxonomy/term/3574"},{"target_id":3573,"target_type":"taxonomy_term","target_uuid":"43cf6a59-36ad-49c8-9baa-3c5494481f13","url