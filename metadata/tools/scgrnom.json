{"tool_name":"scgrnom","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"scgrnom","home":"https://github.com/daifengwanglab/scGRNom","license":"Not licensed","summary":"A computational pipeline of integrative multi-omics analyses for predicting cell-type disease genes and regulatory networks.","addition_date":"2021-10-05T14:41:28.227766Z","last_update_date":"2021-10-05T14:41:28.230094Z","tool_type":["Plug-in"],"biotools_curie":"biotools:scgrnom","cost":"Free of charge","credit":[{"email":"daifeng.wang@wisc.edu","name":"Daifeng Wang","orcidid":"https://orcid.org/0000-0001-9190-3704","typeEntity":"Person"}],"documentation":[{"type":["General"],"url":"https://github.com/daifengwanglab/scGRNom"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene regulatory network analysis","uri":"http://edamontology.org/operation_1781"},{"term":"Gene regulatory network prediction","uri":"http://edamontology.org/operation_2437"},{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Imputation","uri":"http://edamontology.org/operation_3557"},{"term":"Transcriptional regulatory element prediction","uri":"http://edamontology.org/operation_0438"}]}],"name":"scGRNom","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1186/S13073-021-00908-9","metadata":{"abstract":"\u00a9 2021, The Author(s).Understanding cell-type-specific gene regulatory mechanisms from genetic variants to diseases remains challenging. To address this, we developed a computational pipeline, scGRNom (single-cell Gene Regulatory Network prediction from multi-omics), to predict cell-type disease genes and regulatory networks including transcription factors and regulatory elements. With applications to schizophrenia and Alzheimer\u2019s disease, we predicted disease genes and regulatory networks for excitatory and inhibitory neurons, microglia, and oligodendrocytes. Further enrichment analyses revealed cross-disease and disease-specific functions and pathways at the cell-type level. Our machine learning analysis also found that cell-type disease genes improved clinical phenotype predictions. scGRNom is a general-purpose tool available at https://github.com/daifengwanglab/scGRNom.","authors":[{"name":"Huang J."},{"name":"Jin T."},{"name":"Liu S."},{"name":"Rehani P."},{"name":"Roussos P."},{"name":"Wang D."},{"name":"Ying M."}],"citationCount":1,"date":"2021-12-01T00:00:00Z","journal":"Genome Medicine","title":"scGRNom: a computational pipeline of integrative multi-omics analyses for predicting cell-type disease genes and regulatory networks"},"pmcid":"PMC8161957","pmid":"34044854"}],"topic":[{"term":"Epigenomics","uri":"http://edamontology.org/topic_3173"},{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Pathology","uri":"http://edamontology.org/topic_0634"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"}],"validated":1},"bioschemas":{"name":"scGRNom","home":"https://bio.tools/scgrnom","license":"Not licensed","summary":"A computational pipeline of integrative multi-omics analyses for predicting cell-type disease genes and regulatory networks.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:scgrnom/plugin/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":2