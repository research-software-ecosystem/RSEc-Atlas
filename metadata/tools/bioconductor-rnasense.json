{"tool_name":"bioconductor-rnasense","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-rnasense","identifiers":["doi:10.18129/b9.bioc.rnasense"],"license":"GPL-3","summary":"Analysis of Time-Resolved RNA-Seq Data","home_url":"https://bioconductor.org/packages/3.10/bioc/html/RNAsense.html","keywords":["RNA-Seq"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-rnasense","home":"https://bioconductor.org/packages/RNAsense","license":"GPL-3.0","summary":"RNA-sense tool compares RNA-seq time curves in two experimental conditions, i.e. wild-type and mutant, and works in three steps. At Step 1, it builds expression profile for each transcript in one condition (i.e. wild-type) and tests if the transcript abundance grows or decays significantly. Dynamic transcripts are then sorted to non-overlapping groups (time profiles) by the time point of switch up or down. At Step 2, RNA-sense outputs the groups of differentially expressed transcripts, which are up- or downregulated in the mutant compared to the wild-type at each time point. At Step 3, Correlations (Fisher's exact test) between the outputs of Step 1 (switch up- and switch down- time profile groups) and the outputs of Step2 (differentially expressed transcript groups) are calculated. The results of the correlation analysis are printed as two-dimensional color plot, with time profiles and differential expression groups at y- and x-axis, respectively, and facilitates the biological interpretation of the data.","tool_type":["Command-line tool","Library"],"version":["1.26.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-rnasense","credit":[{"name":"Daria Onichtchouk","typeEntity":"Person","typeRole":["Developer"]},{"name":"Gao Meijang","typeEntity":"Person","typeRole":["Developer"]},{"name":"Helge Hass","typeEntity":"Person","typeRole":["Developer"]},{"name":"Marcus Rosenblatt","typeEntity":"Person","typeRole":["Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/RNAsense"}],"name":"RNAsense","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.18129/B9.bioc.RNAsense"}]},"bioschemas":{"name":"RNAsense","home":"https://bio.tools/bioconductor-rnasense","license":"GPL-3.0-only","version":"1.26.0","summary":"RNA-sense tool compares RNA-seq time curves in two experimental conditions, i.e. wild-type and mutant, and works in three steps. At Step 1, it builds expression profile for each transcript in one condition (i.e. wild-type) and tests if the transcript abundance grows or decays significantly. Dynamic transcripts are then sorted to non-overlapping groups (time profiles) by the time point of switch up or down. At Step 2, RNA-sense outputs the groups of differentially expressed transcripts, which are up- or downregulated in the mutant compared to the wild-type at each time point. At Step 3, Correlations (Fisher's exact test) between the outputs of Step 1 (switch up- and switch down- time profile groups) and the outputs of Step2 (differentially expressed transcript groups) are calculated. The results of the correlation analysis are printed as two-dimensional color plot, with time profiles and differential expression groups at y- and x-axis, respectively, and facilitates the biological interpretation of the data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-rnasense:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openeb