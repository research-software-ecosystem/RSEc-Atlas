{"tool_name":"chewbbaca","contents":["bioconda","biocontainers","bioschemas","biotools","galaxy","oeb"],"identifiers":["biotools:chewbbaca","bioconda:chewbbaca","galaxy:chewbbaca"],"fetched_metadata":{"biocontainers":{"name":"chewbbaca","identifiers":["doi:10.1099/mgen.0.000166"],"license":"GNU General Public License v3.0","summary":"A complete suite for gene-by-gene schema creation and strain identification","home_url":"https://github.com/B-UMMI/chewBBACA","keywords":["Genomics"],"manually_check":true,"total_pulls":0},"biotools":{"id":"chewbbaca","home":"https://github.com/B-UMMI/chewBBACA","license":"GPL-3.0","summary":"chewBBACA is a software suite for the creation and evaluation of core genome and whole genome MultiLocus Sequence Typing (cg/wgMLST) schemas and results.","addition_date":"2025-03-17T15:56:34.552871Z","last_update_date":"2025-03-19T14:47:22.843193Z","tool_type":["Command-line tool","Library"],"accessibility":"Open access","biotools_curie":"biotools:chewbbaca","cost":"Free of charge","documentation":[{"type":["User manual"],"url":"https://chewbbaca.readthedocs.io/en/latest/index.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Multilocus sequence typing","uri":"http://edamontology.org/operation_3840"}]}],"name":"chewBBaca","operating_system":["Linux","Mac","Windows"],"owner":"EngyNasr","publication":[{"doi":"10.1099/MGEN.0.000166","metadata":{"abstract":"Gene-by-gene approaches are becoming increasingly popular in bacterial genomic epidemiology and outbreak detection. However, there is a lack of open-source scalable software for schema definition and allele calling for these methodologies. The chewBBACA suite was designed to assist users in the creation and evaluation of novel whole-genome or core-genome gene-by-gene typing schemas and subsequent allele calling in bacterial strains of interest. chewBBACA performs the schema creation and allele calls on complete or draft genomes resulting from de novo assemblers. The chewBBACA software uses Python 3.4 or higher and can run on a laptop or in high performance clusters making it useful for both small laboratories and large reference centers. ChewBBACA is available at https://github.com/B-UMMI/chewBBACA.","authors":[{"name":"Carrico J.A."},{"name":"Machado M.P."},{"name":"Moran-Gilad J."},{"name":"Ramirez M."},{"name":"Rossi M."},{"name":"Santos S."},{"name":"Silva D.N."},{"name":"Silva M."}],"citationCount":276,"date":"2018-03-01T00:00:00Z","journal":"Microbial genomics","title":"chewBBACA: A complete suite for gene-by-gene schema creation and strain identification"},"pmcid":"PMC5885018","pmid":"29543149"}],"topic":[{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Phylogenetics","uri":"http://edamontology.org/topic_3293"}]},"bioschemas":{"name":"chewBBaca","home":"https://bio.tools/chewbbaca","license":"GPL-3.0","summary":"chewBBACA is a software suite for the creation and evaluation of core genome and whole genome MultiLocus Sequence Typing (cg/wgMLST) schemas and results.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:chewbbaca/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":340,"citations":[{"count":1,"year":2017},{"count":1,"year":2018},{"count":10,"year":2019},{"count":21,"year":2020},{"count":32,"year":2021},{"count":39,"year":2022},{"count":45,"year":2023},{"count":50,"year":2024},{"count":65,"year":2026},{"count":76,"year":2025}],"doi":"10.1099/mgen.0.000166","pmcid":"PMC5885018","pmid":"29543149","ref_count":16,"refs":[{"count":1,"year":1990},{"count":1,"year":1998},{"count":1,"year":2002},{"count":1,"year":2003},{"count":1,"year":2005},{"count":1,"ye