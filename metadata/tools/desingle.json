{"tool_name":"desingle","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"desingle","home":"https://bioconductor.org/packages/DEsingle","license":"GPL-2.0","summary":"DEsingle is an R package for differential expression (DE) analysis of single-cell RNA-seq (scRNA-seq) data. It defines and detects 3 types of differentially expressed genes between two groups of single cells, with regard to different expression status (DEs), differential expression abundance (DEa), and general differential expression (DEg). DEsingle employs Zero-Inflated Negative Binomial model to estimate the proportion of real and dropout zeros and to define and detect the 3 types of DE genes. Results showed that DEsingle outperforms existing methods for scRNA-seq DE analysis, and can reveal different types of DE genes that are enriched in different biological functions.","addition_date":"2018-07-08T12:46:29Z","last_update_date":"2026-09-01T06:40:58.203184Z","tool_type":["Library"],"version":["1.32.0"],"collections":["BioConductor"],"biotools_curie":"biotools:desingle","credit":[{"name":"Zhun Miao"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/DEsingle"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Differential gene expression analysis","uri":"http://edamontology.org/operation_3223"}]}],"name":"DEsingle","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[{"doi":"10.1093/bioinformatics/bty332"}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"DEsingle","home":"https://bio.tools/desingle","license":"GPL-2.0-only","version":"1.32.0","summary":"DEsingle is an R package for differential expression (DE) analysis of single-cell RNA-seq (scRNA-seq) data. It defines and detects 3 types of differentially expressed genes between two groups of single cells, with regard to different expression status (DEs), differential expression abundance (DEa), and general differential expression (DEg). DEsingle employs Zero-Inflated Negative Binomial model to estimate the proportion of real and dropout zeros and to define and detect the 3 types of DE genes. Results showed that DEsingle outperforms existing methods for scRNA-seq DE analysis, and can reveal different types of DE genes that are enriched in different biological functions.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:desingle:1.0.4/lib/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"source_packages":true,"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":146,"citations":[{"count":8,"year":"2019"},{"count":11,"year":"2026"},{"count":13,"year":"2025"},{"count":17,"year":"2020"},{"count":22,"year":"2021"},{"count":22,"year":"2024"},{"count":24,"year":"2023"},{"count":29,"year":"2022"}],"doi":"10.1093/bioinformatics/bty332","pmid":"29688277","ref_count":0,"refs":[],"title":"DEsingle for detecting three types of differential expression in single-cell RNA-seq data.","year":2018}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://bioconductor.org/packages/release/bioc/html/DEsingle.html"}],"ssl":true,"ssl_err":null}},"support":{"email":true}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:desingle:1.10.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda",