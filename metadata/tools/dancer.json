{"tool_name":"dancer","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"dancer","home":"http://ekhidna.biocenter.helsinki.fi/poxo/dancer","summary":"Digital Anatomy Constructor is a program that can be used to reconstruct anatomical pictures. In general, it fills color into drawn shapes that collectively form a picture that represents the data. The main data source of this program is microarray data, but in situ hybridization-, Northern Blot-, Southern Blot- or any other data can be used. As a result, a picture is produced where the shapes are filled with color that corresponds to the gene expression level.","addition_date":"2017-12-18T00:05:44Z","last_update_date":"2018-12-10T12:58:59Z","tool_type":["Desktop application"],"version":["1.1.1"],"biotools_curie":"biotools:dancer","credit":[{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://ekhidna.biocenter.helsinki.fi/frontpage"}],"documentation":[{"type":["General"],"url":"http://ekhidna.biocenter.helsinki.fi/poxo/dancer"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Image analysis","uri":"http://edamontology.org/operation_3443"}]}],"name":"Dancer","operating_system":["Windows"],"owner":"mbs_import","topic":[{"term":"Anatomy","uri":"http://edamontology.org/topic_3067"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:dancer:1.1.1/app/ekhidna.biocenter.helsinki.fi","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"ref_count":0,"refs":[]}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":404,"ssl":null,"ssl_err":null}},"support":{"email":false}},{"@id":"https://openebench.bsc.es/mo