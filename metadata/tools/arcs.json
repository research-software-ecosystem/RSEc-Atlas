{"tool_name":"arcs","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"arcs","identifiers":["doi:10.1101/100750","doi:10.1186/s12859-018-2243-x"],"license":"GPL-3.0","summary":"Scaffolding genome sequence assemblies using 10X Genomics data","home_url":"https://github.com/bcgsc/arcs","keywords":["Genomics"],"manually_check":true,"total_pulls":4},"biotools":{"id":"arcs","home":"https://github.com/bcgsc/ARCS/","license":"GPL-3.0","summary":"Scaffolding genome assemblies using 10X Genomics Chromium data or stLFR linked reads","addition_date":"2022-09-09T02:07:03.049889Z","last_update_date":"2024-11-24T15:40:30.715422Z","tool_type":["Command-line tool"],"version":["1.2.4"],"biotools_curie":"biotools:arcs","edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Genome assembly","uri":"http://edamontology.org/operation_0525"},{"term":"Scaffolding","uri":"http://edamontology.org/operation_3216"}]}],"name":"ARCS","owner":"alexcorm","publication":[{"doi":"10.1093/bioinformatics/btx675","metadata":{"abstract":"Motivation Sequencing of human genomes is now routine, and assembly of shotgun reads is increasingly feasible. However, assemblies often fail to inform about chromosome-scale structure due to a lack of linkage information over long stretches of DNA - a shortcoming that is being addressed by new sequencing protocols, such as the GemCode and Chromium linked reads from 10 \u00d7 Genomics. Results Here, we present ARCS, an application that utilizes the barcoding information contained in linked reads to further organize draft genomes into highly contiguous assemblies. We show how the contiguity of an ABySS H.sapiens genome assembly can be increased over six-fold, using moderate coverage (25-fold) Chromium data. We expect ARCS to have broad utility in harnessing the barcoding information contained in linked read data for connecting high-quality sequences in genome assembly drafts.","authors":[{"name":"Birol I."},{"name":"Chu J."},{"name":"Coombe L."},{"name":"Warren R.L."},{"name":"Yeo S."}],"citationCount":111,"date":"2018-03-01T00:00:00Z","journal":"Bioinformatics","title":"ARCS: Scaffolding genome drafts with linked reads"},"pmcid":"PMC6030987","pmid":"29069293"}],"topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"}]},"bioschemas":{"name":"ARCS","home":"https://bio.tools/arcs","license":"GPL-3.0","version":"1.2.4","summary":"Scaffolding genome assemblies using 10X Genomics Chromium data or stLFR linked reads","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:arcs:1.2.4/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":107,"citations":[{"count":1,"year":"2017"},{"count":2,"year":"2026"},{"count":6,"year":"2018"},{"count":9,"year":"2020"},{"count":10,"year":"2019"},{"count":11,"year":"2025"},{"count":15,"year":"2024"},{"count":17,"year":"2022"},{"count":17,"year":"2023"},{"count":19,"year":"2021"}],"doi":"10.1093/bioinformatics/btx675","pmcid":"PMC6030987","pmid":"29069293","ref_count":17,"refs":[{"count":1,"year":"1990"},{"count":1,"year":"2009"},{"count":1,"year":"2010"},{"count":2,"year":"2017"},{"count":3,"year":"2014"},{"count":3,"year":"2015"},{"count":6,"year":"2016"}],"title":"ARCS: scaffolding genome drafts with linked reads.","year":2018}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational