{"tool_name":"bioconductor-sracipe","contents":["oeb","bioschemas","biocontainers","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-sracipe","identifiers":["doi:10.18129/b9.bioc.sracipe"],"license":"MIT","summary":"Systems biology tool to simulate gene regulatory circuits","home_url":"https://bioconductor.org/packages/3.9/bioc/html/sRACIPE.html","keywords":["Gene Expression"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-sracipe","home":"https://bioconductor.org/packages/sRACIPE","license":"MIT","summary":"sRACIPE implements a randomization-based method for gene circuit modeling. It allows us to study the effect of both the gene expression noise and the parametric variation on any gene regulatory circuit (GRC) using only its topology, and simulates an ensemble of models with random kinetic parameters at multiple noise levels. Statistical analysis of the generated gene expressions reveals the basin of attraction and stability of various phenotypic states and their changes associated with intrinsic and extrinsic noises. sRACIPE provides a holistic picture to evaluate the effects of both the stochastic nature of cellular processes and the parametric variation.","addition_date":"2026-09-01T07:32:16.055070Z","last_update_date":"2026-09-01T07:32:16.058086Z","tool_type":["Command-line tool","Library"],"version":["2.4.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-sracipe","credit":[{"name":"Aidan Tillman","typeEntity":"Person","typeRole":["Developer"]},{"name":"Daniel Ramirez","typeEntity":"Person","typeRole":["Developer"]},{"name":"Mingyang Lu","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Vivek Kohar","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/sRACIPE"}],"edit_permission":{"type":"private"},"name":"sRACIPE","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{