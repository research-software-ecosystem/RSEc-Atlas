{"tool_name":"ropls","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-ropls","version":"1.42.0","home":"https://bioconductor.org/packages/3.22/bioc/html/ropls.html","license":"CeCILL","summary":"PCA, PLS(-DA) and OPLS(-DA) for multivariate analysis and feature selection of omics data","identifiers":["biotools:ropls"],"description":"Latent variable modeling with Principal Component Analysis (PCA) and Partial Least Squares (PLS) are powerful methods for visualization, regression, classification, and feature selection of omics data where the number of variables exceeds the number of samples and with multicollinearity among variables. Orthogonal Partial Least Squares (OPLS) enables to separately model the variation correlated (predictive) to the factor of interest and the uncorrelated (orthogonal) variation. While performing similarly to PLS, OPLS facilitates interpretation. Successful applications of these chemometrics techniques include spectroscopic data such as Raman spectroscopy, nuclear magnetic resonance (NMR), mass spectrometry (MS) in metabolomics and proteomics, but also transcriptomics data. In addition to scores, loadings and weights plots, the package provides metrics and graphics to determine the optimal number of components (e.g. with the R2 and Q2 coefficients), check the validity of the model by permutation testing, detect outliers, and perform feature selection (e.g. with Variable Importance in Projection or regression coefficients). The package can be accessed via a user interface on the Workflow4Metabolomics.org online resource for computational metabolomics (built upon the Galaxy environment).","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-biobase >=2.70.0,<2.71.0","bioconductor-multiassayexperiment >=1.36.0,<1.37.0","bioconductor-multidataset >=1.38.0,<1.39.0","bioconductor-summarizedexperiment >=1.40.0,<1.41.0","r-base","r-ggplot2","r-plotly"],"run":["bioconductor-biobase >=2.70.0,<2.71.0","bioconductor-multiassayexperiment >=1.36.0,<1.37.0","bioconductor-multidataset >=1.38.0,<1.39.0","bioconductor-summarizedexperiment >=1.40.0,<1.41.0","r-base","r-ggplot2","r-plotly"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/ropls_1.42.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ropls/ropls_1.42.0.tar.gz","https://bioarchive.galaxyproject.org/ropls_1.42.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-ropls/bioconductor-ropls_1.42.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('ropls')\""]},"parent_recipe":{"name":"bioconductor-ropls","path":"recipes/bioconductor-ropls","version":"1.12.0"}},"biotools":{"id":"ropls","home":"https://bioconductor.org/packages/ropls","license":"CECILL-2.1","summary":"Latent variable modeling with Principal Component Analysis (PCA) and Partial Least Squares (PLS) are powerful methods for visualization, regression, classification, and feature selection of omics data where the number of variables exceeds the number of samples and with multicollinearity among variables. Orthogonal Partial Least Squares (OPLS) enables to separately model the variation correlated (predictive) to the factor of interest and the uncorrelated (orthogonal) variation. While performing similarly to PLS, OPLS facilitates interpretation. Successful applications of these chemometrics techniques include spectroscopic data such as Raman spectroscopy, nuclear magnetic resonance (NMR), mass spectrometry (MS) in metabolomics and proteomics, but also transcriptomics data. In addition to scores, loadings and weights plots, the package provides metrics and graphics to determine the optimal number of components (e.g. with the R2 and Q2 coefficients), check the validity of the model by permutation testing, detect outliers, and perform feature selection (e.g. with Variable Importance in Projection or regression coefficients). The package can be accessed via a user interface on the Workflow4Metabolomics.org online resource for computational metabolomics (built upon the Galaxy environment).","addition_date":"2017-01-17T15:00:30Z","last_update_date":"2019-01-11T01:07:05Z","tool_type":["Command-line tool","Library"],"version":["1.44.0"],"collections":["BioConductor"],"biotools_curie":"biotools:ropls","credit":[{"name":"Etienne A. Thevenot","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/ropls"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genome visualisation","uri":"http://edamontology.org/operation_3208"},{"term":"Regression analysis","uri":"http://edamontology.org/operation_3659"},{"term":"Sequence feature detection","uri":"http://edamontology.org/operation_0253"}]}],"name":"ropls","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1021/acs.jproteome.5b00354"}],"topic":[{"term":"Omics","uri":"http://edamontology.org/topic_3391"}],"validated":1},"bioschemas":{"name":"ropls","home":"https://bio.tools/ropls","version":"1.44.0","summary":"Latent variable modeling with Principal Component Analysis (PCA) and Partial Least Squares (PLS) are powerful methods for visualization, regression, classification, and feature selection of omics data where the number of variables exceeds the number of samples and with multicollinearity among variables. Orthogonal Partial Least Squares (OPLS) enables to separately model the variation correlated (predictive) to the factor of interest and the uncorrelated (orthogonal) variation. While performing similarly to PLS, OPLS facilitates interpretation. Successful applications of these chemometrics techniques include spectroscopic data such as Raman spectroscopy, nuclear magnetic resonance (NMR), mass spectrometry (MS) in metabolomics and proteomics, but also transcriptomics data. In addition to scores, loadings and weights plots, the package provides metrics and graphics to determine the optimal number of components (e.g. with the R2 and Q2 coefficients), check the validity of the model by permutation testing, detect outliers, and perform feature selection (e.g. with Variable Importance in Projection or regression coefficients). The package can be accessed via a user interface on the Workflow4Metabolomics.org online resource for computational metabolomics (built upon the Galaxy environment).","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ropls:1.6.2/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":856,"citations":[{"count":2,"year":"-1"},{"count":10,"year":"2016"},{"count":19,"year":"2017"},{"count":24,"year":"2018"},{"count":34,"year":"2019"},{"count":48,"year":"2020"},{"count":76,"year":"2021"},{"count":89,"year":"2023"},{"count":122,"year":"2022"},{"count":123,"year":"2026"},{"count":140,"year":"2024"},{"count":169,"year":"2025"}],"doi":"10.1021/acs.jproteome.5b00354","pmid":"26088811","ref_count":0,"refs":[],"title":"Analysis of the Human Adult Urinary Metabolome Variations with Age, Body Mass Index, and Gender by Implementing a Comprehensive Workflow for Univariate and OPLS Statistical Analyses.","year":2015}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://bioconductor.org/packages/release/bioc/html/ropls.html"}],"ssl":true,"ssl_err":null}},"support":{"email":true}},{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ropls:1.6.2/lib/bioconductor.org","@license":