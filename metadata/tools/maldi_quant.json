{"tool_name":"maldi_quant","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"maldi_quant","home":"https://cran.r-project.org/package=MALDIquant","license":"GPL-3.0","summary":"MALDIquant is a complete analysis pipeline for matrix-assisted laser desorption/ionization-time-of-flight (MALDI-TOF) and other two-dimensional mass spectrometry data. In addition to commonly used plotting and processing methods it includes distinctive features, namely baseline subtraction methods such as morphological filters (TopHat) or the statistics-sensitive non-linear iterative peak-clipping algorithm (SNIP), peak alignment using warping functions, handling of replicated measurements as well as allowing spectra with different resolutions.","addition_date":"2021-05-26T20:42:18Z","last_update_date":"2025-06-05T11:28:57.497366Z","tool_type":["Library","Workflow"],"accessibility":"Open access","biotools_curie":"biotools:maldi_quant","cost":"Free of charge","credit":[{"email":"mail@sebastiangibb.de","name":"Sebastian Gibb","orcidid":"https://orcid.org/0000-0001-7406-4443","typeEntity":"Person","typeRole":["Developer","Maintainer","Primary contact"]},{"name":"Korbinian Strimmer","orcidid":"https://orcid.org/0000-0001-7917-2056","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["General"],"url":"https://cran.r-project.org/web/packages/MALDIquant/MALDIquant.pdf"}],"edit_permission":{"authors":["sizhengZhao"],"type":"group"},"function":[{"input":[{"data":{"term":"Mass spectrometry data","uri":"http://edamontology.org/data_2536"},"format":[{"term":"ibd","uri":"http://edamontology.org/format_3839"}]},{"data":{"term":"Mass spectrometry data","uri":"http://edamontology.org/data_2536"},"format":[{"term":"imzML metadata file","uri":"http://edamontology.org/format_3682"}]}],"operation":[{"term":"Mass spectra calibration","uri":"http://edamontology.org/operation_3627"}],"output":[{"data":{"term":"Mass spectrometry data","uri":"http://edamontology.or