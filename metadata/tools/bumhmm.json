{"tool_name":"bumhmm","contents":["bioconda","bioconductor","bioschemas","biotools","oeb"],"identifiers":["biotools:bumhmm","bioconductor:bumhmm","bioconda:bioconductor-bumhmm"],"fetched_metadata":{"biotools":{"id":"bumhmm","home":"https://bioconductor.org/packages/BUMHMM","license":"GPL-3.0","summary":"This is a probabilistic modelling pipeline for computing per- nucleotide posterior probabilities of modification from the data collected in structure probing experiments. The model supports multiple experimental replicates and empirically corrects coverage- and sequence-dependent biases. The model utilises the measure of a \"drop-off rate\" for each nucleotide, which is compared between replicates through a log-ratio (LDR). The LDRs between control replicates define a null distribution of variability in drop-off rate observed by chance and LDRs between treatment and control replicates gets compared to this distribution. Resulting empirical p-values (probability of being \"drawn\" from the null distribution) are used as observations in a Hidden Markov Model with a Beta-Uniform Mixture model used as an emission model. The resulting posterior probabilities indicate the probability of a nucleotide of having being modified in a structure probing experiment.","addition_date":"2018-07-05T11:26:28Z","last_update_date":"2026-09-01T06:34:31.620615Z","tool_type":["Library"],"version":["1.36.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bumhmm","credit":[{"name":"Alina Selega"},{"name":"Guido Sanguinetti"},{"name":"Sander Granneman"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/BUMHMM"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Classification","uri":"http://edamontology.org/operation_2990"}]},{"operation":[{"term":"Regression analysis","uri":"http://edamontology.org/operation_3659"}]}],"name":"BUMHMM","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[{"doi":"10.1038/nmeth.4068"}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Gene regulation","uri":"http://edamontology.org/topic_0204"},{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"Genetics","uri":"http://edamontology.org/topic_3053"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"},{"term":"Structure prediction","uri":"http://edamontology.org/topic_0082"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"BUMHMM","home":"https://bio.tools/bumhmm","license":"GPL-3.0","version":"1.36.0","summary":"This is a probabilistic modelling pipeline for computing per- nucleotide posterior probabilities of modification from the data collected in structure probing experiments. The model supports multiple experimental replicates and empirically corrects coverage- and sequence-dependent biases. The model utilises the measure of a \"drop-off rate\" for each nucleotide, which is compared between replicates through a log-ratio (LDR). The LDRs between control replicates define a null distribution of variability in drop-off rate observed by chance and LDRs between treatment and control replicates gets compared to this distribution. Resulting empirical p-values (probability of being \"drawn\" from the null distribution) are used as observations in a Hidden Markov Model with a Beta-Uniform Mixture model used as an emission model. The resulting posterior probabilities indicate the probability of a nucleotide of having being modified in a structure probing experiment.","tool_type":"sc:SoftwareApplication"},"bioconductor":{"name":"BUMHMM","version":"1.36.0","license":"GPL-3","summary":"Computational pipeline for computing probability of modification from structure probing experiment data","description":"This is a probabilistic m