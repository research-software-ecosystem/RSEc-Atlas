{"tool_name":"bioconductor-tidysinglecellexperiment","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-tidysinglecellexperiment","identifiers":["doi:10.18129/b9.bioc.tidysinglecellexperiment"],"license":"GPL-3","summary":"Brings SingleCellExperiment to the Tidyverse","home_url":"https://bioconductor.org/packages/3.12/bioc/html/tidySingleCellExperiment.html","keywords":["Clustering","Transcriptomics"],"manually_check":true,"total_pulls":120},"biotools":{"id":"bioconductor-tidysinglecellexperiment","home":"https://bioconductor.org/packages/tidySpatialExperiment","license":"GPL-3.0-or-later","summary":"tidySpatialExperiment provides a bridge between the SpatialExperiment package and the tidyverse ecosystem. It creates an invisible layer that allows you to interact with a SpatialExperiment object as if it were a tibble; enabling the use of functions from dplyr, tidyr, ggplot2 and plotly. But, underneath, your data remains a SpatialExperiment object.","addition_date":"2026-08-31T21:26:14.181212Z","last_update_date":"2026-09-01T06:33:28.840333Z","tool_type":["Command-line tool","Library"],"version":["1.8.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-tidysinglecellexperiment","credit":[{"name":"Stefano Mangiola","typeEntity":"Person","typeRole":["Developer"]},{"name":"William Hutchison","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/tidySpatialExperiment"}],"edit_permission":{"type":"private"},"name":"tidySingleCellExperiment","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.1038/s41592-024-02299-2"}]},"bioschemas":{"name":"tidySingleCellExperiment","home":"https://bio.tools/bioconductor-tidysinglecellexperiment","license":"GPL-3.0-only","version":"1.22.0","summary":"'tidySingleCellExperiment' is an adapter that abstracts the 'SingleCellExp