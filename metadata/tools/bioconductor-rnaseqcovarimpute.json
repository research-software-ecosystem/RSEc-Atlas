{"tool_name":"bioconductor-rnaseqcovarimpute","contents":["bioschemas","biotools","oeb"],"fetched_metadata":{"biotools":{"id":"bioconductor-rnaseqcovarimpute","home":"https://bioconductor.org/packages/RNAseqCovarImpute","license":"GPL-3.0","summary":"The RNAseqCovarImpute package makes linear model analysis for RNA sequencing read counts compatible with multiple imputation (MI) of missing covariates. A major problem with implementing MI in RNA sequencing studies is that the outcome data must be included in the imputation prediction models to avoid bias. This is difficult in omics studies with high-dimensional data. The first method we developed in the RNAseqCovarImpute package surmounts the problem of high-dimensional outcome data by binning genes into smaller groups to analyze pseudo-independently.","addition_date":"2026-10-02T16:08:14.931838Z","last_update_date":"2026-10-02T16:08:14.933938Z","tool_type":["Command-line tool","Library"],"version":["1.10.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-rnaseqcovarimpute","credit":[{"name":"Adam Szpiro","typeEntity":"Person","typeRole":["Developer"]},{"name":"Alison Paquette","typeEntity":"Person","typeRole":["Developer"]},{"name":"Brennan Baker","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"James MacDonald","typeEntity":"Person","typeRole":["Developer"]},{"name":"Sheela Sathyanarayana","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/RNAseqCovarImpute"}],"edit_permission":{"type":"private"},"name":"RNAseqCovarImpute","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.18129/B9.bioc.RNAseqCovarImpute"}]},"bioschemas":{"name":"RNAseqCovarImpute","home":"https://bio.tools/bioconductor-rnaseqcovarimpute","license":"GPL-3.0","version":"1.10.0","summary":"The RNAseqCovarImpute package makes linear model analysis for RNA sequencing read counts compatible