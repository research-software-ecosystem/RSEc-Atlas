{"tool_name":"r-circlize","contents":["biocontainers","oeb"],"fetched_metadata":{"biocontainers":{"name":"r-circlize","identifiers":[],"license":"GPL (>= 2)","summary":"Circular layout is an efficient way for the visualization of huge  amounts of information. Here the circlize package provides an implementation  of circular layout generation in R as well as an enhancement of available  software. The flexibility of this package is based on the usage of low-level  graphics functions such that self-defined high-level graphics can be easily  implemented by users for specific purposes. Together with the seamless  connection between the powerful computational and visual environment in R,  circlize gives users more convenience and freedom to design figures for  better understanding complex patterns behind multi-dimensional data.","home_url":"None","keywords":[],"manually_check":true,"total_pulls":0},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:r-circlize:0.3.2/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":true,"resolve_time":"PT1569292S"}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:r-circlize:0.3.3/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":true,"source_packages":true,"sourceco