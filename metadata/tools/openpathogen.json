{"tool_name":"openpathogen","contents":["biotools"],"fetched_metadata":{"biotools":{"id":"openpathogen","home":"https://openpathogen.org","license":"MIT","summary":"Openpathogen detects antimicrobial resistance and virulence genes in sequencing reads entirely inside the web browser. FASTQ files are optionally quality-filtered with fastp and mapped with KMA against ResFinder, CARD and VFDB databases, with results grouped by drug class and virulence category and annotated with CABBAGE tested-resistance rates. The tools are compiled to WebAssembly(wasm) and run on the user's machine, so no account or install is needed.","addition_date":"2026-09-19T21:41:46.864320Z","last_update_date":"2026-09-19T21:55:45.666172Z","tool_type":["Web application"],"accessibility":"Open access","biotools_curie":"biotools:openpathogen","cost":"Free of charge","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Antimicrobial resistance prediction","uri":"http://edamontology.org/operation_3482"}]},{"operation":[{"term":"Read mapping","uri":"http://edamontology.org/operation_3198"}]},{"operation":[{"term":"Sequencing quality control","uri":"http://edamontology.org/operation_3218"}]},{"operation":[{"term":"Virulence prediction","uri":"http://edamontology.org/operation_3461"}]}],"name":"Openpathogen","owner":"amulya","topic":[{"term":"Antimicrobial resistance","uri":"http://edamontology.org/topic_4013"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Microbiology","uri":"http://edamontology.org/topic_3301"},{"term":"Public health and epidemiology","uri":"http://edamontology.org/topic_3305"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}]}}}