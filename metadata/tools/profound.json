{"tool_name":"profound","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"profound","home":"http://prowl.rockefeller.edu/prowl-cgi/profound.exe","summary":"A tool for searching a protein sequence collections with peptide mass maps. A Bayesian algorithm is used to rank the protein sequences in the database according to their probability of producing the peptide map.","addition_date":"2017-01-17T14:51:17Z","last_update_date":"2024-11-25T14:12:10.591722Z","tool_type":["Web application"],"collections":["Proteomics","ms-utils"],"biotools_curie":"biotools:profound","credit":[{"email":"Brian.Chait@rockefeller.edu","name":"Brian Chait","typeEntity":"Person","typeRole":["Maintainer"]},{"email":"webmaster@ms-utils.org","typeEntity":"Person","typeRole":["Documentor"],"url":"http://ms-utils.org"}],"documentation":[{"type":["General"],"url":"http://prowl.rockefeller.edu/prowl-cgi/profound.exe"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"input":[{"data":{"term":"Peptide mass fingerprint","uri":"http://edamontology.org/data_0944"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}],"operation":[{"term":"Blind peptide database search","uri":"http://edamontology.org/operation_3647"},{"term":"Peptide database search","uri":"http://edamontology.org/operation_3646"},{"term":"Peptide identification","uri":"http://edamontology.org/operation_3631"},{"term":"Protein fragment weight comparison","uri":"http://edamontology.org/operation_2929"},{"term":"Protein identification","uri":"http://edamontology.org/operation_3767"},{"term":"Tag-based peptide identification","uri":"http://edamontology.org/operation_3643"},{"term":"Target-Decoy","uri":"http://edamontology.org/operation_3649"}],"output":[{"data":{"term":"Peptide identification","uri":"http://edamontology.org/data_0945"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"}]}]}],"name":"ProFound","operating_system":["Linux","Mac","Windows"],"owner":"msutils_import","publication":[{"doi":"10.1021/ac991363o","metadata":{"abstract":"We describe the protein search engine 'ProFound', which employs a Bayesian algorithm to identify proteins from protein databases using mass spectrometric peptide mapping data. The algorithm ranks protein candidates by taking into account individual properties of each protein in the database as well as other information relevant to the peptide mapping experiment. The program consistently identifies the correct protein(s) even when the data quality is relatively low or when the sample consists of a simple mixture of proteins. Illustrative examples of protein identifications are provided.","authors":[{"name":"Chait B.T."},{"name":"Zhang W."}],"citationCount":556,"date":"2000-06-01T00:00:00Z","journal":"Analytical Chemistry","title":"ProFound: An expert system for protein identification using mass spectrometric peptide mapping information"},"pmid":"10857624","type":["Primary"]}],"topic":[{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"}],"validated":1},"bioschemas":{"name":"ProFound","home":"https://bio.tools/profound","summary":"A tool for searching a protein sequence collections with peptide mass maps. A Bayesian algorithm is used to rank the protein sequences in the database according to their probability of producing the peptide map.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:profound/web/prowl.rockefeller.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":121,"citations":[{"count":1,"year":"2015"},{"count":1,"year":"2016"},{"count":1,"year":"2021"},{"count":1,"year":"2022"},{"count":1,"year":"2024"},{"count":2,"year":"