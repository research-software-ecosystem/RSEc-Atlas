{"tool_name":"fetchm","contents":["biotools"],"identifiers":["biotools:fetchm"],"fetched_metadata":{"biotools":{"id":"fetchm","home":"https://pypi.org/project/fetchm/","license":"MIT","summary":"fetchm is a command-line Python tool designed for bacterial comparative genomics. It automates the retrieval, standardization, and integration of genomic metadata (from NCBI Genome) and biological context (from BioSample) records for large-scale comparative studies.","addition_date":"2026-11-04T17:32:22.008291Z","last_update_date":"2026-11-04T17:32:22.010479Z","biotools_curie":"biotools:fetchm","credit":[{"email":"anowara@du.ac.bd","name":"Anowara Begum","orcidid":"https://orcid.org/0000-0001-9915-3311","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Data retrieval","uri":"http://edamontology.org/operation_2422"},{"term":"Genome assembly","uri":"http://edamontology.org/operation_0525"},{"term":"Scatter plot plotting","uri":"http://edamontology.org/operation_2940"}]}],"name":"fetchm","owner":"pub2tools2024","publication":[{"doi":"10.1093/BIOADV/VBAG124","pmcid":"PMC13176611","pmid":"42148047"}],"topic":[{"term":"Sample collections","uri":"http://edamontology.org/topic_3277"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"},{"term":"Zoology","uri":"http://edamontology.org/topic_3500"}]}}}