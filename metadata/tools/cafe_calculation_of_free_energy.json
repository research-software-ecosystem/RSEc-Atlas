{"tool_name":"cafe_calculation_of_free_energy","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"CaFE_Calculation_of_Free_Energy","home":"https://github.com/huiliucode/cafe_plugin","license":"GPL-3.0","summary":"CaFE (Calculation of Free Energy) - a VMD plugin for binding affinity prediction using end-point free energy methods.","addition_date":"2019-08-04T12:00:46Z","last_update_date":"2024-11-24T21:06:32.316740Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:CaFE_Calculation_of_Free_Energy","cost":"Free of charge","credit":[{"email":"tingjunhou@zju.edu.cn","name":"Tingjun Hou","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"https://github.com/HuiLiuCode/CaFE_Plugin/blob/master/doc/manual.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Molecular docking","uri":"http://edamontology.org/operation_0478"},{"term":"Molecular dynamics","uri":"http://edamontology.org/operation_2476"},{"term":"Phasing","uri":"http://edamontology.org/operation_3454"}]}],"maturity":"Mature","name":"CaFE","operating_system":["Linux","Mac","Windows"],"owner":"Ruta","publication":[{"doi":"10.1093/bioinformatics/btw215","metadata":{"abstract":"Accurate prediction of binding free energy is of particular importance to computational biology and structure-based drug design. Among those methods for binding affinity predictions, the end-point approaches, such as MM/PBSA and LIE, have been widely used because they can achieve a good balance between prediction accuracy and computational cost. Here we present an easy-to-use pipeline tool named Calculation of Free Energy (CaFE) to conduct MM/PBSA and LIE calculations. Powered by the VMD and NAMD programs, CaFE is able to handle numerous static coordinate and molecular dynamics trajectory file formats generated by different molecular simulation packages and supports various force field parameters. Availability and implementation: CaFE source code and documentation are freely available under the GNU General Public License via GitHub at https://github.com/huiliucode/cafe-plugin. It is a VMD plugin written in Tcl and the usage is platform-independent. Contact:","authors":[{"name":"Hou T."},{"name":"Liu H."}],"citationCount":115,"date":"2016-07-15T00:00:00Z","journal":"Bioinformatics","title":"CaFE: A tool for binding affinity prediction using end-point free energy methods"},"pmid":"27153651","type":["Primary"]}],"topic":[{"term":"Immunology","uri":"http://edamontology.org/topic_0804"},{"term":"Medicinal chemistry","uri":"http://edamontology.org/topic_0209"},{"term":"Molecular dynamics","uri":"http://edamontology.org/topic_0176"}]},"bioschemas":{"name":"CaFE","home":"https://bio.tools/CaFE_Calculation_of_Free_Energy","license":"GPL-3.0","summary":"CaFE (Calculation of Free Energy) - a VMD plugin for binding affinity prediction using end-point free energy methods.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:cafe_calculation_of_free_energy/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":59,"citations":[{"count":1,"year":"2017"},{"count":2,"year":"2019"},{"count":4,"year":"2026"},{"count":5,"year":"2024"},{"count":6,"year":"2020"},{"count":9,"year":"2025"},{"count":10,"year":"2023"},{"count":11,"year":"2021"},{"count":11,"year":"2022"}],"doi":"10.1093/bioinformatics/btw215","pmid":"27153651","ref_count":0,"refs":[],"title":"CaF