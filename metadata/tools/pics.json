{"tool_name":"pics","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-pics","version":"2.50.0","home":"https://bioconductor.org/packages/3.20/bioc/html/PICS.html","license":"Artistic-2.0","summary":"Probabilistic inference of ChIP-seq","identifiers":["biotools:pics"],"description":"Probabilistic inference of ChIP-Seq using an empirical Bayes mixture model approach.","build":{"number":1,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"build":[null,"automake","make"],"host":["bioconductor-genomicalignments >=1.42.0,<1.43.0","bioconductor-genomicranges >=1.58.0,<1.59.0","bioconductor-iranges >=2.40.0,<2.41.0","bioconductor-rsamtools >=2.22.0,<2.23.0","r-base","libblas","liblapack"],"run":["bioconductor-genomicalignments >=1.42.0,<1.43.0","bioconductor-genomicranges >=1.58.0,<1.59.0","bioconductor-iranges >=2.40.0,<2.41.0","bioconductor-rsamtools >=2.22.0,<2.23.0","r-base"]},"source_url":["https://bioconductor.org/packages/3.20/bioc/src/contrib/PICS_2.50.0.tar.gz","https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/PICS/PICS_2.50.0.tar.gz","https://bioarchive.galaxyproject.org/PICS_2.50.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-pics/bioconductor-pics_2.50.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('PICS')\""]},"parent_recipe":{"name":"bioconductor-pics","path":"recipes/bioconductor-pics","version":"2.24.0"}},"biotools":{"id":"pics","home":"http://bioconductor.org/packages/release/bioc/html/PICS.html","license":"Artistic-2.0","summary":"Probabilistic inference of ChIP-Seq using an empirical Bayes mixture model approach.","addition_date":"2017-01-17T15:00:03Z","last_update_date":"2018-12-29T14:46:53Z","tool_type":["Command-line tool","Library"],"version":["2.18.0"],"collections":["BioConductor"],"biotools_curie":"biotools:pics","credit":[{"email":"xuekui@uvic.ca","name":"Xuekui Zhang","orcidid":"http://orcid.org/0000-0003-4728-2343","typeEntity":"Person","typeRole":["Contributor"]},{"email":"rsautera@fhcrc.org","name":"Renan Sauteraud","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/html/PICS.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Statistical inference","uri":"http://edamontology.org/operation_3658"}]}],"name":"PICS","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1111/j.1541-0420.2010.01441.x","metadata":{"abstract":"ChIP-seq combines chromatin immunoprecipitation with massively parallel short-read sequencing. While it can profile genome-wide in vivo transcription factor-DNA association with higher sensitivity, specificity, and spatial resolution than ChIP-chip, it poses new challenges for statistical analysis that derive from the complexity of the biological systems characterized and from variability and biases in its sequence data. We propose a method called PICS (Probabilistic Inference for ChIP-seq) for identifying regions bound by transcription factors from aligned reads. PICS identifies binding event locations by modeling local concentrations of directional reads, and uses DNA fragment length prior information to discriminate closely adjacent binding events via a Bayesian hierarchicalt-mixture model. It uses precalculated, whole-genome read mappability profiles and a truncatedt-distribution to adjust binding event models for reads that are missing due to local genome repetitiveness. It estimates uncertainties in model parameters that can be used to define confidence regions on binding event locations and to filter estimates. Finally, PICS calculates a per-event enrichment score relative to a control sample, and can use a control sample to estimate a false discovery rate. Using published GABP and FOXA1 data from human cell lines, we show that PICS' predicted binding sites were more consistent with computationally predicted binding motifs than the alternative methods MACS, QuEST, CisGenome, and USeq. We then use a simulation study to confirm that PICS compares favorably to these methods and is robust to model misspecification. \u00a9 2010, The International Biometric Society.","authors":[{"name":"Droit A."},{"name":"Gottardo R."},{"name":"Jones S."},{"name":"Krzywinski M."},{"name":"Ning K."},{"name":"Robertson G."},{"name":"Zhang X."}],"citationCount":49,"date":"2011-03-01T00:00:00Z","journal":"Biometrics","title":"PICS: Probabilistic Inference for ChIP-seq"},"pmid":"20528864","type":["Primary"]}],"topic":[{"term":"ChIP-seq","uri":"http://edamontology.org/topic_3169"},{"term":"DNA binding sites","uri":"http://edamontology.org/topic_3125"},{"term":"Sequence sites, features and motifs","uri":"http://edamontology.org/topic_0160"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"bioschemas":{"name":"PICS","home":"https://bio.tools/pics","license":"Artistic-2.0","version":"2.18.0","summary":"Probabilistic inference of ChIP-Seq using an empirical Bayes mixture model approach.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pics:2.18.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":46,"citations":[{"count":1,"year":"2022"},{"count":1,"year":"2026"},{"count":2,"year":"2010"},{"count":2,"year":"2015"},{"count":2,"year":"2017"},{"count":2,"year":"2024"},{"count":3,"year":"2018"},{"count":3,"year":"2019"},{"count":4,"year":"2014"},{"count":4,"year":"2020"},{"count":5,"year":"2011"},{"count":5,"year":"2012"},{"count":6,"year":"2013"},{"count":6,"year":"2016"}],"doi":"10.1111/j.1541-0420.2010.01441.x","