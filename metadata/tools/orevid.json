{"tool_name":"orevid","contents":["biotools"],"identifiers":["biotools:orevid"],"fetched_metadata":{"biotools":{"id":"orevid","home":"https://orevid.org","license":"MIT","summary":"Open tool that ranks existing drugs for each disease in a biomedical knowledge graph (PrimeKG extended with Open Targets and STRING) and shows the evidence behind every candidate. Only candidates backed by evidence checked against held-out data are shown, with how often each kind of evidence was right. Includes OREVID-bench, a public, reproducible drug-repurposing benchmark with TxGNN run on the same splits. Research use only: it generates hypotheses and is not a clinical tool.","addition_date":"2026-10-22T08:58:15.568735Z","last_update_date":"2026-10-22T08:58:15.571571Z","tool_type":["Command-line tool","Web application"],"version":["1.2.0"],"accessibility":"Open access","biotools_curie":"biotools:orevid","cost":"Free of charge","credit":[{"email":"contact@orevid.org","name":"Joaquim Quadrada Jan\u00e9","orcidid":"https://orcid.org/0009-0000-9624-332X","typeEntity":"Person","typeRole":["Developer","Maintainer","Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/orevid-org/orevid#readme"},{"type":["Terms of use"],"url":"https://orevid.org/#/legal"},{"type":["User manual"],"url":"https://orevid.org/#/method"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Disease name","uri":"http://edamontology.org/data_3668"}}],"note":"For each disease, ranks ~8,000 drugs by learned knowledge-graph path features (LightGBM LambdaRank) and lists the supporting evidence.","operation":[{"term":"Prediction and recognition","uri":"http://edamontology.org/operation_2423"}],"output":[{"data":{"term":"Drug name","uri":"http://edamontology.org/data_2899"}},{"data":{"term":"Report","uri":"http://edamontology.org/data_2048"}}]}],"maturity":"Emerging","name":"OREVID","operating_system":["Linux","Mac","Windows"],"owner":"joaquim0","publication":[{"doi":"10.20944/preprints202610.1918.v2","type":["Primary"]}],"topic":[{"term":"Data integration and warehousing","uri":"http://edamontology.org/topic_3366"},{"term":"Drug discovery","uri":"http://edamontology.org/topic_3336"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Pharmacology","uri":"http://edamontology.org/topic_0202"},{"term":"Rare diseases","uri":"http://edamontology.org/topic_3325"}]}}}