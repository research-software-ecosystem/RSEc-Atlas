{"tool_name":"bioconductor-mscoreutils","contents":["oeb","bioschemas","biocontainers","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-mscoreutils","identifiers":["doi:10.18129/b9.bioc.mscoreutils"],"license":"Artistic-2.0","summary":"Core Utils for Mass Spectrometry Data","home_url":"https://bioconductor.org/packages/3.11/bioc/html/MsCoreUtils.html","keywords":["Proteomics","Mass spectra","Mass spectrometry","Metabolomics"],"manually_check":true,"total_pulls":4},"biotools":{"id":"bioconductor-mscoreutils","home":"https://bioconductor.org/packages/MsBackendMsp","license":"Artistic-2.0","summary":"Mass spectrometry (MS) data backend supporting import and handling of MS/MS spectra from NIST MSP Format (msp) files. Import of data from files with different MSP *flavours* is supported. Objects from this package add support for MSP files to Bioconductor's Spectra package. This package is thus not supposed to be used without the Spectra package that provides a complete infrastructure for MS data handling.","addition_date":"2026-08-30T02:46:56.830697Z","last_update_date":"2026-09-06T01:51:04.864643Z","tool_type":["Command-line tool","Library"],"version":["1.16.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-mscoreutils","credit":[{"name":"Johannes Rainer","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Michael Witting","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Neumann Steffen","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/MsBackendMsp"}],"edit_permission":{"type":"private"},"name":"MsCoreUtils","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.3390/metabo12020173"}]},"bioschemas":{"name":"MsCoreUtils","home":"https://bio.tools/bioconductor-mscoreutils","license":"Artistic-2.0","version":"1.24.0","summary":"MsCoreUtils defines low-level functions for mass spectro