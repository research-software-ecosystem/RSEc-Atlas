{"tool_name":"bamixchecker","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"BAMixChecker","home":"https://github.com/heinc1010/BAMixChecker","summary":"Automated checkup tool for matched sample pairs in NGS cohort.","addition_date":"2019-07-04T11:49:08Z","last_update_date":"2024-11-25T13:45:03.502051Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:BAMixChecker","cost":"Free of charge","credit":[{"email":"hein17@yuhs.ac","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"swkim@yuhs.ac","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://bamixchecker.readthedocs.io/en/latest/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"SNP detection","uri":"http://edamontology.org/operation_0484"}]}],"maturity":"Mature","name":"BAMixChecker","operating_system":["Linux"],"owner":"Ruta","publication":[{"doi":"10.1093/bioinformatics/btz479","metadata":{"abstract":"Mislabeling in the process of next generation sequencing is a frequent problem that can cause an entire genomic analysis to fail, and a regular cohort-level checkup is needed to ensure that it has not occurred. We developed a new, automated tool (BAMixChecker) that accurately detects sample mismatches from a given BAM file cohort with minimal user intervention. BAMixChecker uses a flexible, data-specific set of single-nucleotide polymorphisms and detects orphan (unpaired) and swapped (mispaired) samples based on genotype-concordance score and entropy-based file name analysis. BAMixChecker shows 100% accuracy in real WES, RNA-Seq and targeted sequencing data cohorts, even for small panels (<50 genes). BAMixChecker provides an HTML-style report that graphically outlines the sample matching status in tables and heatmaps, with which users can quickly inspect any mismatch events.","authors":[{"name":"Chun H."}],"citationCount":6,"date":"2019-11-01T00:00:00Z","journal":"Bioinformatics","title":"BAMixChecker: An automated checkup tool for matched sample pairs in NGS cohort"},"pmcid":"PMC6853765","pmid":"31197312","type":["Primary"]}],"topic":[{"term":"Exome sequencing","uri":"http://edamontology.org/topic_3676"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Whole genome sequencing","uri":"http://edamontology.org/topic_3673"}],"validated":1},"bioschemas":{"name":"BAMixChecker","home":"https://bio.tools/BAMixChecker","summary":"Automated checkup tool for matched sample pairs in NGS cohort.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:bamixchecker/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":5,"citations":[{"count":1,"year":"2025"},{"count":2,"year":"2021"},{"count":2,"year":"2024"}],"doi":"10.1093/bioinformatics/btz479","pmcid":"PMC6853765","pmid":"31197312","ref_count":6,"refs":[{"count":1,"year":"2011"},{"count":1,"year":"2017"},{"count":1,"year":"2018"},{"count":3,"year":"2016"}],"title":"BAMixChecker: an automated checkup tool for matched sample pairs in NGS cohort.","year":2019}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":true,"resolve_time":"PT1092066S"}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bamixchecker","@license":"https://creativecommons.or