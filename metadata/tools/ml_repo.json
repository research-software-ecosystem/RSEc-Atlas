{"tool_name":"ml_repo","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"ML_Repo","home":"https://knights-lab.github.io/MLRepo/","license":"MIT","summary":"Microbiome Learning Repo (ML Repo) - public repository of microbiome regression and classification tasks","addition_date":"2019-08-09T13:12:17Z","last_update_date":"2021-04-22T06:26:23Z","tool_type":["Web application"],"accessibility":"Open access","biotools_curie":"biotools:ML_Repo","cost":"Free of charge","credit":[{"email":"dknights@umn.edu","name":"Dan Knights","orcidid":"https://orcid.org/0000-0002-8205-2511","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Deposition","uri":"http://edamontology.org/operation_3431"},{"term":"Regression analysis","uri":"http://edamontology.org/operation_3659"},{"term":"Sequence trimming","uri":"http://edamontology.org/operation_3192"}]}],"maturity":"Mature","name":"ML Repo","operating_system":["Linux","Mac","Windows"],"owner":"hans","publication":[{"doi":"10.1093/GIGASCIENCE/GIZ042","metadata":{"abstract":"\u00a9 The Author(s) 2019. Published by Oxford University Press. This is an Open Access article distributed under the terms of the Creative Commons Attribution License (http://creativecommons.org/licenses/by/4.0/), which permits unrestricted reuse, distribution, and reproduction in any medium, provided the original work is properly cited.The use of machine learning in high-dimensional biological applications, such as the human microbiome, has grown exponentially in recent years, but algorithm developers often lack the domain expertise required for interpretation and curation of the heterogeneous microbiome datasets. We present Microbiome Learning Repo (ML Repo, available at https://knights-lab.github.io/MLRepo/), a public, web-based repository of 33 curated classification and regression tasks from 15 published human microbiome datasets. We highlight the use of ML Repo in several use cases to demonstrate its wide application, and we expect it to be an important resource for algorithm developers.","authors":[{"name":"Hillmann B.M."},{"name":"Knights D."},{"name":"Vangay P."}],"citationCount":16,"date":"2019-05-01T00:00:00Z","journal":"GigaScience","title":"Microbiome learning Repo (ML Repo): A public repository of microbiome regression and classification tasks"},"pmcid":"PMC6493971","pmid":"31042284","type":["Primary"]}],"topic":[{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Microbial ecology","uri":"http://edamontology.org/topic_3697"}]},"bioschemas":{"name":"ML Repo","home":"https://bio.tools/ML_Repo","license":"MIT","summary":"Microbiome Learning Repo (ML Repo) - public repository of microbiome regression and classification tasks","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ml_repo/web/knights-lab.github.io","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":34,"citations":[{"count":1,"year":"-1"},{"count":1,"year":"2019"},{"count":2,"year":"2023"},{"count":4,"year":"2025"},{"count":5,"year":"2020"},{"count":5,"year":"2024"},{"count":6,"year":"2022"},{"count":10,"year":"2021"}],"doi":"10.1093/gigascience/giz042","pmcid":"PMC6493971","pmid":"31042284","ref_count":28,"refs":[{"count":1,"year":"2000"},{"count":1,"year":"2002"},{"count":1,"year":"2004"},{"count":1,"year":"2008"},{"count":1,"year":"2014"},{"count":1,"year":"2019"},{"count":2,"year