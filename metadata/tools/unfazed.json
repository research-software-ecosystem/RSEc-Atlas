{"tool_name":"unfazed","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"unfazed","identifiers":[],"license":"MIT","summary":"Extended read-backed and allele-balance phasing for de novo variation (snvs, indels, svs, and cnvs)","home_url":"https://github.com/jbelyeu/unfazed","keywords":[],"manually_check":true,"total_pulls":11},"biotools":{"id":"unfazed","home":"https://github.com/jbelyeu/unfazed","summary":"Unfazed is a parent-of-origin detection for large and small de novo variants.\nUnfazed is a command-line tool to determine the parental gamete of origin for de novo mutations from paired-end Illumina DNA sequencing reads. Unfazed uses variant information for a sequenced trio to identify the parental gamete of origin by linking phase-informative inherited variants to de novo mutations using read-based phasing. It achieves a high success rate by chaining reads into haplotype groups, thus increasing the search space for informative sites. Unfazed provides a simple command-line interface and scales well to large inputs, determining parent-of-origin for nearly 30,000 de novo variants in under 60 hours.","addition_date":"2021-03-19T09:03:37Z","last_update_date":"2021-07-07T11:26:19Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:unfazed","credit":[{"email":"aaronquinlan@gmail.com","name":"Aaron R. Quinlan","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Haplotype mapping","uri":"http://edamontology.org/operation_0487"},{"term":"Phasing","uri":"http://edamontology.org/operation_3454"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"},{"term":"de Novo sequencing","uri":"http://edamontology.org/operation_3644"}]}],"name":"Unfazed","owner":"zsmag19","publication":[{"doi":"10.1101/2021.02.03.429658"}],"topic":[{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}]},"bioschemas":{"name":"Unfazed","home":"https://bio.tools/unfazed","summary":"Unfazed is a parent-of-origin detection for large and small de novo variants.\nUnfazed is a command-line tool to determine the parental gamete of origin for de novo mutations from paired-end Illumina DNA sequencing reads. Unfazed uses variant information for a sequenced trio to identify the parental gamete of origin by linking phase-informative inherited variants to de novo mutations using read-based phasing. It achieves a high success rate by chaining reads into haplotype groups, thus increasing the search space for informative sites. Unfazed provides a simple command-line interface and scales well to large inputs, determining parent-of-origin for nearly 30,000 de novo variants in under 60 hours.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:unfazed/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1101/2021.02.03.429658","ref_count":0,"refs":[]}]}],"readme":false,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:unfazed:0.1.5/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"binari