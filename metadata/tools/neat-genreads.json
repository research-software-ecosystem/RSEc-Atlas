{"tool_name":"neat-genreads","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"neat-genreads","home":"https://github.com/zstephens/neat-genreads","license":"GPL-3.0","summary":"A fine-grained read simulator. GenReads simulates real-looking data using models learned from specific datasets. There are several supporting utilities for generating models used for simulation.","addition_date":"2017-08-20T15:58:17Z","last_update_date":"2024-11-25T14:05:14.537171Z","tool_type":["Command-line tool"],"collections":["Animal and Crop Genomics"],"biotools_curie":"biotools:neat-genreads","credit":[{"email":"zstephe2@illinois.edu","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/zstephens/neat-genreads"}],"edit_permission":{"authors":["animalandcropgenomics"],"type":"group"},"function":[{"operation":[{"term":"Modelling and simulation","uri":"http://edamontology.org/operation_2426"},{"term":"Random sequence generation","uri":"http://edamontology.org/operation_0364"}]}],"name":"NEAT-genreads","operating_system":["Linux"],"owner":"admin","publication":[{"doi":"10.1371/journal.pone.0167047","metadata":{"abstract":"An obstacle to validating and benchmarking methods for genome analysis is that there are few reference datasets available for which the \"ground truth\" about the mutational landscape of the sample genome is known and fully validated. Additionally, the free and public availability of real human genome datasets is incompatible with the preservation of donor privacy. In order to better analyze and understand genomic data, we need test datasets that model all variants, reflecting known biology as well as sequencing artifacts. Read simulators can fulfill this requirement, but are often criticized for limited resemblance to true data and overall inflexibility. We present NEAT (NExt-generation sequencing Analysis Toolkit), a set of tools that not only includes an easy-to-use read simulator, but also scripts to facilitate variant comparison and tool evaluation. NEAT has a wide variety of tunable parameters which can be set manually on the default model or parameterized using real datasets. The software is freely available at github.com/zstephens/neat-genreads.","authors":[{"name":"Hudson M.E."},{"name":"Iyer R.K."},{"name":"Mainzer L.S."},{"name":"Stephens Z.D."},{"name":"Taschuk M."},{"name":"Weber M.R."}],"citationCount":46,"date":"2016-11-01T00:00:00Z","journal":"PLoS ONE","title":"Simulating next-generation sequencing datasets from empirical mutation and sequencing models"},"pmcid":"PMC5125660","pmid":"27893777","type":["Primary"]}],"topic":[{"term":"Sequence sites, features and motifs","uri":"http://edamontology.org/topic_0160"},{"term":"Simulation experiment","uri":"http://edamontology.org/topic_3524"}],"validated":1},"bioschemas":{"name":"NEAT-genreads","home":"https://bio.tools/neat-genreads","license":"GPL-3.0","summary":"A fine-grained read simulator. GenReads simulates real-looking data using models learned from specific datasets. There are several supporting utilities for generating models used for simulation.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:neat-genreads/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":52,"citations":[{"count":1,"year":"2018"},{"count":4,"year":"2019"},{"count":5,"year":"2024"},{"count":6,"year":"2021"},{"count":6,"year":"2026"},{"count":7,"year":"2020"},{"count":7,"ye