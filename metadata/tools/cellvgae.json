{"tool_name":"cellvgae","contents":["biotools","oeb"],"identifiers":["biotools:cellvgae"],"fetched_metadata":{"biotools":{"id":"cellvgae","home":"https://github.com/davidbuterez/CellVGAE","summary":"CellVGAE is an unsupervised scRNA-seq analysis workflow with graph attention networks. CellVGAE uses the connectivity between cells (such as k-nearest neighbour graphs or KNN) with gene expression values as node features to learn high-quality cell representations in a lower-dimensional space, with applications in downstream analyses like (density-based) clustering, visualisation, gene set enrichment analysis and others. CellVGAE leverages both the variational graph autoencoder and graph attention networks to offer a powerful and more interpretable machine learning approach.","addition_date":"2021-01-18T12:18:14Z","last_update_date":"2026-11-12T14:19:59.868679Z","tool_type":["Command-line tool","Workflow"],"biotools_curie":"biotools:cellvgae","credit":[{"email":"db804@cam.ac.uk","name":"David Buterez","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"},{"term":"Dimensionality reduction","uri":"http://edamontology.org/operation_3935"},{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"CellVGAE","owner":"Kigaard","publication":[{"doi":"10.1093/bioinformatics/btab804","type":["Primary"]},{"doi":"10.1101/2020.12.20.423645","type":["Preprint"]}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:cellvgae/cmd/github.com","@license":"https://creativecommons.org/licenses/b