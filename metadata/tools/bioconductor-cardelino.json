{"tool_name":"bioconductor-cardelino","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-cardelino","home":"https://bioconductor.org/packages/cardelino","license":"GPL-3.0","summary":"Methods to infer clonal tree configuration for a population of cells using single-cell RNA-seq data (scRNA-seq), and possibly other data modalities. Methods are also provided to assign cells to inferred clones and explore differences in gene expression between clones. These methods can flexibly integrate information from imperfect clonal trees inferred based on bulk exome-seq data, and sparse variant alleles expressed in scRNA-seq data. A flexible beta-binomial error model that accounts for stochastic dropout events as well as systematic allelic imbalance is used.","addition_date":"2026-09-01T07:16:11.654679Z","last_update_date":"2026-09-01T07:16:11.657123Z","tool_type":["Command-line tool","Library"],"version":["1.14.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-cardelino","credit":[{"name":"Davis McCarthy","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Jeffrey Pullin","typeEntity":"Person","typeRole":["Developer"]},{"name":"Yuanhua Huang","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/cardelino"}],"edit_permission":{"type":"private"},"name":"cardelino","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.1038/s41592-020-0766-3"}]},"bioschemas":{"name":"cardelino","home":"https://bio.tools/bioconductor-cardelino","license":"GPL-3.0-only","version":"1.14.0","summary":"Methods to infer clonal tree configuration for a population of cells using single-cell RNA-seq data (scRNA-seq), and possibly other data modalities. Methods are also provided to assign cells to inferred clones and explore differences in gene expression between clones. These methods can flexibly integrate in