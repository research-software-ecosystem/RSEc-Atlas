{"tool_name":"ncrna","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"ncrna","home":"http://biobases.ibch.poznan.pl/ncRNA/","summary":"Non-translatable RNA transcripts that appear to work at the RNA level.","addition_date":"2017-04-25T12:30:03Z","last_update_date":"2021-04-26T07:46:20Z","tool_type":["Database portal"],"biotools_curie":"biotools:ncrna","credit":[{"email":"mszyman@ibch.poznan.pl","name":"Non-Coding RNA database team","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"DNA transcription","uri":"http://edamontology.org/operation_0372"},{"term":"Gene expression profiling","uri":"http://edamontology.org/operation_0314"},{"term":"RNA structure prediction","uri":"http://edamontology.org/operation_2441"},{"term":"Structured RNA prediction and optimisation","uri":"http://edamontology.org/operation_0483"},{"term":"Transcriptional regulatory element prediction","uri":"http://edamontology.org/operation_0438"}]}],"name":"Non-Coding RNA database","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"doi":"10.1093/nar/gkl994","metadata":{"abstract":"The noncoding RNA database (ncRNAdb) was created as a source of information on RNA molecules, which do not possess protein-coding capacity. It is now widely accepted that, in addition to constitutively expressed, housekeeping or infrastructural RNAs, there is a wide variety of RNAs participating in mechanisms involved in regulation of gene expression at all levels of transmission of genetic information from DNA to proteins. Noncoding RNAs' activities include chromatin structure remodeling, transcriptional and translational regulation of gene expression, modulation of protein function and regulation of subcellular distribution of RNAs as well as proteins. Noncoding transcripts have been identified in organisms belonging to all domains of life. Currently, the ncRNAdb contains >30 000 ncRNA sequences from Eukaryotes, Eubacteria and Archaea, but does not include housekeeping transcripts or microRNAs and snoRNAs for which more specialized databases are available. The contents of the database can be accessed via the WWW at http://biobases.ibch.poznan.pl/ncRNA/. \u00a9 2007 Oxford University Press.","authors":[{"name":"Barciszewski J."},{"name":"Erdmann V.A."},{"name":"Szymanski M."}],"citationCount":35,"date":"2007-01-01T00:00:00Z","journal":"Nucleic Acids Research","title":"Noncoding RNAs database (ncRNAdb)"},"pmcid":"PMC1781251","pmid":"17169980"}],"topic":[{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"RNA","uri":"http://edamontology.org/topic_0099"}],"validated":1},"bioschemas":{"name":"Non-Coding RNA database","home":"https://bio.tools/ncrna","summary":"Non-translatable RNA transcripts that appear to work at the RNA level.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ncrna/db/biobases.ibch.poznan.pl","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":26,"citations":[{"count":1,"year":"2008"},{"count":1,"year":"2009"},{"count":1,"year":"2018"},{"count":1,"year":"2020"},{"count":1,"year":"2024"},{"count":2,"year":"2023"},{"count":3,"year":"2014"},{"count":3,"year":"2019"},{"count":4,"year":"2011"},{"count":4,"year":"2012"},{"count":5,"year":"2013"}],"doi":"10.1093/nar/gkl994","pmcid":"PMC1781251","pmid":"17169980","ref_count":20,"refs":[{"count":1,"year":"1999"},{"count":1,"year":"2004"},{"count":2,"year":"2002"},{"count":2,"year":"2006"},{"count":3,"year":"2001"},{"count":4,"year":"2003"},{"count":7,"year":"2005"}],"title":"Noncoding RNAs database