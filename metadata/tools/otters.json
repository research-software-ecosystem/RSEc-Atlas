{"tool_name":"otters","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"otters","home":"https://github.com/daiqile96/OTTERS","license":"MIT","summary":"TWAS framework leveraging summary-level reference data.","addition_date":"2023-09-15T17:25:38.681022Z","last_update_date":"2024-11-24T14:40:43.894077Z","tool_type":["Script"],"accessibility":"Open access","biotools_curie":"biotools:otters","cost":"Free of charge","credit":[{"email":"jingjing.yang@emory.edu","name":"Jingjing Yang","orcidid":"https://orcid.org/0000-0002-4191-4138","typeEntity":"Person"},{"email":"mpepste@emory.edu","name":"Michael P. Epstein","orcidid":"https://orcid.org/0000-0001-9647-9738","typeEntity":"Person"},{"name":"Geyu Zhou","typeEntity":"Person"},{"name":"Hongyu Zhao","typeEntity":"Person"},{"name":"Qile Dai","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Imputation","uri":"http://edamontology.org/operation_3557"},{"term":"Simulation analysis","uri":"http://edamontology.org/operation_0244"},{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"OTTERS","operating_system":["Linux","Mac","Windows"],"owner":"Pub2Tools","publication":[{"doi":"10.1038/s41467-023-36862-w","metadata":{"abstract":"Most existing TWAS tools require individual-level eQTL reference data and thus are not applicable to summary-level reference eQTL datasets. The development of TWAS methods that can harness summary-level reference data is valuable to enable TWAS in broader settings and enhance power due to increased reference sample size. Thus, we develop a TWAS framework called OTTERS (Omnibus Transcriptome Test using Expression Reference Summary data) that adapts multiple polygenic risk score (PRS) methods to estimate eQTL weights from summary-level eQTL reference data and conducts an omnibus TWAS. We show that OTTERS is a practi