user's dataset, as well as visualize linkage disequilibrium pattern, infer haplotypes and design tagSNPs. Availability and implementation: Ferret tool and source code are publicly available at http://limousophie35.github.io/Ferret/. Contact: Supplementary information: Supplementary data are available at Bioinformatics online.","authors":[{"name":"Limou S."},{"name":"Taverner A.M."},{"name":"Winkler C.A."}],"citationCount":7,"date":"2016-07-15T00:00:00Z","journal":"Bioinformatics","title":"Ferret: A user-friendly Java tool to extract data from the 1000 Genomes Project"},"pmcid":"PMC4937191","pmid":"27153588","type":["Primary"]}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Exome sequencing","uri":"http://edamontology.org/topic_3676"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"}],"validated":1},"bioschemas":{"name":"Ferret","home":"https://bio.tools/Ferret","license":"Unlicense","summary":"Tool to extract data from the 1000 Genomes Project.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ferret/app/limousophie35.github.io","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":2,"citations":[{"count":1,"year":"2022"},{"count":1,"year":"2025"}],"doi":"10.1093/bioinformatics/btw147","pmcid":"PMC4937191","pmid":"27153588","ref_count":10,"refs":[{"count":1,"year":"2001"},{"count":1,"year":"2004"},{"count":1,"year":"2007"},{"count":1,"year":"2012"},{"count":2,"year":"2010"},{"count":2,"year":"2011"},