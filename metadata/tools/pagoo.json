{"tool_name":"pagoo","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"pagoo","home":"https://cran.r-project.org/package=pagoo","license":"GPL-3.0","summary":"An object-oriented framework for evolutionary pangenome analysis.","addition_date":"2022-07-26T10:25:59.493159Z","last_update_date":"2022-07-26T10:25:59.496060Z","tool_type":["Library"],"accessibility":"Open access","biotools_curie":"biotools:pagoo","cost":"Free of charge","credit":[{"email":"giraola@pasteur.edu.uy","name":"Gregorio Iraola","orcidid":"https://orcid.org/0000-0002-6516-3404","typeEntity":"Person"},{"email":"iferres@pasteur.edu.uy","name":"Ignacio Ferr\u00e9s","orcidid":"https://orcid.org/0000-0003-0910-6568","typeEntity":"Person"}],"documentation":[{"type":["User manual"],"url":"https://cran.r-project.org/web/packages/pagoo/pagoo.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Deposition","uri":"http://edamontology.org/operation_3431"},{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Phylogenetic reconstruction","uri":"http://edamontology.org/operation_3478"},{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"Pagoo","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1016/J.CRMETH.2021.100085","metadata":{"abstract":"\u00a9 2021 The AuthorsPangenome analysis is fundamental to explore molecular evolution occurring in bacterial populations. Here, we introduce Pagoo, an R framework that enables straightforward handling of pangenome data. The encapsulated nature of Pagoo allows the storage of complex molecular and phenotypic information using an object-oriented approach. This facilitates to go back and forward to the data using a single programming environment and saving any stage of analysis (including the raw data) in a single file, making it sharable and reproducible. Pagoo provides tools to query, subset, compare, visualize, and perform statistical analyses, in concert with other microbial genomics packages available in the R ecosystem. As working examples, we used 1,000 Escherichia coli genomes to show that Pagoo is scalable, and a global dataset of Campylobacter fetus genomes to identify evolutionary patterns and genomic markers of host-adaptation in this pathogen.","authors":[{"name":"Ferres I."},{"name":"Iraola G."}],"citationCount":2,"date":"2021-09-27T00:00:00Z","journal":"Cell Reports Methods","title":"An object-oriented framework for evolutionary pangenome analysis"},"pmcid":"PMC9017228","pmid":"35474671"}],"topic":[{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Molecular evolution","uri":"http://edamontology.org/topic_3945"},{"term":"Phylogenomics","uri":"http://edamontology.org/topic_0194"},{"term":"Phylogeny","uri":"http://edamontology.org/topic_0084"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"}],"validated":1},"bioschemas":{"name":"Pagoo","home":"https://bio.tools/pagoo","license":"GPL-3.0","summary":"An object-oriented framework for evolutionary pangenome analysis.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pagoo/lib/cran.r-project.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":20,"citations":[{"count":1,"year":"2021"},{"count":1,"year":"2023"},{"count":2,"year":"2022"},{"count":3,"year":"2026"},{"count":5,"year":"2025"},{"count":8,"year":"2024"}],"doi":"10.1016/j.crmeth.2021.100085","pmcid":"PMC9017228","pmid":"35474671","ref_count":20,"refs":[{"count":1,"year":"2005"},{"count":1,"year":"2010