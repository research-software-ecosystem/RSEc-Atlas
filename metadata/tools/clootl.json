{"tool_name":"clootl","contents":["biotools"],"identifiers":["biotools:clootl"],"fetched_metadata":{"biotools":{"id":"clootl","home":"https://github.com/eliotmiller/clootl","summary":"An R package designed to access, manipulate, and analyze a complete, versioned avian phylogeny. It enables users to easily extract phylogenetic trees for specific taxa while accounting for uncertainty and integrating information from numerous published studies.","addition_date":"2026-11-04T17:39:52.170730Z","last_update_date":"2026-11-04T17:39:52.173211Z","biotools_curie":"biotools:clootl","credit":[{"name":"Eliot T. Miller","typeEntity":"Person"},{"name":"Emily Jane McTavish","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Phylogenetic inference","uri":"http://edamontology.org/operation_0323"},{"term":"Phylogenetic tree editing","uri":"http://edamontology.org/operation_0326"},{"term":"Tree dating","uri":"http://edamontology.org/operation_3942"}]}],"name":"clootl: R package for Avian Phylogeny Access","owner":"pub2tools2024","publication":[{"doi":"10.64898/2026.04.23.720449"}],"topic":[{"term":"Ecology","uri":"http://edamontology.org/topic_0610"},{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Phylogeny","uri":"http://edamontology.org/topic_0084"}]}}}