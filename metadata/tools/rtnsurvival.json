{"tool_name":"rtnsurvival","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"rtnsurvival","home":"https://bioconductor.org/packages/RTN","license":"Artistic-2.0","summary":"A transcriptional regulatory network (TRN) consists of a collection of transcription factors (TFs) and the regulated target genes. TFs are regulators that recognize specific DNA sequences and guide the expression of the genome, either activating or repressing the expression the target genes. The set of genes controlled by the same TF forms a regulon. This package provides classes and methods for the reconstruction of TRNs and analysis of regulons.","addition_date":"2018-07-14T19:34:47Z","last_update_date":"2026-09-01T07:06:26.304500Z","tool_type":["Library"],"version":["2.36.0"],"collections":["BioConductor"],"biotools_curie":"biotools:rtnsurvival","credit":[{"name":"Clarice Groeneveld","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Florian Markowetz","typeEntity":"Person","typeRole":["Developer"]},{"name":"Gordon Robertson","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Kerstin Meyer","typeEntity":"Person","typeRole":["Developer"]},{"name":"Michael Fletcher","typeEntity":"Person","typeRole":["Developer"]},{"name":"Xin Wang","typeEntity":"Person","typeRole":["Developer"]},{"name":"and Mauro Castro","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/RTN"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene-set enrichment analysis","uri":"http://edamontology.org/operation_2436"}]},{"operation":[{"term":"Pathway or network analysis","uri":"http://edamontology.org/operation_2497"}]}],"name":"RTNsurvival","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[{"doi":"10.1038/ncomms3464"},{"doi":"10.1038/ng.3458"}],"topic":[{"term":"Gene regulation","uri":"http://edamontology.org/topic_0204"}],"validated":1},"bioschemas":