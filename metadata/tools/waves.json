{"tool_name":"waves","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"WAVES","home":"http://www.atgc-montpellier.fr/waves/","license":"GPL-3.0","summary":"WAVES is a web application dedicated to bioinformatic tool integration. It provides an efficient way to implement a service for any bioinformatic software. Such services are automatically made available in three ways: web pages, web forms to include in remote websites, and a RESTful web services API to access remotely from applications. In order to fulfill the service\u2019s computational needs, WAVES can perform computation on various resources and environments, such as Galaxy instances.","addition_date":"2020-01-21T14:11:23Z","last_update_date":"2024-11-24T20:59:29.033937Z","tool_type":["Bioinformatics portal","Web API","Web application","Web service"],"version":["1.6"],"accessibility":"Open access","biotools_curie":"biotools:WAVES","cost":"Free of charge","credit":[{"email":"mchakiachvili@ebi.ac.uk","name":"Marc Chakiachvili","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"email":"vincent.lefort@lirmm.fr","name":"Vincent Lefort","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"LIRMM","typeEntity":"Institute","typeRole":["Provider"],"url":"http://www.lirmm.fr/"}],"documentation":[{"type":["Installation instructions"],"url":"https://waves-core.readthedocs.io/en/latest/installation.html"},{"type":["User manual"],"url":"http://waves-core.readthedocs.io/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Service invocation","uri":"http://edamontology.org/operation_3763"}]}],"maturity":"Emerging","name":"WAVES","operating_system":["Linux"],"owner":"vincent.lefort","publication":[{"doi":"10.1093/bioinformatics/bty639","metadata":{"abstract":"WAVES is a web application dedicated to bioinformatic tool integration. It provides an efficient way to implement a service for any bioinformatic software. Such services are automatically made available in three ways: Web pages, web forms to include in remote websites and a RESTful web services single application programing interface to access remotely from applications. In order to fulfill the service's computational needs, WAVES can perform computation on various resources and environments, such as Galaxy instances. Availability and implementation WAVES was developed with Django, a Python-based web framework. It was designed as a reusable web application. It is fully portable, as only a Python installation is required to run Django. It is licensed under GNU General Public License. Source code, documentation with examples and demo are available from http://www.atgc-montpellier.fr/waves/.","authors":[{"name":"Arigon Chifolleau A.-M."},{"name":"Chakiachvili M."},{"name":"Lefort V."},{"name":"Milanesi S."}],"citationCount":2,"date":"2019-01-01T00:00:00Z","journal":"Bioinformatics","title":"WAVES: A web application for versatile enhanced bioinformatic services"},"pmid":"30052762","type":["Primary"]}],"topic":[{"term":"Bioinformatics","uri":"http://edamontology.org/topic_0091"},{"term":"Software engineering","uri":"http://edamontology.org/topic_3372"}],"validated":1},"bioschemas":{"name":"WAVES","home":"https://bio.tools/WAVES","license":"GPL-3.0","version":"1.6","summary":"WAVES is a web application dedicated to bioinformatic tool integration. It provides an efficient way to implement a service for any bioinformatic software. Such services are automatically made available in three ways: web pages, web forms to include in remote websites, and a RESTful web services API to access remotely from applications. In order to fulfill the service\u2019s computational needs, WAVES can perform computation on various resources and environments, such as Galaxy instances.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:waves:1.6/cmd/www.atgc-montpellier.fr","@license":"https://creativecommons.org/licenses/by/