{"tool_name":"dmnet","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"dmnet","home":"http://celltrackingchallenge.net/participants/MU-Ba-US/","license":"Not licensed","summary":"A dual-stream marker-guided network (DMNet) for segmentation of touching cells in microscopy videos of many cell types.","addition_date":"2022-07-26T07:32:54.124856Z","last_update_date":"2024-11-24T15:52:50.776413Z","tool_type":["Web application","Workbench","Workflow"],"accessibility":"Open access (with restrictions)","biotools_curie":"biotools:dmnet","cost":"Free of charge (with restrictions)","credit":[{"email":"rinabao@mail.missouri.edu","name":"Rina Bao","typeEntity":"Person"},{"name":"Noor M. Al-Shakarji","typeEntity":"Person"}],"edit_permission":{"type":"public"},"name":"DMNet","operating_system":["Linux","Mac","Windows"],"owner":"Chan019","publication":[{"doi":"10.1109/iccvw54120.2021.00375","metadata":{"abstract":"Accurate segmentation and tracking of cells in microscopy image sequences is extremely beneficial in clinical diagnostic applications and biomedical research. A continuing challenge is the segmentation of dense touching cells and deforming cells with indistinct boundaries, in low signal-to-noise-ratio images. In this paper, we present a dual-stream marker-guided network (DMNet) for segmentation of touching cells in microscopy videos of many cell types. DMNet uses an explicit cell marker-detection stream, with a separate mask-prediction stream using a distance map penalty function, which enables supervised training to focus attention on touching and nearby cells. For multi-object cell tracking we use M2Track tracking-by-detection approach with multi-step data association. Our M2Track with mask overlap includes short term track-to-cell association followed by track-to-track association to re-link tracklets with missing segmentation masks over a short sequence of frames. Our combined detection, segmentation and tracking algorithm has proven its potential on the IEEE ISBI 2021 6th Cell Tracking Challenge (CTC-6) where we achieved multiple top three rankings for diverse cell types. Our team name is MU-Ba-US, and the implementation of DMNet is available at, http://celltrackingchallenge.net/participants/MU-Ba-US/.","authors":[{"name":"Al-Shakarji N.M."},{"name":"Bao R."},{"name":"Bunyak F."},{"name":"Palaniappan K."}],"citationCount":12,"date":"2021-01-01T00:00:00Z","journal":"Proceedings of the IEEE International Conference on Computer Vision","title":"DMNet: Dual-Stream Marker Guided Deep Network for Dense Cell Segmentation and Lineage Tracking"},"pmcid":"PMC8982054","pmid":"35386855"}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Medicine","uri":"http://edamontology.org/topic_3303"}],"validated":1},"bioschemas":{"name":"DMNet","home":"https://bio.tools/dmnet","license":"Not licensed","summary":"A dual-stream marker-guided network (DMNet) for segmentation of touching cells in microscopy videos of many cell types.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:dmnet/web/celltrackingchallenge.net","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":7,"citations":[{"count":1,"year":"2021"},{"count":1,"year":"2022"},{"count":1,"year":"2024"},{"count":2,"year":"2023"},{"count":2,"year":"2025"}],"doi":"10.1109/iccvw54120.2021.00375","pmcid":"PMC8982054","pmid":"35386855","ref_count":40,"refs":[{"count":1,"year":"1997"},{"count":1,"year":"1999"},{"count":1,"year":"2000"},{"count":1,"year":"2002"},{"count":1,"year":"2004"},{"count":1,"year":"2005"},{"count":1,"year":"2009"},{"count":1,"year":"2011"},{"count":1,"year":"2015"},{"count":1,"year":"2016"},{"count":1,"year