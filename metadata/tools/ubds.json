{"tool_name":"ubds","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"UBDs","home":"https://github.com/UniBioDicts","license":"AGPL-3.0","summary":"Unified Biological Dictionaries (UniBioDicts) is a set of software packages that unite many of the most important biological controlled vocabularies, database vocabularies, and ontologies, under a common query-interface. These packages can access these disparate biological resources, and map their vocabulary data onto a common representation consisting of terms (which biocurators prefer to use), a unique identifier (which computers can reason with), and various descriptive metadata.\n\nThis cross-resource infrastructure is essential for an efficient, modernized biocuration process, as it directly enables the autocomplete-based curation of particularly context-rich annotations, that combine terminology from across biological niches.","addition_date":"2020-07-04T02:23:09Z","last_update_date":"2020-07-04T02:23:24Z","tool_type":["Bioinformatics portal","Database portal","Suite"],"accessibility":"Open access","biotools_curie":"biotools:UBDs","cost":"Free of charge","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"}]}],"maturity":"Mature","name":"UniBioDicts","owner":"bblodfon","topic":[{"term":"Bioinformatics","uri":"http://edamontology.org/topic_0091"},{"term":"Biological databases","uri":"http://edamontology.org/topic_3071"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ubds/db/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,