{"tool_name":"x_hunter","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"x_hunter","home":"http://www.thegpm.org/hunter/index.html","summary":"Matches tandem mass spectra with library spectra from same organism.","addition_date":"2017-01-17T14:51:27Z","last_update_date":"2019-03-26T08:42:39Z","tool_type":["Web application"],"collections":["Proteomics","ms-utils"],"biotools_curie":"biotools:x_hunter","credit":[{"email":"webmaster@ms-utils.org","typeEntity":"Person","typeRole":["Documentor"],"url":"http://ms-utils.org"}],"documentation":[{"type":["General"],"url":"http://www.thegpm.org/hunter/index.html"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"input":[{"data":{"term":"Mass spectrometry spectra","uri":"http://edamontology.org/data_0943"},"format":[{"term":"MGF","uri":"http://edamontology.org/format_3651"}]},{"data":{"term":"Mass spectrometry spectra","uri":"http://edamontology.org/data_0943"},"format":[{"term":"MGF","uri":"http://edamontology.org/format_3651"}]},{"data":{"term":"Sequence set","uri":"http://edamontology.org/data_0850"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}],"operation":[{"term":"PTM identification","uri":"http://edamontology.org/operation_3645"},{"term":"Peptide identification","uri":"http://edamontology.org/operation_3631"},{"term":"Protein identification","uri":"http://edamontology.org/operation_3767"},{"term":"Spectral library search","uri":"http://edamontology.org/operation_3801"}],"output":[{"data":{"term":"Peptide identification","uri":"http://edamontology.org/data_0945"},"format":[{"term":"X!Tandem XML","uri":"http://edamontology.org/format_3711"}]}]}],"name":"X Hunter","operating_system":["Linux","Mac"],"owner":"msutils_import","publication":[{"doi":"10.1021/pr0602085","metadata":{"abstract":"A system for creating a library of tandem mass spectra annotated with corresponding peptide sequences was described. This system was based on the annotated spectra currently available in the Global Proteome Machine Database (GPMDB). The library spectra were created by averaging together spectra that were annotated with the same peptide sequence, sequence modifications, and parent ion charge. The library was constructed so that experimental peptide tandem mass spectra could be compared with those in the library, resulting in a peptide sequence identification based on scoring the similarity of the experimental spectrum with the contents of the library. A software implementation that performs this type of library search was constructed and successfully used to obtain sequence identifications. The annotated tandem mass spectrum libraries for the Homo sapiens, Mus musculus, and Saccharomyces cerevisiae proteomes and search software were made available for download and use by other groups. \u00a9 2006 American Chemical Society.","authors":[{"name":"Beavis R.C."},{"name":"Cortens J.C."},{"name":"Craig R."},{"name":"Fenyo D."}],"citationCount":233,"date":"2006-08-01T00:00:00Z","journal":"Journal of Proteome Research","title":"Using annotated peptide mass spectrum libraries for protein identification"},"type":["Primary"]}],"topic":[{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"}],"validated":1},"bioschemas":{"name":"X Hunter","home":"https://bio.tools/x_hunter","summary":"Matches tandem mass spectra with library spectra from same organism.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:x_hunter/web/www.thegpm.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":109,"citations":[{"count":1,"year":"2019"},{"count":1,"year":"2025"},{"c