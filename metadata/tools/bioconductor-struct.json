{"tool_name":"bioconductor-struct","contents":["oeb","biocontainers","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-struct","identifiers":["doi:10.18129/b9.bioc.struct"],"license":"GPL-3","summary":"Statistics in R Using Class-based Templates","home_url":"https://bioconductor.org/packages/3.11/bioc/html/struct.html","keywords":[],"manually_check":true,"total_pulls":4},"biotools":{"id":"bioconductor-struct","home":"https://bioconductor.org/packages/structToolbox","license":"GPL-3.0","summary":"An extensive set of data (pre-)processing and analysis methods and tools for metabolomics and other omics, with a strong emphasis on statistics and machine learning. This toolbox allows the user to build extensive and standardised workflows for data analysis. The methods and tools have been implemented using class-based templates provided by the struct (Statistics in R Using Class-based Templates) package. The toolbox includes pre-processing methods (e.g. signal drift and batch correction, normalisation, missing value imputation and scaling), univariate (e.g. ttest, various forms of ANOVA, Kruskal\u2013Wallis test and more) and multivariate statistical methods (e.g. PCA and PLS, including cross-validation and permutation testing) as well as machine learning methods (e.g. Support Vector Machines). Ontology terms have been integrated to provide standardised definitions for the different methods, inputs and outputs.","addition_date":"2026-09-01T07:32:28.903196Z","last_update_date":"2026-09-06T01:51:20.871257Z","tool_type":["Command-line tool","Library"],"version":["1.24.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-struct","credit":[{"name":"Gavin Rhys Lloyd","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Ralf Johannes Maria Weber","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/structToolbox"}],"edit_permission":{"type":"pri