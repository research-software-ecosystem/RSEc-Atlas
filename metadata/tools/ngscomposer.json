{"tool_name":"ngscomposer","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"ngscomposer","home":"https://github.com/ryandkuster/ngsComposer","license":"Apache-2.0","summary":"ngsComposer is an automated pipeline for empirically based NGS data quality filtering.","addition_date":"2021-10-25T07:37:07.658949Z","last_update_date":"2024-11-24T20:17:30.164952Z","tool_type":["Workflow"],"biotools_curie":"biotools:ngscomposer","credit":[{"email":"bolukolu@utk.edu","name":"Bode A Olukolu","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Base-calling","uri":"http://edamontology.org/operation_3185"},{"term":"DNA barcoding","uri":"http://edamontology.org/operation_3200"},{"term":"Demultiplexing","uri":"http://edamontology.org/operation_3933"},{"term":"Read pre-processing","uri":"http://edamontology.org/operation_3219"},{"term":"Sequence trimming","uri":"http://edamontology.org/operation_3192"}]}],"name":"ngsComposer","owner":"Kigaard","publication":[{"doi":"10.1093/bib/bbab092","metadata":{"abstract":"Next-generation sequencing (NGS) enables massively parallel acquisition of large-scale omics data; however, objective data quality filtering parameters are lacking. Although a useful metric, evidence reveals that platform-generated Phred values overestimate per-base quality scores. We have developed novel and empirically based algorithms that streamline NGS data quality filtering. The pipeline leverages known sequence motifs to enable empirical estimation of error rates, detection of erroneous base calls and removal of contaminating adapter sequence. The performance of motif-based error detection and quality filtering were further validated with read compression rates as an unbiased metric. Elevated error rates at read ends, where known motifs lie, tracked with propagation of erroneous base calls. Barcode swapping, an inherent problem with pooled libraries, was also effectively mitigated. The ngsComposer pipeline is suitable for various NGS protocols and platforms due to the universal concepts on which the algorithms are based.","authors":[{"name":"Kuster R.D."},{"name":"Olukolu B.A."},{"name":"Yencho G.C."}],"citationCount":11,"date":"2021-09-01T00:00:00Z","journal":"Briefings in Bioinformatics","title":"NgsComposer: An automated pipeline for empirically based NGS data quality filtering"},"pmcid":"PMC8425578","pmid":"33822850"}],"topic":[{"term":"Sequence sites, features and motifs","uri":"http://edamontology.org/topic_0160"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]},"bioschemas":{"name":"ngsComposer","home":"https://bio.tools/ngscomposer","license":"Apache-2.0","summary":"ngsComposer is an automated pipeline for empirically based NGS data quality filtering.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ngscomposer/workflow/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":14,"citations":[{"count":2,"year":"2022"},{"count":2,"year":"2023"},{"count":3,"year":"2024"},{"count":3,"year":"2026"},{"count":4,"year":"2025"}],"doi":"10.1093/bib/bbab092","pmcid":"PMC8425578","pmid":"33822850","ref_count":26,"refs":[{"count":1,"year":"1998"},{"count":1,"year":"2009"},{"count":1,"year":"2013"},{"count":1,"year":"2017"},{"count":1,"year":"2018"},{"count":2,"year":"2008"},{"count":2,"year":"2010"},{"count":2,"year":"2012"},{"count":2,"year":"2014"},{"count":2,"