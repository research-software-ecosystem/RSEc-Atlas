{"tool_name":"hiccompare","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-hiccompare","version":"1.32.0","home":"https://bioconductor.org/packages/3.22/bioc/html/HiCcompare.html","license":"MIT + file LICENSE","summary":"HiCcompare: Joint normalization and comparative analysis of multiple Hi-C datasets","identifiers":["biotools:HiCcompare","doi:10.1186/s12859-018-2288-x"],"description":"HiCcompare provides functions for joint normalization and difference detection in multiple Hi-C datasets. HiCcompare operates on processed Hi-C data in the form of chromosome-specific chromatin interaction matrices. It accepts three-column tab-separated text files storing chromatin interaction matrices in a sparse matrix format which are available from several sources. HiCcompare is designed to give the user the ability to perform a comparative analysis on the 3-Dimensional structure of the genomes of cells in different biological states.`HiCcompare` differs from other packages that attempt to compare Hi-C data in that it works on processed data in chromatin interaction matrix format instead of pre-processed sequencing data. In addition, `HiCcompare` provides a non-parametric method for the joint normalization and removal of biases between two Hi-C datasets for the purpose of comparative analysis. `HiCcompare` also provides a simple yet robust method for detecting differences between Hi-C datasets.","license_file":"LICENSE","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-biocparallel >=1.44.0,<1.45.0","bioconductor-genomicranges >=1.62.0,<1.63.0","bioconductor-interactionset >=1.38.0,<1.39.0","bioconductor-iranges >=2.44.0,<2.45.0","bioconductor-rhdf5 >=2.54.0,<2.55.0","bioconductor-s4vectors >=0.48.0,<0.49.0","r-base","r-data.table","r-dplyr","r-ggplot2","r-gridextra","r-gtools","r-kernsmooth","r-mgcv","r-pheatmap"],"run":["bioconductor-biocparallel >=1.44.0,<1.45.0","bioconductor-genomicranges >=1.62.0,<1.63.0","bioconductor-interactionset >=1.38.0,<1.39.0","bioconductor-iranges >=2.44.0,<2.45.0","bioconductor-rhdf5 >=2.54.0,<2.55.0","bioconductor-s4vectors >=0.48.0,<0.49.0","r-base","r-data.table","r-dplyr","r-ggplot2","r-gridextra","r-gtools","r-kernsmooth","r-mgcv","r-pheatmap"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/HiCcompare_1.32.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HiCcompare/HiCcompare_1.32.0.tar.gz","https://bioarchive.galaxyproject.org/HiCcompare_1.32.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-hiccompare/bioconductor-hiccompare_1.32.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('HiCcompare')\""]},"parent_recipe":{"name":"bioconductor-hiccompare","path":"recipes/bioconductor-hiccompare","version":"1.2.0"}},"biotools":{"id":"hiccompare","home":"https://bioconductor.org/packages/HiCcompare","license":"MIT","summary":"HiCcompare provides functions for joint normalization and difference detection in multiple Hi-C datasets. HiCcompare operates on processed Hi-C data in the form of chromosome-specific chromatin interaction matrices. It accepts three-column tab-separated text files storing chromatin interaction matrices in a sparse matrix format which are available from several sources. HiCcompare is designed to give the user the ability to perform a comparative analysis on the 3-Dimensional structure of the genomes of cells in different biological states.`HiCcompare` differs from other packages that attempt to compare Hi-C data in that it works on processed data in chromatin interaction matrix format instead of pre-processed sequencing data. In addition, `HiCcompare` provides a non-parametric method for the joint normalization and removal of biases between two Hi-C datasets for the purpose of comparative analysis. `HiCcompare` also provides a simple yet robust method for detecting differences between Hi-C datasets.","addition_date":"2018-07-09T17:48:04Z","last_update_date":"2018-12-10T12:59:00Z","tool_type":["Library"],"version":["1.34.0"],"collections":["BioConductor"],"biotools_curie":"biotools:hiccompare","credit":[{"name":"John Stansfield","typeEntity":"Person","typeRole":["Developer"]},{"name":"Kellen Cresswell","typeEntity":"Person","typeRole":["Developer"]},{"name":"Mikhail Dozmorov","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/HiCcompare"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"HiCcompare","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[{"doi":"10.1186/s12859-018-2288-x"}],"topic":[{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"bioschemas":{"name":"HiCcompare","home":"https://bio.tools/hiccompare","license":"MIT","version":"1.34.0","summary":"HiCcompare provides functions for joint normalization and difference detection in multiple Hi-C datasets. HiCcompare operates on processed Hi-C data in the form of chromosome-specific chromatin interaction matrices. It accepts three-column tab-separated text files storing chromatin interaction matrices in a sparse matrix format which are available from several sources. HiCcompare is designed to give the user the ability to perform a comparative analysis on the 3-Dimensional structure of the genomes of cells in different biological states.`HiCcompare` differs from other packages that attempt to compare Hi-C data in that it works on processed data in chromatin interaction matrix format instead of pre-processed sequencing data. In addition, `HiCcompare` provides a non-parametric method for the joint normalization and removal of biases between two Hi-C datasets for the purpose of comparative analysis. `HiCcompare` also provides a simple