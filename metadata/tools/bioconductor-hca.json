{"tool_name":"bioconductor-hca","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-hca","home":"https://bioconductor.org/packages/hca","license":"MIT","summary":"This package provides users with the ability to query the Human Cell Atlas data repository for single-cell experiment data. The `projects()`, `files()`, `samples()` and `bundles()` functions retrieve summary information on each of these indexes; corresponding `*_details()` are available for individual entries of each index. File-based resources can be downloaded using `files_download()`. Advanced use of the package allows the user to page through large result sets, and to flexibly query the 'list-of-lists' structure representing query responses.","tool_type":["Command-line tool","Library"],"version":["1.20.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-hca","credit":[{"name":"Kayla Interdonato","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Martin Morgan","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Maya McDaniel","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/hca"}],"name":"hca","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-hca:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-hca:1.10.0/cmd/bioconductor.org","@license":"https://creativecommons.org/license