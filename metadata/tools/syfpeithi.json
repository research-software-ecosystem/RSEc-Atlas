{"tool_name":"syfpeithi","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"syfpeithi","home":"http://www.syfpeithi.de/","summary":"Database comprising more than 7000 peptide sequences known to bind class I and class II MHC molecules. The entries are compiled from published reports only. The database can be used to predict the immunogenicity of given peptide sequences.","addition_date":"2017-03-30T22:04:29Z","last_update_date":"2024-11-24T20:23:53.451034Z","tool_type":["Database portal"],"biotools_curie":"biotools:syfpeithi","credit":[{"email":"stefan.stevanovic@uni-tuebingen.de","name":"Prof. Dr. Stefan Stevanovic","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.immunology-tuebingen.de/groups/stefan-stevanovic.html"}],"documentation":[{"type":["General"],"url":"http://www.syfpeithi.de/bin/MHCServer.dll/Info.htm"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Peptide database search","uri":"http://edamontology.org/operation_3646"},{"term":"Peptide immunogenicity prediction","uri":"http://edamontology.org/operation_0252"},{"term":"Protein feature detection","uri":"http://edamontology.org/operation_3092"},{"term":"Sequence feature detection","uri":"http://edamontology.org/operation_0253"},{"term":"Sequence motif recognition","uri":"http://edamontology.org/operation_0239"}]}],"name":"SYFPEITHI","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"doi":"10.1007/s002510050595","metadata":{"abstract":"The first version of the major histocompatibility complex (MHC) databank SYFPEITHI: database for MHC ligands and peptide motifs, is now available to the general public. It contains a collection of MHC class I and class II ligands and peptide motifs of humans and other species, such as apes, cattle, chicken, and mouse, for example, and is continuously updated. All motifs currently available are accessible as individual entries. Searches for MHC alleles, MHC motifs, natural ligands, T-cell epitopes, source proteins/organisms and references are possible. Hyperlinks to the EMBL and PubMed databases are included. In addition, ligand predictions are available for a number of MHC allelic products. The database content is restricted to published data only.","authors":[{"name":"Bachmann J."},{"name":"Bachor O.A."},{"name":"Emmerich N.P.N."},{"name":"Rammensee H.-G."},{"name":"Stevanovic S."}],"citationCount":2030,"date":"1999-01-01T00:00:00Z","journal":"Immunogenetics","title":"SYFPEITHI: Database for MHC ligands and peptide motifs"},"pmid":"10602881"}],"topic":[{"term":"Database management","uri":"http://edamontology.org/topic_3489"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}],"validated":1},"bioschemas":{"name":"SYFPEITHI","home":"https://bio.tools/syfpeithi","summary":"Database comprising more than 7000 peptide sequences known to bind class I and class II MHC molecules. The entries are compiled from published reports only. The database can be used to predict the immunogenicity of given peptide sequences.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:syfpeithi/db/www.syfpeithi.de","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":957,"citations":[{"count":1,"year":"1999"},{"count":1,"year":"2000"},{"count":2,"year":"2001"},{"count":7,"year":"-1"},{"count":13,"year":"2002"},{"count":13,"year":"2026"},{"count":20,"year":"2003"},{"count":22,"year":"2023"},{"count":26,"year":"2006"},{"count":28,"year":"2004"},{"count":30,"year":"2024"},{"count":31,"year":"2025"},{"count":32,"year":"2019"},{"count":34,"year":"2017"},{"count":37,"year":"2020"},{"count":38,"year":"2005"},{"count":41,"year":"2008"},{"count":41,"yea