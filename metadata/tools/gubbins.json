{"tool_name":"gubbins","contents":["biocontainers","galaxy","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"gubbins","version":"3.4.3","home":"https://github.com/nickjcroucher/gubbins","documentation":"https://nickjcroucher.github.io/gubbins","license":"GPL-2.0-or-later","summary":"Rapid phylogenetic analysis of large samples of recombinant bacterial whole genome sequences using Gubbins.","identifiers":["doi:10.1093/nar/gku1196","biotools:gubbins","usegalaxy-eu:gubbins"],"license_file":"LICENSE","build":{"entry_points":["run_gubbins.py = gubbins.run_gubbins:main"],"number":1,"run_exports":[null],"skip":true},"requirements":{"build":["make",null,null,"libtool","autoconf","automake","autoconf-archive","pkg-config"],"host":["python","pip","setuptools <82","scipy","dendropy","biopython","numpy <=1.23.0","numba","zlib"],"run":["python","setuptools <82","scipy","dendropy","biopython","multiprocess","raxml >=8.2.12","iqtree >=2.2,<3","rapidnj","raxml-ng >=1.0.1","fasttree >=2.1.10","veryfasttree","numpy <=1.23.0","numba","ska2 >=0.3.0","perl","r-argparser","r-magrittr","r-tidyverse","bioconductor-treeio","bioconductor-ggtree","r-aplot","r-patchwork","r-cowplot","r-rcolorbrewer"]},"source_url":"https://github.com/nickjcroucher/gubbins/archive/refs/tags/v3.4.3.tar.gz","test":{"commands":["run_gubbins.py -h"]}},"biocontainers":{"name":"gubbins","identifiers":["doi:10.1093/nar/gku1196"],"license":"GPL-2+","summary":"Phylogenetic analysis of genome sequences","home_url":"https://github.com/sanger-pathogens/gubbins","keywords":["Genomics"],"manually_check":true,"total_pulls":8805},"biotools":{"id":"gubbins","home":"https://github.com/nickjcroucher/gubbins","license":"GPL-2.0","summary":"Gubbins is a tool for rapid phylogenetic analysis of large samples of recombinant bacterial whole genome sequences.","addition_date":"2021-05-26T20:10:59Z","last_update_date":"2024-11-24T14:34:53.681443Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:gubbins","credit":[{"email":"simon.harris@sanger.ac.uk","name":"Simon R. Harris","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/nickjcroucher/gubbins"}],"edit_permission":{"authors":["ELIXIR-CZ"],"type":"group"},"function":[{"operation":[{"term":"Ancestral reconstruction","uri":"http://edamontology.org/operation_3745"},{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Phylogenetic inference","uri":"http://edamontology.org/operation_0323"}]}],"name":"Gubbins","operating_system":["Linux","Mac"],"owner":"andrewjpage","publication":[{"doi":"10.1093/nar/gku1196","metadata":{"abstract":"The emergence of new sequencing technologies has facilitated the use of bacterial whole genome alignments for evolutionary studies and outbreak analyses. These datasets, of increasing size, often include examples of multiple different mechanisms of horizontal sequence transfer resulting in substantial alterations to prokaryotic chromosomes. The impact of these processes demands rapid and flexible approaches able to account for recombination when reconstructing isolates' recent diversification. Gubbins is an iterative algorithm that uses spatial scanning statistics to identify loci containing elevated densities of base substitutions suggestive of horizontal sequence transfer while concurrently constructing a maximum likelihood phylogeny based on the putative point mutations outside these regions of high sequence diversity. Simulations demonstrate the algorithm generates highly accurate reconstructions under realistically parameterized models of bacterial evolution, and achieves convergence in only a few hours on alignments of hundreds of bacterial genome sequences. Gubbins is appropriate for reconstructing the recent evolutionary history of a variety of haploid genotype alignments, as it makes no assumptions about the underlying mechanism of recombination. The software is freely available for download at github.com/sangerpathogens/Gubbins, implemented in Python and C and supported on Linux and Mac OS X.","authors":[{"name":"Bentley S.D."},{"name":"Connor T.R."},{"name":"Croucher N.J."},{"name":"Delaney A.J."},{"name":"Harris S.R."},{"name":"Keane J.A."},{"name":"Page A.J."},{"name":"Parkhill J."}],"citationCount":1510,"date":"2015-02-18T00:00:00Z","journal":"Nucleic Acids Research","title":"Rapid phylogenetic analysis of large samples of recombinant bacterial whole genome sequences using Gubbins"},"pmcid":"PMC4330336","pmid":"25414349","type":["Primary"]}],"topic":[{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Phylogeny","uri":"http://edamontology.org/topic_0084"},{"term":"Whole genome sequencing","uri":"http://edamontology.org/topic_3673"}]},"bioschemas":{"name":"Gubbins","home":"https://bio.tools/gubbins","license":"GPL-2.0","summary":"Gubbins is a tool for rapid phylogenetic analysis of large samples of recombinant bacterial whole genome sequences.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"@TOOL_VERSION@+galaxy@VERSION_SUFFIX@","first_commit":"2017-06-22","conda_name":"gubbins","conda_version":"3.4.3","summary":"Gubbins - bacterial recombination detection","edam_operations":["Genotyping","Phylogenetic inference","Ancestral reconstruction"],"edam_topics":["Phylogeny","Genotype and phenotype","Whole genome sequencing"],"toolshed_categories":["Sequence Analysis"],"toolshed_id":"gubbins","users_5_years":920,"users_all_time":1033,"usage_5_years":10555,"usage_all_time":12037,"bio_tools_summary":"Gubbins is a tool for rapid phylogenetic analysis of large samples of recombinant bacterial whole genome sequences.","bio_tools_ids":"gubbins","bio_tools_name":"Gubbins","related_tutorials":[],"related_workflows":[],"tool_ids":["gubbins"],"tool_output_formats":["txt","gff3","embl","fasta","phylip","csv","vcf"],"homepage":"https://github.com/nickjcroucher/gubbins","suite_source":"https://github.com/galaxypr