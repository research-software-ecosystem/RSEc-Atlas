{"tool_name":"unipept","contents":["galaxy","oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"unipept","home":"http://unipept.ugent.be/","license":"MIT","summary":"Metaproteomics data analysis with a focus on interactive data visualizations.","addition_date":"2016-05-17T10:18:37Z","last_update_date":"2024-11-24T20:22:13.458623Z","tool_type":["Workbench"],"version":["3.1"],"collections":["BIG N2N","Proteomics","UGent"],"biotools_curie":"biotools:unipept","credit":[{"email":"Unipept@ugent.be","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"ugent.be","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["API documentation"],"url":"https://unipept.ugent.be/apidocs"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"input":[{"data":{"term":"Protein sequence","uri":"http://edamontology.org/data_2976"}}],"operation":[{"term":"Prediction and recognition","uri":"http://edamontology.org/operation_2423"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}],"output":[{"data":{"term":"Phylogenetic tree","uri":"http://edamontology.org/data_0872"}},{"data":{"term":"Sequence set","uri":"http://edamontology.org/data_0850"}}]}],"name":"Unipept","operating_system":["Linux","Mac","Windows"],"owner":"bmesuere","publication":[{"doi":"10.1021/acs.jproteome.0c00855","metadata":{"abstract":"Metaproteomics has become an important research tool to study microbial systems, which has resulted in increased metaproteomics data generation. However, efficient tools for processing the acquired data have lagged behind. One widely used tool for metaproteomics data interpretation is Unipept, a web-based tool that provides, among others, interactive and insightful visualizations. Due to its web-based implementation, however, the Unipept web application is limited in the amount of data that can be analyzed. In this manuscript we therefore present Unipept Desktop, a desktop application version of Unipept that is designed to drastically increase the throughput and capacity of metaproteomics data analysis. Moreover, it provides a novel comparative analysis pipeline and improves the organization of experimental data into projects, thus addressing the growing need for more efficient and versatile analysis tools for metaproteomics data.","authors":[{"name":"Dawyndt P."},{"name":"Martens L."},{"name":"Mesuere B."},{"name":"Van Den Bossche T."},{"name":"Verschaffelt P."}],"citationCount":18,"date":"2021-04-02T00:00:00Z","journal":"Journal of Proteome Research","title":"Unipept Desktop: A Faster, More Powerful Metaproteomics Results Analysis Tool"},"pmid":"33401902"},{"doi":"10.1093/bioinformatics/btw039","metadata":{"abstract":"Summary Unipept is an open source web application that is designed for metaproteomics analysis with a focus on interactive datavisualization. It is underpinned by a fast index built from UniProtKB and the NCBI taxonomy that enables quick retrieval of all UniProt entries in which a given tryptic peptide occurs. Unipept version 2.4 introduced web services that provide programmatic access to the metaproteomics analysis features. This enables integration of Unipept functionality in custom applications and data processing pipelines. Availability and implementation: The web services are freely available at http://api.unipept.ugent.be and are open sourced under the MIT license. Supplementary information: Supplementary data are available at Bioinformatics online.","authors":[{"name":"Dawyndt P."},{"name":"Devreese B."},{"name":"Mesuere B."},{"name":"Van Der Jeugt F."},{"name":"Vandamme P."},{"name":"Willems T."}],"citationCount":45,"date":"2016-06-01T00:00:00Z","journal":"Bioinformatics","title":"Unipept web services for metaproteomics analysis"},"pmid":"26819472"}],"topic":[{"term":"Biodiversity","uri":"http://edamontology.org/topic_3050"},{"term":"Proteogenomics","uri":"http://edamontology.org/topic_3922"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}],"validated":1},"bioschemas":{"name":"Unipept","home":"https://bio.tools/unipept","license":"MIT","version":"3.1","summary":"Metaproteomics data analysis with a focus on interactive data visualizations.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"6.2.4","first_commit":"2015-04-03","conda_name":"python","summary":"Unipept retrieves metaproteomics information","edam_operations":["Prediction and recognition","Visualisation"],"edam_topics":["Proteomics","Proteogenomics","Biodiversity","Workflows"],"toolshed_categories":["Proteomics"],"toolshed_id":"unipept","users_5_years":418,"users_all_time":450,"usage_5_years":6491,"usage_all_time":7815,"bio_tools_summary":"Metaproteomics data analysis with a focus on interactive data visualizations.","bio_tools_ids":"unipept","bio_tools_name":"Unipept","related_tutorials":["https://training.galaxyproject.org/training-material/topics/microbiome/tutorials/clinical-mp-5-data-interpretation/tutorial.html","https://training.galaxyproject.org/training-material/topics/proteomics/tutorials/clinical-mp-5-data-interpretation/tutorial.html","https://training.galaxyproject.org/training-material/topics/proteomics/tutorials/metaproteomics/tutorial.html","https://training.galaxyproject.org/training-material/topics/proteomics/tutorials/metaquantome-data-creation/tutorial.html"],"related_workflows":[{"create_time":"2026-05-18","latest_version":"2","link":"https://workflowhub.eu/workflows/1443?version=2","name":"Metaproteomics_GTN"},{"create_time":"2025-06-02","latest_version":"1","link":"https://workflowhub.eu/workflows/1482?version=1","name":"WF5_Data_Interpretation_Worklow"},{"create_time":"2025-06-02","latest_version":"1","link":"https://workflowhub.eu/workflows/1450?version=1","name":"metaQuantome_datacreation_workflow"},{"create_time":"2025-06-02","latest_version":"1","link":"https://workflowhub.eu/workflows/1433?version=1","name":"WF5_Data