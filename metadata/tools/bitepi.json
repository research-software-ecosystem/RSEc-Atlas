{"tool_name":"bitepi","contents":["biotools","oeb"],"identifiers":["biotools:bitepi"],"fetched_metadata":{"biotools":{"id":"BitEpi","home":"https://github.com/aehrc/BitEpi","summary":"A Fast and Accurate Exhaustive Higher-Order Epistasis Search.\n\nBitEpi: An exhaustive search of higher-order epistatic interactions.\n\nBitEpi is software for an exhaustive search of higher-order epistatic interactions between genomic variants (SNPs) given a binary phenotype (Case/Control).\n\nBitEpi performs an exhaustive search that means it tests all possible combinations of SNPs. For example, the 4-SNP search of 50 SNPs (data.csv) requires to test all \"4 out of 50\" 4-SNP combinations (230300 4-SNP combinations)","addition_date":"2020-01-14T19:39:54Z","last_update_date":"2026-11-12T14:30:00.643938Z","biotools_curie":"biotools:BitEpi","edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Database search","uri":"http://edamontology.org/operation_2421"},{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"BitEpi","owner":"Pub2Tools","publication":[{"doi":"10.1038/s41598-021-94959-y","type":["Primary"]},{"doi":"10.1101/858282","type":["Preprint"]}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Microarray experiment","uri":"http://edamontology.org/topic_3518"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:bitepi/undefined/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"de