{"tool_name":"minicore","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"minicore","home":"https://github.com/dnbaker/minicore","license":"MIT","summary":"Minicore is a fast, generic library for constructing and clustering coresets on graphs, in metric spaces and under non-metric dissimilarity measures. It includes methods for constant-factor and bicriteria approximation solutions, as well as coreset sampling algorithms. These methods allow for fast and accurate summarization of and clustering of datasets with strong theoretical guarantees. Minicore both stands for \"mini\" and \"core\", as it builds concise representations via core-sets, and as a portmanteau of Manticore and Minotaur.","addition_date":"2021-10-10T14:33:01.588464Z","last_update_date":"2021-10-10T14:33:01.590927Z","biotools_curie":"biotools:minicore","credit":[{"email":"dbaker49@jhu.edu","name":"Daniel N. Baker","orcidid":"https://orcid.org/0000-0002-0513-6893","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"langmea@cs.jhu.edu","name":"Ben Langmead","orcidid":"https://orcid.org/0000-0003-2437-1976","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"},{"term":"Dimensionality reduction","uri":"http://edamontology.org/operation_3935"},{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"minicore","owner":"Kigaard","publication":[{"doi":"10.1101/2021.03.24.436859","type":["Primary"]}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}]},"bioschemas":{"name":"minicore","home":"https://bio.tools/minicore","license":"MIT","summary":"Minicore is a fast, generic library for constructing and clustering coresets on graphs, in met