{"tool_name":"linclust","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"Linclust","home":"https://mmseqs.com","license":"GPL-3.0","summary":"Linclust is the first clustering algorithm whose runtime scales linearly. With Linclust we clustered 1.6 billion metagenomic sequence fragments in 10\u2009h on a single server to 50% sequence identity.","addition_date":"2019-07-03T16:03:27Z","last_update_date":"2024-11-24T21:01:43.602795Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:Linclust","cost":"Free of charge","credit":[{"name":"S\u00f6ding Lab","typeEntity":"Division","typeRole":["Primary contact"],"url":"https://www.mpibpc.mpg.de/soeding"}],"documentation":[{"note":"Tutorial material","type":["Training material"],"url":"https://github.com/soedinglab/metaG-ECCB18-partII"},{"type":["General"],"url":"https://github.com/soedinglab/MMseqs2/blob/master/README.md"},{"type":["User manual"],"url":"https://github.com/soedinglab/mmseqs2/wiki"}],"edit_permission":{"type":"private"},"function":[{"cmd":"mmseqs easy-linclust input.fasta output tmp","input":[{"data":{"term":"Sequence set","uri":"http://edamontology.org/data_0850"},"format":[{"term":"FASTA-like (text)","uri":"http://edamontology.org/format_2200"},{"term":"FASTQ-like format (text)","uri":"http://edamontology.org/format_2182"}]}],"operation":[{"term":"Sequence clustering","uri":"http://edamontology.org/operation_0291"}],"output":[{"data":{"term":"Sequence cluster","uri":"http://edamontology.org/data_1235"}}]}],"maturity":"Mature","name":"Linclust","operating_system":["Linux","Mac","Windows"],"owner":"milot-mirdita","publication":[{"doi":"10.1038/s41467-018-04964-5","metadata":{"abstract":"Metagenomic datasets contain billions of protein sequences that could greatly enhance large-scale functional annotation and structure prediction. Utilizing this enormous resource would require reducing its redundancy by similarity clustering. However, clustering hundreds of millions of sequences is impractical using current algorithms because their runtimes scale as the input set size N times the number of clusters K, which is typically of similar order as N, resulting in runtimes that increase almost quadratically with N. We developed Linclust, the first clustering algorithm whose runtime scales as N, independent of K. It can also cluster datasets several times larger than the available main memory. We cluster 1.6 billion metagenomic sequence fragments in 10 h on a single server to 50% sequence identity, >1000 times faster than has been possible before. Linclust will help to unlock the great wealth contained in metagenomic and genomic sequence databases.","authors":[{"name":"Soding J."},{"name":"Steinegger M."}],"citationCount":444,"date":"2018-12-01T00:00:00Z","journal":"Nature Communications","title":"Clustering huge protein sequence sets in linear time"},"pmcid":"PMC6026198","pmid":"29959318","type":["Primary"]}],"topic":[{"term":"Gene and protein families","uri":"http://edamontology.org/topic_0623"},{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Nucleic acids","uri":"http://edamontology.org/topic_0077"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"bioschemas":{"name":"Linclust","home":"https://bio.tools/Linclust","license":"GPL-3.0","summary":"Linclust is the first clustering algorithm whose runtime scales linearly. With Linclust we clustered 1.6 billion metagenomic sequence fragments in 10\u2009h on a single server to 50% sequence identity.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:linclust/cmd/mmseqs.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_pa