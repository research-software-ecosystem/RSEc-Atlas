tructure_checking.readthedocs.io/en/latest/","license_file":"","build":{"noarch":"python","number":0,"run_exports":[null],"script":" -m pip install . --no-deps --ignore-installed --no-cache-dir -vvv"},"requirements":{"host":["python >=3.9","setuptools","pip","numpy","biopython >=1.79","psutil"],"run":["python >=3.9","setuptools","pip","numpy","biopython >=1.79","psutil"]},"source_url":"https://pypi.io/packages/source/b/biobb_structure_checking/biobb_structure_checking-3.16.3.tar.gz","test":{"imports":["biobb_structure_checking"]},"recipe_maintainers":""}}}