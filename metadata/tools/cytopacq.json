{"tool_name":"cytopacq","contents":["neubias","oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"CytoPacq","home":"https://cbia.fi.muni.cz/simulator","license":"Other","summary":"Web-interface for simulating multi-dimensional cell imaging.","addition_date":"2019-08-09T13:15:58Z","last_update_date":"2024-11-24T21:02:09.607146Z","tool_type":["Web application"],"accessibility":"Open access","biotools_curie":"biotools:CytoPacq","cost":"Free of charge","credit":[{"email":"cbia-cytopacq@fi.muni.cz","typeEntity":"Project","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"https://cbia.fi.muni.cz/research/simulations/cytopacq.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Deisotoping","uri":"http://edamontology.org/operation_3629"}]}],"maturity":"Mature","name":"CytoPacq","operating_system":["Linux","Mac","Windows"],"owner":"hans","publication":[{"doi":"10.1093/bioinformatics/btz417","metadata":{"abstract":"Motivation: Objective assessment of bioimage analysis methods is an essential step towards understanding their robustness and parameter sensitivity, calling for the availability of heterogeneous bioimage datasets accompanied by their reference annotations. Because manual annotations are known to be arduous, highly subjective and barely reproducible, numerous simulators have emerged over past decades, generating synthetic bioimage datasets complemented with inherent reference annotations. However, the installation and configuration of these tools generally constitutes a barrier to their widespread use. Results: We present a modern, modular web-interface, CytoPacq, to facilitate the generation of synthetic benchmark datasets relevant for multi-dimensional cell imaging. CytoPacq poses a user-friendly graphical interface with contextual tooltips and currently allows a comfortable access to various cell simulation systems of fluorescence microscopy, which have already been recognized and used by the scientific community, in a straightforward and self-contained form. Availability and implementation: CytoPacq is a publicly available online service running at https://cbia.fi.muni.cz/simulator. More information about it as well as examples of generated bioimage datasets are available directly through the web-interface. Supplementary information: Supplementary data are available at Bioinformatics online.","authors":[{"name":"Kozubek M."},{"name":"Maska M."},{"name":"Svoboda D."},{"name":"Wiesner D."}],"citationCount":19,"date":"2019-11-01T00:00:00Z","journal":"Bioinformatics","title":"CytoPacq: A web-interface for simulating multi-dimensional cell imaging"},"pmcid":"PMC6821329","pmid":"31114843","type":["Primary"]}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Imaging","uri":"http://edamontology.org/topic_3382"}],"validated":1},"bioschemas":{"name":"CytoPacq","home":"https://bio.tools/CytoPacq","license":"Other","summary":"Web-interface for simulating multi-dimensional cell imaging.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:cytopacq/web/cbia.fi.muni.cz","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":8,"citations":[{"count":1,"year":"2020"},{"count":1,"year":"2022"},{"count":1,"year":"2024"},{"count":1,"year":"2025"},{"count":2,"year":"2023"},{"count":2,"year":"2026"}],"doi":"10.1093/bioinformatics/btz417","pmcid":"PMC6821329","pmid":"31114843","ref_count":17,"refs":[{"count":1,"year":"2009"},{"count":1,"year":"2013"},{"count":1,"year":"2017"},{"count":2,"year":"2015"},{"count":3,"year":"2012"},{"count":3,"year":"2014"},{"count":3,"year":"2016"},{"count":3,"year":"2018"}],"title":"CytoPacq: a web-interface for simulating multi-dimensi