{"tool_name":"gostag","contents":["biotools","oeb"],"fetched_metadata":{"biotools":{"id":"gostag","home":"https://bioconductor.org/packages/goSTAG","license":"GPL-3.0","summary":"Given a Gene Ontology (GO) and an annotation of genes, significance of the over-representation of the genes within the ontological categories is determined by a Fisher's exact test or modeling according to a hypergeometric distribution. goSTAG uses GO subtrees to tag and annotate genes within a set. goSTAG visualizes the similarities between the over-representation of DEGs by clustering the p-values from the enrichment statistical tests and labels clusters with the GO term.","addition_date":"2018-07-18T19:16:50Z","last_update_date":"2026-10-02T15:58:58.653053Z","tool_type":["Library"],"version":["1.36.0"],"collections":["BioConductor"],"biotools_curie":"biotools:gostag","cost":"Free of charge","credit":[{"name":"Brian D. Bennett and Pierre R. Bushel"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/goSTAG"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"}]},{"operation":[{"term":"Differential gene expression profiling","uri":"http://edamontology.org/operation_3223"}]},{"operation":[{"term":"Gene-set enrichment analysis","uri":"http://edamontology.org/operation_2436"}]},{"operation":[{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"goSTAG","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[{"doi":"10.1186/s13029-017-0066-1","pmcid":"PMC5390446","pmid":"28413437","type":["Primary"]}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Microarray experiment","uri":"http://edamontology.org/topic_3518"},{"term":"Ontology and terminology","uri":"http://edamontology.org/topic_0089"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"oeb":{"metrics":[{"@id":"