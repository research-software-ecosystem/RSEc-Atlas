{"tool_name":"bioconductor-chipseeker","contents":["biocontainers","oeb","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-chipseeker","identifiers":["biotools:chipseeker","doi:10.1093/bioinformatics/btv145"],"license":"Artistic-2.0","summary":"This package implements functions to retrieve the nearest genes around the peak, annotate the genomic region of the peak, statistical methods for estimating the significance of overlap among chip peak data sets, and incorporate geo database to compare the own dataset with those deposited in database. the comparison can be used to infer cooperative regulation and thus can be used to generate hypotheses.","home_url":"http://bioconductor.org/packages/release/bioc/html/ChIPseeker.html","keywords":["Binding Sites","Chromatin Immunoprecipitation","Computer Graphics","DNA","High-Throughput Nucleotide Sequencing","Molecular Sequence Annotation","Sequence Analysis, DNA","Transcription Factors","Transcription Initiation Site","ChIP-seq","Data visualisation","Data mining"],"manually_check":true,"total_pulls":144},"biotools":{"id":"bioconductor-chipseeker","home":"https://bioconductor.org/packages/epiSeeker","license":"Artistic-2.0","summary":"This package implements functions to analyze multi-omics epigenetic data. Data of fragment type and base type are supported by epiSeeker. It provides functions to retrieve the nearest genes around the peak, annotate genomic region of the peak, statistical methods to estimate the significance of overlap among peak data sets, and motif analysis. It incorporates the GEO database for users to compare their own dataset with those deposited in the database. The comparison can be used to infer cooperative regulation and thus can be used to generate hypotheses. Several visualization functions are implemented to summarize the coverage of the peak experiment, average profile and heatmap of peaks binding to TSS regions, genomic annotation, distance to TSS, overlap of peaks or genes, and the single-base resolution epigenetic data by considering the strand, motif, and additional information.","addition_date":"2026-08-30T02:39:24.505289Z","last_update_date":"2026-09-01T06:33:00.995223Z","tool_type":["Command-line tool","Library"],"version":["1.0.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-chipseeker","credit":[{"name":"Chun-Hui Gao","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Guangchuang Yu","typeEntity":"Person","typeRole":["Contributor","Developer","Maintainer"]},{"name":"Herv\u00e9 Pag\u00e8s","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Michael Kluge","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Ming Li","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Qianwen Wang","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Thomas Schwarzl","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Yun Yan","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Zhougeng Xu","typeEntity":"Person","typeRole":["Contributor"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/epiSeeker"}],"edit_permission":{"type":"private"},"name":"ChIPseeker","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.1002/cpz1.585"},{"doi":"10.1093/bioinformatics/btv145"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-chipseeker:1.10.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://bioconductor.org/packages/release/bioc/html/ChIPseeker.html"}],"ssl":true,"ssl_err":null}}},{"@id":"https://openeb