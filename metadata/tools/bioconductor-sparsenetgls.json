{"tool_name":"bioconductor-sparsenetgls","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-sparsenetgls","identifiers":["doi:10.18129/b9.bioc.sparsenetgls"],"license":"GPL-3","summary":"Using Gaussian graphical structue learning estimation in generalized least squared regression for multivariate normal regression","home_url":"https://bioconductor.org/packages/3.8/bioc/html/sparsenetgls.html","keywords":["Proteomics","Metabolomics"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-sparsenetgls","home":"https://bioconductor.org/packages/sparsenetgls","license":"GPL-3.0","summary":"The package provides methods of combining the graph structure learning and generalized least squares regression to improve the regression estimation. The main function sparsenetgls() provides solutions for multivariate regression with Gaussian distributed dependant variables and explanatory variables utlizing multiple well-known graph structure learning approaches to estimating the precision matrix, and uses a penalized variance covariance matrix with a distance tuning parameter of the graph structure in deriving the sandwich estimators in generalized least squares (gls) regression. This package also provides functions for assessing a Gaussian graphical model which uses the penalized approach. It uses Receiver Operative Characteristics curve as a visualization tool in the assessment.","tool_type":["Command-line tool","Library"],"version":["1.30.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-sparsenetgls","credit":[{"name":"Irene Zeng","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Thomas Lumley","typeEntity":"Person","typeRole":["Contributor"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/sparsenetgls"}],"name":"sparsenetgls","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"d