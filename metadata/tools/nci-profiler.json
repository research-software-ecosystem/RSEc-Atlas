{"tool_name":"nci-profiler","contents":["bioschemas","biotools","oeb"],"fetched_metadata":{"biotools":{"id":"nci-profiler","home":"https://ncip.khu.ac.kr","license":"AGPL-3.0","summary":"NCI-Profiler (NCIP) automatically detects and visualizes protein\u2013ligand non-covalent interactions: hydrogen bonds, hydrophobic contacts, salt bridges, \u03c0\u2013\u03c0 stacking, cation\u2013\u03c0, halogen bonds, metal coordination (with \u03c44/\u03c45 geometry analysis), water bridges and halogen\u2013water\u2013hydrogen (XWH) bridges. It takes PDB/mmCIF files or PDB IDs without manual preparation, handles multi-ligand and macrocyclic ligands, and produces editable 2D diagrams, an in-browser Mol* 3D view, PyMOL sessions and JSON/CSV/TXT output. Available as a free web server and a dependency-free Python CLI/API.","addition_date":"2026-10-16T08:09:19.319104Z","last_update_date":"2026-10-16T08:09:30.223486Z","tool_type":["Command-line tool","Library","Web application"],"version":["1.0.0"],"accessibility":"Open access","biotools_curie":"biotools:nci-profiler","cost":"Free of charge","credit":[{"name":"Eun Yeol Lee","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"Kyung Hee University","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Sharma Rahul","typeEntity":"Person","typeRole":["Developer","Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"PDB ID","uri":"http://edamontology.org/data_1127"}},{"data":{"term":"Protein structure","uri":"http://edamontology.org/data_1460"},"format":[{"term":"PDB","uri":"http://edamontology.org/format_1476"},{"term":"mmCIF","uri":"http://edamontology.org/format_1477"}]}],"note":"Outputs also include PyMOL scripts and sessions.","operation":[{"term":"Hydrogen bond calculation","uri":"http://edamontology.org/operation_0394"},{"term":"Residue interaction calculation","uri":"http://edamontology.org/operation_0248"},{"term":"Structure visualisation","uri":"http://edamontology.org/ope