{"tool_name":"snexpression","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"snexpression","home":"http://www.di.unito.it/~depierro/SNexpression","summary":"A Symbolic Calculator for Symmetric Net Expressions.\n\nA tool for Symmetric Nets structural analysis.\n\nDownload SNexpression and related utilities.\n\nSNexpression is a software tool for structural analysis of Symmetric Nets (SN). It is composed by two software layers: a Library for Symbolic Calculus (LSC) and a Command Line Interface (CLI), implementing a symbolic calculus operating on SN arc expressions. The CLI is a parser of expressions denoting structural relationships in SN models, it reads from the standard input, thus it can be used as a user interface or can be integrated in other tools for the design of SN models.","addition_date":"2021-01-18T10:12:49Z","last_update_date":"2024-11-24T20:42:28.978309Z","biotools_curie":"biotools:snexpression","credit":[{"email":"massimiliano.depierro@unito.it","name":"Massimiliano De Pierro","typeEntity":"Person"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"SNexpression","owner":"zsmag19","publication":[{"pmcid":"PMC7324237"}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Protein expression","uri":"http://edamontology.org/topic_0108"},{"term":"Structure analysis","uri":"http://edamontology.org/topic_0081"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:snexpression/undefined/www.di.unito.it","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":0,"citations":[],"pmcid":"PMC7324237","ref_count":0,"refs":[]}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"ope