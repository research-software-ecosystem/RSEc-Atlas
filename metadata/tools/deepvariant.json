{"tool_name":"deepvariant","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"deepvariant","identifiers":["doi:10.1038/nbt.4235","doi:10.1101/2020.02.10.942086"],"license":"MIT","summary":"Deepvariant is an analysis pipeline that uses a deep neural network to call genetic variants from next-generation dna sequencing data","home_url":"https://github.com/google/deepvariant","keywords":["Genomics"],"manually_check":true,"total_pulls":15},"biotools":{"id":"deepvariant","home":"https://github.com/google/deepvariant","license":"BSD-3-Clause","summary":"DeepVariant is a deep learning-based variant caller that takes aligned reads (in BAM or CRAM format), produces pileup image tensors from them, classifies each tensor using a convolutional neural network, and finally reports the results in a standard VCF or gVCF file.","addition_date":"2021-03-19T08:49:27Z","last_update_date":"2024-11-24T20:38:19.435847Z","biotools_curie":"biotools:deepvariant","credit":[{"email":"cym@google.com","name":"Cory Y McLean","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"}]}],"name":"DeepVariant","owner":"Kigaard","publication":[{"doi":"10.1093/bioinformatics/btaa1081","metadata":{"abstract":"Motivation: Population-scale sequenced cohorts are foundational resources for genetic analyses, but processing raw reads into analysis-ready cohort-level variants remains challenging. Results: We introduce an open-source cohort-calling method that uses the highly accurate caller DeepVariant and scalable merging tool GLnexus. Using callset quality metrics based on variant recall and precision in benchmark samples and Mendelian consistency in father-mother-child trios, we optimize the method across a range of cohort sizes, sequencing methods and sequencing depths. The resulting callsets show consistent quality improvements over those generated using existing best practices with reduced cost. We further evaluate our pipeline in the deeply sequenced 1000 Genomes Project (1KGP) samples and show superior callset quality metrics and imputation reference panel performance compared to an independently generated GATK Best Practices pipeline.","authors":[{"name":"Carroll A."},{"name":"Chang P.-C."},{"name":"Li H."},{"name":"Lin M.F."},{"name":"McLean C.Y."},{"name":"Yun T."}],"citationCount":74,"date":"2020-12-15T00:00:00Z","journal":"Bioinformatics","title":"Accurate, scalable cohort variant calls using DeepVariant and GLnexus"},"pmcid":"PMC8023681","pmid":"33399819"}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Exome sequencing","uri":"http://edamontology.org/topic_3676"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Whole genome sequencing","uri":"http://edamontology.org/topic_3673"}]},"bioschemas":{"name":"DeepVariant","home":"https://bio.tools/deepvariant","license":"BSD-3-Clause","summary":"DeepVariant is a deep learning-based variant caller that takes aligned reads (in BAM or CRAM format), produces pileup image tensors from them, classifies each tensor using a convolutional neural network, and finally reports the results in a standard VCF or gVCF file.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:deepvariant/undefined/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"op