{"tool_name":"diversityscientificterms","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"DiversityScientificTerms","home":"https://diversityworkbench.net/Portal/DiversityScientificTerms","license":"GPL-2.0","summary":"DiversityScientificTerms (DWB-DST) is an application of Diversity Workbench (DWB). It might be installed as part of a DWB environment, but also as a stand-alone application, e. g., in a local installation. Each DWB module is devoted to a specific data domain. DST is focussed on the management of collections of scientific terms and term concepts, i. e., particular domain-specific  terminologies, glossaries and vocabularies (e.g. biostratigraphy, anatomical terminology). DST is able to organise terms together with synonyms, common names and equivalent  terms \u00edn different languages. The single terms are defined, (hierarchically) classified and referenced, for example, by linking online resources and external identifiers.","addition_date":"2019-06-16T22:14:16Z","last_update_date":"2020-06-16T10:55:23Z","tool_type":["Desktop application"],"accessibility":"Open access","biotools_curie":"biotools:DiversityScientificTerms","cost":"Free of charge","credit":[{"email":"triebel@snsb.de","name":"Dagmar Triebel","orcidid":"https://orcid.org/0000-0003-1980-3148","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.snsb.info/staff_triebel.html"},{"email":"it-center@snsb.de","name":"SNSB IT Center","typeEntity":"Division","typeRole":["Maintainer","Provider","Support"],"url":"http://www.snsb.info/"},{"name":"Deutsche Forschungsgemeinschaft (DFG)","typeEntity":"Funding agency"}],"documentation":[{"note":"database model","type":["Other"],"url":"https://diversityworkbench.net/Portal/DiversityScientificTerms_Information_Models"},{"type":["Training material"],"url":"https://diversityworkbench.net/Portal/Training_materials"},{"type":["User manual"],"url":"https://diversityworkbench.net/Portal/DWB_user_manuals"}],"edit_per