{"tool_name":"soapindel","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"soapindel","home":"http://soap.genomics.org.cn/index.html","license":"GPL-3.0","summary":"Developed to find the insertion and deletion specially for re-sequence technology.","addition_date":"2017-08-20T15:59:06Z","last_update_date":"2019-09-04T08:38:37Z","tool_type":["Command-line tool"],"collections":["Animal and Crop Genomics"],"biotools_curie":"biotools:soapindel","credit":[{"email":"soap@genomics.org.cn","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://soap.genomics.org.cn/soapindel.html"}],"edit_permission":{"authors":["animalandcropgenomics"],"type":"group"},"function":[{"operation":[{"term":"Indel detection","uri":"http://edamontology.org/operation_0452"}]}],"name":"SOAPindel","operating_system":["Linux"],"owner":"admin","publication":[{"doi":"10.1101/gr.132480.111","metadata":{"abstract":"We present a new approach to indel calling that explicitly exploits that indel differences between a reference and a sequenced sample make the mapping of reads less efficient. We assign all unmapped reads with a mapped partner to their expected genomic positions and then perform extensive de novo assembly on the regions with many unmapped reads to resolve homozygous, heterozygous, and complex indels by exhaustive traversal of the de Bruijn graph. The method is implemented in the software SOAPindel and provides a list of candidate indels with quality scores. We compare SOAPindel to Dindel, Pindel, and GATK on simulated data and find similar or better performance for short indels (<10 bp) and higher sensitivity and specificity for long indels. A validation experiment suggests that SOAPindel has a falsepositive rate of \u223c10% for long indels (>5 bp), while still providing many more candidate indels than other approaches.","authors":[{"name":"Bolund L."},{"name":"Li H."},{"name":"Li R."},{"name":"Li S."},{"name":"Li Y."},{"name":"Lu J."},{"name":"Schierup M.H."},{"name":"Wang J."}],"citationCount":82,"date":"2013-01-01T00:00:00Z","journal":"Genome Research","title":"SOAPindel: Efficient identification of indels from short paired reads"},"pmcid":"PMC3530679","pmid":"22972939","type":["Primary"]}],"topic":[{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"}],"validated":1},"bioschemas":{"name":"SOAPindel","home":"https://bio.tools/soapindel","license":"GPL-3.0","summary":"Developed to find the insertion and deletion specially for re-sequence technology.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:soapindel/cmd/soap.genomics.org.cn","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":66,"citations":[{"count":1,"year":"2026"},{"count":2,"year":"2022"},{"count":2,"year":"2023"},{"count":2,"year":"2024"},{"count":3,"year":"2020"},{"count":4,"year":"2019"},{"count":4,"year":"2021"},{"count":5,"year":"2016"},{"count":5,"year":"2017"},{"count":6,"year":"2013"},{"count":8,"year":"2018"},{"count":10,"year":"2014"},{"count":14,"year":"2015"}],"doi":"10.1101/gr.132480.111","pmcid":"PMC3530679","pmid":"22972939","ref_count":14,"refs":[{"count":1,"year":"1998"},{"count":2,"year":"2008"},{"count":3,"year":"2011"},{"count":4,"year":"2009"},{"count":4,"year":"2010"}],"title":"SOAPindel: efficient identification of indels from short paired reads.","year":2012}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":408,"ssl":null,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:soapindel:none/cmd/soap.genomics.org.cn","@license":"https://creativec