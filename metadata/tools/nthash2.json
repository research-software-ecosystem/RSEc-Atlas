{"tool_name":"nthash2","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"nthash2","home":"http://github.com/bcgsc/ntHash","license":"MIT","summary":"Recursive spaced seed hashing for nucleotide sequences.","addition_date":"2022-10-11T19:37:11.662860Z","last_update_date":"2024-11-24T15:27:24.081180Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:nthash2","cost":"Free of charge","credit":[{"name":"Hamid Mohamadi"},{"name":"Johnathan Wong"},{"name":"Vladimir Nikoli\u0107"},{"name":"Inan\u00e7 Birol","orcidid":"https://orcid.org/0000-0003-0950-7839"},{"name":"Parham Kazemi","orcidid":"https://orcid.org/0000-0002-2126-5644"},{"name":"Ren\u00e9 L Warren","orcidid":"https://orcid.org/0000-0002-9890-2293"}],"edit_permission":{"type":"private"},"name":"ntHash2","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1093/bioinformatics/btac564","metadata":{"abstract":"Motivation: Spaced seeds are robust alternatives to k-mers in analyzing nucleotide sequences with high base mismatch rates. Hashing is also crucial for efficiently storing abundant sequence data. Here, we introduce ntHash2, a fast algorithm for spaced seed hashing that can be integrated into various bioinformatics tools for efficient sequence analysis with applications in genome research. Results: ntHash2 is up to 2.1\u00d7 faster at hashing various spaced seeds than the previous version and 3.8\u00d7 faster than conventional hashing algorithms with na\u00efve adaptation. Additionally, we reduced the collision rate of ntHash for longer k-mer lengths and improved the uniformity of the hash distribution by modifying the canonical hashing mechanism.","authors":[{"name":"Birol I."},{"name":"Kazemi P."},{"name":"Mohamadi H."},{"name":"Nikolic V."},{"name":"Warren R.L."},{"name":"Wong J."}],"citationCount":5,"date":"2022-10-15T00:00:00Z","journal":"Bioinformatics","title":"ntHash2: recursive spaced seed hashing for nucleotide sequences"},"pmcid":"PMC9563681","pmid":"36000872"}],"topic":[{"term":"Bioinformatics","uri":"http://edamontology.org/topic_0091"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"bioschemas":{"name":"ntHash2","home":"https://bio.tools/nthash2","license":"MIT","summary":"Recursive spaced seed hashing for nucleotide sequences.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:nthash2/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":10,"citations":[{"count":1,"year":"2024"},{"count":2,"year":"2026"},{"count":3,"year":"2025"},{"count":4,"year":"2023"}],"doi":"10.1093/bioinformatics/btac564","pmcid":"PMC9563681","pmid":"36000872","ref_count":4,"refs":[{"count":1,"year":"2002"},{"count":1,"year":"2016"},{"count":1,"year":"2019"},{"count":1,"year":"2020"}],"title":"ntHash2: recursive spaced seed hashing for nucleotide sequences.","year":2022}]}],"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://github.com/BirolLab/ntHash"},{"status":301,"url":"https://github.com/bcgsc/ntHash"}],"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/nthash2","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://github.com/BirolLab/ntHash"},{"status":301,"url":"https://github.com/bcgsc/ntHash"}],"ssl":true,"ssl_err":null}}}]}}}