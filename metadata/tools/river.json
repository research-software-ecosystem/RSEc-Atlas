{"tool_name":"river","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"river","home":"https://bioconductor.org/packages/RIVER","license":"GPL-2.0-or-later","summary":"An implementation of a probabilistic modeling framework that jointly analyzes personal genome and transcriptome data to estimate the probability that a variant has regulatory impact in that individual. It is based on a generative model that assumes that genomic annotations, such as the location of a variant with respect to regulatory elements, determine the prior probability that variant is a functional regulatory variant, which is an unobserved variable. The functional regulatory variant status then influences whether nearby genes are likely to display outlier levels of gene expression in that person. See the RIVER website for more information, documentation and examples.","addition_date":"2018-07-13T09:35:07Z","last_update_date":"2026-08-30T02:30:31.239428Z","tool_type":["Library"],"version":["1.36.0"],"collections":["BioConductor"],"biotools_curie":"biotools:river","credit":[{"name":"Alexis Battle","typeEntity":"Person","typeRole":["Developer"]},{"name":"Yungil Kim","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/RIVER"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"}]},{"operation":[{"term":"Regression analysis","uri":"http://edamontology.org/operation_3659"}]}],"name":"RIVER","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Function analysis","uri":"http://edamontology.org/topic_1775"},{"term":"Functional genomics","uri":"http://edamontology.org/topic_0085"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Gene regulation","uri":"http://edamontology.org/t