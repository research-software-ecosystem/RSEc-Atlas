emas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-nanotator:1.6.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-nanotator:1.8.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconductor-nanotator","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}}]},"bioconda":{"name":"bioconductor-nanotator","version":"1.18.0","home":"https://bioconductor.org/packages/3.18/bioc/html/nanotatoR.html","license":"file LICENSE","summary":"Next generation structural variant annotation and classification","description":"Whole genome sequencing (WGS) has successfully been used to identify single-nucleotide variants (SNV), small insertions and deletions (INDELs) and, more recently, small copy number variants (CNVs). However, due to utilization of short reads, it is not well suited for identification of structural variants (SV). Optical mapping (OM) from Bionano Genomics, utilizes long fluorescently labeled megabase size DNA molecules for de novo genome assembly and identification of SVs with a much higher sensitivity than WGS. Nevertheless, currently available SV annotation tools have limited number of functions. NanotatoR is an R package written to provide a set of annotations for SVs identified by OM. It uses Database of Genomic Variants (DGV), Database of Chromosomal Imbalance and Phenotype in Humans Using Ensembl Resources (DECIPHER) as well as a subset (154 samples) of 1000 Genome Project to calculate the population frequencies of the SVs (an optional internal cohort SV frequency calculation is also available). NanotatoR creates a primary gene list (PG) from NCBI databases based on proband\u2019s phenotype specific keywords and compares the list to the set of genes overlapping/near SVs. The output is given in an Excel file format, which is subdivided into multiple sheets based on SV type (e.g., INDELs, Inversions, Translocations). Users then have a choice to filter SVs using the provided annotations for de novo (if parental samples are available) or inherited rare variants.","license_file":"LICENSE","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-annotationdbi >=1.64.0,<1.65.0","bioconductor-genomicranges >=1.54.0,<1.55.0","bioconductor-org.hs.eg.db >=3.18.0,<3.19.0","r-base","r-curl","r-dplyr","r-hash >=2.2.6","r-httr","r-knitr","r-openxlsx >=4.0.17","r-rentrez >=1.1.0","r-rlang","r-stringr","r-testthat","r-tidyverse","r-varfrompdb","r-xml","r-xml2r"],"run":["bioconductor-annotationdbi >=1.64.0,<1.65.0","bioconductor-genomicranges >=1.54.0,<1.55.0","bioconductor-org.hs.eg.db >=3.18.0,<3.19.0","r-base","r-curl","r-dplyr","r-hash >=2.2.6","r-httr","r-knitr","r-openxlsx >=4.0.17","r-rentrez >=1.1.0","r-rlang","r-stringr","r-testthat","r-tidyverse","r-varfrompdb","r-xml","r-xml2r"]},"source_url":["https://bioconductor.org/packages/3.18/bioc/src/contrib/nanotatoR_1.18.0.tar.gz","https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/nanotatoR/nanotatoR_1.18.0.tar.gz","https://bioarchive.galaxyproject.org/nanotatoR_1.18.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-nanotator/bioconductor-nanotator_1.18.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('nanotatoR')\""]}}}}