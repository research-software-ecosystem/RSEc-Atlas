solve_time":null}}}]},"debian":{"package":"vadr","distribution":"prospective","release":"vcs","component":"main","version":"1.2.1","source":"vadr","homepage":"https://github.com/ncbi/vadr","license":"public_domain","blend":"debian-med","registries":[{"entry":"VADR","name":"bio.tools"}],"bib":[{"key":"doi","value":"10.1101/852657"}],"descr":[{"package":"vadr","description":"classification and annotation of viral sequences","long_description":" VADR (Viral Annotation DefineR) is a suite of tools for classifying and\n analyzing sequences homologous to a set of reference models of viral\n genomes or gene families. It has been mainly tested for analysis of\n Norovirus and Dengue virus sequences in preparation for submission to\n the GenBank database and finds its application also for the ongoing\n pandemics.","release":"vcs","license":"public_domain","blend":"debian-med"}]}}}