{"tool_name":"biochef","contents":["biotools"],"fetched_metadata":{"biotools":{"id":"biochef","home":"https://biochef.app","license":"MIT","summary":"Open-source web application for building and running genomic data analysis workflows in the browser. Bioinformatics tools such as samtools, minimap2, bcftools, bedtools, seqtk, fastp and GTO are compiled to WebAssembly and run on the user's own computer, so data is not uploaded. Tools are published as signed bundles in the BioChef Registry and verified in the browser before they run. Workflows are built with drag and drop and shared as a single JSON file.","addition_date":"2026-10-10T22:34:52.807314Z","last_update_date":"2026-10-10T22:35:01.077185Z","tool_type":["Web application","Workbench"],"accessibility":"Open access","biotools_curie":"biotools:biochef","cost":"Free of charge","credit":[{"name":"Jorge Miguel Silva","orcidid":"https://orcid.org/0000-0002-6331-6091","typeEntity":"Person","typeRole":["Developer","Primary contact"]},{"name":"Jos\u00e9 Lu\u00eds Oliveira","orcidid":"https://orcid.org/0000-0002-6672-6176","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Joaquim Rosa","typeEntity":"Person","typeRole":["Developer"]},{"name":"Jo\u00e3o Andrade","typeEntity":"Person","typeRole":["Developer"]},{"name":"IEETA, University of Aveiro","typeEntity":"Institute","typeRole":["Provider"],"url":"https://www.ieeta.pt"}],"documentation":[{"note":"Project site: architecture, workflows, developer guide","type":["General"],"url":"https://home.biochef.app"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Data","uri":"http://edamontology.org/data_0006"},"format":[{"term":"BAM","uri":"http://edamontology.org/format_2572"},{"term":"FASTA","uri":"http://edamontology.org/format_1929"},{"term":"FASTQ","uri":"http://edamontology.org/format_1930"},{"term":"VCF","uri":"http://edamontology.org/format_3016"}]}],"note":"Operations come from the tools in the BioChef Registry and are chained into workflows in the browser.","operation":[{"term":"Data formatting","uri":"http://edamontology.org/operation_0335"},{"term":"Multiple sequence alignment","uri":"http://edamontology.org/operation_0492"},{"term":"Phylogenetic inference","uri":"http://edamontology.org/operation_0323"},{"term":"Read mapping","uri":"http://edamontology.org/operation_3198"},{"term":"Sequence trimming","uri":"http://edamontology.org/operation_3192"},{"term":"Sequencing quality control","uri":"http://edamontology.org/operation_3218"}]}],"maturity":"Emerging","name":"BioChef","operating_system":["Linux","Mac","Windows"],"owner":"jorge_miguel","publication":[{"doi":"10.1186/s12859-026-06431-1","note":"BMC Bioinformatics 27, 103 (2026)","type":["Primary"]}],"topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]}}}