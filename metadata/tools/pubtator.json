{"tool_name":"pubtator","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"pubtator","home":"http://www.ncbi.nlm.nih.gov/CBBresearch/Lu/Demo/PubTator/","summary":"Web server for text based mining to assist biocuration.","addition_date":"2017-03-25T17:08:23Z","last_update_date":"2018-12-10T12:58:55Z","tool_type":["Web application"],"biotools_curie":"biotools:pubtator","credit":[{"email":"zhiyong.lu@nih.gov","name":"Zhiyong Lu","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://www.ncbi.nlm.nih.gov/CBBresearch/Lu/Demo/PubTator/tutorial/PubTator_ISB2014.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Literature search","uri":"http://edamontology.org/operation_0305"},{"term":"Named-entity and concept recognition","uri":"http://edamontology.org/operation_3280"},{"term":"Text annotation","uri":"http://edamontology.org/operation_3778"},{"term":"Text mining","uri":"http://edamontology.org/operation_0306"}]}],"name":"PubTator","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"metadata":{"abstract":"Manually curating knowledge from biomedical literature into structured databases is highly expensive and time-consuming, making it difficult to keep pace with the rapid growth of the literature. There is therefore a pressing need to assist biocuration with automated text mining tools. Here, we describe PubTator, a web-based system for assisting biocuration. PubTator is different from the few existing tools by featuring a PubMed-like interface, which many biocurators find familiar, and being equipped with multiple challenge-winning text mining algorithms to ensure the quality of its automatic results. Through a formal evaluation with two external user groups, PubTator was shown to be capable of improving both the efficiency and accuracy of manual curation. PubTator is publicly available at http://www.ncbi.nlm.nih.gov/CBBresearch/Lu/Demo/PubTator/.","authors":[{"name":"Kao H.Y."},{"name":"Lu Z."},{"name":"Wei C.H."}],"citationCount":274,"date":"2013-01-01T00:00:00Z","journal":"Nucleic acids research","title":"PubTator: a web-based text mining tool for assisting biocuration."},"pmid":"23703206"}],"topic":[{"term":"Data mining","uri":"http://edamontology.org/topic_3473"},{"term":"Data submission, annotation and curation","uri":"http://edamontology.org/topic_0219"},{"term":"Natural language processing","uri":"http://edamontology.org/topic_0218"},{"term":"Structure analysis","uri":"http://edamontology.org/topic_0081"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pubtator/web/www.ncbi.nlm.nih.gov","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true,"tutorial":true},"publications":[{"entries":[{"cit_count":277,"citations":[{"count":1,"year":"-1"},{"count":3,"year":"2013"},{"count":3,"year":"2026"},{"count":11,"year":"2014"},{"count":12,"year":"2025"},{"count":13,"year":"2017"},{"count":16,"year":"2015"},{"count":17,"year":"2024"},{"count":18,"year":"2023"},{"count":23,"year":"2020"},{"count":28,"year":"2022"},{"count":29,"year":"2021"},{"count":34,"year":"2016"},{"count":34,"year":"2018"},{"count":35,"year":"2019"}],"doi":"10.1093/nar/gkt441","pmcid":"PMC3692066","pmid":"23703206","ref_count":23,"refs":[{"count":1,"year":"2004"},{"count":1,"year":"2006"},{"count":2,"year":"2009"},{"count":2,"year":"2011"},{"count":2,"year":"2013"},{"count":3,"year":"2008"},{"count":12,"year":"2012"}],"title":"PubTator: a web-based text mining tool for assisting biocuration.","year":2013}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":true,"https":true,"license":false,"operational":404,"redirects":[{"status":301,"url":"https://www.ncbi.nlm.nih.gov:443/CBBresearch/Lu/Demo/PubTator/"}],"ssl":true,"ssl_err":null}},"support":{"email"