{"tool_name":"mb-gan","contents":["biotools","oeb"],"identifiers":["biotools:mb-gan"],"fetched_metadata":{"biotools":{"id":"mb-gan","home":"https://github.com/zhanxw/MB-GAN","summary":"To address the challenge of simulating realistic microbiome data, we designed a novel simulation framework termed MB-GAN, by using a generative adversarial network (GAN) and utilizing methodology advancements from the deep learning community. MB-GAN can automatically learn from a given microbial abundances and compute simulated abundances that are indistinguishable from it. In practice, MB-GAN showed the following advantages. First, MB-GAN avoids explicit statistical modeling assumptions, and it only requires real datasets as inputs. Second, unlike the traditional GANs, MB-GAN is easily applicable and can converge efficiently. MB-GAN is freely available at: https://github.com/zhanxw/MB-GAN","addition_date":"2021-01-06T16:03:42Z","last_update_date":"2026-11-12T14:18:44.087410Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:mb-gan","edit_permission":{"type":"private"},"name":"MB-GAN","operating_system":["Linux"],"owner":"zhanxw","publication":[{"doi":"10.1093/gigascience/giab005","type":["Primary"]},{"doi":"10.1101/863977","type":["Preprint"]}],"topic":[{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mb-gan/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1101/863977","pmcid":null,"pmid":null,"ref_count":0,"refs":[],"title":null,"year":null}]}