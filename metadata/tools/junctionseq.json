{"tool_name":"junctionseq","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"junctionseq","home":"http://bioconductor.org/packages/release/bioc/html/JunctionSeq.html","summary":"A Utility for Detection and Visualization of Differential Exon or Splice-Junction Usage in RNA-Seq data.","addition_date":"2017-01-17T15:02:18Z","last_update_date":"2019-01-13T16:46:31Z","tool_type":["Command-line tool","Library"],"version":["1.4.0"],"collections":["BioConductor"],"biotools_curie":"biotools:junctionseq","credit":[{"email":"JunctionSeq-contact@list.nih.gov","name":"Stephen Hartley","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/html/JunctionSeq.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene prediction","uri":"http://edamontology.org/operation_2454"}]}],"name":"JunctionSeq","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1093/nar/gkw501","metadata":{"abstract":"\u00a9 2016 Published by Oxford University Press on behalf of Nucleic Acids Research 2016. This work is written by (a) US Government employee(s) and is in the public domain in the US.Although RNA-Seq data provide unprecedented isoform-level expression information, detection of alternative isoform regulation (AIR) remains difficult, particularly when working with an incomplete transcript annotation. We introduce JunctionSeq, a new method that builds on the statistical techniques used by the well-established DEXSeq package to detect differential usage of both exonic regions and splice junctions. In particular, JunctionSeq is capable of detecting differential usage of novel splice junctions without the need for an additional isoform assembly step, greatly improving performance when the available transcript annotation is flawed or incomplete. JunctionSeq also provides a powerful and streamlined visualization toolset that allows bioinformaticians to quickly and intuitively interpret their results. We tested our method on publicly available data from several experiments performed on the rat pineal gland and Toxoplasma gondii, successfully detecting known and previously validated AIR genes in 19 out of 19 gene-level hypothesis tests. Due to its ability to query novel splice sites, JunctionSeq is still able to detect these differences even when all alternative isoforms for these genes were not included in the transcript annotation. JunctionSeq thus provides a powerful method for detecting alternative isoform regulation even with low-quality annotations. An implementation of JunctionSeq is available as an R/Bioconductor package.","authors":[{"name":"Hartley S.W."},{"name":"Mullikin J.C."}],"citationCount":62,"date":"2016-09-06T00:00:00Z","journal":"Nucleic Acids Research","title":"Detection and visualization of differential splicing in RNA-Seq data with JunctionSeq"},"pmcid":"PMC5009739","pmid":"27257077","type":["Primary"]}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"RNA-seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"bioschemas":{"name":"JunctionSeq","home":"https://bio.tools/junctionseq","version":"1.4.0","summary":"A Utility for Detection and Visualization of Differential Exon or Splice-Junction Usage in RNA-Seq data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:junctionseq:1.4.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"publications":[{"entries":[{"cit_count":90,"citations":[{"count":1,"year":"2016"},{"count":1,"year":"2026"},{"count":4,"year":"2023"},{"count":6,"year":"2020"},{"count":6,"year":"2024"},{"count":7,"year":"2