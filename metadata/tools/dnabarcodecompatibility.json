{"tool_name":"dnabarcodecompatibility","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"DNABarcodeCompatibility","home":"https://bioconductor.org/packages/DNABarcodeCompatibility","summary":"The package allows one to obtain optimised combinations of DNA barcodes to be used for multiplex sequencing. In each barcode combination, barcodes are pooled with respect to Illumina chemistry constraints. Combinations can be filtered to keep those that are robust against substitution and insertion/deletion errors thereby facilitating the demultiplexing step. In addition, the package provides an optimiser function to further favor the selection of barcode combinations with least heterogeneity in barcode usage.","addition_date":"2019-08-11T13:24:24Z","last_update_date":"2026-08-30T02:11:00.041827Z","tool_type":["Desktop application","Library"],"version":["1.28.0"],"collections":["BioConductor"],"accessibility":"Open access","biotools_curie":"biotools:DNABarcodeCompatibility","cost":"Free of charge","credit":[{"name":"C\u00e9line Tr\u00e9beau","typeEntity":"Person","typeRole":["Maintainer"]},{"name":"Fabienne Wong Jun Tai","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Jacques Boutet de Monvel","typeEntity":"Person","typeRole":["Developer"]},{"name":"Rapha\u00ebl Etournay","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/DNABarcodeCompatibility"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Ancestral reconstruction","uri":"http://edamontology.org/operation_3745"},{"term":"Community profiling","uri":"http://edamontology.org/operation_3200"},{"term":"Sequence trimming","uri":"http://edamontology.org/operation_3192"}]}],"maturity":"Mature","name":"DNABarcodeCompatibility","operating_system":["Linux","Mac","Windows"],"owner":"Ruta","publication":[{"doi":"10.1093/bioinformatics/bty1030"}],"topic":[{"term":"Chemistry","uri":"http://eda