{"tool_name":"nalvera.ai","contents":["biotools"],"identifiers":["biotools:nalvera.ai"],"fetched_metadata":{"biotools":{"id":"nalvera.ai","home":"https://nalvera.ai","license":"Proprietary","summary":"Web application for analysing medical imaging research data in the browser, without local installation or coding. Supports automatic and interactive segmentation of organs, bones and muscles in CT and MRI (including TotalSegmentator, MOOSE, MRSegmentator and MuscleMap models), manual editing of segmentation masks, synthetic CT and brain MRI generation (MAISI-v2), structured research reports from chest and abdominal CT, and quantitative PET/SPECT measurements with longitudinal and group comparisons. Accepts DICOM and NIfTI input. For research use only; not a medical device.","addition_date":"2026-11-06T12:56:26.753269Z","last_update_date":"2026-11-07T10:15:07.044235Z","tool_type":["Web application"],"accessibility":"Open access (with restrictions)","biotools_curie":"biotools:nalvera.ai","cost":"Free of charge (with restrictions)","credit":[{"email":"brent@nalvera.be","name":"Brent van der Heyden","orcidid":"https://orcid.org/0000-0001-8412-6417"},{"name":"Nalvera BV","typeEntity":"Institute","url":"https://nalvera.be"}],"documentation":[{"type":["Citation instructions"],"url":"https://nalvera.ai/documentation"},{"type":["FAQ"],"url":"https://nalvera.ai/faq"},{"type":["Terms of use"],"url":"https://nalvera.ai/terms"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Raw image","uri":"http://edamontology.org/data_3424"}}],"operation":[{"term":"Image annotation","uri":"http://edamontology.org/operation_3553"}],"output":[{"data":{"term":"Image","uri":"http://edamontology.org/data_2968"},"format":[{"term":"CSV","uri":"http://edamontology.org/format_3752"},{"term":"DICOM format","uri":"http://edamontology.org/format_3548"},{"term":"JSON-LD","uri":"http://edamontology.org/format_3749"},{"term":"nii","uri":"http://edamontology.org/format_3549"}]}]}],"maturity":"Emerging","name":"Nalvera.AI","owner":"brent","topic":[{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Medical imaging","uri":"http://edamontology.org/topic_3384"}]}}}