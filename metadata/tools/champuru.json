{"tool_name":"champuru","contents":["biotools"],"identifiers":["biotools:champuru"],"fetched_metadata":{"biotools":{"id":"champuru","home":"https://eeg-ebe.github.io/Champuru/","summary":"Champuru is a web-based tool designed to identify the two DNA sequences present in mixed Sanger chromatograms obtained from sequencing two templates of unequal lengths. It uses sophisticated algorithms and offers an improved graphical interface and command-line version for analyzing DNA mixtures.","addition_date":"2026-11-04T14:48:36.404551Z","last_update_date":"2026-11-04T14:48:36.407932Z","biotools_curie":"biotools:champuru","credit":[{"email":"jean-francois.flot@ulb.be","name":"Jean\u2010Fran\u00e7ois Flot","orcidid":"https://orcid.org/0000-0003-4091-7916","typeEntity":"Person"},{"email":"yann.spori@ulb.be","name":"Yann Sp\u00f6ri","orcidid":"https://orcid.org/0000-0001-7278-2732","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Base-calling","uri":"http://edamontology.org/operation_3185"},{"term":"Deisotoping","uri":"http://edamontology.org/operation_3629"},{"term":"Sequence alignment","uri":"http://edamontology.org/operation_0292"}]}],"name":"Champuru","owner":"pub2tools2024","publication":[{"doi":"10.1111/1755-0998.70110","pmcid":"PMC13111972","pmid":"42037082"}],"topic":[{"term":"Bioinformatics","uri":"http://edamontology.org/topic_0091"},{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Ecology","uri":"http://edamontology.org/topic_0610"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}]}}}