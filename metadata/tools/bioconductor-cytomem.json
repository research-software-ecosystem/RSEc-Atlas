{"tool_name":"bioconductor-cytomem","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-cytomem","home":"https://bioconductor.org/packages/cytoMEM","license":"GPL-3.0","summary":"MEM, Marker Enrichment Modeling, automatically generates and displays quantitative labels for cell populations that have been identified from single-cell data. The input for MEM is a dataset that has pre-clustered or pre-gated populations with cells in rows and features in columns. Labels convey a list of measured features and the features' levels of relative enrichment on each population. MEM can be applied to a wide variety of data types and can compare between MEM labels from flow cytometry, mass cytometry, single cell RNA-seq, and spectral flow cytometry using RMSD.","tool_type":["Command-line tool","Library"],"version":["1.16.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-cytomem","credit":[{"name":"Jonathan Irish","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Kirsten Diggins","typeEntity":"Person","typeRole":["Developer"]},{"name":"Sierra Lima","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/cytoMEM"}],"name":"cytoMEM","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-cytomem:1.2.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-cytomem:1.4.0/cmd/bioconduct