<3.11","mamba","bbmap >=39.01,<40","snakemake-minimal >=7.18.1,<7.26","pygments","networkx","graphviz","pandas >=1.2, <1.5","pyarrow >=8","click >=7","ruamel.yaml >=0.17","cookiecutter","pathlib","numpy =1.21"]},"source_url":"https://github.com/metagenome-atlas/atlas/archive/v19.0.1.tar.gz","test":{"commands":["export LC_ALL=en_US.UTF-8 && export LANG=en_US.UTF-8 && atlas --version","export LC_ALL=en_US.UTF-8 && export LANG=en_US.UTF-8 && atlas init --help","export LC_ALL=en_US.UTF-8 && export LANG=en_US.UTF-8 && atlas run --help"],"imports":["atlas"]},"recipe_maintainers":["silask"]}}}