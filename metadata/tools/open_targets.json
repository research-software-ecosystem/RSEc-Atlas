{"tool_name":"open_targets","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"Open_Targets","home":"https://www.opentargets.org","license":"CC-BY-SA-4.0","summary":"Open Targets is a pre-competitive, public-private partnership that uses human genetics and genomics data to systematically identify and prioritise drug targets. Through large-scale genomic experiments and the development of innovative computational techniques, the partnership aims to help researchers select the best targets for the development of new therapies. \n\nAt the heart of Open Targets is a consortium of complementary partner institutions that bring their respective expertise and capabilities  to collaborative experimental and informatics projects. \n\nBridging the gap between academic research and pharmaceutical drug development, Open Targets has made significant contributions to understanding the relationships between targets and diseases, established leading informatics tools in the Open Targets Platform and Open Targets Genetics, and contributed to global initiatives such as the Cancer Dependency Map.","addition_date":"2019-06-05T10:15:52Z","last_update_date":"2022-01-14T11:59:36.054655Z","accessibility":"Open access","biotools_curie":"biotools:Open_Targets","cost":"Free of charge","credit":[{"email":"helpdesk@opentargets.org","typeEntity":"Project","typeRole":["Primary contact"],"url":"https://opentargets.org"}],"documentation":[{"type":["General","Quick start guide"],"url":"https://www.ebi.ac.uk/training/online/courses/open-targets-quick-tour/"}],"edit_permission":{"type":"private"},"maturity":"Mature","name":"Open Targets","owner":"opentargets","topic":[{"term":"Drug discovery","uri":"http://edamontology.org/topic_3336"},{"term":"Genetics","uri":"http://edamontology.org/topic_3053"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Omics","uri":"http://edamontology.org/topic_3391"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics