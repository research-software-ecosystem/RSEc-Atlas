{"tool_name":"cellenics","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"cellenics","home":"https://scp.biomage.net","summary":"Cellenics\u00ae is an open source, cloud-based analytics tool for single cell RNA sequencing data. It allows you to explore and analyze single cell datasets without the need to develop bioinformatics skills. Cellenics\u00ae has a user-friendly interface with a clear workflow. Offers a variety of pre-loaded publication-ready plots.\n\nCellenics\u00ae software was developed by \u00a9 2020-2022 President and Fellows of Harvard College.\nBiomage is an open source software company that provided services to Harvard Medical School for the design and development of Cellenics\u00ae.","addition_date":"2022-07-26T15:35:21.486290Z","last_update_date":"2022-08-16T14:49:04.554438Z","tool_type":["Bioinformatics portal","Web application"],"accessibility":"Open access (with restrictions)","biotools_curie":"biotools:cellenics","cost":"Free of charge (with restrictions)","credit":[{"email":"hello@biomage.net","name":"Adam Kurkiewicz"},{"email":"hello@biomage.net","name":"Iva Babukova"},{"email":"vicky@biomage.net","name":"Vicky Morrison"},{"name":"Developed by \u00a9 2020-2022 President and Fellows of Harvard College."}],"documentation":[{"type":["API documentation"],"url":"https://github.com/hms-dbmi-cellenics/developer-docs"},{"type":["Release notes"],"url":"https://github.com/hms-dbmi-cellenics/releases"},{"type":["User manual"],"url":"https://www.biomage.net/user-guide"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"}]},{"operation":[{"term":"Dimensionality reduction","uri":"http://edamontology.org/operation_3935"}]},{"operation":[{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"Cellenics","operating_system":["Linux","Mac","Windows"],"owner":"biomage.team","topic":[{"term":"Bioinformatics","uri":"http://edamontology.or