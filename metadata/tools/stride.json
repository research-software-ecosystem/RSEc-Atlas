{"tool_name":"stride","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"stride","identifiers":["biotools:stride","doi:10.1093/nar/gkh429"],"license":"GPL-3.0","summary":"The stride assembler integrates string and de bruijn graph by decomposing reads within error-prone regions, while extending paire-end read into long reads for assembly through repetitive regions.","home_url":"https://github.com/ythuang0522/StriDe","keywords":["Databases, Protein","Hydrogen Bonding","Internet","Molecular Structure","Protein Structure, Secondary","Proteins","Structural biology","Protein secondary structure","Protein structure analysis","Mapping"],"manually_check":true,"total_pulls":0},"biotools":{"id":"stride","home":"http://webclu.bio.wzw.tum.de/stride/","summary":"Takes a PDB structure as input and reports back either secondary structure assignments, a Ramachandran plot or a contact map.","addition_date":"2017-03-24T10:46:35Z","last_update_date":"2024-11-24T20:21:39.754449Z","tool_type":["Web application"],"biotools_curie":"biotools:stride","credit":[{"email":"bioinformatik@wzw.tum.de","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://webclu.bio.wzw.tum.de/stride/stride.doc"}],"edit_permission":{"authors":["shruti"],"type":"group"},"function":[{"operation":[{"term":"Protein geometry calculation","uri":"http://edamontology.org/operation_0249"},{"term":"Protein secondary structure assignment","uri":"http://edamontology.org/operation_0319"},{"term":"Protein structure assignment","uri":"http://edamontology.org/operation_0320"}]}],"name":"STRIDE","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"doi":"10.1093/nar/gkh429","metadata":{"abstract":"STRIDE is a software tool for secondary structure assignment from atomic resolution protein structures. It implements a knowledge-based algorithm that makes combined use of hydrogen bond energy and statistically derived backbone torsional angle information and is optimized to return resulting assignments in maximal agreement with crystallographers' designations. The STRIDE web server provides access to this tool and allows visualization of the secondary structure, as well as contact and Ramachandran maps for any file uploaded by the user with atomic coordinates in the Protein Data Bank (PDB) format. A searchable database of STRIDE assignments for the latest PDB release is also provided. The STRIDE server is accessible from http://webclu.bio.wzw.tum.de/stride/. \u00a9 Oxford University Press 2004; all rights reserved.","authors":[{"name":"Frishman D."},{"name":"Heinig M."}],"citationCount":792,"date":"2004-07-01T00:00:00Z","journal":"Nucleic Acids Research","title":"STRIDE: A web server for secondary structure assignment from known atomic coordinates of proteins"},"pmcid":"PMC441567","pmid":"15215436"}],"topic":[{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Protein secondary structure","uri":"http://edamontology.org/topic_3542"},{"term":"Protein structure analysis","uri":"http://edamontology.org/topic_2814"},{"term":"Structural biology","uri":"http://edamontology.org/topic_1317"}],"validated":1},"bioschemas":{"name":"STRIDE","home":"https://bio.tools/stride","summary":"Takes a PDB structure as input and reports back either secondary structure assignments, a Ramachandran plot or a contact map.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:stride/web/webclu.bio.wzw.tum.de","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":473,"citations":[{"count":1,"year":"2004"},{"count":2,"year":"2006"},{"count":3,"year":"2005"},{"count":3,"year":"2008"},{"count":4,"year":"2007"},{"count":7,"year":"2009"},{"count":10,"ye