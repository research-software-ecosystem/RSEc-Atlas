{"tool_name":"cliquems","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"CliqueMS","home":"https://bioconductor.org/packages/cliqueMS","license":"GPL-2.0-or-later","summary":"Annotates data from liquid chromatography coupled to mass spectrometry (LC/MS) metabolomics experiments. Based on a network algorithm (O.Senan, A. Aguilar- Mogas, M. Navarro, O. Yanes, R.Guimer\u00e0 and M. Sales-Pardo, Bioinformatics, 35(20), 2019), 'CliqueMS' builds a weighted similarity network where nodes are features and edges are weighted according to the similarity of this features. Then it searches for the most plausible division of the similarity network into cliques (fully connected components). Finally it annotates metabolites within each clique, obtaining for each annotated metabolite the neutral mass and their features, corresponding to isotopes, ionization adducts and fragmentation adducts of that metabolite.","addition_date":"2019-07-04T14:05:39Z","last_update_date":"2026-08-30T02:07:06.299406Z","tool_type":["Library"],"version":["1.26.0"],"collections":["BioConductor"],"accessibility":"Open access","biotools_curie":"biotools:CliqueMS","cost":"Free of charge","credit":[{"name":"Antoni Aguilar-Mogas","typeEntity":"Person","typeRole":["Developer"]},{"name":"Jordi Capellades","typeEntity":"Person","typeRole":["Developer"]},{"name":"Marta Sales-Pardo","typeEntity":"Person","typeRole":["Developer"]},{"name":"Miriam Navarro","typeEntity":"Person","typeRole":["Developer"]},{"name":"Oriol Senan Campos","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Oscar Yanes","typeEntity":"Person","typeRole":["Developer"]},{"name":"Roger Guimera","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/cliqueMS"}],"edit_permission":{"authors":["recetox-specdatri"],"type":"group"},"function":[{"operation":[{"term":"Natural product identification","uri":"http://edamontology.org