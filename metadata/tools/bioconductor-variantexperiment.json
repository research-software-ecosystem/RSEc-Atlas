{"tool_name":"bioconductor-variantexperiment","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-variantexperiment","identifiers":["doi:10.18129/b9.bioc.variantexperiment"],"license":"GPL-3","summary":"A RangedSummarizedExperiment Container for VCF/GDS Data with GDS Backend","home_url":"https://bioconductor.org/packages/3.10/bioc/html/VariantExperiment.html","keywords":[],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-variantexperiment","home":"https://bioconductor.org/packages/VariantExperiment","license":"GPL-3.0","summary":"VariantExperiment is a Bioconductor package for saving data in VCF/GDS format into RangedSummarizedExperiment object. The high-throughput genetic/genomic data are saved in GDSArray objects. The annotation data for features/samples are saved in DelayedDataFrame format with mono-dimensional GDSArray in each column. The on-disk representation of both assay data and annotation data achieves on-disk reading and processing and saves memory space significantly. The interface of RangedSummarizedExperiment data format enables easy and common manipulations for high-throughput genetic/genomic data with common SummarizedExperiment metaphor in R and Bioconductor.","tool_type":["Command-line tool","Library"],"version":["1.26.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-variantexperiment","credit":[{"name":"Herv\u00e9 Pag\u00e8s","typeEntity":"Person","typeRole":["Developer"]},{"name":"Martin Morgan","typeEntity":"Person","typeRole":["Developer"]},{"name":"Qian Liu","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/VariantExperiment"}],"name":"VariantExperiment","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.18129/B9.bioc.VariantExperiment"}]},"bioschemas":{"name":"VariantExperiment","home":"http