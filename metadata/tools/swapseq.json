{"tool_name":"swapseq","contents":["biotools","oeb"],"identifiers":["biotools:swapseq"],"fetched_metadata":{"biotools":{"id":"swapseq","home":"https://bymankirat.github.io/swapseq/","license":"GPL-3.0","summary":"Detects swapped tubes, mislabelled samples and sample-sheet shifts in longitudinal microbiome studies (16S and shotgun) from each subject's microbial fingerprint. It self-calibrates by planting errors in the user's own labels, reports its own detection power, and runs entirely in the web browser with no data uploaded. An R package (swapseqr) runs the same engine on phyloseq objects or count matrices.","addition_date":"2026-11-05T17:02:17.930691Z","last_update_date":"2026-11-05T21:54:34.821051Z","tool_type":["Library","Web application"],"version":["1.0.1"],"accessibility":"Open access","biotools_curie":"biotools:swapseq","cost":"Free of charge","credit":[{"email":"msinghsandal@gmail.com","name":"Mankirat Singh","orcidid":"https://orcid.org/0009-0005-3375-2123","typeEntity":"Person","typeRole":["Developer","Primary contact"]}],"documentation":[{"note":"R package usage","type":["User manual"],"url":"https://github.com/bymankirat/swapseqr#readme"},{"type":["General"],"url":"https://bymankirat.github.io/swapseq/validation.html"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Count matrix","uri":"http://edamontology.org/data_3917"},"format":[{"term":"BIOM format","uri":"http://edamontology.org/format_3746"},{"term":"DSV","uri":"http://edamontology.org/format_3751"}]}],"note":"Detects swapped, mislabelled and sheet-shifted samples in longitudinal microbiome studies by checking each sample against its subject's microbial fingerprint.","operation":[{"term":"Validation","uri":"http://edamontology.org/operation_2428"}],"output":[{"data":{"term":"Quality control report","uri":"http://edamontology.org/data_3914"},"format":[{"term":"DSV","uri":"http://edamontology.org/format_3751"}]}]}],"maturity":"Emerging","name":"SwapSeq","operating_syste