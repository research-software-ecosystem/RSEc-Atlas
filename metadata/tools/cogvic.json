{"tool_name":"cogvic","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"cogvic","home":"http://www.cogvic.vip/","summary":"COGVIC(Catalogue Of Germline Variants In Cancer). A comprehensive database of germline pathogenic variants in East Asian pan-cancer patients.","addition_date":"2022-06-06T12:03:30.415922Z","last_update_date":"2022-06-06T12:03:30.418454Z","tool_type":["Database portal","Web application"],"accessibility":"Open access","biotools_curie":"biotools:cogvic","cost":"Free of charge","credit":[{"email":"doc_cai@163.com","name":"Kaican Cai","orcidid":"https://orcid.org/0000-0003-4664-6694","typeEntity":"Person"},{"email":"grant.morahan@uwa.edu.au","name":"Grant Morahan","typeEntity":"Person"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Data retrieval","uri":"http://edamontology.org/operation_2422"},{"term":"Database search","uri":"http://edamontology.org/operation_2421"},{"term":"Deposition","uri":"http://edamontology.org/operation_3431"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"},{"term":"Variant classification","uri":"http://edamontology.org/operation_3225"}]}],"name":"COGVIC","operating_system":["Linux","Mac","Windows"],"owner":"Chan019","publication":[{"doi":"10.1093/DATABASE/BAAB075","metadata":{"abstract":"\u00a9 2021 The Author(s).Pathogenic germline variants in cancer-associated genes are risk factors for cancer predisposition. However, systematic mining and summarizing of cancer pathogenic or likely pathogenic variants has not been performed for people of East Asian descent. This study aimed to investigate publicly available data to identify germline variants in East Asian cancer cohorts and compare them to variants in Caucasian cancer cohorts. Based on the data we retrieved, we built a comprehensive database, named COGVIC (Catalog of Germline Variants in Cancer). A total of 233 variants in the East Asian population were identified. The majority (87%) of genes with cancer-associated variants were not shared between the East Asian and Caucasian cohorts. This included pathogenic variants in BRCA2. Our study summarized the prevalence of germline variants in East Asian cancer cohorts and provides an easy-to-use online tool to explore germline mutations related to cancer susceptibility.","authors":[{"name":"Cai K."},{"name":"Chen A.M."},{"name":"Chen Z."},{"name":"Diao D."},{"name":"Dong X."},{"name":"Feng S."},{"name":"Huang K."},{"name":"Li R."},{"name":"Liu X."},{"name":"Liu Z."},{"name":"Lu D."},{"name":"Morahan G."},{"name":"Ren P."},{"name":"Shi X."},{"name":"Zhai J."},{"name":"Zheng Z."}],"date":"2021-01-01T00:00:00Z","journal":"Database","title":"The first comprehensive database of germline pathogenic variants in East Asian cancer patients"},"pmcid":"PMC8730286","pmid":"34964846"}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Exome sequencing","uri":"http://edamontology.org/topic_3676"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"Oncology","uri":"http://edamontology.org/topic_2640"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"bioschemas":{"name":"COGVIC","home":"https://bio.tools/cogvic","summary":"COGVIC(Catalogue Of Germline Variants In Cancer). A comprehensive database of germline pathogenic variants in East Asian pan-cancer patients.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:cogvic/db/www.cogvic.vip","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":2,"citations":[{"count":2,"year":"2026"}],"doi":"10.1093/database/baab075","pmcid":"PMC8730286","pmid":"34964846","ref_count":19,"refs":[{"count":1,"year":"2006"},{"count":1,"year":"2009"},{"count":1,"year":"2015"},{"count":1,"year":"2016"},{"