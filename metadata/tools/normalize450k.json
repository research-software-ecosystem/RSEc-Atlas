{"tool_name":"normalize450k","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"normalize450k","home":"https://bioconductor.org/packages/normalize450K","license":"BSD-2-Clause","summary":"Precise measurements are important for epigenome-wide studies investigating DNA methylation in whole blood samples, where effect sizes are expected to be small in magnitude. The 450K platform is often affected by batch effects and proper preprocessing is recommended. This package provides functions to read and normalize 450K '.idat' files. The normalization corrects for dye bias and biases related to signal intensity and methylation of probes using local regression. No adjustment for probe type bias is performed to avoid the trade-off of precision for accuracy of beta-values.","addition_date":"2017-01-17T15:02:58Z","last_update_date":"2019-01-11T00:28:43Z","tool_type":["Command-line tool","Library"],"version":["1.40.0"],"collections":["BioConductor"],"biotools_curie":"biotools:normalize450k","credit":[{"name":"Jonathan Alexander Heiss"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/normalize450K"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Regression analysis","uri":"http://edamontology.org/operation_3659"},{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"normalize450K","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[],"topic":[{"term":"Microarray experiment","uri":"http://edamontology.org/topic_3518"},{"term":"Probes and primers","uri":"http://edamontology.org/topic_0632"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:normalize450k:1.2.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"