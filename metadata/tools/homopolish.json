{"tool_name":"homopolish","contents":["biocontainers","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"homopolish","version":"0.4.2","home":"https://github.com/ythuang0522/homopolish","license":"GPL-3.0-or-later","summary":"High-quality Nanopore-only genome polisher.","identifiers":["doi:10.1186/s13059-021-02282-6","biotools:homopolish"],"build":{"entry_points":["homopolish = homopolish.homopolish:main"],"noarch":"python","number":0,"run_exports":[null],"script":"-m pip install . --no-deps --no-build-isolation --no-cache-dir --use-pep517 -vvv"},"requirements":{"host":["python >=3.7,<3.13","pip","setuptools"],"run":["python >=3.7,<3.13","scikit-learn","mash","minimap2","python-wget","feather-format","numpy <2","pandas >=0.23.4","biopython >=1.76","joblib >=0.15.1","requests >=2.24.0","more-itertools >=8.4.0","pyarrow >=0.15.1","pycurl >=7.43.0.6","fastani","pysam >=0.15.3"]},"source_url":"https://github.com/SeaneryChang/homopolish/releases/download/v0.4.2/homopolish_0.4.2.tar.gz","test":{"imports":["homopolish"]}},"biocontainers":{"name":"homopolish","identifiers":["doi:10.1101/2020.09.19.304949"],"license":"GPL","summary":"Homopolish is a polish tools","home_url":"https://github.com/ythuang0522/homopolish","keywords":[],"manually_check":true,"total_pulls":38},"biotools":{"id":"homopolish","home":"https://github.com/ythuang0522/homopolish","license":"GPL-3.0","summary":"Homopolish is a method for the removal of systematic errors in nanopore sequencing by homologous polishing.","addition_date":"2021-09-27T06:00:32.428790Z","last_update_date":"2021-09-27T06:00:32.431354Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:homopolish","credit":[{"email":"ythuang@cs.ccu.edu.tw","name":"Yao-Ting Huang","orcidid":"https://orcid.org/0000-0001-9253-2394","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Data retrieval","uri":"http://edamontology.org/operati