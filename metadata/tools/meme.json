eme-suite.org/meme/"},{"status":302,"url":"https://meme-suite.org/"}],"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/meme","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://meme-suite.org/meme/tools/meme"},{"status":302,"url":"https://meme-suite.org/tools/meme"}],"ssl":true,"ssl_err":null}}}]},"debian":{"package":"meme","distribution":"prospective","release":"vcs","component":"non-free","version":"5.5.5","source":"meme","homepage":"https://meme-suite.org/","license":"non-free","blend":"debian-med","registries":[{"entry":"OMICS_08103","name":"OMICtools"},{"entry":"SCR_001783","name":"SciCrunch"},{"entry":"MEME","name":"bio.tools"},{"entry":"meme","name":"conda:bioconda"}],"bib":[{"key":"doi","value":"10.1093/nar/gkl198"},{"key":"doi","package":"glam2","value":"10.1371/journal.pcbi.1000071"}],"descr":[{"package":"meme","description":"search for common motifs in DNA or protein sequences","long_description":" MEME (Multiple EM for Motif Elicitation) is a tool for discovering\n motifs in a group of related DNA or protein sequences.  A motif is a\n sequence pattern that occurs repeatedly in a group of related protein or\n DNA sequences. MEME represents motifs as position-dependent\n letter-probability matrices which describe the probability of each\n possible letter at each position in the pattern. Individual MEME motifs\n do not contain gaps. Patterns with variable-length gaps are split by\n MEME into two or more separate motifs.\n .\n MEME takes as input a group of DNA or protein sequences (the training set)\n and outputs as many motifs as requested. MEME uses statistical modeling\n techniques to automatically choose the best width, number of occurrences,\n and description for each motif.","release":"vcs","license":"non-free","blend":"debian-med"}]}}}