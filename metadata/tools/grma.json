{"tool_name":"grma","contents":["biotools"],"identifiers":["biotools:grma"],"fetched_metadata":{"biotools":{"id":"grma","home":"https://github.com/JonJala/grma","summary":"GRMA is a novel method for genetic association studies that improves upon standard GWAS by allowing analysis in ancestrally diverse populations. It reduces bias by matching individuals to controls based on pairwise relatedness.","addition_date":"2026-11-04T17:40:14.717497Z","last_update_date":"2026-11-04T17:40:14.721122Z","biotools_curie":"biotools:grma","credit":[{"name":"Patrick Turley","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"Genomic-Relatedness-Matched Association (GRMA)","owner":"pub2tools2024","publication":[{"doi":"10.64898/2026.05.14.26353140"}],"topic":[{"term":"Biobank","uri":"http://edamontology.org/topic_3337"},{"term":"GWAS study","uri":"http://edamontology.org/topic_3517"},{"term":"Population genetics","uri":"http://edamontology.org/topic_3056"}]}}}