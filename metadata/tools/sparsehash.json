{"tool_name":"sparsehash","contents":["biocontainers","oeb"],"fetched_metadata":{"biocontainers":{"name":"sparsehash","identifiers":[],"license":"Not available","summary":"An extremely memory-efficient hash_map implementation. 2 bits/entry overhead! The SparseHash library contains several hash-map implementations, including implementations that optimize for space or speed.  These hashtable implementations are similar in API to SGI's hash_map class and the tr1 unordered_map class, but with different performance characteristics. It's easy to replace hash_map or unordered_map by sparse_hash_map or dense_hash_map in C++ code.  They also contain code to serialize and unserialize from disk.","home_url":"None","keywords":[],"manually_check":true,"total_pulls":0},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:sparsehash:2.0.2/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"publications":[],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":true,"resolve_time":"PT5373620S"}}},{"@id":"https://openebench.bsc.es/monitor/metrics/sparsehash","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"publications":[],"readme":true,"summary":{"description