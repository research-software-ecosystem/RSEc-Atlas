{"tool_name":"genview","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"genview","home":"https://github.com/EbmeyerSt/GEnView","license":"GPL-3.0","summary":"A gene-centric, phylogeny-based comparative genomics pipeline for bacterial genomes and plasmids.","addition_date":"2022-05-27T15:45:18.227667Z","last_update_date":"2022-05-27T15:45:18.230050Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:genview","cost":"Free of charge","credit":[{"name":"Erik Kristiansson"},{"name":"Roelof Dirk Coertze"},{"name":"Stefan Ebmeyer"},{"name":"D G Joakim Larsson","orcidid":"https://orcid.org/0000-0002-5496-0328"},{"name":"Fanny Berglund","orcidid":"https://orcid.org/0000-0002-8528-8095"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Deposition","uri":"http://edamontology.org/operation_3431"},{"term":"Genome assembly","uri":"http://edamontology.org/operation_0525"}]}],"name":"GEnView","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1093/BIOINFORMATICS/BTAB855","metadata":{"abstract":"\u00a9 2021 The Author(s) 2021. Published by Oxford University Press.Summary: Comparing genomic loci of a given bacterial gene across strains and species can provide insights into their evolution, including information on e.g. acquired mobility, the degree of conservation between different taxa or indications of horizontal gene transfer events. While thousands of bacterial genomes are available to date, there is no software that facilitates comparisons of individual gene loci for a large number of genomes. GEnView (Genetic Environment View) is a Python-based pipeline for the comparative analysis of gene-loci in a large number of bacterial genomes, providing users with automated, taxon-selective access to the >800.000 genomes and plasmids currently available in the NCBI Assembly and RefSeq databases, and is able to process local genomes that are not deposited at NCBI, enabling searches for genomic sequences and to analyze their genetic environments through the interactive visualization and extensive metadata files created by GEnView.","authors":[{"name":"Berglund F."},{"name":"Coertze R.D."},{"name":"Ebmeyer S."},{"name":"Kristiansson E."},{"name":"Larsson D.G.J."}],"date":"2022-03-15T00:00:00Z","journal":"Bioinformatics","title":"GEnView: A gene-centric, phylogeny-based comparative genomics pipeline for bacterial genomes and plasmids"},"pmid":"34951622"}],"topic":[{"term":"Comparative genomics","uri":"http://edamontology.org/topic_0797"},{"term":"Evolutionary biology","uri":"http://edamontology.org/topic_3299"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}],"validated":1},"bioschemas":{"name":"GEnView","home":"https://bio.tools/genview","license":"GPL-3.0","summary":"A gene-centric, phylogeny-based comparative genomics pipeline for bacterial genomes and plasmids.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:genview/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":10,"citations":[{"count":1,"year":"2024"},{"count":2,"year":"2022"},{"count":2,"year":"2023"},{"count":2,"year":"2026"},{"count":3,"year":"2025"}],"doi":"10.1093/bioinformatics/btab855","pmcid":"PMC8896611","pmid":"34951622","ref_count":0,"refs":[],"title":"GEnView: a gene-centric, phylogeny-based comparative genomics pipeline for bacterial genomes and plasmids.","year"