{"tool_name":"scan.upc","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-scan.upc","version":"2.52.0","home":"https://bioconductor.org/packages/3.22/bioc/html/SCAN.UPC.html","license":"MIT","summary":"Single-channel array normalization (SCAN) and Universal exPression Codes (UPC)","identifiers":["biotools:scan.upc"],"description":"SCAN is a microarray normalization method to facilitate personalized-medicine workflows. Rather than processing microarray samples as groups, which can introduce biases and present logistical challenges, SCAN normalizes each sample individually by modeling and removing probe- and array-specific background noise using only data from within each array. SCAN can be applied to one-channel (e.g., Affymetrix) or two-channel (e.g., Agilent) microarrays. The Universal exPression Codes (UPC) method is an extension of SCAN that estimates whether a given gene/transcript is active above background levels in a given sample. The UPC method can be applied to one-channel or two-channel microarrays as well as to RNA-Seq read counts. Because UPC values are represented on the same scale and have an identical interpretation for each platform, they can be used for cross-platform data integration.","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-affy >=1.88.0,<1.89.0","bioconductor-affyio >=1.80.0,<1.81.0","bioconductor-biobase >=2.70.0,<2.71.0","bioconductor-biostrings >=2.78.0,<2.79.0","bioconductor-geoquery >=2.78.0,<2.79.0","bioconductor-iranges >=2.44.0,<2.45.0","bioconductor-oligo >=1.74.0,<1.75.0","bioconductor-sva >=3.58.0,<3.59.0","r-base","r-foreach","r-mass"],"run":["bioconductor-affy >=1.88.0,<1.89.0","bioconductor-affyio >=1.80.0,<1.81.0","bioconductor-biobase >=2.70.0,<2.71.0","bioconductor-biostrings >=2.78.0,<2.79.0","bioconductor-geoquery >=2.78.0,<2.79.0","bioconductor-iranges >=2.44.0,<2.45.0","bioconductor-oligo >=1.74.0,<1.75.0","bioconductor-sva >=3.58.0,<3.59.0","r-base","r-foreach","r-mass"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/SCAN.UPC_2.52.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SCAN.UPC/SCAN.UPC_2.52.0.tar.gz","https://bioarchive.galaxyproject.org/SCAN.UPC_2.52.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-scan.upc/bioconductor-scan.upc_2.52.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('SCAN.UPC')\""]},"parent_recipe":{"name":"bioconductor-scan.upc","path":"recipes/bioconductor-scan.upc","version":"2.24.0"}},"biotools":{"id":"scan.upc","home":"https://bioconductor.org/packages/SCAN.UPC","license":"MIT","summary":"SCAN is a microarray normalization method to facilitate personalized-medicine workflows. Rather than processing microarray samples as groups, which can introduce biases and present logistical challenges, SCAN normalizes each sample individually by modeling and removing probe- and array-specific background noise using only data from within each array. SCAN can be applied to one-channel (e.g., Affymetrix) or two-channel (e.g., Agilent) microarrays. The Universal exPression Codes (UPC) method is an extension of SCAN that estimates whether a given gene/transcript is active above background levels in a given sample. The UPC method can be applied to one-channel or two-channel microarrays as well as to RNA-Seq read counts. Because UPC values are represented on the same scale and have an identical interpretation for each platform, they can be used for cross-platform data integration.","addition_date":"2017-01-17T14:56:57Z","last_update_date":"2019-01-10T04:11:57Z","tool_type":["Command-line tool","Library"],"version":["2.54.0"],"collections":["BioConductor"],"biotools_curie":"biotools:scan.upc","credit":[{"name":"Stephen R. Piccolo and Andrea H. Bild and W. Evan Johnson"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/SCAN.UPC"}