{"tool_name":"indigomine","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"IndigoMine","home":"http://www.cbrc.kaust.edu.sa/indigo","license":"LGPL-2.1","summary":"INDIGO enables the integration of annotations for the exploration and analysis of newly sequenced microbial genomes.","addition_date":"2019-11-27T10:46:43Z","last_update_date":"2024-11-25T14:03:22.544748Z","tool_type":["Database portal","Web application","Web service"],"version":["1.1"],"biotools_curie":"biotools:IndigoMine","cost":"Free of charge","documentation":[{"type":["API documentation"],"url":"http://intermine.readthedocs.org/en/latest/web-services/"},{"type":["User manual"],"url":"https://flymine.readthedocs.io/en/latest/"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Ontology data","uri":"http://edamontology.org/data_2353"}},{"data":{"term":"Sequence features","uri":"http://edamontology.org/data_1255"}}],"operation":[{"term":"Data retrieval","uri":"http://edamontology.org/operation_2422"},{"term":"Gene-set enrichment analysis","uri":"http://edamontology.org/operation_2436"},{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}],"output":[{"data":{"term":"Over-representation data","uri":"http://edamontology.org/data_3753"}},{"data":{"term":"Query script","uri":"http://edamontology.org/data_3786"}},{"data":{"term":"Sequence features","uri":"http://edamontology.org/data_1255"}}]}],"maturity":"Mature","name":"IndigoMine","operating_system":["Linux","Mac"],"owner":"InterMine","publication":[{"doi":"10.1093/bioinformatics/bts577","metadata":{"abstract":"InterMine is an open-source data warehouse system that facilitates the building of databases with complex data integration requirements and a need for a fast customizable query facility. Using InterMine, large biological databases can be created from a range of heterogeneous data sources, and th