{"tool_name":"rmsi","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"rmsi","home":"https://github.com/prafols/rMSI","summary":"MS imaging data handling and visualization.","addition_date":"2018-06-06T19:24:24Z","last_update_date":"2024-11-24T14:42:39.666749Z","tool_type":["Desktop application"],"collections":["Proteomics"],"biotools_curie":"biotools:rmsi","credit":[{"email":"jesus.brezmes@urv.cat","name":"Jes\u00fas Brezmes","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/prafols/rMSI"}],"edit_permission":{"authors":["jannikwitte","proteomics.bio.tools"],"type":"group"},"function":[{"operation":[{"term":"Image analysis","uri":"http://edamontology.org/operation_3443"},{"term":"Mass spectrum visualisation","uri":"http://edamontology.org/operation_3694"}]}],"name":"rMSI","operating_system":["Linux","Mac","Windows"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1093/bioinformatics/btx182","metadata":{"abstract":"Summary: R platform provides some packages that are useful to process mass spectrometry imaging (MSI) data; however, none of them provide an easy to use graphical user interface (GUI). Here, we introduce rMSI, an R package for MSI data analysis focused on providing an efficient way to manage MSI data together with a GUI integrated in R environment. MS data is loaded in rMSI custom format optimized to minimize the memory footprint yet maintaining a fast spectra access. The rMSI GUI is designed for simple and effective data exploration and visualization. Moreover, rMSI is designed to be integrated in the R environment through a library of functions that can be used to share MS data across others R packages. The release of rMSI for R environment establishes a novel and flexible platform for MSI data analysis, completely free and open-source.","authors":[{"name":"Brezmes J."},{"name":"Correig X."},{"name":"Del Castillo E."},{"name":"Rafols P."},{"name":"Ramirez N."},{"name":"Torres S."},{"name":"Yanes O."}],"citationCount":28,"date":"2017-08-01T00:00:00Z","journal":"Bioinformatics","title":"RMSI: An R package for MS imaging data handling and visualization"},"pmid":"28369250"}],"topic":[{"term":"Biological imaging","uri":"http://edamontology.org/topic_3383"},{"term":"Medical imaging","uri":"http://edamontology.org/topic_3384"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"}],"validated":1},"bioschemas":{"name":"rMSI","home":"https://bio.tools/rmsi","summary":"MS imaging data handling and visualization.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:rmsi/app/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":18,"citations":[{"count":1,"year":"2018"},{"count":1,"year":"2021"},{"count":1,"year":"2024"},{"count":2,"year":"2022"},{"count":2,"year":"2025"},{"count":3,"year":"2019"},{"count":4,"year":"2020"},{"count":4,"year":"2023"}],"doi":"10.1093/bioinformatics/btx182","pmid":"28369250","ref_count":0,"refs":[],"title":"rMSI: an R package for MS imaging data handling and visualization.","year":2017}]}],"readme":false,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"email":true,"issue_tracking":{"public_tracker":null,"resolve_time":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/rmsi","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","distribution":{"b