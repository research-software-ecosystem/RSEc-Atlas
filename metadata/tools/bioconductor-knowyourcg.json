{"tool_name":"bioconductor-knowyourcg","contents":["bioconda","bioconductor","bioschemas","biotools","oeb"],"identifiers":["biotools:bioconductor-knowyourcg","bioconductor:knowyourcg","bioconda:bioconductor-knowyourcg"],"fetched_metadata":{"biotools":{"id":"bioconductor-knowyourcg","home":"https://bioconductor.org/packages/knowYourCG","license":"AGPL-3.0","summary":"KnowYourCG (KYCG) is a supervised learning framework designed for the functional analysis of DNA methylation data. Unlike existing tools that focus on genes or genomic intervals, KnowYourCG directly targets CpG dinucleotides, featuring automated supervised screenings of diverse biological and technical influences, including sequence motifs, transcription factor binding, histone modifications, replication timing, cell-type-specific methylation, and trait-epigenome associations. KnowYourCG addresses the challenges of data sparsity in various methylation datasets, including low-pass Nanopore sequencing, single-cell DNA methylomes, 5-hydroxymethylation profiles, spatial DNA methylation maps, and array-based datasets for epigenome-wide association studies and epigenetic clocks (<doi:10.1126/sciadv.adw3027>). KnowYourCG v2, a command-line implementation in C, is available at <https://github.com/zhou-lab/kycg>.","addition_date":"2026-09-01T07:22:49.788390Z","last_update_date":"2026-10-18T01:28:16.159409Z","tool_type":["Command-line tool","Library"],"version":["1.8.4"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-knowyourcg","credit":[{"name":"David Goldberg","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Hongxiang Fu","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Wanding Zhou","typeEntity":"Person","typeRole":["Contributor","Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/knowYourCG"}],"edit_permission":{"type":"private"},"name":"knowYourCG","operating_system":["Linux","Mac","Windows"],"owner":"gh2bioto