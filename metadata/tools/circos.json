mand-line tool"],"collections":["galaxyPasteur"],"accessibility":"Open access","biotools_curie":"biotools:circos","credit":[{"email":"martink@bcgsc.ca","name":"Martin Krzywinski","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://circos.ca/support/contact/mkweb.bcgsc.ca"}],"documentation":[{"type":["General"],"url":"http://circos.ca/documentation/"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Data","uri":"http://edamontology.org/data_0006"},"format":[{"term":"TSV","uri":"http://edamontology.org/format_3475"}]}],"operation":[{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}],"output":[{"data":{"term":"Data","uri":"http://edamontology.org/data_0006"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]},{"data":{"term":"Image","uri":"http://edamontology.org/data_2968"},"format":[{"term":"Image format","uri":"http://edamontology.org/format_3547"}]}]}],"maturity":"Mature","name":"Circos","operating_system":["Linux","Windows"],"owner":"seqwiki_import","publication":[{"doi":"10.1101/gr.092759.109","metadata":{"abstract":"We created a visualization tool called Circos to facilitate the identification and analysis of similarities and differences arising from comparisons of genomes. Our tool is effective in displaying variation in genome structure and, generally, any other kind of positional relationships between genomic intervals. Such data are routinely produced by sequence alignments, hybridization arrays, genome mapping, and genotyping studies. Circos uses a circular ideogram layout to facilitate the display of relationships between pairs of positions by the use of ribbons, which encode the position, size, and orientation of related genomic elements. Circos is capable of displaying data as scatter, line, and histogram plots, heat maps, tiles, connectors, and text. Bitmap or vector images can be created from GFF-style data inputs and hierarchical configuration files, which can be easily generated by automated tools, making Circos suitable for rapid deployment in data analysis and reporting pipelines. \u00a9 2009 by Cold Spring Harbor Laboratory Press.","authors":[{"name":"Birol I."},{"name":"Connors J."},{"name":"Gascoyne R."},{"name":"Horsman D."},{"name":"Jones S.J."},{"name":"Krzywinski M."},{"name":"Marra M.A."},{"name":"Schein J."}],"citationCount":7810,"date":"2009-09-01T00:00:00Z","journal":"Genome Research","title":"Circos: An information aesthetic for comparative genomics"},"pmcid":"PMC2752132","pmid":"19541911","type":["Primary"]},{"doi":"10.7490/f1000research.1114334.1","type":["Other"]}],"topic":[{"term":"Comparative genomics","uri":"http://edamontology.org/topic_0797"},{"term":"Data visualisation","uri":"http://edamontology.org/topic_0092"}],"validated":1},"bioschemas":{"name":"Circos","home":"https://bio.tools/circos","summary":"Circos is tool for visualizing data in a circular format. It was developed for genomic data but can work for many other kinds of data as well.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:circos/cmd/circos.ca","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":6349,"citations":[{"count":8,"year":"-1"},{"count":12,"year":"2009"},{"count":37,"year":"2010"},{"count":69,"year":"2011"},{"count":147,"year":"2012"},{"count":216,"year":"2013"},{"count":266,"year":"2014"},{"count":295,"year":"2026"},{"count":362,"year":"2015"},{"count":381,"year":"2016"},{"count":404,"year":"2017"},{"count":444,"year":"2018"},{"count":477,"year":"2019"},{"count":479,"year":"2025"},{"count":487,"year":"2024"},{"count":535,"year":"2020"},{"count":549,"year":"2023"},{"count":562,"year":"2022"},{"count":619,"year":"2021"}],"doi":"10.1101