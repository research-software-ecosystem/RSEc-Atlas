{"tool_name":"biodataome","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"biodataome","home":"http://dataome.mensxmachina.org/","summary":"A database of uniformly preprocessed and disease annotated omics data. We followed the same preprocessing pipeline for each biological mart to produce ready for downstream analysis and meta-analysis datasets and automatically annotate them with Disease-Ontology terms. We also designate datasets that share common samples. It includes ~2000 datasets, ~200000 samples spanning ~300 diseases. All datasets are publicly available for querying, browsing and downloading via BioDataome web application.","addition_date":"2017-07-21T11:54:14Z","last_update_date":"2018-12-10T12:58:59Z","tool_type":["Web application"],"biotools_curie":"biotools:biodataome","credit":[{"email":"kliolak@gmail.com","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"nkvorn@gmail.com","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"tsamard.it@gmail.com","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://dataome.mensxmachina.org/documentation"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"}]}],"name":"BioDataome","operating_system":["Linux","Mac","Windows"],"owner":"kliolak","topic":[{"term":"Informatics","uri":"http://edamontology.org/topic_0605"},{"term":"Omics","uri":"http://edamontology.org/topic_3391"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:biodataome/web/dataome.mensxmachina.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":200,"ssl":null