{"tool_name":"annotatr","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"annotatr","home":"https://bioconductor.org/packages/annotatr","license":"GPL-3.0","summary":"Given a set of genomic sites/regions (e.g. ChIP-seq peaks, CpGs, differentially methylated CpGs or regions, SNPs, etc.) it is often of interest to investigate the intersecting genomic annotations. Such annotations include those relating to gene models (promoters, 5'UTRs, exons, introns, and 3'UTRs), CpGs (CpG islands, CpG shores, CpG shelves), or regulatory sequences such as enhancers. The annotatr package provides an easy way to summarize and visualize the intersection of genomic sites/regions with genomic annotations.","addition_date":"2017-01-17T14:55:03Z","last_update_date":"2026-09-01T06:30:55.202802Z","tool_type":["Command-line tool","Library"],"version":["1.38.0"],"collections":["BioConductor"],"biotools_curie":"biotools:annotatr","credit":[{"name":"Maureen A. Sartor"},{"name":"Raymond G. Cavalcante","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/annotatr"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genome visualisation","uri":"http://edamontology.org/operation_3208"}]}],"name":"annotatr","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","topic":[{"term":"ChIP-seq","uri":"http://edamontology.org/topic_3169"},{"term":"DNA binding sites","uri":"http://edamontology.org/topic_3125"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Sequence sites, features and motifs","uri":"http://edamontology.org/topic_0160"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:annotatr:1.0.2/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{