{"tool_name":"bioconductor-transomics2cytoscape","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-transomics2cytoscape","identifiers":["doi:10.1016/j.celrep.2014.07.021","doi:10.18129/b9.bioc.transomics2cytoscape"],"license":"Not available","summary":"A tool set for 3d trans-omic network visualization with cytoscape","home_url":"https://bioconductor.org/packages/3.12/bioc/html/transomics2cytoscape.html","keywords":["Allosteric Regulation","Animals","Cell Line, Tumor","HEK293 Cells","Humans","Insulin","Metabolic Networks and Pathways","Metabolome","Phosphoproteins","Phosphorylation","Protein Processing, Post-Translational","Proteome","Rats","Signal Transduction"],"manually_check":true,"total_pulls":120},"biotools":{"id":"bioconductor-transomics2cytoscape","home":"https://bioconductor.org/packages/transomics2cytoscape","license":"Artistic-2.0","summary":"transomics2cytoscape generates a file for 3D transomics visualization by providing input that specifies the IDs of multiple KEGG pathway layers, their corresponding Z-axis heights, and an input that represents the edges between the pathway layers. The edges are used, for example, to describe the relationships between kinase on a pathway and enzyme on another pathway. This package automates creation of a transomics network as shown in the figure in Yugi.2014 (https://doi.org/10.1016/j.celrep.2014.07.021) using Cytoscape automation (https://doi.org/10.1186/s13059-019-1758-4).","tool_type":["Command-line tool","Library"],"version":["1.22.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-transomics2cytoscape","credit":[{"name":"Katsuyuki Yugi","typeEntity":"Person","typeRole":["Developer"]},{"name":"Kozo Nishida","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/transomics2cytoscape"}],"name":"transomics2cytoscape","operating_system":["Li