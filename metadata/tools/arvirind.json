{"tool_name":"arvirind","contents":["biotools","oeb"],"identifiers":["biotools:arvirind"],"fetched_metadata":{"biotools":{"id":"arvirind","home":"http://www.arvirind.co.in","summary":"ArVirInd is a knowledge-base of Arbo-Viral proteins from India and its neighbourhood. his is a annotated database, which acts as a repository of Protein sequences for arbo-viruses along with antigenic information. Users can search for protein sequences by virus / protein name or by country of origin (India and countries of the Indian subcontinent: Nepal, Bhutan, Bangladesh, SriLanka, Pakistan) and year of collection (that is, the year of outbreak which defines the origin of the strain).","addition_date":"2022-03-28T09:39:14.765567Z","last_update_date":"2026-11-12T14:31:34.126137Z","tool_type":["Database portal"],"accessibility":"Open access","biotools_curie":"biotools:arvirind","cost":"Free of charge","credit":[{"email":"ar.vir.ind@gmail.com","name":"ICMR-National Institute of Virology","typeEntity":"Institute","typeRole":["Developer"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Database search","uri":"http://edamontology.org/operation_2421"},{"term":"Epitope mapping","uri":"http://edamontology.org/operation_0416"},{"term":"Peptide immunogenicity prediction","uri":"http://edamontology.org/operation_0252"}]}],"name":"ArVirInd","owner":"Kigaard","publication":[{"doi":"10.22541/AU.163427612.28700439/V1","type":["Preprint"]},{"doi":"10.7717/peerj.13851","type":["Primary"]}],"topic":[{"term":"Immunoinformatics","uri":"http://edamontology.org/topic_3948"},{"term":"Immunoproteins and antigens","uri":"http://edamontology.org/topic_2830"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"},{"term":"Vaccinology","uri":"http://edamontology.org/topic_3966"},{"term":"Virology","uri":"http://edamontology.org/topic_0781"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:arvirind/db/www.arvirind.co.in","@license":"https://cr