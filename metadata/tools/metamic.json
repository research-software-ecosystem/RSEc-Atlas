{"tool_name":"metamic","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"metamic","home":"https://github.com/ZhaoXM-Lab/metaMIC","license":"MIT","summary":"metaMIC is a fully automated tool for identifying and correcting misassemblies of (meta)genomic assemblies with the following three steps. Firstly, metaMIC extracts various types of features from the alignment between paired-end sequencing reads and the assembled contigs. Secondly, the features extracted in the first step will be used as input of a random forest classifier for identifying misassembled metagenomic assemblies. Thirdly, metaMIC will localize misassembly breakpoints for each misassembled contig and then correct misassemblies by splitting into parts at the breakpoints.","addition_date":"2021-11-06T21:43:06.739634Z","last_update_date":"2021-11-06T21:44:45.016916Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:metamic","cost":"Free of charge","credit":[{"email":"luis@luispedro.org","name":"Luis Pedro Coelho","typeEntity":"Person"},{"email":"weihuachen@hust.edu.cn","name":"Wei-Hua Chen","typeEntity":"Person"},{"email":"xmzhao@fudan.edu.cn","name":"Xing-Ming Zhao","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Sequence assembly","uri":"http://edamontology.org/operation_0310"},{"term":"Sequence assembly validation","uri":"http://edamontology.org/operation_3180"},{"term":"Splitting","uri":"http://edamontology.org/operation_3359"}]}],"name":"metaMIC","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1101/2021.06.22.449514"}],"topic":[{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"}],"validated":1},"bioschemas":{"name":"metaMIC","home":"https://bio.tools/metamic","license":"MIT","summary":"metaMIC is a fully automated tool for identifying and correcting misassemblies of (meta)genomic assemblies with the following three steps. Firstly, metaMIC extracts various types of features from the alignment between paired-end sequencing reads and the assembled contigs. Secondly, the features extracted in the first step will be used as input of a random forest classifier for identifying misassembled metagenomic assemblies. Thirdly, metaMIC will localize misassembly breakpoints for each misassembled contig and then correct misassemblies by splitting into parts at the breakpoints.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:metamic/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1101/2021.06.22.449514","ref_count":0,"refs":[]}]}],"readme":false,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/metamic","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":null,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"publications":[],"readme":false,"summary":{"