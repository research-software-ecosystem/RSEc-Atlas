{"tool_name":"peakachu","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"peakachu","identifiers":["biotools:peakachu","doi:10.1038/s41467-020-17239-9"],"license":"ISCL","summary":"Peak calling tool for CLIP-seq data.","home_url":"https://github.com/tbischler/PEAKachu","keywords":["Chromatin","Databases, Genetic","Genome","Humans","K562 Cells","Organ Specificity","Sequence Analysis, DNA","Species Specificity","Supervised Machine Learning","Machine learning","ChIP-seq","Molecular interactions, pathways and networks"],"manually_check":true,"total_pulls":4},"biotools":{"id":"peakachu","home":"https://github.com/tariks/peakachu","license":"MIT","summary":"A supervised learning framework for chromatin loop detection in genome-wide contact maps. It can be used to visualize Hi-C, ChIA-PET, HiCHiP, PLAC-Seq, Capture Hi-C data.","addition_date":"2019-11-14T18:46:26Z","last_update_date":"2024-11-24T20:50:06.119462Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:peakachu","edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Enrichment analysis","uri":"http://edamontology.org/operation_3501"},{"term":"Genome visualisation","uri":"http://edamontology.org/operation_3208"},{"term":"cis-regulatory element prediction","uri":"http://edamontology.org/operation_0441"}]}],"name":"Peakachu","owner":"Kigaard","publication":[{"doi":"10.1038/s41467-020-17239-9","metadata":{"abstract":"Accurately predicting chromatin loops from genome-wide interaction matrices such as Hi-C data is critical to deepening our understanding of proper gene regulation. Current approaches are mainly focused on searching for statistically enriched dots on a genome-wide map. However, given the availability of orthogonal data types such as ChIA-PET, HiChIP, Capture Hi-C, and high-throughput imaging, a supervised learning approach could facilitate the discovery of a comprehensive set of chromatin interactions. Here, we present Peakachu, a Random Forest classification framework that predicts chromatin loops from genome-wide contact maps. We compare Peakachu with current enrichment-based approaches, and find that Peakachu identifies a unique set of short-range interactions. We show that our models perform well in different platforms, across different sequencing depths, and across different species. We apply this framework to predict chromatin loops in 56 Hi-C datasets, and release the results at the 3D Genome Browser.","authors":[{"name":"Khunsriraksakul C."},{"name":"Ruan Y."},{"name":"Salameh T.J."},{"name":"Song F."},{"name":"Wang X."},{"name":"Wright S.M."},{"name":"Yue F."},{"name":"Zhang B."}],"citationCount":62,"date":"2020-12-01T00:00:00Z","journal":"Nature Communications","title":"A supervised learning framework for chromatin loop detection in genome-wide contact maps"},"pmcid":"PMC7347923","pmid":"32647330"}],"topic":[{"term":"ChIP-seq","uri":"http://edamontology.org/topic_3169"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"}],"validated":1},"bioschemas":{"name":"Peakachu","home":"https://bio.tools/peakachu","license":"MIT","summary":"A supervised learning framework for chromatin loop detection in genome-wide contact maps. It can be used to visualize Hi-C, ChIA-PET, HiCHiP, PLAC-Seq, Capture Hi-C data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:peakachu/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true