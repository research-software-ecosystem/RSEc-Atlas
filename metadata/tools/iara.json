{"tool_name":"iara","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"iara","home":"https://pucpr-bioinformatics.github.io/atlas/atlas","summary":"Curated atlas of the biogenesis of spliceosome machinery during RNA splicing.","addition_date":"2023-12-11T19:38:38.755825Z","last_update_date":"2024-11-24T14:28:47.500741Z","tool_type":["Database portal"],"accessibility":"Open access","biotools_curie":"biotools:iara","cost":"Free of charge","credit":[{"email":"roberto.herai@pucpr.br","name":"Roberto H Herai","orcidid":"https://orcid.org/0000-0001-9885-2735","typeEntity":"Person"},{"name":"Kelren S Rodrigues","typeEntity":"Person"},{"name":"Luiz P Petroski","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Splicing analysis","uri":"http://edamontology.org/operation_2499"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"IARA","operating_system":["Linux","Mac","Windows"],"owner":"Pub2Tools","publication":[{"doi":"10.26508/LSA.202201593","metadata":{"abstract":"Splicing is one of the most important post-transcriptional processing systems and is responsible for the generation of transcriptome diversity in all living eukaryotes. Splicing is regulated by the spliceosome machinery, which is responsible for each step of primary RNA processing. However, current molecules and stages involved in RNA splicing are still spread over different studies. Thus, a curated atlas of spliceosome-related molecules and all involved stages during RNA processing can provide all researchers with a reliable resource to better investigate this important mechanism. Here, we present IARA (website access: https://pucpr-bioinformatics.github.io/atlas/), an extensively curated and constantly updated catalog of molecules involved in spliceosome machinery. IARA has a map of the steps involved in the human splicing mechanism, and it allows a detailed overview of the molecules involved throughout the distinct steps of splicing.","authors":[{"name":"Ferrasa A."},{"name":"Herai R.H."},{"name":"Petroski L.P."},{"name":"Rodrigues K.S."},{"name":"Utumi P.H."}],"citationCount":4,"date":"2023-03-01T00:00:00Z","journal":"Life science alliance","title":"IARA: a complete and curated atlas of the biogenesis of spliceosome machinery during RNA splicing"},"pmcid":"PMC9834665","pmid":"36609432"}],"topic":[{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"RNA splicing","uri":"http://edamontology.org/topic_3320"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}]},"bioschemas":{"name":"IARA","home":"https://bio.tools/iara","summary":"Curated atlas of the biogenesis of spliceosome machinery during RNA splicing.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:iara/db/pucpr-bioinformatics.github.io","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":7,"citations":[{"count":1,"year":"2023"},{"count":2,"year":"2024"},{"count":2,"year":"2025"},{"count":2,"year":"2026"}],"doi":"10.26508/lsa.202201593","pmcid":"PMC9834665","pmid":"36609432","ref_count":92,"refs":[{"count":1,"year":"1970"},{"count":1,"year":"1977"},{"count":1,"year":"1979"},{"count":1,"year":"1985"},{"count":1,"year":"1986"},{"count":1,"year":"1994"},{"count":1,"year":"1999"},{"count":1,"year":"2002"},{"count":1,"year":"2003"},{"count":1,"year":"2004"},{"count":1,"year":"2005"},{"count":1,"year":"2006"},{"count":1,"year":"2011"},{"count":2,"year":"1984"},{"count":2,"year":"1996"},{"count":2,"year":"2022"},{"count":3,"year":"2007"},{"count":3,"year":"2010"},{"count":3,"year":"2012"},{"count":3,"year":"2014"},{"count":4,"year":"2008"},{"count":4,"year":"2009"},{"count":5,