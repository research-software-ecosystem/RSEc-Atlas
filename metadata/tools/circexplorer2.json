y of transcriptomes. Precise annotation of circRNAs with their alternative back-splicing and alternative splicing events is the basis for the functional characterization of different categories of circRNAs. Here we describe a step-by-step computational scheme to annotate circRNAs from publicly available RNA sequencing datasets with the CIRCexplorer2 pipeline.","authors":[{"name":"Chen L.-L."},{"name":"Dong R."},{"name":"Ma X.-K."},{"name":"Yang L."}],"citationCount":11,"date":"2019-01-01T00:00:00Z","journal":"Methods in Molecular Biology","title":"Genome-wide annotation of circRNAs and their alternative back-splicing/splicing with CIRCexplorer pipeline"},"pmid":"30539552","type":["Primary"]}],"topic":[{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"Literature and language","uri":"http://edamontology.org/topic_3068"},{"term":"RNA splicing","uri":"http://edamontology.org/topic_3320"}],"validated":1},"bioschemas":{"name":"CIRCexplorer2","home":"https://bio.tools/CIRCexplorer2","license":"Other","summary":"Genome-wide annotation of circRNAs and their alternative back-splicing/splicing.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"2.3.8","first_commit":"2022-08-26","conda_name":"circexplorer2","conda_version":"2.3.8","summary":"Comprehensive and integrative circular RNA analysis toolset.","edam_operations":[],"edam_topics":["RNA splicing","Gene transcripts","Literature and language"],"toolshed_categories":["RNA","Assembly"],"toolshed_id":"circexplorer2","users_5_years":39,"users_all_time":39,"usage_5_years":833,"usage_all_time":833,"bio_tools_summary":"Genome-wide annotation of circRNAs and their alternative back-splicing/splicing.","bio_tools_ids":"circexplorer2","bio_tools_name":"CIRCexplorer2","related_tutorials":[],"related_workflows":[],"tool_ids":["circexplorer2"],"tool_output_formats":["tgz","bigwig","bed","tabular"],"homepage":"https://github.com/YangLab/CIRCexplorer2","suite_source":"https://github.com/galaxyproject