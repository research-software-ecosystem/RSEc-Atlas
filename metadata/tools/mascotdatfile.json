{"tool_name":"mascotdatfile","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"mascotdatfile","home":"http://compomics.github.io/projects/mascotdatfile.html","summary":"A library to fully parse and analyse MASCOT MS/MS search results.","addition_date":"2016-05-17T10:18:18Z","last_update_date":"2019-03-26T08:22:29Z","tool_type":["Library"],"version":["3.4.42"],"collections":["BIG N2N","Compomics","Proteomics","UGent","VIB"],"biotools_curie":"biotools:mascotdatfile","credit":[{"email":"lennart.martens@ugent.be","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"Kenny Helsens","orcidid":"http://orcid.org/0000-0002-7366-0638","typeEntity":"Person"},{"name":"ugent.be","typeEntity":"Institute","typeRole":["Provider"]}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"input":[{"data":{"term":"Mass spectrometry data","uri":"http://edamontology.org/data_2536"}}],"operation":[{"term":"Calculation","uri":"http://edamontology.org/operation_3438"}],"output":[{"data":{"term":"Mass spectrometry data","uri":"http://edamontology.org/data_2536"}}]}],"name":"Mascotdatfile","operating_system":["Linux","Mac","Windows"],"owner":"Katrijn.Vannerum@ugent.be","publication":[{"doi":"10.1002/pmic.200600682","metadata":{"abstract":"MS-based protein identification is an important part of both gel-based and gel-free proteome studies. The MASCOT search engine (http://www.matrixscience. com) provides one of the most popular automated algorithms for this task. Here we present an open-source software library written in Java that parses raw MASCOT results into an easily accessible and fully functional object model (http://genesis.ugent.be/MascotDatfile). Several scripts based on this library are provided as examples, allowing direct automation of important routine tasks involved in processing peptide identifications. \u00a9 2007 Wiley-VCH Verlag GmbH & Co. KGaA.","authors":[{"name":"Gevaert K."},{"name":"Helsens K."},{"name"