{"tool_name":"htqpcr","contents":["bioconda","oeb","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-htqpcr","version":"1.64.0","home":"https://bioconductor.org/packages/3.22/bioc/html/HTqPCR.html","license":"Artistic-2.0","summary":"Automated analysis of high-throughput qPCR data","identifiers":["biotools:htqpcr"],"description":"Analysis of Ct values from high throughput quantitative real-time PCR (qPCR) assays across multiple conditions or replicates. The input data can be from spatially-defined formats such ABI TaqMan Low Density Arrays or OpenArray; LightCycler from Roche Applied Science; the CFX plates from Bio-Rad Laboratories; conventional 96- or 384-well plates; or microfluidic devices such as the Dynamic Arrays from Fluidigm Corporation. HTqPCR handles data loading, quality assessment, normalization, visualization and parametric or non-parametric testing for statistical significance in Ct values between features (e.g. genes, microRNAs).","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-affy >=1.88.0,<1.89.0","bioconductor-biobase >=2.70.0,<2.71.0","bioconductor-limma >=3.66.0,<3.67.0","r-base","r-gplots","r-rcolorbrewer"],"run":["bioconductor-affy >=1.88.0,<1.89.0","bioconductor-biobase >=2.70.0,<2.71.0","bioconductor-limma >=3.66.0,<3.67.0","r-base","r-gplots","r-rcolorbrewer"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/HTqPCR_1.64.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HTqPCR/HTqPCR_1.64.0.tar.gz","https://bioarchive.galaxyproject.org/HTqPCR_1.64.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-htqpcr/bioconductor-htqpcr_1.64.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('HTqPCR')\""]},"parent_recipe":{"name":"bioconductor-htqpcr","path":"recipes/bioconductor-htqpcr","version":"1.34.0"}},"biotools":{"id":"htqpcr","home":"https://bioconductor.org/packages/HTqPCR","license":"Ar