{"tool_name":"m1cr0b1al1z3r","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"M1CR0B1AL1Z3R","home":"https://microbializer.tau.ac.il/","license":"GPL-2.0","summary":"Web server for the analysis of large-scale microbial genomics data.","addition_date":"2019-08-09T13:09:17Z","last_update_date":"2020-06-16T10:55:25Z","tool_type":["Web application","Web service"],"accessibility":"Open access","biotools_curie":"biotools:M1CR0B1AL1Z3R","cost":"Free of charge","credit":[{"email":"talp@tauex.tau.ac.il","name":"Tal Pupko","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["FAQ"],"url":"https://microbializer.tau.ac.il/faq.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Ancestral reconstruction","uri":"http://edamontology.org/operation_3745"},{"term":"Phylogenetic tree reconstruction","uri":"http://edamontology.org/operation_3478"},{"term":"Text mining","uri":"http://edamontology.org/operation_0306"}]}],"maturity":"Emerging","name":"M1CR0B1AL1Z3R","operating_system":["Linux","Mac","Windows"],"owner":"hans","publication":[{"doi":"10.1093/NAR/GKZ423","metadata":{"abstract":"\u00a9 2019 The Author(s).Large-scale mining and analysis of bacterial datasets contribute to the comprehensive characterization of complex microbial dynamics within a microbiome and among different bacterial strains, e.g., during disease outbreaks. The study of large-scale bacterial evolutionary dynamics poses many challenges. These include data-mining steps, such as gene annotation, ortholog detection, sequence alignment and phylogeny reconstruction. These steps require the use of multiple bioinformatics tools and ad-hoc programming scripts, making the entire process cumbersome, tedious and error-prone due to manual handling. This motivated us to develop the M1CR0B1AL1Z3R web server, a 'one-stop shop' for conducting microbial genomics data analyses via a simple graphical user interface. Some of the features implemented in M1CR0B1AL1Z3R are: (i) extracting putative open reading frames and comparative genomics analysis of gene content; (ii) extracting orthologous sets and analyzing their size distribution; (iii) analyzing gene presence-absence patterns; (iv) reconstructing a phylogenetic tree based on the extracted orthologous set; (v) inferring GC-content variation among lineages. M1CR0B1AL1Z3R facilitates the mining and analysis of dozens of bacterial genomes using advanced techniques, with the click of a button. M1CR0B1AL1Z3R is freely available at https://microbializer.tau.ac.il/.","authors":[{"name":"Avram O."},{"name":"Portugez S."},{"name":"Pupko T."},{"name":"Rapoport D."}],"citationCount":26,"date":"2019-07-01T00:00:00Z","journal":"Nucleic Acids Research","title":"M1CR0B1AL1Z3R - a user-friendly web server for the analysis of large-scale microbial genomics data"},"pmcid":"PMC6602433","pmid":"31114912","type":["Primary"]}],"topic":[{"term":"Data mining","uri":"http://edamontology.org/topic_3473"},{"term":"Microbial ecology","uri":"http://edamontology.org/topic_3697"},{"term":"Phylogeny","uri":"http://edamontology.org/topic_0084"}],"validated":1},"bioschemas":{"name":"M1CR0B1AL1Z3R","home":"https://bio.tools/M1CR0B1AL1Z3R","license":"GPL-2.0","summary":"Web server for the analysis of large-scale microbial genomics data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:m1cr0b1al1z3r/soap/microbializer.tau.ac.il","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"faq":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count