{"tool_name":"masspix","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"masspix","home":"https://github.com/hallz/massPix","summary":"Processes high resolution mass spectrometry imaging data, performs multivariate statistics (PCA, clustering) and lipid identification.","addition_date":"2018-07-19T16:13:14Z","last_update_date":"2024-11-24T13:48:46.625751Z","tool_type":["Command-line tool"],"collections":["Proteomics"],"biotools_curie":"biotools:masspix","credit":[{"email":"jlg40@cam.ac.uk","name":"Julian L. Griffin","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/hallz/massPix"}],"edit_permission":{"authors":["proteomics.bio.tools","sizhengZhao"],"type":"group"},"function":[{"input":[{"data":{"term":"Lipid structure","uri":"http://edamontology.org/data_2850"},"format":[{"term":"CSV","uri":"http://edamontology.org/format_3752"}]},{"data":{"term":"Mass spectrometry data","uri":"http://edamontology.org/data_2536"},"format":[{"term":"imzML metadata file","uri":"http://edamontology.org/format_3682"}]}],"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"},{"term":"Image analysis","uri":"http://edamontology.org/operation_3443"},{"term":"Principal component analysis","uri":"http://edamontology.org/operation_3960"},{"term":"Spectral analysis","uri":"http://edamontology.org/operation_3214"}],"output":[{"data":{"term":"Image","uri":"http://edamontology.org/data_2968"},"format":[{"term":"JPG","uri":"http://edamontology.org/format_3579"},{"term":"PNG","uri":"http://edamontology.org/format_3603"}]},{"data":{"term":"Report","uri":"http://edamontology.org/data_2048"},"format":[{"term":"CSV","uri":"http://edamontology.org/format_3752"}]}]}],"name":"massPix","operating_system":["Linux","Mac","Windows"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1007/s11306-017-1252-5","metadata":{"abstract":"Introduction: Mass spectrometry imaging (MSI) experiments result in complex multi-dimensional datasets, which require specialist data analysis tools. Objectives: We have developed massPix\u2014an R package for analysing and interpreting data from MSI of lipids in tissue. Methods: massPix produces single ion images, performs multivariate statistics and provides putative lipid annotations based on accurate mass matching against generated lipid libraries. Results: Classification of tissue regions with high spectral similarly can be carried out by principal components analysis (PCA) or k-means clustering. Conclusion: massPix is an open-source tool for the analysis and statistical interpretation of MSI data, and is particularly useful for lipidomics applications.","authors":[{"name":"Bond N.J."},{"name":"Griffin J.L."},{"name":"Hall Z."},{"name":"Koulman A."}],"citationCount":19,"date":"2017-11-01T00:00:00Z","journal":"Metabolomics","title":"massPix: an R package for annotation and interpretation of mass spectrometry imaging data for lipidomics"},"pmcid":"PMC5608769","pmid":"28989334"}],"topic":[{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"},{"term":"Statistics and probability","uri":"http://edamontology.org/topic_2269"}],"validated":1},"bioschemas":{"name":"massPix","home":"https://bio.tools/masspix","summary":"Processes high resolution mass spectrometry imaging data, performs multivariate statistics (PCA, clustering) and lipid identification.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:masspix/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":13,"citations":[{"c