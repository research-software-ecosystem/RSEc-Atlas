{"tool_name":"nonpareil","contents":["biocontainers","galaxy","bioschemas","biotools","oeb"],"fetched_metadata":{"biocontainers":{"name":"nonpareil","identifiers":["doi:10.1093/bioinformatics/btt584"],"license":"Artistic-2.0","summary":"Estimate average coverage and create nonpareil curves for metagenomic datasets.","home_url":"http://enve-omics.ce.gatech.edu/nonpareil/","keywords":["Metagenome","Metagenomics","Microbiota","Soil Microbiology"],"manually_check":true,"total_pulls":3356},"biotools":{"id":"nonpareil","home":"http://enve-omics.ce.gatech.edu/nonpareil/","license":"Artistic-2.0","summary":"Estimate metagenomic coverage and sequence diversity","addition_date":"2024-03-11T23:56:26.319721Z","last_update_date":"2024-11-24T14:09:33.328664Z","version":["3.4.1"],"accessibility":"Open access","biotools_curie":"biotools:nonpareil","cost":"Free of charge","credit":[{"email":"miguel@rodriguez-r.com","name":"Luis M Rodriguez-R","typeEntity":"Person","typeRole":["Developer"],"url":"https://github.com/lmrodriguezr"}],"documentation":[{"type":["General"],"url":"https://nonpareil.readthedocs.io"}],"edit_permission":{"type":"private"},"function":[{"cmd":"nonpareil -s reads.fa -T kmer -f fastq -b output # fastq is recommended for kmer algorithm","input":[{"data":{"term":"RNA sequence","uri":"http://edamontology.org/data_3495"},"format":[{"term":"FASTQ","uri":"http://edamontology.org/format_1930"}]}],"operation":[{"term":"Operation","uri":"http://edamontology.org/operation_0004"}],"output":[{"data":{"term":"Evidence","uri":"http://edamontology.org/data_2042"},"format":[{"term":"TSV","uri":"http://edamontology.org/format_3475"}]}]}],"maturity":"Mature","name":"nonpareil","owner":"klemmp","publication":[{"doi":"10.1093/bioinformatics/btt584","metadata":{"abstract":"Motivation: Determining the fraction of the diversity within a microbial community sampled and the amount of sequencing required to cover the total diversity represent challenging issues for metagenomics studies. Owing to these limitations, central ecological questions with respect to the global distribution of microbes and the functional diversity of their communities cannot be robustly assessed.Results: We introduce Nonpareil, a method to estimate and project coverage in metagenomes. Nonpareil does not rely on high-quality assemblies, operational taxonomic unit calling or comprehensive reference databases; thus, it is broadly applicable to metagenomic studies. Application of Nonpareil on available metagenomic datasets provided estimates on the relative complexity of soil, freshwater and human microbiome communities, and suggested that \u223c200 Gb of sequencing data are required for 95% abundance-weighted average coverage of the soil communities analyzed. \u00a9 2013 The Author 2013. Published by Oxford University Press. All rights reserved.","authors":[{"name":"Konstantinidis K.T."},{"name":"Rodriguez-R L.M."}],"citationCount":165,"date":"2014-03-01T00:00:00Z","journal":"Bioinformatics","title":"Nonpareil: A redundancy-based approach to assess the level of coverage in metagenomic datasets"},"pmid":"24123672"}]},"bioschemas":{"name":"nonpareil","home":"https://bio.tools/nonpareil","license":"Artistic-2.0","version":"3.4.1","summary":"Estimate metagenomic coverage and sequence diversity","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"3.5.5","first_commit":"2017-11-03","conda_name":"nonpareil","conda_version":"3.5.5","summary":"Estimate average coverage in metagenomic datasets","edam_operations":["Operation"],"edam_topics":[],"toolshed_categories":["Metagenomics"],"toolshed_id":"nonpareil","users_5_years":39,"users_all_time":45,"usage_5_years":227,"usage_all_time":363,"bio_tools_summary":"Estimate metagenomic coverage and sequence diversity","bio_tools_ids":"nonpareil","bio_tools_name":"nonpareil","related_tutorials":[],"related_workflows":[],"tool_ids":["nonpareil"],"tool_output_formats":["tabular","txt","json"],"homepage":"http://nonpareil.readthedocs.io","suite_