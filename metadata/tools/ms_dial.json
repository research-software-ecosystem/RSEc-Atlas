ometry. Using human, murine, algal and plant biological samples, we annotated and semiquantified 8,051 lipids using MS-DIAL 4 with a 1\u20132% estimated false discovery rate. MS-DIAL 4 helps standardize lipidomics data and discover lipid pathways.","authors":[{"name":"Arita M."},{"name":"Arita M."},{"name":"Bonini P."},{"name":"Cajka T."},{"name":"Fiehn O."},{"name":"Higashi Y."},{"name":"Ikeda K."},{"name":"Koelmel J."},{"name":"Mori Y."},{"name":"Okahashi N."},{"name":"Okazaki Y."},{"name":"Saito K."},{"name":"Satoh A."},{"name":"Tada I."},{"name":"Takahashi M."},{"name":"Tsugawa H."},{"name":"Uchino H."},{"name":"Yamada Y."},{"name":"Zhou Z."},{"name":"Zhu Z.-J."}],"citationCount":38,"date":"2020-10-01T00:00:00Z","journal":"Nature Biotechnology","title":"A lipidome atlas in MS-DIAL 4"},"type":["Primary"]}],"topic":[{"term":"Lipids","uri":"http://edamontology.org/topic_0153"},{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"}]},"bioschemas":{"name":"MS-DIAL","home":"https://bio.tools/ms_dial","summary":"MS-DIAL was launched as a universal program for untargeted metabolomics that supports multiple instruments (GC/MS, GC/MS/MS, LC/MS, and LC/MS/MS) and MS vendors (Agilent, Bruker, LECO, Sciex, Shimadzu, Thermo, and Waters)","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ms_dial/app/prime.psc.riken.jp","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":false,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"faq":true,"general":true},"publications":[{"entries":[{"cit_count":422,"citations":[{"count":7,"year":"202