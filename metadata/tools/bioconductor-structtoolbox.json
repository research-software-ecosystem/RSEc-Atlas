{"tool_name":"bioconductor-structtoolbox","contents":["biocontainers","oeb","bioschemas"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-structtoolbox","identifiers":["doi:10.18129/b9.bioc.structtoolbox"],"license":"GPL-3","summary":"Data processing & analysis tools for Metabolomics and other omics","home_url":"https://bioconductor.org/packages/3.11/bioc/html/structToolbox.html","keywords":["Metabolomics"],"manually_check":true,"total_pulls":4},"bioschemas":{"name":"structToolbox","home":"https://bio.tools/bioconductor-structtoolbox","license":"GPL-3.0-only","version":"1.24.0","summary":"An extensive set of data (pre-)processing and analysis methods and tools for metabolomics and other omics, with a strong emphasis on statistics and machine learning. This toolbox allows the user to build extensive and standardised workflows for data analysis. The methods and tools have been implemented using class-based templates provided by the struct (Statistics in R Using Class-based Templates) package. The toolbox includes pre-processing methods (e.g. signal drift and batch correction, normalisation, missing value imputation and scaling), univariate (e.g. ttest, various forms of ANOVA, Kruskal\u2013Wallis test and more) and multivariate statistical methods (e.g. PCA and PLS, including cross-validation and permutation testing) as well as machine learning methods (e.g. Support Vector Machines). Ontology terms have been integrated to provide standardised definitions for the different methods, inputs and outputs.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-structtoolbox:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschema