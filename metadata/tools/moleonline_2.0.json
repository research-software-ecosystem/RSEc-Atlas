{"tool_name":"moleonline_2.0","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"moleonline_2.0","home":"http://old.mole.upol.cz/","license":"CC-BY-NC-3.0","summary":"Analysis of access/egress paths to biomolecular channels. A 3D graphical representation of the channel is displayed along with a list of lining residues and biochemical properties.","addition_date":"2017-03-25T13:09:24Z","last_update_date":"2024-11-24T20:23:18.643182Z","tool_type":["Web application"],"version":["2.0"],"collections":["ELIXIR-CZ"],"accessibility":"Open access","biotools_curie":"biotools:moleonline_2.0","cost":"Free of charge","credit":[{"email":"mole@upol.cz","name":"MOLE Support","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://mole.upol.cz/documentation/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Molecular surface analysis","uri":"http://edamontology.org/operation_3351"},{"term":"Molecular surface calculation","uri":"http://edamontology.org/operation_0387"},{"term":"Residue distance calculation","uri":"http://edamontology.org/operation_2950"},{"term":"Sequence alignment analysis (conservation)","uri":"http://edamontology.org/operation_0448"}]}],"maturity":"Legacy","name":"MOLEonline 2.0","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-CZ","publication":[{"doi":"10.1093/nar/gks363","metadata":{"abstract":"Biomolecular channels play important roles in many biological systems, e.g. enzymes, ribosomes and ion channels. This article introduces a web-based interactive MOLEonline 2.0 application for the analysis of access/egress paths to interior molecular voids. MOLEonline 2.0 enables platform-independent, easy-to-use and interactive analyses of (bio)macromolecular channels, tunnels and pores. Results are presented in a clear manner, making their interpretation easy. For each channel, MOLEonline displays a 3D graphical representation of the channel, its profile accompanied by a list of lining residues and also its basic physicochemical properties. The users can tune advanced parameters when performing a channel search to direct the search according to their needs. The MOLEonline 2.0 application is freely available via the Internet at http://ncbr.muni.cz/mole or http://mole.upol.cz. \u00a9 2012 The Author(s).","authors":[{"name":"Banas P."},{"name":"Berka K."},{"name":"Hanak O."},{"name":"Ionescu C.-M."},{"name":"Jaiswal D."},{"name":"Koca J."},{"name":"Navratilova V."},{"name":"Otyepka M."},{"name":"Sehnal D."},{"name":"Svobodova Varekova R."}],"citationCount":108,"date":"2012-07-01T00:00:00Z","journal":"Nucleic Acids Research","title":"MOLEonline 2.0: Interactive web-based analysis of biomacromolecular channels"},"pmcid":"PMC3394309","pmid":"22553366"}],"topic":[{"term":"Enzymes","uri":"http://edamontology.org/topic_0821"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"}],"validated":1},"bioschemas":{"name":"MOLEonline 2.0","home":"https://bio.tools/moleonline_2.0","license":"CC-BY-NC-3.0","version":"2.0","summary":"Analysis of access/egress paths to biomolecular channels. A 3D graphical representation of the channel is displayed along with a list of lining residues and biochemical properties.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:moleonline_2.0:2.0/web/old.mole.upol.cz","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":81,"citations":[{"count":2,"year":"2017"},{"count":2,"year":"2021"},{"count":2,"year":"2025"},{"count":3,"year":"2012"},{"count":3,"year":"2016"},{"count":4,"year":"2019"},{"count":5,"year":"2015"},{"count":5,"yea