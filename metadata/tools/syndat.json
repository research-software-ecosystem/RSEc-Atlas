{"tool_name":"syndat","contents":["biotools","oeb"],"identifiers":["biotools:syndat"],"fetched_metadata":{"biotools":{"id":"syndat","home":"https://github.com/SCAI-BIO/syndat","license":"Apache-2.0","summary":"Syndat computes quality metrics for synthetic tabular data and visualizes how closely it reproduces the real data. It implements three base metrics: Jensen-Shannon distance for feature distributions, normalized correlation difference for inter-feature relationships, and discriminator AUC from a cross-validated Random Forest classifier, and aggregates them into normalized 0-100 distribution, correlation and discrimination scores. It also provides stratified visualizations (raincloud, GOF, trajectory plots) for clinical subgroups.","addition_date":"2026-11-06T15:46:59.034852Z","last_update_date":"2026-11-06T15:49:18.793692Z","tool_type":["Library"],"collections":["Synthetic Data"],"accessibility":"Open access","biotools_curie":"biotools:syndat","cost":"Free of charge","credit":[{"email":"holger.froehlich@scai.fraunhofer.de","name":"Holger Fr\u00f6hlich","orcidid":"https://orcid.org/0000-0002-5328-1243","typeRole":["Primary contact","Provider"]},{"email":"tim.adams@scai.fraunhofer.de","name":"Tim Adams","orcidid":"https://orcid.org/0000-0002-2823-0102","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["API documentation"],"url":"https://syndat.readthedocs.io"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Comparison","uri":"http://edamontology.org/operation_2424"}]},{"operation":[{"term":"Data analysis","uri":"http://edamontology.org/operation_2945"}]},{"operation":[{"term":"Statistical calculation","uri":"http://edamontology.org/operation_2238"}]},{"operation":[{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"maturity":"Mature","name":"Syndat","operating_system":["Linux","Mac","Windows"],"owner":"tim","publication":[{"doi":"10.1016/j.isci.2025.112382","pmcid":"PMC12059695","pmid":"40343279","t