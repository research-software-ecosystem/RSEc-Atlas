{"tool_name":"padua","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"padua","home":"https://github.com/mfitzp/padua","license":"BSD-2-Clause","summary":"A Python package for Proteomic Data Analysis, specifically analyzing of the output of MaxQuant.","addition_date":"2019-01-22T14:50:59Z","last_update_date":"2024-11-24T21:05:27.356901Z","tool_type":["Library"],"collections":["Proteomics"],"accessibility":"Open access","biotools_curie":"biotools:padua","cost":"Free of charge","credit":[{"email":"martin.fitzpatrick@gmail.com","name":"Martin Fitzpatrick","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/mfitzp/padua/blob/master/README.md"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"input":[{"data":{"term":"Experiment report","uri":"http://edamontology.org/data_2531"},"format":[{"term":"CSV","uri":"http://edamontology.org/format_3752"}]},{"data":{"term":"Expression data","uri":"http://edamontology.org/data_2603"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}],"operation":[{"term":"Protein quantification","uri":"http://edamontology.org/operation_3630"}],"output":[{"data":{"term":"Plot","uri":"http://edamontology.org/data_2884"},"format":[{"term":"PDF","uri":"http://edamontology.org/format_3508"}]}]}],"maturity":"Mature","name":"PaDuA","operating_system":["Linux","Mac","Windows"],"owner":"n.m.palmblad@lumc.nl","publication":[{"doi":"10.1021/acs.jproteome.8b00576","metadata":{"abstract":"The increased speed and sensitivity in mass spectrometry-based proteomics has encouraged its use in biomedical research in recent years. Large-scale detection of proteins in cells, tissues, and whole organisms yields highly complex quantitative data, the analysis of which poses significant challenges. Standardized proteomic workflows are necessary to ensure automated, sharable, and reproducible proteomics analysis. Likewise, standardized data processing workflows are also essential for the overall reproducibility of results. To this purpose, we developed PaDuA, a Python package optimized for the processing and analysis of (phospho)proteomics data. PaDuA provides a collection of tools that can be used to build scripted workflows within Jupyter Notebooks to facilitate bioinformatics analysis by both end-users and developers.","authors":[{"name":"Altelaar M."},{"name":"Fitzpatrick M."},{"name":"Heck A.J.R."},{"name":"Ressa A."},{"name":"Van Den Toorn H."}],"citationCount":14,"date":"2019-02-01T00:00:00Z","journal":"Journal of Proteome Research","title":"PaDuA: A Python Library for High-Throughput (Phospho)proteomics Data Analysis"},"pmcid":"PMC6364269","pmid":"30525654","type":["Primary"]}],"topic":[{"term":"Protein expression","uri":"http://edamontology.org/topic_0108"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"}],"validated":1},"bioschemas":{"name":"PaDuA","home":"https://bio.tools/padua","license":"BSD-2-Clause","summary":"A Python package for Proteomic Data Analysis, specifically analyzing of the output of MaxQuant.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:padua/lib/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":7,"citations":[{"count":1,"year":"2020"},{"count":1,"year":"2025"},{"count":1,"year":"2026"},{"count":2,"year":"2022"},{"count":2,"year":"2023"}],"doi":"10.1021/acs.jproteome.8b00576","pmcid":"PMC6364269","pm