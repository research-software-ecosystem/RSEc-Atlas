{"tool_name":"nadfinder","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"nadfinder","home":"https://bioconductor.org/packages/NADfinder","license":"GPL-2.0-or-later","summary":"Nucleolus is an important structure inside the nucleus in eukaryotic cells. It is the site for transcribing rDNA into rRNA and for assembling ribosomes, aka ribosome biogenesis. In addition, nucleoli are dynamic hubs through which numerous proteins shuttle and contact specific non-rDNA genomic loci. Deep sequencing analyses of DNA associated with isolated nucleoli (NAD- seq) have shown that specific loci, termed nucleolus- associated domains (NADs) form frequent three- dimensional associations with nucleoli. NAD-seq has been used to study the biological functions of NAD and the dynamics of NAD distribution during embryonic stem cell (ESC) differentiation. Here, we developed a Bioconductor package NADfinder for bioinformatic analysis of the NAD-seq data, including baseline correction, smoothing, normalization, peak calling, and annotation.","addition_date":"2018-07-12T11:15:06Z","last_update_date":"2018-12-10T12:59:00Z","tool_type":["Library"],"version":["1.36.0"],"collections":["BioConductor"],"biotools_curie":"biotools:nadfinder","credit":[{"name":"Haibo Liu"},{"name":"Herv\u00e9 Pag\u00e8s"},{"name":"Jianhong Ou"},{"name":"Jun Yu"},{"name":"Lihua Julie Zhu"},{"name":"Paul Kaufman"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/NADfinder"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Annotation","uri":"http://edamontology.org/operation_0226"}]},{"operation":[{"term":"Peak detection","uri":"http://edamontology.org/operation_3215"}]},{"operation":[{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"NADfinder","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[],"topic":[{"term":"Gene regulation","uri":"http://edamontology.org/topic_0204"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:nadfinder:1.4.0/lib/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"source_packages":true,"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"ref_count":0,"refs":[]}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://bioconductor.org/packages/release/bioc/html/NADfinder.html"}],"ssl":true,"ssl_err":null}},"support":{"email":true}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:nadfinder:1.10.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:nadfinder:1.12.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:nadfinder:1.14.0/cmd/bioconductor.org","@license":"https://c