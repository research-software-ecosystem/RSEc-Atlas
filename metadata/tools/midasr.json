{"tool_name":"midasr","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"midasr","home":"https://github.com/Genentech/MiDAS","license":"MIT","summary":"Meaningful Immunogenetic Data at Scale.\n\nHuman immunogenetic variation in the form of HLA and KIR types has been shown to be strongly associated with a multitude of immune-related phenotypes. We present MiDAS, an R package enabling statistical association analysis and using immunogenetic data transformation functions for HLA amino acid fine mapping, analysis of HLA evolutionary divergence as well as HLA-KIR interactions. MiDAS closes the gap between inference of immunogenetic variation and its efficient utilization to make meaningful discoveries.","addition_date":"2021-03-19T08:37:48Z","last_update_date":"2021-04-11T09:24:33Z","tool_type":["Library"],"biotools_curie":"biotools:midasr","credit":[{"email":"hammer.christian@gene.com","name":"Christian Hammer","typeEntity":"Person"}],"documentation":[{"type":["Training material"],"url":"https://genentech.github.io/MiDAS/articles/MiDAS_tutorial.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Imputation","uri":"http://edamontology.org/operation_3557"},{"term":"Regression analysis","uri":"http://edamontology.org/operation_3659"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"}]}],"name":"MiDASR","owner":"Niclaskn","publication":[{"doi":"10.1101/2021.01.12.425276"}],"topic":[{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Immunogenetics","uri":"http://edamontology.org/topic_3930"},{"term":"Immunoproteins and antigens","uri":"http://edamontology.org/topic_2830"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}]},"bioschemas":{"name":"MiDASR","home":"https://bio.tools/midasr","license":"MIT","summary":"