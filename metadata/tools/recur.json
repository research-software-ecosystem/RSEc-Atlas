{"tool_name":"recur","contents":["biotools"],"identifiers":["biotools:recur"],"fetched_metadata":{"biotools":{"id":"recur","home":"https://github.com/OrthoFinder/RECUR","license":"GPL-3.0","summary":"RECUR is a method designed to identify recurrent amino acid substitutions from multiple sequence alignments, particularly useful for understanding adaptation and immune escape in proteins like SARS-CoV-2 S proteins.","addition_date":"2026-11-04T10:30:37.857707Z","last_update_date":"2026-11-04T10:30:37.860504Z","biotools_curie":"biotools:recur","credit":[{"email":"steven.kelly@biology.ox.ac.uk","name":"Steven Kelly","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Multiple sequence alignment","uri":"http://edamontology.org/operation_0492"},{"term":"Phylogenetic inference","uri":"http://edamontology.org/operation_0323"},{"term":"Phylogenetic tree bootstrapping","uri":"http://edamontology.org/operation_0552"},{"term":"Sequence trimming","uri":"http://edamontology.org/operation_3192"}]}],"name":"RECUR: Identifying Recurrent Amino Acid Substitutions","owner":"pub2tools2024","publication":[{"doi":"10.1093/MOLBEV/MSAG036","pmcid":"PMC12930092","pmid":"41668465"}],"topic":[{"term":"Enzymes","uri":"http://edamontology.org/topic_0821"},{"term":"Molecular evolution","uri":"http://edamontology.org/topic_3945"},{"term":"Phylogenomics","uri":"http://edamontology.org/topic_0194"},{"term":"Phylogeny","uri":"http://edamontology.org/topic_0084"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}]}}}