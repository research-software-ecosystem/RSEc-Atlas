{"tool_name":"ghostipy","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"ghostipy","home":"https://github.com/kemerelab/ghostipy/","license":"Apache-2.0","summary":"An efficient signal processing and spectral analysis toolbox for large data.","addition_date":"2022-03-01T21:44:21.425313Z","last_update_date":"2022-03-01T21:44:21.428122Z","tool_type":["Library"],"accessibility":"Open access","biotools_curie":"biotools:ghostipy","cost":"Free of charge","credit":[{"email":"caleb.kemere@rice.edu","name":"Caleb T. Kemere","orcidid":"https://orcid.org/0000-0003-2054-0234","typeEntity":"Person"},{"name":"Joshua P. Chu"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Filtering","uri":"http://edamontology.org/operation_3695"},{"term":"Spectral analysis","uri":"http://edamontology.org/operation_3214"}]}],"name":"GhostiPy","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1523/ENEURO.0202-21.2021","metadata":{"abstract":"\u00a9 2021 Chu and Kemere.Recent technological advances have enabled neural recordings consisting of hundreds to thousands of chan-nels. As the pace of these developments continues to grow rapidly, it is imperative to have fast, flexible tools supporting the analysis of neural data gathered by such large-scale modalities. Here we introduce GhostiPy (general hub of spectral techniques in Python), a Python open source software toolbox implementing various signal processing and spectral analyses including optimal digital filters and time\u2013frequency transforms. GhostiPy prioritizes performance and efficiency by using parallelized, blocked algorithms. As a result, it is able to outperform commercial software in both time and space complexity for high-channel count data and can handle out-of-core computation in a user-friendly manner. Overall, our software suite reduces frequently en-countered bottlenecks in the experimental pipeline, and we believe this toolset will enhance both the portabil-ity and scalability of neural data analysis.","authors":[{"name":"Chu J.P."},{"name":"Kemere C.T."}],"date":"2021-11-01T00:00:00Z","journal":"eNeuro","title":"Ghostipy: An efficient signal processing and spectral analysis toolbox for large data"},"pmcid":"PMC8641918","pmid":"34556557"}],"topic":[{"term":"Computer science","uri":"http://edamontology.org/topic_3316"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}],"validated":1},"bioschemas":{"name":"GhostiPy","home":"https://bio.tools/ghostipy","license":"Apache-2.0","summary":"An efficient signal processing and spectral analysis toolbox for large data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ghostipy/lib/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":1,"citations":[{"count":1,"year":"2025"}],"doi":"10.1523/ENEURO.0202-21.2021","pmcid":"PMC8641918","pmid":"34556557","ref_count":13,"refs":[{"count":1,"year":"2014"},{"count":1,"year":"2015"},{"count":1,"year":"2020"},{"count":2,"year":"2006"},{"count":2,"year":"2010"},{"count":2,"year":"2013"},{"count":2,"year":"2016"},{"count":2,"year":"2019"}],"title":"GhostiPy: An Efficient Signal Processing and Spectral Analysis Toolbox for Large Data.","year":2021}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_