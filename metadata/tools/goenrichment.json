{"tool_name":"goenrichment","contents":["biocontainers","galaxy","bioschemas","biotools","oeb"],"fetched_metadata":{"biocontainers":{"name":"goenrichment","identifiers":["biotools:goenrichment"],"license":"Apache-2.0","summary":"Goenrichment analyses a set of gene products for go term enrichment","home_url":"https://github.com/DanFaria/GOEnrichment","keywords":["Transcriptomics"],"manually_check":true,"total_pulls":3358},"biotools":{"id":"goenrichment","home":"https://github.com/DanFaria/GOEnrichment","license":"Apache-2.0","summary":"GOEnrichment is a tool for performing GO enrichment analysis of gene sets, such as those obtained from RNA-seq or Microarray experiments, to help characterize them at the functional level. It is available in Galaxy Europe and as a stand-alone tool.\nGOEnrichment is flexible in that it allows the user to use any version of the Gene Ontology and any GO annotation file they desire. To enable the use of GO slims, it is accompanied by a sister tool GOSlimmer, which can convert annotation files from full GO to any specified GO slim.\nThe tool features an optional graph clustering algorithm to reduce the redundancy in the set of enriched GO terms and simplify its output.\nIt was developed by the BioData.pt / ELIXIR-PT team at the Instituto Gulbenkian de Ci\u00eancia.","addition_date":"2019-01-25T11:09:58Z","last_update_date":"2023-11-02T09:06:24.706575Z","tool_type":["Command-line tool"],"version":["2.0"],"accessibility":"Open access","biotools_curie":"biotools:goenrichment","cost":"Free of charge","credit":[{"email":"dfaria@igc.gulbenkian.pt","name":"Daniel Faria","note":"Researcher at the Instituto Gulbenkian de Ci\u00eancia and member of ELIXIR-PT.","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"note":"Tutorial material","type":["Training material"],"url":"https://galaxyproject.github.io/training-material/topics/transcriptomics/tutorials/goenrichment/tutorial.html"}],"edit_permission":{"authors":["ELIXIR-CZ"],"type":"group"},"function":[{"input":[{"data":{"term":"Expression data","uri":"http://edamontology.org/data_2603"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]},{"data":{"term":"Ontology","uri":"http://edamontology.org/data_0582"},"format":[{"term":"OBO format","uri":"http://edamontology.org/format_2196"},{"term":"OWL format","uri":"http://edamontology.org/format_2197"}]}],"operation":[{"term":"Gene-set enrichment analysis","uri":"http://edamontology.org/operation_2436"}],"output":[{"data":{"term":"GO-term enrichment data","uri":"http://edamontology.org/data_3754"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"},{"term":"png","uri":"http://edamontology.org/format_3603"}]}]}],"maturity":"Mature","name":"GOEnrichment","owner":"ELIXIR-PT","topic":[{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"GOEnrichment","home":"https://bio.tools/goenrichment","license":"Apache-2.0","version":"2.0","summary":"GOEnrichment is a tool for performing GO enrichment analysis of gene sets, such as those obtained from RNA-seq or Microarray experiments, to help characterize them at the functional level. It is available in Galaxy Europe and as a stand-alone tool.\nGOEnrichment is flexible in that it allows the user to use any version of the Gene Ontology and any GO annotation file they desire. To enable the use of GO slims, it is accompanied by a sister tool GOSlimmer, which can convert annotation files from full GO to any specified GO slim.\nThe tool features an optional graph clustering algorithm to reduce the redundancy in the set of enriched GO terms and simplify its output.\nIt was developed by the BioData.pt / ELIXIR-PT team at the Instituto Gulbenkian de Ci\u00eancia.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"@TOOL_VERSION@+galaxy@VERSION_SUFFIX@","first_commit":"2018-12-28","conda_name":"goenrichment","conda_version":"2.0.1","summary":"Performs GO E