{"tool_name":"crispam","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"crispam","home":"https://github.com/ristllin/CrisPam","summary":"CrisPam is a web tool that detects SNP-derived PAMs for allele-specific targeting by the CRISPR/Cas system. The algorithm scans the generation of each reported PAM for a given DNA sequence and its variations. A successful result is such that at least one PAM is generated by a SNP. Thus, the PAM shall be part of the variant allele only and the Cas protein will therefore be able to exclusively bind the variant allele for gene-editing, while the wildtype allele remains unchanged.","addition_date":"2021-01-18T08:34:40Z","last_update_date":"2021-02-18T15:21:51Z","tool_type":["Web application"],"biotools_curie":"biotools:crispam","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"PCR primer design","uri":"http://edamontology.org/operation_0308"},{"term":"SNP annotation","uri":"http://edamontology.org/operation_3661"},{"term":"SNP detection","uri":"http://edamontology.org/operation_0484"}]}],"name":"CrisPam","owner":"Kigaard","publication":[{"doi":"10.21203/RS.2.9413/V1"}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Epigenomics","uri":"http://edamontology.org/topic_3173"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"}]},"bioschemas":{"name":"CrisPam","home":"https://bio.tools/crispam","summary":"CrisPam is a web tool that detects SNP-derived PAMs for allele-specific targeting by the CRISPR/Cas system. The algorithm scans the generation of each reported PAM for a given DNA sequence and its variations. A successful result is such that at least one PAM is generated by a SNP. Thus, the PAM shall be part of the variant allele only and the Cas protein will therefore be able to exclusively bind the variant allele for gene-editing, while the wildtype allele remains unchanged.","tool_type":"sc:Software