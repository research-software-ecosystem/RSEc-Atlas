{"tool_name":"genomicfeatures","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-genomicfeatures","version":"1.62.0","home":"https://bioconductor.org/packages/3.22/bioc/html/GenomicFeatures.html","license":"Artistic-2.0","summary":"Query the gene models of a given organism/assembly","identifiers":["biotools:genomicfeatures"],"description":"Extract the genomic locations of genes, transcripts, exons, introns, and CDS, for the gene models stored in a TxDb object. A TxDb object is a small database that contains the gene models of a given organism/assembly. Bioconductor provides a small collection of TxDb objects in the form of ready-to-install TxDb packages for the most commonly studied organisms. Additionally, the user can easily make a TxDb object (or package) for the organism/assembly of their choice by using the tools from the txdbmaker package.","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-annotationdbi >=1.72.0,<1.73.0","bioconductor-biocgenerics >=0.56.0,<0.57.0","bioconductor-biostrings >=2.78.0,<2.79.0","bioconductor-genomicranges >=1.62.0,<1.63.0","bioconductor-iranges >=2.44.0,<2.45.0","bioconductor-rtracklayer >=1.70.0,<1.71.0","bioconductor-s4vectors >=0.48.0,<0.49.0","bioconductor-seqinfo >=1.0.0,<1.1.0","bioconductor-xvector >=0.50.0,<0.51.0","r-base","r-dbi"],"run":["bioconductor-annotationdbi >=1.72.0,<1.73.0","bioconductor-biocgenerics >=0.56.0,<0.57.0","bioconductor-biostrings >=2.78.0,<2.79.0","bioconductor-genomicranges >=1.62.0,<1.63.0","bioconductor-iranges >=2.44.0,<2.45.0","bioconductor-rtracklayer >=1.70.0,<1.71.0","bioconductor-s4vectors >=0.48.0,<0.49.0","bioconductor-seqinfo >=1.0.0,<1.1.0","bioconductor-xvector >=0.50.0,<0.51.0","r-base","r-dbi"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/GenomicFeatures_1.62.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GenomicFeatures/GenomicFeatures_1.62.0.tar.gz","https://bioarchive.galaxyproject.org/GenomicFeatures_1.62.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-genomicfeatures/bioconductor-genomicfeatures_1.62.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('GenomicFeatures')\""]},"parent_recipe":{"name":"bioconductor-genomicfeatures","path":"recipes/bioconductor-genomicfeatures","version":"1.32.3"}},"biotools":{"id":"genomicfeatures","home":"https://bioconductor.org/packages/GenomicRanges","license":"Artistic-2.0","summary":"The ability to efficiently represent and manipulate genomic annotations and alignments is playing a central role when it comes to analyzing high-throughput sequencing data (a.k.a. NGS data). The GenomicRanges package defines general purpose containers for storing and manipulating genomic intervals and variables defined along a genome. More specialized containers for representing and manipulating short alignments against a reference genome, or a matrix-like summarization of an experiment, are defined in the GenomicAlignments and SummarizedExperiment packages, respectively. Both packages build on top of the GenomicRanges infrastructure.","addition_date":"2017-01-17T14:58:16Z","last_update_date":"2026-08-31T21:26:43.898537Z","tool_type":["Command-line tool","Library"],"version":["1.64.0"],"collections":["BioConductor"],"biotools_curie":"biotools:genomicfeatures","credit":[{"name":"Dan Tenenbaum","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Daniel van Twisk","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Herv\u00e9 Pag\u00e8s","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Kayla Morrell","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Lori Shepherd","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Marcel Ramos","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Martin Morgan","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Michael Lawr