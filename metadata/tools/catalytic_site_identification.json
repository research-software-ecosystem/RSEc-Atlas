{"tool_name":"catalytic_site_identification","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"catalytic_site_identification","home":"https://catsid.llnl.gov/","license":"Other","summary":"Provides the ability to find structural matches to a user-specified catalytic site among all Protein Data Bank (PDB) proteins. The web server can also examine a user-specified protein to identify structural matches to a library of catalytic sites.","addition_date":"2017-03-25T17:09:53Z","last_update_date":"2024-11-24T21:04:19.323018Z","tool_type":["Command-line tool","Web application"],"accessibility":"Open access","biotools_curie":"biotools:catalytic_site_identification","cost":"Free of charge","credit":[{"email":"kirshner1@llnl.gov","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Protein binding site prediction","uri":"http://edamontology.org/operation_2575"},{"term":"Protein identification","uri":"http://edamontology.org/operation_3767"},{"term":"Protein modelling","uri":"http://edamontology.org/operation_0477"},{"term":"Protein structural motif recognition","uri":"http://edamontology.org/operation_0245"},{"term":"Protein structure comparison","uri":"http://edamontology.org/operation_2487"}]}],"maturity":"Mature","name":"Catalytic Site Identification","operating_system":["Linux","Mac"],"owner":"ELIXIR-EE","publication":[{"doi":"10.1093/nar/gkt403","metadata":{"abstract":"The catalytic site identification web server provides the innovative capability to find structural matches to a user-specified catalytic site among all Protein Data Bank proteins rapidly (in less than a minute). The server also can examine a user-specified protein structure or model to identify structural matches to a library of catalytic sites. Finally, the server provides a database of pre-calculated matches between all Protein Data Bank proteins and the library of catalytic sites. The database has been used to derive a set of hypothesized novel enzymatic function annotations. In all cases, matches and putative binding sites (protein structure and surfaces) can be visualized interactively online. The website can be accessed at http://catsid.llnl.gov.","authors":[{"name":"Kirshner D.A."},{"name":"Lightstone F.C."},{"name":"Nilmeier J.P."}],"citationCount":23,"date":"2013-01-01T00:00:00Z","journal":"Nucleic acids research","title":"Catalytic site identification--a web server to identify catalytic site structural matches throughout PDB."},"pmcid":"PMC3692059","pmid":"23680785"}],"topic":[{"term":"Protein binding sites","uri":"http://edamontology.org/topic_3534"},{"term":"Protein folds and structural domains","uri":"http://edamontology.org/topic_0736"},{"term":"Protein structural motifs and surfaces","uri":"http://edamontology.org/topic_0166"},{"term":"Protein structure analysis","uri":"http://edamontology.org/topic_2814"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"}]},"bioschemas":{"name":"Catalytic Site Identification","home":"https://bio.tools/catalytic_site_identification","license":"Other","summary":"Provides the ability to find structural matches to a user-specified catalytic site among all Protein Data Bank (PDB) proteins. The web server can also examine a user-specified protein to identify structural matches to a library of catalytic sites.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:catalytic_site_identification/cmd/catsid.llnl.gov","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":14,"citations":[{"count":1,"year":"2020"},{"count":1,"year":"2021"},{"count":2,"year":"2014"},{"count":2,"year":"2015"},{"count":2,"year":"2016"},{"count":2,