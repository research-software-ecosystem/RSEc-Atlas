{"tool_name":"tassel","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"tassel","identifiers":["biotools:tassel","doi:10.1093/bioinformatics/btm308"],"license":"LGPL-2.1","summary":"Tassel is a software package to evaluate traits associations, evolutionary patterns, and linkage disequilibrium.","home_url":"http://www.maizegenetics.net/tassel","keywords":["Chromosome Mapping","DNA Mutational Analysis","Data Interpretation, Statistical","Genetic Variation","Linkage Disequilibrium","Quantitative Trait Loci","GWAS study","Mapping","Whole genome sequencing","Genetics"],"manually_check":true,"total_pulls":0},"biotools":{"id":"tassel","home":"http://www.maizegenetics.net/tassel","license":"LGPL-2.1","summary":"Software package to evaluate traits associations, evolutionary patterns, and linkage disequilibrium.","addition_date":"2017-08-20T15:59:14Z","last_update_date":"2024-11-24T20:23:52.165977Z","tool_type":["Command-line tool","Desktop application"],"collections":["Animal and Crop Genomics"],"biotools_curie":"biotools:tassel","credit":[{"email":"tassel@googlegroups.com","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"https://bitbucket.org/tasseladmin/tassel-5-source/wiki/UserManual"}],"edit_permission":{"authors":["animalandcropgenomics"],"type":"group"},"function":[{"operation":[{"term":"Linkage analysis","uri":"http://edamontology.org/operation_0283"},{"term":"Linkage disequilibrium calculation","uri":"http://edamontology.org/operation_0488"}]}],"name":"TASSEL","operating_system":["Linux","Mac","Windows"],"owner":"admin","publication":[{"doi":"10.1093/bioinformatics/btm308","metadata":{"abstract":"Summary: Association analyses that exploit the natural diversity of a genome to map at very high resolutions are becoming increasingly important. In most studies, however, researchers must contend with the confounding effects of both population and family structure. TASSEL (Trait Analysis by aSSociation, Evolution and Linkage) implements general linear model and mixed linear model approaches for controlling population and family structure. For result interpretation, the program allows for linkage disequilibrium statistics to be calculated and visualized graphically. Database browsing and data importation is facilitated by integrated middleware. Other features include analyzing insertions/deletions, calculating diversity statistics, integration of phenotypic and genotypic data, imputing missing data and calculating principal components. \u00a9 2007 The Author(s).","authors":[{"name":"Bradbury P.J."},{"name":"Buckler E.S."},{"name":"Casstevens T.M."},{"name":"Kroon D.E."},{"name":"Ramdoss Y."},{"name":"Zhang Z."}],"citationCount":5576,"date":"2007-10-01T00:00:00Z","journal":"Bioinformatics","title":"TASSEL: Software for association mapping of complex traits in diverse samples"},"pmid":"17586829","type":["Primary"]}],"topic":[{"term":"GWAS study","uri":"http://edamontology.org/topic_3517"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"}],"validated":1},"bioschemas":{"name":"TASSEL","home":"https://bio.tools/tassel","license":"LGPL-2.1","summary":"Software package to evaluate traits associations, evolutionary patterns, and linkage disequilibrium.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:tassel/app/www.maizegenetics.net","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":false,"license":null,"public":true,"readme":false,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":3899,"citations":[{"count":