{"tool_name":"unwords","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"unwords","home":"http://www.zbh.uni-hamburg.de/forschung/arbeitsgruppe-genominformatik/software/unwords.html","summary":"An efficient software for computing shortest strings which do not occur in a given set of DNA sequences. It is more efficient than previous algorithms and easier to use. It uses bit vector encoding of strings and therefore we called it unwords-bits. It directly computes unwords without the need to specify a length estimate. Moreover, it avoids the space requirements of index structures such as suffix trees and suffix arrays.","addition_date":"2017-12-18T00:13:56Z","last_update_date":"2024-11-25T15:32:23.463828Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:unwords","credit":[{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.zbh.uni-hamburg.de/kurtz"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genome indexing","uri":"http://edamontology.org/operation_3211"}]}],"name":"UNWORDS","operating_system":["Linux"],"owner":"mbs_import","publication":[{"doi":"10.1186/1471-2105-9-167","pmcid":"PMC2375138","pmid":"18366790","type":["Primary"]}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"bioschemas":{"name":"UNWORDS","home":"https://bio.tools/unwords","summary":"An efficient software for computing shortest strings which do not occur in a given set of DNA sequences. It is more efficient than previous algorithms and easier to use. It uses bit vector encoding of strings and therefore we called it unwords-bits. It directly computes unwords without the need to specify a length estimate. Moreover, it avoids the space requirements of index structures such as suffix trees and suffix arrays.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/b