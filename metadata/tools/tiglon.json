{"tool_name":"tiglon","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"tiglon","home":"https://github.com/yutingsdu/Tiglon-v.1.1.git","license":"GPL-3.0","summary":"Tiglon enables accurate transcriptome assembly via integrating mappings of different aligners.","addition_date":"2022-07-14T09:25:28.409939Z","last_update_date":"2024-11-24T15:55:18.277687Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:tiglon","cost":"Free of charge","credit":[{"email":"yutingsdu@163.com","name":"Ting Yu","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"Xiaoyu Zhao","orcidid":"https://orcid.org/0000-0001-7626-0907"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genome assembly","uri":"http://edamontology.org/operation_0525"},{"term":"Mapping","uri":"http://edamontology.org/operation_2429"},{"term":"Mapping assembly","uri":"http://edamontology.org/operation_0523"},{"term":"Transcriptome assembly","uri":"http://edamontology.org/operation_3258"}]}],"name":"Tiglon","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1016/j.isci.2022.104067","metadata":{"abstract":"Full-length transcript reconstruction has a pivotal role in RNA-seq data analysis. In this research, we present a new genome-guided transcriptome assembly algorithm, namely Tiglon, which integrates multiple alignments of different mapping tools and builds the labeled splice graphs, followed by a label-based dynamic path-searching strategy to reconstruct the transcripts. We evaluate Tiglon on a simulated dataset and 12 real datasets under the Hisat2 and Star mappings. The results indicate that the integrating techniques of Tiglon exhibit great superiority over the state-of-the-art assemblers, including StringTie2 and Scallop, depending on Hisat2 alignments, Star alignments, or the merged alignments of both. Especially, Tiglon is significantly powerful in recovering lowly expressed transcripts.","authors":[{"name":"Yu T."},{"name":"Zhao X."}],"citationCount":1,"date":"2022-04-15T00:00:00Z","journal":"iScience","title":"Tiglon enables accurate transcriptome assembly via integrating mappings of different aligners"},"pmcid":"PMC8958329","pmid":"35355524"}],"topic":[{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"Tiglon","home":"https://bio.tools/tiglon","license":"GPL-3.0","summary":"Tiglon enables accurate transcriptome assembly via integrating mappings of different aligners.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:tiglon/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":false,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1016/j.isci.2022.104067","pmcid":"PMC8958329","pmid":"35355524","ref_count":37,"refs":[{"count":1,"year":"2017"},{"count":1,"year":"2021"},{"count":2,"year":"2011"},{"count":2,"year":"2012"},{"count":2,"year":"2014"},{"count":3,"year":"2015"},{"count":3,"year":"2019"},{"count":3,"year":"2020"},{"count":4,"year":"2013"},{"count":5,"year":"2010"},{"count":5,"year":"2016"},{"count":6,"year":"2009"}],"title":"Tiglon enables accurate transcriptome assembly via integrating mappings of different aligners.","year":2022}]}],"rea