y875","metadata":{"abstract":"Motivation: Linkage disequilibrium (LD) decay is of great interest in population genetic studies. However, no tool is available now to do LD decay analysis from variant call format (VCF) files directly. In addition, generation of pair-wise LD measurements for whole genome SNPs usually resulting in large storage wasting files. Results: We developed PopLDdecay, an open source software, for LD decay analysis from VCF files. It is fast and is able to handle large number of variants from sequencing data. It is also storage saving by avoiding exporting pair-wise results of LD measurements. Subgroup analyses are also supported. Availability and implementation: PopLDdecay is freely available at https://github.com/BGI-shen zhen/PopLDdecay.","authors":[{"name":"Dong S.-S."},{"name":"He W.-M."},{"name":"Xu J.-Y."},{"name":"Yang T.-L."},{"name":"Zhang C."}],"citationCount":876,"date":"2019-05-15T00:00:00Z","journal":"Bioinformatics","title":"PopLDdecay: A fast and effective tool for linkage disequilibrium decay analysis based on variant call format files"},"pmid":"30321304","type":["Primary"]}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"bioschemas":{"name":"PopLDdecay","home":"https://bio.tools/PopLDdecay","license":"MIT","summary":"Tool for linkage disequilibrium decay analysis based on variant call format files.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:poplddecay/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"an