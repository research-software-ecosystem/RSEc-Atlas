{"tool_name":"esatac","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-esatac","version":"1.32.0","home":"https://bioconductor.org/packages/3.22/bioc/html/esATAC.html","license":"GPL-3 | file LICENSE","summary":"An Easy-to-use Systematic pipeline for ATACseq data analysis","identifiers":["biotools:esATAC"],"description":"This package provides a framework and complete preset pipeline for quantification and analysis of ATAC-seq Reads. It covers raw sequencing reads preprocessing (FASTQ files), reads alignment (Rbowtie2), aligned reads file operations (SAM, BAM, and BED files), peak calling (F-seq), genome annotations (Motif, GO, SNP analysis) and quality control report. The package is managed by dataflow graph. It is easy for user to pass variables seamlessly between processes and understand the workflow. Users can process FASTQ files through end-to-end preset pipeline which produces a pretty HTML report for quality control and preliminary statistical results, or customize workflow starting from any intermediate stages with esATAC functions easily and flexibly.","license_file":"LICENSE","build":{"number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"build":[null,null,"make"],"host":["bioconductor-annotationdbi >=1.72.0,<1.73.0","bioconductor-biocgenerics >=0.56.0,<0.57.0","bioconductor-biostrings >=2.78.0,<2.79.0","bioconductor-bsgenome >=1.78.0,<1.79.0","bioconductor-chipseeker >=1.46.0,<1.47.0","bioconductor-clusterprofiler >=4.18.0,<4.19.0","bioconductor-genomicalignments >=1.46.0,<1.47.0","bioconductor-genomicfeatures >=1.62.0,<1.63.0","bioconductor-genomicranges >=1.62.0,<1.63.0","bioconductor-iranges >=2.44.0,<2.45.0","bioconductor-jaspar2018 >=1.1.0,<1.2.0","bioconductor-motifmatchr >=1.32.0,<1.33.0","bioconductor-pipeframe >=1.26.0,<1.27.0","bioconductor-rbowtie2 >=2.16.0,<2.17.0","bioconductor-rsamtools >=2.26.0,<2.27.0","bioconductor-rtracklayer >=1.70.0,<1.71.0","bioconductor-s4