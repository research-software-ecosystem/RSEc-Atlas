{"tool_name":"pintail","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"pintail","home":"http://www.softpedia.com/get/Science-CAD/Pintail.shtml","summary":"Program for detecting and analysing 16S rRNA chimeras and other anomalies. Pintail is a tool for identifying anomalies, including chimeras, within 16S rDNA sequences. The program works by comparing evolutionary distances between a query and subject sequence over the length of the 16S rRNA gene (small subunit rRNA), by employing a sampling window of specified size, progressing a fixed number of bases at a time along the length of the gene.","addition_date":"2017-12-18T00:11:02Z","last_update_date":"2018-12-10T12:58:54Z","tool_type":["Desktop application"],"version":["1.1"],"biotools_curie":"biotools:pintail","credit":[{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.medicine.cardiff.ac.uk/person/kevin-ashelford/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"}]}],"name":"Pintail","operating_system":["Windows"],"owner":"mbs_import","topic":[{"term":"RNA","uri":"http://edamontology.org/topic_0099"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pintail:1.1/app/www.softpedia.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":0,"citations":[],"ref_count":0,"refs":[]}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":403,"redirects":[{"status":301,"url":"https://www.softpedia.com/get/Science-CAD/Pintail.shtml"}],"ssl":true,"ssl_err":null}},"support":{"email":false}},{"@id":"https://openebench.bsc.es/m