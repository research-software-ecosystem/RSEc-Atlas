{"tool_name":"coreprofiler","contents":["galaxy","oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"coreprofiler","home":"https://gitlab.com/ifb-elixirfr/abromics/coreprofiler","summary":"CoreProfiler is a cgMLST (core genome multilocus sequence typing) software that identifies alleles in bacterial genome assemblies by comparing them to a reference allele scheme. It detects both exact matches to known alleles and potential novel alleles using a two-step BLAST-based approach, enabling robust and reproducible strain genotyping.","addition_date":"2025-04-08T08:17:22.895529Z","last_update_date":"2025-06-25T07:31:27.919999Z","version":["1.1.1"],"biotools_curie":"biotools:coreprofiler","documentation":[{"type":["General"],"url":"https://gitlab.com/ifb-elixirfr/abromics/coreprofiler/-/blob/main/README.md?ref_type=heads"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Multilocus sequence typing","uri":"http://edamontology.org/operation_3840"}]}],"name":"CoreProfiler","owner":"clsiguret","publication":[{"doi":"10.5281/ZENODO.8282656"},{"doi":"10.1016/S0022-2836(05)80360-2","metadata":{"abstract":"A new approach to rapid sequence comparison, basic local alignment search tool (BLAST), directly approximates alignments that optimize a measure of local similarity, the maximal segment pair (MSP) score. Recent mathematical results on the stochastic properties of MSP scores allow an analysis of the performance of this method as well as the statistical significance of alignments it generates. The basic algorithm is simple and robust; it can be implemented in a number of ways and applied in a variety of contexts including straight-forward DNA and protein sequence database searches, motif searches, gene identification searches, and in the analysis of multiple regions of similarity in long DNA sequences. In addition to its flexibility and tractability to mathematical analysis, BLAST is an order of magnitude faster than existing sequence comparison tools of comparable sensitivity. \u00a9 1990, Academic Press Limited. All rights reserved.","authors":[{"name":"Altschul S.F."},{"name":"Gish W."},{"name":"Lipman D.J."},{"name":"Miller W."},{"name":"Myers E.W."}],"citationCount":80157,"date":"1990-01-01T00:00:00Z","journal":"Journal of Molecular Biology","title":"Basic local alignment search tool"}}],"topic":[{"term":"Bioinformatics","uri":"http://edamontology.org/topic_0091"},{"term":"Microbiology","uri":"http://edamontology.org/topic_3301"},{"term":"Phylogenetics","uri":"http://edamontology.org/topic_3293"}]},"bioschemas":{"name":"CoreProfiler","home":"https://bio.tools/coreprofiler","version":"1.1.1","summary":"CoreProfiler is a cgMLST (core genome multilocus sequence typing) software that identifies alleles in bacterial genome assemblies by comparing them to a reference allele scheme. It detects both exact matches to known alleles and potential novel alleles using a two-step BLAST-based approach, enabling robust and reproducible strain genotyping.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"2.0.0","first_commit":"2025-07-22","conda_name":"coreprofiler","conda_version":"2.0.0","summary":"CoreProfiler, a tool for cgMLST allele calling from bacterial genome assemblies","edam_operations":["Multilocus sequence typing"],"edam_topics":["Microbiology","Bioinformatics","Phylogenetics"],"toolshed_categories":["Variant Analysis"],"toolshed_id":"coreprofiler","users_5_years":0,"users_all_time":0,"usage_5_years":0,"usage_all_time":0,"bio_tools_summary":"CoreProfiler is a cgMLST (core genome multilocus sequence typing) software that identifies alleles in bacterial genome assemblies by comparing them to a reference allele scheme. It detects both exact matches to known alleles and potential novel alleles using a two-step BLAST-based approach, enabling robust and reproducible strain genotyping.","bio_tools_ids":"coreprofiler","bio_tools_name":"CoreProfiler","related_tutorials":[],"related_workflows":[{"crea