{"tool_name":"netge2-plus","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"netge2-plus","home":"http://net-ge2.biocomp.unibo.it","license":"Not licensed","summary":"Network-based enrichment analysis of gene sets.","addition_date":"2020-07-07T10:45:11Z","last_update_date":"2024-11-24T14:11:39.927303Z","tool_type":["Web application"],"version":["2.0"],"collections":["Bologna Biocomputing Group"],"accessibility":"Open access","biotools_curie":"biotools:netge2-plus","cost":"Free of charge","credit":[{"email":"pierluigi.martelli@unibo.it","name":"Pier Luigi Martelli","typeEntity":"Person","typeRole":["Maintainer","Primary contact","Support"]},{"email":"samuele.bovo@unibo.it","name":"Samuele Bovo","typeEntity":"Person","typeRole":["Developer","Maintainer","Primary contact"]},{"name":"ELIXIR-ITA-BOLOGNA","typeEntity":"Institute","typeRole":["Provider","Support"]}],"documentation":[{"type":["General"],"url":"http://net-ge2.biocomp.unibo.it/enrich/default/tutorial"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"UniProt accession","uri":"http://edamontology.org/data_3021"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}],"operation":[{"term":"Enrichment analysis","uri":"http://edamontology.org/operation_3501"},{"term":"Pathway visualisation","uri":"http://edamontology.org/operation_3926"}],"output":[{"data":{"term":"GO concept ID","uri":"http://edamontology.org/data_1176"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"},{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]},{"data":{"term":"Pathway ID (KEGG)","uri":"http://edamontology.org/data_2343"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"},{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]},{"data":{"term":"Pathway ID (reactome)","uri":"http://edamontology.org/data_1155"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"},{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]},{"data":{"term":"Pathway or network","uri":"http://edamontology.org/data_2600"},"format":[{"term":"Image format","uri":"http://edamontology.org/format_3547"},{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]},{"data":{"term":"Taxonomy","uri":"http://edamontology.org/data_3028"},"format":[{"term":"XML","uri":"http://edamontology.org/format_2332"}]}]}],"maturity":"Mature","name":"NETGE-PLUS","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-ITA-BOLOGNA","publication":[{"doi":"10.1021/acs.jproteome.9b00749","metadata":{"abstract":"Omics techniques provide a spectrum of information at the genomic level, whose analysis can characterize complex traits at a molecular level. The relationship among genotype and phenotype implies that from genome information the molecular pathways and biological processes underlying a given phenotype are discovered. In dealing with this problem, gene enrichment analysis has become the most widely adopted strategy. Here we present NETGE-PLUS, a Web server for standard and network-based functional interpretation of gene sets of human and of model organisms, including Sus scrofa, Saccharomyces cerevisiae, Escherichia coli, and Arabidopsis thaliana. NETGE-PLUS enables the functional enrichment of both simple and ranked lists of genes, introducing also the possibility of exploring relationships among KEGG pathways. A Web interface makes data retrieval complete and user-friendly. NETGE-PLUS is publicly available at http://net-ge2.biocomp.unibo.it.","authors":[{"name":"Bovo S."},{"name":"Casadio R."},{"name":"Di Lena P."},{"name":"Martelli P.L."}],"citationCount":3,"date":"2020-07-02T00:00:00Z","journal":"Journal of Proteome Research","title":"NETGE-PLUS: Standard and Network-Based Gene Enrichment Analysis in Human and Model Organisms"},"pmid":"31971806","type":["Primary"]}],"topic":[{"term":"Function analysis","uri":"http://edamontology.org/topic_1775"}]},"bioschemas":{"name":"NETGE-PLUS","home":"https://bio.tools/netge2-plus","license":"Not licensed","version":"2.0","summary":"Network-based enrichment analysis of gene sets.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:netge2-plus:2.0/web/net-ge2.biocomp.unibo.it","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1021/acs.jproteome.9b00749","pmid":"31971806","ref_count":0,"refs":[],"title":"NETGE-PLUS: Standard and Network-Based Gene Enrichment Analysis in Human and Model Organisms.","year":2020}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":303,"redirects":[{"status":302,"url":"https://net-ge2.biocomp.unibo.it/enrich"}],"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:netge2-plus:1.1.0/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":1430,"citations":[{"count":2,"year":"2014"},{"count":5,"year":"-1"},{"count":22,"year":"2015"},{"count":45,"year":"2017"},{"count":46,"year":"2016"},{"count":57,"year":"2018"},{"count":63,"year":"2019"},{"count":93,"year":"2020"},{"count":140,"year":"2021"},{"count":165,"year":"2022"},{"count":165,"year":"2023"},{"count":173,"year":"2026"},{"count":212,"year":"2024"},{"count":242,"ye