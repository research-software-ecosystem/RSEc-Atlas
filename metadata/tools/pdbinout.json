{"tool_name":"pdbinout","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"pdbinout","home":"http://pdbinout.ibch.poznan.pl/","summary":"Open-source, Python-based tool for processing and conversion of various versions of PDB file format for biostructural applications.","addition_date":"2017-08-03T18:53:52Z","last_update_date":"2018-12-10T12:58:49Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:pdbinout","credit":[{"email":"adamiakr@ibch.poznan.pl","name":"Adamiak RW","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.ibch.poznan.pl/adamiak/staff/wozniak_tomasz.html"}],"documentation":[{"type":["User manual"],"url":"http://pdbinout.ibch.poznan.pl/tutorial.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Data handling","uri":"http://edamontology.org/operation_2409"}]}],"name":"PDBinout","operating_system":["Linux","Mac","Windows"],"owner":"mbs_import","publication":[{"metadata":{"abstract":"PDB format is most commonly applied by various programs to define three-dimensional structure of biomolecules. However, the programs often use different versions of the format. Thus far, no comprehensive solution for unifying the PDB formats has been developed. Here we present an open-source, Python-based tool called PDBinout for processing and conversion of various versions of PDB file format for biostructural applications. Moreover, PDBinout allows to create one's own PDB versions. PDBinout is freely available under the LGPL licence at http://pdbinout.ibch.poznan.pl.","authors":[{"name":"Adamiak R.W."},{"name":"Wozniak T."}],"date":"2013-01-01T00:00:00Z","journal":"Acta Biochimica Polonica","title":"Personalization of structural PDB files"},"pmid":"24350306"}],"topic":[{"term":"Data management","uri":"http://edamontology.org/topic_3071"},{"term":"Protein structure analysis","uri":"http://edamontology.org/topic_2814"},{"term":"Structural biology","uri":"http://edamontology.org/topic_1317"}],"validat