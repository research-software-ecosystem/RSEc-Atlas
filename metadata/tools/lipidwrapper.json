{"tool_name":"lipidwrapper","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"lipidwrapper","home":"http://rocce-vm0.ucsd.edu/data/sw/hosted/lipidwrapper/","summary":"An Algorithm for Generating Large-Scale Membrane Models of Arbitrary Geometry.","addition_date":"2018-05-21T15:24:21Z","last_update_date":"2018-12-10T12:58:58Z","tool_type":["Desktop application","Library"],"biotools_curie":"biotools:lipidwrapper","credit":[{"email":"ramaro@ucsd.edu","name":"Rommie E. Amaro","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://rocce-vm0.ucsd.edu/data/sw/hosted/lipidwrapper/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Protein modelling","uri":"http://edamontology.org/operation_0477"},{"term":"Transmembrane protein analysis","uri":"http://edamontology.org/operation_0270"}]}],"name":"LipidWrapper","operating_system":["Linux","Mac","Windows"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1371/JOURNAL.PCBI.1003720","metadata":{"abstract":"As ever larger and more complex biological systems are modeled in silico, approximating physiological lipid bilayers with simple planar models becomes increasingly unrealistic. In order to build accurate large-scale models of subcellular environments, models of lipid membranes with carefully considered, biologically relevant curvature will be essential. In the current work, we present a multi-scale utility called LipidWrapper capable of creating curved membrane models with geometries derived from various sources, both experimental and theoretical. To demonstrate its utility, we use LipidWrapper to examine an important mechanism of influenza virulence. A copy of the program can be downloaded free of charge under the terms of the open-source FreeBSD License from http://nbcr.ucsd.edu/lipidwrapper. LipidWrapper has been tested on all major computer operating systems. \u00a9 2014 Durrant, Amaro.","authors":[{"name":"Amaro R.E."},{"name":"Durrant J.D."}],"citationCount":26,"date":"2014-01-01T00:00:00Z","journal":"PLoS Computational Biology","title":"LipidWrapper: An Algorithm for Generating Large-Scale Membrane Models of Arbitrary Geometry"},"pmcid":"PMC4102414","pmid":"25032790"}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Computational biology","uri":"http://edamontology.org/topic_3307"},{"term":"Membrane and lipoproteins","uri":"http://edamontology.org/topic_0820"},{"term":"Protein structural motifs and surfaces","uri":"http://edamontology.org/topic_0166"}],"validated":1},"bioschemas":{"name":"LipidWrapper","home":"https://bio.tools/lipidwrapper","summary":"An Algorithm for Generating Large-Scale Membrane Models of Arbitrary Geometry.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:lipidwrapper/app/rocce-vm0.ucsd.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":52,"citations":[{"count":2,"year":"2015"},{"count":2,"year":"2016"},{"count":2,"year":"2020"},{"count":2,"year":"2023"},{"count":2,"year":"2026"},{"count":4,"year":"2017"},{"count":4,"year":"2019"},{"count":5,"year":"2018"},{"count":6,"year":"2021"},{"count":6,"year":"2025"},{"count":8,"year":"2024"},{"count":9,"year":"2022"}],"doi":"10.1371/journal.pcbi.1003720","pmcid":"PMC4102414","pmid":"25032790","ref_count":82,"refs":[{"count":1,"year":"1966"},{"count":1,"year":"1971"},{"count":1,"year":"1985"},{"count":1,"year":"1993"},{"count":1,"year":"1996"},{"count":1,"year":"1998"},{"count":1,"year":"2001"},{"count":1,"year":"2002"},{"count":1,"year":"2003"},{"count":1,"year":"2004"},{"count":2,"year":"-1"},{"count":2,"year":"2000"},{"count":2,"year":"2005"},{"count":2,"year":"2007"},{"count":3,"ye