[{"status":303,"url":"https://cran.r-project.org/web/packages/imputeLCMD/index.html"}],"ssl":true,"ssl_err":null}}}]},"bioconda":{"name":"r-imputelcmd","version":"2.1","home":"https://CRAN.R-project.org/package=imputeLCMD","license":"GPL-2.0-or-later","summary":"The package contains a collection of functions for left-censored missing data imputation. Left-censoring is a special case of missing not at random (MNAR)  mechanism that generates non-responses in proteomics experiments. The package also contains functions to artificially generate peptide/protein expression data (log-transformed) as random draws from a multivariate Gaussian distribution as well as a function to generate missing data (both randomly and non-randomly). For comparison reasons, the package also contains several wrapper functions for the imputation of non-responses that are missing at random. * New functionality has been added: a hybrid method that allows the imputation of missing values in a more complex scenario where the missing data are both MAR and MNAR.","license_file":"/lib/R/share/licenses/GPL-2","build":{"merge_build_host":true,"noarch":"generic","number":4,"rpaths":["lib/R/lib/","lib/"],"run_exports":[""]},"requirements":{"build":null,"host":["r-base","r-tmvtnorm","r-norm","bioconductor-pcamethods","bioconductor-impute"],"run":["r-base","r-tmvtnorm","r-norm","bioconductor-pcamethods","bioconductor-impute"]},"source_url":["/src/contrib/imputeLCMD_2.1.tar.gz","/src/contrib/Archive/imputeLCMD/imputeLCMD_2.1.tar.gz"],"test":{"commands":["$R -e \"library('imputeLCMD')\"","\"%R%\" -e \"library('imputeLCMD')\""]}}}}