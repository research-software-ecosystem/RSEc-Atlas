{"tool_name":"qsr","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"qsr","home":"https://github.com/cisselab/qSR","license":"CC-BY-4.0","summary":"Software package for quantitative analysis of single molecule localization microscopy data in live and fixed cells.","addition_date":"2018-07-11T14:57:05Z","last_update_date":"2024-11-25T14:32:38.017849Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:qsr","credit":[{"name":"I. I. Ciss\u00e9","typeEntity":"Person","typeRole":["Primary contact"],"url":"https://www.nature.com/articles/s41598-018-25454-0/email/correspondent/c1/new"}],"documentation":[{"type":["User manual"],"url":"https://github.com/cisselab/qSR/blob/master/qSR_Users_Guide.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Image analysis","uri":"http://edamontology.org/operation_3443"}]}],"name":"qSR","operating_system":["Linux"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1038/s41598-018-25454-0","metadata":{"abstract":"We present qSR, an analytical tool for the quantitative analysis of single molecule based super-resolution data. The software is created as an open-source platform integrating multiple algorithms for rigorous spatial and temporal characterizations of protein clusters in super-resolution data of living cells. First, we illustrate qSR using a sample live cell data of RNA Polymerase II (Pol II) as an example of highly dynamic sub-diffractive clusters. Then we utilize qSR to investigate the organization and dynamics of endogenous RNA Polymerase I (Pol I) in live human cells, throughout the cell cycle. Our analysis reveals a previously uncharacterized transient clustering of Pol I. Both stable and transient populations of Pol I clusters co-exist in individual living cells, and their relative fraction vary during cell cycle, in a manner correlating with global gene expression. Thus, qSR serves to facilitate the study of protein organization and dynamics with very high spatial and temporal resolutions directly in live cell.","authors":[{"name":"Andrews J.O."},{"name":"Cho W.-K."},{"name":"Cisse I.I."},{"name":"Conway W."},{"name":"Inoue T."},{"name":"Jayanth N."},{"name":"Mullen S."},{"name":"Narayanan A."},{"name":"Spille J.-H."},{"name":"Thaler J."}],"citationCount":24,"date":"2018-12-01T00:00:00Z","journal":"Scientific Reports","title":"QSR: A quantitative super-resolution analysis tool reveals the cell-cycle dependent organization of RNA Polymerase i in live human cells"},"pmcid":"PMC5943247","pmid":"29743503"}],"topic":[{"term":"Biological imaging","uri":"http://edamontology.org/topic_3383"},{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"RNA","uri":"http://edamontology.org/topic_0099"}],"validated":1},"bioschemas":{"name":"qSR","home":"https://bio.tools/qsr","license":"CC-BY-4.0","summary":"Software package for quantitative analysis of single molecule localization microscopy data in live and fixed cells.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:qsr/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":false,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":21,"citations":[{"count":1,"year":"2019"},{"count":1,"year":"2023"},{"count":1,"year":"2025"},{"count":1,"year":"2026"},{"count":2,"year":"2018"},{"count":2,"year":"2024"},{"count":3,"year":"2021"},{"count":4,"year":"2020"},{"count":6,"year":"2022"}],"doi":"10.1038/s41598-018-25454-0","pmcid":"PMC5943247","pmid":"29743503","ref_count":56,"refs":[{"count":1,"year"