{"tool_name":"hide-deconv","contents":["biotools"],"fetched_metadata":{"biotools":{"id":"hide-deconv","home":"https://github.com/dvoelkl/HIDE-deconv","license":"MIT","summary":"HIDE-Deconv is a framework for characterizing cellular remodeling from bulk RNA-seq data using hierarchical cell-type deconvolution across multiple levels of cellular resolution. It provides an integrated workflow for single-cell reference preprocessing, estimation of cellular compositions, and downstream analysis of deconvolution results, including visualization, clustering, differential composition, and survival analysis.","addition_date":"2026-09-17T08:40:26.496395Z","last_update_date":"2026-09-17T08:45:55.954777Z","tool_type":["Command-line tool","Library"],"accessibility":"Open access","biotools_curie":"biotools:hide-deconv","cost":"Free of charge","credit":[{"email":"Franziska.Gortler@uib.no","name":"Franziska G\u00f6rtler","orcidid":"https://orcid.org/0000-0003-2015-5766","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"dennis.k.volkl@uib.no","name":"Dennis Voelkl","orcidid":"https://orcid.org/0009-0001-9550-8434","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://github.com/dvoelkl/HIDE-deconv/blob/main/docs/Userguide.md"}],"edit_permission":{"type":"public"},"function":[{"cmd":"`hide-deconv run`","input":[{"data":{"term":"Count matrix","uri":"http://edamontology.org/data_3917"},"format":[{"term":"CSV","uri":"http://edamontology.org/format_3752"}]},{"data":{"term":"Count matrix","uri":"http://edamontology.org/data_3917"},"format":[{"term":"HDF5","uri":"http://edamontology.org/format_3590"}]}],"note":"Run the HIDE-Deconv guided deconvolution workflow.","operation":[{"term":"Dimensionality reduction","uri":"http://edamontology.org/operation_3935"}],"output":[{"data":{"term":"Matrix","uri":"http://edamontology.org/data_2082"}}]},{"cmd":"`hide-deconv analyze diff`","note":"Perform statistical tests on the cellular compositions, to find differences between different cohorts.","operation":[{"term":"Statistical calculation","uri":"http://edamontology.org/operation_2238"}],"output":[{"data":{"term":"Report","uri":"http://edamontology.org/data_2048"}}]},{"cmd":"\u00b4hide-deconv analyze hdiff`","note":"Perform statistical tests between two cohorts and visualize the differences at different cell type annotation layers.","operation":[{"term":"Statistical calculation","uri":"http://edamontology.org/operation_2238"}],"output":[{"data":{"term":"Image","uri":"http://edamontology.org/data_2968"}},{"data":{"term":"Report","uri":"http://edamontology.org/data_2048"}}]}],"maturity":"Emerging","name":"HIDE-Deconv","operating_system":["Linux","Mac","Windows"],"owner":"dennis3","publication":[{"doi":"10.64898/2026.08.24.746754","type":["Preprint"],"version":"0.1.0"}],"topic":[{"term":"Bioinformatics","uri":"http://edamontology.org/topic_0091"},{"term":"Computational biology","uri":"http://edamontology.org/topic_3307"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}]}}}