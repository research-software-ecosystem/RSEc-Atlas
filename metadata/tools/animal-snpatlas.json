{"tool_name":"animal-snpatlas","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"animal-snpatlas","home":"http://gong_lab.hzau.edu.cn/Animal_SNPAtlas/","license":"Other","summary":"A SNP database for multiple animals.","addition_date":"2022-12-20T08:56:31.763055Z","last_update_date":"2024-11-24T15:17:19.332874Z","tool_type":["Database portal","Web application"],"biotools_curie":"biotools:animal-snpatlas","cost":"Free of charge","credit":[{"email":"gong.jing@mail.hzau.edu.cn","name":"Jing Gong","typeEntity":"Person"},{"email":"niuxiaoh@mail.hzau.edu.cn","name":"Xiaohui Niu","typeEntity":"Person"},{"email":"xuewen_xu@mail.hzau.edu.cn","name":"Xuewen Xu","typeEntity":"Person"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Imputation","uri":"http://edamontology.org/operation_3557"},{"term":"Linkage disequilibrium calculation","uri":"http://edamontology.org/operation_0488"},{"term":"SNP annotation","uri":"http://edamontology.org/operation_3661"},{"term":"SNP detection","uri":"http://edamontology.org/operation_0484"}]}],"name":"Animal-SNPAtlas","operating_system":["Linux","Mac","Windows"],"owner":"Chan019","publication":[{"doi":"10.1093/nar/gkac954","metadata":{"abstract":"Single-nucleotide polymorphisms (SNPs) as the most important type of genetic variation are widely used in describing population characteristics and play vital roles in animal genetics and breeding. Large amounts of population genetic variation resources and tools have been developed in human, which provided solid support for human genetic studies. However, compared with human, the development of animal genetic variation databases was relatively slow, which limits the genetic researches in these animals. To fill this gap, we systematically identified \u223c499 million high-quality SNPs from 4784 samples of 20 types of animals. On that basis, we annotated the functions of SNPs, constructed high-density reference panels and calculated genome-wide linkage disequilibrium (LD) matrixes. We further developed Animal-SNPAtlas, a user-friendly database (http://gong-lab.hzau.edu.cn/Animal_SNPAtlas/) which includes high-quality SNP datasets and several support tools for multiple animals. In Animal-SNPAtlas, users can search the functional annotation of SNPs, perform online genotype imputation, explore and visualize LD information, browse variant information using the genome browser and download SNP datasets for each species. With the massive SNP datasets and useful tools, Animal-SNPAtlas will be an important fundamental resource for the animal genomics, genetics and breeding community.","authors":[{"name":"Gao Y."},{"name":"Gong J."},{"name":"Jiang G."},{"name":"Jin W."},{"name":"Niu X."},{"name":"Xu X."},{"name":"Yang W."}],"citationCount":8,"date":"2023-01-06T00:00:00Z","journal":"Nucleic Acids Research","title":"Animal-SNPAtlas: a comprehensive SNP database for multiple animals"},"pmcid":"PMC9825464","pmid":"36300636"}],"topic":[{"term":"Agricultural science","uri":"http://edamontology.org/topic_3810"},{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Zoology","uri":"http://edamontology.org/topic_3500"}],"validated":1},"bioschemas":{"name":"Animal-SNPAtlas","home":"https://bio.tools/animal-snpatlas","license":"Other","summary":"A SNP database for multiple animals.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:animal-snpatlas/db/null","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":16,"citations":[{"count":2,"year":"2023"},{"count"