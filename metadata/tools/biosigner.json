{"tool_name":"biosigner","contents":["biocontainers","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"bioconductor-biosigner","version":"1.38.0","home":"https://bioconductor.org/packages/3.22/bioc/html/biosigner.html","license":"CeCILL","summary":"Signature discovery from omics data","identifiers":["biotools:biosigner","doi:10.3389/fmolb.2016.00026"],"description":"Feature selection is critical in omics data analysis to extract restricted and meaningful molecular signatures from complex and high-dimension data, and to build robust classifiers. This package implements a new method to assess the relevance of the variables for the prediction performances of the classifier. The approach can be run in parallel with the PLS-DA, Random Forest, and SVM binary classifiers. The signatures and the corresponding 'restricted' models are returned, enabling future predictions on new datasets. A Galaxy implementation of the package is available within the Workflow4metabolomics.org online infrastructure for computational metabolomics.","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-biobase >=2.70.0,<2.71.0","bioconductor-multiassayexperiment >=1.36.0,<1.37.0","bioconductor-multidataset >=1.38.0,<1.39.0","bioconductor-ropls >=1.42.0,<1.43.0","bioconductor-summarizedexperiment >=1.40.0,<1.41.0","r-base","r-e1071","r-randomforest"],"run":["bioconductor-biobase >=2.70.0,<2.71.0","bioconductor-multiassayexperiment >=1.36.0,<1.37.0","bioconductor-multidataset >=1.38.0,<1.39.0","bioconductor-ropls >=1.42.0,<1.43.0","bioconductor-summarizedexperiment >=1.40.0,<1.41.0","r-base","r-e1071","r-randomforest"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/biosigner_1.38.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/biosigner/biosigner_1.38.0.tar.gz","https://bioarchive.galaxyproject.org/biosigner_1.38.0.tar.gz","https://depot.galaxy