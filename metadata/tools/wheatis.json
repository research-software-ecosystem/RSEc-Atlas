{"tool_name":"wheatis","contents":["biotools","oeb","bioschemas"],"fetched_metadata":{"biotools":{"id":"WheatIS","home":"https://urgi.versailles.inrae.fr/wheatis/","license":"BSD-3-Clause","summary":"As part of the Wheat Initiative (https://www.wheatinitiative.org/), the WheatIS working group (http://www.wheatis.org/) is developing an international wheat information system to support the wheat research community. \u201cWheatIS Data Discovery\u201d is the web portal that allows users to search for and access wheat data in international databases.\nIt is based on the DataDiscovery tool, which aims to provide researchers with quick and easy access to relevant biological data using specific keywords and filters. This generic tool is easily customizable for specific filters, environments, or data schemas.","addition_date":"2019-11-05T10:40:37Z","last_update_date":"2026-10-12T15:36:02.724346Z","tool_type":["Database portal","Web API","Web application","Web service"],"collections":["URGI","elixir-fr-sdp-2019"],"accessibility":"Open access","biotools_curie":"biotools:WheatIS","cost":"Free of charge","credit":[{"email":"urgi-contact@inrae.fr","name":"URGI","note":"How to cite: https://urgi.versailles.inrae.fr/Platform/How-to-cite","rorid":"04etk8241","typeRole":["Developer","Maintainer","Provider","Support"]}],"documentation":[{"type":["Contributions policy"],"url":"https://forgemia.inra.fr/urgi-is/data-discovery/blob/master/README.md#contribute"},{"type":["Contributions policy"],"url":"https://urgi.versailles.inra.fr/wheatis/join"},{"type":["General"],"url":"https://urgi.versailles.inra.fr/wheatis/about"},{"type":["General"],"url":"https://urgi.versailles.inrae.fr/Data-Services/Data-Access/Federations"},{"type":["Installation instructions"],"url":"https://forgemia.inra.fr/urgi-is/data-discovery/blob/master/README.md#setup"},{"type":["Terms of use"],"url":"https://urgi.versailles.inra.fr/wheatis/legal"},{"type":["User manual"],"url":"https://urgi.versailles.inra.fr/wheatis/h