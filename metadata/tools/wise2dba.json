{"tool_name":"wise2dba","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"wise2dba","home":"http://www.ebi.ac.uk/Tools/psa/wise2dba/","summary":"Align two sequences assuming the sequences share colinear conserved blocks separated by gaps.","addition_date":"2015-01-29T15:47:36Z","last_update_date":"2024-11-24T14:45:46.263310Z","tool_type":["Web application","Web service"],"version":["Retired"],"collections":["EBI Tools"],"biotools_curie":"biotools:wise2dba","credit":[{"name":"EMBL-EBI","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Ewan Birney","typeEntity":"Person","typeRole":["Developer"]},{"name":"Job Dispatcher","typeEntity":"Project","typeRole":["Primary contact"],"url":"https://www.ebi.ac.uk/Tools/jdispatcher/"}],"documentation":[{"type":["General"],"url":"http://www.ebi.ac.uk/Tools/psa/wise2dba/"},{"type":["Terms of use"],"url":"http://www.ebi.ac.uk/about/terms-of-use"}],"edit_permission":{"authors":["biomadeira","nandana"],"type":"group"},"function":[{"input":[{"data":{"term":"Nucleic acid sequence","uri":"http://edamontology.org/data_2977"}}],"operation":[{"term":"Local alignment","uri":"http://edamontology.org/operation_0495"},{"term":"Pairwise sequence alignment","uri":"http://edamontology.org/operation_0491"}],"output":[{"data":{"term":"Sequence alignment (nucleic acid)","uri":"http://edamontology.org/data_1383"}},{"data":{"term":"Sequence alignment (pair)","uri":"http://edamontology.org/data_1381"}}]}],"maturity":"Legacy","name":"Wise2DBA (EBI)","operating_system":["Linux","Mac","Windows"],"owner":"jdispatcher","publication":[{"doi":"10.1093/nar/gkac240","metadata":{"abstract":"The EMBL-EBI search and sequence analysis tools frameworks provide integrated access to EMBL-EBI's data resources and core bioinformatics analytical tools. EBI Search (https://www.ebi.ac.uk/ebisearch) provides a full-text search engine across nearly 5 billion entries, while the Job Dispatcher tools framework (https://www.ebi.ac.uk/services) enables the scientific community to perform a diverse range of sequence analysis using popular bioinformatics applications. Both allow users to interact through user-friendly web applications, as well as via RESTful and SOAP-based APIs. Here, we describe recent improvements to these services and updates made to accommodate the increasing data requirements during the COVID-19 pandemic.","authors":[{"name":"Basutkar P."},{"name":"Edbali O."},{"name":"Kolesnikov A."},{"name":"Lee J."},{"name":"Lopez R."},{"name":"Madeira F."},{"name":"Madhusoodanan N."},{"name":"Pearce M."},{"name":"Tivey A.R.N."}],"citationCount":1248,"date":"2022-07-05T00:00:00Z","journal":"Nucleic Acids Research","title":"Search and sequence analysis tools services from EMBL-EBI in 2022"},"pmcid":"PMC9252731","pmid":"35412617","type":["Other"]},{"doi":"10.1101/gr.9.9.815","metadata":{"abstract":"A data set of 77 genomic mouse/human gene pairs has been compiled from the EMBL nucleotide database, and their corresponding features determined. This set was used to analyze the degree of conservation of noncoding sequences between mouse and human. A new alignment algorithm was developed to cope with the fact that large parts of noncoding sequences are not alignable in a meaningful way because of genetic drift. This new algorithm, DNA Block Aligner (DBA), finds colinear-conserved blocks that are flanked by nonconserved sequences of varying lengths. The noncoding regions of the data set were aligned with DBA. The proportion of the noncoding regions covered by blocks > 60% identical was 36% for upstream regions, 50% for 5' UTRs, 23% for introns, and 56% for 3' UTRs. These blocks of high identity were more or less evenly distributed across the length of the features, except for upstream regions in which the first 100 bp upstream of the transcription start site was covered in up to 70% of the gene pairs. This data set complements earlier sets on the basis of cDNA sequences and will be useful for further comparative studies.","authors":[{"name":"Birney E."},{"name":"Durbin R."},{"name":"Jareborg N."}],"citationCount":173,"date":"1999-09-01T00:00:00Z","journal":"Genome Research","title":"Comparative analysis of noncoding regions of 77 orthologous mouse and human gene pairs"},"pmcid":"PMC310816","pmid":"10508839","type":["Other"]}],"topic":[{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"bioschemas":{"name":"Wise2DBA (EBI)","home":"https://bio.tools/wise2dba","version":"Retired","summary":"Align two sequences assuming the sequences share colinear conserved blocks separated by gaps.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:wise2dba:Retired/soap/www.ebi.ac.uk","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true,"terms_of_use":true},"publications":[{"entries":[{"cit_count":78,"citations":[{"count":1,"year":"2013"},{"count":1,"year":"2015"},{"count":1,"year":"2016"},{"count":2,"year":"2000"},{"count":2,"year":"2009"},{"count":2,"year":"2010"},{"count":2,"year":"2011"},{"count":2,"year":"2012"},{"count":2,"year":"2014"},{"count":2,"year":"2020"},{"count":3,"year":"2008"},{"count":3,"year":"2019"},{"count":4,"year":"2001"},{"count":4,"year":"2007"},{"count":6,"year":"2006"},{"count":7,"year":"2002"},{"count":10,"year":"2005"},{"count":12,"year":"2003"},{"count":12,"year":"2004"}],"doi":"10.1101/gr.9.9.815","pmcid":"PMC310816","pmid":"10508839","ref_count":24,"refs":[{"count":1,"year":"1970"},{"count":1,"year":"1981"},{"count":1,"year":"1987"},{"count":2,"year":"1988"},{"count":2,"year":"1990"},{"count":2,"year":"1994"},{"count":3,"year":"1993"},{"count":4,"year":"1996"},{"count":4,"year":"1997"},{"count":4,"year":"1998"}],"title":"Comparative analysis of noncoding regions of 77 orthologous mouse and human gene pairs.","year":1999}]},{"