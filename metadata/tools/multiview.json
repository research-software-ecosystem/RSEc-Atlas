{"tool_name":"multiview","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"multiview","home":"http://b2slab.upc.edu/software-and-tutorials/multiview-package-multiview-clustering-dimensionality-reduction-methods/","license":"BSD-4-Clause","summary":"Software package for multiview pattern recognition methods.","addition_date":"2019-07-11T09:00:12Z","last_update_date":"2024-11-24T21:03:16.489216Z","tool_type":["Library"],"accessibility":"Open access","biotools_curie":"biotools:multiview","cost":"Free of charge","credit":[{"email":"mburgueno@uoc.edu","name":"Mar\u00eda Araceli Burgue\u00f1o Caballero"},{"email":"samir.kanaan@upc.edu","name":"Samir Kanaan-Izquierdo","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://b2slab.upc.edu/wp-content/uploads/2017/07/mv-vignette.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"}]}],"maturity":"Emerging","name":"multiview","operating_system":["Linux","Mac","Windows"],"owner":"Ruta","publication":[{"doi":"10.1093/bioinformatics/bty1039","metadata":{"abstract":"Summary: Multiview datasets are the norm in bioinformatics, often under the label multi-omics. Multiview data are gathered from several experiments, measurements or feature sets available for the same subjects. Recent studies in pattern recognition have shown the advantage of using multiview methods of clustering and dimensionality reduction; however, none of these methods are readily available to the extent of our knowledge. Multiview extensions of four well-known pattern recognition methods are proposed here. Three multiview dimensionality reduction methods: multiview t-distributed stochastic neighbour embedding, multiview multidimensional scaling and multiview minimum curvilinearity embedding, as well as a multiview spectral clustering method. Often they produce better results than their single-view counterparts, tested here on four multiview datasets.","authors":[{"name":"Burgueno M.A."},{"name":"Kanaan-Izquierdo S."},{"name":"Perera-Lluna A."},{"name":"Ziyatdinov A."}],"citationCount":4,"date":"2019-08-15T00:00:00Z","journal":"Bioinformatics","title":"Multiview: A software package for multiview pattern recognition methods"},"pmid":"30596886","type":["Primary"]}],"topic":[{"term":"Data mining","uri":"http://edamontology.org/topic_3473"},{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"}],"validated":1},"bioschemas":{"name":"multiview","home":"https://bio.tools/multiview","license":"BSD-4-Clause","summary":"Software package for multiview pattern recognition methods.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:multiview/lib/b2slab.upc.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":2,"citations":[{"count":1,"year":"2019"},{"count":1,"year":"2022"}],"doi":"10.1093/bioinformatics/bty1039","pmid":"30596886","ref_count":0,"refs":[],"title":"Multiview: a software package for multiview pattern recognition methods.","year":2019}]}],"readme":false,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":302,"url":"https://b2slab.upc.edu/404.html"}],"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/multiview","@license":"https://creativecom