{"tool_name":"cosmiq","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-cosmiq","version":"1.44.0","home":"https://bioconductor.org/packages/3.22/bioc/html/cosmiq.html","license":"GPL-3","summary":"cosmiq - COmbining Single Masses Into Quantities","identifiers":["biotools:cosmiq","doi:10.5167/uzh-107947"],"description":"cosmiq is a tool for the preprocessing of liquid- or gas - chromatography mass spectrometry (LCMS/GCMS) data with a focus on metabolomics or lipidomics applications. To improve the detection of low abundant signals, cosmiq generates master maps of the mZ/RT space from all acquired runs before a peak detection algorithm is applied. The result is a more robust identification and quantification of low-intensity MS signals compared to conventional approaches where peak picking is performed in each LCMS/GCMS file separately. The cosmiq package builds on the xcmsSet object structure and can be therefore integrated well with the package xcms as an alternative preprocessing step.","license_file":"/lib/R/share/licenses/GPL-3","build":{"number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"build":[null,null,"make"],"host":["bioconductor-faahko >=1.50.0,<1.51.0","bioconductor-massspecwavelet >=1.76.0,<1.77.0","bioconductor-xcms >=4.8.0,<4.9.0","r-base","r-pracma","r-rcpp","libblas","liblapack","zlib","liblzma-devel"],"run":["bioconductor-faahko >=1.50.0,<1.51.0","bioconductor-massspecwavelet >=1.76.0,<1.77.0","bioconductor-xcms >=4.8.0,<4.9.0","r-base","r-pracma","r-rcpp"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/cosmiq_1.44.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/cosmiq/cosmiq_1.44.0.tar.gz","https://bioarchive.galaxyproject.org/cosmiq_1.44.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-cosmiq/bioconductor-cosmiq_1.44.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('cosmiq')\""]},"parent_reci