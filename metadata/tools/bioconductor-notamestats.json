{"tool_name":"bioconductor-notamestats","contents":["bioconda","bioconductor","biotools","oeb"],"identifiers":["biotools:bioconductor-notamestats","bioconductor:notamestats","bioconda:bioconductor-notamestats"],"fetched_metadata":{"biotools":{"id":"bioconductor-notamestats","home":"https://bioconductor.org/packages/notameStats","license":"MIT","summary":"Provides univariate and multivariate statistics for feature prioritization in untargeted LC-MS metabolomics research.","addition_date":"2026-08-30T02:47:39.557015Z","last_update_date":"2026-11-22T22:39:29.123146Z","tool_type":["Command-line tool","Library"],"version":["1.2.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-notamestats","credit":[{"name":"Anton Kl\u00e5vus","typeEntity":"Person","typeRole":["Developer"]},{"name":"Artur Sannikov","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Atte Lihtamo","typeEntity":"Person","typeRole":["Developer"]},{"name":"Jussi Paananen","typeEntity":"Person","typeRole":["Developer"]},{"name":"Kati Hanhineva","typeEntity":"Person","typeRole":["Developer"]},{"name":"Leo Lahti","typeEntity":"Person","typeRole":["Developer"]},{"name":"Olli K\u00e4rkk\u00e4inen","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Oskari Timonen","typeEntity":"Person","typeRole":["Developer"]},{"name":"Retu Haikonen","typeEntity":"Person","typeRole":["Developer"]},{"name":"Vilhelm Suksi","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Ville Koistinen","typeEntity":"Person","typeRole":["Contributor"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/notameStats"}],"edit_permission":{"type":"private"},"name":"notameStats","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.3390/metabo10040135","metadata":{"abstract":"Metabolomics analysis generates vast arrays of data, necessitating comprehensive workflows involving expertise in analytics, biochemistry and bioinformatics in order to provide coherent and high-quality data that enable discovery of robust and biologically significant metabolic findings. In this protocol article, we introduce notame, an analytical workflow for non-targeted metabolic profiling approaches, utilizing liquid chromatography-mass spectrometry analysis. We provide an overview of lab protocols and statistical methods that we commonly practice for the analysis of nutritional metabolomics data. The paper is divided into three main sections: the first and second sections introducing the background and the study designs available for metabolomics research and the third section describing in detail the steps of the main methods and protocols used to produce, preprocess and statistically analyze metabolomics data and, finally, to identify and interpret the compounds that have emerged as interesting.","authors":[{"name":"Broadhurst D"},{"name":"Brunius C"},{"name":"Farizah Babu A"},{"name":"Hanhineva K"},{"name":"H\u00e4kkinen MR"},{"name":"Kl\u00e5vus A"},{"name":"Koistinen VM"},{"name":"Kokla M"},{"name":"K\u00e4rkk\u00e4inen O"},{"name":"Meuronen T"},{"name":"Noerman S"},{"name":"Paananen J"},{"name":"Rummukainen S"},{"name":"Sallinen T"},{"name":"Tuomainen M"},{"name":"Zarei I"}],"citationCount":134,"date":"2020-03-01T00:00:00Z","journal":"Metabolites","title":"\"notame\": Workflow for Non-Targeted LC-MS Metabolic Profiling."},"pmcid":"PMC7240970","pmid":"32244411"}]},"bioconductor":{"name":"notameStats","version":"1.2.0","license":"MIT + file LICENSE","summary":"Workflow for non-targeted LC-MS metabolic profiling","description":"Provides univariate and multivariate statistics for feature prioritization in untargeted LC-MS metabolomics research.","home":"https://github.com/hanhineva-lab/notameStats","author":"Anton Kl\u00e5vus [aut, cph] (ORCID: <https://orcid.org/0000-0003-2612-0230>), Jussi Paananen [aut, cph] (ORCID: <https://orcid.org/0000-0001-5100-4907>), Oskari Timonen [aut, cph] (ORCID: <https://or