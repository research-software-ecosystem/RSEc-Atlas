{"tool_name":"cimbinator","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"cimbinator","home":"http://cimbinator.bioinfo.cnio.es/CombinationIndex","summary":"Web-based tool for drug synergy analysis in small- and large-scale datasets.","addition_date":"2018-06-06T19:01:08Z","last_update_date":"2024-11-25T14:39:01.849928Z","tool_type":["Web application"],"biotools_curie":"biotools:cimbinator","credit":[{"email":"asmund.flobak@ntnu.no","name":"\u00c5smund Flobak","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"miguel.vazquez@cnio.es","name":"Miguel Vazquez","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://cimbinator.bioinfo.cnio.es/CombinationIndex"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Pathway or network analysis","uri":"http://edamontology.org/operation_2497"}]}],"name":"CImbinator","operating_system":["Linux","Mac","Windows"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1093/bioinformatics/btx161","metadata":{"abstract":"Motivation: Drug synergies are sought to identify combinations of drugs particularly beneficial. User-friendly software solutions that can assist analysis of large-scale datasets are required. Results: CImbinator is a web-service that can aid in batch-wise and in-depth analyzes of data from small-scale and large-scale drug combination screens. CImbinator offers to quantify drug combination effects, using both the commonly employed median effect equation, as well as advanced experimental mathematical models describing dose response relationships.","authors":[{"name":"Flobak A."},{"name":"Laegreid A."},{"name":"Valencia A."},{"name":"Vazquez M."}],"citationCount":13,"date":"2017-08-01T00:00:00Z","journal":"Bioinformatics","title":"CImbinator: A web-based tool for drug synergy analysis in small-and large-scale datasets"},"pmcid":"PMC5860113","pmid":"28444126"}],"topic":[{"term":"Drug discovery","uri":"http: