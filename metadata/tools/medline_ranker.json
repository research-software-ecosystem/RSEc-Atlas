{"tool_name":"medline_ranker","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"medline_ranker","home":"http://cbdm.uni-mainz.de/medlineranker","summary":"This web server offers a flexible and fast statistical ranking of PubMed abstracts for topics of interest without expert knowledge.","addition_date":"2016-10-03T14:08:36Z","last_update_date":"2018-12-29T14:01:36Z","tool_type":["Web application","Web service"],"biotools_curie":"biotools:medline_ranker","credit":[{"email":"fontaine@uni-mainz.de","name":"Jean Fred Fontaine","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Article ID","uri":"http://edamontology.org/data_1088"}},{"data":{"term":"Keyword","uri":"http://edamontology.org/data_0968"}}],"note":"Search PubMed abstracts related to a query topic (PubMed query or MeSH term) or a list of abstracts (PMIDs)","operation":[{"term":"Literature search","uri":"http://edamontology.org/operation_0305"},{"term":"Text mining","uri":"http://edamontology.org/operation_0306"}],"output":[{"data":{"term":"Text mining report","uri":"http://edamontology.org/data_0972"}}]}],"name":"Medline Ranker","operating_system":["Linux","Mac","Windows"],"owner":"fontaine","publication":[{"doi":"10.1093/nar/gkp353","metadata":{"abstract":"The biomedical literature is represented by millions of abstracts available in the Medline database. These abstracts can be queried with the PubMed interface, which provides a keyword-based Boolean search engine. This approach shows limitations in the retrieval of abstracts related to very specific topics, as it is difficult for a non-expert user to find all of the most relevant keywords related to a biomedical topic. Additionally, when searching for more general topics, the same approach may return hundreds of unranked references. To address these issues, text mining tools have been developed to help scientists focus on relevant abstracts. We have implemented the MedlineRanker webserver, which allows a flexible ranking of Medline for a topic of interest without expert knowledge. Given some abstracts related to a topic, the program deduces automatically the most discriminative words in comparison to a random selection. These words are used to score other abstracts, including those from not yet annotated recent publications, which can be then ranked by relevance. We show that our tool can be highly accurate and that it is able to process millions of abstracts in a practical amount of time. MedlineRanker is free for use and is available at http://cbdm.mdc-berlin.de/tools/medlineranker.","authors":[{"name":"Andrade-Navarro M.A."},{"name":"Barbosa-Silva A."},{"name":"Fontaine J.-F."},{"name":"Huska M.R."},{"name":"Muro E.M."},{"name":"Schaefer M."}],"citationCount":66,"date":"2009-08-04T00:00:00Z","journal":"Nucleic Acids Research","title":"MedlineRanker: Flexible ranking of biomedical literature"},"pmcid":"PMC2703945","pmid":"19429696","type":["Primary"]}],"topic":[{"term":"Natural language processing","uri":"http://edamontology.org/topic_0218"}],"validated":1},"bioschemas":{"name":"Medline Ranker","home":"https://bio.tools/medline_ranker","summary":"This web server offers a flexible and fast statistical ranking of PubMed abstracts for topics of interest without expert knowledge.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:medline_ranker/soap/cbdm.uni-mainz.de","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":46,"citations":[{"count":1,"year":"2025"},{"count":2,"year":"2010"},{"count":2,"year":"2012"},{"count":2,"year":"2016"},{"count":2,"year":"2017"},{"count":2,"year":"2019"},{"count":2,"year":"2024"},{"count":3,"year":"2021"},{"count":3,"year":"202