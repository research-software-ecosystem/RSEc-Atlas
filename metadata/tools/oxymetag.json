{"tool_name":"oxymetag","contents":["biotools"],"identifiers":["biotools:oxymetag"],"fetched_metadata":{"biotools":{"id":"oxymetag","home":"https://github.com/cliffbueno/oxymetag","summary":"OxyMetaG is a tool that estimates the proportional abundance of aerobic and anaerobic bacteria in a sample by analyzing metagenomic reads. It leverages machine learning models trained on 20 key genes to predict oxygen tolerances.","addition_date":"2026-11-04T17:40:02.126125Z","last_update_date":"2026-11-04T17:40:02.128310Z","biotools_curie":"biotools:oxymetag","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Expression analysis","uri":"http://edamontology.org/operation_2495"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"},{"term":"Sequence assembly","uri":"http://edamontology.org/operation_0310"}]}],"name":"OxyMetaG: Quantifying Oxygen Preferences in Microbial Communities","owner":"pub2tools2024","publication":[{"doi":"10.64898/2026.01.22.701213"}],"topic":[{"term":"Endocrinology and metabolism","uri":"http://edamontology.org/topic_3407"},{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Metatranscriptomics","uri":"http://edamontology.org/topic_3941"},{"term":"Microbial ecology","uri":"http://edamontology.org/topic_3697"}]}}}