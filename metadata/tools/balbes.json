{"tool_name":"balbes","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"balbes","home":"https://www2.mrc-lmb.cam.ac.uk/groups/murshudov/content/balbes/balbes.html","summary":"A system for solving protein structures using x-ray crystallographic data.","addition_date":"2015-03-09T13:15:53Z","last_update_date":"2024-11-25T16:02:40.606863Z","tool_type":["Workbench"],"version":["1"],"collections":["Instruct","Instruct CCP4"],"biotools_curie":"biotools:balbes","cost":"Free of charge","credit":[{"email":"ccisb@stfc.ac.uk","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"Instruct","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["General"],"url":"https://www2.mrc-lmb.cam.ac.uk/groups/murshudov/content/balbes/documentation_fs/doc_layout.html"}],"edit_permission":{"type":"private"},"function":[{"note":"BALBES is a system for solving protein structures using x-ray crystallographic data. Molecular Replacement(MR) is its core scientific method. BALBES aims to integrate all components, necessary for finding a solution structure by MR, into one system. It consists of a database, scientific programs and a python pipeline. The system is automated so that it needs no user's intervention when running complicated combination of jobs such as model searching, molecular replacement and refinement.","operation":[{"term":"Molecular model refinement","uri":"http://edamontology.org/operation_0322"}]}],"name":"BALBES","operating_system":["Linux","Mac"],"owner":"Instruct","publication":[{"doi":"10.1107/s0907444907050172","pmcid":"PMC2394813","pmid":"18094476"}],"topic":[{"term":"Structural biology","uri":"http://edamontology.org/topic_1317"}],"validated":1},"bioschemas":{"name":"BALBES","home":"https://bio.tools/balbes","version":"1","summary":"A system for solving protein structures using x-ray crystallographic data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics