{"tool_name":"bioconductor-ancombc","contents":["biocontainers","oeb","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-ancombc","identifiers":["doi:10.18129/b9.bioc.ancombc"],"license":"Not available","summary":"Analysis of compositions of microbiomes with bias correction","home_url":"https://bioconductor.org/packages/3.12/bioc/html/ANCOMBC.html","keywords":[],"manually_check":true,"total_pulls":367},"biotools":{"id":"bioconductor-ancombc","home":"https://bioconductor.org/packages/ANCOMBC","license":"Artistic-2.0","summary":"ANCOMBC is a package containing differential abundance (DA) and correlation analyses for microbiome data. Specifically, the package includes Analysis of Compositions of Microbiomes with Bias Correction 2 (ANCOM-BC2), Analysis of Compositions of Microbiomes with Bias Correction (ANCOM-BC), and Analysis of Composition of Microbiomes (ANCOM) for DA analysis, and Sparse Estimation of Correlations among Microbiomes (SECOM) for correlation analysis. Microbiome data are typically subject to two sources of biases: unequal sampling fractions (sample-specific biases) and differential sequencing efficiencies (taxon-specific biases). Methodologies included in the ANCOMBC package are designed to correct these biases and construct statistically consistent estimators.","tool_type":["Command-line tool","Library"],"version":["2.14.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-ancombc","credit":[{"name":"Huang Lin","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/ANCOMBC"}],"name":"ANCOMBC","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-ancombc:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packa