{"tool_name":"massarray","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-massarray","version":"1.62.0","home":"https://bioconductor.org/packages/3.22/bioc/html/MassArray.html","license":"GPL (>=2)","summary":"Analytical Tools for MassArray Data","identifiers":["biotools:massarray","doi:10.1093/bioinformatics/btp382"],"description":"This package is designed for the import, quality control, analysis, and visualization of methylation data generated using Sequenom's MassArray platform.  The tools herein contain a highly detailed amplicon prediction for optimal assay design. Also included are quality control measures of data, such as primer dimer and bisulfite conversion efficiency estimation. Methylation data are calculated using the same algorithms contained in the EpiTyper software package.  Additionally, automatic SNP-detection can be used to flag potentially confounded data from specific CG sites.  Visualization includes barplots of methylation data as well as UCSC Genome Browser-compatible BED tracks.  Multiple assays can be positionally combined for integrated analysis.","license_file":"/lib/R/share/licenses/GPL-3","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["r-base"],"run":["r-base"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/MassArray_1.62.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MassArray/MassArray_1.62.0.tar.gz","https://bioarchive.galaxyproject.org/MassArray_1.62.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-massarray/bioconductor-massarray_1.62.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('MassArray')\""]},"parent_recipe":{"name":"bioconductor-massarray","path":"recipes/bioconductor-massarray","version":"1.34.0"}},"biotools":{"id":"massarray","home":"https://bioconductor.org/packages/MassArray","license":"GPL-2.0","summary":"This package is d