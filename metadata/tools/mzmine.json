{"tool_name":"mzmine","contents":["galaxy","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"mzmine","version":"4.7.29","home":"https://github.com/mzmine/mzmine","documentation":"https://mzmine.github.io/mzmine_documentation","license":"MIT","summary":"Integrative analysis of multimodal mass spectrometry data.","identifiers":["usegalaxy-eu:mzmine_batch","biotools:mzmine"],"description":"MZmine 3 is an open-source and platform-independent software for mass\nspectrometry (MS) data processing and visualization. It enables large-scale\nmetabolomics and lipidomics research by spectral preprocessing, feature\ndetection, and various options for compound identification, including\nspectral library querying and creation.\n","license_file":"LICENSE.txt","build":{"noarch":"generic","number":0,"run_exports":[null]},"requirements":{"build":["openjdk >=23","rpm-tools"],"run":["openjdk >=23","pango"]},"source_url":"https://github.com/mzmine/mzmine/archive/refs/tags/v4.7.29.tar.gz","test":{"commands":["test -x ${PREFIX}/bin/mzmine"]}},"biotools":{"id":"mzmine","home":"http://mzmine.sourceforge.net","summary":"Toolbox for visualization and analysis of LC-MS data in netCDF or mzXML.","addition_date":"2017-01-17T14:50:38Z","last_update_date":"2024-09-23T13:43:44.065129Z","tool_type":["Desktop application"],"collections":["Proteomics","ms-utils"],"biotools_curie":"biotools:mzmine","credit":[{"email":"mikko.katajamaa@btk.fi","name":"Mikko Katajamaa","typeEntity":"Person","typeRole":["Maintainer"]},{"email":"pluskal@wi.mit.edu","name":"Tom\u00e1\u0161 Pluskal","typeEntity":"Person","typeRole":["Maintainer"]},{"email":"webmaster@ms-utils.org","typeEntity":"Person","typeRole":["Documentor"],"url":"http://ms-utils.org"}],"documentation":[{"type":["General"],"url":"http://mzmine.github.io/documentation.html"}],"edit_permission":{"authors":["plusik","proteomics.bio.tools","sizhengZhao"],"type":"group"},"function":[{"input":[{"data":{"term":"Mass spectrometry spectra","uri":"http://edamontology.org/data_0943"},"format":[{"term":"Thermo RAW","uri":"http://edamontology.org/format_3712"},{"term":"mzML","uri":"http://edamontology.org/format_3244"},{"term":"mzXML","uri":"http://edamontology.org/format_3654"},{"term":"netCDF","uri":"http://edamontology.org/format_3650"}]}],"operation":[{"term":"Chromatogram visualisation","uri":"http://edamontology.org/operation_3203"},{"term":"Heat map generation","uri":"http://edamontology.org/operation_0531"},{"term":"Mass spectrum visualisation","uri":"http://edamontology.org/operation_3694"},{"term":"Plotting","uri":"http://edamontology.org/operation_3441"},{"term":"Structure visualisation","uri":"http://edamontology.org/operation_0570"}],"output":[{"data":{"term":"Heat map","uri":"http://edamontology.org/data_1636"},"format":[{"term":"png","uri":"http://edamontology.org/format_3603"},{"term":"svg","uri":"http://edamontology.org/format_3604"}]},{"data":{"term":"Image","uri":"http://edamontology.org/data_2968"},"format":[{"term":"png","uri":"http://edamontology.org/format_3603"},{"term":"svg","uri":"http://edamontology.org/format_3604"}]},{"data":{"term":"Plot","uri":"http://edamontology.org/data_2884"},"format":[{"term":"png","uri":"http://edamontology.org/format_3603"},{"term":"svg","uri":"http://edamontology.org/format_3604"}]}]},{"input":[{"data":{"term":"Mass spectrometry spectra","uri":"http://edamontology.org/data_0943"},"format":[{"term":"Thermo RAW","uri":"http://edamontology.org/format_3712"},{"term":"mzML","uri":"http://edamontology.org/format_3244"},{"term":"mzXML","uri":"http://edamontology.org/format_3654"},{"term":"netCDF","uri":"http://edamontology.org/format_3650"}]}],"operation":[{"term":"Chromatographic alignment","uri":"http://edamontology.org/operation_3628"},{"term":"Clustering","uri":"http://edamontology.org/operation_3432"},{"term":"Deisotoping","uri":"http://edamontology.org/operation_3629"},{"term":"Filtering","uri":"http://edamontology.org/operation_3695"},{"term":"Natural product identification","uri":"http://edamontology.org/operation_3803"},{"term":"Peak detection","uri":"http://edamontology.org/operation_3215"},{"term":"Peptide database search","uri":"http://edamontology.org/operation_3646"},{"term":"Peptide identification","uri":"http://edamontology.org/operation_3631"},{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}],"output":[{"data":{"term":"Peptide mass fingerprint","uri":"http://edamontology.org/data_0944"},"format":[{"term":"CSV","uri":"http://edamontology.org/format_3752"},{"term":"SQL","uri":"http://edamontology.org/format_3788"},{"term":"XML","uri":"http://edamontology.org/format_2332"},{"term":"mzTab","uri":"http://edamontology.org/format_3681"}]}]}],"name":"MZmine","operating_system":["Linux","Mac","Windows"],"owner":"plusik","publication":[{"metadata":{"abstract":"Background: Liquid chromatography coupled to mass spectrometry (LC/MS) has been widely used in proteomics and metabolomics research. In this context, the technology has been increasingly used for differential profiling, i.e. broad screening of biomolecular components across multiple samples in order to elucidate the observed phenotypes and discover biomarkers. One of the major challenges in this domain remains development of better solutions for processing of LC/MS data. Results: We present a software package MZmine that enables differential LC/MS analysis of metabolomics data. This software is a toolbox containing methods for all data processing stages preceding differential analysis: spectral filtering, peak detection, alignment and normalization. Specifically, we developed and implemented a new recursive peak search algorithm and a secondary peak picking method for improving already aligned results, as well as a normalization tool that uses multiple internal standards. Visualization tools enable comparative viewing of data across multiple samples. Peak lists can be exported into other data analysis programs. The toolbox has already been utilized in a wide range of applications. We demonstrate its utility on an example of metabolic profiling of Catharanthus roseus cell cultures. Conclusion: The software is freely available under the GNU General Public License and it can be obtained from the project web page at: http://mzmine.sourceforge.net/. \u00a9 2005 Katajamaa and Ore\u0161i\u010d; licensee BioMed Central Ltd.","authors":[{"name":"Katajamaa M."},{"name":"Oresic M."}],"citationCount":303,"date":"2005-07-18T00:00:00Z","journal":"BMC Bioinformatics","title":"Processing methods for differential analysis of LC/MS profile data"},"pmid":"16026613"}],"topic":[{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}],"validated":1},"bioschemas":{"name":"MZmine","home":"https://bio.tools/mzmine","summary":"Toolbox for visualization and analysis of LC-MS data in netCDF or mzXML.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"@TOOL_VERSION@+galaxy@VERSION_SUFFIX@","first_commit":"2023-10-21","conda_name":"mzmine","conda_version":"4.7.29","summary":"mass-spectrometry data processing, with the main focus on LC-MS data","edam_operations":["Natural product identification","Standardisation and normalisation","Peptide database search","Deisotoping","Clustering","Filtering","Chromatographic alignment","Peak detection","Peptide identification","Chromatogram visualisation","Mass spectrum visualisation","Structure visualisation","Plotting","Heat map generation"],"edam_topics":["Proteomics","Metabolomics","Proteomics experiment","Small molecules"],"toolshed_categories":["Metabolomics"],"toolshed_id":"mzmine_batch","users_5_years":8,"users_all_time":8,"usage_5_years":21,"usage_all_time":21,"bio_tools_summary":"Toolbox for visualization and analysis of LC-