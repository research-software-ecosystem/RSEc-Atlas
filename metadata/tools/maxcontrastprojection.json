{"tool_name":"maxcontrastprojection","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"maxcontrastprojection","home":"http://bioconductor.org/packages/release/bioc/html/MaxContrastProjection.html","license":"Artistic-2.0","summary":"A problem when recording 3D fluorescent microscopy images is how to properly present these results in 2D. Maximum intensity projections are a popular method to determine the focal plane of each pixel in the image. The problem with this approach, however, is that out-of-focus elements will still be visible, making edges and fine structures difficult to detect. This package aims to resolve this problem.","addition_date":"2018-07-12T10:23:31Z","last_update_date":"2018-12-10T12:59:00Z","tool_type":["Library"],"version":["1.4.0"],"collections":["BioConductor"],"biotools_curie":"biotools:maxcontrastprojection","credit":[{"email":"jan.sauer@dkfz-heidelberg.de","name":"Jan Sauer","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/manuals/MaxContrastProjection/man/MaxContrastProjection.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Image analysis","uri":"http://edamontology.org/operation_3443"}]},{"operation":[{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"MaxContrastProjection","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","topic":[{"term":"Imaging","uri":"http://edamontology.org/topic_3382"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:maxcontrastprojection:1.4.0/lib/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"source_packages":true,"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publi