{"tool_name":"rdrpcatch","contents":["biotools"],"identifiers":["biotools:rdrpcatch"],"fetched_metadata":{"biotools":{"id":"rdrpcatch","home":"https://rdrpcatch.bioinformatics.nl","summary":"RdRpCATCH is a unified platform for discovering RNA viruses by scanning metatranscriptomic assemblies. It uses collections of profile Hidden Markov Models (pHMMs) targeting the RdRp enzyme for subsequent taxonomic annotation.","addition_date":"2026-11-04T17:34:58.507435Z","last_update_date":"2026-11-04T17:34:58.509452Z","biotools_curie":"biotools:rdrpcatch","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene expression profiling","uri":"http://edamontology.org/operation_0314"},{"term":"Sequence assembly","uri":"http://edamontology.org/operation_0310"},{"term":"Taxonomic classification","uri":"http://edamontology.org/operation_3460"}]}],"name":"RdRpCATCH: RdRp Collaborative Analysis Tool","owner":"pub2tools2024","publication":[{"doi":"10.64898/2026.02.05.703936"}],"topic":[{"term":"Metatranscriptomics","uri":"http://edamontology.org/topic_3941"},{"term":"RNA","uri":"http://edamontology.org/topic_0099"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Virology","uri":"http://edamontology.org/topic_0781"}]}}}