{"tool_name":"deepgoweb","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"deepgoweb","home":"https://deepgo.cbrc.kaust.edu.sa/","summary":"DeepGOWeb is a webserver for protein function prediction from amino acid sequence. DeepGOWeb uses the DeepGOPlus function prediction model.","addition_date":"2021-09-08T16:25:42Z","last_update_date":"2024-11-24T20:19:23.310969Z","tool_type":["SPARQL endpoint","Web API","Web application"],"biotools_curie":"biotools:deepgoweb","credit":[{"email":"maxat.kulmanov@kaust.edu.sa","name":"Maxat Kulmanov","orcidid":"https://orcid.org/0000-0003-1710-1820","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"authors":["bhartimittal"],"type":"group"},"function":[{"operation":[{"term":"Genome indexing","uri":"http://edamontology.org/operation_3211"},{"term":"Protein function prediction","uri":"http://edamontology.org/operation_1777"},{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"},{"term":"Sequence feature detection","uri":"http://edamontology.org/operation_0253"}]}],"name":"DeepGOWeb","owner":"bhartimittal","publication":[{"doi":"10.1093/nar/gkab373","metadata":{"abstract":"Understanding the functions of proteins is crucial to understand biological processes on a molecular level. Many more protein sequences are available than can be investigated experimentally. DeepGOPlus is a protein function prediction method based on deep learning and sequence similarity. DeepGOWeb makes the prediction model available through a website, an API, and through the SPARQL query language for interoperability with databases that rely on Semantic Web technologies. DeepGOWeb provides accurate and fast predictions and ensures that predicted functions are consistent with the Gene Ontology; it can provide predictions for any protein and any function in Gene Ontology. DeepGOWeb is freely available at https://deepgo.cbrc.kaust.edu.sa/.","authors":[{"name":"Hoehndorf R."},{"name":"Kulman