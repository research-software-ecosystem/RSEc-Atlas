{"tool_name":"nlstradamus","contents":["biocontainers","bioconda","oeb","biotools"],"fetched_metadata":{"bioconda":{"name":"nlstradamus","version":"1.8","home":"http://www.moseslab.csb.utoronto.ca/NLStradamus/","license":"GNU General Public License v3 or later (GPLv3+)","summary":"NLStradamus: a simple Hidden Markov Model for nuclear localization signal prediction.","identifiers":["biotools:NLStradamus"],"build":{"number":1},"requirements":{"build":[null],"run":null},"source_url":"http://www.moseslab.csb.utoronto.ca/NLStradamus/NLStradamus/NLStradamus.1.8.tar.gz","test":{"commands":["NLStradamus -h"]}},"biocontainers":{"name":"nlstradamus","identifiers":["biotools:NLStradamus","doi:10.1186/1471-2105-10-202"],"license":"GPL-3.0+","summary":"NLStradamus: a simple Hidden Markov Model for nuclear localization signal prediction.","home_url":"http://www.moseslab.csb.utoronto.ca/NLStradamus/","keywords":["Active Transport, Cell Nucleus","Markov Chains","Models, Theoretical","Nuclear Localization Signals","Sequence sites, features and motifs","Molecular interactions, pathways and networks","Chemistry","Medical imaging"],"manually_check":true,"total_pulls":0},"biotools":{"id":"nlstradamus","home":"http://www.moseslab.csb.utoronto.ca/NLStradamus/","summary":"Simple Hidden Markov Model for nuclear localization signal prediction.","addition_date":"2017-05-02T07:18:53Z","last_update_date":"2018-12-10T12:58:51Z","tool_type":["Web application"],"biotools_curie":"biotools:nlstradamus","credit":[{"email":"alan.moses@utoronto.ca","name":"Alan M Moses","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://www.moseslab.csb.utoronto.ca/NLStradamus/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Protein feature detection","uri":"http://edamontology.org/operation_3092"},{"term":"Protein model validation","uri":"http://edamontology.org/operation_0321"},{"term":"Protein modelling (mutation)","uri":"http://edamontology.org/operation_0331"},{"term":"Protein secondary structure prediction","uri":"http://edamontology.org/operation_0267"}]}],"name":"NLStradamus","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"metadata":{"abstract":"Background: Nuclear localization signals (NLSs) are stretches of residues within a protein that are important for the regulated nuclear import of the protein. Of the many import pathways that exist in yeast, the best characterized is termed the 'classical' NLS pathway. The classical NLS contains specific patterns of basic residues and computational methods have been designed to predict the location of these motifs on proteins. The consensus sequences, or patterns, for the other import pathways are less well-understood. Results: In this paper,we present an analysis of characterized NLSs in yeast, and find, despite the large number of nuclear import pathways, that NLSs seem to show similar patterns of amino acid residues. We test current prediction methods and observe a low true positive rate. We therefore suggest an approach using hidden Markov models (HMMs) to predict novel NLSs in proteins. We show that our method is able to consistently find 37% of the NLSs with a low false positive rate and that our method retains its true positive rate outside of the yeast data set used for the training parameters. Conclusion: Our implementation ofthis model, NLStradamus, is made available at: http://www.moseslab.csb.utoronto.ca/NLStradamus/. \u00a9 2009 Nguyen Ba et al; licensee BioMed Central Ltd.","authors":[{"name":"Moses A.M."},{"name":"Nguyen Ba A.N."},{"name":"Pogoutse A."},{"name":"Provart N."}],"citationCount":317,"date":"2009-06-29T00:00:00Z","journal":"BMC Bioinformatics","title":"NLStradamus: A simple Hidden Markov Model for nuclear localization signal prediction"},"pmid":"19563654"}],"topic":[{"term":"Chemistry","uri":"http://edamontology.org/topic_3314"},{"term":"Medical imaging","uri":"http://edamontology.org/topic_3384"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Sequence sites, features and motifs","uri":"http://edamontology.org/topic_0160"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:nlstradamus/web/www.moseslab.csb.utoronto.ca","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true,"help":true},"publications":[{"entries":[{"cit_count":384,"citations":[{"count":1,"year":"2010"},{"count":8,"year":"2011"},{"count":12,"year":"2015"},{"count":12,"year":"2016"},{"count":13,"year":"2014"},{"count":13,"year":"2026"},{"count":14,"year":"2012"},{"count":16,"year":"2021"},{"count":22,"year":"2013"},{"count":24,"year":"2020"},{"count":26,"year":"2017"},{"count":27,"year":"2019"},{"count":28,"year":"2018"},{"count":29,"year":"2025"},{"count":33,"year":"2022"},{"count":48,"year":"2023"},{"count":58,"year":"2024"}],"doi":"10.1186/1471-2105-10-202","pmcid":"PMC2711084","pmid":"19563654","ref_count":24,"refs":[{"count":1,"year":"1975"},{"count":1,"year":"1986"},{"count":1,"year":"1990"},{"count":1,"year":"1997"},{"count":1,"year":"2006"},{"count":1,"year":"2007"},{"count":1,"year":"2008"},{"count":2,"year":"1993"},{"count":2,"year":"1998"},{"count":2,"year":"1999"},{"count":2,"year":"2004"},{"count":2,"year":"2005"},{"count":3,"year":"2000"},{"count":4,"year":"1996"}],"title":"NLStradamus: a simple Hidden Markov Model for nuclear localization signal prediction.","year":2009}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":408,"ssl":null,"ssl_err":null}},"support":{"email":true}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:nlstradamus:1.8/cmd/www.moseslab.csb.utoronto.ca","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"met