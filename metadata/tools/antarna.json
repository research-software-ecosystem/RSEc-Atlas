ces for a given structure that comply in addition with an adjustable full range objective GC-content distribution, specific sequence constraints and additional fuzzy structure constraints. antaRNA applies ant colony optimization meta-heuristics and its superior performance is shown on a biological datasets.","authors":[{"name":"Backofen R."},{"name":"Kleinkauf R."},{"name":"Mann M."}],"citationCount":22,"date":"2015-10-01T00:00:00Z","journal":"Bioinformatics","title":"AntaRNA: Ant colony-based RNA sequence design"},"pmcid":"PMC4576691","pmid":"26023105","type":["Primary"]}],"topic":[{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"bioschemas":{"name":"AntaRNA","home":"https://bio.tools/antarna","version":"1.1.2","summary":"Multi-objective sequence design by inverse folding.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:antarna:1.1.2/web/rna.informatik.uni-freiburg.de","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true,"help":true},"publications":[{"entries":[{"cit_count":25,"citations":[{"count":1,"year":"2015"},{"count":1,"year":"2020"},{"count":1,"year":"2021"},{"count":1,"year":"2022"},{"count":1,"year":"2024"},{"count":2,"year":"2016"},{"count":2,"year":"2017"},{"count":2,"year":"2019"},{"count":2,"year":"2023"},{"count":2,"year":"2026"},{"count":4,"year":"2018"},{"count":6,"year":"2025"}],"doi":"10.1093/bioinformatics/btv319","pmcid":"PMC4576691","pmid":"26023105","ref_count":29,"refs":[{"count":1,"year":"2007"},{"count":1,"year":"2008"},{"count":2,"year":"2004"},{"count":2,"year":"2005"},{"count":2,"year":"2006"},{"count":2,"year":"2011"},{"count":3,"year":"2010"},{"count":3,"year":"2014"},{"count":6,"year":"2013"},{"count":7,"year":"2012"}],"title":"antaRNA: ant colony-based RNA sequence design.","year":2015}]}],"summary"