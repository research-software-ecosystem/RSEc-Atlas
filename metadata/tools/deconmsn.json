damontology.org/format_3652"}]}]}],"name":"DeconMSn","operating_system":["Linux","Mac","Windows"],"owner":"msutils_import","publication":[{"doi":"10.1093/bioinformatics/btn063","metadata":{"abstract":"Summary: DeconMSn accurately determines the monoisotopic mass and charge state of parent ions from high-resolution tandem mass spectrometry data, offering significant improvement for LTQ_FT and LTQ_Orbitrap instruments over the commercially delivered Thermo Fisher Scientific's extract_msn tool. Optimal parent ion mass tolerance values can be determined using accurate mass information, thus improving peptide identifications for high-mass measurement accuracy experiments. For low-resolution data from LCQ and LTQ instruments, DeconMSn incorporates a support-vector-machine-based charge detection algorithm that identifies the most likely charge of a parent species through peak characteristics of its fragmentation pattern. \u00a9 The Author 2008. Published by Oxford University Press. All rights reserved.","authors":[{"name":"Adkins J.N."},{"name":"Auberry K.J."},{"name":"Jaitly N."},{"name":"Mayampurath A.M."},{"name":"Monroe M.E."},{"name":"Purvine S.O."},{"name":"Smith R.D."}],"citationCount":130,"date":"2008-04-01T00:00:00Z","journal":"Bioinformatics","title":"DeconMSn: A software tool for accurate parent ion monoisotopic mass determination for tandem mass spectra"},"pmcid":"PMC2720627","pmid":"18304935"}],"topic":[{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"}],"validated":1},"bioschemas":{"name":"DeconMSn","home":"https://bio.tools/deconmsn","summary":"Tool for accurate precursor ion monoisotopic mass determination for tandem mass spectra.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:deconmsn/cmd/omics.pnl.gov","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","de