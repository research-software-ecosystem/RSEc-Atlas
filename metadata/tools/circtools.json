rctools.circtools:main"],"noarch":"python","number":0,"run_exports":[null],"script":"-m pip install . --no-deps --no-build-isolation --no-cache-dir -vvv"},"requirements":{"host":["python >=3.8","pip","setuptools"],"run":["python >=3.8","pysam >=0.16.0.1","pybedtools >=0.7.10","biopython >=1.71","scipy >=0.19.0","reportlab >=3.3.0","pandas >=0.25.0","statsmodels","numpy >=1.14.5","htseq >=2.0.0","pathos >=0.3.0","pyyaml >=6.0.2","requests >=2.32.3","star","stringtie","tqdm >=4.67.1","r-base","r-aod","r-devtools","r-formattable","r-kableextra","r-dplyr","r-rcolorbrewer","r-amap","r-data.table","r-ggfortify","r-ggplot2","r-gplots","r-ggrepel","r-gridextra","r-openxlsx","r-plyr","r-hmisc","r-reshape2","bioconductor-ballgown","bioconductor-biomart","bioconductor-edger","bioconductor-genomicfeatures","bioconductor-genomicranges","bioconductor-ggbio"]},"source_url":"https://pypi.io/packages/source/c/circtools/circtools-2.0.5.post2.tar.gz","test":{"commands":["circtools --help"]},"recipe_maintainers":["BarryDigby"]},"biotools":{"id":"circtools","home":"https://github.com/jakobilab/circtools","license":"GPL-3.0","summary":"Software for computational circRNA analyses.","addition_date":"2019-08-04T07:59:36Z","last_update_date":"2024-11-24T21:06:06.390793Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:circtools","cost":"Free of charge","credit":[{"email":"christoph.dieterich@uni-heidelberg.de","name":"Christoph Dieterich","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"tobias.jakobi@uni-heidelberg.de","name":"Tobias Jakobi","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://docs.circ.tools/en/latest/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Enrichment analysis","uri":"http://edamontology.org/operation_3501"}]}],"maturity":"Mature","name":"circtools","operating_system":["Linux","Mac"],"owner":"Ruta","publication":[{"doi":"10.1093/bioinformatics/bty948","metadata":{"abstract":"Motivation: Circular RNAs (circRNAs) originate through back-splicing events from linear primary transcripts, are resistant to exonucleases, are not polyadenylated and have been shown to be highly specific for cell type and developmental stage. CircRNA detection starts from high-throughput sequencing data and is a multi-stage bioinformatics process yielding sets of potential circRNA candidates that require further analyses. While a number of tools for the prediction process already exist, publicly available analysis tools for further characterization are rare. Our work provides researchers with a harmonized workflow that covers different stages of in silico circRNA analyses, from prediction to first functional insights. Results: Here, we present circtools, a modular, Python-based framework for computational circRNA analyses. The software includes modules for circRNA detection, internal sequence reconstruction, quality checking, statistical testing, screening for enrichment of RBP binding sites, differential exon RNase R resistance and circRNA-specific primer design. circtools supports researchers with visualization options and data export into commonly used formats.","authors":[{"name":"Dieterich C."},{"name":"Jakobi T."},{"name":"Uvarovskii A."}],"citationCount":41,"date":"2019-07-01T00:00:00Z","journal":"Bioinformatics","title":"Circtools\u2014a one-stop software solution for circular RNA research"},"pmcid":"PMC6596886","pmid":"30462173","type":["Primary"]}],"topic":[{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"Probes and primers","uri":"http://edamontology.org/topic_0632"}],"validated":1},"bioschemas":{"name":"circtools","home":"https://bio.tools/circtools","license":"GPL-3.0","summary":"Software for computational circRNA analyses.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{