{"tool_name":"mutect","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"mutect","home":"http://www.broadinstitute.org/cancer/cga/mutect","summary":"A method for identification of somatic point mutations in next generation sequencing data of cancer genomes.","addition_date":"2017-01-13T13:15:36Z","last_update_date":"2018-12-10T12:58:49Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:mutect","credit":[{"email":"cga-webmaster@broadinstitute.org","name":"MuTect Support","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"authors":["ELIXIR-EE"],"type":"group"},"function":[{"input":[{"data":{"term":"Nucleic acid sequence","uri":"http://edamontology.org/data_2977"},"format":[{"term":"Alignment format","uri":"http://edamontology.org/format_1921"}]}],"operation":[{"term":"Filtering","uri":"http://edamontology.org/operation_3695"},{"term":"SNP detection","uri":"http://edamontology.org/operation_0484"},{"term":"Statistical calculation","uri":"http://edamontology.org/operation_2238"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"}],"output":[{"data":{"term":"Report","uri":"http://edamontology.org/data_2048"},"format":[{"term":"Workflow format","uri":"http://edamontology.org/format_2032"}]}]}],"name":"MuTect","operating_system":["Linux","Mac","Windows"],"owner":"seqwiki_import","publication":[{"metadata":{"abstract":"Detection of somatic point substitutions is a key step in characterizing the cancer genome. However, existing methods typically miss low-allelic-fraction mutations that occur in only a subset of the sequenced cells owing to either tumor heterogeneity or contamination by normal cells. Here we present MuTect, a method that applies a Bayesian classifier to detect somatic mutations with very low allele fractions, requiring only a few supporting reads, followed by carefully tuned filters that ensure high specificity. We also describe benchmarking approaches that use real, rather than simulated, sequencing data to evaluate the sensitivity and specificity as a function of sequencing depth, base quality and allelic fraction. Compared with other methods, MuTect has higher sensitivity with similar specificity, especially for mutations with allelic fractions as low as 0.1 and below, making MuTect particularly useful for studying cancer subclones and their evolution in standard exome and genome sequencing data. Copyright \u00a9 2013 Nature America, Inc.","authors":[{"name":"Carter S.L."},{"name":"Cibulskis K."},{"name":"Gabriel S."},{"name":"Getz G."},{"name":"Jaffe D."},{"name":"Lander E.S."},{"name":"Lawrence M.S."},{"name":"Meyerson M."},{"name":"Sivachenko A."},{"name":"Sougnez C."}],"citationCount":2329,"date":"2013-03-01T00:00:00Z","journal":"Nature Biotechnology","title":"Sensitive detection of somatic point mutations in impure and heterogeneous cancer samples"},"pmid":"23396013"}],"topic":[{"term":"Exome sequencing","uri":"http://edamontology.org/topic_3676"},{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"Oncology","uri":"http://edamontology.org/topic_2640"}],"validated":1},"bioschemas":{"name":"MuTect","home":"https://bio.tools/mutect","summary":"A method for identification of somatic point mutations in next generation sequencing data of cancer genomes.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mutect/cmd/www.broadinstitute.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":3145,"citations":[{"count":2,"year":"-1"},{"count":39,"year":"2013"},{"count":93,"year":"2014"},{"count":111,"year":"2026"},{"count":151,"year":"2015"},{"count":198,"year":"2016"},{"count":225,"year":"2025"},{"count":244,"year":"2023"},{"count":251,"year":"2017"},{"count":251,"year":"2024"},{"count":281,"year":"2019"}