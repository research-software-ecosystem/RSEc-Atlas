{"tool_name":"vgichan","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"vgichan","home":"http://webs.iiitd.edu.in/raghava/vgichan/","summary":"The aim is to predict voltage gated ion-channels and classify them into sodium, potassium, calcium and chloride ion channels from primary amino sequences.","addition_date":"2017-08-03T19:03:53Z","last_update_date":"2024-11-24T15:35:47.493323Z","tool_type":["Web application"],"biotools_curie":"biotools:vgichan","credit":[{"email":"raghava@imtech.res.in","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.imtech.res.in/raghava/vgichan/contact.html"}],"documentation":[{"type":["General"],"url":"http://crdd.osdd.net/raghava/vgichan/help.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Protein feature detection","uri":"http://edamontology.org/operation_3092"}]}],"name":"VGIchan","operating_system":["Linux","Mac","Windows"],"owner":"raghavagps","publication":[{"doi":"10.1016/s1672-0229(07)60006-0","metadata":{"abstract":"This study describes methods for predicting and classifying voltage-gated ion channels. Firstly, a standard support vector machine (SVM) method was developed for predicting ion channels by using amino acid composition and dipeptide composition, with an accuracy of 82.89% and 85.56%, respectively. The accuracy of this SVM method was improved from 85.56% to 89.11% when combined with PSI-BLAST similarity search. Then we developed an SVM method for classifying ion channels (potassium, sodium, calcium, and chloride) by using dipeptide composition and achieved an overall accuracy of 96.89%. We further achieved a classification accuracy of 97.78% by using a hybrid method that combines dipeptide-based SVM and hidden Markov model methods. A web server VGIchan has been developed for predicting and classifying voltage-gated ion channels using the above approaches. VGIchan is freely available at www.imtech.res.in/raghava/vgichan/. \u00a9 2006 Beijing Genomics Institute.","authors":[{"name":"Raghava G.P.S."},{"name":"Saha S."},{"name":"Singh B."},{"name":"Zack J."}],"citationCount":28,"date":"2006-12-01T00:00:00Z","journal":"Genomics, Proteomics and Bioinformatics","title":"VGIchan: Prediction and Classification of Voltage-Gated Ion Channels"},"pmcid":"PMC5054079","pmid":"17531801"}],"topic":[{"term":"Function analysis","uri":"http://edamontology.org/topic_1775"},{"term":"Protein sites, features and motifs","uri":"http://edamontology.org/topic_3510"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"},{"term":"Structure analysis","uri":"http://edamontology.org/topic_0081"}],"validated":1},"bioschemas":{"name":"VGIchan","home":"https://bio.tools/vgichan","summary":"The aim is to predict voltage gated ion-channels and classify them into sodium, potassium, calcium and chloride ion channels from primary amino sequences.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:vgichan/web/webs.iiitd.edu.in","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":11,"citations":[{"count":1,"year":"2007"},{"count":1,"year":"2013"},{"count":1,"year":"2015"},{"count":1,"year":"2017"},{"count":1,"year":"2020"},{"count":1,"year":"2021"},{"count":1,"year":"2025"},{"count":2,"year":"2016"},{"count":2,"year":"2019"}],"doi":"10.1016/S1672-0229(07)60006-0","pmcid":"PMC5054079","pmid":"17531801","ref_count":10,"refs":[{"count":1,"year":"1994"},{"count":1,"year":"1997"},{"count":1,"year":"1998"},{"count":1,"year":"1999"},{"count":2,"year":"2000"},{"count":2,"year":"2004"},{"count":2,"year":"2005"}],"title":"VGIchan: prediction and classification of voltage-gated ion channels.","year":2006}]}],"summary":{"description":true},"website"