{"tool_name":"alignstat","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"alignstat","home":"http://alignstat.science.latrobe.edu.au/","license":"Other","summary":"AlignStat is a web-tool and R package for statistical comparison of alternative multiple sequence alignments.","addition_date":"2018-08-28T13:11:23Z","last_update_date":"2019-01-13T17:51:17Z","tool_type":["Command-line tool","Web application"],"version":["1.3.2"],"biotools_curie":"biotools:alignstat","credit":[{"email":"T.Shafee@LaTrobe.edu.au","name":"Thomas Shafee","orcidid":"http://orcid.org/0000-0002-2298-7593","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/TS404/AlignStat/blob/master/README.md"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Sequence comparison","uri":"http://edamontology.org/operation_2451"}]}],"name":"AlignStat","operating_system":["Linux","Mac","Windows"],"owner":"daniel_stefan","publication":[{"doi":"10.1186/s12859-016-1300-6","metadata":{"abstract":"\u00a9 2016 The Author(s).Background: Alternative sequence alignment algorithms yield different results. It is therefore useful to quantify the similarities and differences between alternative alignments of the same sequences. These measurements can identify regions of consensus that are likely to be most informative in downstream analysis. They can also highlight systematic differences between alignments that relate to differences in the alignment algorithms themselves. Results: Here we present a simple method for aligning two alternative multiple sequence alignments to one another and assessing their similarity. Differences are categorised into merges, splits or shifts in one alignment relative to the other. A set of graphical visualisations allow for intuitive interpretation of the data. Conclusions: AlignStat enables the easy one-off online use of MSA similarity comparisons or into R pipelines. The web-tool is available at AlignStat.Science.LaTrobe.edu.au. The R package, readme and example data are available on CRAN and GitHub.com/TS404/AlignStat.","authors":[{"name":"Cooke I."},{"name":"Shafee T."}],"date":"2016-10-26T00:00:00Z","journal":"BMC Bioinformatics","title":"AlignStat: A web-tool and R package for statistical comparison of alternative multiple sequence alignments"},"pmcid":"PMC5081975","pmid":"27784265","type":["Primary"]}],"topic":[{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"},{"term":"Statistics and probability","uri":"http://edamontology.org/topic_2269"}],"validated":1},"bioschemas":{"name":"AlignStat","home":"https://bio.tools/alignstat","license":"Other","version":"1.3.2","summary":"AlignStat is a web-tool and R package for statistical comparison of alternative multiple sequence alignments.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:alignstat:1.3.2/cmd/alignstat.science.latrobe.edu.au","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":4,"citations":[{"count":1,"year":"2022"},{"count":1,"year":"2023"},{"count":2,"year":"2021"}],"doi":"10.1186/s12859-016-1300-6","pmcid":"PMC5081975","pmid":"27784265","ref_count":15,"refs":[{"count":1,"year":"1970"},{"count":1,"year":"1999"},{"count":1,"year":"2007"},{"count":1,"year":"2009"},{"count":1,"year":"2010"},{"count":2,"year":"2000"},{"count":2,"year":"2005"},{"count":2,"year":"2006"},{"count":2,"year":"2011"},{"count":2,"year":"2016"}],"title":"AlignStat: a 