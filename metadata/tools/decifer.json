{"tool_name":"decifer","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"decifer","home":"https://github.com/raphael-group/decifer","license":"BSD-3-Clause","summary":"DeCiFer is an algorithm that simultaneously selects mutation multiplicities and clusters SNVs by their corresponding descendant cell fractions (DCF), a statistic that quantifies the proportion of cells which acquired the SNV or whose ancestors acquired the SNV. DCF is related to the commonly used cancer cell fraction (CCF) but further accounts for SNVs which are lost due to deleterious somatic copy-number aberrations (CNAs), identifying clusters of SNVs which occur in the same phylogenetic branch of tumour evolution.","addition_date":"2021-09-08T13:39:08Z","last_update_date":"2021-09-12T18:31:08Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:decifer","credit":[{"email":"braphael@princeton.edu","name":"Benjamin J. Raphael","orcidid":"https://orcid.org/0000-0003-1274-048X","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"melkebir@illinois.edu","name":"Mohammed El-Kebir","orcidid":"https://orcid.org/0000-0002-1468-2407","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Phylogenetic inference","uri":"http://edamontology.org/operation_0323"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"}]}],"name":"DeCiFer","owner":"Kigaard","publication":[{"doi":"10.1101/2021.02.27.429196","type":["Primary"]}],"topic":[{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Oncology","uri":"http://edamontology.org/topic_2640"},{"term":"Phylogenetics","uri":"http://edamontology.org/topic_3293"}]},"bioschemas":{"name":"DeCiFer","home":"https://bio.tools/decifer","license":"BSD-3-Clause","summar