{"tool_name":"pancircbase","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"pancircbase","home":"https://www.pancircbase.net/","license":"Not licensed","summary":"An online resource for the exploration of circular RNAs in pancreatic islets.","addition_date":"2022-11-15T08:31:26.186800Z","last_update_date":"2024-11-24T15:20:59.199907Z","tool_type":["Database portal","Web application"],"biotools_curie":"biotools:pancircbase","credit":[{"email":"amaresh.panda@ils.res.in","name":"Amaresh Chandra Panda","typeEntity":"Person"}],"documentation":[{"type":["General"],"url":"https://www.pancircbase.net/contact-me"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"PCR primer design","uri":"http://edamontology.org/operation_0308"},{"term":"miRNA expression analysis","uri":"http://edamontology.org/operation_3792"},{"term":"miRNA target prediction","uri":"http://edamontology.org/operation_0463"}]}],"name":"PanCircBase","operating_system":["Linux","Mac","Windows"],"owner":"Chan019","publication":[{"doi":"10.3389/fcell.2022.942762","metadata":{"abstract":"Circular RNAs (circRNAs) are a novel class of covalently closed RNA molecules that recently emerged as a critical regulator of gene expression in development and diseases. Recent research has highlighted the importance of novel circRNAs in the biosynthesis and secretion of insulin from \u03b2-cells of pancreatic islets. However, all circRNAs expressed in pancreatic islets or \u03b2-cells are not readily available in the database. In this study, we analyzed publicly available RNA-sequencing datasets of the pancreatic islets to catalog all circRNAs expressed in pancreatic islets to construct the PanCircBase (https://www.pancircbase.net/) database that provides the following resources: 1) pancreatic islet circRNA annotation details (genomic position, host gene, exon information, splice length, sequence, other database IDs, cross-species conservation), 2) divergent primers for PCR analysis of circRNAs, 3) siRNAs for silencing of target circRNAs, 4) miRNAs associated with circRNAs, 5) possible protein-coding circRNAs and their polypeptides. In summary, this is a comprehensive online resource for exploring circRNA expression and its possible function in pancreatic \u03b2-cells.","authors":[{"name":"Mishra S.S."},{"name":"Panda A.C."},{"name":"Singh S."},{"name":"Sinha T."}],"citationCount":3,"date":"2022-08-19T00:00:00Z","journal":"Frontiers in Cell and Developmental Biology","title":"PanCircBase: An online resource for the exploration of circular RNAs in pancreatic islets"},"pmcid":"PMC9437246","pmid":"36060809"}],"topic":[{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"Probes and primers","uri":"http://edamontology.org/topic_0632"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"bioschemas":{"name":"PanCircBase","home":"https://bio.tools/pancircbase","license":"Not licensed","summary":"An online resource for the exploration of circular RNAs in pancreatic islets.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pancircbase/db/www.pancircbase.net","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":1,"citations":[{"count":1,"year":"2024"}],"doi":"10.3389/fcell.2022.942762","pmcid":"PMC9437246","pmid":"36060809","ref_count":50,"refs":[{"count":1,"year":"1979"},{"count":1,"year":"1991"},{"count":1,"year":"1993"},{"count":1,"year":"2003"},{"count":1,"year":"2004"},{"count":1,"year":"2010"},{"c