{"tool_name":"wombat","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"wombat","home":"http://didgeridoo.une.edu.au/km/wombat.php","license":"Not licensed","summary":"Program to facilitate analyses fitting a linear, mixed model via restricted maximum likelihood (REML).","addition_date":"2017-08-20T15:59:22Z","last_update_date":"2020-01-19T17:47:47Z","tool_type":["Command-line tool"],"collections":["Animal and Crop Genomics"],"biotools_curie":"biotools:wombat","credit":[{"email":"kmeyer.agbu@gmail.com","name":"Karin Meyer","orcidid":"http://orcid.org/0000-0003-2663-9059","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://didgeridoo.une.edu.au/km/WOMBAT/WWW/manual.html"}],"edit_permission":{"authors":["animalandcropgenomics"],"type":"group"},"function":[{"operation":[{"term":"Statistical modelling","uri":"http://edamontology.org/operation_3664"}]}],"name":"Wombat","operating_system":["Linux","Mac","Windows"],"owner":"admin","publication":[{"doi":"10.1631/jzus.2007.B0815","metadata":{"abstract":"WOMBAT is a software package for quantitative genetic analyses of continuous traits, fitting a linear, mixed model; estimates of covariance components and the resulting genetic parameters are obtained by restricted maximum likelihood. A wide range of models, comprising numerous traits, multiple fixed and random effects, selected genetic covariance structures, random regression models and reduced rank estimation are accommodated. WOMBAT employs up-to-date numerical and computational methods. Together with the use of efficient compilers, this generates fast executable programs, suitable for large scale analyses. Use of WOMBAT is illustrated for a bivariate analysis. The package consists of the executable program, available for LINUX and WINDOWS environments, manual and a set of worked example, and can be downloaded free of charge from (http://agbu. une.edu.au/~kmeyer/wombat.html).","authors":[{"name":"Meyer K."}],"citationCount":518,"date":"2007-01-01T00:00:00Z","journal":"Journal of Zhejiang University. Science. B.","title":"WOMBAT: a tool for mixed model analyses in quantitative genetics by restricted maximum likelihood (REML)."},"pmcid":"PMC2064953","pmid":"17973343","type":["Primary"]}],"topic":[{"term":"Quantitative genetics","uri":"http://edamontology.org/topic_3055"}],"validated":1},"bioschemas":{"name":"Wombat","home":"https://bio.tools/wombat","license":"Not licensed","summary":"Program to facilitate analyses fitting a linear, mixed model via restricted maximum likelihood (REML).","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:wombat/cmd/didgeridoo.une.edu.au","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":225,"citations":[{"count":2,"year":"2009"},{"count":2,"year":"2010"},{"count":4,"year":"2012"},{"count":6,"year":"2011"},{"count":7,"year":"2017"},{"count":8,"year":"2013"},{"count":8,"year":"2018"},{"count":8,"year":"2026"},{"count":9,"year":"2014"},{"count":13,"year":"2015"},{"count":16,"year":"2016"},{"count":17,"year":"2020"},{"count":18,"year":"2025"},{"count":19,"year":"2019"},{"count":20,"year":"2023"},{"count":20,"year":"2024"},{"count":24,"year":"2021"},{"count":24,"year":"2022"}],"doi":"10.1631/jzus.2007.B0815","pmcid":"PMC2064953","pmid":"17973343","ref_count":2,"refs":[{"count":1,"year":"2005"},{"count":1,"year":"2007"}],"title":"WOMBAT: a tool for mixed model analyses in quantitative genetics by restricted maximum likelihood (REML).","year":2007}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":200,"ssl":null,"ssl_err