{"tool_name":"clusterdna","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"clusterdna","home":"https://www.mathworks.com/matlabcentral/fileexchange/49026-cluster-dna-sequences-using-fourier-power-spectrum","summary":"Cluster DNA sequences using Fourier power spectrum","addition_date":"2021-05-05T11:10:48Z","last_update_date":"2024-11-24T20:23:28.257588Z","tool_type":["Library"],"version":["1.0.0.0"],"collections":["File Exchange","MATLAB"],"accessibility":"Open access (with restrictions)","biotools_curie":"biotools:clusterdna","cost":"Free of charge (with restrictions)","credit":[{"name":"Tung Hoang","typeEntity":"Person","typeRole":["Primary contact"],"url":"https://www.mathworks.com/matlabcentral/profile/4646567-tung-hoang"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"},{"term":"Phylogenetic inference","uri":"http://edamontology.org/operation_0323"},{"term":"Phylogenetic tree editing","uri":"http://edamontology.org/operation_0326"}]}],"name":"Cluster DNA sequences using Fourier power spectrum","operating_system":["Linux","Mac","Windows"],"owner":"zsmag19","publication":[{"doi":"10.1016/j.jtbi.2015.02.026","metadata":{"abstract":"A novel clustering method is proposed to classify genes and genomes. For a given DNA sequence, a binary indicator sequence of each nucleotide is constructed, and Discrete Fourier Transform is applied on these four sequences to attain respective power spectra. Mathematical moments are built from these spectra, and multidimensional vectors of real numbers are constructed from these moments. Cluster analysis is then performed in order to determine the evolutionary relationship between DNA sequences. The novelty of this method is that sequences with different lengths can be compared easily via the use of power spectra and moments. Experimental results on various datasets show that the proposed method provides an efficient tool to classify genes and genomes. It not only gives comparable results but also is remarkably faster than other multiple sequence alignment and alignment-free methods.","authors":[{"name":"Hoang T."},{"name":"Lucy He R."},{"name":"Yau S.S.-T."},{"name":"Yin C."},{"name":"Yu C."},{"name":"Zheng H."}],"citationCount":63,"date":"2015-05-07T00:00:00Z","journal":"Journal of Theoretical Biology","title":"A new method to cluster DNA sequences using Fourier power spectrum"},"pmcid":"PMC7094126","pmid":"25747773","type":["Other"]}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Mathematics","uri":"http://edamontology.org/topic_3315"},{"term":"Phylogeny","uri":"http://edamontology.org/topic_0084"},{"term":"Zoology","uri":"http://edamontology.org/topic_3500"}]},"bioschemas":{"name":"Cluster DNA sequences using Fourier power spectrum","home":"https://bio.tools/clusterdna","version":"1.0.0.0","summary":"Cluster DNA sequences using Fourier power spectrum","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:clusterdna:1.0.0.0/lib/www.mathworks.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":27,"citations":[{"count":1,"year":"2015"},{"count":1,"year":"2020"},{"count":1,"year":"2021"},{"count":1,"year":"2024"},{"count":1,"year":"2025"},{"count":2,"year":"2016"},{"count":2,"year":"2018"},{"count":3,"year":"2023"},{"count":4,"year":"2017"},{"count":4,"year":"2022"},{"count":7,"year":"2019"}],"doi":"10.1016/j.jtbi.2015.02.026","pmcid":"PMC7094126","pmid":"25747773","ref_count":29,"refs":[{"count":1,"year":"1989"},{"count":1,"year":"1992"},{"count":1,"year":"1997"},{"count":1,"year":"2008"},{"count":2,"year":"1982"},{"count":2,"year":"2000"},{"count":2,"year":"2002"},{"count":2,"year":"2005"},{"count":