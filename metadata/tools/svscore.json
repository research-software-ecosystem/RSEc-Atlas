{"tool_name":"svscore","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"SVScore","home":"https://github.com/lganel/SVScore","license":"MIT","summary":"Impact prediction tool for structural variation.","addition_date":"2019-07-08T07:19:38Z","last_update_date":"2024-11-24T21:08:35.940301Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:SVScore","cost":"Free of charge","credit":[{"email":"ihall@wustl.edu","name":"Ira M. Hall","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/lganel/SVScore/blob/master/README.md"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Aggregation","uri":"http://edamontology.org/operation_3436"},{"term":"SNP detection","uri":"http://edamontology.org/operation_0484"},{"term":"Virulence prediction","uri":"http://edamontology.org/operation_3461"}]}],"maturity":"Mature","name":"SVScore","operating_system":["Linux","Mac"],"owner":"Ruta","publication":[{"doi":"10.1093/bioinformatics/btw789","metadata":{"abstract":"Here we present SVScore, a tool for in silico structural variation (SV) impact prediction. SVScore aggregates per-base single nucleotide polymorphism (SNP) pathogenicity scores across relevant genomic intervals for each SV in a manner that considers variant type, gene features and positional uncertainty. We show that the allele frequency spectrum of high-scoring SVs is strongly skewed toward lower frequencies, suggesting that they are under purifying selection, and that SVScore identifies deleterious variants more effectively than alternative methods. Notably, our results also suggest that duplications are under surprisingly strong selection relative to deletions, and that there are a similar number of strongly pathogenic SVs and SNPs in the human population. Availability and Implementation: SVScore is implemented in Perl and available freely at {{http:// www.github.com/lganel/SVScore}} for use under the MIT license.","authors":[{"name":"Abel H.J."},{"name":"Ganel L."},{"name":"Hall I.M."}],"citationCount":41,"date":"2017-04-01T00:00:00Z","journal":"Bioinformatics","title":"SVScore: An impact prediction tool for structural variation"},"pmcid":"PMC5408916","pmid":"28031184","type":["Primary"]}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"DNA structural variation","uri":"http://edamontology.org/topic_3175"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"}],"validated":1},"bioschemas":{"name":"SVScore","home":"https://bio.tools/SVScore","license":"MIT","summary":"Impact prediction tool for structural variation.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:svscore/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":39,"citations":[{"count":2,"year":"2017"},{"count":2,"year":"2025"},{"count":4,"year":"2019"},{"count":5,"year":"2020"},{"count":5,"year":"2021"},{"count":5,"year":"2024"},{"count":6,"year":"2023"},{"count":10,"year":"2022"}],"doi":"10.1093/bioinformatics/btw789","pmcid":"PMC5408916","pmid":"28031184","ref_count":14,"refs":[{"count":1,"year":"2001"},{"count":1,"year":"2005"},{"count":2,"year":"2010"},{"count":2,"year":"2011"},{"count":2,"year":"2014"},{"count":2,"year":"2016"},{"count":4,"year":"2015"}],"title":"SVScore: an impact prediction tool for structural variation.","year":2017}]}],"readme":true,"summary":{"description":true