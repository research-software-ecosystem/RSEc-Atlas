{"tool_name":"navia","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"navia","home":"https://navia.ms","license":"BSD-2-Clause","summary":"NaViA is a web tool created to augmend the analysis of complex mass spectra obtained from native mass spectrometry.","addition_date":"2021-11-05T19:59:30.312262Z","last_update_date":"2024-11-24T20:16:50.795230Z","tool_type":["Web application"],"accessibility":"Open access","biotools_curie":"biotools:navia","cost":"Free of charge","credit":[{"email":"phillip.stansfeld@warwick.ac.uk","name":"Phillip J Stansfeld","orcidid":"https://orcid.org/0000-0001-8800-7669","typeEntity":"Person"},{"email":"carol.robinson@chem.ox.ac.uk","name":"Carol V Robinson","typeEntity":"Person"},{"name":"Denis Shutin"},{"name":"Francesco Fiorentino"},{"name":"Idlir Liko"},{"name":"Rachel Davis"},{"name":"Silvia Lovera"},{"name":"Siyun Chen"},{"name":"Thomas D Newport"},{"name":"Tim K Esser"},{"name":"Daniel Quetschlich","orcidid":"https://orcid.org/0000-0002-0486-5947"}],"documentation":[{"type":["Quick start guide"],"url":"https://www.youtube.com/channel/UCRvzQxegz0WNkjvvaRJ8PpQ"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Mass spectra calibration","uri":"http://edamontology.org/operation_3627"},{"term":"Mass spectrum visualisation","uri":"http://edamontology.org/operation_3694"},{"term":"Peak detection","uri":"http://edamontology.org/operation_3215"},{"term":"Spectrum calculation","uri":"http://edamontology.org/operation_3860"}]}],"name":"NaViA","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1093/bioinformatics/btab436","metadata":{"abstract":"Motivation: Native mass spectrometry is now a well-established method for the investigation of protein complexes, specifically their subunit stoichiometry and ligand binding properties. Recent advances allowing the analysis of complex mixtures lead to an increasing diversity and complexity in the spectra obtained. These spectra can be time-consuming to tackle through manual assignment and challenging for automated approaches. Results: Native Mass Spectrometry Visual Analyser is a web-based tool to augment the manual process of peak assignment. In addition to matching masses to the stoichiometry of its component subunits, it allows raw data processing, assignment and annotation and permits mass spectra to be shared with their respective interpretation.","authors":[{"name":"Chen S."},{"name":"Davis R."},{"name":"Esser T.K."},{"name":"Fiorentino F."},{"name":"Liko I."},{"name":"Lovera S."},{"name":"Newport T.D."},{"name":"Quetschlich D."},{"name":"Robinson C.V."},{"name":"Shutin D."},{"name":"Stansfeld P.J."}],"citationCount":11,"date":"2021-12-15T00:00:00Z","journal":"Bioinformatics","title":"NaViA: A program for the visual analysis of complex mass spectra"},"pmcid":"PMC8665753","pmid":"34145888"}],"topic":[{"term":"Bioinformatics","uri":"http://edamontology.org/topic_0091"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"}],"validated":1},"bioschemas":{"name":"NaViA","home":"https://bio.tools/navia","license":"BSD-2-Clause","summary":"NaViA is a web tool created to augmend the analysis of complex mass spectra obtained from native mass spectrometry.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:navia/web/navia.ms","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":7,"citations":[{"count":2,"year":"2021"},{"count":2,"year":"2026"},{"count":3,"year":"2025"}],"doi":"10.1093/bioinformatics/btab436","pmcid":"PMC8665753","pmid":"34145888","ref_count":11,"refs":[{"count":1,"year":