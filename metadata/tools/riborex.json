{"tool_name":"riborex","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"riborex","identifiers":["biotools:riborex","doi:10.1093/bioinformatics/btx047"],"license":"GPL-3.0","summary":"Riborex is a R package for identification of differential translation from Ribo-seq data.","home_url":"https://github.com/smithlabcode/riborex","keywords":["Animals","Computational Biology","Humans","Mice","Protein Biosynthesis","Ribosomes","Sequence Analysis, RNA","Transcriptome","Functional, regulatory and non-coding RNA","Gene expression","Mapping","Genomics"],"manually_check":true,"total_pulls":0},"biotools":{"id":"riborex","home":"https://github.com/smithlabcode/riborex","summary":"Fast and flexible identification of differential translation from Ribo-seq data.","addition_date":"2018-06-05T12:10:35Z","last_update_date":"2024-11-24T20:25:44.231241Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:riborex","credit":[{"email":"andrewds@usc.edu","name":"Andrew D. Smith","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"weiliw@usc.edu","name":"Weili Wang","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"wenzhenl@usc.edu","name":"Wenzheng Li","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/smithlabcode/riborex"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Transcriptional regulatory element prediction","uri":"http://edamontology.org/operation_0438"}]}],"name":"Riborex","operating_system":["Linux","Mac"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1093/bioinformatics/btx047","metadata":{"abstract":"Motivation: Global analysis of translation regulation has recently been enabled by the development of Ribosome Profiling, or Ribo-seq, technology. This approach provides maps of ribosome activity for each expressed gene in a given biological sample. Measurements of translation efficiency are generated when Ribo-seq data is analyzed in combination with matched RNA-seq gene expression profiles. Existing computational methods for identifying genes with differential translation across samples are based on sound principles, but require users to choose between accuracy and speed. Results: We present Riborex, a computational tool for mapping genome-wide differences in translation efficiency. Riborex shares a similar mathematical structure with existing methods, but has a simplified implementation. Riborex directly leverages established RNA-seq analysis frameworks for all parameter estimation, providing users with a choice among robust engines for these computations. The result is a method that is dramatically faster than available methods without sacrificing accuracy.","authors":[{"name":"Li W."},{"name":"Penalva L.O.F."},{"name":"Smith A.D."},{"name":"Uren P.J."},{"name":"Wang W."}],"citationCount":63,"date":"2017-06-01T00:00:00Z","journal":"Bioinformatics","title":"Riborex: Fast and flexible identification of differential translation from Ribo-seq data"},"pmcid":"PMC5860393","pmid":"28158331"}],"topic":[{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"}],"validated":1},"bioschemas":{"name":"Riborex","home":"https://bio.tools/riborex","summary":"Fast and flexible identification of differential translation from Ribo-seq data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:riborex/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"licens