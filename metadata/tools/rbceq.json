{"tool_name":"rbceq","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"rbceq","home":"https://www.rbceq.org/","summary":"An Integrated Bioinformatics Algorithm Designed to Improve Blood Type Compatibility Testing.\n\nRBCeq is an integrated bioinformatics webserver to characterize blood group profiles from genomics data. The software uses manually curated, publicly available database(s) listing antigen variants and reports known, novel and rare blood group variants. RBCeq is fully automated and allows seamless analysis and visualization through a user-friendly interface.","addition_date":"2021-03-19T08:32:01Z","last_update_date":"2021-03-31T13:13:29Z","tool_type":["Web application"],"biotools_curie":"biotools:rbceq","cost":"Free of charge","credit":[{"email":"shiv.nagaraj@qut.edu.au","name":"Shivashankar H. Nagaraj","typeEntity":"Person"}],"documentation":[{"type":["Training material"],"url":"https://www.rbceq.org/tutorial.php"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Peptide immunogenicity prediction","uri":"http://edamontology.org/operation_0252"},{"term":"Sequence trimming","uri":"http://edamontology.org/operation_3192"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"},{"term":"Variant classification","uri":"http://edamontology.org/operation_3225"}]}],"name":"RBCeq","owner":"zsmag19","publication":[{"doi":"10.1101/2021.01.13.426510"}],"topic":[{"term":"Copy number variation","uri":"http://edamontology.org/topic_3958"},{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Immunoproteins and antigens","uri":"http://edamontology.org/topic_2830"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}]},"bioschemas":{"name":"RBCeq","home":"https://bio.tools/rbceq","summary":"An Integrated Bioinformatics