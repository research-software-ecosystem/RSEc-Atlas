{"tool_name":"peffect","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"peffect","home":"https://rostlab.org/services/peffect/","license":"GPL-2.0","summary":"Prediction of type III effector proteins from protein sequence.","addition_date":"2015-12-02T18:10:26Z","last_update_date":"2024-11-25T14:17:40.306486Z","tool_type":["Command-line tool"],"version":["0.0.1"],"collections":["Bromberglab tools","Rostlab tools"],"biotools_curie":"biotools:peffect","cost":"Free of charge","credit":[{"email":"localization@rostlab.org","name":"Support","typeRole":["Support"]},{"email":"localization@rostlab.org","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"Alexander von Humboldt foundation through the German Federal Ministry for Education and Research","typeEntity":"Funding agency","typeRole":["Contributor"]},{"name":"Ernst Ludwig Ehrlich Studienwerk","typeEntity":"Funding agency","typeRole":["Contributor"]},{"name":"RostLab","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Rutgers University","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Tatyana Goldberg","typeEntity":"Person","typeRole":["Developer"]},{"name":"Technical University of Munich","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Burkhard Rost","typeRole":["Contributor"]},{"name":"Yana Bromberg","typeRole":["Contributor"]}],"documentation":[{"type":["General"],"url":"https://rostlab.org/owiki/index.php/PEffect"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Protein sequence (raw)","uri":"http://edamontology.org/data_2974"},"format":[{"term":"FASTA-like (text)","uri":"http://edamontology.org/format_2200"}]}],"note":"Prediction of gram-negative bacterial type III effector proteins","operation":[{"term":"Protein function prediction","uri":"http://edamontology.org/operation_1777"}],"output":[{"data":{"term":"Sequence features","uri":"http://edamontology.org/data_1255"},"format":[{"term":"TSV","uri":"http://edamontology.org/format_3475"}]}]}],"maturity":"Mature","name":"pEffect","operating_system":["Linux"],"owner":"RostLab","publication":[{"doi":"10.1038/srep34516","metadata":{"abstract":"Type III secretion system is a key bacterial symbiosis and pathogenicity mechanism responsible for a variety of infectious diseases, ranging from food-borne illnesses to the bubonic plague. In many Gram-negative bacteria, the type III secretion system transports effector proteins into host cells, converting resources to bacterial advantage. Here we introduce a computational method that identifies type III effectors by combining homology-based inference with de novo predictions, reaching up to 3-fold higher performance than existing tools. Our work reveals that signals for recognition and transport of effectors are distributed over the entire protein sequence instead of being confined to the N-terminus, as was previously thought. Our scan of hundreds of prokaryotic genomes identified previously unknown effectors, suggesting that type III secretion may have evolved prior to the archaea/bacteria split. Crucially, our method performs well for short sequence fragments, facilitating evaluation of microbial communities and rapid identification of bacterial pathogenicity-no genome assembly required.","authors":[{"name":"Bromberg Y."},{"name":"Goldberg T."},{"name":"Rost B."}],"citationCount":33,"date":"2016-10-07T00:00:00Z","journal":"Scientific Reports","title":"Computational prediction shines light on type III secretion origins"},"pmcid":"PMC5054392","pmid":"27713481","type":["Primary"]}],"topic":[{"term":"Protein sites, features and motifs","uri":"http://edamontology.org/topic_3510"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"bioschemas":{"name":"pEffect","home":"https://bio.tools/peffect","license":"GPL-2.0","version":"0.0.1","summary":"Prediction of type III effector proteins from protein sequence.","tool_type":"sc:SoftwareApplication"},"oeb":{"metr