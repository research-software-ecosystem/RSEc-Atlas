{"tool_name":"unicycler","contents":["biocontainers","galaxy","bioschemas","debian","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"unicycler","version":"0.5.1","home":"https://github.com/rrwick/Unicycler","documentation":"https://github.com/rrwick/Unicycler/wiki","license":"GPL-3.0-or-later","summary":"Hybrid assembly pipeline for bacterial genomes.","identifiers":["biotools:unicycler","usegalaxy-eu:unicycler","doi:10.1371/journal.pcbi.1005595"],"license_file":"LICENSE","build":{"entry_points":["unicycler = unicycler.unicycler:main"],"number":5,"run_exports":[null],"script":"-m pip install . -vvv --no-deps --no-build-isolation --no-cache-dir"},"requirements":{"build":[null,null,"make"],"host":["python","pip","zlib"],"run":["python","spades >=4.0.0","blast","racon","miniasm"]},"source_url":"https://github.com/rrwick/Unicycler/archive/v0.5.1.tar.gz","test":{"commands":["COLUMNS=80 unicycler -h"]}},"biocontainers":{"name":"unicycler","identifiers":["biotools:unicycler","doi:10.1371/JOURNAL.PCBI.1005595"],"license":"GPL-3.0","summary":"A tool for assembling bacterial genomes from a combination of short (2nd generation) and long (3rd generation) sequencing reads.","home_url":"https://github.com/rrwick/Unicycler","keywords":["Chromosome Mapping","Genome, Bacterial","High-Throughput Nucleotide Sequencing","Sequence Alignment","Sequence Analysis, DNA","User-Computer Interface","Microbiology","Genomics","Sequencing","Sequence assembly","Metagenome"],"manually_check":true,"total_pulls":8295},"biotools":{"id":"unicycler","home":"https://github.com/rrwick/Unicycler","license":"GPL-3.0","summary":"A tool for assembling bacterial genomes from a combination of short (2nd generation) and long (3rd generation) sequencing reads.","addition_date":"2018-05-07T15:52:18Z","last_update_date":"2024-11-24T14:35:52.892100Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:unicycler","cost":"Free of charge","credit":[{"email":"rrwick@gmail.com","name":"Ryan R. Wick","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/rrwick/Unicycler"}],"edit_permission":{"authors":["ELIXIR-CZ","ELIXIR-EE"],"type":"group"},"function":[{"input":[{"data":{"term":"Raw sequence","uri":"http://edamontology.org/data_0848"},"format":[{"term":"Raw sequence format","uri":"http://edamontology.org/format_2571"}]}],"operation":[{"term":"Aggregation","uri":"http://edamontology.org/operation_3436"},{"term":"Genome assembly","uri":"http://edamontology.org/operation_0525"}],"output":[{"data":{"term":"Sequence assembly","uri":"http://edamontology.org/data_0925"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"},{"term":"Graph format","uri":"http://edamontology.org/format_3617"}]}]}],"maturity":"Mature","name":"Unicycler","operating_system":["Linux","Mac"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1371/journal.pcbi.1005595","metadata":{"abstract":"The Illumina DNA sequencing platform generates accurate but short reads, which can be used to produce accurate but fragmented genome assemblies. Pacific Biosciences and Oxford Nanopore Technologies DNA sequencing platforms generate long reads that can produce complete genome assemblies, but the sequencing is more expensive and error-prone. There is significant interest in combining data from these complementary sequencing technologies to generate more accurate \u201chybrid\u201d assemblies. However, few tools exist that truly leverage the benefits of both types of data, namely the accuracy of short reads and the structural resolving power of long reads. Here we present Unicycler, a new tool for assembling bacterial genomes from a combination of short and long reads, which produces assemblies that are accurate, complete and cost-effective. Unicycler builds an initial assembly graph from short reads using the de novo assembler SPAdes and then simplifies the graph using information from short and long reads. Unicycler uses a novel semi-global aligner to align long reads to the assembly graph. Tests on both synthetic and real reads show Unicycler can assemble larger contigs with fewer misassemblies than other hybrid assemblers, even when long-read depth and accuracy are low. Unicycler is open source (GPLv3) and available at github.com/rrwick/Unicycler.","authors":[{"name":"Gorrie C.L."},{"name":"Holt K.E."},{"name":"Judd L.M."},{"name":"Wick R.R."}],"citationCount":4783,"date":"2017-06-01T00:00:00Z","journal":"PLoS Computational Biology","title":"Unicycler: Resolving bacterial genome assemblies from short and long sequencing reads"},"pmcid":"PMC5481147","pmid":"28594827"}],"topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Microbiology","uri":"http://edamontology.org/topic_3301"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"bioschemas":{"name":"Unicycler","home":"https://bio.tools/unicycler","license":"GPL-3.0","summary":"A tool for assembling bacterial genomes from a combination of short (2nd generation) and long (3rd generation) sequencing reads.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"@TOOL_VERSION@+galaxy@VERSION_SUFFIX@","first_commit":"2017-05-08","conda_name":"unicycler","conda_version":"0.5.1","summary":"Unicycler is a hybrid assembly pipeline for bacterial genomes.","edam_operations":["Genome assembly","Aggregation"],"edam_topics":["Microbiology","Genomics","Sequencing","Sequence assembly"],"toolshed_categories":["Assembly"],"toolshed_id":"unicycler","users_5_years":13131,"users_all_time":16860,"usage_5_years":173465,"usage_all_time":230738,"bio_tools_summary":"A tool for assembling bacterial genomes from a combination of short (2nd generation) and long (3rd generation) sequencing reads.","bio_tools_ids":"unicycler","bio_tools_name":"Unicycler","related_tutorials":["https://training.gala