{"tool_name":"extract","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"extract","home":"https://extract.jensenlab.org/","license":"BSD-2-Clause","summary":"EXTRACT identifies genes/proteins, chemical compounds, organisms, environments, tissues, diseases, phenotypes and Gene Ontology terms mentioned in a given piece of text and maps them to their corresponding ontology/taxonomy entries.","addition_date":"2018-02-25T10:40:49Z","last_update_date":"2018-12-10T12:58:51Z","tool_type":["Web API","Web application","Web service"],"version":["2.0"],"collections":["JensenLab"],"biotools_curie":"biotools:extract","cost":"Free of charge","credit":[{"email":"lars.juhl.jensen@cpr.ku.dk","name":"Lars Juhl Jensen","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Text","uri":"http://edamontology.org/data_3671"}}],"operation":[{"term":"Text annotation","uri":"http://edamontology.org/operation_3778"}],"output":[{"data":{"term":"Annotated text","uri":"http://edamontology.org/data_3779"}}]}],"maturity":"Mature","name":"EXTRACT","operating_system":["Linux","Mac","Windows"],"owner":"larsjuhljensen","publication":[{"doi":"10.1093/database/baw005","metadata":{"abstract":"\u00a9 The Author(s) 2016.The microbial and molecular ecology research communities have made substantial progress on developing standards for annotating samples with environment metadata. However, sample manual annotation is a highly labor intensive process and requires familiarity with the terminologies used. We have therefore developed an interactive annotation tool, EXTRACT, which helps curators identify and extract standard-compliant terms for annotation of metagenomic records and other samples. Behind its web-based user interface, the system combines published methods for named entity recognition of environment, organism, tissue and disease terms. The evaluators in the BioCreative V Interactive Annotation Task found the system to be intuitive, useful, well documented and sufficiently accurate to be helpful in spotting relevant text passages and extracting organism and environment terms. Comparison of fully manual and text-mining-assisted curation revealed that EXTRACT speeds up annotation by 15-25% and helps curators to detect terms that would otherwise have been missed.","authors":[{"name":"Arvanitidis C."},{"name":"Buttigieg P.L."},{"name":"Ferrell B."},{"name":"Jensen L.J."},{"name":"Pafilis E."},{"name":"Pereira E."},{"name":"Schnetzer J."}],"citationCount":16,"date":"2016-01-01T00:00:00Z","journal":"Database","title":"EXTRACT: Interactive extraction of environment metadata and term suggestion for metagenomic sample annotation"},"pmcid":"PMC4761108","pmid":"26896844","type":["Primary"]}],"topic":[{"term":"Natural language processing","uri":"http://edamontology.org/topic_0218"}],"validated":1},"bioschemas":{"name":"EXTRACT","home":"https://bio.tools/extract","license":"BSD-2-Clause","version":"2.0","summary":"EXTRACT identifies genes/proteins, chemical compounds, organisms, environments, tissues, diseases, phenotypes and Gene Ontology terms mentioned in a given piece of text and maps them to their corresponding ontology/taxonomy entries.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:extract:2.0/rest/extract.jensenlab.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":30,"citations":[{"count":1,"year":"2019"},{"count":1,"year":"2026"},{"count":2,"year":"2024"},{"count":3,"year":"2018"},{"count":3,"year":"2022"},{"count":3,"year":"2023"},{"count":3,"year":"2025"},{"count":4,"year":"2020"},{"count":4,"year":"2021"},{"count":6,"year":"2016"}],"doi":"10.1093/databas