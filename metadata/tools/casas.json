{"tool_name":"casas","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"casas","home":"http://bbisr.shinyapps.winship.emory.edu/CASAS/","summary":"Interactive survival analysis and visualization. Perform the following types of survival analysis:  quantile, landmark and competing risks, in addition to standard survival analysis.","addition_date":"2018-08-17T09:56:42Z","last_update_date":"2018-12-10T12:59:01Z","tool_type":["Suite","Web application"],"biotools_curie":"biotools:casas","credit":[{"email":"manali.rupji@emory.edu","name":"Maintainer- Manali Rupji","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["Training material"],"url":"https://github.com/manalirupji/CASAS/blob/master/CASAS_Tutorial.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"CASAS","operating_system":["Linux","Mac","Windows"],"owner":"aotamendi.1","publication":[{"doi":"10.12688/f1000research.11830.2","metadata":{"abstract":"\u00a9 2017 Rupji M et al.We present CASAS, a shiny R based tool for interactive survival analysis and visualization of results. The tool provides a web-based one stop shop to perform the following types of survival analysis: quantile, landmark and competing risks, in addition to standard survival analysis. The interface makes it easy to perform such survival analyses and obtain results using the interactive Kaplan-Meier and cumulative incidence plots. Univariate analysis can be performed on one or several user specified variable(s) simultaneously, the results of which are displayed in a single table that includes log rank p-values and hazard ratios along with their significance. For several quantile survival analyses from multiple cancer types, a single summary grid is constructed. The CASAS package has been implemented in R and is available via http://shinygispa.winship.emory.edu/CASAS/. The developmental repository is available at https://github.com/manalirupji/CASAS/.","authors":[{"name":"Kowalski J."},{"name":"Rupji M."},{"name":"Zhang X."}],"citationCount":8,"date":"2017-01-01T00:00:00Z","journal":"F1000Research","title":"CASAS: Cancer Survival Analysis Suite, a web based application"},"type":["Primary"]}],"topic":[{"term":"Experimental design and studies","uri":"http://edamontology.org/topic_3678"}],"validated":1},"bioschemas":{"name":"CASAS","home":"https://bio.tools/casas","summary":"Interactive survival analysis and visualization. Perform the following types of survival analysis:  quantile, landmark and competing risks, in addition to standard survival analysis.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:casas/suite/bbisr.shinyapps.winship.emory.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"training_material":true},"publications":[{"entries":[{"cit_count":12,"citations":[{"count":1,"year":"2018"},{"count":1,"year":"2021"},{"count":1,"year":"2023"},{"count":1,"year":"2024"},{"count":2,"year":"2020"},{"count":3,"year":"2019"},{"count":3,"year":"2022"}],"doi":"10.12688/f1000research.11830.2","pmcid":"PMC5580407","pmid":"28928946","ref_count":5,"refs":[{"count":1,"year":"1983"},{"count":1,"year":"2007"},{"count":1,"year":"2010"},{"count":1,"year":"2014"},{"count":1,"year":"2017"}],"title":"CASAS: Cancer Survival Analysis Suite, a web based application.","year":2017}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":500,"redirects":[{"status":302,"u