resolve_time":null}}}]},"galaxy":{"version":"2.9.10","first_commit":"2021-01-27","conda_name":"strelka","conda_version":"2.9.10","summary":"Strelka2 is a fast and accurate small variant caller optimizedfor analysis of germline variation in small cohorts and somaticvariation in tumor/normal sample pairs. The germline caller employs anefficient tiered haplotype model to improve accuracy and provide read-backedphasing, adaptively selecting between assembly and a faster alignment-basedhaplotyping approach at each variant locus. The germline caller also analyzesinput sequencing data using a mixture-model indel error estimation method toimprove robustness to indel noise. The somatic calling model improves on theoriginal Strelka method for liquid and late-stage tumor analysis by accountingfor possible tumor cell contamination in the normal sample. A final empiricalvariant re-scoring step using random forest models trained on various callquality features has been added to both callers to further improve precision.","edam_operations":[],"edam_topics":[],"toolshed_categories":["Variant Analysis"],"toolshed_id":"strelka","users_5_years":430,"users_all_time":430,"usage_5_years":2982,"usage_all_time":2982,"related_tutorials":[],"related_workflows":[{"create_time":"2021-04-24","latest_version":"4","link":"https://usegalaxy.eu/published/workflow?id=ddd604341afd9cf7","name":"Strelka MIRACUM - main"}],"tool_ids":["strelka_germline","strelka_somatic"],"tool_output_formats":["vcf","bed"],"homepage":"https://github.com/Illumina/strelka/","suite_source":"https://github.com/galaxyproject/tools-iuc/tree/main/tools/strelka","suite_owner":"iuc","suite_parsed_folder":"https://github.com/galaxyproject/tools-iuc/tree/master/tools/strelka","suite_version_status":"Up-to-date","no_of_tools":{"eu":2,"org":2,"org.au":0,"be":2,"cz":2,"fr":0,"no":0,"chemflow":0,"aubi":0,"pasteur":0,"trakr":0,"hyphy":0,"ipk":0,"immport":0,"interactomix":0,"lebanese":0,"mbac":0,"mississippi":0,"mandoiu":0,"oqtans":0,"palfinder":0,"pepsimili":0,"phagepromotor":0,"vvv":0},"runs_by_server":{"eu":992,"fr":0,"org":1990,"org.au":0,"eu_5_years":992,"fr_5_years":0,"org_5_years":1990,"org.au_5_years":0},"users_by_server":{"eu":88,"fr":0,"org":342,"org.au":0,"eu_5_years":88,"fr_5_years":0,"org_5_years":342,"org.au_5_years":0}},"debian":{"package":"strelka","distribution":"prospective","release":"vcs","component":"main","version":"2.9.10","source":"strelka","homepage":"https://github.com/Illumina/strelka/","license":"GPL-3+","blend":"debian-med","registries":[{"entry":"strelka","name":"conda:bioconda"}],"bib":[{"key":"doi","value":"10.1038/s41592-018-0051-x"}],"descr":[{"package":"strelka","description":"strelka2 germline and somatic small variant caller","long_description":" Strelka2 is a fast and accurate small variant caller optimized for\n analysis of germline variation in small cohorts and somatic variation in\n tumor/normal sample pairs. The germline caller employs an efficient\n tiered haplotype model to improve accuracy and provide read-backed\n phasing, adaptively selecting between assembly and a faster alignment-\n based haplotyping approach at each variant locus. The germline caller\n also analyzes input sequencing data using a mixture-model indel error\n estimation method to improve robustness to indel noise. The somatic\n calling model improves on the original Strelka method for liquid and late-\n stage tumor analysis by accounting for possible tumor cell contamination\n in the normal sample. A final empirical variant re-scoring step using\n random forest models trained on various call quality features has been\n added to both callers to further improve precision.","release":"vcs","license":"GPL-3+","blend":"debian-med"}],"summary":"strelka2 germline and somatic small variant caller"}}}