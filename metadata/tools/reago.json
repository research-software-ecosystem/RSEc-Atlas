{"tool_name":"reago","contents":["biocontainers","galaxy","bioschemas","biotools","oeb"],"fetched_metadata":{"biocontainers":{"name":"reago","identifiers":["biotools:reago","doi:10.1093/bioinformatics/btv231"],"license":"Apache-2.0","summary":"An assembly tool for 16S ribosomal RNA recovery from metagenomic data","home_url":"https://github.com/chengyuan/reago-1.1","keywords":["Computational Biology","Databases, Nucleic Acid","Genes, rRNA","Metagenomics","Microbiota","Phylogeny","RNA, Bacterial","RNA, Ribosomal, 16S","Sequence Analysis, RNA","Sequence assembly","RNA","Microbiology"],"manually_check":true,"total_pulls":0},"biotools":{"id":"reago","home":"https://github.com/chengyuan/reago-1.1","summary":"This is an assembly tool for 16S ribosomal RNA recovery from metagenomic data.","addition_date":"2017-08-03T18:57:38Z","last_update_date":"2024-11-24T14:35:46.175076Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:reago","credit":[{"typeEntity":"Person","typeRole":["Primary contact"],"url":"https://github.com/chengyuan"}],"documentation":[{"type":["General"],"url":"https://github.com/chengyuan/reago-1.1"},{"type":["User manual"],"url":"https://github.com/chengyuan/reago-1.1#manual"}],"edit_permission":{"authors":["paulzierep"],"type":"group"},"function":[{"operation":[{"term":"Sequence assembly","uri":"http://edamontology.org/operation_0310"}]}],"name":"REAGO","operating_system":["Linux"],"owner":"mbs_import","publication":[{"doi":"10.1093/bioinformatics/btv231","metadata":{"abstract":"Metagenomic data, which contains sequenced DNA reads of uncultured microbial species from environmental samples, provide a unique opportunity to thoroughly analyze microbial species that have never been identified before. Reconstructing 16S ribosomal RNA, a phylogenetic marker gene, is usually required to analyze the composition of the metagenomic data. However, massive volume of dataset, high sequence similarity between related species, skewed microbial abundance and lack of reference genes make 16S rRNA reconstruction difficult. Generic de novo assembly tools are not optimized for assembling 16S rRNA genes. In this work, we introduce a targeted rRNA assembly tool, REAGO (REconstruct 16S ribosomal RNA Genes from metagenOmic data). It addresses the above challenges by combining secondary structure-aware homology search, zproperties of rRNA genes and de novo assembly. Our experimental results show that our tool can correctly recover more rRNA genes than several popular generic metagenomic assembly tools and specially designed rRNA construction tools.","authors":[{"name":"Cole J."},{"name":"Lei J."},{"name":"Sun Y."},{"name":"Yuan C."}],"citationCount":97,"date":"2015-06-15T00:00:00Z","journal":"Bioinformatics","title":"Reconstructing 16S rRNA genes in metagenomic data"},"pmcid":"PMC4765874","pmid":"26072503"}],"topic":[{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Microbiology","uri":"http://edamontology.org/topic_3301"},{"term":"RNA","uri":"http://edamontology.org/topic_0099"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"}],"validated":1},"bioschemas":{"name":"REAGO","home":"https://bio.tools/reago","summary":"This is an assembly tool for 16S ribosomal RNA recovery from metagenomic data.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"@TOOL_VERSION@+galaxy@VERSION_SUFFIX@","first_commit":"2015-12-09","conda_name":"reago","conda_version":"1.1","summary":"Reago is tool to assembly 16S ribosomal RNA recovery from metagenomic data.","edam_operations":["Sequence assembly"],"edam_topics":["Sequence assembly","RNA","Metagenomics","Microbiology"],"toolshed_categories":["Metagenomics","RNA"],"toolshed_id":"reago","users_5_years":7,"users_all_time":7,"usage_5_years":18,"usage_all_time":18,"bio_tools_summary":"This is an assembly tool for 16S ribosomal RNA recovery from metagenomic data.","bio_tools_ids":"reago","bio_tools_name":"REAGO","related_tutorials":[],"related_workflows