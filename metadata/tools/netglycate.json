{"tool_name":"netglycate","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"netglycate","home":"http://cbs.dtu.dk/services/NetGlycate/","license":"Other","summary":"Prediction of glycation of amino groups of lysines in mammalian proteins.","addition_date":"2015-06-29T10:15:15Z","last_update_date":"2018-12-16T14:42:23Z","tool_type":["Web application","Web service"],"version":["1.0"],"biotools_curie":"biotools:netglycate","cost":"Free of charge (with restrictions)","credit":[{"email":"soren.brunak@cpr.ku.dk","name":"S\u00f8ren Brunak","orcidid":"http://orcid.org/0000-0003-0316-5866","typeEntity":"Person"},{"email":"mbj@cbs.dtu.dk","name":"Morten Bo Johansen","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"CBS","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["General"],"url":"http://www.cbs.dtu.dk/services/NetGlycate/instructions.php"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Sequence","uri":"http://edamontology.org/data_2044"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}],"note":"predicts glycation of amino groups of lysines in mammalian proteins","operation":[{"term":"Prediction and recognition","uri":"http://edamontology.org/operation_2423"}],"output":[{"data":{"term":"Protein features","uri":"http://edamontology.org/data_1277"},"format":[{"term":"GIF","uri":"http://edamontology.org/format_3467"}]},{"data":{"term":"Sequence report","uri":"http://edamontology.org/data_2955"},"format":[{"term":"Binary format","uri":"http://edamontology.org/format_2333"}]}]}],"maturity":"Emerging","name":"NetGlycate","operating_system":["Linux"],"owner":"CBS","publication":[{"doi":"10.1093/glycob/cwl009","metadata":{"abstract":"Glycation is a nonenzymatic process in which proteins react with reducing sugar molecules and thereby impair the function and change the characteristics of the proteins. Glycation is involved in diabetes and aging where the accumulation of glycation products causes side effects. In this study, we statistically investigate the glycation of \u03b5 amino groups of lysines and also train a sequence-based predictor. The statistical analysis suggests that acidic amino acids, mainly glutamate, and lysine residues catalyze the glycation of nearby lysines. The catalytic acidic amino acids are found mainly C-terminally from the glycation site, whereas the basic lysine residues are found mainly N-terminally. The predictor was made by combining 60 artificial neural networks in a balloting procedure. The cross-validated Matthews correlation coefficient for the predictor is 0.58, which is quite impressive given the relatively small amount of experimental data available. The method is made available at www.cbs.dtu.dk/services/ NetGlycate-1.0. \u00a9 Copyright 2006 Oxford University Press.","authors":[{"name":"Brunak S."},{"name":"Johansen M.B."},{"name":"Kiemer L."}],"citationCount":140,"date":"2006-09-01T00:00:00Z","journal":"Glycobiology","title":"Analysis and prediction of mammalian protein glycation"},"pmid":"16762979","type":["Primary"]}],"topic":[{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"bioschemas":{"name":"NetGlycate","home":"https://bio.tools/netglycate","license":"Other","version":"1.0","summary":"Prediction of glycation of amino groups of lysines in mammalian proteins.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:netglycate:1.0/soap/cbs.dtu.dk","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":65,"citations":[{"count":1,"year":"2008"},{"count":1,"year":"2010"},{"count":1,"year":"2023"},{"count":2,"year":"2012"},{"count":2,"year":"2015"},{"count":2,"year":"2016