{"tool_name":"cncrnadb","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"cncrnadb","home":"http://www.rna-society.org/cncrnadb/","summary":"cncRNAdb is a manually curated resource of experimentally supported RNAs with both protein-coding and noncoding function.","addition_date":"2021-01-18T11:15:26Z","last_update_date":"2024-11-24T20:43:49.011526Z","tool_type":["Database portal","Web API"],"biotools_curie":"biotools:cncrnadb","credit":[{"email":"wangdong79@smu.edu.cn","typeEntity":"Person"},{"email":"wangdong@ems.hrbmu.edu.cn","typeEntity":"Person"},{"email":"yongzhangcn@foxmail.com","typeEntity":"Person"},{"email":"zhy1001@alu.uestc.edu.cn","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Expression analysis","uri":"http://edamontology.org/operation_2495"},{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"},{"term":"trans-regulatory element prediction","uri":"http://edamontology.org/operation_0443"}]}],"name":"cncRNAdb","owner":"Kigaard","publication":[{"doi":"10.1093/nar/gkaa791","metadata":{"abstract":"RNA endowed with both protein-coding and noncoding functions is referred to as 'dual-function RNA', 'binary functional RNA (bifunctional RNA)' or 'cncRNA (coding and noncoding RNA)'. Recently, an increasing number of cncRNAs have been identified, including both translated ncRNAs (ncRNAs with coding functions) and untranslated mRNAs (mRNAs with noncoding functions). However, an appropriate database for storing and organizing cncRNAs is still lacking. Here, we developed cncRNAdb, a manually curated database of experimentally supported cncRNAs, which aims to provide a resource for efficient manipulation, browsing and analysis of cncRNAs. The current version of cncRNAdb documents about 2600 manually curated entries of cncRNA functions with experimental evidence, involving more than 2,000 RNAs (including over 1300 translated ncRNAs and over 600 untranslated mRNAs) across over 20 species. In summary, we believe that cncRNAdb will help elucidate the functions and mechanisms of cncRNAs and develop new prediction methods. The database is available at http://www.rna-society.org/cncrnadb/.","authors":[{"name":"Cui T."},{"name":"Feng Y."},{"name":"Gong J."},{"name":"Huang Y."},{"name":"Li W."},{"name":"Li Y."},{"name":"Liu T."},{"name":"Luo J."},{"name":"Ning L."},{"name":"Wang D."},{"name":"Wang H."},{"name":"Wang J."},{"name":"Zhang Y."},{"name":"Zhang Y."},{"name":"Zhao Y."}],"citationCount":48,"date":"2021-01-08T00:00:00Z","journal":"Nucleic Acids Research","title":"cncRNAdb: A manually curated resource of experimentally supported RNAs with both protein-coding and noncoding function"},"pmcid":"PMC7778915","pmid":"33010163"}],"topic":[{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"Protein expression","uri":"http://edamontology.org/topic_0108"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}]},"bioschemas":{"name":"cncRNAdb","home":"https://bio.tools/cncrnadb","summary":"cncRNAdb is a manually curated resource of experimentally supported RNAs with both protein-coding and noncoding function.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:cncrnadb/db/www.rna-society.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":42,"citations":[{"count":3,"year":"2021"},{"count":3,"year":"2026"},{"count":4,"year":"2025"},{"count":8,"year":"2023"},{"count":10,"year":"2024"},{"count":14,"year":"2022"}],"doi":"10.1093/nar/gkaa791","pmcid":"PMC7778915","pmid":"33010163","ref_count":53,"refs":[{"count":1,"year":"1970"},{"cou