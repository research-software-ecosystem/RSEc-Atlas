{"tool_name":"maestroweb","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"maestroweb","home":"https://pbwww.services.came.sbg.ac.at/maestro/web","summary":"MAESTRO-web is web interface to MAESTRO, a Multi AgEnt STability pRedictiOn tool for calculating changes in unfolding free energy upon point mutation. MAESTRO is structure based, which means that the 3-d structure of the wild type is required. It is able to predict single- and multi-point in monomeric and multimeric proteins. In addition, MAESTROweb provides mutation sensitivity profiles, a scanner for the most (de)stabilizing mutations and potential S-S bonds sites.","addition_date":"2021-06-16T14:52:41Z","last_update_date":"2021-06-16T14:55:08Z","tool_type":["Web service"],"biotools_curie":"biotools:maestroweb","edit_permission":{"type":"private"},"name":"MAESTROweb","owner":"lacknerpeter","topic":[{"term":"Computational biology","uri":"http://edamontology.org/topic_3307"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:maestroweb/soap/pbwww.services.came.sbg.ac.at","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/maestroweb","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}}]}}}