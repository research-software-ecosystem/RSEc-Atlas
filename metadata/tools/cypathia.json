{"tool_name":"cypathia","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"cypathia","home":"https://apps.cytoscape.org/apps/cypathia","summary":"CyPathia is a cytoscape app, that provides a user friendly and straightforward interface. The CyPathia app is based on Hipathia Bioconductor package, allowing the Cytoscape community the possibility of using mechanistic models.","addition_date":"2022-03-11T15:04:49.944141Z","last_update_date":"2022-03-14T12:09:15.981206Z","tool_type":["Plug-in"],"version":["1.0.0"],"collections":["Cytoscape app","pathway or network visualisation"],"accessibility":"Open access","biotools_curie":"biotools:cypathia","cost":"Free of charge","credit":[{"email":"joaquin.dopazo@juntadeandalucia.es","name":"Joaquin Dopazo","orcidid":"https://orcid.org/0000-0003-3318-120X","url":"https://www.clinbioinfosspa.es/"},{"email":"kinza.rian@juntadeandalucia.es","name":"Kinza Rian","orcidid":"https://orcid.org/0000-0003-4314-7208","url":"https://www.clinbioinfosspa.es/people"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Gene expression profile","uri":"http://edamontology.org/data_0928"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]},{"data":{"term":"Raw microarray data","uri":"http://edamontology.org/data_3110"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}],"operation":[{"term":"Network analysis","uri":"http://edamontology.org/operation_3927"},{"term":"Pathway analysis","uri":"http://edamontology.org/operation_3928"}],"output":[{"data":{"term":"Pathway or network","uri":"http://edamontology.org/data_2600"},"format":[{"term":"Biological pathway or network format","uri":"http://edamontology.org/format_2013"}]},{"data":{"term":"Pathway or network report","uri":"http://edamontology.org/data_2984"},"format":[{"term":"Biological pathway or network report format","uri":"http://edamontology.org/format_3166"}]}]}],"maturity":"Emergi