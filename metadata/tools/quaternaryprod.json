{"tool_name":"quaternaryprod","contents":["bioconda","oeb","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-quaternaryprod","version":"1.44.0","home":"https://bioconductor.org/packages/3.22/bioc/html/QuaternaryProd.html","license":"GPL (>=3)","summary":"Computes the Quaternary Dot Product Scoring Statistic for Signed and Unsigned Causal Graphs","identifiers":["biotools:quaternaryprod"],"description":"QuaternaryProd is an R package that performs causal reasoning on biological networks, including publicly available networks such as STRINGdb. QuaternaryProd is an open-source alternative to commercial products such as Inginuity Pathway Analysis. For a given a set of differentially expressed genes, QuaternaryProd computes the significance of upstream regulators in the network by performing causal reasoning using the Quaternary Dot Product Scoring Statistic (Quaternary Statistic), Ternary Dot product Scoring Statistic (Ternary Statistic) and Fisher's exact test (Enrichment test). The Quaternary Statistic handles signed, unsigned and ambiguous edges in the network. Ambiguity arises when the direction of causality is unknown, or when the source node (e.g., a protein) has edges with conflicting signs for the same target gene. On the other hand, the Ternary Statistic provides causal reasoning using the signed and unambiguous edges only. The Vignette provides more details on the Quaternary Statistic and illustrates an example of how to perform causal reasoning using STRINGdb.","license_file":"/lib/R/share/licenses/GPL-3","build":{"number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"build":[null,null,"make"],"host":["r-base","r-dplyr","r-rcpp >=0.11.3","r-yaml >=2.1.18","libblas","liblapack","zlib","liblzma-devel"],"run":["r-base","r-dplyr","r-rcpp >=0.11.3","r-yaml >=2.1.18"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/QuaternaryProd_1.44.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/QuaternaryProd/QuaternaryProd_1.44.0.tar.gz","https://bioarchive.galaxyproject.org/QuaternaryProd_1.44.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-quaternaryprod/bioconductor-quaternaryprod_1.44.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('QuaternaryProd')\""]},"parent_recipe":{"name":"bioconductor-quaternaryprod","path":"recipes/bioconductor-quaternaryprod","version":"1.14.0"}},"biotools":{"id":"quaternaryprod","home":"https://bioconductor.org/packages/QuaternaryProd","license":"GPL-3.0","summary":"QuaternaryProd is an R package that performs causal reasoning on biological networks, including publicly available networks such as STRINGdb. QuaternaryProd is an open-source alternative to commercial products such as Inginuity Pathway Analysis. For a given a set of differentially expressed genes, QuaternaryProd computes the significance of upstream regulators in the network by performing causal reasoning using the Quaternary Dot Product Scoring Statistic (Quaternary Statistic), Ternary Dot product Scoring Statistic (Ternary Statistic) and Fisher's exact test (Enrichment test). The Quaternary Statistic handles signed, unsigned and ambiguous edges in the network. Ambiguity arises when the direction of causality is unknown, or when the source node (e.g., a protein) has edges with conflicting signs for the same target gene. On the other hand, the Ternary Statistic provides causal reasoning using the signed and unambiguous edges only. The Vignette provides more details on the Quaternary Statistic and illustrates an example of how to perform causal reasoning using STRINGdb.","addition_date":"2017-01-17T15:03:28Z","last_update_date":"2019-01-09T16:14:52Z","tool_type":["Command-line tool","Library"],"version":["1.46.0"],"collections":["BioConductor"],"biotools_curie":"biotools:quaternaryprod","credit":[{"name":"Ping Chen"},{"name":"Carl Tony Fakhry","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Kourosh Zarringhalam","t