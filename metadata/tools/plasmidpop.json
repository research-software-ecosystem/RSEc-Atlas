{"tool_name":"plasmidpop","contents":["biotools"],"identifiers":["biotools:plasmidpop"],"fetched_metadata":{"biotools":{"id":"plasmidpop","home":"https://booneandrewslab.github.io/PlasmidPop/","license":"MIT","summary":"Free browser-based DNA sequence editor and plasmid viewer. Opens, edits and saves GenBank, FASTA and SnapGene files and AB1/FASTQ sequencing reads; shows linear and circular maps; finds restriction sites, ORFs and CRISPR guides; designs and checks primers; aligns sequences and reads; and simulates cloning (restriction/ligation, Gibson, Golden Gate, Gateway). Everything runs in the browser: no account, no install, and files never leave the user\u2019s device. Free and open source (MIT), a browser-based alternative to desktop plasmid editors such as SnapGene, ApE and Serial Cloner.","addition_date":"2026-10-18T01:53:02.214025Z","last_update_date":"2026-11-19T15:18:51.502396Z","tool_type":["Web application"],"version":["1.16.0","1.21.0","1.22.0","1.25.0"],"accessibility":"Open access","biotools_curie":"biotools:plasmidpop","cost":"Free of charge","credit":[{"email":"m.usaj@utoronto.ca","name":"Matej Usaj","orcidid":"https://orcid.org/0000-0003-0675-2847","typeEntity":"Person","typeRole":["Developer","Primary contact"]},{"name":"The Donnelly Centre, University of Toronto","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["Citation instructions"],"url":"https://github.com/BooneAndrewsLab/PlasmidPop/blob/main/CITATION.cff"},{"type":["User manual"],"url":"https://booneandrewslab.github.io/PlasmidPop/guide/"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Nucleic acid sequence record","uri":"http://edamontology.org/data_2887"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"},{"term":"GenBank format","uri":"http://edamontology.org/format_1936"}]},{"data":{"term":"Protein sequence record","uri":"http://edamontology.org/data_2886"},"format":[{"term":"FASTA","uri":"http://edamontology