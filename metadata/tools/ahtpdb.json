{"tool_name":"ahtpdb","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"ahtpdb","home":"https://webs.iiitd.edu.in/raghava/ahtpdb/","summary":"Manually curated database of experimentally validated Antihypertensive peptides (AHTPs) with comprehensive information  that includes: sequence, inhibitory concentration (IC50), log value of inhibitory concentration (pIC50) and toxicity.","addition_date":"2018-05-10T16:22:43Z","last_update_date":"2024-11-24T15:37:18.355292Z","tool_type":["Database portal"],"biotools_curie":"biotools:ahtpdb","credit":[{"email":"raghava@imtech.res.in","name":"DR. Gajendra P. S. Raghava","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://crdd.osdd.net/raghava/"}],"documentation":[{"type":["General"],"url":"http://crdd.osdd.net/raghava/ahtpdb/info2.php"},{"type":["User manual"],"url":"http://crdd.osdd.net/raghava/ahtpdb/main_help.php"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Annotation","uri":"http://edamontology.org/operation_0226"}]},{"operation":[{"term":"Data handling","uri":"http://edamontology.org/operation_2409"}]}],"name":"AHTPDB","owner":"raghavagps","publication":[{"doi":"10.1093/nar/gku1141","metadata":{"abstract":"AHTPDB (http://crdd.osdd.net/raghava/ahtpdb/) is a manually curated database of experimentally validated antihypertensive peptides. Information pertaining to peptides with antihypertensive activity was collected from research articles and from various peptide repositories. These peptides were derived from 35 major sources that include milk, egg, fish, pork, chicken, soybean, etc. In AHTPDB, most of the peptides belong to a family of angiotensin-I converting enzyme inhibiting peptides. The current release of AHTPDB contains 5978 peptide entries among which 1694 are unique peptides. Each entry provides detailed information about a peptide like sequence, inhibitory concentration (IC50), toxicity/bitterness value, source, length, molecular mass and information related to purification of peptides. In addition, the database provides structural information of these peptides that includes predicted tertiary and secondary structures. A user-friendly web interface with various tools has been developed to retrieve and analyse the data. It is anticipated that AHTPDB will be a useful and unique resource for the researchers working in the field of antihypertensive peptides.","authors":[{"name":"Chaudhary K."},{"name":"Chauhan J.S."},{"name":"Gautam A."},{"name":"Kumar R."},{"name":"Nagpal G."},{"name":"Raghava G.P.S."},{"name":"Sharma M."},{"name":"Singh S."}],"citationCount":154,"date":"2015-01-28T00:00:00Z","journal":"Nucleic Acids Research","title":"AHTPDB: A comprehensive platform for analysis and presentation of antihypertensive peptides"},"pmcid":"PMC4383949","pmid":"25392419"}],"topic":[{"term":"Medicines research and development","uri":"http://edamontology.org/topic_3376"},{"term":"Pharmacology","uri":"http://edamontology.org/topic_0202"}],"validated":1},"bioschemas":{"name":"AHTPDB","home":"https://bio.tools/ahtpdb","summary":"Manually curated database of experimentally validated Antihypertensive peptides (AHTPs) with comprehensive information  that includes: sequence, inhibitory concentration (IC50), log value of inhibitory concentration (pIC50) and toxicity.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ahtpdb/db/webs.iiitd.edu.in","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true,"manual":true},"publications":[{"entries":[{"cit_count":73,"citations":[{"count":1,"year":"-1"},{"count":2,"year":"2020"},{"count":3,"year":"2016"},{"count":4,"year":"2017"},{"count":5,"year":"2015"},{"count":5,"year":"2024"},{"count":5,"year":"2026"},{"count":6,"year":"2018"},{"count":6,"year":"2025"},{"count":7,"year":"2019"},{"count