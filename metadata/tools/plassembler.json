{"tool_name":"plassembler","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"plassembler","version":"1.8.3","home":"https://github.com/gbouras13/plassembler","documentation":"https://plassembler.readthedocs.io/en/latest","license":"MIT","summary":"Quickly and accurately assemble plasmids in hybrid sequenced bacterial isolates.","identifiers":["doi:10.1093/bioinformatics/btad409","biotools:plassembler"],"license_file":"LICENSE","build":{"entry_points":["plassembler = plassembler:main"],"noarch":"python","number":0,"run_exports":[null],"script":"-m pip install . --no-deps --no-build-isolation --no-cache-dir -vvv"},"requirements":{"host":["python >=3.8,<3.14","hatchling","pip"],"run":["python >=3.8,<3.14","flye >=2.9","minimap2 >=2.11","fastp >=0.24.2","chopper >=0.5.0","mash >=2.2","unicycler >=0.4.8","raven-assembler >=1.8","samtools >=0.15.0","click >=8.0.0","loguru >=0.5.3","pysam >=0.16.0","pyyaml >=6.0","pandas >=1.4.2","biopython >=1.76","alive-progress >=3.0.1","requests >=2.25.1","canu >=2.2","dnaapler >=0.4.0"]},"source_url":"https://pypi.io/packages/source/p/plassembler/plassembler-1.8.3.tar.gz","test":{"commands":["plassembler --help"],"imports":["plassembler"]},"recipe_maintainers":["gbouras13"]},"biotools":{"id":"plassembler","home":"https://github.com/gbouras13/plassembler","license":"MIT","summary":"Automated bacterial plasmid assembly tool.","addition_date":"2024-02-09T09:09:39.033498Z","last_update_date":"2024-11-24T14:17:23.119003Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:plassembler","cost":"Free of charge","credit":[{"email":"george.bouras@adelaide.edu.au","name":"George Bouras","orcidid":"https://orcid.org/0000-0002-5885-4186","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Read mapping","uri":"http://edamontology.org/operation_3198"},{"term":"Sequence assembly","uri":"http://edamontology.org/operation_0310"},{"term":"Sequence trimming","uri":"http://edamontology.org/operation_3192"}]}],"name":"plassembler","operating_system":["Linux","Mac"],"owner":"Pub2Tools","publication":[{"doi":"10.1093/bioinformatics/btad409","metadata":{"abstract":"With recent advances in sequencing technologies, it is now possible to obtain near-perfect complete bacterial chromosome assemblies cheaply and efficiently by combining a long-read-first assembly approach with short-read polishing. However, existing methods for assembling bacterial plasmids from long-read-first assemblies often misassemble or even miss bacterial plasmids entirely and accordingly require manual curation. Plassembler was developed to provide a tool that automatically assembles and outputs bacterial plasmids using a hybrid assembly approach. It achieves increased accuracy and computational efficiency compared to the existing gold standard tool Unicycler by removing chromosomal reads from the input read sets using a mapping approach.","authors":[{"name":"Bouras G."},{"name":"Mallawaarachchi V."},{"name":"Sheppard A.E."},{"name":"Vreugde S."}],"citationCount":11,"date":"2023-07-01T00:00:00Z","journal":"Bioinformatics","title":"Plassembler: an automated bacterial plasmid assembly tool"},"pmcid":"PMC10326302","pmid":"37369026"}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Mobile genetic elements","uri":"http://edamontology.org/topic_0798"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"}]},"bioschemas":{"name":"plassembler","home":"https://bio.tools/plassembler","license":"MIT","summary":"Automated bacterial plasmid assembly tool.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:plassembler/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false,"