{"tool_name":"orthodb","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"orthodb","version":"0.9.1","home":"https://www.ezlab.org/orthodb_v12_userguide.html","documentation":"https://www.ezlab.org/orthodb_v12_userguide.html#api","license":"GPL3","summary":"Interface to OrthoDB REST API.","identifiers":["biotools:orthodb","doi:10.1093/nar/gkac996","PMID:36350662"],"description":"Python interface to OrthoDB REST API with some additional functionality.","license_file":"LICENSE","build":{"noarch":"python","number":0,"run_exports":[null]},"requirements":{"build":["python >=3.7","pip","setuptools"],"host":["python >=3.7","pip","setuptools"],"run":["python >=3.7","requests"]},"source_url":"https://gitlab.com/ezlab/orthodb_py/-/archive/0.9.1/orthodb_py-0.9.1.tar.gz","test":{"commands":["python -c 'import orthodb'","python -c 'from orthodb import OdbAPI'"]},"recipe_maintainers":["ftegenfe"]},"biotools":{"id":"orthodb","home":"http://www.orthodb.org/","summary":"Catalog of eukaryotic orthologous protein-coding genes. OrthoDB explicitly delineates orthologs at each radiation along the species phylogeny. Available protein descriptors, together with Gene Ontology and InterPro attributes, serve to provide general descriptive annotations of the orthologous groups, and facilitate comprehensive database querying. Data sources include proteomes from arthropods, fungi, vertebrates and basal metazoans.","addition_date":"2015-01-21T13:30:06Z","last_update_date":"2024-11-25T14:20:48.389878Z","tool_type":["Database portal"],"biotools_curie":"biotools:orthodb","credit":[{"email":"Evgeny.Zdobnov@isb-sib.ch","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"SIB Swiss Institute of Bioinformatics","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["User manual"],"url":"http://www.orthodb.org/?page=help"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene functional annotation","uri":"http://edamontology.org/operation_3672"},{"term":"Protein function analysis","uri":"http://edamontology.org/operation_2414"}]}],"name":"OrthoDB","operating_system":["Linux","Mac","Windows"],"owner":"SIB","publication":[{"doi":"10.1093/nar/gkw1119","metadata":{"abstract":"OrthoDB is a comprehensive catalog of orthologs, genes inherited by extant species from a single gene in their last common ancestor. In 2016 OrthoDB reached its 9th release, growing to over 22 million genes from over 5000 species, now adding plants, archaea and viruses. In this update we focused on usability of this fast-growing wealth of data: updating the user and programmatic interfaces to browse and query the data, and further enhancing the already extensive integration of available gene functional annotations. Collating functional annotations from over 100 resources, and enabled us to propose descriptive titles for 87% of ortholog groups. Additionally, OrthoDB continues to provide computed evolutionary annotations and to allow user queries by sequence homology. The OrthoDB resource now enables users to generate publication-quality comparative genomics charts, as well as to upload, analyze and interactively explore their own private data. OrthoDB is available from http://orthodb.org.","authors":[{"name":"Ioannidis P."},{"name":"Kriventseva E.V."},{"name":"Kuznetsov D."},{"name":"Loetscher A."},{"name":"Seppey M."},{"name":"Simao F.A."},{"name":"Tegenfeldt F."},{"name":"Waterhouse R.M."},{"name":"Zdobnov E.M."}],"citationCount":326,"date":"2017-01-01T00:00:00Z","journal":"Nucleic Acids Research","title":"OrthoDB v9.1: Cataloging evolutionary and functional annotations for animal, fungal, plant, archaeal, bacterial and viral orthologs"},"pmcid":"PMC5210582","pmid":"27899580","type":["Primary"]}],"topic":[{"term":"Evolutionary biology","uri":"http://edamontology.org/topic_3299"},{"term":"Function analysis","uri":"http://edamontology.org/topic_1775"},{"term":"Gene and protein families","uri":"http://edamontology.org/topic_0623"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"},{"term":"Phylogeny","uri":"http://edamontology.org/topic_0084"}],"validated":1},"bioschemas":{"name":"OrthoDB","home":"https://bio.tools/orthodb","summary":"Catalog of eukaryotic orthologous protein-coding genes. OrthoDB explicitly delineates orthologs at each radiation along the species phylogeny. Available protein descriptors, together with Gene Ontology and InterPro attributes, serve to provide general descriptive annotations of the orthologous groups, and facilitate comprehensive database querying. Data sources include proteomes from arthropods, fungi, vertebrates and basal metazoans.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:orthodb/db/www.orthodb.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"manual":true},"publications":[{"entries":[{"cit_count":252,"citations":[{"count":4,"year":"2026"},{"count":9,"year":"2025"},{"count":12,"year":"2017"},{"count":12,"year":"2024"},{"count":16,"year":"2023"},{"count":19,"year":"2022"},{"count":38,"year":"2018"},{"count":41,"year":"2020"},{"count":43,"year":"2021"},{"count":58,"year":"2019"}],"doi":"10.1093/nar/gkw1119","pmcid":"PMC5210582","pmid":"27899580","ref_count":34,"refs":[{"count":1,"year":"-1"},{"count":1,"year":"2000"},{"count":1,"year":"2006"},{"count":1,"year":"2008"},{"count":1,"year":"2011"},{"count":1,"year":"2016"},{"count":2,"year":"2005"},{"count":2,"year":"2010"},{"count":3,"year":"2007"},{"count":3,"year":"2009"},{"count":3,"year":"2013"},{"count":6,"year":"2014"},{"count":9,"year":"2015"}],"title":"OrthoDB v9.1: cataloging evolutionary and functional annotations for animal, fungal, plant, archaeal, bacterial and viral orthologs.","year":2016}]}],"