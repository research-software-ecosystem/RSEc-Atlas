"year":"2002"},{"count":2,"year":"2003"},{"count":3,"year":"2000"},{"count":3,"year":"2004"},{"count":4,"year":"2005"},{"count":5,"year":"2008"},{"count":6,"year":"2006"},{"count":7,"year":"2007"}],"title":"Gene-boosted assembly of a novel bacterial genome from very short reads.","year":2008}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":403,"redirects":[{"status":301,"url":"https://amos.sourceforge.net/docs/pipeline/abba.html"}],"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/abba","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":200,"redirects":[{"status":302,"url":"http://www.biofacebook.com/?p=250/wp-admin/install.php"},{"status":302,"url":"http://www.biofacebook.com/?p=250/wp-admin/install.php"},{"status":302,"url":"http://www.biofacebook.com/?p=250/wp-admin/install.php"},{"status":302,"url":"http://www.biofacebook.com/?p=250/wp-admin/install.php"},{"status":302,"url":"http://www.biofacebook.com/?p=250/wp-admin/install.php"},{"status":302,"url":"http://www.biofacebook.com/?p=250/wp-admin/install.php"},{"status":302,"url":"http://www.biofacebook.com/?p=250/wp-admin/install.php"},{"status":302,"url":"http://www.biofacebook.com/?p=250/wp-admin/install.php"},{"status":302,"url":"http://www.biofacebook.com/?p=250/wp-admin/install.php"},{"status":302,"url":"http://www.biofacebook.com/?p=250/wp-admin/install.php"}],"ssl":null,"ssl_err":null}}}]},"neubias":{"body":[{"format":"basic_html","processed":"<p>Aligning Big Brains &amp; Atlases (ABBA) is a set of software components which allows users to register images of thin serial biological tissue sections, cut in any orientation (coronal, sagittal or horizontal) to atlases, usually brain atlases. ABBA is available as a Fiji plugin for performing registration; a QuPath extension is also available and recommended. Typically, a set of serial sections is defined as a QuPath project, that is registered within Fiji. The registration results can then imported back into QuPath for downstream processing (cell detection and classification, cell counting per region, etc.).</p><p>Available atlases include the 3D mouse Allen Brain atlas and the Waxholm Space Atlas of the Sprague Dawley Rat Brain. Depending on your installation method, you may also access all BrainGlobe atlases.</p>","summary":"","value":"<p>Aligning Big Brains &amp; Atlases (ABBA) is a set of software components which allows users to register images of thin serial biological tissue sections, cut in any orientation (coronal, sagittal or horizontal) to atlases, usually brain atlases. ABBA is available as a Fiji plugin for performing registration; a QuPath extension is also available and recommended. Typically, a set of serial sections is defined as a QuPath project, that is registered within Fiji. The registration results can then imported back into QuPath for downstream processing (cell detection and classification, cell counting per region, etc.).</p><p>Available atlases include the 3D mouse Allen Brain atlas and the Waxholm Space Atlas of the Sprague Dawley Rat Brain. Depending on your installation method, you may also access all BrainGlobe atlases.</p>"}],"changed":[{"format":"Y-m-d\\TH:i:sP","value":"2025-10-27T09:13:23+00:00"}],"created":[{"format":"Y-m-d\\TH:i:sP","value":"2025-10-27T02:28:47+00:00"}],"default_langcode":[{"value":true}],"attribution_instructions":[],"comments_2023":[{"cid":0,"comment_count":0,"last_comment_name":null,"last_comment_timestamp":1761532525,"last_comment_uid":4076,"status":2}],"free_tagging":[{"target_id":5048,"target_type":"taxonomy_term","target_uuid":"24935529-f2a1-4bc8-87b5-944234305e95","url":"/taxonomy/term/5048"}],"give_feedback_on_this_soft":[{"cid":0,"comment_cou