{"tool_name":"bioconductor-scgraphverse","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-scgraphverse","home":"https://bioconductor.org/packages/scGraphVerse","license":"GPL-3.0","summary":"A package for inferring, comparing, and visualizing gene networks from single-cell RNA sequencing data. It integrates multiple methods (GENIE3, GRNBoost2, ZILGM, PCzinb, and JRF) for robust network inference, supports consensus building across methods or datasets, and provides tools for evaluating regulatory structure and community similarity. GRNBoost2 requires Python package 'arboreto' which can be installed using init_py(install_missing = TRUE). This package includes adapted functions from ZILGM (Park et al., 2021), JRF (Petralia et al., 2015), and learn2count (Nguyen et al. 2023) packages with proper attribution under GPL-2 license.","addition_date":"2026-09-01T07:30:26.978033Z","last_update_date":"2026-09-01T07:30:26.981270Z","tool_type":["Command-line tool","Library"],"version":["1.2.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-scgraphverse","credit":[{"name":"Annamaria Carissimo","typeEntity":"Person","typeRole":["Developer"]},{"name":"Claudia Angelini","typeEntity":"Person","typeRole":["Contributor","Developer"]},{"name":"Daniela De Canditiis","typeEntity":"Person","typeRole":["Developer"]},{"name":"Francesco Cecere","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/scGraphVerse"}],"edit_permission":{"type":"private"},"name":"scGraphVerse","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.1093/bioinformatics/btab293"},{"doi":"10.1093/bioinformatics/btv268"},{"doi":"10.1186/s12859-021-04441-8"}]},"bioschemas":{"name":"scGraphVerse","home":"https://bio.tools/bioconductor-scgraphverse","license":"GPL-3.0-only","version":"1.2.0","summary":"A package for inferring, co