{"tool_name":"jasper","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"jasper","home":"http://biorg.cs.fiu.edu/jasper","summary":"Jasper is a tool for visualizing profiles from 16S and whole-genome sequencing, and orders taxa along a space-filling Hilbert curve. The result is a Microbiome Map, where each position in the image represents the abundance of a single taxon from a reference collection. Jasper can order the taxa in two ways, and depending on the ordering, the maps can highlight \"hot spots\" of microbes that are either common to, or unique to, the biological conditions under study.","addition_date":"2021-10-04T08:33:30.404179Z","last_update_date":"2021-10-04T08:33:30.406622Z","tool_type":["Desktop application"],"biotools_curie":"biotools:jasper","credit":[{"email":"camilo@castflyer.com","name":"Giri Narasimhan","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"DNA barcoding","uri":"http://edamontology.org/operation_3200"},{"term":"Mapping","uri":"http://edamontology.org/operation_2429"},{"term":"Taxonomic classification","uri":"http://edamontology.org/operation_3460"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"Jasper","operating_system":["Mac"],"owner":"Kigaard","publication":[{"doi":"10.1101/2021.03.22.436520","type":["Primary"]}],"topic":[{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Microbial ecology","uri":"http://edamontology.org/topic_3697"},{"term":"Urology and nephrology","uri":"http://edamontology.org/topic_3422"},{"term":"Zoology","uri":"http://edamontology.org/topic_3500"}]},"bioschemas":{"name":"Jasper","home":"https://bio.tools/jasper","summary":"Jasper is a tool for visualizing profiles from 16S and whole-genome sequencing, and orders taxa along a space-filling Hilbert curve. The result is a Microbiome Map