{"tool_name":"moldiscovery","contents":["biotools","oeb"],"identifiers":["biotools:moldiscovery"],"fetched_metadata":{"biotools":{"id":"moldiscovery","home":"https://github.com/mohimanilab/molDiscovery","summary":"Learning Mass Spectrometry Fragmentation of Small Molecules.\n\nMolDiscovery is a mass spectral database search method that improves both efficiency and accuracy of small molecule identification by (i) utilizing an efficient algorithm to generate mass spectrometry fragmentations, and (ii) learning a probabilistic model to match small molecules with their mass spectra. A search of over six million spectra from global natural product social molecular networking infrastructure shows that our probabilistic model can identify nearly twice more small molecules than previous method.","addition_date":"2021-01-18T10:47:07Z","last_update_date":"2026-11-12T14:16:31.759093Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:moldiscovery","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Blind peptide database search","uri":"http://edamontology.org/operation_3647"},{"term":"Natural product identification","uri":"http://edamontology.org/operation_3803"},{"term":"Spectral library search","uri":"http://edamontology.org/operation_3801"},{"term":"Spectrum calculation","uri":"http://edamontology.org/operation_3860"},{"term":"Target-Decoy","uri":"http://edamontology.org/operation_3649"}]}],"name":"molDiscovery","owner":"Niclaskn","publication":[{"doi":"10.1038/s41467-021-23986-0","type":["Primary"]},{"doi":"10.21203/RS.3.RS-71854/V1","type":["Preprint"]}],"topic":[{"term":"Chemistry","uri":"http://edamontology.org/topic_3314"},{"term":"Molecular biology","uri":"http://edamontology.org/topic_3047"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}]},"oeb":{"metrics":[{"@id":"https://ope