{"tool_name":"dhcl","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"dhcl","home":"http://cropnet.pl/dhcl/","license":"Unlicense","summary":"Provides analysis of the hierarchy of protein domain structures. It detects closed loops and van der Waals locks, and outputs domain decomposition at different levels of protein domain structure hierarchy.","addition_date":"2017-02-14T09:36:14Z","last_update_date":"2024-11-24T21:03:53.037230Z","tool_type":["Web application"],"accessibility":"Open access","biotools_curie":"biotools:dhcl","cost":"Free of charge","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Protein domain recognition","uri":"http://edamontology.org/operation_0246"},{"term":"Protein feature detection","uri":"http://edamontology.org/operation_3092"},{"term":"Protein fold recognition","uri":"http://edamontology.org/operation_0303"},{"term":"Protein structure analysis","uri":"http://edamontology.org/operation_2406"},{"term":"Transmembrane protein analysis","uri":"http://edamontology.org/operation_0270"}]}],"maturity":"Mature","name":"DHcL","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"doi":"10.1093/nar/gkn326","metadata":{"abstract":"Domain hierarchy and closed loops (DHcL) (http://sitron.bccs.uib.no/dhcl/) is a web server that delineates energy hierarchy of protein domain structure and detects domains at different levels of this hierarchy. The server also identifies closed loops and van der Waals locks, which constitute a structural basis for the protein domain hierarchy. The DHcL can be a useful tool for an express analysis of protein structures and their alternative domain decompositions. The user submits a PDB identifier(s) or uploads a 3D protein structure in a PDB format. The results of the analysis are the location of domains at different levels of hierarchy, closed loops, van der Waals locks and their interactive visualization. The server maintains a regularly updated database of domains, closed loop and van der Waals locks for all X-ray structures in PDB. DHcL server is available at: http://sitron.bccs.uib.no/dhcl.","authors":[{"name":"Berezovsky I.N."},{"name":"Koczyk G."}],"citationCount":32,"date":"2008-01-01T00:00:00Z","journal":"Nucleic acids research","title":"Domain Hierarchy and closed Loops (DHcL): a server for exploring hierarchy of protein domain structure."},"pmcid":"PMC2447749","pmid":"18502776"}],"topic":[{"term":"Protein folds and structural domains","uri":"http://edamontology.org/topic_0736"},{"term":"Protein structure analysis","uri":"http://edamontology.org/topic_2814"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"},{"term":"Structure prediction","uri":"http://edamontology.org/topic_0082"},{"term":"X-ray diffraction","uri":"http://edamontology.org/topic_2828"}],"validated":1},"bioschemas":{"name":"DHcL","home":"https://bio.tools/dhcl","license":"Unlicense","summary":"Provides analysis of the hierarchy of protein domain structures. It detects closed loops and van der Waals locks, and outputs domain decomposition at different levels of protein domain structure hierarchy.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:dhcl/web/cropnet.pl","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":11,"citations":[{"count":1,"year":"2009"},{"count":1,"year":"2013"},{"count":1,"year":"2017"},{"count":1,"year":"2021"},{"count":1,"year":"2026"},{"count":2,"year":"2010"},{"count":2,"year":"2022"},{"count":2,"year":"2024"}],"doi":"10.1093/nar/gkn326","pmcid":"PMC2447749","pmid":"18502776","ref_count":16,"refs":[{"count":1,"year":"1959"},{"count":1,"year":"1981"},{"count":1,"year":"1987"},{"count":1,"year":"1994"},{"count":1,"year":"1995"},{"count":1,"year":"1997"