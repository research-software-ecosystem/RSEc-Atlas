{"tool_name":"bioconductor-outrider","contents":["oeb","bioschemas","biocontainers","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-outrider","identifiers":["doi:10.18129/b9.bioc.outrider"],"license":"MIT","summary":"OUTRIDER - OUTlier in RNA-Seq fInDER","home_url":"https://bioconductor.org/packages/3.8/bioc/html/OUTRIDER.html","keywords":["RNA-Seq","Transcriptomics","Gene Expression","Genetics"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-outrider","home":"https://bioconductor.org/packages/OUTRIDER","summary":"Identification of aberrant gene expression in RNA-seq data. Read count expectations are modeled by an autoencoder to control for confounders in the data. Given these expectations, the RNA-seq read counts are assumed to follow a negative binomial distribution with a gene-specific dispersion. Outliers are then identified as read counts that significantly deviate from this distribution. Furthermore, OUTRIDER provides useful plotting functions to analyze and visualize the results.","addition_date":"2026-09-01T07:26:10.996617Z","last_update_date":"2026-09-01T07:26:11.006384Z","tool_type":["Command-line tool","Library"],"version":["1.30.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-outrider","credit":[{"name":"Agne Matuseviciute","typeEntity":"Person","typeRole":["Developer"]},{"name":"Andrea Raithel","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Christian Mertes","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Felix Brechtmann","typeEntity":"Person","typeRole":["Developer"]},{"name":"Julien Gagneur","typeEntity":"Person","typeRole":["Developer"]},{"name":"Michaela Fee M\u00fcller","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Vicente Yepez","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/OUTRIDER"}],"edit_permission":{"type":"private"},"name":"OUTRIDER","opera