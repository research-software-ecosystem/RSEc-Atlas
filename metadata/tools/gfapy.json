{"tool_name":"gfapy","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"gfapy","identifiers":["biotools:gfapy","doi:10.1093/bioinformatics/btx398"],"license":"BSD","summary":"Flexible and extensible software library for handling sequence graphs in python.","home_url":"https://github.com/ggonnella/gfapy","keywords":["Computer Graphics","Programming Languages","Sequence Analysis","Sequencing","Data visualisation","Sequence analysis","Genetic variation","Sequence assembly"],"manually_check":true,"total_pulls":5421},"biotools":{"id":"gfapy","home":"https://github.com/ggonnella/gfapy","summary":"Flexible and extensible software library for handling sequence graphs in Python.","addition_date":"2018-06-14T14:13:15Z","last_update_date":"2024-11-25T14:40:28.752470Z","tool_type":["Command-line tool","Library"],"biotools_curie":"biotools:gfapy","credit":[{"email":"gonnella@zbh.uni-hamburg.de","name":"Giorgio Gonnella","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"https://github.com/ggonnella/gfapy/blob/master/manual/gfapy-manual.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Sequence visualisation","uri":"http://edamontology.org/operation_0564"}]}],"name":"GfaPy","operating_system":["Linux","Mac"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1093/bioinformatics/btx398","metadata":{"abstract":"Summary GFA 1 and GFA 2 are recently defined formats for representing sequence graphs, such as assembly, variation or splicing graphs. The formats are adopted by several software tools. Here, we present GfaPy, a software package for creating, parsing and editing GFA graphs using the programming language Python. GfaPy supports GFA 1 and GFA 2, using the same interface and allows for interconversion between both formats. The software package provides a simple interface for custom record types, which is an important new feature of GFA 2 (compared to GFA 1). This enables new applications of the format.","authors":[{"name":"Gonnella G."},{"name":"Kurtz S."}],"citationCount":5,"date":"2017-10-01T00:00:00Z","journal":"Bioinformatics","title":"GfaPy: A flexible and extensible software library for handling sequence graphs in Python"},"pmid":"28645150"}],"topic":[{"term":"Data visualisation","uri":"http://edamontology.org/topic_0092"},{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"bioschemas":{"name":"GfaPy","home":"https://bio.tools/gfapy","summary":"Flexible and extensible software library for handling sequence graphs in Python.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:gfapy/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"publications":[{"entries":[{"cit_count":6,"citations":[{"count":1,"year":"2019"},{"count":2,"year":"2022"},{"count":3,"year":"2026"}],"doi":"10.1093/bioinformatics/btx398","pmid":"28645150","ref_count":0,"refs":[],"title":"GfaPy: a flexible and extensible software library for handling sequence graphs in Python.","year":2017}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"email":true,"issue_tracking":{"public_tracker":true,"resolve_time":"PT13544978S"}}},{"@i