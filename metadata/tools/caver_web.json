{"tool_name":"caver_web","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"caver_web","home":"https://loschmidt.chemi.muni.cz/caverweb/","license":"Proprietary","summary":"A web interface for identification and analysis of tunnels and channels in static protein structures with automated starting point detection.","addition_date":"2016-06-30T11:17:55Z","last_update_date":"2024-11-24T20:23:04.296230Z","tool_type":["Web application"],"version":["1.1"],"collections":["CAVER","Czech Republic","ELIXIR-CZ"],"accessibility":"Open access","biotools_curie":"biotools:caver_web","cost":"Free of charge (with restrictions)","credit":[{"email":"1441@mail.muni.cz","name":"Jiri Damborsky","orcidid":"https://orcid.org/0000-0002-7848-8216","typeEntity":"Person","typeRole":["Contributor"]},{"email":"222755@mail.muni.cz","name":"David Bednar","orcidid":"https://orcid.org/0000-0002-6803-0340","typeEntity":"Person","typeRole":["Contributor"]},{"email":"423826@mail.muni.cz","name":"Marie Jankujova","orcidid":"https://orcid.org/0000-0003-3219-8149","typeEntity":"Person","typeRole":["Developer"]},{"email":"brezovsky@mail.muni.cz","name":"Jan Brezovsky","orcidid":"https://orcid.org/0000-0001-9677-5078","typeEntity":"Person","typeRole":["Contributor"]},{"email":"fila@mail.muni.cz","name":"Jiri Filipovic","orcidid":"https://orcid.org/0000-0002-5703-9673","typeEntity":"Person","typeRole":["Developer"]},{"email":"josegasparpinto@gmail.com","name":"Gaspar Pinto","orcidid":"https://orcid.org/0000-0002-8917-1169","typeEntity":"Person","typeRole":["Contributor"]},{"email":"piia@mail.muni.cz","name":"Piia Kokkonen","orcidid":"https://orcid.org/0000-0001-6002-1856","typeEntity":"Person","typeRole":["Contributor"]},{"email":"stourac.jan@gmail.com","name":"Jan Stourac","orcidid":"https://orcid.org/0000-0003-3139-3700","typeEntity":"Person","typeRole":["Developer","Support"]},{"email":"caver@caver.cz","name":"CAVER team","typeEntity":"Person","typeRole":["Primary contact"]},