{"tool_name":"demodifier","contents":["biotools"],"identifiers":["biotools:demodifier"],"fetched_metadata":{"biotools":{"id":"demodifier","home":"https://github.com/miranda-e/Demodifier","summary":"The Demodifier is an open-source palaeoproteomics tool that screens detected peptides for modification-induced alternate sequences (e.g., from deamidation of Q/N or pyroglutamate formation) that can produce spurious taxonomic assignments, helping archaeologists avoid inaccurate species interpretations of ancient samples.","addition_date":"2026-11-04T09:53:15.578594Z","last_update_date":"2026-11-04T09:53:15.587017Z","biotools_curie":"biotools:demodifier","credit":[{"email":"mae52@cam.ac.uk","name":"Miranda Evans","orcidid":"https://orcid.org/0000-0002-9284-9268","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"PTM localisation","uri":"http://edamontology.org/operation_3755"},{"term":"Protein fragment weight comparison","uri":"http://edamontology.org/operation_2929"},{"term":"de Novo sequencing","uri":"http://edamontology.org/operation_3644"}]}],"name":"The Demodifier","owner":"pub2tools2024","publication":[{"doi":"10.1371/JOURNAL.PONE.0339465","pmcid":"PMC12795368","pmid":"41525273"}],"topic":[{"term":"Protein modifications","uri":"http://edamontology.org/topic_0601"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"},{"term":"Taxonomy","uri":"http://edamontology.org/topic_0637"}]}}}