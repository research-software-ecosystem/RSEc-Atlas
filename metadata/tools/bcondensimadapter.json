{"tool_name":"bcondensimadapter","contents":["biotools","oeb"],"identifiers":["biotools:bcondensimadapter"],"fetched_metadata":{"biotools":{"id":"bcondensimadapter","home":"https://github.com/hanlab-computChem/CondenSimAdapter","summary":"CondenSimAdapter is a Python package designed to facilitate multiscale molecular dynamics simulations, specifically bridging the gap between coarse-grained (CG) and all-atom (AA) simulations for studying protein condensates. It uses an SE(3)-transformer-based backmapping coupled with a physics-inspired optimization protocol to resolve structural clashes during the simulation process.","addition_date":"2026-11-05T13:46:04.061790Z","last_update_date":"2026-11-05T13:46:04.063921Z","biotools_curie":"biotools:bcondensimadapter","credit":[{"email":"hanw_chem@hkbu.edu.hk","name":"Wei Han","orcidid":"https://orcid.org/0000-0003-0759-1766","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Molecular dynamics","uri":"http://edamontology.org/operation_2476"},{"term":"Phasing","uri":"http://edamontology.org/operation_3454"},{"term":"Simulation analysis","uri":"http://edamontology.org/operation_0244"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"CondenSimAdapter","owner":"pub2tools2024","publication":[{"doi":"10.1021/ACS.JCIM.6C00413","pmcid":"PMC13370849","pmid":"42376920"}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Molecular dynamics","uri":"http://edamontology.org/topic_0176"},{"term":"Physics","uri":"http://edamontology.org/topic_3318"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:bcondensimadapter/undefined/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","project":{"publications":[{"entries":[{"cit_c