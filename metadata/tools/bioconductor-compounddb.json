{"tool_name":"bioconductor-compounddb","contents":["oeb","biotools","bioschemas"],"fetched_metadata":{"biotools":{"id":"bioconductor-compounddb","home":"https://bioconductor.org/packages/MetaboAnnotation","license":"Artistic-2.0","summary":"High level functions to assist in annotation of (metabolomics) data sets. These include functions to perform simple tentative annotations based on mass matching but also functions to consider m/z and retention times for annotation of LC-MS features given that respective reference values are available. In addition, the function provides high-level functions to simplify matching of LC-MS/MS spectra against spectral libraries and objects and functionality to represent and manage such matched data.","addition_date":"2026-08-30T02:39:52.572384Z","last_update_date":"2026-09-06T01:50:42.826857Z","tool_type":["Command-line tool","Library"],"version":["1.16.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-compounddb","credit":[{"name":"Andrea Vicini","typeEntity":"Person","typeRole":["Developer"]},{"name":"Carolin Huber","typeEntity":"Person","typeRole":["Developer"]},{"name":"Johannes Rainer","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Michael Witting","typeEntity":"Person","typeRole":["Developer"]},{"name":"Nir Shachaf","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Philippine Louail","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/MetaboAnnotation"}],"edit_permission":{"type":"private"},"name":"CompoundDb","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.3390/metabo12020173"}]},"bioschemas":{"name":"CompoundDb","home":"https://bio.tools/bioconductor-compounddb","license":"Artistic-2.0","version":"1.16.0","summary":"CompoundDb provides functionality to create and use (chemical) compound annotation databases from a variety of different sources such a