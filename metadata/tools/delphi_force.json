{"tool_name":"delphi_force","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"delphi_force","home":"http://compbio.clemson.edu/delphi-force/","summary":"Calculate the electrostatic force between two objects, such as proteins, DNAs, lipids, small molecules, etc.","addition_date":"2018-06-17T16:19:36Z","last_update_date":"2024-11-25T14:41:10.126063Z","tool_type":["Web application"],"biotools_curie":"biotools:delphi_force","credit":[{"email":"delphi@clemson.edu","name":"Support","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://compbio.clemson.edu/delphi-force-web"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Protein property calculation","uri":"http://edamontology.org/operation_0250"}]}],"name":"DelPhi Force","operating_system":["Linux","Mac","Windows"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1093/bioinformatics/btx495","metadata":{"abstract":"Summary Electrostatic force is an essential component of the total force acting between atoms and macromolecules. Therefore, accurate calculations of electrostatic forces are crucial for revealing the mechanisms of many biological processes. We developed a DelPhiForce web server to calculate and visualize the electrostatic forces at molecular level. DelPhiForce web server enables modeling of electrostatic forces on individual atoms, residues, domains and molecules, and generates an output that can be visualized by VMD software. Here we demonstrate the usage of the server for various biological problems including protein-cofactor, domain-domain, protein-protein, protein-DNA and protein-RNA interactions. Availability and implementation The DelPhiForce web server is available at: http://compbio.clemson.edu/delphi-force. Contact delphi@clemson.edu Supplementary informationSupplementary dataare available at Bioinformatics online.","authors":[{"name":"Alexov E."},{"name":"Chakravorty A."},{"name":"Jia Z."},{"name":"Li L."},{"name":"Peng Y."},{"name":"Sun L."}],"citationCount":33,"date":"2017-11-15T00:00:00Z","journal":"Bioinformatics","title":"DelPhiForce web server: Electrostatic forces and energy calculations and visualization"},"pmcid":"PMC5870670","pmid":"29036596"}],"topic":[{"term":"Data visualisation","uri":"http://edamontology.org/topic_0092"},{"term":"Nucleic acid structure analysis","uri":"http://edamontology.org/topic_0097"},{"term":"Protein structure analysis","uri":"http://edamontology.org/topic_2814"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}],"validated":1},"bioschemas":{"name":"DelPhi Force","home":"https://bio.tools/delphi_force","summary":"Calculate the electrostatic force between two objects, such as proteins, DNAs, lipids, small molecules, etc.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:delphi_force/web/compbio.clemson.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":25,"citations":[{"count":1,"year":"2024"},{"count":3,"year":"2020"},{"count":3,"year":"2022"},{"count":3,"year":"2023"},{"count":3,"year":"2026"},{"count":4,"year":"2019"},{"count":4,"year":"2021"},{"count":4,"year":"2025"}],"doi":"10.1093/bioinformatics/btx495","pmcid":"PMC5870670","pmid":"29036596","ref_count":11,"refs":[{"count":1,"year":"1997"},{"count":1,"year":"2002"},{"count":1,"year":"2007"},{"count":1,"year":"2012"},{"count":1,"year":"2013"},{"count":1,"year":"2015"},{"count":1,"year":"2017"},{"count":2,"year":"2014"},{"count":2,"year":"2016"}],"title":"DelPhiForce web server: electrostatic forces and energy calculations and visualization.","year":2017}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":404,"redirects":[{"status":