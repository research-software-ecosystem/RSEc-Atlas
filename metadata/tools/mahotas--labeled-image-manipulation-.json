{"tool_name":"mahotas--labeled-image-manipulation-","contents":["neubias"],"fetched_metadata":{"neubias":{"body":[{"format":"basic_html","processed":"<p>Labeled images are integer images where the values correspond to different regions. I.e., region 1 is all of the pixels which have value <em>1</em>, region two is the pixels with value 2, and so on. By convention, region 0 is the background and often handled differently.</p>\n\n<p>&nbsp;</p>","summary":"","value":"<p>Labeled images are integer images where the values correspond to different regions. I.e., region 1 is all of the pixels which have value <em>1</em>, region two is the pixels with value 2, and so on. By convention, region 0 is the background and often handled differently.</p>\r\n\r\n<p>&nbsp;</p>\r\n"}],"changed":[{"format":"Y-m-d\\TH:i:sP","value":"2020-03-03T11:27:37+00:00"}],"created":[{"format":"Y-m-d\\TH:i:sP","value":"2013-10-15T10:45:49+00:00"}],"default_langcode":[{"value":true}],"attribution_instructions":[],"comments_2023":[],"free_tagging":[],"give_feedback_on_this_soft":[{"cid":0,"comment_count":0,"last_comment_name":null,"last_comment_timestamp":1505209345,"last_comment_uid":164,"status":2}],"has_author":[{"value":"Luis Pedro Coelho"}],"has_biological_terms":[],"has_comparison":[],"has_documentation":[{"options":[],"title":"","uri":"https://mahotas.readthedocs.io/en/latest/labeled.html"}],"has_doi":[],"has_entry_curator":[{"target_id":167,"target_type":"user","target_uuid":"f71a2161-f0ab-4f2a-8567-703d1592f830","url":"/user/167"}],"has_function":[{"target_id":4122,"target_type":"taxonomy_term","target_uuid":"http://edamontology.org/operation__RyCFuPLOeGxpcGjYbWcWWD","url":"/object-classification"}],"has_implementation":[{"target_id":4339,"target_type":"taxonomy_term","target_uuid":"f1c052f1-81ff-4315-986e-e5eef75cb95c","url":"/taxonomy/term/4339"}],"has_interaction_level":[{"target_id":3574,"target_type":"taxonomy_term","target_uuid":"a22a3a50-0fbb-41ee-944a-38e0b86ac077","url":"/taxonomy/te