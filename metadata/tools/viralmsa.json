{"tool_name":"viralmsa","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"viralmsa","version":"1.1.48","home":"https://github.com/niemasd/ViralMSA","license":"GNU General Public License v3 (GPLv3)","summary":"Reference-guided multiple sequence alignment of viral genomes","identifiers":["biotools:viralmsa","doi:10.1093/bioinformatics/btaa743"],"license_file":"LICENSE","build":{"noarch":"generic","number":0,"run_exports":[null]},"requirements":{"run":["python >=3.7","biopython","bowtie2","dragmap","hisat2","lra","minimap2","ngmlr","star","unimap","wfmash","winnowmap"]},"source_url":"https://github.com/niemasd/ViralMSA/archive/refs/tags/1.1.48.tar.gz","test":{"commands":["ViralMSA.py -h"]}},"biotools":{"id":"viralmsa","home":"https://github.com/niemasd/ViralMSA","license":"GPL-3.0","summary":"Massively scalable reference-guided multiple sequence alignment of viral genomes.\n\nViralMSA is a tool to perform reference-guided multiple sequence alignment of viral genomes.\n\nImportantly, ViralMSA differs significantly from VIRULIGN, a codon-correct reference-guided alignment tool designed for viruses, in three key ways:.","addition_date":"2021-01-18T10:36:42Z","last_update_date":"2021-01-30T10:39:30Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:viralmsa","credit":[{"email":"niemamoshiri@gmail.com","name":"Niema Moshiri","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genome alignment","uri":"http://edamontology.org/operation_3182"},{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Multiple sequence alignment","uri":"http://edamontology.org/operation_0492"},{"term":"Pairwise sequence alignment","uri":"http://edamontology.org/operation_0491"}]}],"name":"ViralMSA","owner":"Niclaskn","publication":[{"doi":"10.1093/BIOINFORMATICS/BTAA743","metadata":{"abstract":"\u00a9 2020 The Author(s) 2020. Published by Oxford University Press. All rights reserved. For permissions, please e-mail: journals.permissions@oup.com.Motivation: In molecular epidemiology, the identification of clusters of transmissions typically requires the alignment of viral genomic sequence data. However, existing methods of multiple sequence alignment (MSA) scale poorly with respect to the number of sequences. Results: ViralMSA is a user-friendly reference-guided MSA tool that leverages the algorithmic techniques of read mappers to enable the MSA of ultra-large viral genome datasets. It scales linearly with the number of sequences, and it is able to align tens of thousands of full viral genomes in seconds. However, alignments produced by ViralMSA omit insertions with respect to the reference genome.","authors":[{"name":"Moshiri N."}],"citationCount":3,"date":"2021-03-01T00:00:00Z","journal":"Bioinformatics","title":"ViralMSA: Massively scalable reference-guided multiple sequence alignment of viral genomes"},"pmid":"32814953"}],"topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Public health and epidemiology","uri":"http://edamontology.org/topic_3305"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}]},"bioschemas":{"name":"ViralMSA","home":"https://bio.tools/viralmsa","license":"GPL-3.0","summary":"Massively scalable reference-guided multiple sequence alignment of viral genomes.\n\nViralMSA is a tool to perform reference-guided multiple sequence alignment of viral genomes.\n\nImportantly, ViralMSA differs significantly from VIRULIGN, a codon-correct reference-guided alignment tool designed for viruses, in three key ways:.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:viralmsa/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"