{"tool_name":"subtiwiki","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"subtiwiki","home":"https://subtiwiki.uni-goettingen.de/","summary":"SubtiWiki is a database for the model organism Bacillus subtilis.","addition_date":"2022-03-13T11:27:48.265908Z","last_update_date":"2025-07-16T13:05:53.746014Z","tool_type":["Database portal","Web application"],"accessibility":"Open access","biotools_curie":"biotools:subtiwiki","cost":"Free of charge","credit":[{"email":"christoph.elfmann@uni-goettingen.de","name":"Christoph Elfmann","note":"PhD student in charge of SubtiWiki.","orcidid":"https://orcid.org/0000-0002-7872-8232","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"jstuelk@gwdg.de","name":"J\u00f6rg St\u00fclke","orcidid":"https://orcid.org/0000-0001-5881-5390","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene regulatory network analysis","uri":"http://edamontology.org/operation_1781"},{"term":"Genome visualisation","uri":"http://edamontology.org/operation_3208"},{"term":"Operon prediction","uri":"http://edamontology.org/operation_0435"}]}],"name":"SubtiWiki","operating_system":["Linux","Mac","Windows"],"owner":"ChristophElfmann","publication":[{"doi":"10.1093/nar/gkae957","metadata":{"abstract":"Bacillus subtilis is a Gram-positive model bacterium and one of the most-studied and best understood organisms. The complex information resulting from its investigation is compiled in the database SubtiWiki (https://subtiwiki.uni-goettingen.de/v5) in an integrated and intuitive manner. To enhance the utility of SubtiWiki, we have added novel features such as a viewer to interrogate conserved genomic organization, a widget that shows mutant fitness data for all non-essential genes, and a widget showing protein structures, structure predictions and complex structures. Moreover, we have integrated metabolites as new entities. The new framework also includes a documented API, enabling programmatic access to data for computational tasks. Here we present the recent developments of SubtiWiki and the current state of the data for this organism.","authors":[{"name":"Dumann V."},{"name":"Elfmann C."},{"name":"Stulke J."},{"name":"van den Berg T."}],"citationCount":4,"date":"2025-01-06T00:00:00Z","journal":"Nucleic Acids Research","title":"A new framework for SubtiWiki, the database for the model organism Bacillus subtilis"},"pmcid":"PMC11701700","pmid":"39441067","type":["Primary"],"version":"5.0"}],"topic":[{"term":"Endocrinology and metabolism","uri":"http://edamontology.org/topic_3407"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Phylogenetics","uri":"http://edamontology.org/topic_3293"}],"validated":1},"bioschemas":{"name":"SubtiWiki","home":"https://bio.tools/subtiwiki","summary":"SubtiWiki is a database for the model organism Bacillus subtilis.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:subtiwiki/db/subtiwiki.uni-goettingen.de","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":25,"citations":[{"count":12,"year":"2026"},{"count":13,"year":"2025"}],"doi":"10.1093/nar/gkae957","pmcid":"PMC11701700","pmid":"39441067","ref_count":0,"refs":[],"title":"A new framework for SubtiWiki, the database for the model organism Bacillus subtilis.","year":2025}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://subtiwiki.uni-goettingen.de/v5"},{"status":301,"url":"https://subtiwiki.uni-goettingen.de/v5/"}],"ssl":true,"ssl_err":nul