{"tool_name":"heron","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"heron","home":"https://bioconductor.org/packages/HERON","license":"GPL-3.0-or-later","summary":"HERON is a software package for analyzing peptide binding array data. In addition to identifying significant binding probes, HERON also provides functions for finding epitopes (string of consecutive peptides within a protein). HERON also calculates significance on the probe, epitope, and protein level by employing meta p-value methods.  HERON is designed for obtaining calls on the sample level and calculates fractions of hits for different conditions.","addition_date":"2026-01-15T11:57:05.015546Z","last_update_date":"2026-08-30T02:18:47.277459Z","version":["1.10.0"],"collections":["BioConductor"],"biotools_curie":"biotools:heron","credit":[{"name":"Irene Ong","typeEntity":"Person","typeRole":["Developer"]},{"name":"Sean McIlwain","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/HERON"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Epitope mapping","uri":"http://edamontology.org/operation_0416"},{"term":"Multiple testing correction","uri":"http://edamontology.org/operation_4034"},{"term":"Peptide immunogenicity prediction","uri":"http://edamontology.org/operation_0252"}]}],"name":"HERON","owner":"pub2tools2024","publication":[{"doi":"10.1101/2023.04.23.536620"}],"topic":[{"term":"Immunogenetics","uri":"http://edamontology.org/topic_3930"},{"term":"Microarray experiment","uri":"http://edamontology.org/topic_3518"},{"term":"Probes and primers","uri":"http://edamontology.org/topic_0632"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}]},"bioschemas":{"name":"HERON","home":"https://bio.tools/heron","license":"GPL-3.0-or-later","version":"1.10.0","summary":"HERON is a soft