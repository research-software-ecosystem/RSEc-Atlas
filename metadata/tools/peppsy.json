{"tool_name":"peppsy","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"peppsy","home":"http://peppsy.genouest.org","summary":"A gene expression-based prioritization system to help investigators to determine in which human tissues they should look for an unseen protein.","addition_date":"2017-10-24T13:40:51Z","last_update_date":"2024-11-25T14:12:40.921423Z","tool_type":["Web application"],"collections":["Proteomics"],"biotools_curie":"biotools:peppsy","cost":"Free of charge","credit":[{"email":"frederic.chalmel@univ-rennes1.fr","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"Fr\u00e9d\u00e9ric Chalmel","typeEntity":"Person","typeRole":["Maintainer"]},{"name":"Lydie Lane","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Olivier Collin","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Olivier Sallou","typeEntity":"Person","typeRole":["Developer"]},{"name":"Paula P. Duek","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Thomas Darde","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["General"],"url":"http://peppsy.genouest.org/help"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"input":[{"data":{"term":"ID list","uri":"http://edamontology.org/data_2872"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}],"operation":[{"term":"Prediction and recognition","uri":"http://edamontology.org/operation_2423"}],"output":[{"data":{"term":"Evidence","uri":"http://edamontology.org/data_2042"}}]}],"maturity":"Mature","name":"PepPSy","operating_system":["Linux","Mac","Windows"],"owner":"olivier.collin@irisa.fr","publication":[{"doi":"10.1093/database/baw070","metadata":{"abstract":"Among the 20 000 human gene products predicted from genome annotation, about 3000 still lack validation at protein level. We developed PepPSy, a user-friendly gene expression-based prioritization system, to help investigators to determin