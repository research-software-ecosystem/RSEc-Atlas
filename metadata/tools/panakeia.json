{"tool_name":"panakeia","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"panakeia","home":"https://github.com/BioSina/Panakeia","license":"GPL-3.0","summary":"Panakeia is a python-based tool for prokaryotic pangenome analysis. Panakeia uses graph-based representations of the input genomes to build a complete pangenome graph. It then utilises graph algorithms on this pangenome graph to detect shared patterns of insertions, deletions, rearrangement and variants between groups of genomes in the pangenome. Pankaia can be coupled with Pantagruel (https://github.com/flass/pantagruel) to further highlight areas with shares evolutionary history in the pangenome graph.","addition_date":"2021-11-01T10:19:57.631935Z","last_update_date":"2021-11-01T10:19:57.634636Z","tool_type":["Script"],"biotools_curie":"biotools:panakeia","credit":[{"email":"sb59@sanger.ac.uk","name":"Sina Beier","orcidid":"https://orcid.org/0000-0002-8230-4256","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Deletion detection","uri":"http://edamontology.org/operation_3962"},{"term":"Genome annotation","uri":"http://edamontology.org/operation_0362"}]}],"name":"Panakeia","owner":"Kigaard","publication":[{"doi":"10.1101/2021.03.02.433540"}],"topic":[{"term":"Ecology","uri":"http://edamontology.org/topic_0610"},{"term":"Gene structure","uri":"http://edamontology.org/topic_0114"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"},{"term":"Phylogeny","uri":"http://edamontology.org/topic_0084"}]},"bioschemas":{"name":"Panakeia","home":"https://bio.tools/panakeia","license":"GPL-3.0","summary":"Panakeia is a python-based tool for prokaryotic pangenome analysis. Panakeia uses graph-based representations of the input genomes to build a complete pangenome graph. It then utilises graph algorithms on this pangenome graph to detect