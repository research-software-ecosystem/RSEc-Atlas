{"tool_name":"t-gene","contents":["biotools","oeb"],"identifiers":["biotools:t-gene"],"fetched_metadata":{"biotools":{"id":"T-Gene","home":"http://meme-suite.org/tools/tgene","summary":"Improved target gene prediction.\n\nAbstract Motivation Identifying the genes regulated by a given transcription factor (its \u201ctarget genes\u201d) is a key step in developing a comprehensive understanding of gene regulation. Previously we developed a method for predicting the target genes of a transcription factor (TF) based solely on the correlation between a histone modification at the TF\u2019s binding site and the expression of the gene across a set of tissues. That approach is limited to organisms for which extensive histone and expression data is available, and does not explicitly incorporate the genomic distance between the TF and the gene. Results We present the T-Gene algorithm, which overcomes these limitations. T-Gene can be used to predict which genes are most likely to be regulated by a TF, and which of the TF\u2019s binding sites are most likely involved in regulating particular genes.","addition_date":"2020-01-09T17:42:19Z","last_update_date":"2026-11-12T14:31:05.583468Z","biotools_curie":"biotools:T-Gene","edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Binding site prediction","uri":"http://edamontology.org/operation_2575"},{"term":"Expression correlation analysis","uri":"http://edamontology.org/operation_3463"},{"term":"Transcription factor binding site prediction","uri":"http://edamontology.org/operation_0445"}]}],"name":"T-Gene","owner":"Pub2Tools","publication":[{"doi":"10.1093/bioinformatics/btaa227","type":["Primary"]},{"doi":"10.1101/803221","type":["Preprint"]}],"topic":[{"term":"Epigenetics","uri":"http://edamontology.org/topic_3295"},{"term":"Gene regulation","uri":"http://edamontology.org/topic_0204"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:t-gene/undefined/meme-suite.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1101/803221","pmcid":null,"pmid":null,"ref_count":0,"refs":[],"title":null,"year":null}]},{"entries":[{"cit_count":19,"citations":[{"count":2,"year":2021},{"count":2,"year":2022},{"count":2,"year":2026},{"count":3,"year":2023},{"count":4,"year":2025},{"count":6,"year":2024}],"doi":"10.1093/bioinformatics/btaa227","pmcid":"PMC7320607","pmid":"32246829","ref_count":7,"refs":[{"count":1,"year":2008},{"count":1,"year":2010},{"count":1,"year":2015},{"count":2,"year":2009},{"count":2,"year":2017}],"title":"T-Gene: improved target gene prediction.","year":2020}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://meme-suite.org/meme/tools/tgene"},{"status":302,"url":"https://meme-suite.org/tools/tgene"}],"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/t-gene","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://meme-suite.org/meme/tools/tgene"},{"status":302,"url":"https://meme-suite.org/tools/tgene"}],"ssl":true,"ssl_err":null}}}]}}}