{"tool_name":"shinycurves","contents":["biotools","oeb"],"identifiers":["biotools:shinycurves"],"fetched_metadata":{"biotools":{"id":"shinycurves","home":"https://biosol.shinyapps.io/shinycurves/","license":"CC-BY-NC-SA-4.0","summary":"shiny web application to analyse multisource qPCR amplification data.\n\nQuantitative RT-PCR amplification has been the gold-standard tool for viral detection during the SARS-CoV-2 pandemic. However, the desperate rush for a quick diagnosis led the use of very different types of machines and proprietary software, leading thus to an unbearable complexity of data analysis with a limited parameter setup. Here, we present shinyCurves, a shiny web application created to analyse multisource qPCR amplification data from independent multi-plate format. Furthermore, our automated system allows the classification of the results as well as the plot of both amplification and melting curves. Altogether, our web application is an automated qPCR analysis resource available to the research community.","addition_date":"2021-01-18T11:11:01Z","last_update_date":"2026-11-12T14:39:34.810821Z","biotools_curie":"biotools:shinycurves","credit":[{"email":"joseramon.bilabo@ehu.eus","typeEntity":"Person"},{"email":"nora.fernandez@ehu.eus","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Nucleic acid melting curve plotting","uri":"http://edamontology.org/operation_0458"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"}]}],"name":"shinyCurves","owner":"zsmag19","publication":[{"doi":"10.1101/2020.10.14.20212381","type":["Preprint"]},{"doi":"10.1186/s12859-021-04392-1","type":["Primary"]}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"PCR experiment","uri":"http://edamontology.org/topic_3519"},{"term":"Probes and primers","uri":"http://edamontology.org/topic_0632"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:shinycurves/undefined/biosol.shinyapps.io","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1101/2020.10.14.20212381","pmcid":null,"pmid":null,"ref_count":0,"refs":[],"title":null,"year":null}]},{"entries":[{"cit_count":3,"citations":[{"count":1,"year":2022},{"count":1,"year":2023},{"count":1,"year":2025}],"doi":"10.1186/s12859-021-04392-1","pmcid":"PMC8487674","pmid":"34602053","ref_count":7,"refs":[{"count":1,"year":2008},{"count":1,"year":2013},{"count":1,"year":2014},{"count":1,"year":2020},{"count":3,"year":2021}],"title":"shinyCurves, a shiny web application to analyse multisource qPCR amplification data: a COVID-19 case study.","year":2021}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":202,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/shinycurves","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":202,"ssl":true,"ssl_err":null}}}]}}}