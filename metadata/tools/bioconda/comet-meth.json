{"tool_name":"bioconda/comet-meth","contents":["bioconda"],"identifiers":["bioconda:comet-meth"],"fetched_metadata":{"bioconda":{"name":"comet-meth","version":"1.1.1","home":"https://github.com/fanglab/COMET","license":"CC-BY-NC-SA-4.0","summary":"Read-level cell-type assignment and cell-type-resolved DMR analysis for long-read methylation data","description":"COMET (Cell-of-Origin from METhylation) assigns individual long reads from bulk tissue to\ntheir cell type of origin using per-read CpG methylation and a cell-type reference panel,\nand outputs cell-type BAMs, per-site methylation calls and cell-type composition.\n","license_file":"LICENSE","build":{"noarch":"generic","number":0,"run_exports":[null]},"requirements":{"run":["python >=3.8","pysam >=0.21","numpy >=1.20","pandas >=1.3","scipy >=1.7","matplotlib-base >=3.5","mscorefonts","samtools >=1.15","bedtools >=2.29","htslib >=1.15","ont-modkit ==0.3.1","metilene ==0.2.9","perl","gawk","coreutils"]},"source_url":"https://github.com/fanglab/COMET/archive/refs/tags/v1.1.1.tar.gz","test":{"commands":["comet --version","comet --help","comet_assign.py --help","comet_summarize.py --help","comet_plot_assign.py --help","comet_plot_dmr.py --help","comet dmr --help","comet test --help","comet test --env-only","test -s $PREFIX/share/comet/test/dmr/brain_deep_AD_1.Microglia.CG.bed.gz","comet assign --help","metilene --version || true","modkit --version"]},"recipe_maintainers":["Kanochan-hao"]}}}