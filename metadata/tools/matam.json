{"tool_name":"matam","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"matam","identifiers":["biotools:matam","doi:10.1093/bioinformatics/btx644"],"license":"AGPL-3.0","summary":"MATAM is a software dedicated to the fast and accurate targeted assembly of short reads.","home_url":"https://github.com/bonsai-team/matam","keywords":["Gastrointestinal Microbiome","High-Throughput Nucleotide Sequencing","Humans","Metagenome","Metagenomics","Phylogeny","RNA, Ribosomal, 16S","Sequence Analysis, DNA","Metatranscriptomics","Sequence assembly","Clustering","Genomics"],"manually_check":true,"total_pulls":4},"biotools":{"id":"matam","home":"https://github.com/bonsai-team/matam","license":"AGPL-3.0","summary":"Reconstruction of phylogenetic marker genes from short sequencing reads in metagenomes","addition_date":"2020-04-03T13:19:31Z","last_update_date":"2024-11-24T14:49:53.484672Z","tool_type":["Command-line tool"],"version":["1.6.0","1.6.1"],"biotools_curie":"biotools:matam","cost":"Free of charge","credit":[{"email":"helene.touzet@univ-lille.fr","name":"H\u00e9l\u00e8ne Touzet","orcidid":"https://orcid.org/0000-0001-5305-9987"},{"email":"pierre.pericard@univ-lille.fr","name":"Pierre Pericard","orcidid":"https://orcid.org/0000-0001-8167-6448"}],"edit_permission":{"type":"private"},"maturity":"Emerging","name":"MATAM","operating_system":["Linux"],"owner":"ppericard","publication":[{"doi":"10.1093/bioinformatics/btx644","metadata":{"abstract":"Motivation Advances in the sequencing of uncultured environmental samples, dubbed metagenomics, raise a growing need for accurate taxonomic assignment. Accurate identification of organisms present within a community is essential to understanding even the most elementary ecosystems. However, current high-throughput sequencing technologies generate short reads which partially cover full-length marker genes and this poses difficult bioinformatic challenges for taxonomy identification at high resolution. Results We designed MATAM, a software dedicated to the fast and accurate targeted assembly of short reads sequenced from a genomic marker of interest. The method implements a stepwise process based on construction and analysis of a read overlap graph. It is applied to the assembly of 16S rRNA markers and is validated on simulated, synthetic and genuine metagenomes. We show that MATAM outperforms other available methods in terms of low error rates and recovered fractions and is suitable to provide improved assemblies for precise taxonomic assignments. Availability and implementation https://github.com/bonsai-team/matam Contact pierre.pericard@gmail.com or helene.touzet@univ-lille1.fr Supplementary informationSupplementary dataare available at Bioinformatics online.","authors":[{"name":"Blanquart S."},{"name":"Couderc L."},{"name":"Dufresne Y."},{"name":"Pericard P."},{"name":"Touzet H."}],"citationCount":33,"date":"2018-02-15T00:00:00Z","journal":"Bioinformatics","title":"MATAM: Reconstruction of phylogenetic marker genes from short sequencing reads in metagenomes"},"pmid":"29040406"}],"topic":[{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Metatranscriptomics","uri":"http://edamontology.org/topic_3941"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"}],"validated":1},"bioschemas":{"name":"MATAM","home":"https://bio.tools/matam","license":"AGPL-3.0","version":["1.6.0","1.6.1"],"summary":"Reconstruction of phylogenetic marker genes from short sequencing reads in metagenomes","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:matam/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme