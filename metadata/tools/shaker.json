{"tool_name":"shaker","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"ShaKer","home":"https://github.com/BackofenLab/ShaKer","summary":"RNA SHAPE prediction using graph kernel | SHApe simulation with graph KERnels | import shaker.rna_tools.rna_io as rio","addition_date":"2019-11-14T19:32:53Z","last_update_date":"2020-12-19T16:17:31Z","biotools_curie":"biotools:ShaKer","credit":[{"email":"backofen@informatik.uni-freiburg.de","name":"Rolf Backofen","typeEntity":"Person"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Protein secondary structure prediction","uri":"http://edamontology.org/operation_0267"},{"term":"RNA secondary structure prediction","uri":"http://edamontology.org/operation_0278"},{"term":"RNA structure prediction","uri":"http://edamontology.org/operation_2441"}]}],"name":"ShaKer","owner":"Pub2Tools","publication":[{"doi":"10.1093/BIOINFORMATICS/BTZ395","metadata":{"abstract":"\u00a9 2019 The Author(s) 2019. Published by Oxford University Press.Summary: SHAPE experiments are used to probe the structure of RNA molecules. We present ShaKer to predict SHAPE data for RNA using a graph-kernel-based machine learning approach that is trained on experimental SHAPE information. While other available methods require a manually curated reference structure, ShaKer predicts reactivity data based on sequence input only and by sampling the ensemble of possible structures. Thus, ShaKer is well placed to enable experiment-driven, transcriptome-wide SHAPE data prediction to enable the study of RNA structuredness and to improve RNA structure and RNA-RNA interaction prediction. For performance evaluation, we use accuracy and accessibility comparing to experimental SHAPE data and competing methods. We can show that Shaker outperforms its competitors and is able to predict high quality SHAPE annotations even when no reference structure is provided.","authors":[{"name":"Backofen R."},{"name":"Costa F."},{"name":"Mautner S."},{"name":"Miladi M."},{"name":"Montaseri S."},{"name":"Raden M."}],"citationCount":3,"date":"2019-07-15T00:00:00Z","journal":"Bioinformatics","title":"ShaKer: RNA SHAPE prediction using graph kernel"},"pmcid":"PMC6612843","pmid":"31510707"}],"topic":[{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"RNA","uri":"http://edamontology.org/topic_0099"},{"term":"Structure prediction","uri":"http://edamontology.org/topic_0082"}],"validated":1},"bioschemas":{"name":"ShaKer","home":"https://bio.tools/ShaKer","summary":"RNA SHAPE prediction using graph kernel | SHApe simulation with graph KERnels | import shaker.rna_tools.rna_io as rio","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:shaker/undefined/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":null,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":5,"citations":[{"count":1,"year":"2024"},{"count":2,"year":"2020"},{"count":2,"year":"2022"}],"doi":"10.1093/bioinformatics/btz395","pmcid":"PMC6612843","pmid":"31510707","ref_count":24,"refs":[{"count":1,"year":"2003"},{"count":1,"year":"2005"},{"count":1,"year":"2008"},{"count":1,"year":"2009"},{"count":1,"year":"2011"},{"count":1,"year":"2015"},{"count":1,"year":"2019"},{"count":2,"year":"2007"},{"count":2,"year":"2012"},{"count":2,"year":"2018"},{"count":3,"year":"2013"},{"count":3,"year":"2016"},{"count":5,"year":"2017"}],"title":"ShaKer: RNA SHAPE prediction using graph kernel.","year":2019}]}],"readme":false,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl