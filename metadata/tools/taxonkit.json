{"tool_name":"taxonkit","contents":["biocontainers","galaxy","bioschemas","biotools","oeb"],"fetched_metadata":{"biocontainers":{"name":"taxonkit","identifiers":["doi:10.1101/513523"],"license":"MIT","summary":"A Cross-platform and Efficient NCBI Taxonomy Toolkit","home_url":"https://github.com/shenwei356/taxonkit","keywords":[],"manually_check":true,"total_pulls":7},"biotools":{"id":"taxonkit","home":"https://github.com/shenwei356/taxonkit","license":"MIT","summary":"TaxonKit is a practical and efficient NCBI taxonomy toolkit.","addition_date":"2021-12-13T08:32:03.778261Z","last_update_date":"2021-12-13T08:32:03.781004Z","tool_type":["Suite"],"biotools_curie":"biotools:taxonkit","credit":[{"email":"shenwei356@cqmu.edu.cn","name":"Wei Shen","orcidid":"https://orcid.org/0000-0002-8099-8258","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"renhong0531@cqmu.edu.cn","name":"Hong Ren","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"https://bioinf.shenwei.me/taxonkit/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Data retrieval","uri":"http://edamontology.org/operation_2422"},{"term":"Formatting","uri":"http://edamontology.org/operation_0335"}]}],"name":"TaxonKit","owner":"Kigaard","publication":[{"doi":"10.1016/J.JGG.2021.03.006","metadata":{"abstract":"\u00a9 2021 Institute of Genetics and Developmental Biology, Chinese Academy of Sciences, and Genetics Society of ChinaThe National Center for Biotechnology Information (NCBI) Taxonomy is widely applied in biomedical and ecological studies. Typical demands include querying taxonomy identifier (TaxIds) by taxonomy names, querying complete taxonomic lineages by TaxIds, listing descendants of given TaxIds, and others. However, existed tools are either limited in functionalities or inefficient in terms of runtime. In this work, we present TaxonKit, a command-line toolkit for comprehensive and efficient manipulation of NCBI Taxonomy data. TaxonKit comprises seven core subcommands providing functions, including TaxIds querying, listing, filtering, lineage retrieving and reformatting, lowest common ancestor computation, and TaxIds change tracking. The practical functions, competitive processing performance, scalability with different scales of datasets and good accessibility can facilitate taxonomy data manipulations. TaxonKit provides free access under the permissive MIT license on GitHub, Brewsci, and Bioconda. The documents are also available at https://bioinf.shenwei.me/taxonkit/.","authors":[{"name":"Ren H."},{"name":"Shen W."}],"citationCount":1,"date":"2021-09-20T00:00:00Z","journal":"Journal of Genetics and Genomics","title":"TaxonKit: A practical and efficient NCBI taxonomy toolkit"},"pmid":"34001434","type":["Primary"]}],"topic":[{"term":"Biotechnology","uri":"http://edamontology.org/topic_3297"},{"term":"Ecology","uri":"http://edamontology.org/topic_0610"},{"term":"Taxonomy","uri":"http://edamontology.org/topic_0637"}]},"bioschemas":{"name":"TaxonKit","home":"https://bio.tools/taxonkit","license":"MIT","summary":"TaxonKit is a practical and efficient NCBI taxonomy toolkit.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"0.20.0","first_commit":"2024-07-26","conda_name":"taxonkit","conda_version":"0.20.0","summary":"TaxonKit - A Practical and Efficient NCBI Taxonomy Toolkit","edam_operations":["Formatting","Data retrieval"],"edam_topics":["Taxonomy","Biotechnology","Ecology"],"toolshed_categories":["Metagenomics"],"toolshed_id":"taxonkit","users_5_years":12,"users_all_time":12,"usage_5_years":1094,"usage_all_time":1094,"bio_tools_summary":"TaxonKit is a practical and efficient NCBI taxonomy toolkit.","bio_tools_ids":"taxonkit","bio_tools_name":"TaxonKit","related_tutorials":[],"related_workflows":[{"create_time":"2026-07-05","latest_version":"3","link":"https://workflowhub.eu/workflows/2099?version=3","name":"mags-taxonomy-annotation/main"},{"create_time":"2025-01-18","la