{"tool_name":"spacem","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"spacem","home":"https://metaspace2020.eu/project/Rappez_2021_SpaceM","license":"Apache-2.0","summary":"A method for in situ single-cell metabolomics of cultured cells that integrates microscopy with MALDI-imaging mass spectrometry.","addition_date":"2021-11-20T18:38:56.875636Z","last_update_date":"2024-09-03T09:20:10.636926Z","tool_type":["Library"],"accessibility":"Open access","biotools_curie":"biotools:spacem","cost":"Free of charge","credit":[{"email":"theodore.alexandrov@embl.de","name":"Theodore Alexandrov","orcidid":"https://orcid.org/0000-0001-9464-6125","typeEntity":"Person"},{"email":"m.heikenwaelder@dkfz-heidelberg.de","name":"Mathias Heikenwalder","typeEntity":"Person"},{"name":"Prasad Phapale","orcidid":"https://orcid.org/0000-0002-9487-597X"}],"edit_permission":{"authors":["sizhengZhao"],"type":"group"},"function":[{"input":[{"data":{"term":"Mass spectrometry data","uri":"http://edamontology.org/data_2536"},"format":[{"term":"imzML metadata file","uri":"http://edamontology.org/format_3682"}]},{"data":{"term":"Raw image","uri":"http://edamontology.org/data_3424"},"format":[{"term":"JPG","uri":"http://edamontology.org/format_3579"},{"term":"OME-TIFF","uri":"http://edamontology.org/format_3727"},{"term":"PNG","uri":"http://edamontology.org/format_3603"},{"term":"tiff","uri":"http://edamontology.org/format_3591"}]}],"note":"The Image analysis in the operation represent \"Image segmentation\". \"http://edamontology.org/operation_Image_segmentation\"","operation":[{"term":"Anonymisation","uri":"http://edamontology.org/operation_3283"},{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Filtering","uri":"http://edamontology.org/operation_3695"},{"term":"Image analysis","uri":"http://edamontology.org/operation_3443"},{"term":"Image annotation","uri":"http://edamontology.org/operation_3553"},{"term":"Spectrum calculation","uri":"http://edamontology.org/operation_3860"}],"output":[{"data":{"term":"Image","uri":"http://edamontology.org/data_2968"},"format":[{"term":"JPG","uri":"http://edamontology.org/format_3579"},{"term":"OME-TIFF","uri":"http://edamontology.org/format_3727"},{"term":"PNG","uri":"http://edamontology.org/format_3603"},{"term":"tiff","uri":"http://edamontology.org/format_3591"}]},{"data":{"term":"Report","uri":"http://edamontology.org/data_2048"},"format":[{"term":"CSV","uri":"http://edamontology.org/format_3752"},{"term":"PDF","uri":"http://edamontology.org/format_3508"}]}]}],"name":"SpaceM","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1038/S41592-021-01198-0","metadata":{"abstract":"A growing appreciation of the importance of cellular metabolism and revelations concerning the extent of cell\u2013cell heterogeneity demand metabolic characterization of individual cells. We present SpaceM, an open-source method for in situ single-cell metabolomics that detects >100 metabolites from >1,000 individual cells per hour, together with a fluorescence-based readout and retention of morpho-spatial features. We validated SpaceM by predicting the cell types of cocultured human epithelial cells and mouse fibroblasts. We used SpaceM to show that stimulating human hepatocytes with fatty acids leads to the emergence of two coexisting subpopulations outlined by distinct cellular metabolic states. Inducing inflammation with the cytokine interleukin-17A perturbs the balance of these states in a process dependent on NF-\u03baB signaling. The metabolic state markers were reproduced in a murine model of nonalcoholic steatohepatitis. We anticipate SpaceM to be broadly applicable for investigations of diverse cellular models and to democratize single-cell metabolomics.","authors":[{"name":"Alexandrov T."},{"name":"Gathungu R.M."},{"name":"Heikenwalder M."},{"name":"Ovchinnikova K."},{"name":"Phapale P."},{"name":"Rappez L."},{"name":"Stadler M."},{"name":"Triana S."}],"citationCount":167,"date":"2021-07-01T00:00:00Z","journal":"Nature Methods","title":"SpaceM reveals metabolic states of single cells"},"pmcid":"PMC7611214","pmid":"34226721"}],"topic":[{"term":"Endocrinology and metabolism","uri":"http://edamontology.org/topic_3407"},{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}],"validated":1},"bioschemas":{"name":"SpaceM","home":"https://bio.tools/spacem","license":"Apache-2.0","summary":"A method for in situ single-cell metabolomics of cultured cells that integrates microscopy with MALDI-imaging mass spectrometry.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:spacem/lib/metaspace2020.eu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":189,"citations":[{"count":8,"year":"2021"},{"count":22,"year":"2026"},{"count":24,"year":"2022"},{"count":40,"year":"2025"},{"count":47,"year":"2023"},{"count":48,"year":"2024"}],"doi":"10.1038/s41592-021-01198-0","pmcid":"PMC7611214","pmid":"34226721","ref_count":48,"refs":[{"count":1,"year":"2002"},{"count":1,"year":"2006"},{"count":1,"year":"2011"},{"count":2,"year":"2009"},{"count":2,"year":"2014"},{"count":3,"year":"2012"},{"count":3,"year":"2013"},{"count":3,"year":"2015"},{"count":3,"year":"2020"},{"count":6,"year":"2016"},{"count":7,"year":"2017"},{"count":8,"year":"2018"},{"count":8,"year":"2019"}],"title":"SpaceM reveals metabolic states of single cells.","year":2021}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects