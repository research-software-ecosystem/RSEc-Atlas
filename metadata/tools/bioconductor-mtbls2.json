e":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconductor-mtbls2","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}}]},"bioconda":{"name":"bioconductor-mtbls2","version":"1.40.0","home":"https://bioconductor.org/packages/3.22/data/experiment/html/mtbls2.html","license":"CC0","summary":"MetaboLights MTBLS2: Comparative LC/MS-based profiling of silver nitrate-treated Arabidopsis thaliana leaves of wild-type and cyp79B2 cyp79B3 double knockout plants. B\u00f6ttcher et al. (2004)","description":"Indole-3-acetaldoxime (IAOx) represents an early intermediate of the biosynthesis of a variety of indolic secondary metabolites including the phytoanticipin indol-3-ylmethyl glucosinolate and the phytoalexin camalexin (3-thiazol-2'-yl-indole). Arabidopsis thaliana cyp79B2 cyp79B3 double knockout plants are completely impaired in the conversion of tryptophan to indole-3-acetaldoxime and do not accumulate IAOx-derived metabolites any longer. Consequently, comparative analysis of wild-type and cyp79B2 cyp79B3 plant lines has the potential to explore the complete range of IAOx-derived indolic secondary metabolites.","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["r-base"],"run":["r-base","curl","bioconductor-data-packages >=20260207"]},"source_url":["https://bioconductor.org/packages/3.22/data/experiment/src/contrib/mtbls2_1.40.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/mtbls2/mtbls2_1.40.0.tar.gz","https://bioarchive.galaxyproject.org/mtbls2_1.40