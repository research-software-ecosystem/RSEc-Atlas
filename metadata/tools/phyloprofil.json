{"tool_name":"phyloprofil","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"phyloprofil","home":"https://bioconductor.org/packages/PhyloProfile","license":"MIT","summary":"PhyloProfile is a tool for exploring complex phylogenetic profiles. Phylogenetic profiles, presence/absence patterns of genes over a set of species, are commonly used to trace the functional and evolutionary history of genes across species and time. With PhyloProfile we can enrich regular phylogenetic profiles with further data like sequence/structure similarity, to make phylogenetic profiling more meaningful. Besides the interactive visualisation powered by R-Shiny, the package offers a set of further analysis features to gain insights like the gene age estimation or core gene identification.","addition_date":"2018-06-02T07:29:31Z","last_update_date":"2026-08-30T02:27:11.640651Z","tool_type":["Desktop application"],"version":["2.4.6"],"collections":["BioConductor"],"biotools_curie":"biotools:phyloprofil","credit":[{"name":"Bastian Greshake Tzovaras","typeEntity":"Person","typeRole":["Developer"]},{"name":"Carla M\u00f6lbert","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Ingo Ebersberger","typeEntity":"Person","typeRole":["Developer"]},{"name":"Vinh Tran","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/PhyloProfile"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Phylogenetic tree analysis","uri":"http://edamontology.org/operation_0324"},{"term":"Phylogenetic tree visualisation","uri":"http://edamontology.org/operation_0567"}]}],"name":"PhyloProfil","operating_system":["Linux","Mac","Windows"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1093/bioinformatics/bty225"}],"topic":[{"term":"Data visualisation","uri":"http://edamontology.org/topic_0092"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Phylogene