{"tool_name":"bsoft","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bsoft","home":"http://bsoft.ws","license":"Not licensed","summary":"Bsoft is a collection of programs and a platform for development of software for image and molecular processing in structural biology.","addition_date":"2022-09-29T06:28:45.498951Z","last_update_date":"2022-09-29T06:30:15.495616Z","tool_type":["Command-line tool","Web application"],"biotools_curie":"biotools:bsoft","credit":[{"email":"heymannb@mail.nih.gov","name":"Bernard J. Heymann","typeEntity":"Person"}],"documentation":[{"type":["Training material"],"url":"http://bsoftwebsite.s3-website-us-east-1.amazonaws.com/"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Filtering","uri":"http://edamontology.org/operation_3695"},{"term":"Image analysis","uri":"http://edamontology.org/operation_3443"},{"term":"Structure analysis","uri":"http://edamontology.org/operation_2480"}]}],"name":"Bsoft","operating_system":["Linux","Mac","Windows"],"owner":"Chan019","publication":[{"doi":"10.21769/BIOPROTOC.4393","metadata":{"abstract":"Copyright \u00a9 2022 The Authors.Bsoft is a software package primarily developed for processing electron micrographs, with the goal of determining the structures of biologically relevant molecules, molecular assemblies, and parts of cells. However, it incorporates many ways to deal with images, from the mundane to very sophisticated algorithms. This article is an introduction into its use, illustrating that it is an extensive toolbox, for manipulating and understanding images. Bsoft has over 150 programs, allowing the user an infinite number of ways to process images. These programs can be executed on the command line, or through the interactive program called brun. The main visualization program is bshow, providing numerous ways to manipulate and interpret images. The primary aim is to provide the user with powerful capabilities, including processing large numbers of images. An important additional aim is to make it as accessible as possible, making it easier to deal with image formats and features, and enhance productivity.","authors":[{"name":"Heymann J.B."}],"date":"2022-04-20T00:00:00Z","journal":"Bio-protocol","title":"Bsoft: Image Processing for Structural Biology"},"pmcid":"PMC9081485","pmid":"35800093"}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Electron microscopy","uri":"http://edamontology.org/topic_0611"},{"term":"Molecular biology","uri":"http://edamontology.org/topic_3047"}],"validated":1},"bioschemas":{"name":"Bsoft","home":"https://bio.tools/bsoft","license":"Not licensed","summary":"Bsoft is a collection of programs and a platform for development of software for image and molecular processing in structural biology.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:bsoft/cmd/bsoft.ws","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"training_material":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":6,"citations":[{"count":1,"year":"2022"},{"count":1,"year":"2023"},{"count":1,"year":"2024"},{"count":1,"year":"2025"},{"count":2,"year":"2026"}],"doi":"10.21769/BioProtoc.4393","pmcid":"PMC9081485","pmid":"35800093","ref_count":14,"refs":[{"count":1,"year":"1999"},{"count":1,"year":"2004"},{"count":1,"year":"2006"},{"count":1,"year":"2007"},{"count":1,"year":"2015"},{"count":1,"year":"2017"},{"count":1,"year":"2018"},{"count":2,"year":"-1"},{"count":2,"year":"2019"},{"count":3,"year":"2020"}],"title":"Bsoft: Image Processing for Structural Biology.","year":2022}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"