{"tool_name":"bioconductor-glmsparsenet","contents":["biocontainers","oeb","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-glmsparsenet","identifiers":["doi:10.18129/b9.bioc.glmsparsenet"],"license":"GPL (>=3)","summary":"Network Centrality Metrics for Elastic-Net Regularized Models","home_url":"https://bioconductor.org/packages/3.11/bioc/html/glmSparseNet.html","keywords":[],"manually_check":true,"total_pulls":5},"biotools":{"id":"bioconductor-glmsparsenet","home":"https://bioconductor.org/packages/glmSparseNet","license":"GPL-3.0","summary":"glmSparseNet is an R-package that generalizes sparse regression models when the features (e.g. genes) have a graph structure (e.g. protein-protein interactions), by including network-based regularizers.  glmSparseNet uses the glmnet R-package, by including centrality measures of the network as penalty weights in the regularization. The current version implements regularization based on node degree, i.e. the strength and/or number of its associated edges, either by promoting hubs in the solution or orphan genes in the solution. All the glmnet distribution families are supported, namely \"gaussian\", \"poisson\", \"binomial\", \"multinomial\", \"cox\", and \"mgaussian\".","tool_type":["Command-line tool","Library"],"version":["1.30.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-glmsparsenet","credit":[{"name":"Andr\u00e9 Ver\u00edssimo","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Eunice Carrasquinha","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Marta Lopes","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Susana Vinga","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/glmSparseNet"}],"name":"glmSparseNet","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/mon