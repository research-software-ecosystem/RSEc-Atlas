{"tool_name":"nmrprocflow","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"nmrprocflow","home":"http://nmrprocflow.org/","license":"GPL-3.0","summary":"An interactive 1D NMR spectra processing tool dedicated to metabolomics. This open source software provides a complete set of tools for processing and visualization of 1D NMR data, the whole within an interactive interface based on a spectra visualization.","addition_date":"2017-04-13T13:56:19Z","last_update_date":"2024-11-24T20:21:11.101420Z","tool_type":["Desktop application","Web application"],"version":["1.4"],"accessibility":"Open access","biotools_curie":"biotools:nmrprocflow","cost":"Free of charge","credit":[{"email":"daniel.jacob@inrae.fr","name":"Daniel Jacob","orcidid":"https://orcid.org/0000-0002-6687-7169","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"https://nmrprocflow.org"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"NMR spectrum","uri":"http://edamontology.org/data_3488"}}],"operation":[{"term":"Alignment","uri":"http://edamontology.org/operation_2928"},{"term":"Data handling","uri":"http://edamontology.org/operation_2409"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"},{"term":"Spectral analysis","uri":"http://edamontology.org/operation_3214"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}],"output":[{"data":{"term":"Matrix","uri":"http://edamontology.org/data_2082"}}]}],"maturity":"Mature","name":"NMRProcFlow","operating_system":["Linux","Mac","Windows"],"owner":"djacob","publication":[{"doi":"10.1007/s11306-017-1178-y","metadata":{"abstract":"Introduction: Concerning NMR-based metabolomics, 1D spectra processing often requires an expert eye for disentangling the intertwined peaks. Objectives: The objective of NMRProcFlow is to assist the expert in this task in the best way without requirement of programming skills. Methods: NMRProcFlow was developed to be a graphical and interactive 1D NMR (1H & 13C) spectra processing tool. Results: NMRProcFlow (http://nmrprocflow.org), dedicated to metabolic fingerprinting and targeted metabolomics, covers all spectra processing steps including baseline correction, chemical shift calibration and alignment. Conclusion: Biologists and NMR spectroscopists can easily interact and develop synergies by visualizing the NMR spectra along with their corresponding experimental-factor levels, thus setting a bridge between experimental design and subsequent statistical analyses.","authors":[{"name":"Deborde C."},{"name":"Jacob D."},{"name":"Lefebvre M."},{"name":"Maucourt M."},{"name":"Moing A."}],"citationCount":140,"date":"2017-04-01T00:00:00Z","journal":"Metabolomics","title":"NMRProcFlow: a graphical and interactive tool dedicated to 1D spectra processing for NMR-based metabolomics"},"pmcid":"PMC5313591","pmid":"28261014","type":["Primary"]}],"topic":[{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"}],"validated":1},"bioschemas":{"name":"NMRProcFlow","home":"https://bio.tools/nmrprocflow","license":"GPL-3.0","version":"1.4","summary":"An interactive 1D NMR spectra processing tool dedicated to metabolomics. This open source software provides a complete set of tools for processing and visualization of 1D NMR data, the whole within an interactive interface based on a spectra visualization.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:nmrprocflow:1.2/app/nmrprocflow.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":95,"citations":[{"count":4,"year":"2018"},{"count":7,"year":"2019"},{"count":7,"year":"2020"},{"count":10,"year":"2026"},{"count":12,"year