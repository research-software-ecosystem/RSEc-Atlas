{"tool_name":"celltracker","contents":["neubias","oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"celltracker","home":"https://github.com/WangLabTHU/CellTracker","license":"LGPL-3.0","summary":"CellTracker is an automated toolbox for single-cell segmentation and tracking of time-lapse microscopy images. CellTracker is a highly integrated graphical user interface software, for automated cell segmentation and tracking of time-lapse microscopy images. It covers essential steps in image analysis including project management, image pre-processing, cell segmentation, cell tracking, manually correction, and statistical analysis such as the quantification of cell size and fluorescence intensity, etc. Furthermore, CellTracker provides an annotation tool and supports model training from scratch, thus proposing a flexible and scalable solution for customized dataset analysis.","addition_date":"2021-03-19T08:37:44Z","last_update_date":"2021-04-22T14:03:33Z","tool_type":["Desktop application","Suite"],"biotools_curie":"biotools:celltracker","credit":[{"email":"xwwang@tsinghua.edu.cn","name":"Xiaowo Wang","orcidid":"https://orcid.org/0000-0003-2965-8036","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Image analysis","uri":"http://edamontology.org/operation_3443"},{"term":"Image annotation","uri":"http://edamontology.org/operation_3553"},{"term":"Microscope image visualisation","uri":"http://edamontology.org/operation_3552"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"}]}],"name":"CellTracker","owner":"Kigaard","publication":[{"doi":"10.1093/BIOINFORMATICS/BTAA1106","pmid":"33416830"}],"topic":[{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Statistics and probability","uri":"http://edamontology.org/topic_2269"}]},"bioschemas":{"name":"CellTracker","home":"https://bio.tools/celltracker","license":"LGPL-3.0","summary":"CellTracker is an automated toolbox for single