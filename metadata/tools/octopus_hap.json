{"tool_name":"octopus_hap","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"octopus_hap","home":"https://github.com/luntergroup/octopus","license":"MIT","summary":"Octopus is a mapping-based variant caller that implements several calling models within a unified haplotype-aware framework. Octopus takes inspiration from particle filtering by constructing a tree of haplotypes and dynamically pruning and extending the tree based on haplotype posterior probabilities in a sequential manner. This allows octopus to implicitly consider all possible haplotypes at a given loci in reasonable time.","addition_date":"2022-02-17T15:53:29.019868Z","last_update_date":"2024-11-24T20:11:37.768336Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:octopus_hap","documentation":[{"type":["User manual"],"url":"https://luntergroup.github.io/octopus/"}],"edit_permission":{"type":"private"},"name":"octopus","owner":"Guerau","publication":[{"doi":"10.1038/s41587-021-00861-3","metadata":{"abstract":"Almost all haplotype-based variant callers were designed specifically for detecting common germline variation in diploid populations, and give suboptimal results in other scenarios. Here we present Octopus, a variant caller that uses a polymorphic Bayesian genotyping model capable of modeling sequencing data from a range of experimental designs within a unified haplotype-aware framework. Octopus combines sequencing reads and prior information to phase-called genotypes of arbitrary ploidy, including those with somatic mutations. We show that Octopus accurately calls germline variants in individuals, including single nucleotide variants, indels and small complex replacements such as microinversions. Using a synthetic tumor data set derived from clean sequencing data from a sample with known germline haplotypes and observed mutations in a large cohort of tumor samples, we show that Octopus is more sensitive to low-frequency somatic variation, yet calls considerably fewer false positives than other methods. Octopus also outputs realigned evidence BAM files to aid validation and interpretation.","authors":[{"name":"Cooke D.P."},{"name":"Lunter G."},{"name":"Wedge D.C."}],"citationCount":43,"date":"2021-07-01T00:00:00Z","journal":"Nature Biotechnology","title":"A unified haplotype-based method for accurate and comprehensive variant calling"},"pmcid":"PMC7611855","pmid":"33782612"}],"topic":[{"term":"DNA mutation","uri":"http://edamontology.org/topic_2533"}]},"bioschemas":{"name":"octopus","home":"https://bio.tools/octopus_hap","license":"MIT","summary":"Octopus is a mapping-based variant caller that implements several calling models within a unified haplotype-aware framework. Octopus takes inspiration from particle filtering by constructing a tree of haplotypes and dynamically pruning and extending the tree based on haplotype posterior probabilities in a sequential manner. This allows octopus to implicitly consider all possible haplotypes at a given loci in reasonable time.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:octopus_hap/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":66,"citations":[{"count":1,"year":"2020"},{"count":5,"year":"2021"},{"count":5,"year":"2026"},{"count":10,"year":"2025"},{"count":13,"year":"2023"},{"count":14,"year":"2022"},{"count":18,"year":"2024"}],"doi":"10.1038/s41587-021-00861-3","pmcid":"PMC7611855","pmid":"33782612","ref_count":31,"refs":[{"count":1,"year":"1998"},{"count":2,"year":"2011"},{"count":3,"year":"2013"},{"count":3,"year":"2014"},{"count":4,"year":"2012"},{"count":4,"year":"2015"},{"count":4,"year":"2017"},{"count":5,"year":"2016"},{"count":5,"year":"2018"}],"title":"A unified haplotype-based method for accurate and comprehensive variant calling.","year":2021}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":true,"resolve_time":"PT3081548S"}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:octopus_hap:0.3.3a/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":true,"resolve_time":"PT3081548S"}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:octopus_hap:0.4.1a/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"