{"tool_name":"4d-nucleome-data-portal","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"4d-nucleome-data-portal","home":"https://data.4dnucleome.org/","summary":"4D Nucleome Data Portal is a resource for searching and visualizing curated nucleomics data. The 4D Nucleome program aims to understand the principles behind the 3D organization of the nucleus in space and time (the 4th dimension). The 4DN Data Visualization Workspace allows users to create 1D or 2D genome displays. Registered users can save and share the displays they create. The Visualization Workspace is powered by HiGlass. The 4D Nucleome Data Portal hosts data generated by the 4DN Network and other reference nucleomics data sets, and an expanding tool set for open data processing and visualization.","addition_date":"2022-03-28T06:35:54.503414Z","last_update_date":"2022-03-28T06:35:54.507585Z","tool_type":["Bioinformatics portal","Web API"],"accessibility":"Open access","biotools_curie":"biotools:4d-nucleome-data-portal","cost":"Free of charge","credit":[{"email":"peter_park@hms.harvard.edu","name":"Peter J. Park","orcidid":"http://orcid.org/0000-0001-9378-960X","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["API documentation"],"url":"https://data.4dnucleome.org/help/user-guide/programmatic-access"},{"type":["FAQ"],"url":"https://data.4dnucleome.org/help/user-guide/faq"},{"type":["Quick start guide"],"url":"https://data.4dnucleome.org/help/user-guide/getting-started"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Database search","uri":"http://edamontology.org/operation_2421"},{"term":"Deposition","uri":"http://edamontology.org/operation_3431"},{"term":"Phasing","uri":"http://edamontology.org/operation_3454"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"4D Nucleome Data Portal","owner":"Kigaard","publication":[{"doi":"10.1101/2021.10.14.464435"}],"topic":[{"term":"Chromosom