{"tool_name":"t_coffee","contents":["biocontainers","oeb","biotools"],"fetched_metadata":{"biocontainers":{"name":"t_coffee","identifiers":[],"license":"GNU","summary":"A collection of tools for Computing, Evaluating and Manipulating Multiple Alignments of DNA, RNA, Protein Sequences and Structures.","home_url":"https://github.com/cbcrg/tcoffee","keywords":["Protein Sequences"],"manually_check":true,"total_pulls":22},"biotools":{"id":"t_coffee","home":"http://www.tcoffee.org/","license":"Freeware","summary":"T-Coffee is a multiple sequence alignment package. You can use T-Coffee to align sequences or to combine the output of your favorite alignment methods (Clustal, Mafft, Probcons, Muscle...) into one unique alignment (M-Coffee).\n\nT-Coffee can align Protein, DNA and RNA sequences. It is also able to combine sequence information with protein structural information (3D-Coffee/Expresso), profile information (PSI-Coffee) or RNA secondary structures (R-Coffee).","addition_date":"2024-11-05T05:51:37.897131Z","last_update_date":"2024-11-07T13:49:01.946320Z","tool_type":["Command-line tool"],"version":["13.45.0.4846264"],"biotools_curie":"biotools:t_coffee","edit_permission":{"authors":["rlibouban"],"type":"group"},"function":[{"operation":[{"term":"Multiple sequence alignment","uri":"http://edamontology.org/operation_0492"},{"term":"Sequence analysis","uri":"http://edamontology.org/operation_2403"}]}],"name":"t_coffee","operating_system":["Linux","Mac"],"owner":"gareth_galaxyaus","topic":[{"term":"Microbiology","uri":"http://edamontology.org/topic_3301"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:t_coffee:11.0.8/cmd/www.tcoffee.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[