{"tool_name":"gapfiller","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"gapfiller","identifiers":[],"license":"GPL-3","summary":"Gapfiller is a seed-and-extend local assembler to fill the gap within paired reads.","home_url":"https://sourceforge.net/projects/gapfiller","keywords":[],"manually_check":true,"total_pulls":1},"biotools":{"id":"gapfiller","home":"http://www.baseclear.com","summary":"GapFiller is an automated strategy, called to reliably close gaps within scaffolds using paired reads.","addition_date":"2022-03-21T10:13:27.665464Z","last_update_date":"2024-11-24T20:11:06.048538Z","biotools_curie":"biotools:gapfiller","credit":[{"name":"Walter Pirovano","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Localised reassembly","uri":"http://edamontology.org/operation_3183"}]}],"name":"Gapfiller","owner":"Kigaard","publication":[{"doi":"10.1186/gb-2012-13-6-r56","metadata":{"abstract":"De novo assembly is a commonly used application of next-generation sequencing experiments. The ultimate goal is to puzzle millions of reads into one complete genome, although draft assemblies usually result in a number of gapped scaffold sequences. In this paper we propose an automated strategy, called GapFiller, to reliably close gaps within scaffolds using paired reads. The method shows good results on both bacterial and eukaryotic datasets, allowing only few errors. As a consequence, the amount of additional wetlab work needed to close a genome is drastically reduced. The software is available at http://www.baseclear.com/bioinformatics-tools/. \u00a9 2012 Boetzer and Pirovano; licensee BioMed Central Ltd.","authors":[{"name":"Boetzer M."},{"name":"Pirovano W."}],"citationCount":860,"date":"2012-06-25T00:00:00Z","journal":"Genome Biology","title":"Toward almost closed genomes with GapFiller"},"pmcid":"PMC3446322","pmid":"22731987","type":["Primary"]}],"topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"}]},"bioschemas":{"name":"Gapfiller","home":"https://bio.tools/gapfiller","summary":"GapFiller is an automated strategy, called to reliably close gaps within scaffolds using paired reads.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:gapfiller/undefined/www.baseclear.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":781,"citations":[{"count":1,"year":"-1"},{"count":12,"year":"2012"},{"count":21,"year":"2026"},{"count":22,"year":"2013"},{"count":35,"year":"2023"},{"count":35,"year":"2025"},{"count":41,"year":"2024"},{"count":43,"year":"2022"},{"count":54,"year":"2021"},{"count":58,"year":"2020"},{"count":65,"year":"2019"},{"count":74,"year":"2017"},{"count":77,"year":"2014"},{"count":77,"year":"2018"},{"count":79,"year":"2015"},{"count":87,"year":"2016"}],"doi":"10.1186/gb-2012-13-6-r56","pmcid":"PMC3446322","pmid":"22731987","ref_count":12,"refs":[{"count":1,"year":"2008"},{"count":1,"year":"2012"},{"count":4,"year":"2010"},{"count":6,"year":"2009"}],"title":"Toward almost closed genomes with GapFiller.","year":2012}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://www.baseclear.com/"}],"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:gapfiller:2.1.1/cmd/sourceforge.net","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":