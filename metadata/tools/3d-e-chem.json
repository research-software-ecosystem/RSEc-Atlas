{"tool_name":"3d-e-chem","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"3d-e-chem","home":"http://3d-e-chem.github.io/3D-e-Chem-VM/","summary":"Structural Cheminformatics Research Infrastructure in a Freely Available Virtual Machine.","addition_date":"2018-05-30T07:01:13Z","last_update_date":"2018-12-10T12:58:59Z","tool_type":["Desktop application"],"biotools_curie":"biotools:3d-e-chem","credit":[{"email":"S.Verhoeven@esciencecenter.nl","name":"S. Verhoeven","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"c.de.graaf@vu.nl","name":"C. De. Graaf","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"ross.mcguire@bioaxisresearch.com","name":"Ross Mcguire","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/3D-e-Chem/3D-e-Chem-VM/wiki"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Peptide database search","uri":"http://edamontology.org/operation_3646"},{"term":"Protein function analysis","uri":"http://edamontology.org/operation_2414"},{"term":"Protein structure analysis","uri":"http://edamontology.org/operation_2406"}]}],"name":"3D-e-Chem-VM","operating_system":["Linux","Mac","Windows"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1021/ACS.JCIM.6B00686","metadata":{"abstract":"\u00a9 2017 American Chemical Society.3D-e-Chem-VM is an open source, freely available Virtual Machine (http://3d-e-chem.github.io/3D-e-Chem-VM/) that integrates cheminformatics and bioinformatics tools for the analysis of protein-ligand interaction data. 3D-e-Chem-VM consists of software libraries, and database and workflow tools that can analyze and combine small molecule and protein structural information in a graphical programming environment. New chemical and biological data analytics tools and workflows have been developed for the efficient exploitation of structural and pharmacological protein-ligand interaction data from proteomewide databases (e.g., ChEMBLdb and PDB), as well as customized information systems focused on, e.g., G protein-coupled receptors (GPCRdb) and protein kinases (KLIFS). The integrated structural cheminformatics research infrastructure compiled in the 3D-e-Chem-VM enables the design of new approaches in virtual ligand screening (Chemdb4VS), ligand-based metabolism prediction (SyGMa), and structure-based protein binding site comparison and bioisosteric replacement for ligand design (KRIPOdb).","authors":[{"name":"De Esch I.J.P."},{"name":"De Graaf C."},{"name":"Kooistra A.J."},{"name":"Leurs R."},{"name":"Lusher S.J."},{"name":"McGuire R."},{"name":"Ridder L."},{"name":"Ritschel T."},{"name":"Vass M."},{"name":"Verhoeven S."},{"name":"Vriend G."}],"citationCount":18,"date":"2017-02-27T00:00:00Z","journal":"Journal of Chemical Information and Modeling","title":"3D-e-Chem-VM: Structural Cheminformatics Research Infrastructure in a Freely Available Virtual Machine"},"pmcid":"PMC5342320","pmid":"28125221"}],"topic":[{"term":"Cheminformatics","uri":"http://edamontology.org/topic_2258"},{"term":"Chemistry","uri":"http://edamontology.org/topic_3314"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"},{"term":"Structure analysis","uri":"http://edamontology.org/topic_0081"}],"validated":1},"bioschemas":{"name":"3D-e-Chem-VM","home":"https://bio.tools/3d-e-chem","summary":"Structural Cheminformatics Research Infrastructure in a Freely Available Virtual Machine.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:3d-e-chem/app/3d-e-chem.github.io","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":fals