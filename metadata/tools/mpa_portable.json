{"tool_name":"mpa_portable","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"mpa_portable","home":"https://github.com/compomics/meta-proteome-analyzer","summary":"MetaProteomeAnalyzer (MPA) software for analyzing and visualizing MS-based metaproteomics data.","addition_date":"2018-07-15T10:48:53Z","last_update_date":"2024-11-25T14:13:56.543904Z","tool_type":["Command-line tool"],"collections":["Proteomics"],"biotools_curie":"biotools:mpa_portable","credit":[{"email":"muth@rki.de","name":"Thilo Muth","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/compomics/meta-proteome-analyzer"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"operation":[{"term":"Sequence analysis","uri":"http://edamontology.org/operation_2403"}]}],"name":"MPA Portable","operating_system":["Linux","Mac","Windows"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1021/acs.analchem.7b03544","metadata":{"abstract":"Metaproteomics, the mass spectrometry-based analysis of proteins from multispecies samples faces severe challenges concerning data analysis and results interpretation. To overcome these shortcomings, we here introduce the MetaProteomeAnalyzer (MPA) Portable software. In contrast to the original server-based MPA application, this newly developed tool no longer requires computational expertise for installation and is now independent of any relational database system. In addition, MPA Portable now supports state-of-the-art database search engines and a convenient command line interface for high-performance data processing tasks. While search engine results can easily be combined to increase the protein identification yield, an additional two-step workflow is implemented to provide sufficient analysis resolution for further postprocessing steps, such as protein grouping as well as taxonomic and functional annotation. Our new application has been developed with a focus on intuitive usability, adherence to data standards, and adaptation to Web-based workflow platforms. The open source software package can be found at https://github.com/compomics/meta-proteome-analyzer.","authors":[{"name":"Benndorf D."},{"name":"Heyer R."},{"name":"Kohrs F."},{"name":"Martens L."},{"name":"Muth T."},{"name":"Rapp E."},{"name":"Reichl U."},{"name":"Renard B.Y."}],"citationCount":39,"date":"2018-01-02T00:00:00Z","journal":"Analytical Chemistry","title":"MPA Portable: A Stand-Alone Software Package for Analyzing Metaproteome Samples on the Go"},"pmcid":"PMC5757220","pmid":"29215871"}],"topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"bioschemas":{"name":"MPA Portable","home":"https://bio.tools/mpa_portable","summary":"MetaProteomeAnalyzer (MPA) software for analyzing and visualizing MS-based metaproteomics data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mpa_portable/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":26,"citations":[{"count":1,"year":"2022"},{"count":2,"year":"2026"},{"count":3,"year":"2020"},{"count":3,"year":"2023"},{"count":3,"year":"2025"},{"count":4,"year":"2021"},{"count":5,"year":"2019"},{"count":5,"year":"2024"}],"doi":"10.1021/acs.analchem.7b03544","pmcid":"PMC5757220","pmid":"29215871","ref_count":35,"refs":[{"count":1,"year":"2005"},{"count"