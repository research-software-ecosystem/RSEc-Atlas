{"tool_name":"venn_diagrams","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"venn_diagrams","home":"http://bioinformatics.psb.ugent.be/webtools/Venn/","summary":"With this tool you can calculate the intersection(s) of list of elements. It will generate a textual output indicating which elements are in each intersection or are unique to a certain list. If the number of lists is lower than 6 it will also produce a graphical output in the form of a venn diagram. You have the choice between symmetric (default) or non symmetric venn diagrams. Currently you are able to calculate the intersections of at maximum 30 lists.","addition_date":"2016-01-31T16:35:01Z","last_update_date":"2018-12-10T12:58:50Z","tool_type":["Web application"],"version":["1"],"collections":["BIG N2N","Plant Systems Biology","UGent","VIB"],"biotools_curie":"biotools:venn_diagrams","credit":[{"email":"liste@psb.ugent.be","name":"Lieven Sterck","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"PSB","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["General"],"url":"http://bioinformatics.psb.ugent.be/webtools/Venn/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene set testing","uri":"http://edamontology.org/operation_3224"}]}],"name":"Venn Diagrams","operating_system":["Linux","Mac","Windows"],"owner":"PSB","topic":[{"term":"Data integration and warehousing","uri":"http://edamontology.org/topic_3366"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:venn_diagrams:1/web/bioinformatics.psb.ugent.be","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":200,"ssl":null,"ssl_err":null}},"support":{"email":true}}