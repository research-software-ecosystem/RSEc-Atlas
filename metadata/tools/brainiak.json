{"tool_name":"brainiak","contents":["bioschemas","biotools","oeb"],"identifiers":["biotools:brainiak"],"fetched_metadata":{"biotools":{"id":"brainiak","home":"http://brainiak.org","license":"Apache-2.0","summary":"Brain Imaging Analysis Kit (BrainIAK)  is a package of Python modules useful for neuroscience, primarily focused on functional Magnetic Resonance Imaging (fMRI) analysis. BrainIAK applies advanced machine learning methods and high-performance computing to analyzing neuroimaging data. It is tightly integrated with SciKit-Learn, and includes modules for Full Correlation Matrix Analysis (FCMA), Multi-voxel Pattern Analysis (MVPA), a suite of methods for Shared Response Modeling (SRM), Topographic Factor Analysis (TFA), Bayesian-derived methods for Representational Similarity Analysis (RSA), and more.","addition_date":"2021-01-18T07:04:19Z","last_update_date":"2026-11-12T14:41:30.409488Z","tool_type":["Library"],"biotools_curie":"biotools:brainiak","credit":[{"email":"mk35@princeton.edu","name":"Manoj Kumar","orcidid":"https://orcid.org/0000-0002-4911-2885","typeEntity":"Person"}],"documentation":[{"type":["Training material"],"url":"https://brainiak.org/tutorials/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Dimensionality reduction","uri":"http://edamontology.org/operation_3935"},{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Image analysis","uri":"http://edamontology.org/operation_3443"}]}],"name":"BrainIAK","owner":"Kigaard","publication":[{"doi":"10.52294/31bb5b68-2184-411b-8c00-a1dacb61e1da"},{"doi":"10.1371/JOURNAL.PCBI.1007549","pmcid":"PMC6961866","pmid":"31940340"},{"doi":"10.31219/osf.io/db2ev","type":["Preprint"]}],"topic":[{"term":"MRI","uri":"http://edamontology.org/topic_3444"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Medical imaging","uri":"http://edamontology.org/topic_3384"},{"term":"Neurobiology","uri":"http://edamontology.org/topic_33