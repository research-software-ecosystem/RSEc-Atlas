{"tool_name":"metdb","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"metdb","home":"http://metdb.sb-roscoff.fr/metdb/","license":"Not licensed","summary":"METdb is a genomic reference database dedicated to micro-eukaryotic marine species transcriptomes. Most datasets were from Marine Microbial Eukaryote Transcriptome Sequencing Project and others from Roscoff marine station and Tara research projects. All datasets were assembled and analyzed using two workflows dedicated to de novo assembly and functional annotation both developed with the CWL workflow management system. The assembly compartment includes evaluation, filtering and trimming of raw data and the de novo assembly and evaluation of assembled transcripts. The annotation compartment defines the presence of coding regions and functional annotation is performed. The resource includes transcriptome assemblies and associated data (metrics and annotations) of 463 distinct marine micro-eukaryotic taxa.","addition_date":"2020-04-03T07:37:31Z","last_update_date":"2020-04-03T07:59:04Z","tool_type":["Database portal"],"biotools_curie":"biotools:metdb","cost":"Free of charge","credit":[{"email":"mark.hoebeke@sb-roscoff.fr","name":"Mark Hoebeke","orcidid":"https://orcid.org/0000-0001-6311-9752"},{"email":"corre@sb-roscoff.fr","name":"Erwan Corre","orcidid":"https://orcid.org/0000-0001-6354-2278","typeEntity":"Person"},{"email":"eric.pelletier@genoscope.cns.fr","name":"Eric Pelletier","orcidid":"https://orcid.org/0000-0003-4228-1712","typeEntity":"Person"},{"email":"maxim@ebi.ac.uk","name":"Maxim Scheremetjew","orcidid":"https://orcid.org/0000-0002-7458-3072","typeEntity":"Person"},{"email":"rdf@ebi.ac.uk","name":"Rob Finn","orcidid":"https://orcid.org/0000-0001-8626-2148","typeEntity":"Person"},{"name":"Arnaud Meng","orcidid":"https://orcid.org/0000-0002-0377-5077","typeEntity":"Person"},{"name":"Guita Niang","typeEntity":"Person"}],"documentation":[{"type":["General"],"url":"http://metdb.sb-roscoff.fr/metdb/documentation/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"De-novo assembly","uri":"http://edamontology.org/operation_0524"},{"term":"Gene functional annotation","uri":"http://edamontology.org/operation_3672"}]}],"maturity":"Emerging","name":"METdb","owner":"corre_erwan","topic":[{"term":"Biodiversity","uri":"http://edamontology.org/topic_3050"},{"term":"Marine biology","uri":"http://edamontology.org/topic_3387"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:metdb/db/metdb.sb-roscoff.fr","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://metdb.sb-roscoff.fr/metdb/"}],"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/metdb","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://metdb.sb-roscoff.fr/metdb/"}],"ssl":true,"ssl_err":null}}}]}}}