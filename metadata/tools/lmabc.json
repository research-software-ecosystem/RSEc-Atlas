{"tool_name":"lmabc","contents":["biotools"],"identifiers":["biotools:lmabc"],"fetched_metadata":{"biotools":{"id":"lmabc","home":"https://drkowal.github.io/lmabc/","summary":"lmabc is an R package implementing an estimation scheme using Abundance-Based Constraints (ABCs) for linear regression, enabling the discovery of heterogeneous, group-specific effects (e.g., by race or sex) while maintaining estimation and inference for main effects.","addition_date":"2026-11-05T13:47:29.553422Z","last_update_date":"2026-11-05T13:47:29.556829Z","biotools_curie":"biotools:lmabc","credit":[{"email":"dan.kowal@cornell.edu","name":"Daniel R. Kowal","orcidid":"https://orcid.org/0000-0003-0917-3007","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Power test","uri":"http://edamontology.org/operation_4031"},{"term":"Regression analysis","uri":"http://edamontology.org/operation_3659"},{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"lmabc (Linear Regression with Abundance-Based Constraints)","owner":"pub2tools2024","publication":[{"doi":"10.1080/01621459.2026.2635078","pmcid":"PMC13251731","pmid":"42282507"}],"topic":[{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"},{"term":"Statistics and probability","uri":"http://edamontology.org/topic_2269"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"}]}}}