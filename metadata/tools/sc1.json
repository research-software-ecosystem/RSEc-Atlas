{"tool_name":"sc1","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"sc1","home":"https://sc1.engr.uconn.edu","summary":"SC1 (scRNA-Seq analysis pipeline) is a tool for interactive web-based single cell RNA-seq data analysis.","addition_date":"2021-11-29T12:16:01.831474Z","last_update_date":"2024-11-24T20:15:30.360757Z","tool_type":["Web application","Workflow"],"biotools_curie":"biotools:sc1","credit":[{"email":"ion.mandoiu@uconn.edu","name":"Ion I. M\u0103ndoiu","orcidid":"https://orcid.org/0000-0002-4818-0237","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"marmar.moussa@uconn.edu","name":"Marmar Moussa","orcidid":"https://orcid.org/0000-0003-0574-6656","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Dendrogram visualisation","uri":"http://edamontology.org/operation_2938"},{"term":"Differential gene expression profiling","uri":"http://edamontology.org/operation_3223"},{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Expression profile clustering","uri":"http://edamontology.org/operation_0313"},{"term":"Imputation","uri":"http://edamontology.org/operation_3557"}]}],"name":"SC1","owner":"Kigaard","publication":[{"doi":"10.1089/cmb.2021.0051","metadata":{"abstract":"Single-cell RNA-Seq (scRNA-Seq) is critical for studying cellular function and phenotypic heterogeneity as well as the development of tissues and tumors. In this study, we present SC1 a web-based highly interactive scRNA-Seq data analysis tool publicly accessible at https://sc1.engr.uconn.edu. The tool presents an integrated workflow for scRNA-Seq analysis, implements a novel method of selecting informative genes based on term-frequency inverse-document-frequency scores, and provides a broad range of methods for clustering, differential expression analysis, gene enrichment, interactive visualization, and cell cycle analysis. The tool integrates other single-cell omics data modalities such as T-cell receptor (TCR)-Seq and supports several single-cell sequencing technologies. In just a few steps, researchers can generate a comprehensive analysis and gain powerful insights from their scRNA-Seq data.","authors":[{"name":"Mandoiu I.I."},{"name":"Moussa M."}],"citationCount":6,"date":"2021-08-01T00:00:00Z","journal":"Journal of Computational Biology","title":"SC1: A Tool for Interactive Web-Based Single-Cell RNA-Seq Data Analysis"},"pmid":"34115950","type":["Primary"]}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]},"bioschemas":{"name":"SC1","home":"https://bio.tools/sc1","summary":"SC1 (scRNA-Seq analysis pipeline) is a tool for interactive web-based single cell RNA-seq data analysis.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:sc1/web/sc1.engr.uconn.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":8,"citations":[{"count":1,"year":"-1"},{"count":1,"year":"2021"},{"count":1,"year":"2022"},{"count":1,"year":"2023"},{"count":1,"year":"2025"},{"count":1,"year":"2026"},{"count":2,"year":"2024"}],"doi":"10.1089/cmb.2021.0051","pmid":"34115950","ref_count":0,"refs":[],"title":"SC1: A Tool for Interactive Web-Based Single-Cell RNA-Seq Data Analysis.","year":2021}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:sc1/workflow/sc1.engr.uconn