{"tool_name":"histometrix","contents":["biotools"],"identifiers":["biotools:histometrix"],"fetched_metadata":{"biotools":{"id":"histometrix","home":"https://www.quantacell.com/products/histometrix/","license":"Proprietary","summary":"HistoMetriX is a quantitative histology and digital pathology image analysis software for biomedical research. It enables AI-assisted tissue segmentation, cell detection and classification, biomarker quantification, morphological and intensity measurements, and spatial analysis from brightfield and fluorescence microscopy images, including whole-slide images and tissue microarrays. Custom deep-learning models can be trained to identify tissue structures and biological phenotypes specific to a study.","addition_date":"2026-09-23T09:30:01.957544Z","last_update_date":"2026-09-23T09:30:01.967800Z","tool_type":["Desktop application","Suite"],"biotools_curie":"biotools:histometrix","cost":"Commercial","credit":[{"email":"victor.racine@quantacell.com","name":"Victor Racine","orcidid":"https://orcid.org/0000-0002-1486-8973","typeEntity":"Person","url":"https://www.quantacell.com/"},{"email":"contact@quantacell.com","name":"QuantaCell","typeEntity":"Project","url":"https://www.quantacell.com/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Image annotation","uri":"http://edamontology.org/operation_3553"}]},{"operation":[{"term":"Microscope image visualisation","uri":"http://edamontology.org/operation_3552"}]},{"operation":[{"term":"Neurite measurement","uri":"http://edamontology.org/operation_3450"}]},{"operation":[{"term":"Single particle alignment and classification","uri":"http://edamontology.org/operation_3458"}]},{"operation":[{"term":"Single particle alignment and classification","uri":"http://edamontology.org/operation_3458"}]}],"maturity":"Mature","name":"HistoMetriX","operating_system":["Windows"],"owner":"victor3","topic":[{"term":"Bioimaging","uri":"http://edamontology.org/topic_3383"}]}}}