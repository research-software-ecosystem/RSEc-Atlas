{"tool_name":"lfqc","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"lfqc","home":"http://engr.uconn.edu/~rajasek/","summary":"New lossless non-reference based fastq compression algorithm.","addition_date":"2017-08-03T18:48:01Z","last_update_date":"2018-12-10T12:58:43Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:lfqc","credit":[{"email":"rajasek@engr.uconn.edu","name":"Sanguthevar Rajasekaran","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://engr.uconn.edu/~rajasek/"}],"documentation":[{"type":["General"],"url":"https://github.com/mariusmni/lfqc/blob/master/README.md"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Formatting","uri":"http://edamontology.org/operation_0335"}]}],"name":"LFQC","operating_system":["Linux","Mac"],"owner":"mbs_import","publication":[{"metadata":{"abstract":"\u00a9 2015 The Author.Motivation: Next Generation Sequencing (NGS) technologies have revolutionized genomic research by reducing the cost of whole genome sequencing. One of the biggest challenges posed by modern sequencing technology is economic storage of NGS data. Storing raw data is infeasible because of its enormous size and high redundancy. In this article, we address the problem of storage and transmission of large FASTQ files using innovative compression techniques. Results: We introduce a new lossless non-reference based FASTQ compression algorithm named Lossless FASTQ Compressor. We have compared our algorithm with other state of the art big data compression algorithms namely gzip, bzip2, fastqz (Bonfield and Mahoney, 2013), fqzcomp (Bonfield and Mahoney, 2013), Quip (Jones et al., 2012), DSRC2 (Roguski and Deorowicz, 2014). This comparison reveals that our algorithm achieves better compression ratios on LS454 and SOLiD datasets.","authors":[{"name":"Nicolae M."},{"name":"Pathak S."},{"name":"Rajasekaran S."}],"citationCount":28,"date":"2015-03-25T00:00:00Z","journal":"Bioinformatics","title":"LFQC: A lossless compression algorithm for FASTQ files"},"pmid":"26093148"}],"topic":[{"term":"Data management","uri":"http://edamontology.org/topic_3071"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:lfqc/cmd/engr.uconn.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":20,"citations":[{"count":1,"year":"-1"},{"count":1,"year":"2018"},{"count":1,"year":"2021"},{"count":1,"year":"2023"},{"count":1,"year":"2024"},{"count":2,"year":"2016"},{"count":2,"year":"2020"},{"count":2,"year":"2025"},{"count":3,"year":"2017"},{"count":3,"year":"2019"},{"count":3,"year":"2022"}],"doi":"10.1093/bioinformatics/btv384","pmcid":"PMC4795634","pmid":"26093148","ref_count":14,"refs":[{"count":1,"year":"1998"},{"count":1,"year":"2010"},{"count":1,"year":"2013"},{"count":1,"year":"2014"},{"count":2,"year":"2009"},{"count":3,"year":"2012"},{"count":5,"year":"2011"}],"title":"LFQC: a lossless compression algorithm for FASTQ files.","year":2015}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":404,"redirects":[{"status":301,"url":"https://engineering.uconn.edu/~rajasek/"},{"status":301,"url":"https://engr.uconn.edu/~rajasek/"}],"ssl":true,"ssl_err":null}},"support":{"email":true,"issue_tracking":{"public_tracker":true,"resolve_time":"PT143819S"}}},{"@id":"https://openebench.bsc.es/monitor/metrics/lfqc","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@