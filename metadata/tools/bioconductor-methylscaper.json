{"tool_name":"bioconductor-methylscaper","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-methylscaper","home":"https://bioconductor.org/packages/methylscaper","license":"GPL-2.0","summary":"methylscaper is an R package for processing and visualizing data jointly profiling methylation and chromatin accessibility (MAPit, NOMe-seq, scNMT-seq, nanoNOMe, etc.). The package supports both single-cell and single-molecule data, and a common interface for jointly visualizing both data types through the generation of ordered representational methylation-state matrices. The Shiny app allows for an interactive seriation process of refinement and re-weighting that optimally orders the cells or DNA molecules to discover methylation patterns and nucleosome positioning.","tool_type":["Command-line tool","Library"],"version":["1.20.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-methylscaper","credit":[{"name":"Bacher Rhonda","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Parker Knight","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/methylscaper"}],"name":"methylscaper","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-methylscaper:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-methylscaper:1.10.0/cmd/bioconductor.org","@license":"https://creativ