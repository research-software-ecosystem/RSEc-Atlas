{"tool_name":"rtcga","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-rtcga","version":"1.40.0","home":"https://bioconductor.org/packages/3.22/bioc/html/RTCGA.html","license":"GPL-2","summary":"The Cancer Genome Atlas Data Integration","identifiers":["biotools:rtcga","doi:10.1038/nmeth.3252"],"description":"The Cancer Genome Atlas (TCGA) Data Portal provides a platform for researchers to search, download, and analyze data sets generated by TCGA. It contains clinical information, genomic characterization data, and high level sequence analysis of the tumor genomes. The key is to understand genomics to improve cancer care. RTCGA package offers download and integration of the variety and volume of TCGA data using patient barcode key, what enables easier data possession. This may have an benefcial infuence on impact on development of science and improvement of patients' treatment. Furthermore, RTCGA package transforms TCGA data to tidy form which is convenient to use.","license_file":"/lib/R/share/licenses/GPL-2","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["r-assertthat","r-base","r-data.table","r-dplyr","r-ggplot2","r-ggthemes","r-htmltools","r-knitr","r-purrr","r-rcurl","r-rmarkdown","r-rvest","r-scales","r-stringi","r-survival","r-survminer","r-viridis","r-xml","r-xml2"],"run":["r-assertthat","r-base","r-data.table","r-dplyr","r-ggplot2","r-ggthemes","r-htmltools","r-knitr","r-purrr","r-rcurl","r-rmarkdown","r-rvest","r-scales","r-stringi","r-survival","r-survminer","r-viridis","r-xml","r-xml2"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/RTCGA_1.40.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RTCGA/RTCGA_1.40.0.tar.gz","https://bioarchive.galaxyproject.org/RTCGA_1.40.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-rtcga/bioconductor-rtcga_1.40.0_src_all.tar.gz"],"test":