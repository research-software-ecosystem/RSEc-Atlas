{"tool_name":"sapfinder","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"sapfinder","home":"http://bioconductor.org/packages/release/bioc/html/sapFinder.html","license":"GPL-2.0","summary":"Tool developed to automate (1) variation-associated database construction, (2) database searching, (3) post-processing, (4) HTML-based report generation in shotgun proteomics.","addition_date":"2017-01-17T15:04:52Z","last_update_date":"2019-07-19T17:50:47Z","tool_type":["Command-line tool","Library"],"version":["1.12.0"],"collections":["BioConductor","Proteomics"],"biotools_curie":"biotools:sapfinder","credit":[{"email":"wenbo@genomics.cn","name":"Bo Wen","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"xsh.skye@gmail.com","name":"Shaohang Xu","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/html/sapFinder.html"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"operation":[{"term":"Deposition","uri":"http://edamontology.org/operation_3431"},{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"}]}],"name":"sapFinder","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1093/bioinformatics/btu397","metadata":{"abstract":"\u00a9 The Author 2014. Published by Oxford University Press.Single nucleotide variations (SNVs) located within a reading frame can result in single amino acid polymorphisms (SAPs), leading to alteration of the corresponding amino acid sequence as well as function of a protein. Accurate detection of SAPs is an important issue in proteomic analysis at the experimental and bioinformatic level. Herein, we present sapFinder, an R software package, for detection of the variant peptides based on tandem mass spectrometry (MS/MS)-based proteomics data. This package automates the construction of variation-associated databases from public SNV repositories or sample-specific next-generation sequencing (NGS) data and the identification of SAPs through database searching, post-processing and generation of HTML-based report with visualized interface.","authors":[{"name":"Feng Q."},{"name":"Lin L."},{"name":"Liu S."},{"name":"Sheynkman G.M."},{"name":"Wang J."},{"name":"Wang Q."},{"name":"Wen B."},{"name":"Xu S."},{"name":"Xu X."}],"citationCount":19,"date":"2014-01-01T00:00:00Z","journal":"Bioinformatics","title":"SapFinder: An R/Bioconductor package for detection of variant peptides in shotgun proteomics experiments"},"type":["Primary"]}],"topic":[{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"}],"validated":1},"bioschemas":{"name":"sapFinder","home":"https://bio.tools/sapfinder","license":"GPL-2.0","version":"1.12.0","summary":"Tool developed to automate (1) variation-associated database construction, (2) database searching, (3) post-processing, (4) HTML-based report generation in shotgun proteomics.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:sapfinder:1.12.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":17,"citations":[{"count":1,"year":"2015"},{"count":1,"year":"2020"},{"count":1,"year":"2023"},{"count":2,"year":"2018"},{"count":2,"year":"2022"},{"count":2,"year":"2024"},{"count":2,"year":"2025"},{"count":3,"year":"2016"},{"count":3,"year":"2017"}],"doi":"10.1093/bioinformatics/btu397","pmcid":"PMC4609003","pmid":"25053745","ref_count":20,"refs":[{"count":1,"year":"1999"},{"count":1,"year":"2001"},{"count":1,"year":"2002"},{"count":1,"year":"2004"},{"count":1,"year":"2005"},{"count":1,"year":"2007"},{"count":1,