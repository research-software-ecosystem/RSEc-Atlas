{"tool_name":"authentict","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"authentict","home":"https://github.com/StephanePeyregne/AuthentiCT","license":"GPL-3.0","summary":"AuthentiCT is a command-line tool to estimate the proportion of present-day DNA contamination in ancient DNA datasets generated from single-stranded libraries. It estimates contamination using an ancient DNA damage model and assumes that the contaminant is not deaminated.","addition_date":"2021-01-18T08:15:07Z","last_update_date":"2024-11-24T20:46:33.533239Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:authentict","credit":[{"email":"stephanepeyregne@gmail.com","name":"St\u00e9phane Peyr\u00e9gne","orcidid":"https://orcid.org/0000-0002-9823-9102","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"DNA substitution modelling","uri":"http://edamontology.org/operation_0550"},{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Sequence contamination filtering","uri":"http://edamontology.org/operation_3187"}]}],"name":"AuthentiCT","owner":"Kigaard","publication":[{"doi":"10.1186/s13059-020-02123-y","metadata":{"abstract":"Contamination from present-day DNA is a fundamental issue when studying ancient DNA from historical or archaeological material, and quantifying the amount of contamination is essential for downstream analyses. We present AuthentiCT, a command-line tool to estimate the proportion of present-day DNA contamination in ancient DNA datasets generated from single-stranded DNA libraries. The prediction is based solely on the patterns of post-mortem damage observed on ancient DNA sequences. The method has the power to quantify contamination from as few as 10,000 mapped sequences, making it particularly useful for analysing specimens that are poorly preserved or for which little data is available.","authors":[{"name":"Peter B.M."},{"name":"Peyregne S."}],"citationCount":34,"date":"2020-09-15T00:00:00Z","journal":"Genome Biology","title":"AuthentiCT: A model of ancient DNA damage to estimate the proportion of present-day DNA contamination"},"pmcid":"PMC7490890","pmid":"32933569","type":["Primary"]},{"doi":"10.1101/2020.03.13.991240","type":["Primary"]}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Sequence sites, features and motifs","uri":"http://edamontology.org/topic_0160"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}]},"bioschemas":{"name":"AuthentiCT","home":"https://bio.tools/authentict","license":"GPL-3.0","summary":"AuthentiCT is a command-line tool to estimate the proportion of present-day DNA contamination in ancient DNA datasets generated from single-stranded libraries. It estimates contamination using an ancient DNA damage model and assumes that the contaminant is not deaminated.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:authentict/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":39,"citations":[{"count":4,"year":"2024"},{"count":6,"year":"2026"},{"count":7,"year":"2021"},{"count":7,"year":"2023"},{"count":7,"year":"2025"},{"count":8,"year":"2022"}],"doi":"10.1186/s13059-020-02123-y","pmcid":"PMC7490890","pmid":"32933569","ref_count":66,"refs":[{"count":1,"year":"1974"},{"count":1,"year":"1993"},{"count":1,"year":"2006"},{"count":1,"year":"2008"},{"count":1,"year":"2020"},{"count":2,"year":"2001"},{"count":2,"