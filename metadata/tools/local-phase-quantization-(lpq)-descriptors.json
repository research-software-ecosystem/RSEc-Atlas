{"tool_name":"local-phase-quantization-(lpq)-descriptors","contents":["neubias"],"fetched_metadata":{"neubias":{"body":[{"format":"basic_html","processed":"<p>This is a Matlab implementation of Local Phase Quantization (LPQ) texture descriptors that is robust to image blurring due to the use of phase information. Theoretical background could be found here: <a href=\"http://www.ee.oulu.fi/research/mvmp/mvg/files/pdf/ICISP08.pdf\">http://www.ee.oulu.fi/research/mvmp/mvg/files/pdf/ICISP08.pdf</a></p>","summary":"","value":"<p>This is a Matlab implementation of Local Phase Quantization (LPQ) texture descriptors that is robust to image blurring due to the use of phase information. Theoretical background could be found here: http://www.ee.oulu.fi/research/mvmp/mvg/files/pdf/ICISP08.pdf</p>\r\n"}],"changed":[{"format":"Y-m-d\\TH:i:sP","value":"2019-10-18T16:18:54+00:00"}],"created":[{"format":"Y-m-d\\TH:i:sP","value":"2017-02-13T14:55:26+00:00"}],"default_langcode":[{"value":true}],"attribution_instructions":[],"comments_2023":[],"free_tagging":[],"give_feedback_on_this_soft":[{"cid":0,"comment_count":0,"last_comment_name":null,"last_comment_timestamp":1505227358,"last_comment_uid":164,"status":2}],"has_author":[{"value":"Center for machine vision and signal analysis (Oulu University)"}],"has_biological_terms":[],"has_comparison":[],"has_documentation":[],"has_doi":[],"has_entry_curator":[{"target_id":175,"target_type":"user","target_uuid":"3750f9fc-5ff9-4411-8990-b3e992f13b8d","url":"/user/175"}],"has_function":[{"target_id":4065,"target_type":"taxonomy_term","target_uuid":"http://edamontology.org/operation_Object_detection","url":"/image-feature-detection"},{"target_id":4053,"target_type":"taxonomy_term","target_uuid":"http://edamontology.org/operation_Image_processing","url":"/image-processing"}],"has_implementation":[],"has_interaction_level":[{"target_id":3574,"target_type":"taxonomy_term","target_uuid":"a22a3a50-0fbb-41ee-944a-38e0b86ac077","url":"/taxonomy/term/3574