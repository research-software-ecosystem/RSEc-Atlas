mat":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}]}],"name":"Denovogui","operating_system":["Linux","Mac","Windows"],"owner":"Katrijn.Vannerum@ugent.be","publication":[{"doi":"10.1021/pr4008078","metadata":{"abstract":"De novo sequencing is a popular technique in proteomics for identifying peptides from tandem mass spectra without having to rely on a protein sequence database. Despite the strong potential of de novo sequencing algorithms, their adoption threshold remains quite high. We here present a user-friendly and lightweight graphical user interface called DeNovoGUI for running parallelized versions of the freely available de novo sequencing software PepNovo+, greatly simplifying the use of de novo sequencing in proteomics. Our platform-independent software is freely available under the permissible Apache2 open source license. Source code, binaries, and additional documentation are available at http://denovogui.googlecode.com. \u00a9 2013 American Chemical Society.","authors":[{"name":"Barsnes H."},{"name":"Huber C.G."},{"name":"Martens L."},{"name":"Muth T."},{"name":"Rapp E."},{"name":"Vaudel M."},{"name":"Weilnbock L."}],"citationCount":67,"date":"2014-02-07T00:00:00Z","journal":"Journal of Proteome Research","title":"DeNovoGUI: An open source graphical user interface for de novo sequencing of tandem mass spectra"},"pmcid":"PMC3923451","pmid":"24295440","type":["Primary"]}],"topic":[{"term":"Proteins","uri":"http://edamontology.org/topic_0078"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"}],"validated":1},"bioschemas":{"name":"Denovogui","home":"https://bio.tools/denovogui","license":"Apache-2.0","version":"1.9.6","summary":"Graphical user interface for de novo sequencing of tandem mass spectra.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:denovogui:1.9.6/app/compomic