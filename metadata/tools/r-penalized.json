{"tool_name":"r-penalized","contents":["biocontainers","oeb"],"fetched_metadata":{"biocontainers":{"name":"r-penalized","identifiers":[],"license":"GPL (>= 2)","summary":"Fitting possibly high dimensional penalized regression models. The penalty structure can be any combination of an L1 penalty (lasso and fused lasso), an L2 penalty (ridge) and a positivity constraint on the regression coefficients. The supported regression models are linear, logistic and Poisson regression and the Cox Proportional Hazards model. Cross-validation routines allow optimization of the tuning parameters.","home_url":"https://CRAN.R-project.org/package=penalized","keywords":[],"manually_check":true,"total_pulls":0},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:r-penalized:0.9.47/cmd/cran.r-project.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/r-penalized","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}}]}}}