],"operation":[{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"}],"output":[{"data":{"term":"Nucleic acid features","uri":"http://edamontology.org/data_1276"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"}]}]},{"input":[{"data":{"term":"Gene symbol","uri":"http://edamontology.org/data_1026"}},{"data":{"term":"Species name","uri":"http://edamontology.org/data_1045"}}],"operation":[{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"}],"output":[{"data":{"term":"Nucleic acid features","uri":"http://edamontology.org/data_1276"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"}]}]}],"name":"AceView genes database","operating_system":["Linux","Mac","Windows"],"owner":"DRCAT","publication":[{"doi":"10.1016/j.immuni.2009.10.008","metadata":{"abstract":"Interleukin-21 (IL-21) is a pleiotropic cytokine that induces expression of transcription factor BLIMP1 (encoded by Prdm1), which regulates plasma cell differentiation and T cell homeostasis. We identified an IL-21 response element downstream of Prdm1 that binds the transcription factors STAT3 and IRF4, which are required for optimal Prdm1 expression. Genome-wide ChIP-Seq mapping of STAT3- and IRF4-binding sites showed that most regions with IL-21-induced STAT3 binding also bound IRF4 in vivo and furthermore revealed that the noncanonical TTCnnnTAA GAS motif critical in Prdm1 was broadly used for STAT3 binding. Comparing genome-wide expression array data to binding sites revealed that most IL-21-regulated genes were associated with combined STAT3-IRF4 sites rather than pure STAT3 sites. Correspondingly, ChIP-Seq analysis of Irf4-/- T cells showed greatly diminished STAT3 binding after IL-21 treatment, and Irf4-/- mice showed impaired IL-21-induced Tfh cell differentiation in vivo. These results reveal broad cooperative gene regulation by STAT3 and IRF4. \u00a9 2009 Elsevier Inc. All rights reserved.","authors":[{"name":"Calame K."},{"name":"Carotta S."},{"name":"Donovan C.E."},{"name":"Goldman M.L."},{"name":"Kim H.-P."},{"name":"Kwon H."},{"name":"Leonard W.J."},{"name":"Levy D.E."},{"name":"Nutt S.L."},{"name":"Oh J."},{"name":"Ozato K."},{"name":"Tailor P."},{"name":"Thierry-Mieg D."},{"name":"Thierry-Mieg J."},{"name":"Tunyaplin C."}],"citationCount":245,"date":"2009-12-18T00:00:00Z","journal":"Immunity","title":"Analysis of Interleukin-21-Induced Prdm1 Gene Regulation Reveals Functional Cooperation of STAT3 and IRF4 Transcription Factors"},"pmcid":"PMC3272079","pmid":"20064451","type":["Primary"]}],"topic":[{"term":"Gene and protein families","uri":"http://edamontology.org/topic_0623"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"}],"validated":1},"bioschemas":{"name":"AceView genes database","home":"https://bio.tools/aceview","summary":"A curated, comprehensive and non-redundant sequence representation of all public mRNA sequences (mRNAs from GenBank or RefSeq, and single pass cDNA sequences from dbEST and Trace).","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:aceview/db/www.ncbi.nlm.nih.gov","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":223,"citations":[{"count":3,"year":"2026"},{"count":6,"year":"2020"},{"count":6,"year":"2024"},{"count":6,"year":"2025"},{"count":7,"year":"2017"},{"count":7,"year":"2019"},{"count":11,"year":"2018"},{"count":11,"year":"2023"},{"count":12,"year":"2010"},{"count":14,"year":"2011"},{"count":14,"year":"2022"},{"count":17,"year":"2021"},{"count":19,"year":"2012"},{"count":21,"year":"2015"},{"count":21,"year":"2016"},{"count":22,"year":"2014"},{"count":26,"year":"2013"}],"doi":"10.1016/j.immuni.2009.10.008","pmcid":"PMC3272079","pmid":"20064451","ref_count":35,"refs":[{"count":1,"year":"1993