{"tool_name":"ncoils","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"ncoils","identifiers":["biotools:ncoils","doi:10.1126/science.252.5009.1162"],"license":"GPL-2","summary":"Program that compares a sequence to a database of known parallel two-stranded coiled-coils and derives a similarity score. by comparing this score to the distribution of scores in globular and coiled-coil proteins, the program then calculates the probability that the sequence will adopt a coiled-coil conformation.","home_url":"https://embnet.vital-it.ch/software/COILS_form.html","keywords":["Amino Acid Sequence","Amino Acids","Animals","Databases, Factual","Humans","Probability","Protein Conformation","Proteins","Protein secondary structure","Protein Sequences"],"manually_check":true,"total_pulls":0},"biotools":{"id":"ncoils","home":"http://www.predictprotein.org","summary":"Prediction of coiled-coil secondary structure elements.","addition_date":"2015-12-03T10:07:15Z","last_update_date":"2024-11-24T15:12:26.942553Z","tool_type":["Web application"],"version":["1"],"collections":["Rostlab tools"],"biotools_curie":"biotools:ncoils","credit":[{"email":"help@predicrtprotein.org","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"RostLab","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["General"],"url":"https://www.predictprotein.org/"}],"edit_permission":{"authors":["KISALAY"],"type":"group"},"function":[{"input":[{"data":{"term":"Protein sequence (raw)","uri":"http://edamontology.org/data_2974"},"format":[{"term":"FASTA-like (text)","uri":"http://edamontology.org/format_2200"}]}],"operation":[{"term":"Protein secondary structure prediction (coils)","uri":"http://edamontology.org/operation_0470"}],"output":[{"data":{"term":"Protein features","uri":"http://edamontology.org/data_1277"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}]}],"name":"ncoils","operating_system":["Linux","Mac","Windows"],"owner":"RostLab","publication":[{"doi":"10.1126/science.252.5009.1162","metadata":{"abstract":"The probability that a residue in a protein is part of a coiled-coil structure was assessed by comparison of its flanking sequences with sequences of known coiled-coil proteins. This method was used to delineate coiled-coil domains in otherwise globular proteins, such as the leucine zipper domains in transcriptional regulators, and to predict regions of discontinuity within coiled-coil structures, such as the hinge region in myosin. More than 200 proteins that probably have coiled-coil domains were identified in GenBank, including \u03b1- and \u03b2-tubulins, flagellins, G protein \u03b2 subunits, some bacterial transfer RNA synthetases, and members of the heat shock protein (Hsp70) family.","authors":[{"name":"Lupas A."},{"name":"Stock J."},{"name":"Van Dyke M."}],"citationCount":3617,"date":"1991-01-01T00:00:00Z","journal":"Science","title":"Predicting coiled coils from protein sequences"},"pmid":"2031185","type":["Primary"]}],"topic":[{"term":"Protein secondary structure","uri":"http://edamontology.org/topic_3542"}],"validated":1},"bioschemas":{"name":"ncoils","home":"https://bio.tools/ncoils","version":"1","summary":"Prediction of coiled-coil secondary structure elements.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ncoils:1/web/www.predictprotein.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true,"help":true,"tutorial":true},"publications":[{"entries":[{"cit_count":1782,"citations":[{"count":1,"year":"1991"},{"count":4,"year":"-1"},{"count":9,"year":"1992"},{"count":9,"year":"1993"},{"count":13,"year":"2026"},{"count":16,"year":"1994"},{"count":24,"year":"2024"},{"count":24,"year":"2025"},{"count":30,"year":"2023"},{"count":36,"year":"1