{"tool_name":"nlpexplorer","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"nlpexplorer","home":"http://nlpexplorer.org","summary":"Exploring the Universe of NLP Papers.\n\nUnderstanding the current research trends, problems, and their innovative solutions remains a bottleneck due to the ever-increasing volume of scientific articles. In this paper, we propose NLPExplorer, a completely automatic portal for indexing, searching, and visualizing Natural Language Processing (NLP) research volume. NLPExplorer presents interesting insights from papers, authors, venues, and topics.","addition_date":"2021-01-18T08:47:14Z","last_update_date":"2024-11-24T20:40:04.413965Z","tool_type":["Web application"],"biotools_curie":"biotools:nlpexplorer","credit":[{"email":"singh.mayank@iitgn.ac.in","name":"Mayank Singh","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Database search","uri":"http://edamontology.org/operation_2421"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"NLPExplorer","owner":"Niclaskn","publication":[{"pmcid":"PMC7148103"}],"topic":[{"term":"Data acquisition","uri":"http://edamontology.org/topic_3077"},{"term":"Data architecture, analysis and design","uri":"http://edamontology.org/topic_3365"},{"term":"Natural language processing","uri":"http://edamontology.org/topic_0218"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:nlpexplorer/web/nlpexplorer.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":0,"citations":[],"pmcid":"PMC7148103","ref_count":0,"refs":[]}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":408,"redirects":[{"status":302,"url":"https://www.afternic.com/forsale/nlpexplorer.org?traffic_id=GoDaddy_DL