{"tool_name":"bioconductor-orthos","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-orthos","home":"https://bioconductor.org/packages/orthos","license":"MIT","summary":"`orthos` decomposes RNA-seq contrasts, for example obtained from a gene knock-out or compound treatment experiment, into unspecific and experiment-specific components. Original and decomposed contrasts can be efficiently queried against a large database of contrasts (derived from ARCHS4, https://maayanlab.cloud/archs4/) to identify similar experiments. `orthos` furthermore provides plotting functions to visualize the results of such a search for similar contrasts.","addition_date":"2026-09-01T07:26:08.254571Z","last_update_date":"2026-09-01T07:26:08.256560Z","tool_type":["Command-line tool","Library"],"version":["1.10.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-orthos","credit":[{"name":"Friedrich Miescher Institute for Biomedical Research"},{"name":"Charlotte Soneson","typeEntity":"Person","typeRole":["Developer"]},{"name":"Michael Stadler","typeEntity":"Person","typeRole":["Developer"]},{"name":"Panagiotis Papasaikas","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/orthos"}],"edit_permission":{"type":"private"},"name":"orthos","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.18129/B9.bioc.orthos"}]},"bioschemas":{"name":"orthos","home":"https://bio.tools/bioconductor-orthos","license":"MIT","version":"1.10.0","summary":"`orthos` decomposes RNA-seq contrasts, for example obtained from a gene knock-out or compound treatment experiment, into unspecific and experiment-specific components. Original and decomposed contrasts can be efficiently queried against a large database of contrasts (derived from ARCHS4, https://maayanlab.cloud/archs4/) to identify similar experiments. `orthos` furthermo