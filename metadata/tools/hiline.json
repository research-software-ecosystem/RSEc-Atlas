adme":false,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}}]},"bioconda":{"name":"hiline","version":"0.2.4","home":"https://github.com/wtsi-hpag/HiLine","license":"MIT","summary":"HiC alignment and classification pipeline.","description":"This is a HiC short-read alignment pipeline. It will perform an alignment, or read in an external alignment, perform optional duplicate-read marking, perform HiC read classification based on an in-slico restriction digest of reference sequences and finally split the output alignments based on HiC read-type. It can also optionally process and output HiC alignment statistics. Under the hood, it uses bwa mem and samtools to perform and process alignments. It also uses a custom C++ Python extension to perform the in-silico digest (using the Hyperscan (https://github.com/intel/hyperscan) regex library) and subsequent HiC classification.  ","license_file":"LICENSE","build":{"number":1,"script":" -m pip install . --no-deps --ignore-installed --no-cache-dir -vvv","skip":true},"requirements":{"build":[null,"clang >=9.0","git","cmake >=3.16.4","pkgconfig >=1.3.1"],"host":["python","numpy >=1.18.1","pip >=20.0.2","setuptools >=46.0.0","boost-cpp","ragel >=6.10","pcre","ninja >=1.10.0"],"run":["python","bwa >=0.7.17","bwa-mem2 >=2.0","minimap2 >=2.17","gawk >=5.1.0","perl >=5.30.3","samtools >=1.10","click >=7.0","pandas >=1.0.1",null,"seaborn >=0.10.0","matplotlib-base >=3.2.0","biopython >=1.76"]},"source_url":"https://github.com/wtsi-hpag/HiLine/archive/0.2.4.tar.gz","test":{"commands":["HiLine --help"],"imports":["HiLine"]}}}}