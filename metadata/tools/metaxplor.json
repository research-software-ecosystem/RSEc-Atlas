{"tool_name":"metaxplor","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"metaxplor","home":"https://github.com/SouthGreenPlatform/metaXplor","license":"AGPL-3.0","summary":"metaXplor is an interactive viral and microbial metagenomic data manager. It aims at storing large volumes of user-defined sample, sequence and assignment information while providing a user-friendly fine-filtering web-interface. This online GUI also offers means to share datasets with collaborators, BLAST external sequences against them, and confirm assignments by running phylogenetic placement. metaXplor is available as a set of Docker containers that make it simple to deploy on various infrastructures.","addition_date":"2020-09-14T08:41:59Z","last_update_date":"2021-04-22T06:15:41Z","tool_type":["Database portal","Web application"],"version":["1.0-beta"],"accessibility":"Open access (with restrictions)","biotools_curie":"biotools:metaxplor","cost":"Free of charge","credit":[{"email":"metaxplor@cirad.fr"},{"email":"guilhem.sempere@cirad.fr","name":"Guilhem Semp\u00e9r\u00e9","orcidid":"https://orcid.org/0000-0001-7429-2091"}],"documentation":[{"note":"HTML documentation is embedded in the web application","type":["User manual"],"url":"https://metaxplor.cirad.fr/metaXplor/docIndex.jsp"}],"edit_permission":{"type":"private"},"maturity":"Mature","name":"metaXplor","operating_system":["Linux"],"owner":"guilhems","topic":[{"term":"Biological databases","uri":"http://edamontology.org/topic_3071"},{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:metaxplor:1.0-beta/db/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":null,"license":null,"public":true,"readme"