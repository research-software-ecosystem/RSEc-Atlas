pyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:r-xcell:1.3/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":true,"source_packages":false,"sourcecode":{"free":null,"interpreted":null,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":3154,"citations":[{"count":3,"year":2017},{"count":6,"year":-1},{"count":29,"year":2018},{"count":92,"year":2019},{"count":156,"year":2020},{"count":352,"year":2026},{"count":385,"year":2021},{"count":493,"year":2024},{"count":512,"year":2023},{"count":528,"year":2025},{"count":598,"year":2022}],"doi":"10.1186/s13059-017-1349-1","pmcid":"PMC5688663","pmid":"29141660","ref_count":33,"refs":[{"count":1,"year":1993},{"count":1,"year":2006},{"count":1,"year":2011},{"count":2,"year":2005},{"count":2,"year":2009},{"count":2,"year":2017},{"count":3,"year":2012},{"count":3,"year":2014},{"count":4,"year":2013},{"count":6,"year":2016},{"count":8,"year":2015}],"title":"xCell: digitally portraying the tissue cellular heterogeneity landscape.","year":2017}]}],"readme":false,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/r-xcell","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":null,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"publications":[],"readme":false,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}}]},"bioconda":{"name":"r-xcell","version":"1.3","home":"https://github.com/dviraran/xCell","license":"GPL-3","summary":"Estimate immune cell proportions from gene expression data","identifiers":["doi:10.1186/s13059-017-1349-1"],"description":"\"Tissues are a complex milieu consisting of numerous cell types. In cancer, understanding the cellular heterogeneity in the tumor microenvironment is an emerging field of research. Numerous methods have been published in recent years for the enumeration of cell subsets from tissue expression profiles. However, the available methods suffer from three major problems: inferring cell subset based on gene sets learned and verified from limited sources; displaying only partial portrayal of the full cellular heterogeneity; and insufficient validation in mixed tissues. The xCell package performs cell type enrichment analysis from gene expression data for 64 immune and stroma cell types. xCell is a gene signatures-based method learned from thousands of pure cell types from various sources. xCell applies a novel technique for reducing associations between closley related cell types. xCell signatures were validated using extensive in-silico simulations and also cytometry immunophenotyping, and were shown to outperform previous methods. xCell allows researchers to reliably portray the cellular heterogeneity landscape of tissue expression profiles.\"\n","license_file":"/lib/R/share/licenses/GPL-3","build":{"number":8,"rpaths":["lib/R/lib/","lib/"],"run_exports":[null],"script":"$R CMD INSTALL --build ."},"requirements":{"build":[null],"host":["r-base","r-roxygen2","r-mass","bioconductor-gsva","bioconductor-gseabase","r-pracma","r-digest","r-quadprog","r-curl"],"run":["r-base >=3.1.0","r-roxygen2","r-mass","bioconductor-gsva","bioconductor-gseabase","r-pracma","r-digest","r-quadprog","r-curl"]},"source_url":["https://github.com/dviraran/xCell/archive/1.3.tar.gz"],"test":{"commands":["$R -e \"library('xCell')\""]},"recipe_maintainers":["grst","dviraran"]}}}