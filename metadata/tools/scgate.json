{"tool_name":"scgate","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"scgate","home":"https://github.com/carmonalab/scGate","license":"Not licensed","summary":"Marker-based purification of cell types from heterogeneous single-cell RNA-seq datasets.","addition_date":"2022-03-28T20:36:58.334863Z","last_update_date":"2024-11-24T20:10:35.533533Z","tool_type":["Library"],"accessibility":"Open access","biotools_curie":"biotools:scgate","cost":"Free of charge","credit":[{"email":"santiago.carmona@unil.ch","name":"Santiago J. Carmona","orcidid":"https://orcid.org/0000-0002-2495-0671","typeEntity":"Person"},{"name":"Ariel J. Berenstein","orcidid":"https://orcid.org/0000-0001-8540-5389"},{"name":"Massimo Andreatta","orcidid":"https://orcid.org/0000-0002-8036-2647"}],"documentation":[{"type":["Training material"],"url":"https://github.com/carmonalab/scGate.demo"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene expression profiling","uri":"http://edamontology.org/operation_0314"}]}],"name":"scGate","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1093/bioinformatics/btac141","metadata":{"abstract":"A common bioinformatics task in single-cell data analysis is to purify a cell type or cell population of interest from heterogeneous datasets. Here, we present scGate, an algorithm that automatizes marker-based purification of specific cell populations, without requiring training data or reference gene expression profiles. scGate purifies a cell population of interest using a set of markers organized in a hierarchical structure, akin to gating strategies employed in flow cytometry. scGate outperforms state-of-the-art single-cell classifiers and it can be applied to multiple modalities of single-cell data (e.g. RNA-seq, ATAC-seq, CITE-seq). scGate is implemented as an R package and integrated with the Seurat framework, providing an intuitive tool to isolate cell populations of interest from heterogeneous single-cell datasets.","authors":[{"name":"Andreatta M."},{"name":"Berenstein A.J."},{"name":"Carmona S.J."}],"citationCount":26,"date":"2022-05-01T00:00:00Z","journal":"Bioinformatics","title":"scGate: Marker-based purification of cell types from heterogeneous single-cell RNA-seq datasets"},"pmcid":"PMC9048671","pmid":"35258562"}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Cytometry","uri":"http://edamontology.org/topic_3934"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"bioschemas":{"name":"scGate","home":"https://bio.tools/scgate","license":"Not licensed","summary":"Marker-based purification of cell types from heterogeneous single-cell RNA-seq datasets.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:scgate/lib/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"documentation":{"training_material":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":54,"citations":[{"count":2,"year":"2022"},{"count":8,"year":"2023"},{"count":12,"year":"2026"},{"count":14,"year":"2025"},{"count":18,"year":"2024"}],"doi":"10.1093/bioinformatics/btac141","pmcid":"PMC9048671","pmid":"35258562","ref_count":0,"refs":[],"title":"scGate: marker-based purification of cell types from heterogeneous single-cell RNA-seq datasets.","year":2022}]}],"readme":false,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operatio