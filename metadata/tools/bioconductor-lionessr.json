{"tool_name":"bioconductor-lionessr","contents":["bioconda","bioconductor","biocontainers","bioschemas","biotools","oeb"],"identifiers":["biotools:bioconductor-lionessr","bioconductor:lionessr","bioconda:bioconductor-lionessr"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-lionessr","identifiers":["doi:10.18129/b9.bioc.lionessr"],"license":"MIT","summary":"Modeling networks for individual samples using lioness","home_url":"https://bioconductor.org/packages/3.11/bioc/html/lionessR.html","keywords":[],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-lionessr","home":"https://bioconductor.org/packages/lionessR","license":"MIT","summary":"LIONESS, or Linear Interpolation to Obtain Network Estimates for Single Samples, can be used to reconstruct single-sample networks (https://arxiv.org/abs/1505.06440). This code implements the LIONESS equation in the lioness function in R to reconstruct single-sample networks. The default network reconstruction method we use is based on Pearson correlation. However, lionessR can run on any network reconstruction algorithms that returns a complete, weighted adjacency matrix. lionessR works for both unipartite and bipartite networks.","addition_date":"2026-08-30T02:45:07.062442Z","last_update_date":"2026-08-30T02:45:07.064327Z","tool_type":["Command-line tool","Library"],"version":["1.26.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-lionessr","credit":[{"name":"Marieke Lydia Kuijjer","typeEntity":"Person","typeRole":["Developer"]},{"name":"Ping-Han Hsieh","typeEntity":"Person","typeRole":["Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/lionessR"}],"edit_permission":{"type":"private"},"name":"lionessR","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.1101/582098"}]},"bioschemas":{"name":"lionessR","home":"https://bio.tools/bioconductor-lionessr","license":"MIT","version":"1.26.0","summa