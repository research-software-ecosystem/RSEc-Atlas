{"tool_name":"intermap3d","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"intermap3d","home":"http://cbs.dtu.dk/services/InterMap3D/","license":"Other","summary":"Prediction of interacting protein residues by identifying co-evolving pairs of aminoacids from an alignment of protein sequences.","addition_date":"2015-01-21T13:29:13Z","last_update_date":"2018-12-29T14:11:14Z","tool_type":["Web application"],"version":["1.3"],"biotools_curie":"biotools:intermap3d","cost":"Free of charge (with restrictions)","credit":[{"name":"CBS","typeEntity":"Institute","typeRole":["Provider"]},{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.bioinformatics.dtu.dk/english/Service/Contact"}],"documentation":[{"type":["General"],"url":"http://www.cbs.dtu.dk/services/InterMap3D/instructions.php"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Sequence","uri":"http://edamontology.org/data_2044"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}],"note":"predicts interacting protein residues","operation":[{"term":"Residue interaction prediction","uri":"http://edamontology.org/operation_0272"}],"output":[{"data":{"term":"Protein features","uri":"http://edamontology.org/data_1277"},"format":[{"term":"GFF","uri":"http://edamontology.org/format_2305"}]},{"data":{"term":"Protein structure report","uri":"http://edamontology.org/data_1537"},"format":[{"term":"Binary format","uri":"http://edamontology.org/format_2333"}]}]}],"maturity":"Emerging","name":"InterMap3D","operating_system":["Linux","Mac","Windows"],"owner":"CBS","publication":[{"doi":"10.1093/bioinformatics/btp335","metadata":{"abstract":"InterMap3D predicts co-evolving protein residues and plots them on the 3D protein structure. Starting with a single protein sequence, InterMap3D automatically finds a set of homologous sequences, generates an alignment and fetches the most similar 3D structure from the Protein Data Bank (PDB). It can also accept a user-generated alignment. Based on the alignment, co-evolving residues are then predicted using three different methods: Row and Column Weighing of Mutual Information, Mutual Information/Entropy and Dependency. Finally, InterMap3D generates high-quality images of the protein with the predicted co-evolving residues highlighted. \u00a9 The Author 2009. Published by Oxford University Press. All rights reserved.","authors":[{"name":"Gouveia-Oliveira R."},{"name":"Molgaard A."},{"name":"Pedersen A.G."},{"name":"Roque F.S."},{"name":"Sackett P.W."},{"name":"Sicheritz-Ponten T."},{"name":"Wernersson R."}],"citationCount":16,"date":"2009-08-01T00:00:00Z","journal":"Bioinformatics","title":"InterMap3D: Predicting and visualizing co-evolving protein residues"},"pmid":"19528088","type":["Primary"]}],"topic":[{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Protein binding sites","uri":"http://edamontology.org/topic_3534"}],"validated":1},"bioschemas":{"name":"InterMap3D","home":"https://bio.tools/intermap3d","license":"Other","version":"1.3","summary":"Prediction of interacting protein residues by identifying co-evolving pairs of aminoacids from an alignment of protein sequences.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:intermap3d:1.3/web/cbs.dtu.dk","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true,"help":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":12,"citations":[{"count":1,"year":"2010"},{"count":1,"year":"2011"},{"count":1,"year":"2022"},{"count":2,"year":"2012"},{"count":2,"year":"2013"},{"count":2,"year":"2015"},{"count":3,"year":"2017"}],"doi":"10.1093/bioinformatics/btp335","pmid":"19528088","ref_count":0,"refs":[],"title":"InterMap3D: predi