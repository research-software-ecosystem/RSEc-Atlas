{"tool_name":"hbat","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"hbat","home":"https://hbat.abhishek-tiwari.com","license":"MIT","summary":"HBAT (Hydrogen Bond Analysis Tool) is a package to automate the analysis of potential hydrogen bonds and similar type of weak interactions in macromolecular structures, available in Protein Data Bank (PDB) file format. HBAT uses a geometric approach to identify molecular interactions by analysing distance and angular criteria.\n\nHBAT 1.1 was released in 2007 as closed source Windows binary and continue to be available via SourceForge. \n\nHBAT 2.0 was introduced in 2025 and a completed rewrite of original implementation with cross-platform support. HBAT 2.0 is open sourced under MIT License.","addition_date":"2017-08-03T18:45:53Z","last_update_date":"2025-11-29T17:30:01.186940Z","tool_type":["Command-line tool","Desktop application"],"version":["1.1, 1.0","2.x"],"accessibility":"Open access","biotools_curie":"biotools:hbat","cost":"Free of charge","credit":[{"name":"Abhishek Tiwari","orcidid":"https://orcid.org/0000-0003-2222-2395","typeEntity":"Person","typeRole":["Primary contact"],"url":"https://www.abhishek-tiwari.com"}],"documentation":[{"type":["API documentation","Citation instructions","Command-line options","General","Installation instructions","Quick start guide"],"url":"https://hbat.abhishek-tiwari.com"}],"edit_permission":{"type":"private"},"function":[{"cmd":"hbat input.pdb","input":[{"data":{"term":"Protein structure","uri":"http://edamontology.org/data_1460"},"format":[{"term":"PDB","uri":"http://edamontology.org/format_1476"}]}],"operation":[{"term":"Protein structure analysis","uri":"http://edamontology.org/operation_2406"}],"output":[{"data":{"term":"Protein hydrogen bonds","uri":"http://edamontology.org/data_1549"}}]}],"maturity":"Mature","name":"HBAT","operating_system":["Linux","Mac","Windows"],"owner":"abhishektiwari","publication":[{"doi":"10.3233/ISI-2007-00337","note"