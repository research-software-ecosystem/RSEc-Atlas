{"tool_name":"gradebins","contents":["biotools"],"identifiers":["biotools:gradebins"],"fetched_metadata":{"biotools":{"id":"gradebins","home":"https://bbmap.org/tools/gradebins","summary":"GradeBins is a framework that evaluates the quality of metagenome bins by calculating completeness and contamination metrics for draft genomes. It can process labeled contigs or integrate external quality estimates to provide standardized, high-quality reporting for genome-resolved metagenomics.","addition_date":"2026-11-04T17:39:25.118862Z","last_update_date":"2026-11-04T17:39:25.121114Z","biotools_curie":"biotools:gradebins","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Expression analysis","uri":"http://edamontology.org/operation_2495"},{"term":"Regression analysis","uri":"http://edamontology.org/operation_3659"},{"term":"Sequence assembly","uri":"http://edamontology.org/operation_0310"},{"term":"Validation","uri":"http://edamontology.org/operation_2428"}]}],"name":"GradeBins","owner":"pub2tools2024","publication":[{"doi":"10.64898/2026.03.11.709163"}],"topic":[{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Taxonomy","uri":"http://edamontology.org/topic_0637"}]}}}