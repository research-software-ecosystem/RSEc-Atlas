{"tool_name":"bioconductor-xnastring","contents":["bioconda","bioconductor","oeb"],"identifiers":["bioconductor:xnastring","bioconda:bioconductor-xnastring"],"fetched_metadata":{"bioconductor":{"name":"XNAString","version":"1.18.0","license":"GPL-2","summary":"Efficient Manipulation of Modified Oligonucleotide Sequences","description":"The XNAString package allows for description of base sequences and associated chemical modifications in a single object. XNAString is able to capture single stranded, as well as double stranded molecules. Chemical modifications are represented as independent strings associated with different features of the molecules (base sequence, sugar sequence, backbone sequence, modifications) and can be read or written to a HELM notation. It also enables secondary structure prediction using RNAfold from ViennaRNA. XNAString is designed to be efficient representation of nucleic-acid based therapeutics, therefore it stores information about target sequences and provides interface for matching and alignment functions from Biostrings and pwalign packages.","author":"Anna G\u00f3rska [aut], Marianna Plucinska [aut, cre], Lykke Pedersen [aut], Lukasz Kielpinski [aut], Disa Tehler [aut], Peter H. Hagedorn [aut]","maintainer":"Marianna Plucinska <marianna.plucinska@roche.com>","bioc_views":["Alignment","Genetics","SequenceMatching","Sequencing","Software"]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-xnastring:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-xnastrin