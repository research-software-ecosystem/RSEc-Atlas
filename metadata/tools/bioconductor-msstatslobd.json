{"tool_name":"bioconductor-msstatslobd","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-msstatslobd","home":"https://bioconductor.org/packages/MSstatsLOBD","license":"Artistic-2.0","summary":"The MSstatsLOBD package allows calculation and visualization of limit of blac (LOB) and limit of detection (LOD). We define the LOB as the highest apparent concentration of a peptide expected when replicates of a blank sample containing no peptides are measured. The LOD is defined as the measured concentration value for which the probability of falsely claiming the absence of a peptide in the sample is 0.05, given a probability 0.05 of falsely claiming its presence. These functionalities were previously a part of the MSstats package. The methodology is described in Galitzine (2018) <doi:10.1074/mcp.RA117.000322>.","tool_type":["Command-line tool","Library"],"version":["1.20.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-msstatslobd","credit":[{"name":"Cyril Galitzine","typeEntity":"Person","typeRole":["Developer"]},{"name":"Devon Kohler","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Mateusz Staniak","typeEntity":"Person","typeRole":["Developer"]},{"name":"Meena Choi","typeEntity":"Person","typeRole":["Developer"]},{"name":"Olga Vitek","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/MSstatsLOBD"}],"name":"MSstatsLOBD","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-msstatslobd:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"summary":{"description":true},"website"