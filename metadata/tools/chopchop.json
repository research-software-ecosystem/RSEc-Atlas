{"tool_name":"chopchop","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"chopchop","home":"http://chopchop.cbu.uib.no/","license":"Apache-2.0","summary":"CHOPCHOP is a versatile tool for selecting target sites for CRISPR (Cas9, Cas9 nickase, Cas13, Cpf1/CasX) or TALEN-directed mutagenesis. The latest release of CHOPCHOP (version 3) includes many new features and visualization options, supporting over 200 genomes with whole-gene targeting and versatile search modes. The tool now enables precise RNA targeting with Cas13, supporting alternative transcript isoforms and predicting RNA accessibility using ViennaRNA's RNAfold. The update also introduces new DNA targeting modes, including CRISPR activation/repression, targeted enrichment of loci for long-read sequencing, and prediction of Cas9 repair outcomes. For larger queries or handling unsupported genomes, a command-line version is available with additional functionalities. CHOPCHOP v3 is user-friendly and well-equipped to support diverse targeting applications, facilitating effective experimental design.","addition_date":"2016-03-11T10:35:00Z","last_update_date":"2023-08-03T13:19:40.201053Z","tool_type":["Command-line tool","Web application"],"version":["1","2","3"],"collections":["ELIXIR-NO","ELIXIR-Norway","UiB tools"],"accessibility":"Open access","biotools_curie":"biotools:chopchop","cost":"Free of charge","credit":[{"email":"erin.calhoun@uit.no","name":"Erin Calhoun","note":"Curation of bio.tools profile - contact me with updates/corrections.","orcidid":"https://orcid.org/0009-0003-3752-7156","typeEntity":"Person","typeRole":["Documentor"]},{"email":"support@elixir.no","name":"The Norwegian Bioinformatics Platform (ELIXIR-Norway) Helpdesk","note":"Helpdesk and support for ELIXIR Norway services","typeEntity":"Consortium","typeRole":["Support"],"url":"https://elixir.no/helpdesk"},{"email":"kornel.labun@uib.no","name":"Kornel Labun","orcidid":"https://orcid.org/0000-0002-1262-2611","typeEntity":"Person","typeRole":["Developer","Maintainer","Primary contact","Support"]},{"email":"tessa.chopchop@gmail.com","name":"Tessa Montague","orcidid":"https://orcid.org/0000-0002-5918-6327","typeEntity":"Person","typeRole":["Contributor","Primary contact","Support"]},{"fundrefid":"10.13039/501100006475","gridid":"grid.478482.5","name":"Bergen Research Foundation","note":"Now part of the Trond Mohn Foundation","rorid":"04efaep75","typeEntity":"Funding agency","url":"https://mohnfoundation.no/en/about/"},{"fundrefid":"10.13039/501100005036","gridid":"grid.7914.b","name":"University of Bergen","rorid":"03zga2b32","typeEntity":"Institute","typeRole":["Provider"],"url":"https://www.uib.no/en"},{"fundrefid":"10.13039/501100005036","gridid":"grid.7914.b","name":"University of Bergen","rorid":"03zga2b32","typeEntity":"Funding agency","url":"https://www.uib.no/en"},{"fundrefid":"10.13039/501100005416","gridid":"grid.13985.36","name":"The Research Council of Norway","rorid":"00epmv149","typeEntity":"Funding agency","url":"http://www.forskningsradet.no/en/Home_page/1177315753906"},{"name":"James Graham","note":"Recommendations on the long-read enrichment mode","orcidid":"https://orcid.org/0000-0002-8639-7592","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Valen Group (Computational Biology Unit)","typeEntity":"Division","typeRole":["Developer","Maintainer","Support"],"url":"https://www.cbu.uib.no/valen/"}],"documentation":[{"note":"Bitbucket REST API documentation","type":["API documentation"],"url":"https://developer.atlassian.com/cloud/bitbucket/rest/api-group-downloads/#api-group-downloads"},{"type":["Citation instructions","FAQ"],"url":"http://chopchop.cbu.uib.no/faq"},{"type":["Command-line options"],"url":"https://bitbucket.org/valenlab/chopchop/src/master/README.md"},{"type":["User manual"],"url":"http://chopchop.cbu.uib.no/instructions"}],"edit_permission":{"authors":["eca008"],"type":"group"},"function":[{"input":[{"data":{"term":"Gene ID","uri":"http://edamontology.org/data_2295"}},{"data":{"term":"Species name","uri":"http://edamontology.org/data_1045"}},{"data":{"term":"Feature table","uri":"http://edamontology.org/data_1270"},"format":[{"term":"GFF3","uri":"http://edamontology.org/format_1975"}]},{"data":{"term":"Sequence assembly","uri":"http://edamontology.org/data_0925"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}],"note":"For adding a new genome to CHOPCHOP by email","operation":[{"term":"Deposition","uri":"http://edamontology.org/operation_3431"}]},{"input":[{"data":{"term":"Gene ID","uri":"http://edamontology.org/data_2295"}},{"data":{"term":"Tool name","uri":"http://edamontology.org/data_1190"}},{"data":{"term":"DNA sequence (raw)","uri":"http://edamontology.org/data_3497"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"},{"term":"Gene annotation format","uri":"http://edamontology.org/format_2031"},{"term":"Sequence range format","uri":"http://edamontology.org/format_2078"}]}],"note":"Input target can be specified using gene IDs that are retrieved from the ENSEMBL (ensGene) and RefSeq (refGene) tables from the UCSC genome browser or FASTA file with target sequence of interest. Also we allow input to be specific coordinates e.g. chr1:3000-4000.","operation":[{"term":"Prediction and recognition","uri":"http://edamontology.org/operation_2423"},{"term":"Primer and probe design","uri":"http://edamontology.org/operation_2419"}],"output":[{"data":{"term":"Sequence set (nucleic acid)","uri":"http://edamontology.org/data_1234"}}]}],"maturity":"Mature","name":"CHOPCHOP","operating_system":["Linux","Mac","Windows"],"owner":"edv","publication":[{"doi":"10.1093/nar/gku410","metadata":{"abstract":"Major advances in genome editing have recently been made possible with the development of the TALEN and CRISPR/Cas9 methods. The speed and ease of implementing these technologies has led to an explosion of mutant and transgenic organisms. A rate-limiting step in efficiently applying TALEN and CRISPR/Cas9 methods is the selection and design of targeting constructs. We have developed an online tool, CHOPCHOP (https://chopchop.rc.fas.harvard.edu), to expedite the design process. CHOPCHOP accepts a wide range of inputs (gene identifiers, genomic regions or pasted sequences) and provides an array of advanced options for target selection. It uses efficient sequence alignment algorithms to minimize search times, and rigorously predicts off-target binding of single-guide RNAs (sgRNAs) and TALENs. Each query produces an interactive visualization of the gene with candidate target sites displayed at their genomic positions and color-coded according to quality scores. In addition, for each possible target site, restriction sites and primer candidates are visualized, facilitating a streamlined pipeline of mutant generation and validation. The ease-of-use and speed of CHOPCHOP make it a valuable tool for genome engineering. \u00a9 2014 The Author(s).","authors":[{"name":"Church G.M."},{"name":"Cruz J.M."},{"name":"Gagnon J.A."},{"name":"Montague T.G."},{"name":"Valen E."}],"citationCount":736,"date":"2014-07-01T00:00:00Z","journal":"Nucleic Acids Research","title":"CHOPCHOP: A CRISPR/Cas9 and TALEN web tool for genome editing"},"pmcid":"PMC4086086","pmid":"24861617","type":["Primary"],"version":"1"},{"doi":"10.1093/nar/gkw398","metadata":{"abstract":"In just 3 years CRISPR genome editing has transformed biology, and its popularity and potency continue to grow. New CRISPR effectors and rules for locating optimum targets continue to be reported, highlighting the need for computational CRISPR targeting tools to compile these rules and facilitate target selection and design. CHOPCHOP is one of the most widely used web tools for CRISPR- and TALEN-based genome editing. Its overarching principle is to provide an intuitive and powerful tool that can serve both novice and experienced users. In this major update we introduce tools for the next generation of CRISPR advances, including Cpf1 and Cas9 nickases. We support a number of new features that improve the targeting power, usability and efficiency of CHOPCHOP. To increase targeting range and specificity we provide support for custom length sgRNAs, and we evaluate the sequence composition of the whole sgRNA and its surrounding region using models compiled from multiple large-scale studies. These and other new features, coupled with an updated interface for increased usability and support for a continually growing list of organisms, maintain CHOPCHOP as one of the leading tools for CRISPR genome editing. CHOPCHOP v2 can be found at http://chopchop.cbu.uib.no.","authors":[{"name":"Gagnon J.A."},{"name":"Labun K."},{"name":"Montague T.G."},{"name":"Thyme S.B."},{"name":"Valen E."}],"citationCount":552,"date":"2016-07-08T00:00:00Z","journal":"Nucleic Acids Research","title":"CHOPCHOP v2: a web tool for the next generation of CRISPR genome engineering"},"pmcid":"PMC4987937","pmid":"27185894","type":["Primary"],"version":"2"},{"doi":"10.1093/nar/gkz365","metadata":{"abstract":"The CRISPR-Cas system is a powerful genome editing tool that functions in a diverse array of organisms and cell types. The technology was initially developed to induce targeted mutations in DNA, but CRISPR-Cas has now been adapted to target nucleic acids for a range of purposes. CHOPCHOP is a web tool for identifying CRISPR-Cas single guide RNA (sgRNA) targets. In this major update of CHOPCHOP, we expand our toolbox beyond knockouts. We introduce functionality for targeting RNA with Cas13, which includes support for alternative transcript isoforms and RNA accessibility predictions. We incorporate new DNA targeting modes, including CRISPR activation/repression, targeted enrichment of loci for long-read sequencing, and prediction of Cas9 repair outcomes. Finally, we expand our results page visualization to reveal alternative isoforms and downstream ATG sites, which will aid users in avoiding the expression of truncated proteins. The CHOPCHOP web tool now supports over 200 genomes and we have released a command-line script for running larger jobs and handling unsupported genomes. CHOPCHOP v3 can be found at https://chopchop.cbu.uib.no","authors":[{"name":"Krause M."},{"name":"Labun K."},{"name":"Montague T.G."},{"name":"Tjeldnes H."},{"name":"Torres Cleuren Y.N."},{"name":"Valen E."}],"citationCount":600,"date":"2019-07-01T00:00:00Z","journal":"Nucleic Acids Research","title":"CHOPCHOP v3: Expanding the CRISPR web toolbox beyond genome editing"},"pmcid":"PMC6602426","pmid":"31106371","type":["Primary"],"version":"3"},{"doi":"10.1002/cpz1.46","metadata":{"abstract":"The design of optimal guide RNA (gRNA) sequences for CRISPR systems is challenged by the need to achieve highly efficient editing at the desired location (on-target editing) with minimal editing at unintended locations (off-target editing). Although laboratory validation should ideally be used to detect off-target activity, computational predictions are almost always preferred in practice due to their speed and low cost. Several studies have therefore explored gRNA-DNA interactions in order to understand how CRISPR complexes select their genomic targets. CHOPCHOP (https://chopchop.cbu.uib.no/) leverages these developments to build a user-friendly web interface that helps users design optimal gRNAs. CHOPCHOP supports a wide range of CRISPR applications, including gene knock-out, sequence knock-in, and RNA knock-down. Furthermore, CHOPCHOP offers visualization that enables an informed choice of gRNAs and supports experimental validation. In these protocols, we describe the best practices for gRNA design using CHOPCHOP. \u00a9 2021 The Authors. Current Protocols published by Wiley Periodicals LLC. Basic Protocol 1: Design of gRNAs for gene knock-out. Alternate Protocol 1: Design of gRNAs for dCas9 fusion/effector targeting. Support Protocol: Design of gRNAs for targeting transgenic or plasmid sequences. Basic Protocol 2: Design of gRNAs for RNA targeting. Basic Protocol 3: Design of gRNAs for sequence knock-in. Alternate Protocol 2: Design of gRNAs for knock-in using non-homologous end joining. Basic Protocol 4: Design of gRNAs for knock-in using Cas9 nickases.","authors":[{"name":"Krause M."},{"name":"Labun K."},{"name":"Torres Cleuren Y."},{"name":"Valen E."}],"citationCount":12,"date":"2021-04-01T00:00:00Z","journal":"Current Protocols","title":"CRISPR Genome Editing Made Easy Through the CHOPCHOP Website"},"pmid":"33905612","type":["Usage"],"version":"3"}],"topic":[{"term":"Data visualisation","uri":"http://edamontology.org/topic_0092"},{"term":"Experimental design and studies","uri":"http://edamontology.org/topic_3678"},{"term":"Genetic engineering","uri":"http://edamontology.org/topic_3912"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Nucleic acid sites, features and motifs","uri":"http://edamontology.org/topic_3511"}],"validated":1},"bioschemas":{"name":"CHOPCHOP","home":"https://bio.tools/chopchop","license":"Apache-2.0","version":["1","2","3"],"summary":"CHOPCHOP is a versatile tool for selecting target sites for CRISPR (Cas9, Cas9 nickase, Cas13, Cpf1/CasX) or TALEN-directed mutagenesis. The latest release of CHOPCHOP (version 3) includes many new features and visualization options, supporting over 200 genomes with whole-gene targeting and versatile search modes. The tool now enables precise RNA targeting with Cas13, supporting alternative transcript isoforms and predicting RNA accessibility using ViennaRNA's RNAfold. The update also introduces new DNA targeting modes, including CRISPR activation/repression, targeted enrichment of loci for long-read sequencing, and prediction of Cas9 repair outcomes. For larger queries or handling unsupported genomes, a command-line version is available with additional functionalities. CHOPCHOP v3 is user-friendly and well-equipped to support diverse targeting applications, facilitating effective experimental design.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:chopchop:1-3/cmd/chopchop.cbu.uib.no","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"faq":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":560,"citations":[{"count":5,"year":"2016"},{"count":21,"year":"2017"},{"count":29,"year":"2026"},{"count":44,"year":"2025"},{"count":53,"year":"2024"},{"count":55,"year":"2022"},{"count":56,"year":"2018"},{"count":60,"year":"2023"},{"count":65,"year":"2021"},{"count":80,"year":"2020"},{"count":92,"year":"2019"}],"doi":"10.1093/nar/gkw398","pmcid":"PMC4987937","pmid":"27185894","ref_count":32,"refs":[{"count":1,"year":"1985"},{"count":1,"year":"2002"},{"count":1,"year":"2009"},{"count":2,"year":"2012"},{"count":3,"year":"2016"},{"count":5,"year":"2014"},{"count":8,"year":"2015"},{"count":11,"year":"2013"}],"title":"CHOPCHOP v2: a web tool for the next generation of CRISPR genome engineering.","year":2016}]},{"entries":[{"cit_count":690,"citations":[{"count":1,"year":"-1"},{"count":11,"year":"2014"},{"count":29,"year":"2015"},{"count":30,"year":"2026"},{"count":34,"year":"2017"},{"count":46,"year":"2016"},{"count":55,"year":"2025"},{"count":58,"year":"2023"},{"count":59,"year":"2022"},{"count":67,"year":"2021"},{"count":68,"year":"2024"},{"count":72,"year":"2018"},{"count":72,"year":"2020"},{"count":88,"year":"2019"}],"doi":"10.1093/nar/gku410","pmcid":"PMC4086086","pmid":"24861617","ref_count":40,"refs":[{"count":1,"year":"2004"},{"count":1,"year":"2007"},{"count":1,"year":"2010"},{"count":1,"year":"2011"},{"count":4,"year":"2009"},{"count":5,"year":"2012"},{"count":5,"year":"2014"},{"count":22,"year":"2013"}],"title":"CHOPCHOP: a CRISPR/Cas9 and TALEN web tool for genome editing."