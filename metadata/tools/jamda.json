{"tool_name":"jamda","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"jamda","home":"https://www.zbh.uni-hamburg.de/en/forschung/amd/software/jamda.html","license":"Other","summary":"JAMDA enables the preparation of individual protein structures and the docking of small molecules in preprocessed binding sites of choice. JAMDA simplifies the process of protein-ligand docking by automatic preprocessing protocols for the protein and binding sites of interest. The JAMDAscore scoring function retrieved 75% of the native poses in the three highest-ranked solutions for high-quality protein-ligand complexes with default settings. Individual configurations for protein preparation are available, e.g., considering protein ensembles, relevant binding site water molecules, or cofactors. A user-defined number of input conformations for the ligands of interest can be generated fully automated using Conformator. Alternatively, users can also provide externally prepared ligand conformers.","addition_date":"2025-12-17T13:44:30.421942Z","last_update_date":"2026-06-16T12:33:56.146239Z","tool_type":["Command-line tool","Web service"],"collections":["de.NBI","de.NBI-biodata"],"biotools_curie":"biotools:jamda","cost":"Free of charge (with restrictions)","credit":[{"email":"pplus.zbh@uni-hamburg.de","name":"ProteinsPlus Support","note":"Primary Contact for Web Service Issues","typeRole":["Primary contact"]},{"email":"software.zbh@uni-hamburg.de","name":"NAOMI ChemBio Suite Support","note":"Primary Contact for Standalone Tool Issues","typeRole":["Primary contact"]},{"name":"University of Hamburg, ZBH - Center for Bioinformatics","rorid":"00g30e956","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["General"],"url":"https://proteins.plus/help/index"}],"edit_permission":{"authors":["MelanieZBH","ehrt"],"type":"group"},"function":[{"input":[{"data":{"term":"UniProt accession","uri":"http://edamontology.org/data_3021"}},{"data":{"term":