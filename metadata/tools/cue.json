{"tool_name":"cue","contents":["biotools","oeb"],"identifiers":["biotools:cue"],"fetched_metadata":{"biotools":{"id":"cue","home":"https://github.com/GangLiTarheel/CUE","summary":"CpG impUtation Ensemble (CUE) is a method, which leverages multiple classical statistical and modern machine learning methods, to impute from the Illumina HumanMethylation450 (HM450) BeadChip to the Illumina HumanMethylationEPIC (HM850) BeadChip. DNA methylation at CpG dinucleotides is one of the most extensively studied epigenetic marks. With technological advancements, geneticists can profile DNA methylation with multiple reliable approaches. However, different profiling platforms can differ substantially in the CpGs they assess, consequently hindering integrated analysis across platforms.","addition_date":"2021-01-18T09:33:32Z","last_update_date":"2026-11-12T14:26:43.308809Z","tool_type":["Library"],"biotools_curie":"biotools:cue","credit":[{"email":"yunli@med.unc.edu","name":"Yun Li","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"DNA profiling","uri":"http://edamontology.org/operation_3894"},{"term":"Imputation","uri":"http://edamontology.org/operation_3557"},{"term":"PTM site prediction","uri":"http://edamontology.org/operation_0417"},{"term":"Regression analysis","uri":"http://edamontology.org/operation_3659"}]}],"name":"CUE","owner":"Kigaard","publication":[{"doi":"10.1080/15592294.2020.1827716","type":["Primary"]},{"doi":"10.1101/2020.05.30.107094","type":["Preprint"]}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Epigenetics","uri":"http://edamontology.org/topic_3295"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Methylated DNA immunoprecipitation","uri":"http://edamontology.org/topic_3674"},{"term":"Probes and primers","uri":"http://edamontology.org/topic_0632"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:cue/lib/github.com","@licen