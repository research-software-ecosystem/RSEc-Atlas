{"tool_name":"gefast","contents":["biocontainers","oeb"],"fetched_metadata":{"biocontainers":{"name":"gefast","identifiers":["doi:10.1186/s12859-018-2349-1"],"license":"AGPL-3.0","summary":"Clustering tool primarily designed for processing nucleotide sequences obtained from high-throughput sequencing. GeFaST (Generalised Fastidious Swarming Tool) picks up the two-phased, iterative clustering strategy of Swarm and generalises resp. extends both the clustering and the refinement phase. GeFaST considers the iterative strategy as an abstract scheme, which can be coupled with different notions of distance. The refinement phase has been generalised by broadening the applicability of the original fastidious approach and introducing further refinement methods.","home_url":"https://github.com/romueller/gefast","keywords":["Cluster Analysis","Databases as Topic","High-Throughput Nucleotide Sequencing","RNA, Ribosomal, 16S","Time Factors","Clustering"],"manually_check":true,"total_pulls":933},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:gefast:1.0.0/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":true,"resolve_time":"PT17089558S"}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:gefast:2.0.1/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"binaries":{"