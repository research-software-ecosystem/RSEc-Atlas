er provides support for the initial steps of dealing with protein structures, namely structure search, quality assessment, and preprocessing. JAMDA enables users to perform an on-the-fly molecular docking of up to five molecules. The poses can then be visualized in 2D (PoseView, PoseEdit). Furthermore, advanced options, such as protein pocket detection (DoGSite), prediction of water molecule positions (WarPP), protein structure ensemble generation (SIENA), prediction of metal coordination (METALizer), the analysis of solvent channels in protein crystals (LifeSoaks), or the categorization of protein-protein-interfaces (HyPPI) are supported.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:proteinsplus/rest/proteins.plus","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":20,"citations":[{"count":1,"year":"2025"},{"count":19,"year":"2026"}],"doi":"10.1093/nar/gkaf377","pmcid":"PMC12230695","pmid":"40326518","ref_count":38,"refs":[{"count":1,"year":"1968"},{"count":1,"year":"1992"},{"count":1,"year":"1997"},{"count":1,"year":"2000"},{"count":1,"year":"2012"},{"count":1,"year":"2019"},{"count":1,"year":"2021"},{"count":2,"year":"2011"},{"count":2,"year":"2024"},{"count":3,"year":"2014"},{"count":3,"year":"2016"},{"count":3,"year":"2020"},{"count":4,"year":"2017"},{"count":4,"year":"2018"},{"count":4,"year":"2022"},{"count":6,"year":"2023"}],"title":"ProteinsPlus: a publicly available resource for protein structure mining.","year":2025}]},{"entries":[{"cit_count":77,"citations":[{"count":1,"year":"-1"},{"count":2,"year":"2022"},{"count":9,"year":"2023"},{"count":18,"year":"2026"},{"count":19,"year":"2024"},{"count":28,"year":"2025"}],"doi":"10.1093/nar/gkac305","pmcid":"PMC9252762","pmid":"3