{"tool_name":"spikelab","contents":["biotools","oeb"],"identifiers":["biotools:spikelab"],"fetched_metadata":{"biotools":{"id":"spikelab","home":"https://github.com/braingeneers/SpikeLab","summary":"SpikeLab is a text-to-analysis framework designed for neural spike data that uses an agentic system to guide large language models (LLMs) for robust, reproducible, and expert-vetted electrophysiology analysis. It allows complex analyses (e.g., dose-response studies, network structure) to be executed via natural language prompts without requiring the user to write code.","addition_date":"2026-11-04T17:39:26.554473Z","last_update_date":"2026-11-04T17:39:26.557394Z","biotools_curie":"biotools:spikelab","credit":[{"email":"tsharf@ucsc.edu","name":"Tal Sharf","orcidid":"https://orcid.org/0000-0002-7899-2818","typeEntity":"Person"},{"email":"tvanderm@ucsc.edu","name":"Tjitse van der Molen","orcidid":"https://orcid.org/0000-0001-6147-542X","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Principal component analysis","uri":"http://edamontology.org/operation_3960"},{"term":"Principal component visualisation","uri":"http://edamontology.org/operation_2939"}]}],"name":"SpikeLab: Agentic tools for spike data analysis","owner":"pub2tools2024","publication":[{"doi":"10.64898/2026.04.25.720833","pmcid":"PMC13142478","pmid":"42094562"}],"topic":[{"term":"Mathematics","uri":"http://edamontology.org/topic_3315"},{"term":"Neurobiology","uri":"http://edamontology.org/topic_3304"},{"term":"Pharmacology","uri":"http://edamontology.org/topic_0202"},{"term":"Physiology","uri":"http://edamontology.org/topic_3300"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:spikelab/undefined/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","project":{"publications":[{"entries":[{"cit_count":0,"cita