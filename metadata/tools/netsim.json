{"tool_name":"netsim","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"netsim","home":"http://www.medcomp.medicina.unipd.it/bioing/netsim/","license":"GPL-2.0","summary":"Gene-network simulator. Simulators are helpful to test and compare the accuracy of different reverse-engineering approaches in a variety of experimental conditions.","addition_date":"2015-01-22T11:40:39Z","last_update_date":"2024-11-25T15:54:40.615289Z","tool_type":["Command-line tool","Web application"],"version":["2.0"],"biotools_curie":"biotools:netsim","credit":[{"email":"barbara.dicamillo@unipd.it","name":"Barbara Di Camillo","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.dei.unipd.it/~dicamill/"},{"name":"ELIXIR-ITA-PADOVA","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["General"],"url":"http://www.medcomp.medicina.unipd.it/bioing/netsim/"}],"edit_permission":{"type":"private"},"function":[{"note":"Netsim is a gene-network simulator that resembles some of the main features of transcriptional regulatory networks related to topology, interaction among regulators of transcription, and expression dynamics. The user can give as input the desired in/out degree distribution and clustering coefficient. Netsim first generates the network topology and second the rules codifying the regulatory interactions (these latter can also be given as input), represented using fuzzy logic. Third, netsim generates the system dynamics using differential equations to generate continuous data, comparable to real data for variety and dynamic complexity. The user can give as input the parameters describing kinetics, saturation in the response to regulation, and transcription activation thresholds.","operation":[{"term":"Network simulation","uri":"http://edamontology.org/operation_3562"}]}],"name":"Netsim","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-ITA-PADOVA","publication":[{"doi":"10.1111/j.1749-6632.2008.03756.x","p