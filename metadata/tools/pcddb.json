{"tool_name":"pcddb","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"pcddb","home":"http://pcddb.cryst.bbk.ac.uk","summary":"The Protein Circular Dichroism Data Bank is a public repository for circular dichroism and synchrotron radiation CD spectral data and their associated experimental metadata. All entries undergo validation and curation procedures to ensure completeness, consistency and quality of the data included. A web-based interface enables users to browse and query sample types, sample conditions, experimental parameters and provides spectra in both graphical display format and as downloadable text files.","addition_date":"2017-03-30T16:57:09Z","last_update_date":"2018-12-11T17:15:47Z","tool_type":["Database portal"],"biotools_curie":"biotools:pcddb","credit":[{"email":"pcddb@mail.cryst.bbk.ac.uk","name":"PCDDB Support","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://pcddb.cryst.bbk.ac.uk/helptexts.php"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Deposition","uri":"http://edamontology.org/operation_3431"},{"term":"Protein secondary structure assignment","uri":"http://edamontology.org/operation_0319"},{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"},{"term":"Validation","uri":"http://edamontology.org/operation_2428"}]}],"name":"PCDDB","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"metadata":{"abstract":"The Protein Circular Dichroism Data Bank (PCDDB) is a public repository that archives and freely distributes circular dichroism (CD) and synchrotron radiation CD (SRCD) spectral data and their associated experimental metadata. All entries undergo validation and curation procedures to ensure completeness,consistency and quality of the data included. A web-based interface enables users to browse and query sample types,sample conditions,experimental parameters and provides spectra in both graphical display format and as downloadable text files. The entries are linked,when appropriate,to primary sequence (UniProt) and structural (PDB) databases,as well as to secondary databases such as the Enzyme Commission functional classification database and the CATH fold classification database,as well as to literature citations. The PCDDB is available at: http://pcddb.cryst.bbk.ac.uk. \u00a9 The Author(s) 2010.","authors":[{"name":"Janes R.W."},{"name":"Klose D.P."},{"name":"Miles A.J."},{"name":"Wallace B.A."},{"name":"Whitmore L."},{"name":"Woollett B."}],"citationCount":60,"date":"2011-01-01T00:00:00Z","journal":"Nucleic Acids Research","title":"PCDDB: The protein circular dichroism data bank,a repository for circular dichroism spectral and metadata"},"pmid":"21071417"}],"topic":[{"term":"Enzymes","uri":"http://edamontology.org/topic_0821"},{"term":"Protein folds and structural domains","uri":"http://edamontology.org/topic_0736"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"},{"term":"Structural biology","uri":"http://edamontology.org/topic_1317"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pcddb/db/pcddb.cryst.bbk.ac.uk","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":37,"citations":[{"count":1,"year":"2011"},{"count":1,"year":"2019"},{"count":1,"year":"2023"},{"count":1,"year":"2024"},{"count":2,"year":"2012"},{"count":2,"year":"2020"},{"count":3,"year":"2014"},{"count":3,"year":"2017"},{"count":4,"year":"2013"},{"count":4,"year":"2021"},{"count":5,"year":"2015"},{"count":5,"year":"2016"},{"count":5,"year":"2025"}],"doi":"10.1093/nar/gkq1026","pmcid":"PMC3013654","pmid":"21071417","ref_count":23,"refs":[{"count":1,"year":"1983"},{"count":1,"year":"1996"},{"count":1,"year":"1999"},{"count":1,"year":"2000"},{"count":1,"year"