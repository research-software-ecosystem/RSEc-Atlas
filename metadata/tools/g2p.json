{"tool_name":"g2p","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"G2P","home":"https://github.com/XiaoleiLiuBio/G2P","license":"Unlicense","summary":"Genome-Wide-Association-Study simulation tool for genotype simulation, phenotype simulation and power evaluation.","addition_date":"2019-07-04T14:55:06Z","last_update_date":"2024-11-24T21:07:10.688117Z","tool_type":["Command-line tool","Desktop application"],"accessibility":"Open access","biotools_curie":"biotools:G2P","cost":"Free of charge","credit":[{"email":"xiaoleiliu@mail.hzau.edu.cn","name":"Xiaolei Liu","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/XiaoleiLiuBio/G2P/blob/master/README.md"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genetic mapping","uri":"http://edamontology.org/operation_0282"},{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Imputation","uri":"http://edamontology.org/operation_3557"}]}],"maturity":"Mature","name":"G2P","operating_system":["Linux","Mac","Windows"],"owner":"Ruta","publication":[{"doi":"10.1093/bioinformatics/btz126","metadata":{"abstract":"Motivation: Plenty of Genome-Wide-Association-Study (GWAS) methods have been developed for mapping genetic markers that associated with human diseases and agricultural economic traits. Computer simulation is a nice tool to test the performances of various GWAS methods under certain scenarios. Existing tools are either inefficient in terms of computation and memory efficiency or inconvenient to use to simulate big, realistic genotype data and phenotype data to evaluate available GWAS methods. Results: Here, we present a GWAS simulation tool named G2P that can be used to simulate genotype data, phenotype data and perform power evaluation of GWAS methods. G2P is a user-friendly tool with all functions is provided in both graphical user interface and pipeline manners and it is available for Windows, Mac and Linux environments. Furthermore, G2P achieves maximum efficiency in terms of both memory usage and simulation speed; with G2P, the simulation of genotype data that includes 1 000 000 samples and 2 000 000 markers can be accomplished in 5 h. Availability and implementation: The G2P software, user manual, and example datasets are freely available at GitHub: https://github.com/XiaoleiLiuBio/G2P. Supplementary information: Supplementary data are available at Bioinformatics online.","authors":[{"name":"Liu X."},{"name":"Tang Y."}],"citationCount":11,"date":"2019-10-01T00:00:00Z","journal":"Bioinformatics","title":"G2P: A Genome-Wide-Association-Study simulation tool for genotype simulation, phenotype simulation and power evaluation"},"pmid":"30848784","type":["Primary"]}],"topic":[{"term":"GWAS study","uri":"http://edamontology.org/topic_3517"},{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"}],"validated":1},"bioschemas":{"name":"G2P","home":"https://bio.tools/G2P","license":"Unlicense","summary":"Genome-Wide-Association-Study simulation tool for genotype simulation, phenotype simulation and power evaluation.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:g2p/app/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":false,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":9,"citations":[{"count":1,"year":"2019"},{"count":1,"year":"2020"},{"count":1,"year":"2021"},{"count":1,"year":"2022"