{"tool_name":"rmsicleanup","contents":["biotools","oeb"],"identifiers":["biotools:rmsicleanup"],"fetched_metadata":{"biotools":{"id":"rMSIcleanup","home":"https://github.com/gbaquer/rMSIcleanup","license":"GPL-3.0","summary":"An open-source tool for matrix-related peak annotation in mass spectrometry imaging and its application to silver-assisted laser desorption/ionization.\n\nAutomated annotation of matrix-related signals in MSI.\n\nrMSIcleanup is an open-source R package to annotate matrix-related signals in MSI data. The algorithm takes into account the chemical formula and the spatial distribution to determine which ions are matrix-related. The algorithm incorporates an overlapping peak detection feature to prevent misclassification of overlapped or isobaric ions. Additionally, the package generates a visual report to transparently justify each annotation","addition_date":"2020-01-14T19:39:02Z","last_update_date":"2026-11-12T14:25:06.714884Z","biotools_curie":"biotools:rMSIcleanup","edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Image annotation","uri":"http://edamontology.org/operation_3553"},{"term":"Peak detection","uri":"http://edamontology.org/operation_3215"},{"term":"Principal component visualisation","uri":"http://edamontology.org/operation_2939"}]}],"name":"rMSIcleanup","owner":"Pub2Tools","publication":[{"doi":"10.1101/2019.12.20.884957","type":["Preprint"]},{"doi":"10.1186/s13321-020-00449-0","type":["Primary"]}],"topic":[{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/moni