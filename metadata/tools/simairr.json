{"tool_name":"simairr","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"simairr","home":"https://github.com/KanduriC/simAIRR","license":"AGPL-3.0","summary":"simAIRR provides a simulation approach to generate synthetic AIRR datasets that are suitable for benchmarking machine learning (ML) methods, where undesirable access to ground truth signals in training datasets for ML methods is mitigated. Unlike state-of-the-art approaches, simAIRR constructs antigen-experienced-like baseline repertoires and introduces signals by following the empirical relationship between generation probability and sharing pattern of public sequences calibrated from real-world experimental datasets.","addition_date":"2023-08-22T13:17:43.452584Z","last_update_date":"2023-08-22T13:28:47.562550Z","tool_type":["Command-line tool"],"version":["0.1"],"accessibility":"Open access","biotools_curie":"biotools:simairr","documentation":[{"type":["User manual"],"url":"https://kanduric.github.io/simAIRR/"}],"edit_permission":{"type":"private"},"name":"simAIRR","operating_system":["Linux","Mac","Windows"],"owner":"kanduric","topic":[{"term":"Bioinformatics","uri":"http://edamontology.org/topic_0091"},{"term":"Immunoinformatics","uri":"http://edamontology.org/topic_3948"},{"term":"Immunomics","uri":"http://edamontology.org/topic_3967"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:simairr:0.1/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/mon