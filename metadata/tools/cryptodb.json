{"tool_name":"cryptodb","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"cryptodb","home":"http://cryptodb.org/cryptodb/","summary":"Genomic-scale dataset associated with the eukaryotic pathogens Cryptosporidium.","addition_date":"2015-09-11T22:51:30Z","last_update_date":"2018-12-16T14:27:53Z","tool_type":["Database portal"],"collections":["DRCAT"],"biotools_curie":"biotools:cryptodb","credit":[{"email":"jkissing@uga.edu","name":"Jessica C. Kissinger","orcidid":"http://orcid.org/0000-0002-6413-1101","typeEntity":"Person"},{"name":"DRCAT","typeEntity":"Project","typeRole":["Documentor"]},{"name":"University of Georgia","typeEntity":"Institute","typeRole":["Provider"]},{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://cryptodb.org/cryptodb/contact.do"}],"documentation":[{"type":["General"],"url":"http://cryptodb.org/cryptodb/showXmlDataContent.do?name=XmlQuestions.Tutorials"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Gene ID","uri":"http://edamontology.org/data_2295"}}],"operation":[{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"}],"output":[{"data":{"term":"Gene report","uri":"http://edamontology.org/data_0916"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"}]}]}],"name":"Cryptosporidium genome resources CryptoDB","operating_system":["Linux","Mac","Windows"],"owner":"DRCAT","publication":[{"doi":"10.1093/nar/gkj078","metadata":{"abstract":"The database, CryptoDB (http://CryptoDB.org), is a community bioinformatics resource for the AIDS-related apicomplexan-parasite, Cryptosporidium. CryptoDB integrates whole genome sequence and annotation with expressed sequence tag and genome survey sequence data and provides supplemental bioinformatics analyses and data-mining tools. A simple, yet comprehensive web interface is available for mining and visualizing the data. CryptoDB is allied with the databases PlasmoDB and ToxoDB via ApiDB, an NIH/NIAID-fundedBioinformatics Resource Center. Recent updates to CryptoDB include the deposition of annotated genome sequences for Cryptosporidium parvum and Cryptosporidium hominis, migration to a relational database (GUS), a new query and visualization interface and the introduction of Web services.","authors":[{"name":"Aurrecoechea C."},{"name":"Gao X."},{"name":"He C.Z."},{"name":"Heiges M."},{"name":"Kaluskar N."},{"name":"Kissinger J.C."},{"name":"Kraemer E."},{"name":"Miller J."},{"name":"Rhodes P."},{"name":"Robinson E."},{"name":"Su Y."},{"name":"Wang H."},{"name":"Wang S."}],"citationCount":108,"date":"2006-01-01T00:00:00Z","journal":"Nucleic acids research","title":"CryptoDB: a Cryptosporidium bioinformatics resource update."},"pmcid":"PMC1347441","pmid":"16381902","type":["Primary"]}],"topic":[{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"},{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"}],"validated":1},"bioschemas":{"name":"Cryptosporidium genome resources CryptoDB","home":"https://bio.tools/cryptodb","summary":"Genomic-scale dataset associated with the eukaryotic pathogens Cryptosporidium.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:cryptodb/db/cryptodb.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":88,"citations":[{"count":1,"year":"2010"},{"count":1,"year":"2026"},{"count":2,"year":"2006"},{"count":2,"year":"2007"},{"count":2,"year":"2015"},{"count":2,"year":"2016"},{"count":3,"year":"2022"},{"count":3,"year":"2024"},{"count":4,"year":"2014"},{"count":4,"year":"2021"},{"count":4,"year":"2023"},{"count":4,"year":"2025"},{"count":5,"year":"2009"},{"count":5,"year":"2013"},{"count":5,"year":"2017"},{"count":6,"year":"2011"},{"count":6,"year":"2018"},{"count":7,"