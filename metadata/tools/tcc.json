{"tool_name":"tcc","contents":["bioconda","bioconductor","biotools","oeb"],"identifiers":["biotools:tcc","bioconductor:tcc","bioconda:bioconductor-tcc"],"fetched_metadata":{"biotools":{"id":"tcc","home":"https://bioconductor.org/packages/TCC","license":"GPL-2.0","summary":"This package provides a series of functions for performing differential expression analysis from RNA-seq count data using robust normalization strategy (called DEGES). The basic idea of DEGES is that potential differentially expressed genes or transcripts (DEGs) among compared samples should be removed before data normalization to obtain a well-ranked gene list where true DEGs are top-ranked and non-DEGs are bottom ranked. This can be done by performing a multi-step normalization strategy (called DEGES for DEG elimination strategy). A major characteristic of TCC is to provide the robust normalization methods for several kinds of count data (two-group with or without replicates, multi-group/multi-factor, and so on) by virtue of the use of combinations of functions in depended packages.","addition_date":"2017-01-17T15:02:44Z","last_update_date":"2026-09-30T22:24:28.114006Z","tool_type":["Command-line tool","Library"],"version":["1.52.0"],"collections":["BioConductor"],"biotools_curie":"biotools:tcc","credit":[{"name":"Jianqiang Sun"},{"name":"Kentaro Shimizu"},{"name":"Tomoaki Nishiyama"},{"name":"and Koji Kadota"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/TCC"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Differential gene expression analysis","uri":"http://edamontology.org/operation_3223"}]}],"name":"TCC","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"bioconductor":{"name":"TCC","version":"1.52.0","license":"GPL-2","summary":"TCC: Differential exp