{"tool_name":"scisorwiz","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"scisorwiz","home":"http://github.com/ans4013/ScisorWiz","license":"Not licensed","summary":"Visualizing Differential Isoform Expression in Single-Cell Long-Read Data.","addition_date":"2022-08-17T21:06:13.205431Z","last_update_date":"2022-08-17T21:06:13.207890Z","tool_type":["Library"],"accessibility":"Open access","biotools_curie":"biotools:scisorwiz","cost":"Free of charge","credit":[{"email":"hut2006@med.cornell.edu","name":"Hagen U Tilgner","orcidid":"https://orcid.org/0000-0002-7058-3606","typeEntity":"Person"},{"name":"Anoushka Joglekar"},{"name":"Chi-Lam Poon"},{"name":"Alexander N Stein","orcidid":"https://orcid.org/0000-0002-5039-4330"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"},{"term":"Sorting","uri":"http://edamontology.org/operation_3802"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"ScisorWiz","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1093/BIOINFORMATICS/BTAC340","metadata":{"abstract":"\u00a9 2022 The Author(s) 2022. Published by Oxford University Press.Summary: RNA isoforms contribute to the diverse functionality of the proteins they encode within the cell. Visualizing how isoform expression differs across cell types and brain regions can inform our understanding of disease and gain or loss of functionality caused by alternative splicing with potential negative impacts. However, the extent to which this occurs in specific cell types and brain regions is largely unknown. This is the kind of information that ScisorWiz plots can provide in an informative and easily communicable manner. ScisorWiz affords its user the opportunity to visualize specific genes across any number of cell types, and provides various sorting options for the user to gain different ways to understand their data. ScisorWiz provides a clear picture of differential isoform expression through various clustering methods and highlights features such as alternative exons and single-nucleotide variants. Tools like ScisorWiz are key for interpreting single-cell isoform sequencing data. This tool applies to any single-cell long-read RNA sequencing data in any cell type, tissue or species.","authors":[{"name":"Joglekar A."},{"name":"Poon C.-L."},{"name":"Stein A.N."},{"name":"Tilgner H.U."}],"date":"2022-07-01T00:00:00Z","journal":"Bioinformatics","title":"ScisorWiz: Visualizing differential isoform expression in single-cell long-read data"},"pmcid":"PMC9237735","pmid":"35604081"}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"Neurobiology","uri":"http://edamontology.org/topic_3304"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"RNA splicing","uri":"http://edamontology.org/topic_3320"}],"validated":1},"bioschemas":{"name":"ScisorWiz","home":"https://bio.tools/scisorwiz","license":"Not licensed","summary":"Visualizing Differential Isoform Expression in Single-Cell Long-Read Data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:scisorwiz/lib/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":18,"citations":[{"count":1,"year":"2022"},{"count":1,"year":"2026"},{"count":4,"year":"2023"},{"count":5,"year":"2024"},{"count":7,"year":"2025"}],"doi":"10