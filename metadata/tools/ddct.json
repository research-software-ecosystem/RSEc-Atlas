{"tool_name":"ddct","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-ddct","version":"1.66.0","home":"https://bioconductor.org/packages/3.22/bioc/html/ddCt.html","license":"LGPL-3","summary":"The ddCt Algorithm for the Analysis of Quantitative Real-Time PCR (qRT-PCR)","identifiers":["biotools:ddct","doi:10.1038/nmeth.3252"],"description":"The Delta-Delta-Ct (ddCt) Algorithm is an approximation method to determine relative gene expression with quantitative real-time PCR (qRT-PCR) experiments. Compared to other approaches, it requires no standard curve for each primer-target pair, therefore reducing the working load and yet returning accurate enough results as long as the assumptions of the amplification efficiency hold. The ddCt package implements a pipeline to collect, analyse and visualize qRT-PCR results, for example those from TaqMan SDM software, mainly using the ddCt method. The pipeline can be either invoked by a script in command-line or through the API consisting of S4-Classes, methods and functions.","license_file":"/lib/R/share/licenses/LGPL-3","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-biobase >=2.70.0,<2.71.0","bioconductor-biocgenerics >=0.56.0,<0.57.0","r-base","r-lattice","r-rcolorbrewer >=0.1-3","r-xtable"],"run":["bioconductor-biobase >=2.70.0,<2.71.0","bioconductor-biocgenerics >=0.56.0,<0.57.0","r-base","r-lattice","r-rcolorbrewer >=0.1-3","r-xtable"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/ddCt_1.66.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ddCt/ddCt_1.66.0.tar.gz","https://bioarchive.galaxyproject.org/ddCt_1.66.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-ddct/bioconductor-ddct_1.66.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('ddCt')\""]},"parent_recipe":{"name":"bioconductor-ddct","path":"recipes/bioconductor-d