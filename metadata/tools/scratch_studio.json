{"tool_name":"scratch_studio","contents":["biotools"],"identifiers":["biotools:scratch_studio"],"fetched_metadata":{"biotools":{"id":"scratch_studio","home":"https://www.cellxapps.com/scratchstudio/","license":"PolyForm-Noncommercial-1.0.0","summary":"Scratch Studio is a desktop application for Apple Silicon Macs (macOS 11 or later) that analyses scratch (wound-healing) cell-migration assays, from raw images to publication-ready figures and statistics. Wound area is measured with a built-in classical detector or optional Cellpose or SAM 2 segmentation, all run locally. Calibration is read from the scale bar by OCR, or set manually. It reports percent wound closure, closure rate and edge velocity per condition, timepoint and biological replicate, flags blurred, poorly exposed or drifting frames, and picks representative images closest to the group mean. A recommendation engine selects robust tests (Welch t-test and ANOVA, Dunnett comparisons against control, two-way and repeated-measures designs, four-parameter logistic dose\u2013response) with effect sizes and assumption checks. Outputs include charts, a multi-panel figure composer, CSV, Excel and PDF reports, a time-lapse animation, and auto-generated Methods and Results text.","addition_date":"2026-10-29T01:40:10.061987Z","last_update_date":"2026-10-31T00:49:45.600391Z","tool_type":["Desktop application"],"version":["1.0.3"],"biotools_curie":"biotools:scratch_studio","cost":"Free of charge (with restrictions)","credit":[{"name":"M. Oktar Guloglu","orcidid":"https://orcid.org/0000-0002-3629-7788","typeEntity":"Person","typeRole":["Developer","Maintainer","Primary contact"]}],"documentation":[{"type":["Citation instructions"],"url":"https://github.com/oktarguloglu/scratch-studio#how-to-cite"},{"type":["General"],"url":"https://github.com/oktarguloglu/scratch-studio"},{"type":["Installation instructions"],"url":"https://github.com/oktarguloglu/scratch-studio#download"},{"type":["Release notes"],"url":"https://github.com/oktarguloglu/scratch-studio/releases"},{"type":["Terms of use"],"url":"https://github.com/oktarguloglu/scratch-studio/blob/main/LICENSE"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Image","uri":"http://edamontology.org/data_2968"},"format":[{"term":"AVI","uri":"http://edamontology.org/format_3990"},{"term":"BMP","uri":"http://edamontology.org/format_3592"},{"term":"JPG","uri":"http://edamontology.org/format_3579"},{"term":"MPEG-4","uri":"http://edamontology.org/format_3997"},{"term":"PNG","uri":"http://edamontology.org/format_3603"},{"term":"TIFF","uri":"http://edamontology.org/format_3591"}]}],"note":"Input: time-lapse microscopy images (TIFF, PNG, JPEG, BMP) or videos (MP4, AVI, MOV, MKV). Outputs: figures (PNG, JPEG, TIFF, PDF, SVG), results tables and reports (CSV, Excel, PDF), Methods and Results text (plain text, Markdown) and a time-lapse animation (GIF, MP4).","operation":[{"term":"Cell migration analysis","uri":"http://edamontology.org/operation_3446"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"},{"term":"Statistical calculation","uri":"http://edamontology.org/operation_2238"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}],"output":[{"data":{"term":"Image","uri":"http://edamontology.org/data_2968"},"format":[{"term":"GIF","uri":"http://edamontology.org/format_3467"},{"term":"MPEG-4","uri":"http://edamontology.org/format_3997"}]},{"data":{"term":"Plot","uri":"http://edamontology.org/data_2884"},"format":[{"term":"JPG","uri":"http://edamontology.org/format_3579"},{"term":"PDF","uri":"http://edamontology.org/format_3508"},{"term":"PNG","uri":"http://edamontology.org/format_3603"},{"term":"SVG","uri":"http://edamontology.org/format_3604"},{"term":"TIFF","uri":"http://edamontology.org/format_3591"}]},{"data":{"term":"Report","uri":"http://edamontology.org/data_2048"},"format":[{"term":"CSV","uri":"http://edamontology.org/format_3752"},{"term":"PDF","uri":"http://edamontology.org/format_3508"},{"term":"plain text format (unformatted)","uri":"http://edamontology.org/format_1964"},{"term":"xlsx","uri":"http://edamontology.org/format_3620"}]}]}],"maturity":"Emerging","name":"Scratch Studio","operating_system":["Mac"],"owner":"mehmet_oktar","topic":[{"term":"Bioimaging","uri":"http://edamontology.org/topic_3383"},{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Light microscopy","uri":"http://edamontology.org/topic_3385"},{"term":"Statistics and probability","uri":"http://edamontology.org/topic_2269"}]}}}