{"tool_name":"ardock","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"ardock","home":"http://ardock.ibcp.fr","summary":"Analysis of surfaces of protein structures.","addition_date":"2016-03-24T16:56:27Z","last_update_date":"2024-11-25T14:42:13.598114Z","tool_type":["Web API","Web application"],"version":["0.9"],"biotools_curie":"biotools:ardock","credit":[{"email":"guillaume.launay@ibcp.fr","name":"Guillaume Launay","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"ardock-support@ibcp.fr","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"ibcp","typeEntity":"Consortium"},{"name":"CNRS","typeEntity":"Institute","typeRole":["Provider"]},{"name":"G.Launay","typeEntity":"Person","typeRole":["Developer"]},{"name":"UCBL","typeEntity":"Institute","typeRole":["Provider"]},{"name":"ibcp.fr","typeEntity":"Institute","typeRole":["Provider"]},{"name":"J.Martin","typeRole":["Contributor"]},{"name":"R.Lavery","typeRole":["Contributor"]}],"documentation":[{"type":["General"],"url":"http://ardock.ibcp.fr/tutorial"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"PDB ID","uri":"http://edamontology.org/data_1127"}},{"data":{"term":"Protein structure","uri":"http://edamontology.org/data_1460"},"format":[{"term":"PDB","uri":"http://edamontology.org/format_1476"}]}],"note":"Analyse protein surface residues for interaction site prediction","operation":[{"term":"Prediction and recognition","uri":"http://edamontology.org/operation_2423"}]},{"operation":[{"term":"Molecular docking","uri":"http://edamontology.org/operation_0478"}]}],"name":"arDock","operating_system":["Linux","Mac","Windows"],"owner":"guillaume.launay@ibcp.fr","publication":[{"doi":"10.1093/nar/gky472","metadata":{"abstract":"ArDock (ardock.ibcp.fr) is a structural bioinformatics web server for the prediction and the visualization of potential interaction regions at protein surfaces. ArDock ranks the surface residues of a protein according to their tendency to form interfaces in a set of predefined docking experiments between the query protein and a set of arbitrary protein probes. The ArDock methodology is derived from large scale cross-docking studies where it was observed that randomly chosen proteins tend to dock in a non-random way at protein surfaces. The method predicts interaction site of the protein, or alternate interfaces in the case of proteins with multiple interaction modes. The server takes a protein structure as input and computes a score for each surface residue. Its output focuses on the interactive visualization of results and on interoperability with other services.","authors":[{"name":"Garnier M."},{"name":"Gouet P."},{"name":"Launay G."},{"name":"Martin J."},{"name":"Reille S."},{"name":"Robert X."}],"citationCount":9,"date":"2018-07-02T00:00:00Z","journal":"Nucleic Acids Research","title":"Identification and visualization of protein binding regions with the ArDock server"},"pmcid":"PMC6031020","pmid":"29905873","type":["Primary"]},{"doi":"10.1186/2046-1682-5-7","pmcid":"PMC3441232","pmid":"22559010","type":["Primary"]}],"topic":[{"term":"Protein binding sites","uri":"http://edamontology.org/topic_3534"},{"term":"Protein structural motifs and surfaces","uri":"http://edamontology.org/topic_0166"}],"validated":1},"bioschemas":{"name":"arDock","home":"https://bio.tools/ardock","version":"0.9","summary":"Analysis of surfaces of protein structures.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ardock:0.9/rest/ardock.ibcp.fr","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":4,"citations":[{"count":1,"year":"2021"},{"count":1,"year":"2023"},{"count":2,"year":"2022"}],"doi":"10.1093/nar/gky472"