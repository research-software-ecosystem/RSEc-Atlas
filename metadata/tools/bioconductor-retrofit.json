{"tool_name":"bioconductor-retrofit","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-retrofit","home":"https://bioconductor.org/packages/retrofit","license":"GPL-3.0","summary":"RETROFIT is a Bayesian non-negative matrix factorization framework to decompose cell type mixtures in ST data without using external single-cell expression references. RETROFIT outperforms existing reference-based methods in estimating cell type proportions and reconstructing gene expressions in simulations with varying spot size and sample heterogeneity, irrespective of the quality or availability of the single-cell reference. RETROFIT recapitulates known cell-type localization patterns in a Slide-seq dataset of mouse cerebellum without using any single-cell data.","tool_type":["Command-line tool","Library"],"version":["1.12.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-retrofit","credit":[{"name":"Adam Park","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Qunhua Li","typeEntity":"Person","typeRole":["Developer"]},{"name":"Roopali Singh","typeEntity":"Person","typeRole":["Developer"]},{"name":"Xiang Zhu","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/retrofit"}],"name":"retrofit","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-retrofit:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monit