{"tool_name":"hifiasm","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"hifiasm","identifiers":[],"license":"MIT","summary":"Haplotype-resolved assembler for accurate Hifi reads","home_url":"https://github.com/chhylp123/hifiasm","keywords":["Genomics"],"manually_check":true,"total_pulls":7341},"biotools":{"id":"hifiasm","home":"https://github.com/chhylp123/hifiasm","license":"MIT","summary":"Hifiasm: a haplotype-resolved assembler for accurate Hifi reads","addition_date":"2022-07-04T14:39:20.644374Z","last_update_date":"2026-05-05T08:11:43.608451Z","tool_type":["Command-line tool"],"version":["0.16.1"],"biotools_curie":"biotools:hifiasm","documentation":[{"type":["General"],"url":"https://hifiasm.readthedocs.io/en/latest/"}],"edit_permission":{"authors":["bebatut"],"type":"group"},"function":[{"operation":[{"term":"De-novo assembly","uri":"http://edamontology.org/operation_0524"},{"term":"Genome assembly","uri":"http://edamontology.org/operation_0525"}]}],"name":"Hifiasm","owner":"alexcorm","publication":[{"doi":"10.1038/s41592-020-01056-5","metadata":{"abstract":"Haplotype-resolved de novo assembly is the ultimate solution to the study of sequence variations in a genome. However, existing algorithms either collapse heterozygous alleles into one consensus copy or fail to cleanly separate the haplotypes to produce high-quality phased assemblies. Here we describe hifiasm, a de novo assembler that takes advantage of long high-fidelity sequence reads to faithfully represent the haplotype information in a phased assembly graph. Unlike other graph-based assemblers that only aim to maintain the contiguity of one haplotype, hifiasm strives to preserve the contiguity of all haplotypes. This feature enables the development of a graph trio binning algorithm that greatly advances over standard trio binning. On three human and five nonhuman datasets, including California redwood with a ~30-Gb hexaploid genome, we show that hifiasm frequently delivers better assemblies than existing tools and consistently outperforms others on haplotype-resolved assembly.","authors":[{"name":"Cheng H."},{"name":"Concepcion G.T."},{"name":"Feng X."},{"name":"Li H."},{"name":"Zhang H."}],"citationCount":1739,"date":"2021-02-01T00:00:00Z","journal":"Nature Methods","title":"Haplotype-resolved de novo assembly using phased assembly graphs with hifiasm"},"pmcid":"PMC7961889","pmid":"33526886"}],"topic":[{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"}]},"bioschemas":{"name":"Hifiasm","home":"https://bio.tools/hifiasm","license":"MIT","version":"0.16.1","summary":"Hifiasm: a haplotype-resolved assembler for accurate Hifi reads","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:hifiasm/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":3744,"citations":[{"count":1,"year":"2020"},{"count":2,"year":"-1"},{"count":77,"year":"2021"},{"count":240,"year":"2022"},{"count":621,"year":"2023"},{"count":709,"year":"2026"},{"count":908,"year":"2024"},{"count":1186,"year":"2025"}],"doi":"10.1038/s41592-020-01056-5","pmcid":"PMC7961889","pmid":"33526886","ref_count":1,"refs":[{"count":1,"year":"2005"}],"title":"Haplotype-resolved de novo assembly using phased assembly graphs with hifiasm.","year":2021}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"su