{"tool_name":"airrship","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"airrship","home":"https://github.com/Cowanlab/airrship","license":"AGPL-3.0","summary":"Simulating human B cell receptor repertoire sequences.","addition_date":"2024-01-22T10:48:04.647235Z","last_update_date":"2024-11-24T14:21:01.623365Z","tool_type":["Command-line tool","Library"],"biotools_curie":"biotools:airrship","cost":"Free of charge","credit":[{"email":"graeme.cowan@ed.ac.uk","name":"Graeme J M Cowan","orcidid":"https://orcid.org/0000-0002-1949-4253","typeEntity":"Person"}],"documentation":[{"type":["User manual"],"url":"https://airrship.readthedocs.io/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Recombination detection","uri":"http://edamontology.org/operation_0451"}]}],"name":"AIRRSHIP","operating_system":["Linux","Mac","Windows"],"owner":"Pub2Tools","publication":[{"doi":"10.1093/bioinformatics/btad365","metadata":{"abstract":"Adaptive Immune Receptor Repertoire Sequencing is a rapidly developing field that has advanced understanding of the role of the adaptive immune system in health and disease. Numerous tools have been developed to analyse the complex data produced by this technique but work to compare their accuracy and reliability has been limited. Thorough, systematic assessment of their performance is dependent on the ability to produce high quality simulated datasets with known ground truth. We have developed AIRRSHIP, a flexible and fast Python package that produces synthetic human B cell receptor sequences. AIRRSHIP uses a comprehensive set of reference data to replicate key mechanisms in the immunoglobulin recombination process, with a particular focus on junctional complexity. Repertoires generated by AIRRSHIP are highly similar to published data and all steps in the sequence generation process are recorded. These data can be used to not only determine the accuracy of repertoire analysis tools but can also, by tuning of the large number of user-controllable parameters, give insight into factors that contribute to inaccuracies in results.","authors":[{"name":"Cowan G.J.M."},{"name":"Sutherland C."}],"citationCount":1,"date":"2023-06-01T00:00:00Z","journal":"Bioinformatics","title":"AIRRSHIP: simulating human B cell receptor repertoire sequences"},"pmcid":"PMC10272706","pmid":"37279738"}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"DNA replication and recombination","uri":"http://edamontology.org/topic_3127"},{"term":"Human biology","uri":"http://edamontology.org/topic_2815"}]},"bioschemas":{"name":"AIRRSHIP","home":"https://bio.tools/airrship","license":"AGPL-3.0","summary":"Simulating human B cell receptor repertoire sequences.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:airrship/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":4,"citations":[{"count":1,"year":"2022"},{"count":1,"year":"2024"},{"count":2,"year":"2025"}],"doi":"10.1093/bioinformatics/btad365","pmcid":"PMC10272706","pmid":"37279738","ref_count":20,"refs":[{"count":1,"year":"2007"},{"count":1,"year":"2008"},{"count":1,"year":"2017"},{"count":1,"year":"2019"},{"count":2,"year":"2013"},{"count":2,"year":"2016"},{"count":2,"year":"2018"},{"count":2,"year":"2020"},{"count":2,"year":"2021"},{"count":2,"year":"2022"},{"count":4,"year":"2015"}],"title":"AIRRSHIP: simulating human B cell receptor repertoire sequences.","year":2023}]}],"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openeben