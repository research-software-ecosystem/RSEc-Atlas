{"tool_name":"nucleome_data_bank","contents":["biotools","oeb"],"identifiers":["biotools:nucleome_data_bank"],"fetched_metadata":{"biotools":{"id":"Nucleome_Data_Bank","home":"https://ndb.rice.edu","summary":"Web-based Resources to Simulate and Analyze the Three-Dimensional Genome.\n\nA web platform to simulate and browse the three-dimensional architecture of genomes.\n\nIn NDB user can find data for 3D genome structures and also computational tools for simulating the genome. The server is also made for visualization the structures and dynamics of the genome, allowing users to explore the 3D organization of chromosomes from their computer.\n\nThis platform enables users to visualize and annotate the 3D chromosome structures with experimental tracks from ENCODE or with their own data, allowing for an integrative experience for all genome scientists.","addition_date":"2020-01-14T19:45:54Z","last_update_date":"2026-11-12T14:23:31.643466Z","tool_type":["Web application"],"biotools_curie":"biotools:Nucleome_Data_Bank","edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Genome visualisation","uri":"http://edamontology.org/operation_3208"},{"term":"Molecular dynamics","uri":"http://edamontology.org/operation_2476"},{"term":"Structure visualisation","uri":"http://edamontology.org/operation_0570"}]}],"name":"Nucleome Data Bank","owner":"Pub2Tools","publication":[{"doi":"10.1093/nar/gkaa818","type":["Primary"]},{"doi":"10.1101/2019.12.20.885145","type":["Preprint"]}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Epigenetics","uri":"http://edamontology.org/topic_3295"},{"term":"Immunoprecipitation experiment","uri":"http://edamontology.org/topic_3656"},{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"},{"term":"Molecular dynamics","uri":"http://edamontology.org/topic_0176"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:nucleome_data_bank/web/ndb.rice.edu","@licens