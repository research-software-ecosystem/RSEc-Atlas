{"tool_name":"idbp","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"idbp","home":"http://idbps.tau.ac.il/","summary":"A server for the identification of DNA binding proteins.","addition_date":"2015-02-16T10:08:08Z","last_update_date":"2024-11-25T15:00:54.871389Z","tool_type":["Web application"],"version":["1"],"collections":["Instruct"],"biotools_curie":"biotools:idbp","cost":"Free of charge","credit":[{"email":"ccisb@stfc.ac.uk","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"Instruct","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["General"],"url":"http://idbps.tau.ac.il/Overview.htm"}],"edit_permission":{"type":"private"},"function":[{"note":"The iDBPs server was developed for the identification of DNA binding proteins (DBPs) for proteins with known three-dimensional structure.In the first stage of classification, the functional region of the protein is predicted using the PatchFinder algorithm. PatchFinder searches for clusters (patches) of evolutionarily conserved residues on the protein surface. It was previously shown that the maximum-likelihood (ML) patches found by PatchFinder often delineate the functional regions in proteins, specifically, the core of DNA binding regions within DBPs.The iDBPs server uses the random forests classifier trained with global features of the proteins as well as features of their ML-patches. The features can be roughly divided into seven categories as follows:Surface electrostatic potential.Amino acid conservation patterns of the ML-patch.Secondary structure content.Amino acid content.Hydrogen donors/acceptors.Dipole moment.Spatial asymmetry of the distribution of specific amino acids.The","operation":[{"term":"Protein interaction prediction","uri":"http://edamontology.org/operation_2492"}]}],"name":"iDBP","operating_system":["Linux","Mac","Windows"],"owner":"Instruct","publication":[{"doi":"10.1016/j.jmb.2009.02.023","pmcid":"PMC2726711","pmid":"19233205","type":["Primary"]}],"topic":[{"term":"DNA binding sites","uri":"http://edamontology.org/topic_3125"},{"term":"Functional genomics","uri":"http://edamontology.org/topic_0085"},{"term":"Structural biology","uri":"http://edamontology.org/topic_1317"}],"validated":1},"bioschemas":{"name":"iDBP","home":"https://bio.tools/idbp","version":"1","summary":"A server for the identification of DNA binding proteins.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:idbp:1/web/idbps.tau.ac.il","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":36,"citations":[{"count":1,"year":"-1"},{"count":1,"year":"2015"},{"count":1,"year":"2017"},{"count":1,"year":"2018"},{"count":1,"year":"2024"},{"count":2,"year":"2013"},{"count":2,"year":"2019"},{"count":4,"year":"2010"},{"count":4,"year":"2012"},{"count":4,"year":"2016"},{"count":4,"year":"2020"},{"count":5,"year":"2011"},{"count":6,"year":"2014"}],"doi":"10.1016/j.jmb.2009.02.023","pmcid":"PMC2726711","pmid":"19233205","ref_count":73,"refs":[{"count":1,"year":"1975"},{"count":1,"year":"1983"},{"count":1,"year":"1984"},{"count":1,"year":"1987"},{"count":1,"year":"1989"},{"count":1,"year":"1992"},{"count":1,"year":"2001"},{"count":2,"year":"1993"},{"count":2,"year":"1996"},{"count":2,"year":"1997"},{"count":2,"year":"2003"},{"count":2,"year":"2008"},{"count":3,"year":"1995"},{"count":3,"year":"1998"},{"count":3,"year":"1999"},{"count":3,"year":"2002"},{"count":4,"year":"1994"},{"count":4,"year":"2007"},{"count":7,"year":"2006"},{"count":8,"year":"2000"},{"count":9,"year":"2004"},{"count":12,"year":"2005"}],"title":"Identification of DNA-binding proteins using structural, electrostatic and evolutionary features.","year":2009}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright"