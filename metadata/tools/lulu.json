{"tool_name":"lulu","contents":["biotools","oeb"],"identifiers":["biotools:lulu"],"fetched_metadata":{"biotools":{"id":"LULU","home":"https://github.com/tobiasgf/lulu","license":"LGPL-3.0","summary":"A flexible pipeline combining bioinformatic correction tools for prokaryotic and eukaryotic metabarcoding | r package for post-clustering curation of amplicon next generation sequencing data (metabarcoding) | The purpose of LULU is to reduce the number of erroneous OTUs in OTU tables to achieve more realistic biodiversity metrics. By evaluating the co-occurence patterns of OTUs among samples LULU identifies OTUs that consistently satisfy some user selected criteria for being errors of more abundant OTUs and merges these. It has been shown that curation with LULU consistently result in more realistic diversity metrics. The required input of LULU is an OTU table and a corresponding matchlist with all the internal matches of OTUs | A r-package for distribution based post clustering curation of amplicon data","addition_date":"2019-11-14T18:31:28Z","last_update_date":"2026-11-12T14:25:55.555407Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:LULU","edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Community profiling","uri":"http://edamontology.org/operation_3200"},{"term":"Rarefaction","uri":"http://edamontology.org/operation_3797"},{"term":"Sequence trimming","uri":"http://edamontology.org/operation_3192"}]}],"name":"LULU","owner":"Pub2Tools","publication":[{"doi":"10.1101/717355","type":["Preprint"]},{"doi":"10.1111/1755-0998.13398","type":["Primary"]}],"topic":[{"term":"Biodiversity","uri":"http://edamontology.org/topic_3050"},{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:lulu/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1101/717355","pmcid":null,"pmid":null,"ref_count":0,"refs":[],"title":null,"year":null}]},{"entries":[{"cit_count":29,"citations":[{"count":2,"year":2026},{"count":4,"year":2024},{"count":5,"year":2021},{"count":5,"year":2022},{"count":6,"year":2023},{"count":7,"year":2025}],"doi":"10.1111/1755-0998.13398","pmid":"33835712","ref_count":0,"refs":[],"title":"Bioinformatic pipelines combining denoising and clustering tools allow for more comprehensive prokaryotic and eukaryotic metabarcoding.","year":2021}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":true,"resolve_time":"PT105368S"}}},{"@id":"https://openebench.bsc.es/monitor/metrics/lulu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"publications":[],"readme":true,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":true,"resolve_time":"PT105368S"}}}]}}}