{"tool_name":"sga","contents":["biocontainers","bioschemas","debian","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"sga","version":"0.10.15","home":"https://github.com/jts/sga","license":"GPL-3.0-or-later","summary":"SGA - String Graph Assembler. SGA is a de novo assembler for DNA sequence reads. It is based on Gene Myers string graph formulation of assembly and uses the FM-index/Burrows-Wheeler transform to efficiently find overlaps between sequence reads.","identifiers":["biotools:sga"],"license_file":"src/COPYING","build":{"number":11,"run_exports":[null]},"requirements":{"build":["make",null,null,"autoconf","automake","libtool","pkg-config","gnuconfig"],"host":["sparsehash","bamtools","zlib"],"run":["sparsehash","bamtools"]},"source_url":"https://github.com/jts/sga/archive/v0.10.15.tar.gz","test":{"commands":["sga --help"]}},"biocontainers":{"name":"sga","identifiers":["biotools:sga","doi:10.1093/bioinformatics/bti1114"],"license":"GPL-3.0","summary":"Sga is a de novo assembler designed to assemble large genomes from high coverage short read data.","home_url":"https://github.com/jts/sga","keywords":["Base Sequence","Chromosome Mapping","DNA Fragmentation","Molecular Sequence Data","Sequence Analysis, DNA","Genomics","Sequence assembly","Whole genome sequencing"],"manually_check":true,"total_pulls":4856},"biotools":{"id":"sga","home":"https://github.com/jts/sga","license":"GPL-3.0","summary":"SGA is a de novo assembler designed to assemble large genomes from high coverage short read data.","addition_date":"2017-01-13T13:16:25Z","last_update_date":"2024-11-24T20:25:02.853286Z","tool_type":["Suite"],"biotools_curie":"biotools:sga","credit":[{"email":"jared.simpson@oicr.on.ca","name":"Jared Simpson","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/jts/sga/tree/master/src#readme"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Sequence assembly","uri":