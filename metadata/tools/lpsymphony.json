ny is that it includes the solver source code (SYMPHONY version 5.6), while Rsymphony expects to find header and library files on the users' system. Thus the intention of lpsymphony is to provide an easy to install interface to SYMPHONY. For Windows, precompiled DLLs are included in this package.","addition_date":"2017-01-17T15:04:36Z","last_update_date":"2018-12-10T12:58:51Z","tool_type":["Command-line tool","Library"],"version":["1.40.0"],"collections":["BioConductor"],"biotools_curie":"biotools:lpsymphony","credit":[{"name":"Ashutosh Mahajan","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Cyrille Szymanski","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Kurt Hornik","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Menal Guzelsoy","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Mike Smith","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Reinhard Harter","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Stefan Theussl","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Ted Ralphs","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Vladislav Kim","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/lpsymphony"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"lpsymphony","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.18129/B9.bioc.lpsymphony"}],"topic":[{"term":"Informatics","uri":"http://edamontology.org/topic_0605"}],"validated":1},"bioschemas":{"name":"lpsymphony","home":"https://bio.tools/lpsymphony","license":"EPL-1.0","version":"1.40.0","summary":"This package was derived from Rsymphony_0.1-17 from CRAN. These packages provide an R interface to SYMPHONY, an open-source linear programming solver written in C++. The main difference between this