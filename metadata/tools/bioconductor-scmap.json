{"tool_name":"bioconductor-scmap","contents":["biocontainers","oeb","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-scmap","identifiers":["doi:10.18129/b9.bioc.scmap"],"license":"GPL-3","summary":"A tool for unsupervised projection of single cell RNA-seq data","home_url":"https://bioconductor.org/packages/3.8/bioc/html/scmap.html","keywords":["Clustering","RNA-Seq","Transcriptomics","Transcriptome"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-scmap","home":"https://bioconductor.org/packages/scmap","license":"GPL-3.0","summary":"Single-cell RNA-seq (scRNA-seq) is widely used to investigate the composition of complex tissues since the technology allows researchers to define cell-types using unsupervised clustering of the transcriptome. However, due to differences in experimental methods and computational analyses, it is often challenging to directly compare the cells identified in two different experiments. scmap is a method for projecting cells from a scRNA-seq experiment on to the cell-types or individual cells identified in a different experiment.","tool_type":["Command-line tool","Library"],"version":["1.34.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-scmap","credit":[{"name":"Vladimir Kiselev"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/scmap"}],"name":"scmap","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-scmap:1.10.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true