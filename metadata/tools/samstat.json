{"tool_name":"samstat","contents":["bioconda","bioschemas","biotools","oeb"],"identifiers":["biotools:samstat","bioconda:samstat"],"fetched_metadata":{"bioconda":{"name":"samstat","version":"2.5.0","home":"https://github.com/TimoLassmann/samstat","documentation":"https://github.com/TimoLassmann/samstat","license":"MIT","summary":"Quality control for SAM, BAM, CRAM, FASTA and FASTQ files, split by mapping quality.","identifiers":["biotools:samstat","doi:10.1093/bioinformatics/btad019"],"description":"SAMStat summarises sequencing reads and their alignments in one self-contained HTML report:\nread length, base quality, base composition, mismatch and indel rates along the read and\nidentity to the reference, each split by mapping quality. Short and long reads (Illumina,\nPacBio, ONT) are supported. It can also write JSON and MultiQC files.\n","license_file":"COPYING","build":{"number":0,"run_exports":[null]},"requirements":{"build":[null,null,"cmake >=3.19","make","autoconf","automake"],"host":["zlib","bzip2","xz"]},"source_url":"https://github.com/TimoLassmann/samstat/archive/refs/tags/v2.5.0.tar.gz","test":{"commands":["samstat -v","printf '@HD\\tVN:1.6\\n@SQ\\tSN:chr1\\tLN:1000\\nr1\\t0\\tchr1\\t1\\t60\\t10M\\t*\\t0\\t0\\tACGTACGTAC\\tIIIIIIIIII\\tNM:i:0\\tMD:Z:10\\n' > test.sam","samstat --json --multiqc test.sam","test -s test.sam.samstat.html","test -s test.sam.samstat.json","test -s test.sam.samstat_general_mqc.json","printf '@r1\\nACGTACGTAC\\n+\\nIIIIIIIIII\\n@r2\\nACGTACGTAC\\n+\\nIIIIIIIIII\\n' > test.fq","samstat test.fq","test -s test.fq.samstat.html"]}},"biotools":{"id":"samstat","home":"http://samstat.sourceforge.net/#usage","license":"GPL-3.0","summary":"Efficient C program for displaying statistics of large sequence files.","addition_date":"2017-01-13T13:16:12Z","last_update_date":"2024-11-25T15:21:00.872426Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:samstat","credit":[{"email":"timolassmann@gmail.com","name":"Timo Lassmann","typeEn