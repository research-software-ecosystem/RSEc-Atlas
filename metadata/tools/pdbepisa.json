{"tool_name":"pdbepisa","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"pdbepisa","home":"http://pdbe.org/pisa","summary":"Exploration of macromolecular interfaces and prediction of probable quaternary structures.","addition_date":"2015-01-29T15:47:22Z","last_update_date":"2024-11-25T14:26:02.516607Z","tool_type":["Web application"],"version":["1"],"collections":["EBI Tools","PDBe Tools"],"biotools_curie":"biotools:pdbepisa","credit":[{"email":"mikew@ebi.ac.uk","name":"Michael Wainwright","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"pdbhelp@ebi.ac.uk","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"EMBL-EBI","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Michael Wainwright","typeEntity":"Person","typeRole":["Developer"]},{"name":"PDBe development team","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["General"],"url":"http://pdbe.org/pisa"},{"type":["Terms of use"],"url":"http://www.ebi.ac.uk/about/terms-of-use"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Protein structure","uri":"http://edamontology.org/data_1460"},"format":[{"term":"PDB","uri":"http://edamontology.org/format_1476"}]}],"note":"The output includes  a ranked list of probable assemblies and webpages showing analysis of interfacing residues","operation":[{"term":"Molecular surface analysis","uri":"http://edamontology.org/operation_3351"},{"term":"Protein quaternary structure prediction","uri":"http://edamontology.org/operation_3350"}],"output":[{"data":{"term":"Protein interaction data","uri":"http://edamontology.org/data_0906"}},{"data":{"term":"Protein structure report","uri":"http://edamontology.org/data_1537"}}]}],"name":"PDBePISA","operating_system":["Linux","Mac","Windows"],"owner":"EMBL-EBI","publication":[{"doi":"10.1016/j.jmb.2007.05.022","metadata":{"abstract":"We discuss basic physical-chemical principles underlying the formation of stable macromolecular complexes, which in many cases are likely to be the biological units performing a certain physiological function. We also consider available theoretical approaches to the calculation of macromolecular affinity and entropy of complexation. The latter is shown to play an important role and make a major effect on complex size and symmetry. We develop a new method, based on chemical thermodynamics, for automatic detection of macromolecular assemblies in the Protein Data Bank (PDB) entries that are the results of X-ray diffraction experiments. As found, biological units may be recovered at 80-90% success rate, which makes X-ray crystallography an important source of experimental data on macromolecular complexes and protein-protein interactions. The method is implemented as a public WWW service\u2020.\u2020http://www.ebi.ac.uk/msd-srv/prot int/pistart.html. \u00a9 2007 Elsevier Ltd. All rights reserved.","authors":[{"name":"Henrick K."},{"name":"Krissinel E."}],"citationCount":7792,"date":"2007-09-21T00:00:00Z","journal":"Journal of Molecular Biology","title":"Inference of Macromolecular Assemblies from Crystalline State"},"pmid":"17681537","type":["Primary"]}],"topic":[{"term":"Protein structural motifs and surfaces","uri":"http://edamontology.org/topic_0166"},{"term":"Structure prediction","uri":"http://edamontology.org/topic_0082"}],"validated":1},"bioschemas":{"name":"PDBePISA","home":"https://bio.tools/pdbepisa","version":"1","summary":"Exploration of macromolecular interfaces and prediction of probable quaternary structures.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pdbepisa:1/web/pdbe.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"faq":true,"general":true,"terms_of_use":true,"tutorial":true},"publications":[{"entries":[{"cit_count":6139,"citations":[{"count":1,"year":