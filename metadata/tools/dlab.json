{"tool_name":"dlab","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"dlab","home":"https://github.com/oxpig/dlab-public","license":"GPL-2.0","summary":"DLAB-Deep learning methods for structure-based virtual screening of antibodies.","addition_date":"2022-02-23T18:36:58.189085Z","last_update_date":"2024-11-24T20:11:31.513186Z","tool_type":["Workflow"],"accessibility":"Open access","biotools_curie":"biotools:dlab","credit":[{"email":"deane@stats.ox.ac.uk","name":"Charlotte M Deane","typeEntity":"Person"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Epitope mapping","uri":"http://edamontology.org/operation_0416"},{"term":"Peptide immunogenicity prediction","uri":"http://edamontology.org/operation_0252"},{"term":"Protein-protein docking","uri":"http://edamontology.org/operation_3899"},{"term":"Side chain modelling","uri":"http://edamontology.org/operation_0480"},{"term":"Virtual screening","uri":"http://edamontology.org/operation_3938"}]}],"name":"DLAB","owner":"Chan019","publication":[{"doi":"10.1093/bioinformatics/btab660","metadata":{"abstract":"Motivation: Antibodies are one of the most important classes of pharmaceuticals, with over 80 approved molecules currently in use against a wide variety of diseases. The drug discovery process for antibody therapeutic candidates however is time- and cost-intensive and heavily reliant on in vivo and in vitro high throughput screens. Here, we introduce a framework for structure-based deep learning for antibodies (DLAB) which can virtually screen putative binding antibodies against antigen targets of interest. DLAB is built to be able to predict antibody-antigen binding for antigens with no known antibody binders. Results: We demonstrate that DLAB can be used both to improve antibody-antigen docking and structure-based virtual screening of antibody drug candidates. DLAB enables improved pose ranking for antibody docking experiments as well as selection of antibody-antigen pairings for which accurate poses are generated and correctly ranked. We also show that DLAB can identify binding antibodies against specific antigens in a case study. Our results demonstrate the promise of deep learning methods for structure-based virtual screening of antibodies.","authors":[{"name":"Buchanan A."},{"name":"Deane C.M."},{"name":"Schneider C."},{"name":"Taddese B."}],"citationCount":53,"date":"2022-01-15T00:00:00Z","journal":"Bioinformatics","title":"DLAB: deep learning methods for structure-based virtual screening of antibodies"},"pmcid":"PMC8723137","pmid":"34546288"}],"topic":[{"term":"Biotherapeutics","uri":"http://edamontology.org/topic_3374"},{"term":"Drug discovery","uri":"http://edamontology.org/topic_3336"},{"term":"Immunogenetics","uri":"http://edamontology.org/topic_3930"},{"term":"Immunoproteins and antigens","uri":"http://edamontology.org/topic_2830"},{"term":"Molecular modelling","uri":"http://edamontology.org/topic_2275"}],"validated":1},"bioschemas":{"name":"DLAB","home":"https://bio.tools/dlab","license":"GPL-2.0","summary":"DLAB-Deep learning methods for structure-based virtual screening of antibodies.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:dlab/workflow/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":52,"citations":[{"count":1,"year":"2021"},{"count":2,"year":"2026"},{"count":4,"year":"-1"},{"count":4,"year":"2022"},{"count":11,"year":"2024"},{"count":14,"year":"2023"},{"count":16,"year":"2025"}],"doi":"10.1093/bioinformatics/btab660","pmcid":"PMC8723137","pmid":"34546288","ref_count":36,"refs":[{"count":1,"year":"1971"},{"count":1,"year":"2000"},{"count":1,"year":"2004"},{"count":1,"year":"2005"},{"count":1,"year":"2006"},{"count":1,"year":"2008"},{"count":1,"year":"2011"},{"count":2,"year":"2013"},{"count":2,"year":"2015"},{"count":2,"year":"2016"},{"count":2,"year":"2019"},{"count":3,"year":"2014"},{"count":3,"year":"2021"},{"count":4,"year":"2017"},{"count":5,"year":"2018"},{"count":6,"year":"2020"}],"title":"DLAB: deep learning methods for structure-based virtual screening of antibodies.","year":2022}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/dlab","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"publications":[],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}}]}}}