{"tool_name":"3d-footprint","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"3d-footprint","home":"http://floresta.eead.csic.es/3dfootprint","summary":"3D-footprint provides estimates of binding specificity for all protein-DNA complexes available at the Protein Data Bank. The web interface allows the user to: (i) browse DNA-binding proteins by keyword; (ii) find proteins that recognize a similar DNA motif and (iii) BLAST similar DNA-binding proteins, highlighting interface residues in the resulting alignments. Comparisons with expert-curated databases RegulonDB and TRANSFAC support the quality of structure-based estimates of specificity.","addition_date":"2017-03-30T16:57:04Z","last_update_date":"2024-11-25T15:01:51.213583Z","tool_type":["Database portal"],"biotools_curie":"biotools:3d-footprint","credit":[{"email":"compbio@eead.csic.es","name":"3D-Footprint Support","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://floresta.eead.csic.es/3dfootprint/tutorial.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Database comparison","uri":"http://edamontology.org/operation_3561"},{"term":"Molecular docking","uri":"http://edamontology.org/operation_0478"},{"term":"Protein comparison","uri":"http://edamontology.org/operation_2997"},{"term":"Protein model validation","uri":"http://edamontology.org/operation_0321"}]}],"name":"3D-Footprint","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"doi":"10.1093/nar/gkp781","pmcid":"PMC2808867","pmid":"19767616"}],"topic":[{"term":"Protein binding sites","uri":"http://edamontology.org/topic_3534"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"},{"term":"Sequence composition, complexity and repeats","uri":"http://edamontology.org/topic_0157"},{"term":"Structure analysis","uri":"http://edamontology.org/topic_0081"}],"validated":1},"bioschemas":{"name":"3D-Footprint","home":"