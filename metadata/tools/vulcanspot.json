93/bioinformatics/btz465","metadata":{"abstract":"Genetic alterations lead to tumor progression and cell survival but also uncover cancer-specific vulnerabilities on gene dependencies that can be therapeutically exploited. Results: vulcanSpot is a novel computational approach implemented to expand the therapeutic options in cancer beyond known-driver genes unlocking alternative ways to target undruggable genes. The method integrates genome-wide information provided by massive screening experiments to detect genetic vulnerabilities associated to tumors. Then, vulcanSpot prioritizes drugs to target cancer-specific gene dependencies using a weighted scoring system based on well known drug-gene relationships and drug repositioning strategies.","authors":[{"name":"Al-Shahrour F."},{"name":"Carretero-Puche C."},{"name":"Domenico T.D."},{"name":"Fustero-Torre C."},{"name":"Gomez-Lo Pez G."},{"name":"Perales-Paton J."},{"name":"Pineiro-Yanez E."},{"name":"Tejero H."},{"name":"Valencia A."}],"citationCount":6,"date":"2019-11-01T00:00:00Z","journal":"Bioinformatics","title":"VulcanSpot: A tool to prioritize therapeutic vulnerabilities in cancer"},"pmcid":"PMC6853644","pmid":"31173067","type":["Primary"],"version":"v1.0.0b"}],"topic":[{"term":"Genetics","uri":"http://edamontology.org/topic_3053"},{"term":"Oncology","uri":"http://edamontology.org/topic_2640"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}],"validated":1},"bioschemas":{"name":"vulcanSpot","home":"https://bio.tools/vulcanSpot","license":"APL-1.0","version":"v1.0.0b","summary":"Tool to prioritize therapeutic vulnerabilities in cancer.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:vulcanspot/web/www.vulcanspot.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deploymen