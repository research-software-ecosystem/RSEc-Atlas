{"tool_name":"analyze-12.0","contents":["neubias"],"fetched_metadata":{"neubias":{"body":[{"format":"markdown","processed":"","summary":"","value":"Analyze 12.0 is a set of image processing, visualization and analysis tools that provides users access to a breadth of essential post-processing functions critical for innovative research. Analyze 12.0 provides users with all the key display, editing, processing, registration, and measurement tools needed to realize their research goals in a single multifaceted software package. Analyze 12.0 is open-ended, allowing for the application of its tools to novel and emerging research."}],"changed":[{"format":"Y-m-d\\TH:i:sP","value":"2018-05-14T20:16:23+00:00"}],"created":[{"format":"Y-m-d\\TH:i:sP","value":"2013-10-11T13:08:44+00:00"}],"default_langcode":[{"value":true}],"attribution_instructions":[],"comments_2023":[],"free_tagging":[{"target_id":4537,"target_type":"taxonomy_term","target_uuid":"f7c8d5f3-e400-4a76-b175-19edd06d4c15","url":"/taxonomy/term/4537"},{"target_id":4538,"target_type":"taxonomy_term","target_uuid":"ced8df7d-6ced-417d-afb5-fd8913328803","url":"/taxonomy/term/4538"},{"target_id":4539,"target_type":"taxonomy_term","target_uuid":"0fa9f482-b490-4fa9-a5f2-470fd756b9d1","url":"/taxonomy/term/4539"}],"give_feedback_on_this_soft":[{"cid":0,"comment_count":0,"last_comment_name":null,"last_comment_timestamp":1505206785,"last_comment_uid":164,"status":2}],"has_author":[],"has_biological_terms":[],"has_comparison":[],"has_documentation":[{"options":[],"title":"","uri":"https://analyzedirect.com/documents/training_guide/Analyze_Training_Guide.pdf"}],"has_doi":[],"has_entry_curator":[{"target_id":98,"target_type":"user","target_uuid":"2ae7ecac-ed23-4375-8a06-79f6a294e65b","url":"/user/98"}],"has_function":[],"has_implementation":[],"has_interaction_level":[{"target_id":3573,"target_type":"taxonomy_term","target_uuid":"43cf6a59-36ad-49c8-9baa-3c5494481f13","url":"/taxonomy/term/3573"}],"has_license":[],"has_location