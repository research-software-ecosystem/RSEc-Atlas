{"tool_name":"mango","contents":["biocontainers","oeb","biotools"],"fetched_metadata":{"biocontainers":{"name":"mango","identifiers":["biotools:mango","doi:10.1093/bioinformatics/btv336"],"license":"Apache-2.0","summary":"A scalable genomic visualization tool","home_url":"https://github.com/bdgenomics/mango","keywords":["Chromatin","Chromatin Immunoprecipitation","Humans","K562 Cells","Nucleic Acid Conformation","Sequence Analysis, DNA","Statistics as Topic","Statistics and probability","Structural genomics"],"manually_check":true,"total_pulls":0},"biotools":{"id":"mango","home":"https://github.com/dphansti/mango","summary":"Complete ChIA-PET (Chromatin Interaction Analysis by Paired-End Tag sequencing) data analysis pipeline that provides statistical confidence estimates for interactions and corrects for major sources of bias including differential peak enrichment and genomic proximity.","addition_date":"2017-08-03T18:50:36Z","last_update_date":"2018-12-10T12:58:51Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:mango","credit":[{"email":"dphansti@email.unc.edu","name":"PHANSTIEL LAB","typeEntity":"Person","typeRole":["Primary contact"],"url":"https://github.com/dphansti/mango"}],"documentation":[{"type":["General"],"url":"https://github.com/dphansti/mango/blob/master/README.rst"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Analysis","uri":"http://edamontology.org/operation_2945"}]},{"operation":[{"term":"Statistical calculation","uri":"http://edamontology.org/operation_2238"}]}],"name":"Mango","operating_system":["Linux","Mac"],"owner":"mbs_import","publication":[{"metadata":{"abstract":"\u00a9 The Author 2015.Motivation: Chromatin Interaction Analysis by Paired-End Tag sequencing (ChIA-PET) is an established method for detecting genome-wide looping interactions at high resolution. Current ChIA-PET analysis software packages either fail to correct for non-specific interactions due to genomic proximity or only address a fraction of the steps required for data processing. We present Mango, a complete ChIA-PET data analysis pipeline that provides statistical confidence estimates for interactions and corrects for major sources of bias including differential peak enrichment and genomic proximity. Results: Comparison to the existing software packages, ChIA-PET Tool and ChiaSig revealed that Mango interactions exhibit much better agreement with high-resolution Hi-C data. Importantly, Mango executes all steps required for processing ChIA-PET datasets, whereas ChiaSig only completes 20% of the required steps. Application of Mango to multiple available ChIA-PET datasets permitted the independent rediscovery of known trends in chromatin loops including enrichment of CTCF, RAD21, SMC3 and ZNF143 at the anchor regions of interactions and strong bias for convergent CTCF motifs.","authors":[{"name":"Boyle A.P."},{"name":"Heidari N."},{"name":"Phanstiel D.H."},{"name":"Snyder M.P."}],"citationCount":59,"date":"2015-10-01T00:00:00Z","journal":"Bioinformatics","title":"Mango: A bias-correcting ChIA-PET analysis pipeline"},"pmid":"26034063"}],"topic":[{"term":"Statistics and probability","uri":"http://edamontology.org/topic_2269"},{"term":"Structural genomics","uri":"http://edamontology.org/topic_0122"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mango/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":false,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":86,"citations":[{"count":3,"year":"2015"},{"count":3,"year":"2025"},{"count":3,"year":"2026"},{"count":5,"year":"2016"},{"count