{"tool_name":"bioconductor-fmrs","contents":["biotools","biocontainers","oeb"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-fmrs","identifiers":["doi:10.18129/b9.bioc.fmrs"],"license":"GPL (>= 3)","summary":"Provides parameter estimation as well as variable selection in Finite Mixture of Accelerated Failure Time Regression and Finite Mixture of Regression Models. Furthermore, this package provides Ridge Regression and Elastic Net.","home_url":"https://bioconductor.org/packages/3.12/bioc/html/fmrs.html","keywords":[],"manually_check":true,"total_pulls":484},"biotools":{"id":"bioconductor-fmrs","home":"https://bioconductor.org/packages/fmrs","license":"GPL-3.0","summary":"The package obtains parameter estimation, i.e., maximum likelihood estimators (MLE), via the Expectation-Maximization (EM) algorithm for the Finite Mixture of Regression (FMR) models with Normal distribution, and MLE for the Finite Mixture of Accelerated Failure Time Regression (FMAFTR) subject to right censoring with Log-Normal and Weibull distributions via the EM algorithm and the Newton-Raphson algorithm (for Weibull distribution). More importantly, the package obtains the maximum penalized likelihood (MPLE) for both FMR and FMAFTR models (collectively called FMRs). A component-wise tuning parameter selection based on a component-wise BIC is implemented in the package. Furthermore, this package provides Ridge Regression and Elastic Net.","addition_date":"2026-10-02T16:06:24.101252Z","last_update_date":"2026-10-02T16:06:24.103418Z","tool_type":["Command-line tool","Library"],"version":["1.22.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-fmrs","credit":[{"name":"Farhad Shokoohi","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/fmrs"}],"edit_permission":{"type":"private"},"name":"fmrs","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools"},"oeb":{"metri