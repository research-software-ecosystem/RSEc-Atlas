{"tool_name":"signalalign","contents":["oeb","bioschemas","debian","biotools"],"fetched_metadata":{"biotools":{"id":"signalalign","home":"https://github.com/ArtRand/signalAlign","license":"MIT","summary":"A method for detecting DNA methylation from nanopore MinION sequencing data.","addition_date":"2018-06-11T13:50:54Z","last_update_date":"2024-11-25T13:49:35.275539Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:signalalign","cost":"Free of charge","credit":[{"name":"Arthur C Rand","typeEntity":"Person","typeRole":["Primary contact"],"url":"https://github.com/ArtRand"}],"documentation":[{"type":["User manual"],"url":"https://github.com/ArtRand/signalAlign/blob/master/Manual.md"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Data reference","uri":"http://edamontology.org/data_2093"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]},{"data":{"term":"Sequence record","uri":"http://edamontology.org/data_0849"},"format":[{"term":"FASTA-like","uri":"http://edamontology.org/format_2546"}]}],"operation":[{"term":"Mapping","uri":"http://edamontology.org/operation_2429"},{"term":"Methylation analysis","uri":"http://edamontology.org/operation_3204"},{"term":"Statistical calculation","uri":"http://edamontology.org/operation_2238"}],"output":[{"data":{"term":"Report","uri":"http://edamontology.org/data_2048"}}]}],"maturity":"Mature","name":"signalAlign","operating_system":["Linux"],"owner":"ELIXIR-EE","publication":[{"doi":"10.1038/nmeth.4189","metadata":{"abstract":"DNA chemical modifcations regulate genomic function. We present a framework for mapping cytosine and adenosine methylation with the oxford nanopore technologies minion using this nanopore sequencers ionic current signal. We map three cytosine variants and two adenine variants. the results show that our model is sensitive enough to detect changes in genomic dna methylation levels as a function of growth phase in Escherichia coli.","authors":[{"name":"Akeson M."},{"name":"Eizenga J.M."},{"name":"Jain M."},{"name":"Musselman-Brown A."},{"name":"Olsen H.E."},{"name":"Paten B."},{"name":"Rand A.C."}],"citationCount":334,"date":"2017-02-20T00:00:00Z","journal":"Nature Methods","title":"Mapping DNA methylation with high-throughput nanopore sequencing"},"pmcid":"PMC5704956","pmid":"28218897"}],"topic":[{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"},{"term":"Statistics and probability","uri":"http://edamontology.org/topic_2269"}],"validated":1},"bioschemas":{"name":"signalAlign","home":"https://bio.tools/signalalign","license":"MIT","summary":"A method for detecting DNA methylation from nanopore MinION sequencing data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:signalalign/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":257,"citations":[{"count":1,"year":"-1"},{"count":1,"year":"2016"},{"count":9,"year":"2017"},{"count":14,"year":"2018"},{"count":18,"year":"2026"},{"count":20,"year":"2024"},{"count":29,"year":"2020"},{"count":29,"year":"2023"},{"count":30,"year":"2022"},{"count":32,"year":"2021"},{"count":34,"year":"2025"},{"count":40,"year":"2019"}],"doi":"10.1038/nmeth.4189","pmcid":"PMC5704956","pmid":"28218897","ref_count":22,"refs":[{"count":1,"year":"1992"},{"count":1,"year":"2007"},{"count":1,"year":"2008"},{"count":1,"year":"2010"},{"count":2,"year":"2009"},{"count":2,"year":"2012"},{"count":2,"year":"2014"},{"count":2,"year":"2016"},{"count":4,"year":"2013"},{"count":6,"year":"2015"}],"title":"Mapping DNA methylation with high-throughput nanopore sequencing.","year":2017}]}],"readme":false,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"email":false,"issue_tracking":{"public_tracker":null,"resolve_time":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/signalalign","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":null,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"publications":[],"readme":false,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}}]},"debian":{"package":"signalalign","distribution":"prospective","release":"vcs","component":"main","version":"0.0+git20170131.3293fad","source":"signalalign","homepage":"https://github.com/ArtRand/signalAlign","license":"MIT","blend":"debian-med","registries":[{"entry":"signalalign","name":"bio.tools"}],"descr":[{"package":"signalalign","description":"HMM-HDP models for MinION signal alignments","long_description":" MinION signal-level alignment and methylation detection using hidden\n Markov Models with hierarchical Dirichlet process kmer learning.\n .\n Nanopore sequencing is based on the principal of isolating a nanopore in\n a membrane separating buffered salt solutions, then applying a voltage\n across the membrane and monitoring the ionic current through the\n nanopore. The Oxford Nanopore Technologies (ONT) MinION sequences DNA by\n recording the ionic current as DNA strands are enzymatically guided\n through the nanopore. SignalAlign will align the ionic current from the\n MinION to a reference sequence using a trainable hidden Markov model\n (HMM). The emissions model for the HMM can either be the table of\n parametric normal distributions provided by ONT or a hierarchical\n Dirichlet process (HDP) mixture of normal distributions. The HDP models\n enable mapping of methylated bases to your reference sequence.","release":"vcs","license":"MIT","blend":"debian-med"}]}}}