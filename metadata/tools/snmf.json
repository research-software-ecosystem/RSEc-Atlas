{"tool_name":"snmf","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"snmf","identifiers":["biotools:snmf","doi:10.1534/genetics.113.160572"],"license":"GNU GPL v3","summary":"Fast and efficient program for estimating individual admixture coefficients based on sparse non-negative matrix factorization and population genetics","home_url":"http://membres-timc.imag.fr/Olivier.Francois/snmf/index.htm","keywords":["Computational Biology","Gene Frequency","Genetic Association Studies","Genetics, Population","Genotype","Humans","Likelihood Functions","Plants","Population Groups","Time Factors","Population genetics","Genetics"],"manually_check":true,"total_pulls":0},"biotools":{"id":"snmf","home":"http://membres-timc.imag.fr/Olivier.Francois/snmf/index.htm","license":"Not licensed","summary":"Fast and efficient program for estimating individual admixture coefficients based on sparse non-negative matrix factorization and population genetics.","addition_date":"2017-08-20T15:59:03Z","last_update_date":"2020-01-19T17:47:47Z","tool_type":["Command-line tool"],"collections":["Animal and Crop Genomics"],"biotools_curie":"biotools:snmf","credit":[{"email":"eric.frichot@imag.fr","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://membres-timc.imag.fr/Olivier.Francois/snmf/files/note.pdf"}],"edit_permission":{"authors":["animalandcropgenomics"],"type":"group"},"function":[{"operation":[{"term":"Genetic variation analysis","uri":"http://edamontology.org/operation_3197"}]}],"name":"sNMF","operating_system":["Linux","Mac"],"owner":"admin","publication":[{"doi":"10.1534/genetics.113.160572","metadata":{"abstract":"Inference of individual ancestry coefficients, which is important for population genetic and association studies, is commonly performed using computer-intensive likelihood algorithms. With the availability of large population genomic data sets, fast versions of likelihood algorithms have attracted considerable attention. Reducing the computational burden of estimation algorithms remains, however, a major challenge. Here, we present a fast and efficient method for estimating individual ancestry coefficients based on sparse nonnegative matrix factorization algorithms. We implemented our method in the computer program sNMF and applied it to human and plant data sets. The performances of sNMF were then compared to the likelihood algorithm implemented in the computer program ADMIXTURE. Without loss of accuracy, sNMF computed estimates of ancestry coefficients with runtimes 10-30 times shorter than those of ADMIXTURE. \u00a9 2014 by the Genetics Society of America.","authors":[{"name":"Bouchard G."},{"name":"Francois O."},{"name":"Frichot E."},{"name":"Mathieu F."},{"name":"Trouillon T."}],"citationCount":261,"date":"2014-01-01T00:00:00Z","journal":"Genetics","title":"Fast and efficient estimation of individual ancestry coefficients"},"pmcid":"PMC3982712","pmid":"24496008","type":["Primary"]}],"topic":[{"term":"Population genetics","uri":"http://edamontology.org/topic_3056"}],"validated":1},"bioschemas":{"name":"sNMF","home":"https://bio.tools/snmf","license":"Not licensed","summary":"Fast and efficient program for estimating individual admixture coefficients based on sparse non-negative matrix factorization and population genetics.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:snmf/cmd/membres-timc.imag.fr","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":370,"citations":[{"count":4,"year":"2014"},{"count":8,"year":"2015"},{"count":8,"year":"2016"},{"count":14,"year":"2017"},{"count":19,"year":"2018"},{"