{"tool_name":"scaanet","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"scaanet","home":"https://github.com/KrishnaswamyLab/AAnet","license":"Not licensed","summary":"Non-linear archetypal analysis of single-cell RNA-seq data by deep autoencoders.","addition_date":"2022-07-25T01:00:22.090582Z","last_update_date":"2024-11-24T15:53:20.012908Z","tool_type":["Script"],"accessibility":"Open access","biotools_curie":"biotools:scaanet","cost":"Free of charge","credit":[{"email":"hongyu.zhao@yale.edu","name":"Hongyu Zhao","orcidid":"https://orcid.org/0000-0003-1195-9607","typeEntity":"Person"},{"name":"Yuge Wang","orcidid":"https://orcid.org/0000-0001-7389-1519"}],"documentation":[{"type":["Quick start guide"],"url":"https://nbviewer.org/github/KrishnaswamyLab/AAnet/blob/master/notebooks/AAnet_tutorial_MNIST.ipynb"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Expression profile clustering","uri":"http://edamontology.org/operation_0313"},{"term":"Gene expression profiling","uri":"http://edamontology.org/operation_0314"}]}],"name":"scAAnet","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1371/journal.pcbi.1010025","metadata":{"abstract":"Advances in single-cell RNA sequencing (scRNA-seq) have led to successes in discovering novel cell types and understanding cellular heterogeneity among complex cell populations through cluster analysis. However, cluster analysis is not able to reveal continuous spectrum of states and underlying gene expression programs (GEPs) shared across cell types. We introduce scAAnet, an autoencoder for single-cell non-linear archetypal analysis, to identify GEPs and infer the relative activity of each GEP across cells. We use a count distribution- based loss term to account for the sparsity and overdispersion of the raw count data and add an archetypal constraint to the loss function of scAAnet. We first show that scAAnet outperforms existing methods for archetypal analysis across different metrics through simulations. We then demonstrate the ability of scAAnet to extract biologically meaningful GEPs using publicly available scRNA-seq datasets including a pancreatic islet dataset, a lung idiopathic pulmonary fibrosis dataset and a prefrontal cortex dataset.","authors":[{"name":"Wang Y."},{"name":"Zhao H."}],"citationCount":7,"date":"2022-04-01T00:00:00Z","journal":"PLoS Computational Biology","title":"Non-linear archetypal analysis of single-cell RNA-seq data by deep autoencoders"},"pmcid":"PMC9007392","pmid":"35363784"}],"topic":[{"term":"Exome sequencing","uri":"http://edamontology.org/topic_3676"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Mathematics","uri":"http://edamontology.org/topic_3315"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"bioschemas":{"name":"scAAnet","home":"https://bio.tools/scaanet","license":"Not licensed","summary":"Non-linear archetypal analysis of single-cell RNA-seq data by deep autoencoders.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:scaanet/script/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":13,"citations":[{"count":1,"year":"2022"},{"count":1,"year":"2024"},{"count":2,"year":"2026"},{"count":4,"year":"2025"},{"count":5,"year":"2023"}],"doi":"10.1371/journal.pcbi.1010025","pmcid":"PMC9007392","pmid":"35363784","ref_count":54,"refs":[{"count":1,"year":"1985"},{"count":1,"year":"1991"},{"count":1,"year":"1999"},{"count":1,"year":"2000"},{"count":1,"year":"2002"},{"count":1,"year":"2004"},{"count":1,"year":"2008"},{"count":1,"year":"2010"},{"count":1,"year":"2013"},{"count":1,"year":"2021"},{"count":2,"year":"2009"},{"count":3,"year":"2005"},{"count":4,"year":"2016"},{"count":4,"year":"2017"},{"count":7,"year":"2018"},{"count":7,"year":"2020"},{"count":8,"year":"2015"},{"count":9,"year":"2019"}],"title":"Non-linear archetypal analysis of single-cell RNA-seq data by deep autoencoders.","year":2022}]}],"readme":false,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/scaanet","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":null,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"publications":[],"readme":false,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}}]}}}