{"tool_name":"bioconductor-traviz","contents":["bioconductor","oeb"],"identifiers":["bioconductor:traviz"],"fetched_metadata":{"bioconductor":{"name":"traviz","version":"1.15.0","license":"MIT + file LICENSE","summary":"Trajectory functions for visualization and interpretation.","description":"traviz provides a suite of functions to plot trajectory related objects from Bioconductor packages. It allows plotting trajectories in reduced dimension, as well as averge gene expression smoothers as a function of pseudotime. Asides from general utility functions, traviz also allows plotting trajectories estimated by Slingshot, as well as smoothers estimated by tradeSeq. Furthermore, it allows for visualization of Slingshot trajectories using ggplot2.","author":"Hector Roux de Bezieux [aut, ctb], Kelly Street [aut, ctb], Koen Van den Berge [aut, cre]","maintainer":"Koen Van den Berge <koen.vdberge@gmail.com>","bioc_views":["GeneExpression","RNASeq","Sequencing","SingleCell","Software","Transcriptomics","Visualization"],"git_url":"https://git.bioconductor.org/packages/traviz","last_commit_date":"2025-04-15"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-traviz:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-traviz:1.4.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":