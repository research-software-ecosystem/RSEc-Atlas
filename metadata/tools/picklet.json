{"tool_name":"picklet","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"picklet","home":"https://fishka.bio/picklet","license":"Freeware","summary":"Browser-based tool to open almost any file that carries sequence \u2014 FASTA, FASTQ, GenBank, EMBL, Swiss-Prot, AB1/ABIF, SCF, Clustal, Stockholm, PHYLIP, NEXUS, MSF, PIR, MEGA, GFF3, SAM, BAM, GFA, PDB and ACE \u2014 see every sequence inside, pick the ones you want, and save them as FASTA. The format is detected from the file content, not from the extension, so unlabelled or misnamed files still open, and gzip-compressed files are unpacked in place. Records can be filtered by length, name, GC or sequence type, reverse-complemented, transcribed DNA\u2194RNA or translated to protein, deduplicated and reordered before saving. Runs entirely in the browser \u2014 files are never uploaded.","addition_date":"2026-07-11T21:51:46.808639Z","last_update_date":"2026-08-21T02:36:18.912394Z","tool_type":["Desktop application","Web application"],"collections":["fishka.bio"],"accessibility":"Open access","biotools_curie":"biotools:picklet","cost":"Free of charge","credit":[{"email":"swim@fishka.bio","name":"Fishka Bio","typeEntity":"Project","typeRole":["Developer","Maintainer","Primary contact"],"url":"https://fishka.bio"}],"documentation":[{"note":"Showcase gallery \u2014 an annotated screenshot per task, from opening an unlabelled file to filtering, translating and saving the picked records","type":["Training material"],"url":"https://fishka.bio/picklet/showcase"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Sequence record","uri":"http://edamontology.org/data_0849"},"format":[{"term":"AB1","uri":"http://edamontology.org/format_3000"},{"term":"ACE","uri":"http://edamontology.org/format_3001"},{"term":"BAM","uri":"http://edamontology.org/format_2572"},{"term":"ClustalW format","uri":"http://edamontology.org/format_1982"},{"term":"EMBL format","uri":"http://edamontology.org/format_1927"},{"term":"FASTA","uri":"http://edamontology.org/format_1929"},{"term":"FASTQ","uri":"http://edamontology.org/format_1930"},{"term":"GCG MSF","uri":"http://edamontology.org/format_1947"},{"term":"GFA 1","uri":"http://edamontology.org/format_3975"},{"term":"GFA 2","uri":"http://edamontology.org/format_3976"},{"term":"GFF3","uri":"http://edamontology.org/format_1975"},{"term":"GenBank format","uri":"http://edamontology.org/format_1936"},{"term":"Nexus format","uri":"http://edamontology.org/format_1912"},{"term":"PDB","uri":"http://edamontology.org/format_1476"},{"term":"PHYLIP format","uri":"http://edamontology.org/format_1997"},{"term":"SAM","uri":"http://edamontology.org/format_2573"},{"term":"SCF","uri":"http://edamontology.org/format_1632"},{"term":"Stockholm format","uri":"http://edamontology.org/format_1961"},{"term":"UniProtKB format","uri":"http://edamontology.org/format_1963"},{"term":"mega","uri":"http://edamontology.org/format_1991"},{"term":"nbrf/pir","uri":"http://edamontology.org/format_1948"}]}],"operation":[{"term":"DNA transcription","uri":"http://edamontology.org/operation_0372"},{"term":"DNA translation","uri":"http://edamontology.org/operation_0371"},{"term":"Data filtering","uri":"http://edamontology.org/operation_3695"},{"term":"Sequence conversion","uri":"http://edamontology.org/operation_0233"},{"term":"Sequence file editing","uri":"http://edamontology.org/operation_2121"}],"output":[{"data":{"term":"Protein sequence","uri":"http://edamontology.org/data_2976"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]},{"data":{"term":"Sequence set","uri":"http://edamontology.org/data_0850"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}]}],"maturity":"Mature","name":"picklet","operating_system":["Linux","Mac","Windows"],"owner":"fishka","publication":[{"doi":"10.5281/zenodo.21444547","note":"Software deposit (concept DOI \u2014 resolves to the latest version) covering the fishka.bio tools, including picklet.","type":["Other"],"version":"2026.07.19"}],"topic":[{"term":"Data management","uri":"http://edamontology.org/topic_3071"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}]},"bioschemas":{"name":"picklet","home":"https://bio.tools/picklet","license":"Freeware","summary":"Browser-based tool to open almost any file that carries sequence \u2014 FASTA, FASTQ, GenBank, EMBL, Swiss-Prot, AB1/ABIF, SCF, Clustal, Stockholm, PHYLIP, NEXUS, MSF, PIR, MEGA, GFF3, SAM, BAM, GFA, PDB and ACE \u2014 see every sequence inside, pick the ones you want, and save them as FASTA. The format is detected from the file content, not from the extension, so unlabelled or misnamed files still open, and gzip-compressed files are unpacked in place. Turns any of them into FASTA without a command line and without an account. Runs entirely in the browser \u2014 files are never uploaded.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:picklet/app/fishka.bio","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"training_material":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.5281/zenodo.21444547","ref_count":0,"refs":[]}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:picklet/web/fishka.bio","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"training_material":true},"license":{"open_source":false,"osi":false},"publications":