{"tool_name":"diffgr","contents":["biotools","oeb"],"identifiers":["biotools:diffgr"],"fetched_metadata":{"biotools":{"id":"diffgr","home":"https://github.com/wmalab/DiffGR","summary":"DiffGR is a statistical method for detecting differential genomic regions at TAD level between two Hi-C contact maps. Briefly, DiffGR utilizes the stratum-adjusted correlation coefficient (SCC), which can effectively eliminate the genomic-distance effect in Hi-C data, to measure the similarity of local genomic regions between two contact matrices, and then applies a nonparametric permutation test on those SCC values to detect genomic regions.","addition_date":"2021-01-18T10:57:04Z","last_update_date":"2026-11-12T14:35:33.012614Z","tool_type":["Library"],"biotools_curie":"biotools:diffgr","credit":[{"email":"wenxiu.ma@ucr.edu","name":"Wenxiu Ma","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Contact map calculation","uri":"http://edamontology.org/operation_0392"},{"term":"Mapping","uri":"http://edamontology.org/operation_2429"},{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"DiffGR","owner":"Kigaard","publication":[{"doi":"10.1093/gpbjnl/qzae028","type":["Primary"]},{"doi":"10.1101/2020.08.29.273698","type":["Preprint"]}],"topic":[{"term":"ChIP-seq","uri":"http://edamontology.org/topic_3169"},{"term":"Epigenomics","uri":"http://edamontology.org/topic_3173"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:diffgr/lib/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build