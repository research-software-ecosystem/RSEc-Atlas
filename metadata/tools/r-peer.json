{"tool_name":"r-peer","contents":["biocontainers","oeb"],"fetched_metadata":{"biocontainers":{"name":"r-peer","identifiers":[],"license":"GPL 2.0","summary":"PEER is a collection of Bayesian approaches to infer hidden determinants and their effects from gene expression profiles using factor analysis methods. Applications of PEER have (i) detected batch effects and experimental confounders (ii) increased the number of expression QTL findings by threefold and (iii) allowed inference of intermediate cellular traits, such as transcription factor or pathway activations. This project offers an efficient and versatile C++ implementation of the underlying algorithms with user-friendly interfaces to R and python. ","home_url":"https://github.com/PMBio/peer/","keywords":[],"manually_check":true,"total_pulls":3},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:r-peer:1.3/cmd/conda.anaconda.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":true,"source_packages":false,"sourcecode":{"free":null,"interpreted":null,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"readme":false,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://pypi.org/project/gdsctools/"},{"status":301,"url":"https://pypi.org/pypi/gdsctools"},{"status":301,"url":"https://pypi.org/pypi/gdsctools/"},{"status":301,"url":"https://pypi.python.org/pypi/gdsctools"}],"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/r-peer","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","p