tity":"Person","typeRole":["Contributor"]},{"name":"Sveinung Gundersen","orcidid":"https://orcid.org/0000-0001-9888-7954","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Victor Greiff","orcidid":"https://orcid.org/0000-0003-2622-5032","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Alexandre Almeida Costa","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Fabian L. M. Bernal","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Ivar Grytten","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Knut Rand","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Knut Waagan","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Nikolay Vazov","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Radmila Kompova","typeEntity":"Person","typeRole":["Contributor"]}],"documentation":[{"type":["Citation instructions","Command-line options","Contributions policy","General","Installation instructions","Release notes"],"url":"https://github.com/uio-bmi/immuneML/"},{"type":["General","Installation instructions","Quick start guide","Training material","User manual"],"url":"https://docs.immuneml.uio.no/latest/index.html"}],"edit_permission":{"authors":["eca008"],"type":"group"},"function":[{"input":[{"data":{"term":"Annotated text","uri":"http://edamontology.org/data_3779"},"format":[{"term":"YAML","uri":"http://edamontology.org/format_3750"}]},{"data":{"term":"Mathematical model","uri":"http://edamontology.org/data_0950"},"format":[{"term":"TSV","uri":"http://edamontology.org/format_3475"},{"term":"Workflow format","uri":"http://edamontology.org/format_2032"}]},{"data":{"term":"Resource metadata","uri":"http://edamontology.org/data_2337"},"format":[{"term":"CSV","uri":"http://edamontology.org/format_3752"}]},{"data":{"term":"Text data","uri":"http://edamontology.org/data_2526"},"format":[{"term":"NumPy format","uri":"http://edamontology.org/format_4003"},{"term":"YAML","uri":"http://edamontology.org/format_3750"}]}],"operation":[{"term":"Analysis","uri":"http://edamontology.org/operation_2945"},{"term":"Epitope mapping","uri":"http://edamontology.org/operation_0416"},{"term":"Modelling and simulation","uri":"http://edamontology.org/operation_2426"},{"term":"Peptide immunogenicity prediction","uri":"http://edamontology.org/operation_0252"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}],"output":[{"data":{"term":"Mathematical model","uri":"http://edamontology.org/data_0950"},"format":[{"term":"YAML","uri":"http://edamontology.org/format_3750"},{"term":"ZIP format","uri":"http://edamontology.org/format_3987"}]},{"data":{"term":"Report","uri":"http://edamontology.org/data_2048"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"}]}]}],"maturity":"Mature","name":"immuneML","operating_system":["Linux","Mac","Windows"],"owner":"Kigaard","publication":[{"doi":"10.1038/s42256-021-00413-z","metadata":{"abstract":"Adaptive immune receptor repertoires (AIRR) are key targets for biomedical research as they record past and ongoing adaptive immune responses. The capacity of machine learning (ML) to identify complex discriminative sequence patterns renders it an ideal approach for AIRR-based diagnostic and therapeutic discovery. So far, widespread adoption of AIRR ML has been inhibited by a lack of reproducibility, transparency and interoperability. immuneML (immuneml.uio.no) addresses these concerns by implementing each step of the AIRR ML process in an extensible, open-source software ecosystem that is based on fully specified and shareable workflows. To facilitate widespread user adoption, immuneML is available as a command-line tool and through an intuitive Galaxy web interface, and extensive documentation of workflows is provided. We demonstrate the broad applicability of immuneML by (1) reproducing a large-scale study on immune state prediction, (2) developing, integrating and applying a novel deep learning method for antigen specificity prediction and (3) showcasing streamlined interpretability-focused benchmarking of AIRR ML.","authors":[{"name":"Akbar R."},{"name":"Al Hajj G.S."},{"name":"Balaban G."},{"name":"Bernal F.L.M."},{"name":"Brusko T.M."},{"name":"Chernigovskaya M."},{"name":"Christley S."},{"name":"Corrie B."},{"name":"Costa A.A."},{"name":"Cowell L.G."},{"name":"Frank R."},{"name":"Greiff V."},{"name":"Grytten I."},{"name":"Gundersen S."},{"name":"Haff I.H."},{"name":"Hovig E."},{"name":"Hsieh P.-H."},{"name":"Kanduri C."},{"name":"Klambauer G."},{"name":"Kompova R."},{"name":"Kuijjer M.L."},{"name":"Lund-Andersen C."},{"name":"Martini A."},{"name":"Minotto T."},{"name":"Motwani K."},{"name":"Pavlovic M."},{"name":"Pensar J."},{"name":"Rand K."},{"name":"Riccardi E."},{"name":"Robert P.A."},{"name":"Rocha A."},{"name":"Sandve G.K."},{"name":"Scheffer L."},{"name":"Slabodkin A."},{"name":"Snapkov I."},{"name":"Sollid L.M."},{"name":"Titov D."},{"name":"Vazov N."},{"name":"Waagan K."},{"name":"Weber C.R."},{"name":"Widrich M."},{"name":"Yaari G."}],"citationCount":17,"date":"2021-11-01T00:00:00Z","journal":"Nature Machine Intelligence","title":"The immuneML ecosystem for machine learning analysis of adaptive immune receptor repertoires"},"pmcid":"PMC10312379","pmid":"37396030","type":["Primary"]}],"topic":[{"term":"Immunoinformatics","uri":"http://edamontology.org/topic_3948"},{"term":"Immunoproteins and antigens","uri":"http://edamontology.org/topic_2830"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Simulation experiment","uri":"http://edamontology.org/topic_3524"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]},"bioschemas":{"name":"immuneML","home":"https://bio.tools/immuneml","license":"AGPL-3.0","version":["1.1.2 - 1.1.4","1.2.0 - 1.2.5","2.0.0 - 2.0.6","2.1.0 - 2.1.2","2.2.0 - 2.2.5"],"summary":"immuneML is a flexible platform designed for machine learning-based analysis and classification of adaptive immune receptor repertoires (AIRR). The 