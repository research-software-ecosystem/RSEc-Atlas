{"tool_name":"lncrnasnp","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"lncrnasnp","home":"http://gong_lab.hzau.edu.cn/lncRNASNP3/","license":"Other","summary":"An database for functional variants in long non-coding RNAs.","addition_date":"2023-02-08T15:09:44.240118Z","last_update_date":"2024-11-24T15:04:31.552390Z","tool_type":["Database portal","Web application"],"version":["3.0"],"biotools_curie":"biotools:lncrnasnp","cost":"Free of charge","credit":[{"email":"gong.jing@mail.hzau.edu.cn","name":"Jing Gong","typeEntity":"Person"},{"email":"guoay@hust.edu.cn","name":"An-Yuan Guo","typeEntity":"Person"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"SNP annotation","uri":"http://edamontology.org/operation_3661"},{"term":"Variant effect prediction","uri":"http://edamontology.org/operation_0331"}]}],"name":"lncRNASNP","operating_system":["Linux","Mac","Windows"],"owner":"Chan019","publication":[{"doi":"10.1093/nar/gkac981","metadata":{"abstract":"Long non-coding RNAs (lncRNAs) act as versatile regulators of many biological processes and play vital roles in various diseases. lncRNASNP is dedicated to providing a comprehensive repository of single nucleotide polymorphisms (SNPs) and somatic mutations in lncRNAs and their impacts on lncRNA structure and function. Since the last release in 2018, there has been a huge increase in the number of variants and lncRNAs. Thus, we updated the lncRNASNP to version 3 by expanding the species to eight eukaryotic species (human, chimpanzee, pig, mouse, rat, chicken, zebrafish, and fruitfly), updating the data and adding several new features. SNPs in lncRNASNP have increased from 11 181 387 to 67 513 785. The human mutations have increased from 1 174 768 to 2 387 685, including 1 031 639 TCGA mutations and 1 356 046 CosmicNCVs. Compared with the last release, updated and new features in lncRNASNP v3 include (i) SNPs in lncRNAs and their impacts on lncRNAs for eight species, (ii) SNP effects on miRNA-lncRNA interactions for eight species, (iii) lncRNA expression profiles for six species, (iv) disease & GWAS-associated lncRNAs and variants, (v) experimental & predicted lncRNAs and drug target associations and (vi) SNP effects on lncRNA expression (eQTL) across tumor & normal tissues. The lncRNASNP v3 is freely available at http://gong-lab.hzau.edu.cn/lncRNASNP3/.","authors":[{"name":"Cao W."},{"name":"Gong J."},{"name":"Guo A.-Y."},{"name":"Luo H."},{"name":"Miao Y.-R."},{"name":"Wang D."},{"name":"Wu X."},{"name":"Yang J."},{"name":"Yang W."},{"name":"Yang Y."}],"citationCount":22,"date":"2023-01-06T00:00:00Z","journal":"Nucleic Acids Research","title":"lncRNASNP v3: an updated database for functional variants in long non-coding RNAs"},"pmcid":"PMC9825536","pmid":"36350671"}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}]},"bioschemas":{"name":"lncRNASNP","home":"https://bio.tools/lncrnasnp","license":"Other","version":"3.0","summary":"An database for functional variants in long non-coding RNAs.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:lncrnasnp:3.0/db/null","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":34,"citations":[{"count":6,"year":"2023"},{"count":6,"year":"2026"},{"count":9,"year":"2024"},{"count":13,"year":"2025"}],"doi":"10.1093/nar/gkac981","pmcid":"PMC9825536","pmid