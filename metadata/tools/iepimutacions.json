{"tool_name":"iepimutacions","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"iepimutacions","home":"https://bioconductor.org/packages/epimutacions","license":"MIT","summary":"The package includes some statistical outlier detection methods for epimutations detection in DNA methylation data. The methods included in the package are MANOVA, Multivariate linear models, isolation forest, robust mahalanobis distance, quantile and beta. The methods compare a case sample with a suspected disease against a reference panel (composed of healthy individuals) to identify epimutations in the given case sample. It also contains functions to annotate and visualize the identified epimutations.","addition_date":"2024-01-02T16:41:20.752854Z","last_update_date":"2026-09-06T01:56:07.375971Z","tool_type":["Library"],"version":["1.16.0"],"collections":["BioConductor"],"accessibility":"Open access","biotools_curie":"biotools:iepimutacions","cost":"Free of charge","credit":[{"name":"Carles Hernandez-Ferrer","typeEntity":"Person","typeRole":["Developer"]},{"name":"Carlos Ruiz-Arenas","typeEntity":"Person","typeRole":["Developer"]},{"name":"Dolors Pelegri-Siso","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Juan R. Gonzalez","typeEntity":"Person","typeRole":["Developer"]},{"name":"Leire Abarrategui","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/epimutacions"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Expression correlation analysis","uri":"http://edamontology.org/operation_3463"},{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"iepimutacions","owner":"Pub2Tools","publication":[{"doi":"10.1080/15592294.2023.2230670"}],"topic":