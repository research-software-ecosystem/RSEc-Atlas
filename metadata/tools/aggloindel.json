{"tool_name":"aggloindel","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"aggloindel","home":"http://bibiserv.cebitec.uni-bielefeld.de/agglodel","summary":"This tool to detect structural variations is specifically designed to cluster short-read paired-end data into possibly overlapping predictions for deletions and insertions. It does not make any assumptions on the composition of the data, such as the number of samples, heterogeneity or polyploidy. Taking paired ends mapped to a reference genome as input, it merges mappings to clusters based on a similarity score that takes both the putative location and size of an indel into account.","addition_date":"2016-01-20T09:50:50Z","last_update_date":"2024-11-25T15:40:27.566187Z","tool_type":["Command-line tool"],"version":["1"],"collections":["BiGi","de.NBI"],"biotools_curie":"biotools:aggloindel","cost":"Free of charge","credit":[{"email":"bibi-help@cebitec.uni-bielefeld.de","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"BiBiServ","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Bielefeld University","typeEntity":"Institute","typeRole":["Provider"]},{"name":"CeBiTec","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Maureen Smith","typeEntity":"Person","typeRole":["Developer"]},{"name":"Roland Wittler","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["General"],"url":"https://bibiserv.cebitec.uni-bielefeld.de/agglodel"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Genome map","uri":"http://edamontology.org/data_1288"},"format":[{"term":"BAM","uri":"http://edamontology.org/format_2572"}]}],"note":"Taking paired ends mapped to a reference genome as input, it iteratively merges mappings to clusters based on a similarity score that takes both the putative location and size of an indel into account","operation":[{"term":"Polymorphism detection","uri":"http://edamontology.org/operation_3202"},{"term":"S