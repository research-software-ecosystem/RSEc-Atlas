{"tool_name":"fl-qsar","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"fl-qsar","home":"https://github.com/bm2-lab/FL-QSAR","license":"Apache-2.0","summary":"FL-QSAR is a federated learning based QSAR prototype for collaborative drug discovery. FL-QSAR is an horizontal federated-learning based QSAR framework that enables clients to simulate the scenario of n clients with and without HFL(horizontal federated-learning). FL-QSAR is also a demo framework designed to help users better understanding the workflow and the underline mechanism of applying HFL for QSAR modeling. Meanwhile, FL-QSAR can be easily extended to other deep learning algorithms for solving various drug-related learning tasks.","addition_date":"2021-01-18T07:29:36Z","last_update_date":"2021-03-11T09:18:05Z","tool_type":["Command-line tool","Workbench"],"biotools_curie":"biotools:fl-qsar","credit":[{"email":"qiliu@tongji.edu.cn","name":"Qi Liu","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Network analysis","uri":"http://edamontology.org/operation_3927"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"},{"term":"Relation extraction","uri":"http://edamontology.org/operation_3625"}]}],"name":"FL-QSAR","owner":"Kigaard","publication":[{"doi":"10.1101/2020.02.27.950592"}],"topic":[{"term":"Drug development","uri":"http://edamontology.org/topic_3373"},{"term":"Drug discovery","uri":"http://edamontology.org/topic_3336"},{"term":"Drug metabolism","uri":"http://edamontology.org/topic_3375"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Pharmacology","uri":"http://edamontology.org/topic_0202"}]},"bioschemas":{"name":"FL-QSAR","home":"https://bio.tools/fl-qsar","license":"Apache-2.0","summary":"FL-QSAR is a federated learning based QSAR prototype for collaborative drug discovery. FL-QSAR is an horizontal federated-learning based QSAR framework that enables clients to simulate