{"tool_name":"mimir","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"mimir","home":"https://github.com/DanieleBizzarri/MiMIR","license":"GPL-3.0","summary":"R-shiny application to infer risk factors and endpoints from Nightingale Health's 1H-NMR Metabolomics data.","addition_date":"2022-09-05T22:38:19.112335Z","last_update_date":"2024-11-24T15:41:46.062415Z","tool_type":["Library"],"accessibility":"Open access","biotools_curie":"biotools:mimir","cost":"Free of charge","credit":[{"email":"e.b.van_den_akker@lumc.nl","name":"E B van den Akker","typeEntity":"Person"},{"name":"M Beekman"},{"name":"P E Slagboom"},{"name":"D Bizzarri","orcidid":"https://orcid.org/0000-0002-6881-273X"},{"name":"M J T Reinders","orcidid":"https://orcid.org/0000-0002-1148-1562"}],"documentation":[{"type":["User manual"],"url":"https://github.com/DanieleBizzarri/MiMIR/blob/main/man/MANUAL.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Imputation","uri":"http://edamontology.org/operation_3557"},{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"MiMIR","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1093/bioinformatics/btac388","metadata":{"abstract":"Motivation: 1H-NMR metabolomics is rapidly becoming a standard resource in large epidemiological studies to acquire metabolic profiles in large numbers of samples in a relatively low-priced and standardized manner. Concomitantly, metabolomics-based models are increasingly developed that capture disease risk or clinical risk factors. These developments raise the need for user-friendly toolbox to inspect new 1H-NMR metabolomics data and project a wide array of previously established risk models. Results: We present MiMIR (Metabolomics-based Models for Imputing Risk), a graphical user interface that provides an intuitive framework for ad hoc statistical analysis of Nightingale Health's 1H-NMR metabolomics data and allows for the projection and calibration of 24 pre-trained metabolomics-based models, without any pre-required programming knowledge.","authors":[{"name":"Beekman M."},{"name":"Bizzarri D."},{"name":"Reinders M.J.T."},{"name":"Slagboom P.E."},{"name":"Van Den Akker E.B."}],"citationCount":7,"date":"2022-08-01T00:00:00Z","journal":"Bioinformatics","title":"MiMIR: R-shiny application to infer risk factors and endpoints from Nightingale Health's 1H-NMR metabolomics data"},"pmcid":"PMC9344846","pmid":"35695757"}],"topic":[{"term":"Biobank","uri":"http://edamontology.org/topic_3337"},{"term":"Endocrinology and metabolism","uri":"http://edamontology.org/topic_3407"},{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"},{"term":"Public health and epidemiology","uri":"http://edamontology.org/topic_3305"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}],"validated":1},"bioschemas":{"name":"MiMIR","home":"https://bio.tools/mimir","license":"GPL-3.0","summary":"R-shiny application to infer risk factors and endpoints from Nightingale Health's 1H-NMR Metabolomics data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mimir/lib/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":12,"citations":[{"count":1,"year":"2026"},{"count":3,"year":"2023"},{"count":4,"year":"2024"},{"count":4,"year":"2025"}],"doi":"10.1093/bioinformatics/btac388","pmcid":"PMC9344846","pmid":"35695757","ref_count":8,"refs":[{"cou