{"tool_name":"colide","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"colide","home":"https://github.com/voracva1/CoLiDe","license":"MIT","summary":"CoLiDe is a Combinatorial Library Design tool for probing protein sequence space","addition_date":"2021-01-18T10:50:14Z","last_update_date":"2024-11-24T20:43:44.384645Z","tool_type":["Desktop application","Library"],"biotools_curie":"biotools:colide","credit":[{"email":"klara.hlouchova@natur.cuni.cz","name":"V\u00e1clav Vor\u00e1\u010dek","typeEntity":"Person"},{"email":"voracva1@fel.cvut.cz","name":"Kl\u00e1ra Hlouchov\u00e1","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"PCR primer design","uri":"http://edamontology.org/operation_0308"},{"term":"Scaffolding","uri":"http://edamontology.org/operation_3216"},{"term":"Sequence composition calculation","uri":"http://edamontology.org/operation_0236"}]}],"name":"CoLiDe","owner":"Kigaard","publication":[{"doi":"10.1093/bioinformatics/btaa804","metadata":{"abstract":"Motivation: Current techniques of protein engineering focus mostly on re-designing small targeted regions or defined structural scaffolds rather than constructing combinatorial libraries of versatile compositions and lengths. This is a missed opportunity because combinatorial libraries are emerging as a vital source of novel functional proteins and are of interest in diverse research areas. Results: Here, we present a computational tool for Combinatorial Library Design (CoLiDe) offering precise control over protein sequence composition, length and diversity. The algorithm uses evolutionary approach to provide solutions to combinatorial libraries of degenerate DNA templates. We demonstrate its performance and precision using four different input alphabet distribution on different sequence lengths. In addition, a model design and experimental pipeline for protein library expression and purification is presented, providing a proof-of-concept that our protocol can be used to prepare purified protein library samples of up to 1011-1012 unique sequences. CoLiDe presents a composition-centric approach to protein design towards different functional phenomena.","authors":[{"name":"Fujishima K."},{"name":"Hlouchova K."},{"name":"Soucek R."},{"name":"Tretyachenko V."},{"name":"Voracek V."}],"citationCount":5,"date":"2021-02-15T00:00:00Z","journal":"Bioinformatics","title":"CoLide: Combinatorial library design tool for probing protein sequence space"},"pmcid":"PMC8088326","pmid":"32956450"}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Probes and primers","uri":"http://edamontology.org/topic_0632"},{"term":"Protein expression","uri":"http://edamontology.org/topic_0108"},{"term":"Protein folding, stability and design","uri":"http://edamontology.org/topic_0130"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}]},"bioschemas":{"name":"CoLiDe","home":"https://bio.tools/colide","license":"MIT","summary":"CoLiDe is a Combinatorial Library Design tool for probing protein sequence space","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:colide/app/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":6,"citations":[{"count":1,"year":"2024"},{"count":2,"year":"2026"},{"count":3,"year":"2022"}],"doi":"10.1093/bioinformatics/btaa804","pmcid":"PMC8088326","pmid":"32956450","ref_count":34,"refs":[{"count":1,"year":"1990"},{"count":1,"year":"1997"},{"count":1,"year":"20