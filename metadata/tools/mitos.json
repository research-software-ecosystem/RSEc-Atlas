{"tool_name":"mitos","contents":["biocontainers","galaxy","bioschemas","biotools","oeb"],"fetched_metadata":{"biocontainers":{"name":"mitos","identifiers":["biotools:mitos","doi:10.1016/j.ympev.2012.08.023"],"license":"MIT","summary":"MITOS is a tool for the annotation of metazoan mitochondrial genomes.","home_url":"http://mitos.bioinf.uni-leipzig.de","keywords":["Animals","Computational Biology","Evolution, Molecular","Genome, Mitochondrial","Internet","Molecular Sequence Annotation","Phylogeny","Sequence Analysis, DNA","Zoology","Whole genome sequencing"],"manually_check":true,"total_pulls":14},"biotools":{"id":"mitos","home":"https://mitos.bioinf.uni-leipzig.de/index.py","summary":"De novo metazoan mitochondrial genome annotation.","addition_date":"2018-05-24T11:57:56Z","last_update_date":"2024-11-24T14:34:32.508183Z","tool_type":["Web application","Workflow"],"biotools_curie":"biotools:mitos","credit":[{"email":"mitos@bioinf.uni-leipzig.de","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General","Training material"],"url":"https://mitos.bioinf.uni-leipzig.de/help.py#example"}],"edit_permission":{"authors":["ELIXIR-CZ"],"type":"group"},"function":[{"input":[{"data":{"term":"Sequence set (nucleic acid)","uri":"http://edamontology.org/data_1234"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}],"operation":[{"term":"Genome annotation","uri":"http://edamontology.org/operation_0362"}],"output":[{"data":{"term":"Nucleic acid report","uri":"http://edamontology.org/data_2084"},"format":[{"term":"BED","uri":"http://edamontology.org/format_3003"},{"term":"FASTA","uri":"http://edamontology.org/format_1929"},{"term":"GFF","uri":"http://edamontology.org/format_2305"}]}]}],"name":"MITOS","owner":"aotamendi.1","publication":[{"doi":"10.1016/j.ympev.2012.08.023","metadata":{"abstract":"About 2000 completely sequenced mitochondrial genomes are available from the NCBI RefSeq data base together with manually curated annotations of their protein-coding genes, rRNAs, and tRNAs. This annotation information, which has accumulated over two decades, has been obtained with a diverse set of computational tools and annotation strategies. Despite all efforts of manual curation it is still plagued by misassignments of reading directions, erroneous gene names, and missing as well as false positive annotations in particular for the RNA genes. Taken together, this causes substantial problems for fully automatic pipelines that aim to use these data comprehensively for studies of animal phylogenetics and the molecular evolution of mitogenomes. The MITOS pipeline is designed to compute a consistent de novo annotation of the mitogenomic sequences. We show that the results of MITOS match RefSeq and MitoZoa in terms of annotation coverage and quality. At the same time we avoid biases, inconsistencies of nomenclature, and typos originating from manual curation strategies. The MITOS pipeline is accessible online at http://mitos.bioinf.uni-leipzig.de. \u00a9 2012 Elsevier Inc.","authors":[{"name":"Bernt M."},{"name":"Donath A."},{"name":"Externbrink F."},{"name":"Florentz C."},{"name":"Fritzsch G."},{"name":"Juhling F."},{"name":"Middendorf M."},{"name":"Putz J."},{"name":"Stadler P.F."}],"citationCount":3875,"date":"2013-11-01T00:00:00Z","journal":"Molecular Phylogenetics and Evolution","title":"MITOS: Improved de novo metazoan mitochondrial genome annotation"},"pmid":"22982435"}],"topic":[{"term":"Whole genome sequencing","uri":"http://edamontology.org/topic_3673"},{"term":"Zoology","uri":"http://edamontology.org/topic_3500"}],"validated":1},"bioschemas":{"name":"MITOS","home":"https://bio.tools/mitos","summary":"De novo metazoan mitochondrial genome annotation.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"@TOOL_VERSION@+galaxy@VERSION_SUFFIX@","first_commit":"2020-02-18","conda_name":"mitos","conda_version":"2.1.10","summary":"de-novo annotation of metazoan mitochondrial genomes","edam_o