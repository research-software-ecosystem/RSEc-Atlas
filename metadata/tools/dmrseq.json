{"tool_name":"dmrseq","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"dmrseq","home":"https://bioconductor.org/packages/dmrseq","license":"MIT","summary":"This package implements an approach for scanning the genome to detect and perform accurate inference on differentially methylated regions from Whole Genome Bisulfite Sequencing data. The method is based on comparing detected regions to a pooled null distribution, that can be implemented even when as few as two samples per population are available. Region-level statistics are obtained by fitting a generalized least squares (GLS) regression model with a nested autoregressive correlated error structure for the effect of interest on transformed methylation proportions.","addition_date":"2018-07-17T16:10:33Z","last_update_date":"2024-11-25T14:33:35.927904Z","tool_type":["Library"],"version":["1.32.0"],"collections":["BioConductor"],"biotools_curie":"biotools:dmrseq","cost":"Free of charge","credit":[{"name":"Keegan Korthauer","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Rafael Irizarry","typeEntity":"Person","typeRole":["Developer"]},{"name":"Sutirtha Chakraborty","typeEntity":"Person","typeRole":["Developer"]},{"name":"Yuval Benjamini","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/dmrseq"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Comparison","uri":"http://edamontology.org/operation_2424"}]},{"operation":[{"term":"Differentially-methylated region identification","uri":"http://edamontology.org/operation_3809"}]},{"operation":[{"term":"Regression analysis","uri":"http://edamontology.org/operation_3659"}]}],"name":"dmrseq","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[{"doi":"10.1093/biostatistics/kxy007"}],"topic":[{"term":"Epigenetics","uri":"http://edamontology.org/topic_3295"},{"term":"Functional genomics","uri":"h