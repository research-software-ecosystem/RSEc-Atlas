{"tool_name":"contedb","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"ConTEdb","home":"http://genedenovoweb.ticp.net:81/conTEdb/index.php","license":"Unlicense","summary":"Comprehensive database of transposable elements in conifers.","addition_date":"2019-08-11T12:41:43Z","last_update_date":"2020-06-16T10:55:24Z","tool_type":["Database portal","Web application"],"accessibility":"Open access","biotools_curie":"biotools:ConTEdb","cost":"Free of charge","credit":[{"email":"43853645@qq.com","name":"Fei Yi","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"fangqun163@163.com","name":"Fangqun Ouyang","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"wangjh808@sina.com","name":"Junhui Wang","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["FAQ"],"url":"http://genedenovoweb.ticp.net:81/conTEdb/help.php"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"De-novo assembly","uri":"http://edamontology.org/operation_0524"},{"term":"Deposition","uri":"http://edamontology.org/operation_3431"},{"term":"Scaffolding","uri":"http://edamontology.org/operation_3216"}]}],"maturity":"Mature","name":"ConTEdb","operating_system":["Linux","Mac","Windows"],"owner":"Ruta","publication":[{"doi":"10.1093/database/bay131","metadata":{"abstract":"\u00a9 The Author(s) 2018. Published by Oxford University Press.Conifers are the largest and most ubiquitous group of gymnosperms and have significant ecological significance and economic importance. However, the huge and complex genomes have hindered the sequencing and mining of conifer genomes. In this study, we identified 413 423 transposable elements (TEs) from Picea abies, Picea glauca and Pinus taeda using a combination of multiple approaches and classified them into 11 133 families. A comprehensive web-based database, ConTEdb, was constructed and served for researchers. ConTEdb enables users to browse, retrieve and download the TE sequences from the database. Several analysis tools are integrated into ConTEdb to help users mine the TE data easily and effectively. In summary, ConTEdb provides a platform to study TE biology and functional genomics in conifers.","authors":[{"name":"Ling J."},{"name":"Ouyang F."},{"name":"Wang J."},{"name":"Xiao Y."},{"name":"Yi F."},{"name":"Zhang H."}],"citationCount":6,"date":"2018-01-01T00:00:00Z","journal":"Database","title":"ConTEdb: A comprehensive database of transposable elements in conifers"},"pmcid":"PMC6301336","pmid":"30576494","type":["Primary"]}],"topic":[{"term":"Ecology","uri":"http://edamontology.org/topic_0610"},{"term":"Mobile genetic elements","uri":"http://edamontology.org/topic_0798"},{"term":"Plant biology","uri":"http://edamontology.org/topic_0780"}],"validated":1},"bioschemas":{"name":"ConTEdb","home":"https://bio.tools/ConTEdb","license":"Unlicense","summary":"Comprehensive database of transposable elements in conifers.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:contedb/db/genedenovoweb.ticp.net","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"faq":true},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":9,"citations":[{"count":1,"year":"2021"},{"count":1,"year":"2023"},{"count":2,"year":"2020"},{"count":2,"year":"2022"},{"count":3,"year":"2019"}],"doi":"10.1093/database/bay131","pmcid":"PMC6301336","pmid":"30576494","ref_count":29,"refs":[{"count":1,"year":"1985"},{"count":1,"year":"2000"},{"count":1,"year":"2001"},{"count":1,"year":"2002"},{"count":1,"year":"2006"},{"count":1,"year":"2011"},{"count":1,"year":"2015"},{"count":1,"year":"2017"},{"count":1,"year":"2018"},{"count":2,"year":"2004"},{"count":2,"year":"2007"},{"count":2,"year":"2010"},{"count":3,"year":"2009"},{"count":3,"year":"2013"},{"count":4,"year":"