{"tool_name":"daybook2","contents":["neubias"],"fetched_metadata":{"neubias":{"body":[{"format":"basic_html","processed":"<p>Daybook 2 is the analysis software linked to argoligth slides. It tests the performance of microscopes on various levels: illumination homogeneity, field distortion, lateral resolving power, stage drift, chromatic aberrations, intensity response... It&nbsp;works with various file formats but requires the use of an argolight test slide.&nbsp;</p>","summary":"","value":"<p>Daybook 2 is the analysis software linked to argoligth slides. It tests the performance of microscopes on various levels: illumination homogeneity, field distortion, lateral resolving power, stage drift, chromatic aberrations, intensity response... It&nbsp;works with various file formats but requires the use of an argolight test slide.&nbsp;</p>\r\n"}],"changed":[{"format":"Y-m-d\\TH:i:sP","value":"2019-02-05T11:17:51+00:00"}],"created":[{"format":"Y-m-d\\TH:i:sP","value":"2019-02-03T11:29:24+00:00"}],"default_langcode":[{"value":true}],"attribution_instructions":[],"comments_2023":[],"free_tagging":[{"target_id":4830,"target_type":"taxonomy_term","target_uuid":"bc50ea74-55cf-4616-9cc7-3b8b2a3e88dd","url":"/taxonomy/term/4830"},{"target_id":4831,"target_type":"taxonomy_term","target_uuid":"5f9ee21e-c0e7-464d-90ba-7f7e427cc39c","url":"/taxonomy/term/4831"},{"target_id":4826,"target_type":"taxonomy_term","target_uuid":"6e0577a8-e223-48fc-b01c-9f7e62c8dd01","url":"/taxonomy/term/4826"}],"give_feedback_on_this_soft":[{"cid":0,"comment_count":0,"last_comment_name":null,"last_comment_timestamp":1549193727,"last_comment_uid":43,"status":2}],"has_author":[{"value":"Argolight"}],"has_biological_terms":[],"has_comparison":[],"has_documentation":[],"has_doi":[],"has_entry_curator":[{"target_id":43,"target_type":"user","target_uuid":"49079edf-8326-4a2f-b550-21827d985cc7","url":"/user/43"}],"has_function":[],"has_implementation":[{"target_id":4341,"target_type":"taxonomy_term","target_uuid