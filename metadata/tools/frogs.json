{"tool_name":"frogs","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"frogs","identifiers":["biotools:frogs","doi:10.1093/bioinformatics/btx791"],"license":"GNU General Public License v3.0","summary":"Frogs is a workflow designed to produce an otus count matrix from high depth sequencing amplicon data. this is the official release 3.1.0 of frogs.","home_url":"https://github.com/geraldinepascal/FROGS","keywords":["Bacteria","Cluster Analysis","Metagenomics","Microbial ecology","Taxonomy","Evolutionary biology","Sequencing","Clustering"],"manually_check":true,"total_pulls":0},"biotools":{"id":"frogs","home":"http://frogs.toulouse.inra.fr/","license":"GPL-3.0","summary":"The user-friendly and Galaxy-supported pipeline FROGS analyses large sets of DNA amplicons sequences accurately and rapidly, essential for microbe community studies.","addition_date":"2018-06-24T10:38:07Z","last_update_date":"2024-11-24T20:07:18.846597Z","tool_type":["Command-line tool"],"version":["4.0.0"],"collections":["FROGS"],"biotools_curie":"biotools:frogs","credit":[{"email":"geraldine.pascal@inrae.fr","name":"G\u00e9raldine Pascal","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/geraldinepascal/FROGS"}],"edit_permission":{"authors":["olivierrue"],"type":"group"},"function":[{"operation":[{"term":"Taxonomic classification","uri":"http://edamontology.org/operation_3460"}]}],"name":"FROGS","operating_system":["Linux"],"owner":"olivierrue","publication":[{"doi":"10.1093/bib/bbab318","metadata":{"abstract":"Fungi are present in all environments. They fulfil important ecological functions and play a crucial role in the food industry. Their accurate characterization is thus indispensable, particularly through metabarcoding. The most frequently used markers to monitor fungi are ITSs. These markers are the best documented in public databases but have one main weakness: polymerase chain reaction amplification may produce non-overlapping reads in a significant fraction of the fungi. When these reads are filtered out, traditional metabarcoding pipelines lose part of the information and consequently produce biased pictures of the composition and structure of the environment under study. We developed a solution that enables processing of the entire set of reads including both overlapping and non-overlapping, thus providing a more accurate picture of fungal communities. Our comparative tests using simulated and real data demonstrated the effectiveness of our solution, which can be used by both experts and non-specialists on a command line or through the Galaxy-based web interface.","authors":[{"name":"Bernard M."},{"name":"Mariadassou M."},{"name":"Pascal G."},{"name":"RuCrossed D signCopyright O."}],"citationCount":20,"date":"2021-11-01T00:00:00Z","journal":"Briefings in Bioinformatics","title":"FROGS: a powerful tool to analyse the diversity of fungi with special management of internal transcribed spacers"},"pmid":"34410336","type":["Primary"]},{"doi":"10.1093/bioinformatics/btx791","metadata":{"abstract":"Motivation Metagenomics leads to major advances in microbial ecology and biologists need user friendly tools to analyze their data on their own. Results This Galaxy-supported pipeline, called FROGS, is designed to analyze large sets of amplicon sequences and produce abundance tables of Operational Taxonomic Units (OTUs) and their taxonomic affiliation. The clustering uses Swarm. The chimera removal uses VSEARCH, combined with original cross-sample validation. The taxonomic affiliation returns an innovative multi-affiliation output to highlight databases conflicts and uncertainties. Statistical results and numerous graphical illustrations are produced along the way to monitor the pipeline. FROGS was tested for the detection and quantification of OTUs on real and in silico datasets and proved to be rapid, robust and highly sensitive. It compares favorably with the widespread mothur, UPARSE and QIIME.","authors":[{"name":"Auer L."},{"name":"Bernard M."},{"name":"Cauquil L."},{"name":"Combes S."},{"name":"Escudie F."},{"name":"Hernandez-Raquet G."},{"name":"Maman S."},{"name":"Mariadassou M."},{"name":"Pascal G."},{"name":"Vidal K."}],"citationCount":557,"date":"2018-04-15T00:00:00Z","journal":"Bioinformatics","title":"FROGS: Find, Rapidly, OTUs with Galaxy Solution"},"pmid":"29228191","type":["Primary"]}],"topic":[{"term":"Evolutionary biology","uri":"http://edamontology.org/topic_3299"},{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Microbial ecology","uri":"http://edamontology.org/topic_3697"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"},{"term":"Taxonomy","uri":"http://edamontology.org/topic_0637"}],"validated":1},"bioschemas":{"name":"FROGS","home":"https://bio.tools/frogs","license":"GPL-3.0","version":"4.0.0","summary":"The user-friendly and Galaxy-supported pipeline FROGS analyses large sets of DNA amplicons sequences accurately and rapidly, essential for microbe community studies.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:frogs/cmd/frogs.toulouse.inra.fr","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":364,"citations":[{"count":1,"year":"2017"},{"count":2,"year":"-1"},{"count":17,"year":"2018"},{"count":17,"year":"2026"},{"count":25,"year":"2019"},{"count":46,"year":"2025"},{"count":48,"year":"2020"},{"count":48,"year":"2023"},