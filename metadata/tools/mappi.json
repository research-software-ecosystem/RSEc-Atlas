{"tool_name":"mappi","contents":["biotools"],"identifiers":["biotools:mappi"],"fetched_metadata":{"biotools":{"id":"mappi","home":"https://github.com/micropolimi/MAPPI","summary":"MAPPI (MAcro Plant Projection Imaging) is an open-source, low-cost, modular fluorescence imaging platform combining custom hardware and ScopeFoundry-based control software for real-time, wide-field, dual-projection imaging of fluorescent reporters in whole soil-grown plants, validated by tracking calcium and L-glutamate dynamics in adult Nicotiana benthamiana.","addition_date":"2026-11-04T09:52:53.620089Z","last_update_date":"2026-11-04T09:52:53.623317Z","biotools_curie":"biotools:mappi","credit":[{"email":"alex.costa@unimi.it","name":"Alex Costa","orcidid":"https://orcid.org/0000-0002-2628-1176","typeEntity":"Person"},{"email":"andrea1.bassi@polimi.it","name":"Andrea Bassi","orcidid":"https://orcid.org/0000-0002-5017-0775","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Image analysis","uri":"http://edamontology.org/operation_3443"}]}],"name":"MAPPI","owner":"pub2tools2024","publication":[{"doi":"10.1126/SCIADV.AEA4466","pmcid":"PMC12829558","pmid":"41576153"}],"topic":[{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"},{"term":"Plant biology","uri":"http://edamontology.org/topic_0780"}]}}}