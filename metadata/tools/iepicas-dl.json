{"tool_name":"iepicas-dl","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"iepicas-dl","home":"http://www.sunlab.fun:3838/EpiCas-DL","license":"Not licensed","summary":"Predicting sgRNA activity for CRISPR-mediated epigenome editing by deep learning.","addition_date":"2023-02-24T22:50:49.392176Z","last_update_date":"2023-02-24T22:50:49.394720Z","tool_type":["Command-line tool","Web application"],"accessibility":"Open access","biotools_curie":"biotools:iepicas-dl","cost":"Free of charge","credit":[{"email":"ydsun@ion.ac.cn","name":"Yidi Sun","typeEntity":"Person"},{"email":"zuoerwei@caas.cn","name":"Erwei Zuo","typeEntity":"Person"},{"name":"Juan Meng"},{"name":"Lei Ma"},{"name":"Leilei Wu"},{"name":"Qianqian Yang"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Sequence","uri":"http://edamontology.org/data_2044"}}],"operation":[{"term":"Editing","uri":"http://edamontology.org/operation_3096"},{"term":"PTM site prediction","uri":"http://edamontology.org/operation_0417"},{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"iEpiCas-DL","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1016/J.CSBJ.2022.11.034","metadata":{"abstract":"\u00a9 2022 The AuthorsCRISPR-mediated epigenome editing enables gene expression regulation without changing the underlying DNA sequence, and thus has vast potential for basic research and gene therapy. Effective selection of a single guide RNA (sgRNA) with high on-target efficiency and specificity would facilitate the application of epigenome editing tools. Here we performed an extensive analysis of CRISPR-mediated epigenome editing tools on thousands of experimentally examined on-target sites and established EpiCas-DL, a deep learning framework to optimize sgRNA design for gene silencing or activation. EpiCas-DL achieves high accuracy in sgRNA activity prediction for targeted gene silencing or activation and outperforms other available in silico methods. In addition, EpiCas-DL also identifies both epigenetic and sequence features that affect sgRNA efficacy in gene silencing and activation, facilitating the application of epigenome editing for research and therapy. EpiCas-DL is available at http://www.sunlab.fun:3838/EpiCas-DL.","authors":[{"name":"Ma L."},{"name":"Meng J."},{"name":"Sun Y."},{"name":"Wu L."},{"name":"Yang Q."},{"name":"Zuo E."}],"date":"2023-01-01T00:00:00Z","journal":"Computational and Structural Biotechnology Journal","title":"EpiCas-DL: Predicting sgRNA activity for CRISPR-mediated epigenome editing by deep learning"},"pmcid":"PMC9763632","pmid":"36582444"}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Epigenomics","uri":"http://edamontology.org/topic_3173"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Methylated DNA immunoprecipitation","uri":"http://edamontology.org/topic_3674"}]},"bioschemas":{"name":"iEpiCas-DL","home":"https://bio.tools/iepicas-dl","license":"Not licensed","summary":"Predicting sgRNA activity for CRISPR-mediated epigenome editing by deep learning.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:iepicas-dl/cmd/www.sunlab.fun","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":12,"citations":[{"count":1,"year":"2026"},{"count":2,"year":"2023"},{"count":2,"year":"2024"},{"count":7,"year":"2025"}],"doi":"10.1016/j.csbj.2022.11.034","pmcid":"PMC9763632","pmid":"36582444","ref_count":46,"refs":[{"count":1,"year":"2012"},{"count":1,"year":"2017"},{"count":1,"year":"202