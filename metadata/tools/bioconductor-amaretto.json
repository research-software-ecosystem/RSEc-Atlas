{"tool_name":"bioconductor-amaretto","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-amaretto","identifiers":["doi:10.18129/b9.bioc.amaretto"],"license":"Apache License (== 2.0)","summary":"Regulatory Network Inference and Driver Gene Evaluation using Integrative Multi-Omics Analysis and Penalized Regression","home_url":"https://bioconductor.org/packages/3.9/bioc/html/AMARETTO.html","keywords":["Clustering","Gene Expression"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-amaretto","home":"https://bioconductor.org/packages/AMARETTO","license":"Apache-2.0","summary":"Integrating an increasing number of available multi-omics cancer data remains one of the main challenges to improve our understanding of cancer. One of the main challenges is using multi-omics data for identifying novel cancer driver genes. We have developed an algorithm, called AMARETTO, that integrates copy number, DNA methylation and gene expression data to identify a set of driver genes by analyzing cancer samples and connects them to clusters of co-expressed genes, which we define as modules. We applied AMARETTO in a pancancer setting to identify cancer driver genes and their modules on multiple cancer sites. AMARETTO captures modules enriched in angiogenesis, cell cycle and EMT, and modules that accurately predict survival and molecular subtypes. This allows AMARETTO to identify novel cancer driver genes directing canonical cancer pathways.","tool_type":["Command-line tool","Library"],"version":["1.28.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-amaretto","credit":[{"name":"Celine Everaert"},{"name":"Jayendra Shinde"},{"name":"Jishu Xu"},{"name":"Mohsen Nabian"},{"name":"Nathalie Pochet and Olivier Gevaert"},{"name":"Shaimaa Bakr"},{"name":"Vincent Carey"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/AMARETTO"}],"name":"AMARETTO","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.18129/B9.bioc.AMARETTO"}]},"bioschemas":{"name":"AMARETTO","home":"https://bio.tools/bioconductor-amaretto","license":"Apache-2.0","version":"1.28.0","summary":"Integrating an increasing number of available multi-omics cancer data remains one of the main challenges to improve our understanding of cancer. One of the main challenges is using multi-omics data for identifying novel cancer driver genes. We have developed an algorithm, called AMARETTO, that integrates copy number, DNA methylation and gene expression data to identify a set of driver genes by analyzing cancer samples and connects them to clusters of co-expressed genes, which we define as modules. We applied AMARETTO in a pancancer setting to identify cancer driver genes and their modules on multiple cancer sites. AMARETTO captures modules enriched in angiogenesis, cell cycle and EMT, and modules that accurately predict survival and molecular subtypes. This allows AMARETTO to identify novel cancer driver genes directing canonical cancer pathways.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-amaretto:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-amaretto:1.1.1/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"os