{"tool_name":"satchmo-js","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"satchmo-js","home":"http://phylogenomics.berkeley.edu/software","summary":"Web server for simultaneous estimation of protein multiple sequence alignments and phylogenetic trees. Input is a FASTA file of sequences, and output is a phylogenetic tree and multiple sequence alignment.","addition_date":"2017-03-25T12:40:52Z","last_update_date":"2024-11-24T21:04:12.264735Z","tool_type":["Web application"],"accessibility":"Open access","biotools_curie":"biotools:satchmo-js","cost":"Free of charge","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Multiple sequence alignment","uri":"http://edamontology.org/operation_0492"},{"term":"Phylogenetic tree generation","uri":"http://edamontology.org/operation_0323"},{"term":"Sequence alignment","uri":"http://edamontology.org/operation_0292"},{"term":"Tree-based sequence alignment","uri":"http://edamontology.org/operation_0499"}]}],"maturity":"Mature","name":"SATCHMO-JS","owner":"ELIXIR-EE","publication":[{"doi":"10.1093/nar/gkq298","metadata":{"abstract":"We present the jump-start simultaneous alignment and tree construction using hidden Markov models (SATCHMO-JS) web server for simultaneous estimation of protein multiple sequence alignments (MSAs) and phylogenetic trees. The server takes as input a set of sequences in FASTA format, and outputs a phylogenetic tree and MSA; these can be viewed online or downloaded from the website. SATCHMO-JS is an extension of the SATCHMO algorithm, and employs a divide-and-conquer strategy to jump-start SATCHMO at a higher point in the phylogenetic tree, reducing the computational complexity of the progressive all-versus-all HMM-HMM scoring and alignment. Results on a benchmark dataset of 983 structurally aligned pairs from the PREFAB benchmark dataset show that SATCHMO-JS provides a statistically significant improvement in alignment accuracy over MUSCLE, Multiple Alignment using Fast Fourier Transform (MAFFT), ClustalW and the original SATCHMO algorithm. The SATCHMO-JS webserver is available at http://phylogenomics.berkeley.edu/satchmo-js. The datasets used in these experiments are available for download at http://phylogenomics.berkeley.edu/satchmo-js/supplementary/. \u00a9 The Author(s) 2010. Published by Oxford University Press.","authors":[{"name":"Datta R.S."},{"name":"Davidson J.R."},{"name":"Hagopian R."},{"name":"Jarvis G.R."},{"name":"Samad B."},{"name":"Sjolander K."}],"citationCount":24,"date":"2010-04-29T00:00:00Z","journal":"Nucleic Acids Research","title":"SATCHMO-JS: A webserver for simultaneous protein multiple sequence alignment and phylogenetic tree construction"},"pmcid":"PMC2896197","pmid":"20430824"}],"topic":[{"term":"Phylogenetics","uri":"http://edamontology.org/topic_3293"},{"term":"Phylogeny","uri":"http://edamontology.org/topic_0084"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"bioschemas":{"name":"SATCHMO-JS","home":"https://bio.tools/satchmo-js","summary":"Web server for simultaneous estimation of protein multiple sequence alignments and phylogenetic trees. Input is a FASTA file of sequences, and output is a phylogenetic tree and multiple sequence alignment.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:satchmo-js/web/phylogenomics.berkeley.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"packages":true,"source_packages":true,"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":17,"citations":[{"count":1,"year":"2024"},{"count":2,"year":"2014"},{"count":2,"year":"2016"},{"count":2,"year":"2021"},{"count":3,"year":"2011"},{"count":3,"year":"2013"},{"count":4,"year":"2012"}],"doi":"10.109