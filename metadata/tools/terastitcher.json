ct":{"build":{},"deployment":{},"publications":[],"readme":false,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":200,"ssl":null,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}}]},"neubias":{"body":[{"format":"basic_html","processed":"<p>TeraStitcher is a free tool that enables the stitching of Teravoxel-sized tiled microscopy images even on workstations with relatively limited resources of memory (&lt;8 GB) and processing power. It exploits the knowledge of approximate tile positions and uses ad-hoc strategies and algorithms designed for such very large datasets. The produced images can be saved into a multiresolution representation to be efficiently visualized (e.g. <a href=\"https://github.com/abria/TeraStitcher/wiki/Vaa3D-TeraFly\">Vaa3D-TeraFly</a>) and processed.</p>","summary":"","value":"<p>TeraStitcher is a free tool that enables the stitching of Teravoxel-sized tiled microscopy images even on workstations with relatively limited resources of memory (&lt;8 GB) and processing power. It exploits the knowledge of approximate tile positions and uses ad-hoc strategies and algorithms designed for such very large datasets. The produced images can be saved into a multiresolution representation to be efficiently visualized (e.g. <a href=\"https://github.com/abria/TeraStitcher/wiki/Vaa3D-TeraFly\">Vaa3D-TeraFly</a>) and processed.</p>\r\n"}],"changed":[{"format":"Y-m-d\\TH:i:sP","value":"2018-01-30T08:49:39+00:00"}],"created":[{"format":"Y-m-d\\TH:i:sP","value":"2018-01-30T08:40:05+00:00"}],"default_langcode":[{"value":true}],"attribution_instructions":[],"comments_2023":[],"free_tagging":[],"give_feedback_on_this_soft":[{"cid":0,"comment_count":0,"last_comment_name":null,"last_comment_timestamp":1517302179,"last_comment_uid":280,"status":2}],"has_author":[{"value":"Bria Alessandro"},{"value":"Iannello Giulio"},{"value":"Onofri Leonardo"}],"has_biologic