"},{"count":1,"year":"2025"},{"count":1,"year":"2026"},{"count":2,"year":"2017"},{"count":2,"year":"2019"},{"count":2,"year":"2020"},{"count":3,"year":"2016"},{"count":3,"year":"2022"},{"count":6,"year":"2021"},{"count":7,"year":"2023"}],"doi":"10.1093/bioinformatics/btv576","pmid":"26446133","ref_count":0,"refs":[],"title":"SIMToolbox: a MATLAB toolbox for structured illumination fluorescence microscopy.","year":2015}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://simtoolbox.github.io/"}],"ssl":true,"ssl_err":null}},"support":{"email":true}},{"@id":"https://openebench.bsc.es/monitor/metrics/simtoolbox","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://simtoolbox.github.io/"}],"ssl":true,"ssl_err":null}}}]},"neubias":{"body":[{"format":"basic_html","processed":"<p>SIMToolbox: a MATLAB toolbox for structured illumination microscopy SIMToolbox is an open-source, modular set of functions for MATLAB designed for processing data acquired by structured illumination microscopy. Both optical sectioning and super-resolution applications are supported. The software is also capable of maximum a posteriori probability image estimation (MAP-SIM), an alternative method for reconstruction of structured illumination images. MAP-SIM can potentially reduce reconstruction artifacts, which commonly occur due to refractive index mismatch within the sample and to imperfections in the illumination. 2665</p>","summary":"","value":"<p>SIMToolbox: a MATLAB toolbox for structured illumination microscopy SIMToolbox is an open-source, modular set of functions for MATLAB designed for processing data acquired by structured illumination microscopy. Both optical sectioning and super-resolution applications are supported. The software is also capable of maximum a posteriori probability image estimation (MAP-SIM), an alternative method for reconstruction of structured illumination images. MAP-SIM can potentially reduce reconstruction artifacts, which commonly occur due to refractive index mismatch within the sample and to imperfections in the illumination. 2665</p>\r\n"}],"changed":[{"format":"Y-m-d\\TH:i:sP","value":"2018-11-26T08:30:04+00:00"}],"created":[{"format":"Y-m-d\\TH:i:sP","value":"2016-10-01T18:10:22+00:00"}],"default_langcode":[{"value":true}],"attribution_instructions":[],"comments_2023":[],"free_tagging":[],"give_feedback_on_this_soft":[{"cid":0,"comment_count":0,"last_comment_name":null,"last_comment_timestamp":1505204850,"last_comment_uid":164,"status":2}],"has_author":[{"value":"Krizek Pavel"},{"value":"Lukes Tom\u00e1s "},{"value":"Ovesn\u00fd Martin"},{"value":"Fliegel Karel "},{"value":"Hagen Guy M. "}],"has_biological_terms":[],"has_comparison":[],"has_documentation":[],"has_doi":[],"has_entry_curator":[{"target_id":42,"target_type":"user","target_uuid":"a924b827-fe88-49fb-80d9-9d19042c7aec","url":"/user/42"}],"has_function":[{"target_id":4032,"target_type":"taxonomy_term","target_uuid":"http://edamontology.org/operation_Image_reconstruction","url":"/image-reconstruction"},{"target_id":4050,"target_type":"taxonomy_term","target_uuid":"http://edamontology.org/operation__R8V95OnTjs7fCvVXWjaXrh6","url":"/structured-illumination-reconstruction"},{"target_id":4053,"target_type":"taxonomy_term","target_uuid":"http://edamontology.org/operation_Image_processing","url":"/image-processing"}],"has_implementation":[],"has_interaction_level":[{"target_id":3574,"target_type":"taxonomy_term","target_uuid":"a22a3a50-0fbb-41ee-944a-38e0b86ac077","url":"/taxonomy/term/3574"}],"has_license":[{"value":"GPL"}],"has_location":[{"options":[],"title":"","uri":"http://mmtg.fel.cvut.cz