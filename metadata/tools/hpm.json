{"tool_name":"hpm","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"hpm","home":"http://www.cs.helsinki.fi/group/genetics/hpm.html","summary":"HPM (Haplotype Pattern Mining) is a program for gene mapping in case-control haplotype data.","addition_date":"2017-12-18T00:07:27Z","last_update_date":"2019-01-17T12:41:58Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:hpm","credit":[{"email":"juha.kere@biosci.ki.se","name":"Juha Kere","orcidid":"https://orcid.org/0000-0003-1974-0271","typeEntity":"Person","typeRole":["Primary contact"]},{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.cs.helsinki.fi/group/genetics/Group.html"}],"documentation":[{"type":["General"],"url":"https://www.cs.helsinki.fi/group/genetics/hpm.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Analysis","uri":"http://edamontology.org/operation_2945"}]},{"operation":[{"term":"Mapping","uri":"http://edamontology.org/operation_2429"}]}],"name":"HPM","operating_system":["Linux","Mac","Windows"],"owner":"mbs_import","publication":[{"doi":"10.1126/science.1090010","metadata":{"abstract":"Susceptibility to asthma depends on variation at an unknown number of genetic loci. To identify susceptibility genes on chromosome 7p, we adopted a hierarchical genotyping design, leading to the identification of a 133-kilobase risk-conferring segment containing two genes. One of these coded for an orphan G protein-coupled receptor named GPRA (G protein-coupled receptor for asthma susceptibility), which showed distinct distribution of protein isoforms between bronchial biopsies from healthy and asthmatic individuals. In three cohorts from Finland and Canada, single nucleotide polymorphism-tagged haplotypes associated with high serum immunoglobulin E or asthma. The murine ortholog of GPRA was up-regulated in a mouse model of ovalbumin-induced inflammation. Together, these data implicate GPRA in the pathogenesis of atopy and asthma.","authors":[{"name":"Alenius H."},{"name":"Gullsten H."},{"name":"Haahtela T."},{"name":"Hudson T.J."},{"name":"Kere J."},{"name":"Laitinen A."},{"name":"Laitinen L.A."},{"name":"Laitinen T."},{"name":"Laprise C."},{"name":"Leino M."},{"name":"Makela S."},{"name":"Petays T."},{"name":"Pirskanen A."},{"name":"Polvi A."},{"name":"Pulkkinen V."},{"name":"Rautanen A."},{"name":"Rehn M."},{"name":"Rydman P."},{"name":"Salmikangas P."},{"name":"Vendelin J."},{"name":"Zucchelli M."}],"citationCount":373,"date":"2004-04-09T00:00:00Z","journal":"Science","title":"Characterization of a Common Susceptibility Locus for Asthma-Related Traits"},"pmid":"15073379","type":["Primary"]}],"topic":[{"term":"Genetics","uri":"http://edamontology.org/topic_3053"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"}],"validated":1},"bioschemas":{"name":"HPM","home":"https://bio.tools/hpm","summary":"HPM (Haplotype Pattern Mining) is a program for gene mapping in case-control haplotype data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:hpm/cmd/www.cs.helsinki.fi","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":127,"citations":[{"count":1,"year":"-1"},{"count":1,"year":"2020"},{"count":2,"year":"2018"},{"count":2,"year":"2023"},{"count":2,"year":"2024"},{"count":2,"year":"2026"},{"count":3,"year":"2014"},{"count":3,"year":"2019"},{"count":3,"year":"2022"},{"count":4,"year":"2012"},{"count":4,"year":"2016"},{"count":4,"year":"2017"},{"count":5,"year":"2015"},{"count":6,"year":"2007"},{"count":7,"year":"2021"},{"count":8,"year":"2009"},{"count":8,"year":"2013"},{"count":11,"year":"2008"},{"count":11,"year":"2011"},{"count":12,"year":"2005"},{"count":14,"year":"2006"},{"count":14,"year"