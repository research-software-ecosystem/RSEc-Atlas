{"tool_name":"bioconductor-veloviz","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-veloviz","home":"https://bioconductor.org/packages/veloviz","license":"GPL-3.0","summary":"VeloViz uses each cell\u2019s current observed and predicted future transcriptional states inferred from RNA velocity analysis to build a nearest neighbor graph between cells in the population. Edges are then pruned based on a cosine correlation threshold and/or a distance threshold and the resulting graph is visualized using a force-directed graph layout algorithm. VeloViz can help ensure that relationships between cell states are reflected in the 2D embedding, allowing for more reliable representation of underlying cellular trajectories.","tool_type":["Command-line tool","Library"],"version":["1.18.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-veloviz","credit":[{"name":"Arpan Sahoo","typeEntity":"Person","typeRole":["Developer"]},{"name":"Jean Fan","typeEntity":"Person","typeRole":["Developer"]},{"name":"Lyla Atta","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/veloviz"}],"name":"veloviz","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-veloviz:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-veloviz:1.4.0/cmd/bioconductor.org","@license":"https://creativecommons