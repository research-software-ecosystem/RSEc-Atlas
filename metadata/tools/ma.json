{"tool_name":"ma","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"ma","identifiers":["biotools:ma","doi:10.1007/s00335-015-9596-5"],"license":"MIT","summary":"MA - The Modular Aligner","home_url":"https://github.com/ITBE-Lab/MA","keywords":["Animals","Computational Biology","Databases, Genetic","Embryo, Mammalian","Embryonic Development","Gene Expression Regulation, Developmental","Internet","Mice","Gene expression"],"manually_check":true,"total_pulls":0},"biotools":{"id":"ma","home":"http://www.emouseatlas.org/emap/home.html","summary":"Comprehensive online resource to visualise mouse development and investigate gene expression in the mouse embryo.","addition_date":"2015-08-03T09:36:05Z","last_update_date":"2024-11-24T20:31:06.464357Z","tool_type":["Web service"],"version":["1"],"biotools_curie":"biotools:ma","credit":[{"name":"BioCatalogue","typeEntity":"Project","typeRole":["Documentor"],"url":"https://www.biocatalogue.org"},{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.emouseatlas.org/emap/help/contact.html"}],"documentation":[{"type":["General"],"url":"http://www.emouseatlas.org/axis2/services/listServices"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Data retrieval","uri":"http://edamontology.org/operation_2422"},{"term":"Gene expression analysis","uri":"http://edamontology.org/operation_2495"}]}],"name":"ma","operating_system":["Linux","Mac","Windows"],"owner":"BioCatalogue","publication":[{"doi":"10.1007/s00335-015-9596-5","metadata":{"abstract":"A significant proportion of developmental biology data is presented in the form of images at morphologically diverse stages of development. The curation of these datasets presents different challenges to that of sequence/text-based data. Towards this end, the eMouseAtlas project created a digital atlas of mouse embryo development as a means of understanding developmental anatomy and exploring the relationship between genes and development in a spatial context. Using the morphological staging system pioneered by Karl Theiler, the project has generated 3D models of post-implantation mouse development and used them as a spatial framework for the delineation of anatomical components and for archiving in situ gene expression data in the EMAGE database. This has allowed us to develop a unique online resource for mouse developmental biology. We describe here the underlying structure of the resource, as well as some of the tools that have been developed to allow users to mine the curated image data. These tools include our IIP3D/X3DOM viewer that allows 3D visualisation of anatomy and/or gene expression in the context of a web browser, and the eHistology resource that extends this functionality to allow visualisation of high-resolution cellular level images of histology sections. Furthermore, we review some of the informatics aspects of eMouseAtlas to provide a deeper insight into the use of the atlas and gene expression database.","authors":[{"name":"Armit C."},{"name":"Baldock R.A."},{"name":"Hill B."},{"name":"Richardson L."},{"name":"Yang Y."}],"citationCount":16,"date":"2015-10-01T00:00:00Z","journal":"Mammalian Genome","title":"eMouseAtlas informatics: embryo atlas and gene expression database"},"pmcid":"PMC4602050","pmid":"26296321","type":["Primary"]}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"}],"validated":1},"bioschemas":{"name":"ma","home":"https://bio.tools/ma","version":"1","summary":"Comprehensive online resource to visualise mouse development and investigate gene expression in the mouse embryo.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ma:1/soap/www.emouseatlas.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publi