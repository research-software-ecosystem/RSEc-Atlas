{"tool_name":"generxcluster","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-generxcluster","version":"1.46.0","home":"https://bioconductor.org/packages/3.22/bioc/html/geneRxCluster.html","license":"GPL (>= 2)","summary":"gRx Differential Clustering","identifiers":["biotools:generxcluster"],"description":"Detect Differential Clustering of Genomic Sites such as gene therapy integrations.  The package provides some functions for exploring genomic insertion sites originating from two different sources. Possibly, the two sources are two different gene therapy vectors.  Vectors are preferred that target sensitive regions less frequently, motivating the search for localized clusters of insertions and comparison of the clusters formed by integration of different vectors.  Scan statistics allow the discovery of spatial differences in clustering and calculation of False Discovery Rates (FDRs) providing statistical methods for comparing retroviral vectors. A scan statistic for comparing two vectors using multiple window widths to detect clustering differentials and compute FDRs is implemented here.","license_file":"/lib/R/share/licenses/GPL-3","build":{"number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"build":[null,"make"],"host":["bioconductor-genomicranges >=1.62.0,<1.63.0","bioconductor-iranges >=2.44.0,<2.45.0","r-base","libblas","liblapack","zlib","liblzma-devel"],"run":["bioconductor-genomicranges >=1.62.0,<1.63.0","bioconductor-iranges >=2.44.0,<2.45.0","r-base"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/geneRxCluster_1.46.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/geneRxCluster/geneRxCluster_1.46.0.tar.gz","https://bioarchive.galaxyproject.org/geneRxCluster_1.46.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-generxcluster/bioconductor-generxcluster_1.46.0_src_all.tar.gz"],"test":{"commands":["$R -e \"libra