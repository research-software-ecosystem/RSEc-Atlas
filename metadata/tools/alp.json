{"tool_name":"alp","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"alp","home":"http://www.ncbi.nlm.nih.gov/CBBresearch/Spouge/html_ncbi/html/software/program.html?uid=6","summary":"This program calculates the statistical parameters in the modified Gumbel distribution for BLAST","addition_date":"2017-08-03T18:35:43Z","last_update_date":"2024-11-25T14:18:09.801535Z","tool_type":["Desktop application"],"collections":["BLAST utility"],"biotools_curie":"biotools:alp","credit":[{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.ncbi.nlm.nih.gov/CBBresearch/Spouge/html_ncbi/html/index/group.html"}],"documentation":[{"type":["General"],"url":"https://www.ncbi.nlm.nih.gov/CBBresearch/Spouge/html_ncbi/html/bib/alp_lib_v1_93.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Statistical calculation","uri":"http://edamontology.org/operation_2238"}]}],"name":"ALP","operating_system":["Linux","Windows"],"owner":"mbs_import","publication":[{"doi":"10.1093/bioinformatics/btv575","metadata":{"abstract":"Motivation: Pairwise local alignment is an indispensable tool for molecular biologists. In real time (i.e. in about 1 s), ALP (Ascending Ladder Program) calculates the E-values for protein-protein or DNA-DNA local alignments of random sequences, for arbitrary substitution score matrix, gap costs and letter abundances; and FALP (Frameshift Ascending Ladder Program) performs a similar task, although more slowly, for frameshifting DNA-protein alignments. Availability and implementation: To permit other C++ programmers to implement the computational efficiencies in ALP and FALP directly within their own programs, C++ source codes are available in the public domain at http://go.usa.gov/3GTSW under 'ALP' and 'FALP', along with the standalone programs ALP and FALP. Contact: Supplementary information: Supplementary data are available at Bioinformatics online.","authors":[{"name":"Frith M.C."},{"name":"Park Y."},{"name":"Sheetlin S."},{"name":"Spouge J.L."}],"citationCount":5,"date":"2016-01-15T00:00:00Z","journal":"Bioinformatics","title":"ALP & FALP: C++ libraries for pairwise local alignment E-values"},"pmcid":"PMC4739181","pmid":"26428291"}],"topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Nucleic acid structure analysis","uri":"http://edamontology.org/topic_0097"},{"term":"Statistics and probability","uri":"http://edamontology.org/topic_2269"}],"validated":1},"bioschemas":{"name":"ALP","home":"https://bio.tools/alp","summary":"This program calculates the statistical parameters in the modified Gumbel distribution for BLAST","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:alp/app/www.ncbi.nlm.nih.gov","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":3,"citations":[{"count":1,"year":"2016"},{"count":1,"year":"2018"},{"count":1,"year":"2020"}],"doi":"10.1093/bioinformatics/btv575","pmcid":"PMC4739181","pmid":"26428291","ref_count":21,"refs":[{"count":1,"year":"1990"},{"count":1,"year":"2001"},{"count":1,"year":"2002"},{"count":1,"year":"2008"},{"count":1,"year":"2013"},{"count":1,"year":"2015"},{"count":2,"year":"2005"},{"count":2,"year":"2009"},{"count":2,"year":"2010"},{"count":2,"year":"2012"},{"count":3,"year":"2011"},{"count":4,"year":"2014"}],"title":"ALP & FALP: C++ libraries for pairwise local alignment E-values.","year":2015}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":404,"redirects":[{"status":301,"url":"https://www.ncbi.nlm.nih.gov:443/CBBresearch/Spouge/html_ncbi/html/software/program.html?uid=6"}],"ssl":true,"ssl_err":null}},"support":{"email":false}},{"@id":"https://openebench.bsc.es/monitor/metrics/alp","