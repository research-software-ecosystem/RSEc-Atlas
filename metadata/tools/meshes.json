{"tool_name":"meshes","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-meshes","version":"1.36.0","home":"https://bioconductor.org/packages/3.22/bioc/html/meshes.html","license":"Artistic-2.0","summary":"MeSH Enrichment and Semantic analyses","identifiers":["biotools:meshes","doi:10.1038/nmeth.3252"],"description":"MeSH (Medical Subject Headings) is the NLM controlled vocabulary used to manually index articles for MEDLINE/PubMed. MeSH terms were associated by Entrez Gene ID by three methods, gendoo, gene2pubmed and RBBH. This association is fundamental for enrichment and semantic analyses. meshes supports enrichment analysis (over-representation and gene set enrichment analysis) of gene list or whole expression profile. The semantic comparisons of MeSH terms provide quantitative ways to compute similarities between genes and gene groups. meshes implemented five methods proposed by Resnik, Schlicker, Jiang, Lin and Wang respectively and supports more than 70 species.","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-annotationdbi >=1.72.0,<1.73.0","bioconductor-annotationhub >=4.0.0,<4.1.0","bioconductor-dose >=4.4.0,<4.5.0","bioconductor-enrichplot >=1.30.0,<1.31.0","bioconductor-gosemsim >=2.36.0,<2.37.0","bioconductor-meshdbi >=1.46.0,<1.47.0","r-base","r-yulab.utils >=0.1.5"],"run":["bioconductor-annotationdbi >=1.72.0,<1.73.0","bioconductor-annotationhub >=4.0.0,<4.1.0","bioconductor-dose >=4.4.0,<4.5.0","bioconductor-enrichplot >=1.30.0,<1.31.0","bioconductor-gosemsim >=2.36.0,<2.37.0","bioconductor-meshdbi >=1.46.0,<1.47.0","r-base","r-yulab.utils >=0.1.5"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/meshes_1.36.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/meshes/meshes_1.36.0.tar.gz","https://bioarchive.galaxyproject.org/meshes_1.36.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-meshes/bioconductor-meshes_1.36.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('meshes')\""]},"parent_recipe":{"name":"bioconductor-meshes","path":"recipes/bioconductor-meshes","version":"1.6.1"}},"biotools":{"id":"meshes","home":"https://bioconductor.org/packages/meshes","license":"Artistic-2.0","summary":"MeSH (Medical Subject Headings) is the NLM controlled vocabulary used to manually index articles for MEDLINE/PubMed. MeSH terms were associated by Entrez Gene ID by three methods, gendoo, gene2pubmed and RBBH. This association is fundamental for enrichment and semantic analyses. meshes supports enrichment analysis (over-representation and gene set enrichment analysis) of gene list or whole expression profile. The semantic comparisons of MeSH terms provide quantitative ways to compute similarities between genes and gene groups. meshes implemented five methods proposed by Resnik, Schlicker, Jiang, Lin and Wang respectively and supports more than 70 species.","addition_date":"2017-01-17T14:56:16Z","last_update_date":"2026-08-30T02:22:29.834379Z","tool_type":["Command-line tool","Library"],"version":["1.38.0"],"collections":["BioConductor"],"biotools_curie":"biotools:meshes","credit":[{"name":"Guangchuang Yu","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/meshes"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Indexing","uri":"http://edamontology.org/operation_0227"}]}],"name":"meshes","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1093/bioinformatics/bty410"}],"topic":[{"term":"Biomedical science","uri":"http://edamontology.org/topic_3344"},{"term":"Literature and language","uri":"http://edamontology.org/topic_3068"}],"validated":1},"bioschemas":{"name":"meshes","home":"https://bio.tools/meshes","license":"Artistic-2.0","version":"1.38.0","summary":"MeSH (