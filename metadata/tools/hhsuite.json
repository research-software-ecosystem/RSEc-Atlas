{"tool_name":"hhsuite","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"hhsuite","identifiers":[],"license":"GPL-3.0+","summary":"Sensitive protein sequence searching based on hmm-hmm alignment","home_url":"https://toolkit.tuebingen.mpg.de/","keywords":[],"manually_check":true,"total_pulls":5393},"biotools":{"id":"hhsuite","home":"https://github.com/soedinglab/hh-suite","license":"GPL-3.0","summary":"HH-suite is a remote protein homology detection suite.","addition_date":"2022-03-21T09:58:57.345333Z","last_update_date":"2024-11-24T20:10:54.257975Z","tool_type":["Suite"],"accessibility":"Open access","biotools_curie":"biotools:hhsuite","cost":"Free of charge","credit":[{"email":"soeding@mpibpc.mpg.de","name":"Johannes S\u00f6ding","orcidid":"https://orcid.org/0000-0001-9642-8244","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/soedinglab/hh-suite/wiki"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Protein folding analysis","uri":"http://edamontology.org/operation_2415"},{"term":"Sequence analysis","uri":"http://edamontology.org/operation_2403"},{"term":"Sequence similarity search","uri":"http://edamontology.org/operation_0346"}]}],"name":"HH-suite","owner":"Kigaard","publication":[{"doi":"10.1186/s12859-019-3019-7","metadata":{"abstract":"Background: HH-suite is a widely used open source software suite for sensitive sequence similarity searches and protein fold recognition. It is based on pairwise alignment of profile Hidden Markov models (HMMs), which represent multiple sequence alignments of homologous proteins. Results: We developed a single-instruction multiple-data (SIMD) vectorized implementation of the Viterbi algorithm for profile HMM alignment and introduced various other speed-ups. These accelerated the search methods HHsearch by a factor 4 and HHblits by a factor 2 over the previous version 2.0.16. HHblits3 is 10\u00d7 faster than PSI-BLAST and 20\u00d7 faster than HMMER3. Jobs to perform HHsearch and HHblits searches with many query profile HMMs can be parallelized over cores and over cluster servers using OpenMP and message passing interface (MPI). The free, open-source, GPLv3-licensed software is available at https://github.com/soedinglab/hh-suite. Conclusion: The added functionalities and increased speed of HHsearch and HHblits should facilitate their use in large-scale protein structure and function prediction, e.g. in metagenomics and genomics projects.","authors":[{"name":"Haunsberger S.J."},{"name":"Meier M."},{"name":"Mirdita M."},{"name":"Soding J."},{"name":"Steinegger M."},{"name":"Vohringer H."}],"citationCount":588,"date":"2019-09-14T00:00:00Z","journal":"BMC Bioinformatics","title":"HH-suite3 for fast remote homology detection and deep protein annotation"},"pmcid":"PMC6744700","pmid":"31521110","type":["Primary"]}],"topic":[{"term":"Proteins","uri":"http://edamontology.org/topic_0078"}]},"bioschemas":{"name":"HH-suite","home":"https://bio.tools/hhsuite","license":"GPL-3.0","summary":"HH-suite is a remote protein homology detection suite.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:hhsuite/suite/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":599,"citations":[{"count":1,"year":"-1"},{"count":3,"year":"2019"},{"count":32,"year":"2020"},{"count":55,"year":"2026"},{"count":89,"year":"2021"},{"count":89,"year":"2022"},{"co