{"tool_name":"artem","contents":["bioschemas","biotools","oeb"],"identifiers":["biotools:artem"],"fetched_metadata":{"biotools":{"id":"artem","home":"https://github.com/david-bogdan-r/ARTEM","license":"Apache-2.0","summary":"ARTEM is a tool for the superposition of two arbitrary RNA 3D structure fragments.\nARTEM doesn\u2019t rely on sequence similarity, annotated interactions, or backbone topology. Instead, ARTEM assumes at least one residue-residue match has a close-to-zero RMSD in the ideal superposition. Then, ARTEM tries all N*M single-residue matches and derives a subset of mutually closest residues as the matches for each of the single-residue-based superpositions. Finally, ARTEM returns the superpositions ordered by their size, letting the user choose the best one based on any specific requirements. ARTEM can read/write both PDB and mmCIF format.","addition_date":"2023-09-04T12:19:37.685404Z","last_update_date":"2026-11-12T14:41:19.059132Z","tool_type":["Command-line tool","Script"],"version":["version 2.0"],"collections":["3D-BioInfo-Nucleic-Acid"],"accessibility":"Open access","biotools_curie":"biotools:artem","cost":"Free of charge","credit":[{"email":"bogdan.d@phystech.edu","name":"Davyd Bohdan","orcidid":"https://orcid.org/0000-0002-6456-6658","typeRole":["Developer"]}],"documentation":[{"note":"README file","type":["User manual"],"url":"https://github.com/david-bogdan-r/ARTEM/blob/main/README.md"}],"edit_permission":{"type":"private"},"function":[{"cmd":"python3 artem.py r=FILENAME q=FILENAME [OPTIONS]","input":[{"data":{"term":"RNA structure","uri":"http://edamontology.org/data_1465"},"format":[{"term":"PDB","uri":"http://edamontology.org/format_1476"},{"term":"mmCIF","uri":"http://edamontology.org/format_1477"}]}],"operation":[{"term":"Local structure alignment","uri":"http://edamontology.org/operation_0509"},{"term":"Pairwise structure alignment","uri":"http://edamontology.org/operation_0503"}],"output":[{"data":{"term":"RNA structure alignment","uri":"http://edamontology.org/data_1493"},"format":[{"term":"PDB","uri":"http://edamontology.org/format_1476"},{"term":"mmCIF","uri":"http://edamontology.org/format_1477"}]}]}],"maturity":"Mature","name":"ARTEM","operating_system":["Linux","Mac","Windows"],"owner":"febos","publication":[{"doi":"10.1186/s13059-025-03696-2"},{"doi":"10.1093/nar/gkad605","pmcid":"PMC10484739","pmid":"37471030","type":["Primary"]},{"doi":"10.1101/2024.05.31.596898","type":["Preprint"]}],"topic":[{"term":"Computational biology","uri":"http://edamontology.org/topic_3307"},{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"Nucleic acid sites, features and motifs","uri":"http://edamontology.org/topic_3511"},{"term":"Nucleic acid structure analysis","uri":"http://edamontology.org/topic_0097"},{"term":"Nucleic acids","uri":"http://edamontology.org/topic_0077"},{"term":"RNA","uri":"http://edamontology.org/topic_0099"}]},"bioschemas":{"name":"ARTEM","home":"https://bio.tools/artem","license":"Apache-2.0","version":"version 2.0","summary":"ARTEM is a tool for the superposition of two arbitrary RNA 3D structure fragments.\nARTEM doesn\u2019t rely on sequence similarity, annotated interactions, or backbone topology. Instead, ARTEM assumes at least one residue-residue match has a close-to-zero RMSD in the ideal superposition. Then, ARTEM tries all N*M single-residue matches and derives a subset of mutually closest residues as the matches for each of the single-residue-based superpositions. Finally, ARTEM returns the superpositions ordered by their size, letting the user choose the best one based on any specific requirements. ARTEM can read/write both PDB and mmCIF format.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:artem/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type"