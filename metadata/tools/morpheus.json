{"tool_name":"morpheus","contents":["biocontainers","galaxy","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"morpheus","version":"290","home":"https://github.com/cwenger/Morpheus/","documentation":"https://cwenger.github.io/Morpheus/","license":"MIT","summary":"mass spectrometry\u2013based proteomics database search algorithm","identifiers":["doi:10.1021/pr301024c","biotools:morpheus"],"license_file":"MIT_License.CommandLine.txt","build":{"number":0,"run_exports":[null],"script":"mkdir -p $PREFIX/bin && cp * $PREFIX/bin && cd $PREFIX/bin && ln -s ./morpheus_mzml_mono_cl.exe ./morpheus && chmod +x $PREFIX/bin/morpheus*","skip":true},"requirements":{"run":["mono >=4.0.0"]},"source_url":"https://github.com/cwenger/Morpheus/releases/download/r290/Morpheus_mzML_Mono.tar.gz","test":{"commands":["mono `which morpheus` | grep 'mzML Mono command line'"]}},"biocontainers":{"name":"morpheus","identifiers":["biotools:morpheus","doi:10.1021/pr301024c"],"license":"MIT","summary":"mass spectrometry\u2013based proteomics database search algorithm","home_url":"https://github.com/cwenger/Morpheus/","keywords":["Chromatography, Liquid","Escherichia coli Proteins","Humans","Proteomics","Saccharomyces cerevisiae Proteins","Mass Spectrometry","Mass spectrometry"],"manually_check":true,"total_pulls":5},"biotools":{"id":"morpheus","home":"https://cwenger.github.io/Morpheus/","license":"MIT","summary":"A proteomics search algorithm specifically designed for high-resolution tandem mass spectra.","addition_date":"2018-03-14T22:10:20Z","last_update_date":"2024-11-25T14:13:59.350810Z","tool_type":["Command-line tool"],"collections":["Proteomics"],"biotools_curie":"biotools:morpheus","credit":[{"email":"craig.wenger@gmail.com","name":"Craig Wenger","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://cwenger.github.io/Morpheus/faq.html"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"operation":[{"term":"Peptide database search","uri":"http://edamontology.org/operation_3646"}]}],"name":"Morpheus","owner":"jison","publication":[{"doi":"10.1021/pr301024c","metadata":{"abstract":"The acquisition of high-resolution tandem mass spectra (MS/MS) is becoming more prevalent in proteomics, but most researchers employ peptide identification algorithms that were designed prior to this development. Here, we demonstrate new software, Morpheus, designed specifically for high-mass accuracy data, based on a simple score that is little more than the number of matching products. For a diverse collection of data sets from a variety of organisms (E. coli, yeast, human) acquired on a variety of instruments (quadrupole-time-of-flight, ion trap-orbitrap, and quadrupole-orbitrap) in different laboratories, Morpheus gives more spectrum, peptide, and protein identifications at a 1% false discovery rate (FDR) than Mascot, Open Mass Spectrometry Search Algorithm (OMSSA), and Sequest. Additionally, Morpheus is 1.5 to 4.6 times faster, depending on the data set, than the next fastest algorithm, OMSSA. Morpheus was developed in C#.NET and is available free and open source under a permissive license. \u00a9 2013 American Chemical Society.","authors":[{"name":"Coon J.J."},{"name":"Wenger C.D."}],"citationCount":128,"date":"2013-03-01T00:00:00Z","journal":"Journal of Proteome Research","title":"A proteomics search algorithm specifically designed for high-resolution tandem mass spectra"},"pmcid":"PMC3586292","pmid":"23323968","type":["Primary"]}],"topic":[{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"}],"validated":1},"bioschemas":{"name":"Morpheus","home":"https://bio.tools/morpheus","license":"MIT","summary":"A proteomics search algorithm specifically designed for high-resolution tandem mass spectra.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"288","first_commit":"2015-10-29","conda_name":"morpheus","conda_version":"290","summary":"M