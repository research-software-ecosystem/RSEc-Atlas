{"tool_name":"postman","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"postman","home":"http://www.uib.no/en/rg/probe/65847/postman","summary":"Post-translational modification software.","addition_date":"2017-01-17T14:51:13Z","last_update_date":"2019-03-26T08:32:44Z","tool_type":["Desktop application"],"collections":["Proteomics","ms-utils"],"biotools_curie":"biotools:postman","credit":[{"email":"webmaster@ms-utils.org","typeEntity":"Person","typeRole":["Documentor"],"url":"http://ms-utils.org"}],"documentation":[{"type":["General"],"url":"http://www.uib.no/en/rg/probe/65847/postman"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"input":[{"data":{"term":"Mass spectrometry spectra","uri":"http://edamontology.org/data_0943"},"format":[{"term":"TSV","uri":"http://edamontology.org/format_3475"}]},{"data":{"term":"Protein sequence record","uri":"http://edamontology.org/data_2886"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}],"operation":[{"term":"Chromatographic alignment","uri":"http://edamontology.org/operation_3628"},{"term":"Filtering","uri":"http://edamontology.org/operation_3695"},{"term":"PTM identification","uri":"http://edamontology.org/operation_3645"},{"term":"PTM localisation","uri":"http://edamontology.org/operation_3755"},{"term":"Peptide database search","uri":"http://edamontology.org/operation_3646"},{"term":"Plotting","uri":"http://edamontology.org/operation_3441"},{"term":"Post-translation modification site prediction","uri":"http://edamontology.org/operation_0417"},{"term":"Protein fragment weight comparison","uri":"http://edamontology.org/operation_2929"}],"output":[{"data":{"term":"Peptide mass fingerprint","uri":"http://edamontology.org/data_0944"},"format":[{"term":"TSV","uri":"http://edamontology.org/format_3475"}]}]}],"name":"POSTMan","operating_system":["Linux","Mac","Windows"],"owner":"msutils_import","publication":[{"metadata":{"abstract":"Post-translationally modified peptides present in low concentrations are often not selected for CID, resulting in no sequence information for these peptides. We have developed a software POSTMan (POST-translational Modification analysis) allowing post-translationally modified peptides to be targeted for fragmentation. The software aligns LC-MS runs (MS1 data) between individual runs or within a single run and isolates pairs of peptides which differ by a user defined mass difference (post-translationally modified peptides). The method was validated for acetylated peptides and allowed an assessment of even the basal protein phosphorylation of phenylalanine hydroxylase (PHA) in intact cells. \u00a9 2009 Wiley-VCH Verlag GmbH & Co. KGaA.","authors":[{"name":"Arntzen M.O."},{"name":"D'Santos C.S."},{"name":"Doskeland S.-O."},{"name":"Kopperud R."},{"name":"Lewis A.E."},{"name":"Osland C.L."},{"name":"Raa C.R.-O."}],"citationCount":3,"date":"2009-03-01T00:00:00Z","journal":"Proteomics","title":"POSTMan (POST-translational modification analysis), a software application for PTM discovery"},"pmid":"19253288"}],"topic":[{"term":"Protein modifications","uri":"http://edamontology.org/topic_0601"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"}],"validated":1},"bioschemas":{"name":"POSTMan","home":"https://bio.tools/postman","summary":"Post-translational modification software.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:postman/app/www.uib.no","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":1,"citations":[{"count":1,"year":"2015"}],"doi":"10.1002/pmic.200800500","pmid":"19253288","ref_count":0,"r