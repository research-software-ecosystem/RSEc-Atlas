{"tool_name":"cloops2","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"cloops2","home":"https://github.com/KejiZhaoLab/cLoops2","license":"BSD-3-Clause","summary":"cLoops2: full stack analysis tool for chromatin interactions.","addition_date":"2022-06-06T11:44:51.850161Z","last_update_date":"2022-06-06T11:44:51.852592Z","tool_type":["Library"],"accessibility":"Open access","biotools_curie":"biotools:cloops2","cost":"Free of charge","credit":[{"email":"zhaok@nhlbi.nih.gov","name":"Keji Zhao","orcidid":"https://orcid.org/0000-0001-5559-6233","typeEntity":"Person"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Aggregation","uri":"http://edamontology.org/operation_3436"},{"term":"Principal component visualisation","uri":"http://edamontology.org/operation_2939"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"}]}],"name":"cLoops2","operating_system":["Linux","Mac","Windows"],"owner":"Chan019","publication":[{"doi":"10.1093/NAR/GKAB1233","metadata":{"abstract":"\u00a9 2021 Published by Oxford University Press on behalf of Nucleic Acids Research 2021.Investigating chromatin interactions between regulatory regions such as enhancer and promoter elements is vital for understanding the regulation of gene expression. Compared to Hi-C and its variants, the emerging 3D mapping technologies focusing on enriched signals, such as TrAC-looping, reduce the sequencing cost and provide higher interaction resolution for cis-regulatory elements. A robust pipeline is needed for the comprehensive interpretation of these data, especially for loop-centric analysis. Therefore, we have developed a new versatile tool named cLoops2 for the full-stack analysis of these 3D chromatin interaction data. cLoops2 consists of core modules for peak-calling, loop-calling, differentially enriched loops calling and loops annotation. It also contains multiple modules for interaction resolution estimation, data similarity estimation, features quantification, feature aggregation analysis, and visualization. cLoops2 with documentation and example data are open source and freely available at GitHub: https://github.com/KejiZhaoLab/cLoops2.","authors":[{"name":"Cao Y."},{"name":"Liu S."},{"name":"Ren G."},{"name":"Tang Q."},{"name":"Zhao K."}],"date":"2022-01-11T00:00:00Z","journal":"Nucleic Acids Research","title":"CLoops2: A full-stack comprehensive analytical tool for chromatin interactions"},"pmcid":"PMC8754654","pmid":"34928392"}],"topic":[{"term":"ChIP-seq","uri":"http://edamontology.org/topic_3169"},{"term":"Gene regulation","uri":"http://edamontology.org/topic_0204"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Mathematics","uri":"http://edamontology.org/topic_3315"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"}],"validated":1},"bioschemas":{"name":"cLoops2","home":"https://bio.tools/cloops2","license":"BSD-3-Clause","summary":"cLoops2: full stack analysis tool for chromatin interactions.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:cloops2/lib/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":28,"citations":[{"count":3,"year":"2022"},{"count":5,"year":"2023"},{"count":5,"year":"2026"},{"count":7,"year":"2025"},{"count":8,"year":"2024"}],"doi":"10.1093/nar/gkab1233","pmcid":"PMC8754654","pmid":"34928392","ref_count":66,"refs":[{"count":1,"year":"2004"},{"count":1,"year":"2007"},{"count":1,"year":"2008"},{"count":