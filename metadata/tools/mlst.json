{"tool_name":"mlst","contents":["biocontainers","galaxy","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"mlst","version":"2.35.0","home":"https://github.com/tseemann/mlst","license":"GPL-2.0","summary":"Scan contig files against PubMLST typing schemes","identifiers":["biotools:mlst"],"license_file":"LICENSE","build":{"noarch":"generic","number":0,"run_exports":[null]},"requirements":{"run":["any2fasta","blast >=2.16.0","libxcrypt1","perl","perl-bioperl >=1.7.2","perl-file-which","perl-json","perl-list-moreutils","perl-moo","zlib"]},"source_url":"https://github.com/tseemann/mlst/archive/v2.35.0.tar.gz","test":{"commands":["mlst --version","mlst --check","mlst --help","mlst --list 2>&1 | grep leptospira > /dev/null"]}},"biocontainers":{"name":"mlst","identifiers":["biotools:mlst","doi:10.1128/JCM.06094-11"],"license":"Apache-2.0","summary":"Multi locus sequence typing from an assembled genome or from a set of reads.","home_url":"http://cge.cbs.dtu.dk/services/MLST/","keywords":["Bacteria","Bacterial Typing Techniques","Contig Mapping","Databases, Genetic","Genes, Bacterial","Genome, Bacterial","High-Throughput Nucleotide Sequencing","Multilocus Sequence Typing","Immunoproteins, genes and antigens"],"manually_check":true,"total_pulls":3476},"biotools":{"id":"mlst","home":"http://cge.cbs.dtu.dk/services/MLST/","license":"Other","summary":"Multi Locus Sequence Typing from an assembled genome or from a set of reads.","addition_date":"2015-01-21T13:29:15Z","last_update_date":"2024-11-24T14:10:19.854595Z","tool_type":["Web application"],"version":["1.7"],"biotools_curie":"biotools:mlst","cost":"Free of charge (with restrictions)","credit":[{"email":"mette@cbs.dtu.dk","name":"Mette Voldby Larsen","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"CBS","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["General"],"url":"https://cge.cbs.dtu.dk//services/MLST/instructions.php"}],"edit_permission":{"type":"public"},"function":[{"input":[{"data":{"term":"Sequence","uri":"http://edamontology.org/data_2044"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"},{"term":"FASTA-like","uri":"http://edamontology.org/format_2546"}]}],"note":"Multi Locus Sequence Typing (MLST) from an assembled genome or from a set of reads","operation":[{"term":"Multilocus sequence typing","uri":"http://edamontology.org/operation_3840"}],"output":[{"data":{"term":"Sequence report","uri":"http://edamontology.org/data_2955"},"format":[{"term":"Binary format","uri":"http://edamontology.org/format_2333"}]}]}],"maturity":"Emerging","name":"MLST","operating_system":["Linux"],"owner":"CBS","publication":[{"doi":"10.1128/jcm.06094-11","metadata":{"abstract":"Accurate strain identification is essential for anyone working with bacteria. For many species, multilocus sequence typing (MLST) is considered the \"gold standard\" of typing, but it is traditionally performed in an expensive and time-consuming manner. As the costs of whole-genome sequencing (WGS) continue to decline, it becomes increasingly available to scientists and routine diagnostic laboratories. Currently, the cost is below that of traditional MLST. The new challenges will be how to extract the relevant information from the large amount of data so as to allow for comparison over time and between laboratories. Ideally, this information should also allow for comparison to historical data. We developed a Web-based method for MLST of 66 bacterial species based on WGS data. As input, the method uses short sequence reads from four sequencing platforms or preassembled genomes. Updates from the MLST databases are downloaded monthly, and the best-matching MLST alleles of the specified MLST scheme are found using a BLAST-based ranking method. The sequence type is then determined by the combination of alleles identified. The method was tested on preassembled genomes from 336 isolates covering 56 MLST schemes, on short sequence reads from 387 isolates covering 10 schemes, and on a small test set of short sequence reads from 29 isolates for which the sequence type had been determined by traditional methods. The method presented here enables investigators to determine the sequence types of their isolates on the basis of WGS data. This method is publicly available at www.cbs.dtu.dk/services/ MLST. Copyright \u00a9 2012, American Society for Microbiology. All Rights Reserved.","authors":[{"name":"Aarestrup F.M."},{"name":"Cosentino S."},{"name":"Friis C."},{"name":"Hasman H."},{"name":"Jelsbak L."},{"name":"Larsen M.V."},{"name":"Lund O."},{"name":"Marvig R.L."},{"name":"Rasmussen S."},{"name":"Sicheritz-Ponten T."},{"name":"Ussery D.W."}],"citationCount":1688,"date":"2012-04-01T00:00:00Z","journal":"Journal of Clinical Microbiology","title":"Multilocus sequence typing of total-genome-sequenced bacteria"},"pmcid":"PMC3318499","pmid":"22238442","type":["Primary"]}],"topic":[{"term":"Immunoproteins and antigens","uri":"http://edamontology.org/topic_2830"}],"validated":1},"bioschemas":{"name":"MLST","home":"https://bio.tools/mlst","license":"Other","version":"1.7","summary":"Multi Locus Sequence Typing from an assembled genome or from a set of reads.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"2.22.0","first_commit":"2016-12-13","conda_name":"mlst","conda_version":"2.35.0","summary":"Scan contig files against PubMLST typing schemes","edam_operations":["Multilocus sequence typing"],"edam_topics":["Immunoproteins and antigens"],"toolshed_categories":["Sequence Analysis"],"toolshed_id":"mlst","users_5_years":4301,"users_all_time":4799,"usage_5_years":49962,"usage_all_time":55608,"bio_tools_summary":"Multi Locus Sequence Typing from an assembled genome or from a set of reads.","bio_tools_ids":"mlst","bio_tools_name":"MLST","related_tutorials":["https://training.galaxyproject.org/training-material/topics/microbiome/tutorials/pathogen-detection-from-nanopore-foodborne-data/tutorial.html"],"rel