{"tool_name":"sseq","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-sseq","version":"1.48.0","home":"https://bioconductor.org/packages/3.22/bioc/html/sSeq.html","license":"GPL (>= 3)","summary":"Shrinkage estimation of dispersion in Negative Binomial models for RNA-seq experiments with small sample size","identifiers":["biotools:sseq","doi:10.1093/bioinformatics/btt143"],"description":"The purpose of this package is to discover the genes that are differentially expressed between two conditions in RNA-seq experiments. Gene expression is measured in counts of transcripts and modeled with the Negative Binomial (NB) distribution using a shrinkage approach for dispersion estimation. The method of moment (MM) estimates for dispersion are shrunk towards an estimated target, which minimizes the average squared difference between the shrinkage estimates and the initial estimates. The exact per-gene probability under the NB model is calculated, and used to test the hypothesis that the expected expression of a gene in two conditions identically follow a NB distribution.","license_file":"/lib/R/share/licenses/GPL-3","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["r-base","r-catools","r-rcolorbrewer"],"run":["r-base","r-catools","r-rcolorbrewer"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/sSeq_1.48.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/sSeq/sSeq_1.48.0.tar.gz","https://bioarchive.galaxyproject.org/sSeq_1.48.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-sseq/bioconductor-sseq_1.48.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('sSeq')\""]},"parent_recipe":{"name":"bioconductor-sseq","path":"recipes/bioconductor-sseq","version":"1.18.0"}},"biotools":{"id":"sseq","home":"https://bioconductor.org/packages/sSeq","license":"GPL-3.0-or-later","summary":"The purpose of this package is to discover the genes that are differentially expressed between two conditions in RNA-seq experiments. Gene expression is measured in counts of transcripts and modeled with the Negative Binomial (NB) distribution using a shrinkage approach for dispersion estimation. The method of moment (MM) estimates for dispersion are shrunk towards an estimated target, which minimizes the average squared difference between the shrinkage estimates and the initial estimates. The exact per-gene probability under the NB model is calculated, and used to test the hypothesis that the expected expression of a gene in two conditions identically follow a NB distribution.","addition_date":"2017-01-17T15:05:59Z","last_update_date":"2024-11-25T15:14:38.667007Z","tool_type":["Command-line tool","Library"],"version":["1.50.0"],"collections":["BioConductor"],"biotools_curie":"biotools:sseq","credit":[{"name":"Danni Yu"},{"name":"Wolfgang Huber"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/sSeq"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Differential gene expression analysis","uri":"http://edamontology.org/operation_3223"}]}],"name":"sSeq","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.18129/B9.bioc.sSeq"}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"bioschemas":{"name":"sSeq","home":"https://bio.tools/sseq","license":"GPL-3.0-or-later","version":"1.50.0","summary":"The purpose of this package is to discover the genes that are differentially expressed between two conditions in RNA-seq experiments. Gene expression is measured in counts of transcripts and modeled with the Negative Binomial (NB) distribution using a shrinkage approach for dispersion estimation. The method of moment (MM) estimates for dispersion are shrunk towards an estimated target, wh