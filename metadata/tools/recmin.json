{"tool_name":"recmin","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"recmin","home":"http://www.stats.ox.ac.uk/~myers/RecMin.html","summary":"Software to identify ancestral recombination events from population genetic data. Under certain assumptions the pattern of diversity at a collection of linked sites provides information allowing us to detect historic recombination events. This program calculates a lower bound on the number of recombination events required to construct any history of a sample, under the assumption that each segregating site has mutated only once since the most recent common ancestor of the sample.","addition_date":"2017-12-18T00:12:05Z","last_update_date":"2018-12-10T12:58:54Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:recmin","credit":[{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.stats.ox.ac.uk/~myers/"}],"documentation":[{"type":["General"],"url":"http://www.stats.ox.ac.uk/~myers/RecMin/Readme.txt"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Recombination detection","uri":"http://edamontology.org/operation_0451"}]}],"name":"RecMin","operating_system":["Linux","Windows"],"owner":"mbs_import","topic":[{"term":"Evolutionary biology","uri":"http://edamontology.org/topic_3299"},{"term":"Genetics","uri":"http://edamontology.org/topic_3053"},{"term":"Phylogenetics","uri":"http://edamontology.org/topic_3293"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:recmin/cmd/www.stats.ox.ac.uk","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":302,"url":"https://www.stats.