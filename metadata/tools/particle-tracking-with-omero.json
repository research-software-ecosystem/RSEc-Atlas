{"tool_name":"particle-tracking-with-omero","contents":["neubias"],"fetched_metadata":{"neubias":{"body":[{"format":"basic_html","processed":"<p>u-Track is a client-side OMERO MATLAB application implementing the sophisticated multiple-particle tracking algorithm of Jaqaman et al. . It works on data previously imported into an OMERO server, and produces results in the form of MATLAB data structures as well as providing functionality to visualise these results.</p>","summary":"","value":"<p>u-Track is a client-side OMERO MATLAB application implementing the sophisticated multiple-particle tracking algorithm of Jaqaman et al. . It works on data previously imported into an OMERO server, and produces results in the form of MATLAB data structures as well as providing functionality to visualise these results.</p>\r\n"}],"changed":[{"format":"Y-m-d\\TH:i:sP","value":"2018-05-27T14:53:03+00:00"}],"created":[{"format":"Y-m-d\\TH:i:sP","value":"2014-12-09T11:55:45+00:00"}],"default_langcode":[{"value":true}],"attribution_instructions":[],"comments_2023":[],"free_tagging":[],"give_feedback_on_this_soft":[{"cid":0,"comment_count":0,"last_comment_name":null,"last_comment_timestamp":1505205342,"last_comment_uid":164,"status":2}],"has_author":[{"value":"Danuser lab"}],"has_biological_terms":[],"has_comparison":[],"has_documentation":[{"options":[],"title":"[PDF] u-track Documentation Release 2.1.2","uri":"https://downloads.openmicroscopy.org/u-track/2.1.2/artifacts/u-track-2.1.2.pdf"}],"has_doi":[],"has_entry_curator":[{"target_id":23,"target_type":"user","target_uuid":"c34efbcc-a07c-4bba-9437-0e5edae0741f","url":"/user/23"}],"has_function":[{"target_id":4023,"target_type":"taxonomy_term","target_uuid":"http://edamontology.org/operation_Image_tracking","url":"/object-tracking"}],"has_implementation":[],"has_interaction_level":[{"target_id":3573,"target_type":"taxonomy_term","target_uuid":"43cf6a59-36ad-49c8-9baa-3c5494481f13","url":"/taxonomy/term/3573"}],"has_license":[],"has_locat