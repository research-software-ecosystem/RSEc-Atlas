. In response, the services and infrastructure of the European Bioinformatics Institute (EMBL-EBI, www.ebi.ac.UK) are continually expanding: total disk capacity increases significantly every year to keep pace with demand (75 petabytes as of December 2015), and interoperability between resources remains a strategic priority. Since 2014 we have launched two new resources: the European Variation Archive for genetic variation data and EMPIAR for two-dimensional electron microscopy data, as well as a Resource Description Framework platform. We also launched the Embassy Cloud service, which allows users to run large analyses in a virtual environment next to EMBL-EBI's vast public data resources.","authors":[{"name":"Apweiler R."},{"name":"Bergman M.T."},{"name":"Birney E."},{"name":"Cochrane G."},{"name":"Cook C.E."},{"name":"Finn R.D."}],"citationCount":78,"date":"2016-01-01T00:00:00Z","journal":"Nucleic Acids Research","title":"The European Bioinformatics Institute in 2016: Data growth and integration"},"type":["Other"]}],"topic":[{"term":"Data management","uri":"http://edamontology.org/topic_3071"}],"validated":1},"bioschemas":{"name":"BioModels Database Converters","home":"https://bio.tools/biomodels_database_converters","version":"1","summary":"Set of converters between various modelling formats, there are also some available online to be used directly.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:biomodels_database_converters:1/web/www.ebi.ac.uk","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true,"terms_of_use":true},"publications":[{"entries":[{"cit_count":48,"citations":[{"count":1,"year":"2023"},{"count":2,"year":"2021"},{"count":2,"year":"2022"},{"count":3,"year":"2025"},{"count":5,"year":"2020"},{"count":5,"year":"2024"},{"count":6,"year":"2016"},{"count":7,"yea