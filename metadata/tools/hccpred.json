{"tool_name":"hccpred","contents":["biotools","oeb"],"identifiers":["biotools:hccpred"],"fetched_metadata":{"biotools":{"id":"HCCPred","home":"http://webs.iiitd.edu.in/raghava/hccpred/","summary":"Identification of Platform-Independent Diagnostic Biomarker Panel for Hepatocellular Carcinoma using Large-scale Transcriptomics Data | A webserver to predict Hepatocellular carcinoma (HCC) | Pipeline Differential Expression Analysis | HCCpred is a web-bench for the prediction of tumorous and non-tumorous Hepatocellular Carcinoma (HCC) patients. Our major prediction modules based on the robust biomarkers such as 3-Gene HCC Biomarker, 4-Gene HCC Biomarker, 5-Gene HCC Biomarker. These HCC biomarkers identified using gene expression profiles of a total of 3,961 samples include 2,306 HCC and 1,655 non-tumorous samples. The datasets derived from various profiling platforms such as Affymatrix, Illumina, High-througput and Agilent. The user can also analyse the expression pattern of any of 26 \"core genes of HCC\" in cancerous vs normal conditions","addition_date":"2019-11-14T19:44:21Z","last_update_date":"2026-11-12T14:17:22.095124Z","tool_type":["Web service"],"biotools_curie":"biotools:HCCPred","edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Differential gene expression analysis","uri":"http://edamontology.org/operation_3223"},{"term":"Enrichment analysis","uri":"http://edamontology.org/operation_3501"},{"term":"Expression profile clustering","uri":"http://edamontology.org/operation_0313"}]}],"name":"HCCPred","owner":"raghavagps","publication":[{"doi":"10.1101/758250","type":["Preprint"]},{"doi":"10.3389/fgene.2019.01306","type":["Primary"]}],"topic":[{"term":"Biomarkers","uri":"http://edamontology.org/topic_3360"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:hccpred/soap/webs.