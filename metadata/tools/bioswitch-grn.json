{"tool_name":"bioswitch-grn","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bioswitch-grn","home":"https://github.com/CBigOxf/BioSWITCH","license":"MIT","summary":"BioSWITCH iis a command-line program using the BioPAX standardised language to \u201cswitch on\u201d static regulatory networks so that they can be executed in GINML to predict cellular behaviour. Using a previously published haematopoiesis gene network, we show that BioSWITCH successfully and faithfully automates the network de-coding and re-coding into an executable logical network. BioSWITCH also supports the integration of a BioPAX model into an existing GINML graph.","addition_date":"2021-01-18T09:41:03Z","last_update_date":"2021-02-04T15:11:38Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:bioswitch-grn","credit":[{"email":"francesca.buffa@oncology.ox.ac.uk","name":"Francesca Buffa","orcidid":"https://orcid.org/0000-0003-0409-406X","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Deposition","uri":"http://edamontology.org/operation_3431"},{"term":"Gene regulatory network analysis","uri":"http://edamontology.org/operation_1781"},{"term":"Gene regulatory network prediction","uri":"http://edamontology.org/operation_2437"},{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Pathway analysis","uri":"http://edamontology.org/operation_3928"}]}],"name":"BioSWITCH","owner":"Kigaard","publication":[{"doi":"10.1101/2020.05.29.122200"}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Gene regulation","uri":"http://edamontology.org/topic_0204"},{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Protein expression","uri":"http://edamontology.org/topic_0108"}]},"bioschemas":{"name":"BioSWITCH","home":"https://bio.tools/biosw