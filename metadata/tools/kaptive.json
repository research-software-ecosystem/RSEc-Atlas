{"tool_name":"kaptive","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"kaptive","identifiers":["doi:10.1101/869370"],"license":"GNU General Public License v3.0","summary":"Kaptive reports information about capsular (k) loci found in genome assemblies","home_url":"https://github.com/katholt/Kaptive","keywords":["Genomics","Protein Sequences","Ortholog"],"manually_check":true,"total_pulls":0},"biotools":{"id":"Kaptive","home":"http://kaptive.holtlab.net/","license":"GPL-3.0","summary":"Identification of Acinetobacter baumannii loci for capsular polysaccharide (KL) and lipooligosaccharide outer core (OCL) synthesis in genome assemblies using curated reference databases compatible with Kaptive.\n\nKaptive reports information about surface polysaccharide loci for Klebsiella and Acinetobacter baumannii genome assemblies. You can also run a graphical version of Kaptive via this web interface (source code).\n\nGiven a novel genome and a database of known loci (K, O or OC), Kaptive will help a user to decide whether their sample has a known or novel locus. It carries out the following for each input assembly:.\n\nKaptive is a tool for bacterial surface polysaccharide locus typing and variant evaluation. It takes one or more pre-assembled genomes and for each finds the best matching locus from a reference database. References for Klebsiella pneumoniae species complex and Acinetobacter baumannii are available in Kaptive's web interface","addition_date":"2020-01-14T19:38:00Z","last_update_date":"2020-12-14T14:12:43Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:Kaptive","edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Database search","uri":"http://edamontology.org/operation_2421"},{"term":"Deposition","uri":"http://edamontology.org/operation_3431"},{"term":"Genome assembly","uri":"http://edamontology.org/operation_0525"},{"term":"Multilocus sequence typing","uri":"http://edamontology.org/operation_3840"}]}],"name":"Kaptive","owner":"Pub2Tools","publication":[{"doi":"10.1101/869370"}],"topic":[{"term":"Immunoproteins and antigens","uri":"http://edamontology.org/topic_2830"},{"term":"Microbiology","uri":"http://edamontology.org/topic_3301"},{"term":"Public health and epidemiology","uri":"http://edamontology.org/topic_3305"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Whole genome sequencing","uri":"http://edamontology.org/topic_3673"}],"validated":1},"bioschemas":{"name":"Kaptive","home":"https://bio.tools/Kaptive","license":"GPL-3.0","summary":"Identification of Acinetobacter baumannii loci for capsular polysaccharide (KL) and lipooligosaccharide outer core (OCL) synthesis in genome assemblies using curated reference databases compatible with Kaptive.\n\nKaptive reports information about surface polysaccharide loci for Klebsiella and Acinetobacter baumannii genome assemblies. You can also run a graphical version of Kaptive via this web interface (source code).\n\nGiven a novel genome and a database of known loci (K, O or OC), Kaptive will help a user to decide whether their sample has a known or novel locus. It carries out the following for each input assembly:.\n\nKaptive is a tool for bacterial surface polysaccharide locus typing and variant evaluation. It takes one or more pre-assembled genomes and for each finds the best matching locus from a reference database. References for Klebsiella pneumoniae species complex and Acinetobacter baumannii are available in Kaptive's web interface","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:kaptive/cmd/kaptive.holtlab.net","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entri