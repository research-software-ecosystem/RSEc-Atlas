{"tool_name":"netsam","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"netsam","home":"https://bioconductor.org/packages/NetSAM","license":"LGPL-2.0-or-later","summary":"The NetSAM (Network Seriation and Modularization) package takes an edge-list representation of a weighted or unweighted network as an input, performs network seriation and modularization analysis, and generates as files that can be used as an input for the one-dimensional network visualization tool NetGestalt (http://www.netgestalt.org) or other network analysis. The NetSAM package can also generate correlation network (e.g. co-expression network) based on the input matrix data, perform seriation and modularization analysis for the correlation network and calculate the associations between the sample features and modules or identify the associated GO terms for the modules.","addition_date":"2017-01-17T15:05:42Z","last_update_date":"2024-11-25T15:32:07.951344Z","tool_type":["Command-line tool","Library"],"version":["1.52.0"],"collections":["BioConductor"],"biotools_curie":"biotools:netsam","credit":[{"name":"Jing Wang"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/NetSAM"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Pathway or network analysis","uri":"http://edamontology.org/operation_2497"}]}],"name":"NetSAM","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.18129/B9.bioc.NetSAM"}],"topic":[{"term":"Data management","uri":"http://edamontology.org/topic_3071"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"}],"validated":1},"bioschemas":{"name":"NetSAM","home":"https://bio.tools/netsam","license":"LGPL-2.0-or-later","version":"1.52.0","summary":"The NetSAM (Network Seriation and Modularization) package takes an edge-list representation of a weighted or unweighted network as an input, performs network se