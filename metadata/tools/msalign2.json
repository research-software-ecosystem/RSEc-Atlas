{"tool_name":"msalign2","contents":["biocontainers","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"msalign2","version":"1.0","home":"http://www.ms-utils.org/msalign2/index.html","license":"GPL3","summary":"Aligns 2 CE-MS or LC-MS datasets using accurate mass information.","identifiers":["biotools:msalign2","doi:10.1007/s00216-009-3166-1"],"build":{"number":6,"skip":true},"requirements":{"build":[null],"host":["zlib","libgd"],"run":["zlib","libgd"]},"source_url":"http://www.ms-utils.org/msalign2/msalign2.zip","test":{"commands":["msalign2 -h"]}},"biocontainers":{"name":"msalign2","identifiers":["biotools:msalign2","doi:10.1007/s00216-009-3166-1"],"license":"GPL-3.0","summary":"Aligns 2 CE-MS or LC-MS datasets using accurate mass information.","home_url":"http://www.ms-utils.org/msalign2/index.html","keywords":["Animals","Electrophoresis, Capillary","Mice","Spectrometry, Mass, Matrix-Assisted Laser Desorption-Ionization","Statistics as Topic","Urine","Proteomics experiment","Proteomics","Metabolomics","Peptides"],"manually_check":true,"total_pulls":0},"biotools":{"id":"msalign2","home":"http://www.ms-utils.org/msalign2/index.html","license":"GPL-3.0","summary":"Aligns 2 CE-MS or LC-MS datasets using accurate mass information.","addition_date":"2017-01-17T14:51:04Z","last_update_date":"2024-11-25T14:13:42.731944Z","tool_type":["Command-line tool"],"collections":["Proteomics","ms-utils"],"biotools_curie":"biotools:msalign2","credit":[{"email":"e.nevedomskaya@lumc.nl","name":"E. Nevedomskaya","typeEntity":"Person","typeRole":["Maintainer"]},{"email":"magnus.palmblad@gmail.com","name":"Magnus Palmblad","typeEntity":"Person","typeRole":["Maintainer"]},{"email":"webmaster@ms-utils.org","typeEntity":"Person","typeRole":["Documentor"],"url":"http://ms-utils.org"}],"documentation":[{"type":["General"],"url":"http://www.ms-utils.org/msalign2/index.html"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"input":[{"data":{"term":"Mass spectrometry spectra","uri":"http://edamontology.org/data_0943"},"format":[{"term":"mzXML","uri":"http://edamontology.org/format_3654"}]}],"operation":[{"term":"Chromatographic alignment","uri":"http://edamontology.org/operation_3628"},{"term":"Plotting","uri":"http://edamontology.org/operation_3441"}],"output":[{"data":{"term":"Alignment","uri":"http://edamontology.org/data_1916"},"format":[{"term":"mzXML","uri":"http://edamontology.org/format_3654"}]}]}],"name":"msalign2","operating_system":["Linux"],"owner":"msutils_import","publication":[{"doi":"10.1007/s00216-009-3166-1","metadata":{"abstract":"Capillary electrophoresis-mass spectrometry (CE-MS) is a powerful technique for the analysis of small soluble compounds in biological fluids. A major drawback of CE is the poor migration time reproducibility, which makes it difficult to combine data from different experiments and correctly assign compounds. A number of alignment algorithms have been developed but not all of them can cope with large and irregular time shifts between CE-MS runs. Here we present a genetic algorithm designed for alignment of CE-MS data using accurate mass information. The utility of the algorithm was demonstrated on real data, and the results were compared with one of the existing packages. The new algorithm showed a significant reduction of elution time variation in the aligned datasets. The importance of mass accuracy for the performance of the algorithm was also demonstrated by comparing alignments of datasets from a standard time-of-flight (TOF) instrument with those from the new ultrahigh resolution TOF maXis (Bruker Daltonics). \u00a9 2009 Springer-Verlag.","authors":[{"name":"Deelder A.M."},{"name":"Derks R."},{"name":"Mayboroda O.A."},{"name":"Nevedomskaya E."},{"name":"Palmblad M."}],"citationCount":50,"date":"2009-12-01T00:00:00Z","journal":"Analytical and Bioanalytical Chemistry","title":"Alignment of capillary electrophoresis-mass spectrometry datasets us