{"tool_name":"r-sap","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"r-sap","home":"https://mcdonaldlab.biology.gatech.edu/r-sap/","summary":"User-friendly and fully automated bioinformatics pipeline that analyzes and quantitates high-throughput RNA-Seq datasets. It accurately characterizes various classes of transcripts resulted from aberrant splicing and chimeric transcripts. Expression level estimates are reported as RPKM (reads per kilobase of exon model per million mapped reads) values.","addition_date":"2017-08-03T18:57:17Z","last_update_date":"2024-11-24T20:26:16.812891Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:r-sap","credit":[{"email":"vinaykmittal@gatech.edu","name":"Vinay Mittal","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://www.mcdonaldlab.biology.gatech.edu/r-sap/README_1.1.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"RNA-Seq analysis","uri":"http://edamontology.org/operation_3680"}]}],"name":"R-SAP","operating_system":["Linux","Windows"],"owner":"mbs_import","publication":[{"doi":"10.1093/nar/gks047","metadata":{"abstract":"The rapid expansion in the quantity and quality of RNA-Seq data requires the development of sophisticated high-performance bioinformatics tools capable of rapidly transforming this data into meaningful information that is easily interpretable by biologists. Currently available analysis tools are often not easily installed by the general biologist and most of them lack inherent parallel processing capabilities widely recognized as an essential feature of next-generation bioinformatics tools. We present here a user-friendly and fully automated RNA-Seq analysis pipeline (R-SAP) with built-in multi-threading capability to analyze and quantitate high-throughput RNA-Seq datasets. R-SAP follows a hierarchical decision making procedure to accurately characterize various classes of transcripts and achieves a near linear decrease in data processing time as a result of increased multi-threading. In addition, RNA expression level estimates obtained using R-SAP display high concordance with levels measured by microarrays. \u00a9 2012 The Author(s).","authors":[{"name":"McDonald J.F."},{"name":"Mittal V.K."}],"citationCount":6,"date":"2012-05-01T00:00:00Z","journal":"Nucleic Acids Research","title":"R-SAP: A multi-threading computational pipeline for the characterization of high-throughput RNA-sequencing data"},"pmcid":"PMC3351179","pmid":"22287631"}],"topic":[{"term":"Nucleic acids","uri":"http://edamontology.org/topic_0077"},{"term":"RNA","uri":"http://edamontology.org/topic_0099"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"bioschemas":{"name":"R-SAP","home":"https://bio.tools/r-sap","summary":"User-friendly and fully automated bioinformatics pipeline that analyzes and quantitates high-throughput RNA-Seq datasets. It accurately characterizes various classes of transcripts resulted from aberrant splicing and chimeric transcripts. Expression level estimates are reported as RPKM (reads per kilobase of exon model per million mapped reads) values.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:r-sap/cmd/mcdonaldlab.biology.gatech.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":5,"citations":[{"count":1,"year":"2012"},{"count":1,"year":"2015"},{"count":1,"year":"2017"},{"count":1,"year":"2019"},{"count":1,"year":"2020"}],"doi":"10.1093/nar/gks047","pmcid":"PMC3351179","pmid":"22287631","ref_count":47,"refs":[{"count":1,"year":"1987"},{"count":1,"year":"1992"},{"count":1,"year":"1997"},{"count":1,"year":"2000"},{"count":1,"year":"2001"