{"tool_name":"bioconductor-chetah","contents":["oeb","bioschemas","biocontainers","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-chetah","identifiers":["doi:10.18129/b9.bioc.chetah"],"license":"GNU AFFERO GENERAL PUBLIC LICENSE Version 3","summary":"Fast and accurate scrna-seq cell type identification","home_url":"https://bioconductor.org/packages/3.11/bioc/html/CHETAH.html","keywords":["Clustering","RNA-Seq"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-chetah","home":"https://bioconductor.org/packages/CHETAH","summary":"CHETAH (CHaracterization of cEll Types Aided by Hierarchical classification) is an accurate, selective and fast scRNA-seq classifier. Classification is guided by a reference dataset, preferentially also a scRNA-seq dataset. By hierarchical clustering of the reference data, CHETAH creates a classification tree that enables a step-wise, top-to-bottom classification. Using a novel stopping rule, CHETAH classifies the input cells to the cell types of the references and to \"intermediate types\": more general classifications that ended in an intermediate node of the tree.","addition_date":"2026-09-01T07:16:44.056490Z","last_update_date":"2026-09-01T07:16:44.059069Z","tool_type":["Command-line tool","Library"],"version":["1.28.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-chetah","credit":[{"name":"Jurrian de Kanter","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Philip Lijnzaad","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/CHETAH"}],"edit_permission":{"type":"private"},"name":"CHETAH","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.1093/nar/gkz543"}]},"bioschemas":{"name":"CHETAH","home":"https://bio.tools/bioconductor-chetah","version":"1.28.0","summary":"CHETAH (CHaracterization of cEll Types Aided by Hierarchical classifica