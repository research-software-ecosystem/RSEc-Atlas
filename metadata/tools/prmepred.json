{"tool_name":"prmepred","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"prmepred","home":"http://bioinfo.icgeb.res.in/PRmePRed/","summary":"Protein arginine methylation prediction tool.","addition_date":"2018-06-04T19:57:44Z","last_update_date":"2024-11-25T14:38:12.788518Z","tool_type":["Web application"],"biotools_curie":"biotools:prmepred","credit":[{"email":"dinesh@icgeb.res.in","name":"Dinesh Gupta","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://bioinfo.icgeb.res.in/PRmePRed/index-1.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Post-translation modification site prediction","uri":"http://edamontology.org/operation_0417"}]}],"name":"PRmePRed","operating_system":["Linux","Mac","Windows"],"owner":"migle_sur","publication":[{"doi":"10.1371/journal.pone.0183318","metadata":{"abstract":"Protein methylation is an important Post-Translational Modification (PTMs) of proteins. Argi-nine methylation carries out and regulates several important biological functions, including gene regulation and signal transduction. Experimental identification of arginine methylation site is a daunting task as it is costly as well as time and labour intensive. Hence reliable prediction tools play an important task in rapid screening and identification of possible methylation sites in proteomes. Our preliminary assessment using the available prediction methods on collected data yielded unimpressive results. This motivated us to perform a comprehensive data analysis and appraisal of features relevant in the context of biological significance, that led to the development of a prediction tool PRmePRed with better performance. The PRmePRed perform reasonably well with an accuracy of 84.10%, 82.38% sensitivity, 83.77% specificity, and Matthew\u2019s correlation coefficient of 66.20% in 10-fold cross-validation. PRmePRed is freely available at http://bioinfo.icgeb.res.in/PRmePRed/.","authors":[{"name":"Gupta D."},{"name":"Joy J."},{"name":"Kumar P."},{"name":"Pandey A."}],"citationCount":36,"date":"2017-08-01T00:00:00Z","journal":"PLoS ONE","title":"PRmePRed: A protein arginine methylation prediction tool"},"pmcid":"PMC5557562","pmid":"28813517","type":["Primary"]}],"topic":[{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"}],"validated":1},"bioschemas":{"name":"PRmePRed","home":"https://bio.tools/prmepred","summary":"Protein arginine methylation prediction tool.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:prmepred/web/bioinfo.icgeb.res.in","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":21,"citations":[{"count":2,"year":"2019"},{"count":2,"year":"2021"},{"count":2,"year":"2025"},{"count":3,"year":"2020"},{"count":3,"year":"2022"},{"count":3,"year":"2023"},{"count":6,"year":"2024"}],"doi":"10.1371/journal.pone.0183318","pmcid":"PMC5557562","pmid":"28813517","ref_count":26,"refs":[{"count":1,"year":"1992"},{"count":1,"year":"2005"},{"count":1,"year":"2008"},{"count":1,"year":"2010"},{"count":1,"year":"2011"},{"count":1,"year":"2012"},{"count":1,"year":"2015"},{"count":1,"year":"2016"},{"count":1,"year":"2017"},{"count":1,"year":"2018"},{"count":2,"year":"1999"},{"count":2,"year":"2006"},{"count":2,"year":"2007"},{"count":2,"year":"2009"},{"count":2,"year":"2014"},{"count":3,"year":"2004"},{"count":3,"year":"2013"}],"title":"PRmePRed: A protein arginine methylation prediction tool.","year":2017}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redir