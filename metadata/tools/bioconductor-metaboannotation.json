{"tool_name":"bioconductor-metaboannotation","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-metaboannotation","home":"https://bioconductor.org/packages/MsBackendMsp","license":"Artistic-2.0","summary":"Mass spectrometry (MS) data backend supporting import and handling of MS/MS spectra from NIST MSP Format (msp) files. Import of data from files with different MSP *flavours* is supported. Objects from this package add support for MSP files to Bioconductor's Spectra package. This package is thus not supposed to be used without the Spectra package that provides a complete infrastructure for MS data handling.","addition_date":"2026-08-30T02:45:50.131543Z","last_update_date":"2026-09-01T06:33:12.732196Z","tool_type":["Command-line tool","Library"],"version":["1.16.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-metaboannotation","credit":[{"name":"Johannes Rainer","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Michael Witting","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Neumann Steffen","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/MsBackendMsp"}],"edit_permission":{"type":"private"},"name":"MetaboAnnotation","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.3390/metabo12020173"}]},"bioschemas":{"name":"MetaboAnnotation","home":"https://bio.tools/bioconductor-metaboannotation","license":"Artistic-2.0","version":"1.16.0","summary":"High level functions to assist in annotation of (metabolomics) data sets. These include functions to perform simple tentative annotations based on mass matching but also functions to consider m/z and retention times for annotation of LC-MS features given that respective reference values are available. In addition, the function provides high-level functions to simplify matching of LC-MS/MS spectra against spect