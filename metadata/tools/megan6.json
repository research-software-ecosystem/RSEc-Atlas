{"tool_name":"megan6","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"megan6","home":"http://ab.inf.uni-tuebingen.de/software/megan6/","license":"Proprietary","summary":"Comprehensive toolbox for interactively analyzing microbiome data. It can perform taxonomic analysis using the NCBI taxonomy. Perform functional analysis using InterPro2GO, SEED, eggNOG or KEGG. Make bar chartsm word clouds, Coronoi tree maps and other charts. Perform PCoA, clustering and networks.","addition_date":"2017-08-20T15:57:56Z","last_update_date":"2024-11-25T14:05:28.732157Z","tool_type":["Desktop application"],"collections":["Animal and Crop Genomics"],"biotools_curie":"biotools:megan6","credit":[{"email":"daniel.huson@uni-tuebingen.de","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://ab.inf.uni-tuebingen.de/software/megan6/getting-started/"}],"edit_permission":{"authors":["animalandcropgenomics"],"type":"group"},"function":[{"operation":[{"term":"Phylogenetic tree generation","uri":"http://edamontology.org/operation_0323"},{"term":"Phylogenetic tree visualisation","uri":"http://edamontology.org/operation_0567"},{"term":"Taxonomic classification","uri":"http://edamontology.org/operation_3460"}]}],"name":"MEGAN6","operating_system":["Linux","Mac","Windows"],"owner":"admin","publication":[{"doi":"10.1101/gr.120618.111","metadata":{"abstract":"A major challenge in the analysis of environmental sequences is data integration. The question is how to analyze different types of data in a unified approach, addressing both the taxonomic and functional aspects. To facilitate such analyses, we have substantially extended MEGAN, a widely used taxonomic analysis program. The new program, MEGAN4, provides an integrated approach to the taxonomic and functional analysis of metagenomic, metatranscriptomic, metaproteomic, and rRNA data. While taxonomic analysis is performed based on the NCBI taxonomy, functional analysis is performed using the SEED classification of subsystems and functional roles or the KEGG classification of pathways and enzymes. A number of examples illustrate how such analyses can be performed, and show that one can also import and compare classification results obtained using others' tools. MEGAN4 is freely available for academic purposes, and installers for all three major operating systems can be downloaded from www-ab.informatik.uni-tuebingen.de/software/megan. \u00a9 2011 by Cold Spring Harbor Laboratory Press.","authors":[{"name":"Huson D.H."},{"name":"Mitra S."},{"name":"Ruscheweyh H.-J."},{"name":"Schuster S.C."},{"name":"Weber N."}],"citationCount":1176,"date":"2011-09-01T00:00:00Z","journal":"Genome Research","title":"Integrative analysis of environmental sequences using MEGAN4"},"pmcid":"PMC3166839","pmid":"21690186","type":["Primary"]}],"topic":[{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"}],"validated":1},"bioschemas":{"name":"MEGAN6","home":"https://bio.tools/megan6","license":"Proprietary","summary":"Comprehensive toolbox for interactively analyzing microbiome data. It can perform taxonomic analysis using the NCBI taxonomy. Perform functional analysis using InterPro2GO, SEED, eggNOG or KEGG. Make bar chartsm word clouds, Coronoi tree maps and other charts. Perform PCoA, clustering and networks.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:megan6/app/ab.inf.uni-tuebingen.de","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":749,"citations":[{"count":1,"year":"-1"},{"count":2,"year":"2011"},{"count":25,"year":"2026"},{"count":30,"year":"2020"},{"count":33,"year":"2012"},{"count":33,"year":"