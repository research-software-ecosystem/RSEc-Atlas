{"tool_name":"microminer","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"microminer","home":"https://www.zbh.uni-hamburg.de/en/forschung/amd/software/microminer.html","license":"Other","summary":"MicroMiner assists in identifying single-residue substitutions in protein structure databases. It searches protein residue environments with local sequence and structural similarity based on the SIENA methodology. Users can search for structural mutation in the entire PDB, their in-house structure collection, or (subsets of) the AlphaFold Database. They can use the method to explore the mutation landscape of proteins with experimental or predicted structures. MicroMiner can be applied to single domains or even protein-protein or protein-ligand interfaces. Several filter options to simplify downstream analysis are available.","addition_date":"2025-12-17T13:59:47.755840Z","last_update_date":"2026-06-16T12:37:05.019651Z","tool_type":["Command-line tool","Web service"],"collections":["de.NBI","de.NBI-biodata"],"biotools_curie":"biotools:microminer","cost":"Free of charge (with restrictions)","credit":[{"email":"pplus.zbh@uni-hamburg.de","name":"ProteinsPlus Support","note":"Primary Contact for Web Service Issues","typeRole":["Primary contact"]},{"email":"software.zbh@uni-hamburg.de","name":"NAOMI ChemBio Suite Support","note":"Primary Contact for Standalone Tool Issues","typeRole":["Primary contact"]},{"name":"University of Hamburg, ZBH - Center for Bioinformatics","rorid":"00g30e956","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["General"],"url":"https://proteins.plus/help/index"}],"edit_permission":{"authors":["MelanieZBH","ehrt"],"type":"group"},"function":[{"input":[{"data":{"term":"UniProt accession","uri":"http://edamontology.org/data_3021"}},{"data":{"term":"Protein structure","uri":"http://edamontology.org/data_1460"},"format":[{"term":"PDB","uri":"http://edamontology.org/format_1476"}]},{"data":{"term":"P