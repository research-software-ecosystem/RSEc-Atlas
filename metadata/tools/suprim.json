{"tool_name":"suprim","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"suprim","home":"http://itg.beckman.illinois.edu/technology_development/software_development/suprim/","summary":"A flexible, modular software package intended for the processing of electron microscopy images is presented. The system consists of a set of image processing tools or filters, written in the C programming language, and a command line style user interface based on the UNIX shell. The pipe and filter structure of UNIX and the availability of command files in the form of shell scripts eases the construction of complex image processing procedures from the simpler tools.","addition_date":"2017-08-03T19:02:16Z","last_update_date":"2024-11-25T15:59:47.338520Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:suprim","credit":[{"email":"itg@beckman.illinois.edu","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://itg.beckman.illinois.edu/index.cgi"}],"documentation":[{"type":["General"],"url":"http://itg.beckman.illinois.edu/technology_development/software_development/suprim/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Image analysis","uri":"http://edamontology.org/operation_3443"}]}],"name":"Suprim","operating_system":["Linux"],"owner":"mbs_import","publication":[{"doi":"10.1006/jsbi.1996.0021","pmid":"8742734"}],"topic":[{"term":"Analytical chemistry","uri":"http://edamontology.org/topic_3370"},{"term":"Electron microscopy","uri":"http://edamontology.org/topic_0611"},{"term":"Imaging","uri":"http://edamontology.org/topic_3382"}],"validated":1},"bioschemas":{"name":"Suprim","home":"https://bio.tools/suprim","summary":"A flexible, modular software package intended for the processing of electron microscopy images is presented. The system consists of a set of image processing tools or filters, written in the C programming language, and a command line style user interface based on the UNIX shell. The pipe and