{"tool_name":"bioconductor-tidyomics","contents":["biotools","oeb","bioschemas"],"fetched_metadata":{"biotools":{"id":"bioconductor-tidyomics","home":"https://bioconductor.org/packages/tidySummarizedExperiment","license":"GPL-3.0","summary":"'tidySingleCellExperiment' is an adapter that abstracts the 'SingleCellExperiment' container in the form of a 'tibble'. This allows *tidy* data manipulation, nesting, and plotting. For example, a 'tidySingleCellExperiment' is directly compatible with functions from 'tidyverse' packages `dplyr` and `tidyr`, as well as plotting with `ggplot2` and `plotly`. In addition, the package provides various utility functions specific to single-cell omics data analysis (e.g., aggregation of cell-level data to pseudobulks).","addition_date":"2026-08-30T02:54:10.786600Z","last_update_date":"2026-10-02T15:55:33.295887Z","tool_type":["Command-line tool","Library"],"version":["1.22.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-tidyomics","credit":[{"name":"Stefano Mangiola","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/tidySummarizedExperiment"}],"edit_permission":{"type":"private"},"name":"tidyomics","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.1038/s41592-024-02299-2"}]},"bioschemas":{"name":"tidyomics","home":"https://bio.tools/bioconductor-tidyomics","license":"MIT","version":"1.8.0","summary":"The tidyomics ecosystem is a set of packages for \u2019omic data analysis that work together in harmony; they share common data representations and API design, consistent with the tidyverse ecosystem. The tidyomics package is designed to make it easy to install and load core packages from the tidyomics ecosystem with a single command.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:bioconductor-tidyomics:1.22.0/cm