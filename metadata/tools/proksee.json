{"tool_name":"proksee","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"proksee","home":"https://proksee.ca","license":"Apache-2.0","summary":"In-depth characterization and visualization of bacterial genomes.","addition_date":"2023-12-18T12:01:32.485646Z","last_update_date":"2024-11-24T14:28:10.624794Z","tool_type":["Command-line tool","Web application"],"accessibility":"Open access","biotools_curie":"biotools:proksee","cost":"Free of charge","credit":[{"email":"gary.vandomselaar@phac-aspc.gc.ca","name":"Gary Van Domselaar","orcidid":"https://orcid.org/0000-0003-1139-4458","typeEntity":"Person"},{"email":"stothard@ualberta.ca","name":"Paul Stothard","orcidid":"https://orcid.org/0000-0003-4263-969X","typeEntity":"Person"}],"edit_permission":{"type":"public"},"function":[{"input":[{"data":{"term":"Nucleic acid sequence","uri":"http://edamontology.org/data_2977"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"},{"term":"FASTQ","uri":"http://edamontology.org/format_1930"}]}],"operation":[{"term":"Genome assembly","uri":"http://edamontology.org/operation_0525"},{"term":"Genome visualisation","uri":"http://edamontology.org/operation_3208"},{"term":"Mapping","uri":"http://edamontology.org/operation_2429"},{"term":"Sequence assembly validation","uri":"http://edamontology.org/operation_3180"},{"term":"Sequence assembly visualisation","uri":"http://edamontology.org/operation_3184"}]}],"name":"Proksee","operating_system":["Linux","Mac","Windows"],"owner":"Pub2Tools","publication":[{"doi":"10.1093/nar/gkad326","metadata":{"abstract":"Proksee (https://proksee.ca) provides users with a powerful, easy-To-use, and feature-rich system for assembling, annotating, analysing, and visualizing bacterial genomes. Proksee accepts Illumina sequence reads as compressed FASTQ files or pre-Assembled contigs in raw, FASTA, or GenBank format. Alternatively, users can supply a GenBank accession or a previously generated Proksee map in JSON format. Proksee then performs assembly (for raw sequence data), generates a graphical map, and provides an interface for customizing the map and launching further analysis jobs. Notable features of Proksee include unique and informative assembly metrics provided via a custom reference database of assemblies; a deeply integrated high-performance genome browser for viewing and comparing analysis results at individual base resolution (developed specifically for Proksee); an ever-growing list of embedded analysis tools whose results can be seamlessly added to the map or searched and explored in other formats; and the option to export graphical maps, analysis results, and log files for data sharing and research reproducibility. All these features are provided via a carefully designed multi-server cloud-based system that can easily scale to meet user demand and that ensures the web server is robust and responsive.","authors":[{"name":"Chen C.-Y."},{"name":"Enns E."},{"name":"Graham M."},{"name":"Grant J.R."},{"name":"Herman E.K."},{"name":"Mandal A."},{"name":"Marinier E."},{"name":"Stothard P."},{"name":"Van Domselaar G."}],"citationCount":380,"date":"2023-07-05T00:00:00Z","journal":"Nucleic Acids Research","title":"Proksee: In-depth characterization and visualization of bacterial genomes"},"pmcid":"PMC10320063","pmid":"37140037","type":["Primary"]}],"topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]},"bioschemas":{"name":"Proksee","home":"https://bio.tools/proksee","license":"Apache-2.0","summary":"In-depth characterization and visualization of bacterial genomes.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:proksee/cmd/prok