{"tool_name":"anota","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-anota","version":"1.58.0","home":"https://bioconductor.org/packages/3.22/bioc/html/anota.html","license":"GPL-3","summary":"ANalysis Of Translational Activity (ANOTA).","identifiers":["biotools:anota","doi:10.1093/bioinformatics/btr146"],"description":"Genome wide studies of translational control is emerging as a tool to study verious biological conditions. The output from such analysis is both the mRNA level (e.g. cytosolic mRNA level) and the levl of mRNA actively involved in translation (the actively translating mRNA level) for each mRNA. The standard analysis of such data strives towards identifying differential translational between two or more sample classes - i.e. differences in actively translated mRNA levels that are independent of underlying differences in cytosolic mRNA levels. This package allows for such analysis using partial variances and the random variance model. As 10s of thousands of mRNAs are analyzed in parallell the library performs a number of tests to assure that the data set is suitable for such analysis.","license_file":"/lib/R/share/licenses/GPL-3","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-multtest >=2.66.0,<2.67.0","bioconductor-qvalue >=2.42.0,<2.43.0","r-base"],"run":["bioconductor-multtest >=2.66.0,<2.67.0","bioconductor-qvalue >=2.42.0,<2.43.0","r-base"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/anota_1.58.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/anota/anota_1.58.0.tar.gz","https://bioarchive.galaxyproject.org/anota_1.58.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-anota/bioconductor-anota_1.58.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('anota')\""]},"parent_recipe":{"name":"bioconductor-anota","path":"recipes/bioconductor-anota","version":"1.28.0"}},"biotools":{"id":"anota","home":"https://bioconductor.org/packages/anota","license":"GPL-3.0","summary":"Genome wide studies of translational control is emerging as a tool to study verious biological conditions. The output from such analysis is both the mRNA level (e.g. cytosolic mRNA level) and the levl of mRNA actively involved in translation (the actively translating mRNA level) for each mRNA. The standard analysis of such data strives towards identifying differential translational between two or more sample classes - i.e. differences in actively translated mRNA levels that are independent of underlying differences in cytosolic mRNA levels. This package allows for such analysis using partial variances and the random variance model. As 10s of thousands of mRNAs are analyzed in parallell the library performs a number of tests to assure that the data set is suitable for such analysis.","addition_date":"2017-01-17T15:01:54Z","last_update_date":"2026-09-01T06:30:57.311466Z","tool_type":["Command-line tool","Library"],"version":["1.60.0"],"collections":["BioConductor"],"biotools_curie":"biotools:anota","credit":[{"name":"Nahum Sonenberg"},{"name":"Ola Larsson"},{"name":"Robert Nadon"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/anota"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene expression analysis","uri":"http://edamontology.org/operation_2495"}]}],"name":"anota","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.18129/B9.bioc.anota"}],"topic":[{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"anota","home":"https://bio.tools/anota","license":"GPL-3.0-only","version":"1.60.0","summary":"Genome wide studies of translational control is emerg