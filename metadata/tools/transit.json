{"tool_name":"transit","contents":["biocontainers","galaxy","bioschemas","debian","biotools","oeb"],"fetched_metadata":{"biocontainers":{"name":"transit","identifiers":["biotools:transit","doi:10.1371/journal.pcbi.1004401"],"license":"GPL-3.0","summary":"Transit","home_url":"http://github.com/mad-lab/transit","keywords":["Base Sequence","Chromosome Mapping","DNA Transposable Elements","Genome, Bacterial","Molecular Sequence Data","Pattern Recognition, Automated","Programming Languages","Sequence Analysis, DNA","DNA","Sequencing","Mobile genetic elements","Genomics"],"manually_check":true,"total_pulls":3348},"biotools":{"id":"transit","home":"http://saclab.tamu.edu/essentiality/transit/","summary":"A tool for the analysis of Tn-Seq data. It provides an easy to use graphical interface and access to three different analysis methods that allow the user to determine essentiality in a single condition as well as between conditions.","addition_date":"2017-08-03T19:02:53Z","last_update_date":"2024-11-25T14:22:27.846591Z","tool_type":["Desktop application"],"biotools_curie":"biotools:transit","credit":[{"email":"michael.dejesus@tamu.edu","name":"Michael A. DeJesus","orcidid":"http://orcid.org/0000-0003-3867-0299","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://students.cs.tamu.edu/mad/"}],"documentation":[{"type":["General"],"url":"http://transit.readthedocs.io/en/latest/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Transposon prediction","uri":"http://edamontology.org/operation_0427"}]}],"name":"TRANSIT","operating_system":["Linux","Mac","Windows"],"owner":"mbs_import","publication":[{"doi":"10.1371/journal.pcbi.1004401","metadata":{"abstract":"TnSeq has become a popular technique for determining the essentiality of genomic regions in bacterial organisms. Several methods have been developed to analyze the wealth of data that has been obtained through TnSeq experiments. We developed a tool for analyzing Himar1 TnSeq data called TRANSIT. TRANSIT provides a graphical interface to three different statistical methods for analyzing TnSeq data. These methods cover a variety of approaches capable of identifying essential genes in individual datasets as well as comparative analysis between conditions. We demonstrate the utility of this software by analyzing TnSeq datasets of M. tuberculosis grown on glycerol and cholesterol. We show that TRANSIT can be used to discover genes which have been previously implicated for growth on these carbon sources. TRANSIT is written in Python, and thus can be run on Windows, OSX and Linux platforms. The source code is distributed under the GNU GPL v3 license and can be obtained from the following GitHub repository: https://github.com/mad-lab/transit","authors":[{"name":"Ambadipudi C."},{"name":"Baker R."},{"name":"DeJesus M.A."},{"name":"Ioerger T.R."},{"name":"Sassetti C."}],"citationCount":119,"date":"2015-01-01T00:00:00Z","journal":"PLoS Computational Biology","title":"TRANSIT - A Software Tool for Himar1 TnSeq Analysis"},"pmcid":"PMC4598096","pmid":"26447887"}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Mobile genetic elements","uri":"http://edamontology.org/topic_0798"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"bioschemas":{"name":"TRANSIT","home":"https://bio.tools/transit","summary":"A tool for the analysis of Tn-Seq data. It provides an easy to use graphical interface and access to three different analysis methods that allow the user to determine essentiality in a single condition as well as between conditions.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"3.2.3","first_commit":"2019-03-01","conda_name":"transit","conda_version":"3.3.20","summary":"TRANSIT","edam_operations":["Transposon prediction"],"edam_topics":["DNA","Sequencing","Mobile genetic elements"],"toolshed_categories":["Genome annotation"],"toolshed_id":"transit","users_5_years":349,"users_all_time":390,"