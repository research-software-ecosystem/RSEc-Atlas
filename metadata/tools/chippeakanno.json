-chippeakanno/bioconductor-chippeakanno_3.44.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('ChIPpeakAnno')\""]},"parent_recipe":{"name":"bioconductor-chippeakanno","path":"recipes/bioconductor-chippeakanno","version":"3.14.2"}},"biotools":{"id":"chippeakanno","home":"https://bioconductor.org/packages/ChIPpeakAnno","license":"GPL-2.0-or-later","summary":"The package encompasses a range of functions for identifying the closest gene, exon, miRNA, or custom features\u2014such as highly conserved elements and user-supplied transcription factor binding sites. Additionally, users can retrieve sequences around the peaks and obtain enriched Gene Ontology (GO) or Pathway terms. In version 2.0.5 and beyond, new functionalities have been introduced. These include features for identifying peaks associated with bi-directional promoters along with summary statistics (peaksNearBDP), summarizing motif occurrences in peaks (summarizePatternInPeaks), and associating additional identifiers with annotated peaks or enrichedGO (addGeneIDs). The package integrates with various other packages such as biomaRt, IRanges, Biostrings, BSgenome, GO.db, multtest, and stat to enhance its analytical capabilities.","addition_date":"2017-01-17T14:58:03Z","last_update_date":"2026-09-29T12:38:35.110537Z","tool_type":["Command-line tool","Library"],"version":["3.46.1"],"collections":["BioConductor"],"biotools_curie":"biotools:chippeakanno","credit":[{"name":"Claude Gazin"},{"name":"David Lapointe"},{"name":"Haibo Liu"},{"name":"Herv\u00e9 Pag\u00e8s"},{"name":"Jianhong Ou"},{"name":"Jun Yu"},{"name":"Junhui Li"},{"name":"Kai Hu"},{"name":"Lihua Julie Zhu"},{"name":"Michael Green"},{"name":"Nathan Lawson"},{"name":"Ryan Thompson"},{"name":"Simon Lin"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/ChIPpeakAnno"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Sequence coordinates","uri":"http://edamontology.org/data_2012"},"format"