{"tool_name":"pecat","contents":["galaxy","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"pecat","version":"0.0.3","home":"https://github.com/lemene/PECAT","license":"BSD-2-Clause","summary":"A phased error correction and assembly tool.","identifiers":["biotools:pecat","doi:10.1038/s41467-024-47349-7"],"license_file":"LICENSE","build":{"number":2,"run_exports":[null],"skip":true},"requirements":{"build":["make",null,null],"host":["zlib"],"run":["minimap2 >=2.17","racon >=1.4.3","perl >=5.26.2","python >=3.6","samtools >=1.17"]},"source_url":"https://github.com/lemene/PECAT/releases/download/v0.0.3/pecat_source_v0.0.3.tar.gz","test":{"commands":["pecat.pl | grep 'unzip'"]}},"biotools":{"id":"pecat","home":"https://github.com/lemene/PECAT","summary":"De novo diploid genome assembly using long noisy reads.","addition_date":"2024-04-19T10:42:15.957876Z","last_update_date":"2024-11-24T14:02:49.478588Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:pecat","credit":[{"email":"jxwang@mail.csu.edu.cn","name":"Jianxin Wang","typeEntity":"Person"},{"email":"luofeng@clemson.edu","name":"Feng Luo","typeEntity":"Person"},{"email":"xiaochuanle@126.com","name":"Chuanle Xiao","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"De-novo assembly","uri":"http://edamontology.org/operation_0524"},{"term":"Genome assembly","uri":"http://edamontology.org/operation_0525"},{"term":"Haplotype mapping","uri":"http://edamontology.org/operation_0487"},{"term":"Phasing","uri":"http://edamontology.org/operation_3454"},{"term":"k-mer counting","uri":"http://edamontology.org/operation_3472"}]}],"name":"PECAT","owner":"Pub2Tools","publication":[{"doi":"10.1038/s41467-024-47349-7","metadata":{"abstract":"The high sequencing error rate has impeded the application of long noisy reads for diploid genome assembly. Most existing assemblers failed to generate high-quality phased assemblies using long noisy reads. Here, we present PECAT, a Phased Error Correction and Assembly Tool, for reconstructing diploid genomes from long noisy reads. We design a haplotype-aware error correction method that can retain heterozygote alleles while correcting sequencing errors. We combine a corrected read SNP caller and a raw read SNP caller to further improve the identification of inconsistent overlaps in the string graph. We use a grouping method to assign reads to different haplotype groups. PECAT efficiently assembles diploid genomes using Nanopore R9, PacBio CLR or Nanopore R10 reads only. PECAT generates more contiguous haplotype-specific contigs compared to other assemblers. Especially, PECAT achieves nearly haplotype-resolved assembly on B. taurus (Bison\u00d7Simmental) using Nanopore R9 reads and phase block NG50 with 59.4/58.0 Mb for HG002 using Nanopore R10 reads.","authors":[{"name":"Huang N."},{"name":"Luo F."},{"name":"Ni P."},{"name":"Nie F."},{"name":"Wang J."},{"name":"Wang Z."},{"name":"Xiao C."},{"name":"Zhang J."}],"citationCount":2,"date":"2024-12-01T00:00:00Z","journal":"Nature Communications","title":"De novo diploid genome assembly using long noisy reads"},"pmcid":"PMC10997618","pmid":"38580638"}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"}]},"bioschemas":{"name":"PECAT","home":"https://bio.tools/pecat","summary":"De novo diploid genome assembly using long noisy reads.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"0.0.3","first_commit":"2026-05-22","conda_name":"pecat","conda_version":"0.0.3","summary":"Phased error correction and assembly tool for long reads","edam_operations":["Genome assembly","De-novo assembly","Phasing","k-mer counting","Haplotype mapping"],"edam_topics":["Sequence assembly","DNA polymorphism","Mapping"],"toolshed_categories":["Assembly"],"toolshed_id":"pecat","users_5