{"tool_name":"raiss","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"raiss","identifiers":["biotools:raiss","doi:10.1093/bioinformatics/btz466"],"license":"MIT","summary":"SNP summary statistics imputation package","home_url":"http://statistical-genetics.pages.pasteur.fr/raiss/","keywords":["Genome-Wide Association Study","Genotype","Phenotype","Polymorphism, Single Nucleotide","GWAS study","Statistics and probability","Genetics"],"manually_check":true,"total_pulls":0},"biotools":{"id":"raiss","home":"http://statistical-genetics.pages.pasteur.fr/raiss/","license":"MIT","summary":"software package enabling the imputation of SNP summary statistics from the neighboring SNPs by taking advantage of the Linkage desiquilibrium.","addition_date":"2020-01-20T10:07:47Z","last_update_date":"2024-11-24T20:59:22.136271Z","tool_type":["Command-line tool"],"version":["1.0, 2.0"],"collections":["Institut Pasteur"],"accessibility":"Open access","biotools_curie":"biotools:raiss","cost":"Free of charge","credit":[{"email":"hanna.julienne@pasteur.fr","name":"Hanna Julienne","orcidid":"https://orcid.org/0000-0001-8214-9412","typeEntity":"Person","typeRole":["Developer"],"url":"https://research.pasteur.fr/fr/member/hanna-julienne/"},{"email":"hugues.aschard@pasteur.fr","name":"Hugues Aschard","orcidid":"http://orcid.org/0000-0002-7554-6783","typeEntity":"Person","typeRole":["Primary contact"],"url":"https://research.pasteur.fr/fr/member/hugues-aschard/"},{"name":"Bogdan Pasaniuc","orcidid":"https://orcid.org/0000-0002-0227-2056"},{"name":"Huwenbo Shi","orcidid":"https://orcid.org/0000-0001-9886-877X"}],"documentation":[{"type":["General"],"url":"http://statistical-genetics.pages.pasteur.fr/raiss/"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Data","uri":"http://edamontology.org/data_0006"},"format":[{"term":"TSV","uri":"http://edamontology.org/format_3475"}]}],"operation":[{"term":"Statistical calculation","uri":"http://edamontology.org/operation_2238"}],"output":[{"data":{"term":"Data","uri":"http://edamontology.org/data_0006"},"format":[{"term":"TSV","uri":"http://edamontology.org/format_3475"}]}]}],"maturity":"Mature","name":"RAISS","operating_system":["Linux"],"owner":"hmenager","publication":[{"doi":"10.1093/bioinformatics/btz466","metadata":{"abstract":"Multi-trait analyses using public summary statistics from genome-wide association studies (GWASs) are becoming increasingly popular. A constraint of multi-trait methods is that they require complete summary data for all traits. Although methods for the imputation of summary statistics exist, they lack precision for genetic variants with small effect size. This is benign for univariate analyses where only variants with large effect size are selected a posteriori. However, it can lead to strong p-value inflation in multi-trait testing. Here we present a new approach that improve the existing imputation methods and reach a precision suitable for multi-trait analyses. Results: We fine-tuned parameters to obtain a very high accuracy imputation from summary statistics. We demonstrate this accuracy for variants of all effect sizes on real data of 28 GWAS. We implemented the resulting methodology in a python package specially designed to efficiently impute multiple GWAS in parallel.","authors":[{"name":"Aschard H."},{"name":"Julienne H."},{"name":"Pasaniuc B."},{"name":"Shi H."}],"citationCount":14,"date":"2019-11-01T00:00:00Z","journal":"Bioinformatics","title":"RAISS: Robust and accurate imputation from summary statistics"},"pmcid":"PMC6853677","pmid":"31173064","type":["Primary"]}],"topic":[{"term":"GWAS study","uri":"http://edamontology.org/topic_3517"},{"term":"Genetics","uri":"http://edamontology.org/topic_3053"},{"term":"Statistics and probability","uri":"http://edamontology.org/topic_2269"}],"validated":1},"bioschemas":{"name":"RAISS","home":"https://bio.tools/raiss","license":"MIT","version":"1.0, 2.0","s