{"tool_name":"bioconda/proovframe","contents":["bioconda"],"identifiers":["bioconda:proovframe"],"fetched_metadata":{"bioconda":{"name":"proovframe","version":"0.9.7","home":"https://github.com/thackl/proovframe","license":"MIT","summary":"frame-shift correction for long read (meta)genomics","description":"Gene prediction on long reads, aka PacBio and Nanopore, is often impaired by indels causing frameshift. \nProovframe detects and corrects frameshifts in coding sequences from raw long reads or long-read derived assemblies.\n","license_file":"LICENSE","build":{"noarch":"generic","number":1,"run_exports":[null]},"requirements":{"run":["diamond >=2.0.3","minimap2","seqkit","perl","perl-data-dumper","perl-getopt-long","perl-text-wrap","perl-file-path","perl-findbin"]},"source_url":"https://github.com/thackl/proovframe/archive/v0.9.7.tar.gz","test":{"commands":["proovframe map --help","proovframe fix --help","proovframe prf --help"]}}}}