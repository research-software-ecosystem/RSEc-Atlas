{"tool_name":"hicstuff","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"hicstuff","identifiers":["doi:10.5281/zenodo.2620608","doi:10.5281/zenodo.4066363"],"license":"GNU General Public License v3.0","summary":"General purpose stuff to generate and handle hi-c data in its simplest form.","home_url":"https://github.com/koszullab/hicstuff","keywords":["Genomics"],"manually_check":true,"total_pulls":8},"biotools":{"id":"hicstuff","home":"https://github.com/koszullab/hicstuff","license":"BSD-3-Clause","summary":"A lightweight library that generates and handles Hi-C contact maps in either cooler-compatible 2Dbedgraph or instaGRAAL format.","addition_date":"2022-01-20T00:55:59.558977Z","last_update_date":"2022-09-28T09:05:35.122834Z","tool_type":["Library"],"accessibility":"Open access","biotools_curie":"biotools:hicstuff","cost":"Free of charge","credit":[{"email":"cyril.mattheydoret@gmail.com","name":"Cyril Matthey-Doret","orcidid":"https://orcid.org/0000-0002-1126-1535","rorid":"02hdt9m26","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"email":"romain.koszul@pasteur.fr","name":"Romain Koszul","orcidid":"https://orcid.org/0000-0002-3086-1173","rorid":"05etkex69","typeEntity":"Person","typeRole":["Primary contact"],"url":"https://research.pasteur.fr/en/team/spatial-regulation-of-genomes/"},{"email":"axel.cournac@pasteur.fr","name":"Axel Cournac","orcidid":"https://orcid.org/0000-0003-3523-2453","typeEntity":"Person","typeRole":["Contributor","Support"]},{"email":"lyam.baudry@unil.ch","name":"Lyam Baudry","orcidid":"https://orcid.org/0000-0002-9283-674X","typeEntity":"Person","typeRole":["Maintainer"]},{"email":"amaury.bignaud@pasteur.fr","name":"Amaury Bignaud","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Nad\u00e8ge Guiglielmoni","orcidid":"https://orcid.org/0000-0002-6185-1592","typeEntity":"Person","typeRole":["Maintainer","Support"]}],"documentation":[{"type":["General","Installation instructions","User manual"],"url":"https://hicstuff.readthedocs.io/en/latest/#"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Filtering","uri":"http://edamontology.org/operation_3695"},{"term":"Mapping","uri":"http://edamontology.org/operation_2429"},{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"hicstuff","operating_system":["Linux","Mac","Windows"],"owner":"cmdoret","publication":[{"doi":"10.1007/978-1-0716-1390-0_1","metadata":{"abstract":"\u00a9 2022, Springer Science+Business Media, LLC, part of Springer Nature.Over the last decade, genomic proximity ligation approaches have reshaped our vision of chromosomes 3D organizations, from bacteria nucleoids to larger eukaryotic genomes. The different protocols (3Cseq, Hi-C, TCC, MicroC [XL], Hi-CO, etc.) rely on common steps (chemical fixation digestion, ligation\u2026) to detect pairs of genomic positions in close proximity. The most common way to represent these data is a matrix, or contact map, which allows visualizing the different chromatin structures (compartments, loops, etc.) that can be associated to other signals such as transcription, protein occupancy, etc. as well as, in some instances, to biological functions. In this chapter we present and discuss the filtering of the events recovered in proximity ligation experiments as well as the application of the balancing normalization procedure on the resulting contact map. We also describe a computational tool for visualizing normalized contact data dubbed Scalogram. The different processes described here are illustrated and supported by the laboratory custom-made scripts pooled into \u201chicstuff,\u201d an open-access python package accessible on github (https://github.com/koszullab/hicstuff ).","authors":[{"name":"Baudry L."},{"name":"Cournac A."},{"name":"Koszul R."},{"name":"Matthey-Doret C."},{"name":"Moreau P."},{"name":"Mortaza S."}],"date":"2022-01-01T00:00:00Z","journal":"Methods in Molecular Biology","title":"Normalization of Chromosome Contact Maps: Matrix Balancing and Visualization"},"pmid":"34415528"}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]},"bioschemas":{"name":"hicstuff","home":"https://bio.tools/hicstuff","license":"BSD-3-Clause","summary":"A lightweight library that generates and handles Hi-C contact maps in either cooler-compatible 2Dbedgraph or instaGRAAL format.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:hicstuff/lib/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"documentation":{"general":true,"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":8,"citations":[{"count":1,"year":"2023"},{"count":2,"year":"2025"},{"count":2,"year":"2026"},{"count":3,"year":"2024"}],"doi":"10.1007/978-1-0716-1390-0_1","pmid":"34415528","ref_count":0,"refs":[],"title":"Normalization of Chromosome Contact Maps: Matrix Balancing and Visualization.","year":2022}]}],"readme":false,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:hicstuff:3.1.5/cmd/