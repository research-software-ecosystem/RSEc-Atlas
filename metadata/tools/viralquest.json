{"tool_name":"viralquest","contents":["biotools"],"identifiers":["biotools:viralquest"],"fetched_metadata":{"biotools":{"id":"viralquest","home":"https://github.com/gabrielvpina/viralquest/","summary":"ViralQuest is an interactive pipeline designed for the post-assembly analysis and characterization of viral sequences derived from high-throughput sequencing (HTS) metagenomic data. It automates identification, performs functional annotation, and generates comprehensive, visual HTML reports for in-depth virome analysis.","addition_date":"2026-11-04T10:30:27.555471Z","last_update_date":"2026-11-04T10:30:27.559113Z","biotools_curie":"biotools:viralquest","credit":[{"email":"ericgdp@gmail.com","name":"Eric Roberto Guimar\u00e3es Rocha Aguiar","orcidid":"https://orcid.org/0000-0002-8143-5756","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Sequence assembly","uri":"http://edamontology.org/operation_0310"},{"term":"Taxonomic classification","uri":"http://edamontology.org/operation_3460"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"ViralQuest","owner":"pub2tools2024","publication":[{"doi":"10.1186/S12859-026-06391-6","pmcid":"PMC12990509","pmid":"41667950"}],"topic":[{"term":"Bioinformatics","uri":"http://edamontology.org/topic_0091"},{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Sequence sites, features and motifs","uri":"http://edamontology.org/topic_0160"},{"term":"Virology","uri":"http://edamontology.org/topic_0781"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]}}}