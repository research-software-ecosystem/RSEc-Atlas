{"tool_name":"bioconductor-buscorrect","contents":["bioconda","bioconductor","biocontainers","biotools","oeb"],"identifiers":["biotools:bioconductor-buscorrect","bioconductor:buscorrect","bioconda:bioconductor-buscorrect"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-buscorrect","identifiers":["doi:10.18129/b9.bioc.buscorrect"],"license":"GPL (>= 2)","summary":"Batch Effects Correction with Unknown Subtypes","home_url":"https://bioconductor.org/packages/3.8/bioc/html/BUScorrect.html","keywords":["Clustering"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-buscorrect","home":"https://bioconductor.org/packages/BUScorrect","license":"GPL-2.0-or-later","summary":"High-throughput experimental data are accumulating exponentially in public databases. However, mining valid scientific discoveries from these abundant resources is hampered by technical artifacts and inherent biological heterogeneity. The former are usually termed \"batch effects,\" and the latter is often modelled by \"subtypes.\" The R package BUScorrect fits a Bayesian hierarchical model, the Batch-effects-correction-with-Unknown-Subtypes model (BUS), to correct batch effects in the presence of unknown subtypes. BUS is capable of (a) correcting batch effects explicitly, (b) grouping samples that share similar characteristics into subtypes, (c) identifying features that distinguish subtypes, and (d) enjoying a linear-order computation complexity.","addition_date":"2026-10-02T16:05:32.413649Z","last_update_date":"2026-10-02T16:05:32.418158Z","tool_type":["Command-line tool","Library"],"version":["1.30.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-buscorrect","credit":[{"name":"Xiangyu Luo"},{"name":"Yingying Wei"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/BUScorrect"}],"edit_permission":{"type":"private"},"name":"BUScorrect","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools"},"bioconductor"