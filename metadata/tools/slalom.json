{"tool_name":"slalom","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"slalom","home":"https://bioconductor.org/packages/slalom","license":"GPL-2.0","summary":"slalom is a scalable modelling framework for single-cell RNA-seq data that uses gene set annotations to dissect single-cell transcriptome heterogeneity, thereby allowing to identify biological drivers of cell-to-cell variability and model confounding factors. The method uses Bayesian factor analysis with a latent variable model to identify active pathways (selected by the user, e.g. KEGG pathways) that explain variation in a single-cell RNA-seq dataset. This an R/C++ implementation of the f-scLVM Python package. See the publication describing the method at https://doi.org/10.1186/s13059-017-1334-8.","addition_date":"2018-07-26T16:49:59Z","last_update_date":"2018-12-10T12:59:00Z","tool_type":["Library"],"version":["1.34.0"],"collections":["BioConductor"],"biotools_curie":"biotools:slalom","cost":"Free of charge","credit":[{"name":"Davis McCarthy","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Florian Buettner","typeEntity":"Person","typeRole":["Developer"]},{"name":"John Marioni","typeEntity":"Person","typeRole":["Developer"]},{"name":"Naruemon Pratanwanich","typeEntity":"Person","typeRole":["Developer"]},{"name":"Oliver Stegle","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/slalom"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]},{"operation":[{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"slalom","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"RNA-seq","uri":"http://edamontology.org/topic_3170"},{"term":"Sequencing","uri":"