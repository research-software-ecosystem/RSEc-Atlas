{"tool_name":"aragorn","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"aragorn","identifiers":[],"license":"GPL-2.0+","summary":"Trna and tmrna detection in nucleotide sequences","home_url":"http://mbio-serv2.mbioekol.lu.se/ARAGORN/","keywords":[],"manually_check":true,"total_pulls":6635},"biotools":{"id":"aragorn","home":"http://www.ansikte.se/ARAGORN/","license":"Not licensed","summary":"ARAGORN detects tRNA, mtRNA info about tmRNA, and tmRNA genes","addition_date":"2022-03-16T09:15:31.291929Z","last_update_date":"2022-03-16T09:15:31.294464Z","tool_type":["Web application"],"accessibility":"Open access","biotools_curie":"biotools:aragorn","cost":"Free of charge","credit":[{"email":"bcanback@thep.lu.se","name":"Bjorn Canback"},{"name":"Dean Laslett"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene prediction","uri":"http://edamontology.org/operation_2454"}]}],"name":"aragorn","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1093/nar/gkh152","metadata":{"abstract":"A computer program, ARAGORN, identifies tRNA and tmRNA genes. The program employs heuristic algorithms to predict tRNA secondary structure, based on homology with recognized tRNA consensus sequences and ability to form a base-paired cloverleaf. tmRNA genes are identified using a modified version of the BRUCE program. ARAGORN achieves a detection sensitivity of 99% from a set of 1290 eubacterial, eukaryotic and archaeal tRNA genes and detects all complete tmRNA sequences in the tmRNA database, improving on the performance of the BRUCE program. Recently discovered tmRNA genes in the chloroplasts of two species from the 'green' algae lineage are detected. The output of the program reports the proposed tRNA secondary structure and, for tmRNA genes, the secondary structure of the tRNA domain, the tmRNA gene sequence, the tag peptide and a list of organisms with matching tmRNA peptide tags.","authors":[{"name":"Canback B."},{"name":"Laslett D."}],"citationCount":1394,"date":"2004-03-01T00:00:00Z","journal":"Nucleic Acids Research","title":"ARAGORN, a program to detect tRNA genes and tmRNA genes in nucleotide sequences"},"pmcid":"PMC373265","pmid":"14704338"}],"topic":[{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"}],"validated":1},"bioschemas":{"name":"aragorn","home":"https://bio.tools/aragorn","license":"Not licensed","summary":"ARAGORN detects tRNA, mtRNA info about tmRNA, and tmRNA genes","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:aragorn/web/www.ansikte.se","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":1961,"citations":[{"count":2,"year":"-1"},{"count":2,"year":"2004"},{"count":7,"year":"2006"},{"count":7,"year":"2007"},{"count":8,"year":"2008"},{"count":11,"year":"2009"},{"count":13,"year":"2010"},{"count":27,"year":"2011"},{"count":39,"year":"2012"},{"count":45,"year":"2013"},{"count":59,"year":"2015"},{"count":80,"year":"2014"},{"count":104,"year":"2016"},{"count":105,"year":"2018"},{"count":119,"year":"2017"},{"count":124,"year":"2026"},{"count":146,"year":"2024"},{"count":153,"year":"2020"},{"count":167,"year":"2023"},{"count":174,"year":"2021"},{"count":184,"year":"2019"},{"count":184,"year":"2025"},{"count":201,"year":"2022"}],"doi":"10.1093/nar/gkh152","pmcid":"PMC373265","pmid":"14704338","ref_count":13,"refs":[{"count":1,"year":"1974"},{"count":1,"year":"1985"},{"count":1,"year":"1991"},{"count":1,"year":"1997"},{"count":1,"year":"2000"},{"count":1,"year":"2003"},{"count":1,"year":"2004"},{"count":2,"year":"1994"},{"count":2,"year":"1998"},{"count":2,"year":"2002"}],