{"tool_name":"easyprot","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"easyprot","home":"http://easyprot.unige.ch/","summary":"Graphical and software platform for the analysis of MS/MS data.","addition_date":"2017-01-17T14:51:18Z","last_update_date":"2024-11-25T14:15:56.727492Z","tool_type":["Command-line tool","Desktop application"],"collections":["Proteomics","ms-utils"],"biotools_curie":"biotools:easyprot","credit":[{"email":"florent.gluck@unige.ch","name":"Florent Gluck","typeEntity":"Person","typeRole":["Maintainer"]},{"email":"webmaster@ms-utils.org","typeEntity":"Person","typeRole":["Documentor"],"url":"http://ms-utils.org"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"operation":[{"term":"Protein fragment weight comparison","uri":"http://edamontology.org/operation_2929"}]}],"name":"EasyProt","owner":"msutils_import","publication":[{"doi":"10.1016/j.jprot.2012.12.012","metadata":{"abstract":"High throughput protein identification and quantification analysis based on mass spectrometry are fundamental steps in most proteomics projects. Here, we present EasyProt (available at http://easyprot.unige.ch), a new platform for mass spectrometry data processing, protein identification, quantification and unexpected post-translational modification characterization. EasyProt provides a fully integrated graphical experience to perform a large part of the proteomic data analysis workflow. Our goal was to develop a software platform that would fulfill the needs of scientists in the field, while emphasizing ease-of-use for non-bioinformatician users. Protein identification is based on OLAV scoring schemes and protein quantification is implemented for both, isobaric labeling and label-free methods. Additional features are available, such as peak list processing, isotopic correction, spectra filtering, charge-state deconvolution and spectra merging. To illustrate the EasyProt platform, we present two identification and quantification workflows based on isobaric tagging and label-free methods. \u00a9 2012 Elsevier B.V.","authors":[{"name":"Antinori P."},{"name":"Dayon L."},{"name":"Fetaud V."},{"name":"Geiser L."},{"name":"Gluck F."},{"name":"Hochstrasser D."},{"name":"Hoogland C."},{"name":"Lisacek F."},{"name":"Muller M."},{"name":"Nikitin F."},{"name":"Pasquarello C."},{"name":"Robin X."},{"name":"Sanchez J.-C."},{"name":"Scherl A."},{"name":"Zufferey A."}],"citationCount":60,"date":"2013-02-01T00:00:00Z","journal":"Journal of Proteomics","title":"EasyProt - An easy-to-use graphical platform for proteomics data analysis"},"pmid":"23277275","type":["Primary"]}],"topic":[{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"}],"validated":1},"bioschemas":{"name":"EasyProt","home":"https://bio.tools/easyprot","summary":"Graphical and software platform for the analysis of MS/MS data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:easyprot/app/easyprot.unige.ch","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":35,"citations":[{"count":1,"year":"2019"},{"count":1,"year":"2022"},{"count":3,"year":"2016"},{"count":4,"year":"2017"},{"count":4,"year":"2018"},{"count":4,"year":"2020"},{"count":5,"year":"2014"},{"count":6,"year":"2015"},{"count":7,"year":"2013"}],"doi":"10.1016/j.jprot.2012.12.012","pmid":"23277275","ref_count":0,"refs":[],"title":"EasyProt--an easy-to-use graphical platform for proteomics data analysis.","year":2012}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":408,"ssl":null,"ssl_err":null}},"support":{"email":true}},{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:easyprot/c