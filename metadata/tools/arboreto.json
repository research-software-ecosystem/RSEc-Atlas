{"tool_name":"arboreto","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"arboreto","identifiers":["biotools:arboreto","doi:10.1093/BIOINFORMATICS/BTY916"],"license":"BSD 3-Clause \"New\" or \"Revised\" License","summary":"Scalable gene regulatory network inference using tree-based ensemble regressors","home_url":"https://github.com/tmoerman/arboreto","keywords":["Molecular interactions, pathways and networks","RNA-Seq","Gene expression","Clustering","Gene Expression","Transcription Factors"],"manually_check":true,"total_pulls":0},"biotools":{"id":"arboreto","home":"http://arboreto.readthedocs.io","license":"BSD-3-Clause","summary":"efficient and scalable inference of gene regulatory networks.\n\nUsage Example \u2014 arboreto 0.1.5 documentation.\n\nFree document hosting provided by Read the Docs.","addition_date":"2020-09-03T19:12:07Z","last_update_date":"2020-09-08T14:31:51Z","version":["0.1.5"],"collections":["KU Leuven","VIB"],"biotools_curie":"biotools:arboreto","credit":[{"email":"stein.aerts@kuleuven.vib.be","name":"Stein Aerts","orcidid":"https://orcid.org/0000-0002-8006-0315","typeEntity":"Person"}],"documentation":[{"type":["General"],"url":"https://arboreto.readthedocs.io/en/latest/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene regulatory network prediction","uri":"http://edamontology.org/operation_2437"}]}],"name":"Arboreto","owner":"bits@vib.be","publication":[{"doi":"10.1093/BIOINFORMATICS/BTY916","metadata":{"abstract":"\u00a9 The Author(s) 2018.Inferring a Gene Regulatory Network (GRN) from gene expression data is a computationally expensive task, exacerbated by increasing data sizes due to advances in high-Throughput gene profiling technology, such as single-cell RNA-seq. To equip researchers with a toolset to infer GRNs from large expression datasets, we propose GRNBoost2 and the Arboreto framework. GRNBoost2 is an efficient algorithm for regulatory network inference using gradient boosting, based on the GENIE3 architecture. Arboreto is a computational framework that scales up GRN inference algorithms complying with this architecture. Arboreto includes both GRNBoost2 and an improved implementation of GENIE3, as a user-friendly open source Python package.","authors":[{"name":"Aerts J."},{"name":"Aerts S."},{"name":"Aibar Santos S."},{"name":"Bravo Gonzalez-Blas C."},{"name":"Moerman T."},{"name":"Moreau Y."},{"name":"Simm J."}],"citationCount":45,"date":"2019-06-01T00:00:00Z","journal":"Bioinformatics","title":"GRNBoost2 and Arboreto: Efficient and scalable inference of gene regulatory networks"},"pmid":"30445495"}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"bioschemas":{"name":"Arboreto","home":"https://bio.tools/arboreto","license":"BSD-3-Clause","version":"0.1.5","summary":"efficient and scalable inference of gene regulatory networks.\n\nUsage Example \u2014 arboreto 0.1.5 documentation.\n\nFree document hosting provided by Read the Docs.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:arboreto:0.1.5/undefined/arboreto.readthedocs.io","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":320,"citations":[{"count":3,"year":"2019"},{"count":13,"year":"2020"},{"count":21,"year":"2022"},{"count":32,"year":"2021"},{"count":54,"year":"2026"},{"count":57,"year":"2023"},{"count":63,"year":"2025"},{"count":77,"year":"2024"}],"doi":"10.1093/bioinformatics/bty916","pmid":"30445495","ref_count":0