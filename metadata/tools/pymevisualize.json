{"tool_name":"pymevisualize","contents":["biotools","oeb"],"identifiers":["biotools:pymevisualize"],"fetched_metadata":{"biotools":{"id":"pymevisualize","home":"https://python-microscopy.org/","summary":"an open-source tool for exploring 3D super-resolution data.\n\nLocalization-based super-resolution microscopy techniques such as PALM, STORM, and PAINT are increasingly critical tools for biological discovery. These methods generate lists of single fluorophore positions that capture nanoscale structural details of subcellular organisation, but to develop biological insight, we must post-process and visualize this data in a meaningful way. A large number of algorithms have been developed for localization post-processing, transforming point data into representations which approximate traditional microscopy images, and performing specific quantitative analysis directly on points. Implementations of these algorithms typically stand in isolation, necessitating complex workflows involving multiple different software packages","addition_date":"2021-01-18T11:38:20Z","last_update_date":"2026-11-12T14:25:02.914800Z","biotools_curie":"biotools:pymevisualize","credit":[{"email":"d.baddeley@auckland.ac.nz","name":"David Baddeley","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Mapping","uri":"http://edamontology.org/operation_2429"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"PYMEVisualize","owner":"zsmag19","publication":[{"doi":"10.1038/s41592-021-01165-9","type":["Primary"]},{"doi":"10.1101/2020.09.29.315671","type":["Preprint"]}],"topic":[{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pymevisualize/undefined/python-microscopy.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1101/2020.09.29.315671","pmcid":null,"pmid":null,"ref_count":0,"refs":[],"title":null,"year":null}]},{"entries":[{"cit_count":26,"citations":[{"count":1,"year":2021},{"count":3,"year":2024},{"count":3,"year":2026},{"count":5,"year":2022},{"count":7,"year":2023},{"count":7,"year":2025}],"doi":"10.1038/s41592-021-01165-9","pmid":"34002092","ref_count":10,"refs":[{"count":1,"year":2010},{"count":1,"year":2011},{"count":1,"year":2013},{"count":1,"year":2015},{"count":1,"year":2017},{"count":1,"year":2018},{"count":1,"year":2019},{"count":1,"year":2020},{"count":2,"year":2014}],"title":"PYMEVisualize: an open-source tool for exploring 3D super-resolution data.","year":2021}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/pymevisualize","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}}]}}}