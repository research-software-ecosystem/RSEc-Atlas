{"tool_name":"hdf5array","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-hdf5array","version":"1.38.0","home":"https://bioconductor.org/packages/3.22/bioc/html/HDF5Array.html","license":"Artistic-2.0","summary":"HDF5 datasets as array-like objects in R","identifiers":["biotools:hdf5array","doi:10.1038/nmeth.3252"],"description":"The HDF5Array package is an HDF5 backend for DelayedArray objects. It implements the HDF5Array, H5SparseMatrix, H5ADMatrix, and TENxMatrix classes, 4 convenient and memory-efficient array-like containers for representing and manipulating either: (1) a conventional (a.k.a. dense) HDF5 dataset, (2) an HDF5 sparse matrix (stored in CSR/CSC/Yale format), (3) the central matrix of an h5ad file (or any matrix in the /layers group), or (4) a 10x Genomics sparse matrix. All these containers are DelayedArray extensions and thus support all operations (delayed or block-processed) supported by DelayedArray objects.","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-biocgenerics >=0.56.0,<0.57.0","bioconductor-delayedarray >=0.36.0,<0.37.0","bioconductor-h5mread >=1.2.0,<1.3.0","bioconductor-iranges >=2.44.0,<2.45.0","bioconductor-rhdf5 >=2.54.0,<2.55.0","bioconductor-s4arrays >=1.10.0,<1.11.0","bioconductor-s4vectors >=0.48.0,<0.49.0","bioconductor-sparsearray >=1.10.0,<1.11.0","r-base","r-matrix"],"run":["bioconductor-biocgenerics >=0.56.0,<0.57.0","bioconductor-delayedarray >=0.36.0,<0.37.0","bioconductor-h5mread >=1.2.0,<1.3.0","bioconductor-iranges >=2.44.0,<2.45.0","bioconductor-rhdf5 >=2.54.0,<2.55.0","bioconductor-s4arrays >=1.10.0,<1.11.0","bioconductor-s4vectors >=0.48.0,<0.49.0","bioconductor-sparsearray >=1.10.0,<1.11.0","r-base","r-matrix"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/HDF5Array_1.38.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HDF5Arra