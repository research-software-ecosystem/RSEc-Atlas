{"tool_name":"diffusion","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"diffusion","home":"http://apps.cytoscape.org/apps/Diffusion","license":"MIT","summary":"A Cytoscape application for network propagation for finding new genes that are most relevant to a disease state.","addition_date":"2018-06-25T13:37:36Z","last_update_date":"2024-11-25T13:49:49.559294Z","tool_type":["Plug-in"],"accessibility":"Open access","biotools_curie":"biotools:diffusion","cost":"Free of charge","credit":[{"email":"carlin.daniel@gmail.com","name":"Daniel E. Carlin","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/idekerlab/heat-diffusion"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Gene identifier","uri":"http://edamontology.org/data_1025"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}],"operation":[{"term":"Gene functional annotation","uri":"http://edamontology.org/operation_3672"},{"term":"Network simulation","uri":"http://edamontology.org/operation_3562"},{"term":"Pathway or network prediction","uri":"http://edamontology.org/operation_3439"},{"term":"Variant prioritisation","uri":"http://edamontology.org/operation_3226"}],"output":[{"data":{"term":"Pathway or network","uri":"http://edamontology.org/data_2600"},"format":[{"term":"Graph format","uri":"http://edamontology.org/format_3617"}]}]}],"maturity":"Mature","name":"Diffusion","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"doi":"10.1371/journal.pcbi.1005598","metadata":{"abstract":"Network propagation is an important and widely used algorithm in systems biology, with applications in protein function prediction, disease gene prioritization, and patient stratification. However, up to this point it has required significant expertise to run. Here we extend the popular network analysis program Cytoscape to perform network propagation