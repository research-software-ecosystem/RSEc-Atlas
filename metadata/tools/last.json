{"tool_name":"last","contents":["biocontainers","galaxy","bioschemas","debian","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"last","version":"1654","home":"https://gitlab.com/mcfrith/last","documentation":"https://gitlab.com/mcfrith/last/-/blob/1654/doc/last-cookbook.rst","license":"GPL-3.0-or-later","summary":"LAST finds & aligns related regions of sequences.","identifiers":["biotools:last","usegalaxy-eu:last_train","usegalaxy-eu:last_al","usegalaxy-eu:last_db","usegalaxy-eu:last_split"],"description":"LAST finds & aligns related regions of sequences. It is designed for moderately large data (e.g. genomes, DNA reads, proteomes).  It's especially good at: finding rearrangements and recombinations; finding DNA-versus-protein related regions; unusual data like AT-rich DNA; sensitive DNA-DNA search.","license_file":"COPYING.txt","build":{"number":1,"run_exports":[null]},"requirements":{"build":[null,null,null,"make"],"host":["zlib"],"run":["python","pillow","parallel"]},"source_url":"https://gitlab.com/mcfrith/last/-/archive/1654/last-1654.tar.gz","test":{"commands":["lastal -h","lastdb -h","last-split -h","last-merge-batches -h","maf-convert -h","last-dotplot -h","last-map-probs -h","last-postmask -h","last-train -h","last-pair-probs -h","fastq-interleave -h","last-postmask -h","maf-convert -h","maf-cut -h","maf-join -h","maf-sort -h","maf-swap -h","parallel-fasta -h","parallel-fastq -h"]}},"biocontainers":{"name":"last","identifiers":["biotools:last","doi:10.1093/nar/gkq010"],"license":"GPL-3.0","summary":"LAST finds similar regions between sequences, and aligns them.","home_url":"http://last.cbrc.jp/","keywords":["Animals","Chromosome Mapping","Computer Simulation","Drosophila","Drosophila melanogaster","Probability","Sequence Alignment","Sequence Analysis, DNA","Genomics","Comparative genomics"],"manually_check":true,"total_pulls":35},"biotools":{"id":"last","home":"http://last.cbrc.jp/","license":"GPL-3.0","summary":"Short read alignment program incorporating quality scores","addition_date":"2017-01-13T13:15:13Z","last_update_date":"2024-11-24T20:31:21.432303Z","tool_type":["Web service"],"biotools_curie":"biotools:last","credit":[{"email":"last-align@googlegroups.com","name":"LAST Support","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://last.cbrc.jp/doc/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Sequence alignment","uri":"http://edamontology.org/operation_0292"}]}],"maturity":"Mature","name":"LAST","operating_system":["Linux","Mac","Windows"],"owner":"seqwiki_import","publication":[{"doi":"10.1093/nar/gkq010","metadata":{"abstract":"New DNA sequencing technologies have achieved breakthroughs in throughput, at the expense of higher error rates. The primary way of interpreting biological sequences is via alignment, but standard alignment methods assume the sequences are accurate. Here, we describe how to incorporate the per-base error probabilities reported by sequencers into alignment. Unlike existing tools for DNA read mapping, our method models both sequencer errors and real sequence differences. This approach consistently improves mapping accuracy, even when the rate of real sequence difference is only 0.2%. Furthermore, when mapping Drosophila melanogaster reads to the Drosophila simulans genome, it increased the amount of correctly mapped reads from 49 to 66%. This approach enables more effective use of DNA reads from organisms that lack reference genomes, are extinct or are highly polymorphic. \u00a9 The Author(s) 2010. Published by Oxford University Press.","authors":[{"name":"Frith M.C."},{"name":"Horton P."},{"name":"Wan R."}],"citationCount":63,"date":"2010-01-27T00:00:00Z","journal":"Nucleic Acids Research","title":"Incorporating sequence quality data into alignment improves DNA read mapping"},"pmcid":"PMC2853142","pmid":"20110255"}],"topic":[{"term":"Comparative genomics","uri":"http://edamontology.or