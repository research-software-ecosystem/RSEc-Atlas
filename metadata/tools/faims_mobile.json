{"tool_name":"faims_mobile","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"faims_mobile","home":"https://github.com/ElsevierSoftwareX/SOFTX-D-17-00021","license":"GPL-3.0","summary":"FAIMS is a native Android application that can be used for data capture when doing field work.","addition_date":"2018-08-22T11:17:40Z","last_update_date":"2018-12-10T12:59:01Z","tool_type":["Desktop application"],"biotools_curie":"biotools:faims_mobile","credit":[{"email":"support@fedarch.org","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://faimsproject.atlassian.net/wiki/spaces/FAIMS/overview"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Data handling","uri":"http://edamontology.org/operation_2409"}]}],"name":"FAIMS","operating_system":["Linux"],"owner":"daniel_stefan","publication":[{"doi":"10.1016/j.softx.2017.12.006","metadata":{"abstract":"\u00a9 2017 The AuthorsFAIMS Mobile is a native Android application supported by an Ubuntu server facilitating human-mediated field research across disciplines. It consists of \u2018core\u2019 Java and Ruby software providing a platform for data capture, which can be deeply customised using \u2018definition packets\u2019 consisting of XML documents (data schema and UI) and Beanshell scripts (automation). Definition packets can also be generated using an XML-based domain-specific language, making customisation easier. FAIMS Mobile includes features allowing rich and efficient data capture tailored to the needs of fieldwork. It also promotes synthetic research and improves transparency and reproducibility through the production of comprehensive datasets that can be mapped to vocabularies or ontologies as they are created.","authors":[{"name":"Ballsun-Stanton B."},{"name":"Crook P."},{"name":"Ross S.A."},{"name":"Sobotkova A."}],"citationCount":4,"date":"2018-01-01T00:00:00Z","journal":"SoftwareX","title":"FAIMS Mobile: Flexible, open-source software for field research"},"type":["Primary"]}],"topic":[{"term":"Data acquisition","uri":"http://edamontology.org/topic_3077"}],"validated":1},"bioschemas":{"name":"FAIMS","home":"https://bio.tools/faims_mobile","license":"GPL-3.0","summary":"FAIMS is a native Android application that can be used for data capture when doing field work.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:faims_mobile/app/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1016/j.softx.2017.12.006","ref_count":0,"refs":[]}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"email":true,"issue_tracking":{"public_tracker":null,"resolve_time":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/faims_mobile","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"publications":[],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_t