{"tool_name":"bioconductor-msqrob2","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-msqrob2","home":"https://bioconductor.org/packages/msqrob2","license":"Artistic-2.0","summary":"msqrob2 provides a robust linear mixed model framework for assessing differential abundance in MS-based Quantitative proteomics experiments. Our workflows can start from raw peptide intensities or summarised protein expression values. The model parameter estimates can be stabilized by ridge regression, empirical Bayes variance estimation and robust M-estimation. msqrob2's hurde workflow can handle missing data without having to rely on hard-to-verify imputation assumptions, and, outcompetes state-of-the-art methods with and without imputation for both high and low missingness. It builds on QFeature infrastructure for quantitative mass spectrometry data to store the model results together with the raw data and preprocessed data.","addition_date":"2026-08-30T02:47:06.002768Z","last_update_date":"2026-08-30T02:47:06.004840Z","tool_type":["Command-line tool","Library"],"version":["1.20.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-msqrob2","credit":[{"name":"Adriaan Sticker","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Laurent Gatto","typeEntity":"Person","typeRole":["Developer"]},{"name":"Lieven Clement","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Ludger Goeminne","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Milan Malfait","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Oliver M. Crook","typeEntity":"Person","typeRole":["Developer"]},{"name":"Stijn Vandenbulcke","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/msqrob2"}],"edit_permission":{"type":"private"},"name":"msqrob2","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.1021/acs.analchem.9b04375"},{"doi":"10.1021/acs.analchem.9b04375"},{"doi":"10.1074/mcp.m115.055897"},{"doi":"10.1074/mcp.m115.055897"},{"doi":"10.1074/mcp.ra119.001624"},{"doi":"10.1074/mcp.ra119.001624"}]},"bioschemas":{"name":"msqrob2","home":"https://bio.tools/bioconductor-msqrob2","license":"Artistic-2.0","version":"1.20.0","summary":"msqrob2 provides a robust linear mixed model framework for assessing differential abundance in MS-based Quantitative proteomics experiments. Our workflows can start from raw peptide intensities or summarised protein expression values. The model parameter estimates can be stabilized by ridge regression, empirical Bayes variance estimation and robust M-estimation. msqrob2's hurde workflow can handle missing data without having to rely on hard-to-verify imputation assumptions, and, outcompetes state-of-the-art methods with and without imputation for both high and low missingness. It builds on QFeature infrastructure for quantitative mass spectrometry data to store the model results together with the raw data and preprocessed data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-msqrob2:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-msqrob2:1.10.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"summary":{"descr