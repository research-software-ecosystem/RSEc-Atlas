{"tool_name":"pcrtiler","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"pcrtiler","home":"http://pcrtiler.genap.ca/PCRTiler/","summary":"Allows for the automated design of tiled primer pairs for any number of genomic loci. Based on Primer3 and BLAST analysis for cross-hybridization.","addition_date":"2017-03-25T12:40:51Z","last_update_date":"2018-12-10T12:58:58Z","tool_type":["Desktop application","Web application"],"biotools_curie":"biotools:pcrtiler","credit":[{"email":"alain.gervais@USherbrooke.ca","name":"alain.gervais@USherbrooke.ca","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://alaingervais.org/"},{"name":"Contact Form","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://pcrtiler.genap.ca/PCRTiler/contact.jsp"}],"documentation":[{"type":["User manual"],"url":"http://pcrtiler.genap.ca/PCRTiler/tutorial.jsp"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Analysis","uri":"http://edamontology.org/operation_2945"}]},{"operation":[{"term":"PCR primer design","uri":"http://edamontology.org/operation_0308"},{"term":"Primer and probe design","uri":"http://edamontology.org/operation_2419"},{"term":"Primer removal","uri":"http://edamontology.org/operation_3237"},{"term":"Splitting","uri":"http://edamontology.org/operation_3359"}]}],"name":"PCRTiler","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"metadata":{"abstract":"Efficiency and specificity of PCR amplification is dependent on several parameters, such as amplicon length, as well as hybridization specificity and melting temperature of primer oligonucleotides. Primer design is thus of critical importance for the success of PCR experiments, but can be a time-consuming and repetitive task, for example when large genomic regions are to be scanned for the presence of a protein of interest by chromatin immunoprecipitation experiments. We present here a webserver that allows the automated design of tiled primer pairs for any number of genomic loci. PCRTiler splits the target DNA sequences into smaller regions, and identifies candidate primers for each sub-region by running the well-known program Primer3 followed by the elimination of primers with a high cross-hybridization potential via BLAST. Tiling density and primer characteristics are specified by the user via a simple and user-friendly interface. The webserver can be accessed at http://pcrtiler.alaingervais.org:8080/PCRTiler. Additionally, users may download a standalone Java-based implementation of this software. Experimental validation of PCRTiler has demonstrated that it produces correct results. We have tiled a region of the human genome, in which 96 of 123 primer pairs worked in the first attempt, and 105 of 123 (85%) could be made to work by optimizing the conditions of the PCR assay. \u00a9 The Author(s) 2010. Published by Oxford University Press.","authors":[{"name":"Gaudreau L."},{"name":"Gervais A.L."},{"name":"Marques M."}],"citationCount":17,"date":"2010-06-02T00:00:00Z","journal":"Nucleic Acids Research","title":"PCRTiler: Automated design of tiled and specific PCR primer pairs"},"pmid":"20519202"}],"topic":[{"term":"Immunoprecipitation experiment","uri":"http://edamontology.org/topic_3656"},{"term":"Laboratory techniques","uri":"http://edamontology.org/topic_3361"},{"term":"Nucleic acids","uri":"http://edamontology.org/topic_0077"},{"term":"PCR experiment","uri":"http://edamontology.org/topic_3519"},{"term":"Probes and primers","uri":"http://edamontology.org/topic_0632"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pcrtiler/app/pcrtiler.genap.ca","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"publications":[{"entries":[{"cit_count":15,"citations":[{"count":1,"year":"2013"},{"count":1,"year":"2016"},{"count":1,"year":"2017"},{"count":1,"year":"2019"},{"count":1,"year":"2022"},{"count":1,"year":"2024"},{"count":2,"year":"2014"},{"count":2,"year":"2018"},{"count":2,"year":"2021"},{"count":3,"year":"2012"}],"doi":"10.1093/nar/gkq485","pmcid":"PMC2896098","pmid":"20519202","ref_count":6,"refs":[{"count":1,"year":"1990"},{"count":1,"year":"2000"},{"count":1,"year":"2006"},{"count":1,"year":"2009"},{"count":2,"year":"2008"}],"title":"PCRTiler: automated design of tiled and specific PCR primer pairs.","year":2010}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":408,"ssl":null,"ssl_err":null}},"support":{"email":true}},{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pcrtiler/web/pcrtiler.genap.ca","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"publications":[{"entries":[{"cit_count":15,"citations":[{"count":1,"year":"2013"},{"count":1,"year":"2016"},{"count":1,"year":"2017"},{"count":1,"year":"2019"},{"count":1,"year":"2022"},{"count":1,"year":"2024"},{"count":2,"year":"2014"},{"count":2,"year":"2018"},{"count":2,"year":"2021"},{"count":3,"year":"2012"}],"doi":"10.1093/nar/gkq485","pmcid":"PMC2896098","pmid":"20519202","ref_count":6,"refs":[{"count":1,"year":"1990"},{"count":1,"year":"2000"},{"count":1,"year":"2006"},{"count":1,"year":"2009"},{"count":2,"year":"2008"}],"title":"PCRTiler: automated design of tiled and specific PCR primer pairs.","year":2010}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":408,"ssl":null,"ssl_err":n