{"tool_name":"mil-adapter","contents":["biotools"],"identifiers":["biotools:mil-adapter"],"fetched_metadata":{"biotools":{"id":"mil-adapter","home":"https://github.com/cvblab/MIL-Adapter","summary":"MIL-Adapter is a novel framework designed for few-shot slide-level classification in computational pathology. It combines Multiple Instance Learning (MIL) aggregation functions with lightweight vision-language adapters to process Whole Slide Images (WSIs) for cancer diagnosis.","addition_date":"2026-11-04T10:31:29.830128Z","last_update_date":"2026-11-04T10:31:29.833217Z","biotools_curie":"biotools:mil-adapter","credit":[{"email":"madeam2@upv.es","name":"Roc\u00edo Del Amor","typeEntity":"Person"},{"email":"pabmees@upv.es","name":"Pablo Meseguer","typeEntity":"Person"},{"email":"vnaranjo@upv.es","name":"Valery Naranjo","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Aggregation","uri":"http://edamontology.org/operation_3436"}]}],"name":"MIL-Adapter: Few-shot Slide-Level Classification","owner":"pub2tools2024","publication":[{"doi":"10.1016/J.MEDIA.2026.103964","pmid":"41616642"}],"topic":[{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Oncology","uri":"http://edamontology.org/topic_2640"},{"term":"Pathology","uri":"http://edamontology.org/topic_0634"}]}}}