{"tool_name":"graphqa","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"graphqa","home":"http://github.com/baldassarreFe/graphqa","summary":"Protein Model Quality Assessment using Graph Convolutional Networks.","addition_date":"2021-01-18T10:37:21Z","last_update_date":"2024-11-24T20:47:06.736723Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:graphqa","credit":[{"email":"azizpour@kth.se","name":"Hossein Azizpour","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Protein folding analysis","uri":"http://edamontology.org/operation_2415"},{"term":"Protein modelling","uri":"http://edamontology.org/operation_0477"},{"term":"Protein structure validation","uri":"http://edamontology.org/operation_0321"}]}],"name":"GraphQA","owner":"Niclaskn","publication":[{"doi":"10.1093/bioinformatics/btaa714","metadata":{"abstract":"Motivation: Proteins are ubiquitous molecules whose function in biological processes is determined by their 3D structure. Experimental identification of a protein's structure can be time-consuming, prohibitively expensive and not always possible. Alternatively, protein folding can be modeled using computational methods, which however are not guaranteed to always produce optimal results. GraphQA is a graph-based method to estimate the quality of protein models, that possesses favorable properties such as representation learning, explicit modeling of both sequential and 3D structure, geometric invariance and computational efficiency. Results: GraphQA performs similarly to state-of-the-art methods despite using a relatively low number of input features. In addition, the graph network structure provides an improvement over the architecture used in ProQ4 operating on the same input features. Finally, the individual contributions of GraphQA components are carefully evaluated.","authors":[{"name":"Azizpour H."},{"name":"Baldassarre F."},{"name":"Elofsson A."},{"name":"Menendez Hurtado D."}],"citationCount":67,"date":"2021-02-01T00:00:00Z","journal":"Bioinformatics","title":"GraphQA: protein model quality assessment using graph convolutional networks"},"pmcid":"PMC8058777","pmid":"32780838"}],"topic":[{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Protein folding, stability and design","uri":"http://edamontology.org/topic_0130"},{"term":"Protein folds and structural domains","uri":"http://edamontology.org/topic_0736"},{"term":"Protein secondary structure","uri":"http://edamontology.org/topic_3542"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}],"validated":1},"bioschemas":{"name":"GraphQA","home":"https://bio.tools/graphqa","summary":"Protein Model Quality Assessment using Graph Convolutional Networks.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:graphqa/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":46,"citations":[{"count":4,"year":"2026"},{"count":7,"year":"2021"},{"count":8,"year":"2023"},{"count":8,"year":"2024"},{"count":9,"year":"2025"},{"count":10,"year":"2022"}],"doi":"10.1093/bioinformatics/btaa714","pmcid":"PMC8058777","pmid":"32780838","ref_count":30,"refs":[{"count":1,"year":"1983"},{"count":1,"year":"1994"},{"count":1,"year":"1995"},{"count":1,"year":"1999"},{"count":1,"year":"2001"},{"count":1,"year":"2004"},{"count":1,"year":"2005"},{"count":1,"year":"2006"},{"count":1,"year":"2007"},{"count":1,"year":"2013"},{"count":1,"year":"2016"},{"count":1,"year":"2020"},{"count":2,"year":"2003"},{"count":2,"year