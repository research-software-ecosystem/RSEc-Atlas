{"tool_name":"deep_transfer_graph_convolutional_network","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"deep_transfer_graph_convolutional_network","home":"https://github.com/senli2018/DTGCN","summary":"We develop a novel deep learning approach for multi-stage malaria parasites recognition in blood smear images using Deep Transfer Graph Convolutional Network (DTGCN). And this work is the first application of GCN on multi-stage malaria parasites recognition in blood smear images. The proposed DTGCN model is based on unsupervised learning by transferring knowledge learnt from source images that contain the discriminative morphology character-istics of multi-stage malaria parasites. These transferred information guarantees the effectiveness on the target parasites recognition.","addition_date":"2021-02-28T05:48:18Z","last_update_date":"2022-12-01T18:58:33.475821Z","biotools_curie":"biotools:deep_transfer_graph_convolutional_network","documentation":[{"type":["General"],"url":"https://github.com/senli2018/DTGCN"}],"edit_permission":{"type":"public"},"name":"Deep Transfer Graph Convolutional Network","owner":"senli2018","topic":[{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Parasitology","uri":"http://edamontology.org/topic_3302"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:deep_transfer_graph_convolutional_network/undefined/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[],"readme":true,"summary":{"description":true},"websi