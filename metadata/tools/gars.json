{"tool_name":"gars","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"gars","home":"https://bioconductor.org/packages/GARS","license":"GPL-2.0-or-later","summary":"Feature selection aims to identify and remove redundant, irrelevant and noisy variables from high-dimensional datasets. Selecting informative features affects the subsequent classification and regression analyses by improving their overall performances. Several methods have been proposed to perform feature selection: most of them relies on univariate statistics, correlation, entropy measurements or the usage of backward/forward regressions. Herein, we propose an efficient, robust and fast method that adopts stochastic optimization approaches for high-dimensional. GARS is an innovative implementation of a genetic algorithm that selects robust features in high-dimensional and challenging datasets.","addition_date":"2018-07-08T16:31:50Z","last_update_date":"2018-12-10T12:59:00Z","tool_type":["Library"],"version":["1.32.0"],"collections":["BioConductor"],"biotools_curie":"biotools:gars","credit":[{"name":"Luca Piacentini"},{"name":"Mattia Chiesa"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/GARS"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Classification","uri":"http://edamontology.org/operation_2990"}]},{"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"}]},{"operation":[{"term":"Regression analysis","uri":"http://edamontology.org/operation_3659"}]}],"name":"GARS","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[{"doi":"10.1186/s12859-020-3400-6"}],"topic":[{"term":"Gene structure","uri":"http://edamontology.org/topic_0114"}],"validated":1},"bioschemas":{"name":"GARS","home":"https://bio.tools/gars","license":"GPL-2.0-or-later","version":"1.32.0","summary":"Feature selection aims to identify and remove redundant, irrelevant and noisy variables from high-dimensional datasets. Selecting informative features affects the subsequent classification and regression analyses by improving their overall performances. Several methods have been proposed to perform feature selection: most of them relies on univariate statistics, correlation, entropy measurements or the usage of backward/forward regressions. Herein, we propose an efficient, robust and fast method that adopts stochastic optimization approaches for high-dimensional. GARS is an innovative implementation of a genetic algorithm that selects robust features in high-dimensional and challenging datasets.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:gars:1.0.0/lib/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"source_packages":true,"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"ref_count":0,"refs":[]}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://bioconductor.org/packages/release/bioc/html/GARS.html"}],"ssl":true,"ssl_err":null}},"support":{"email":true}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:gars:1.10.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:gars:1.12.0