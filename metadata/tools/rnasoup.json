{"tool_name":"rnasoup","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"rnasoup","home":"http://www.bioinf.uni-leipzig.de/~kristin/Software/RNAsoup/?p=index.html","summary":"Post-processing tool of a structural clustering pipeline for structured RNAs (e.g. RNAclust). It requires as input a binary cluster-tree, the minimum free energy (MFE) of the consensus secondary structure for each internal node, and a FASTA file of the input sequences. It detects the optimal partition (i.e. finding the optimal number of clusters/groups) into distinct subtrees where each subtree contains structurally related RNA sequences.","addition_date":"2017-12-18T00:11:54Z","last_update_date":"2018-12-10T12:58:58Z","tool_type":["Command-line tool"],"version":["1.0a"],"biotools_curie":"biotools:rnasoup","credit":[{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.bioinf.uni-leipzig.de/~kristin/"}],"documentation":[{"type":["General"],"url":"http://www.bioinf.uni-leipzig.de/~kristin/Software/RNAsoup/manual.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"}]},{"operation":[{"term":"Processing","uri":"http://edamontology.org/operation_2409"}]}],"name":"RNAsoup","operating_system":["Linux"],"owner":"mbs_import","topic":[{"term":"RNA","uri":"http://edamontology.org/topic_0099"},{"term":"Sequences","uri":"http://edamontology.org/topic_0080"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:rnasoup:1.0a/cmd/www.bioinf.uni-leipzig.de","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"ref_count":0,"refs":[]}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirec