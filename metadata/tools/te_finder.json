{"tool_name":"te_finder","contents":["biotools"],"identifiers":["biotools:te_finder"],"fetched_metadata":{"biotools":{"id":"te_finder","home":"https://forge.inrae.fr/urgi/urgi-anagen/te_finder","license":"CECILL-2.0","summary":"TE Finder is a suite of C++ programs for finding and annotating transposable elements in large eukaryotic genome sequences. Its core pipeline (BLASTER or HASHER, followed by MATCHER, GROUPER and DUSTER) produces pairwise alignments, chains them into consistent diagonal paths, clusters the resulting paths into candidate transposable element families, and filters out low-complexity or spurious matches. BLASTER wraps external BLAST implementations (NCBI BLAST/BLAST+ or WU-BLAST), while HASHER is a self-contained aligner combining k-mer seeding with wavefront alignment (WFA2-lib). TE Finder is the computational engine of the REPET package (TEdenovo and TEannot pipelines) and can also process BLASTER-compatible .align outputs from other tools (RepeatMasker, CENSOR, BLAT...).","addition_date":"2026-11-08T08:38:49.950367Z","last_update_date":"2026-11-08T08:44:05.921572Z","tool_type":["Command-line tool","Suite"],"version":["2.34.1"],"collections":["REPET","URGI"],"accessibility":"Open access","biotools_curie":"biotools:te_finder","cost":"Free of charge","credit":[{"email":"urgi-repet@versailles.inrae.fr","name":"URGI","typeEntity":"Institute","typeRole":["Developer","Maintainer","Provider"],"url":"https://urgi.versailles.inrae.fr/"},{"name":"Etienne Bardet","orcidid":"https://orcid.org/0009-0006-6288-4173","typeEntity":"Person","typeRole":["Developer"]},{"name":"Fran\u00e7oise Alfama-Depauw","orcidid":"https://orcid.org/0000-0003-4448-306X","typeEntity":"Person","typeRole":["Developer"]},{"name":"Hadi Quesneville","orcidid":"https://orcid.org/0000-0003-3001-4908","typeEntity":"Person","typeRole":["Developer","Primary contact"]},{"name":"Mari\u00e8ne Wan","orcidid":"https://orcid.org/0009-0000-4066-7238","typeEntity":"Person","typeRole":["Developer"]},{"name":"Olivier Inizan","orcidid":"https://orcid.org/0000-0002-1137-5794","typeEntity":"Person","typeRole":["Developer"]},{"name":"Benoit Bely","typeEntity":"Person","typeRole":["Developer"]},{"name":"Ga\u00ebl Faroux","typeEntity":"Person","typeRole":["Developer"]},{"name":"Mark Moissette","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"note":"URGI tool page","type":["General"],"url":"https://urgi.versailles.inrae.fr/Tools/TE_finder"},{"type":["General"],"url":"https://forge.inrae.fr/urgi/urgi-anagen/te_finder"}],"edit_permission":{"authors":["johann_confais"],"type":"group"},"function":[{"input":[{"data":{"term":"DNA sequence","uri":"http://edamontology.org/data_3494"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}],"operation":[{"term":"Genome annotation","uri":"http://edamontology.org/operation_0362"},{"term":"Repeat sequence detection","uri":"http://edamontology.org/operation_0379"},{"term":"Sequence alignment","uri":"http://edamontology.org/operation_0292"},{"term":"Sequence clustering","uri":"http://edamontology.org/operation_0291"}],"output":[{"data":{"term":"Sequence alignment","uri":"http://edamontology.org/data_0863"},"format":[{"term":"Alignment format (text)","uri":"http://edamontology.org/format_2554"}]}]}],"maturity":"Mature","name":"TE_finder","operating_system":["Linux","Mac"],"owner":"hadi8","publication":[{"doi":"10.1007/s00239-003-0007-2","type":["Primary"]}],"topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Mobile genetic elements","uri":"http://edamontology.org/topic_0798"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"},{"term":"Sequence composition, complexity and repeats","uri":"http://edamontology.org/topic_0157"}]}}}