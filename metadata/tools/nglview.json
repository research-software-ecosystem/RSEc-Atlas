{"tool_name":"nglview","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"nglview","identifiers":["biotools:nglview","doi:10.1093/bioinformatics/btx789"],"license":"Not available","summary":"An ipython widget to interactively view molecular structures and trajectories. utilizes the embeddable ngl viewer for rendering.","home_url":"https://github.com/arose/nglview","keywords":["Computational Biology","Molecular Dynamics Simulation","Proteins","Protein structural motifs and surfaces","Data visualisation","Protein structure analysis","Molecular Dynamics"],"manually_check":true,"total_pulls":11634164},"biotools":{"id":"nglview","home":"https://github.com/arose/nglview","license":"MIT","summary":"Jupyter/IPython widget to interactively view molecular structures as well as trajectories from molecular dynamics simulations. Fast and scalable molecular graphics are provided through the NGL Viewer.","addition_date":"2018-06-26T15:42:28Z","last_update_date":"2024-11-25T14:44:05.376624Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:nglview","credit":[{"email":"asr.moin@gmail.com","name":"Alexander S Rose","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/arose/nglview"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Protein structure analysis","uri":"http://edamontology.org/operation_2406"},{"term":"Structure visualisation","uri":"http://edamontology.org/operation_0570"}]}],"name":"NGLview","operating_system":["Linux","Mac"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1093/bioinformatics/btx789","metadata":{"abstract":"NGLview is a Jupyter/IPython widget to interactively view molecular structures as well as trajectories from molecular dynamics simulations. Fast and scalable molecular graphics are provided through the NGL Viewer. The widget supports showing data from the file-system, online data bases and from objects of many popular analysis libraries including mdanalysis, mdtraj, pytraj, rdkit and more. Availability and implementation The source code is freely available under the MIT license at https://github.com/arose/nglview. Python packages are available from PyPI and bioconda. NGLview uses Python on the server-side and JavaScript on the client. The integration with Jupyter is done through the ipywidgets package. The NGL Viewer is embedded client-side to provide WebGL accelerated molecular graphics.","authors":[{"name":"Case D.A."},{"name":"Nguyen H."},{"name":"Rose A.S."}],"citationCount":101,"date":"2018-04-01T00:00:00Z","journal":"Bioinformatics","title":"NGLview-interactive molecular graphics for Jupyter notebooks"},"pmcid":"PMC6031024","pmid":"29236954"}],"topic":[{"term":"Data visualisation","uri":"http://edamontology.org/topic_0092"},{"term":"Protein structural motifs and surfaces","uri":"http://edamontology.org/topic_0166"},{"term":"Protein structure analysis","uri":"http://edamontology.org/topic_2814"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"}],"validated":1},"bioschemas":{"name":"NGLview","home":"https://bio.tools/nglview","license":"MIT","summary":"Jupyter/IPython widget to interactively view molecular structures as well as trajectories from molecular dynamics simulations. Fast and scalable molecular graphics are provided through the NGL Viewer.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:nglview/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":t