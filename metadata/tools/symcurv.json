{"tool_name":"symcurv","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"symcurv","home":"http://genome.crg.es/cgi-bin/SymCurv/SymCurv.pl","summary":"SymCurv is a computational ab initio method for nucleosome positioning prediction. It is based on the structural property of natural nucleosome forming sequences, to be symmetrically curved around a local minimum of curvature.","addition_date":"2016-04-22T13:42:59Z","last_update_date":"2024-11-25T15:00:30.175157Z","tool_type":["Command-line tool"],"version":["1"],"biotools_curie":"biotools:symcurv","credit":[{"email":"sonja.althammer@gmail.com","name":"Sonja Althammer","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"Lab Roderic Guigo Group","note":"Computational Biology of RNA processing @ Centre for Genomic Regulation Parc de Recerca Biomedica: Dr. Aiguader, 88, 08003 Barcelona","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Christoforos Nikolau","typeEntity":"Person","typeRole":["Developer"]},{"name":"Sonja Althammer","typeEntity":"Person","typeRole":["Developer"]},{"name":"crg.eu","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["General"],"url":"http://genome.crg.es/SymCurv/tutorial.html"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Nucleic acid sequence","uri":"http://edamontology.org/data_2977"}}],"note":"SymCurv is a computational ab initio method for nucleosome positioning prediction. It is based on the structural property of natural nucleosome forming sequences, to be symmetrically curved around a local minimum of curvature. The method takes as input the primary DNA sequence, calculates the expected curvature from which it deduces possible centers of nucleosomal sequences, by imposing symmetry constraints. SymCurv's performance is comparable to existing tools but offers the additional advantages of predicting nucleosome positions under two assumed-states (stationary and dynamic) providing insi