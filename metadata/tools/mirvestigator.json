{"tool_name":"mirvestigator","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"mirvestigator","home":"http://mirvestigator.systemsbiology.net","summary":"miRvestigator is a web based tool to identify miRNAs mediating co-regulation of gene expression patterns observed in transcriptome profilng data. The miRvestigator takes as input a list of co-expressed genes and returns the most likely miRNA regulating the genes. It searches for an over-represented sequence motif in the 3' UTRs of the genes using Weeder and compares the motif to all unique miRNA seed sequences in miRBase using our custom built miRvestigator hidden Markov model (HMM).","addition_date":"2017-02-14T09:35:21Z","last_update_date":"2024-11-25T15:05:50.353579Z","tool_type":["Web application"],"biotools_curie":"biotools:mirvestigator","credit":[{"email":"cbare@systemsbiology.org","name":"miRvestigator Support","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"cplaisier@systemsbiology.org","name":"miRvestigator Support","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://mirvestigator.systemsbiology.net/help"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene expression analysis","uri":"http://edamontology.org/operation_2495"},{"term":"Gene expression correlation","uri":"http://edamontology.org/operation_3463"},{"term":"Gene expression profiling","uri":"http://edamontology.org/operation_0314"},{"term":"Sequence motif discovery","uri":"http://edamontology.org/operation_0238"},{"term":"Sequence motif recognition","uri":"http://edamontology.org/operation_0239"}]}],"name":"miRvestigator","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"doi":"10.1093/nar/gkr374","pmcid":"PMC3125776","pmid":"21602264"}],"topic":[{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"Gene expression","uri":"http://edamontolo