{"tool_name":"ngsep","contents":["biocontainers","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"ngsep","version":"4.0.1","home":"https://github.com/NGSEP/NGSEPcore","license":"GPL-3","summary":"NGSEP - Next Generation Sequencing Experience Platform","identifiers":["biotools:ngsep","doi:10.1093/bioinformatics/btz275"],"description":"NGSEP provides an object model to enable different kinds of\nanalysis of DNA high throughput sequencing (HTS) data. The classic\nuse of NGSEP is a reference guided construction and downstream analysis of\nlarge datasets of genomic variation. NGSEP performs accurate detection and\ngenotyping of Single Nucleotide Variants (SNVs), small and large indels, short\ntandem repeats (STRs), inversions, and Copy Number Variants (CNVs). NGSEP also\nprovides utilities for downstream analysis of variation in VCF files, including\nfunctional annotation of variants, filtering, format conversion, comparison,\nclustering, imputation, introgression analysis and different kinds of\nstatistics.\n","build":{"noarch":"generic","number":1},"requirements":{"run":["openjdk >=8","python"]},"source_url":"https://master.dl.sourceforge.net/project/ngsep/Library/NGSEPcore_4.0.1.jar","test":{"commands":["ngsep --version","ngsep --citing"]}},"biocontainers":{"name":"ngsep","identifiers":["biotools:ngsep -   doi:10.1093/BIOINFORMATICS/BTZ275"],"license":"GPL-3","summary":"Ngsep - next generation sequencing experience platform","home_url":"https://github.com/NGSEP/NGSEPcore","keywords":["Clustering","Genomics","Whole genome sequencing","RNA-Seq","Sequence Alignment","Genetics","Transcriptome","Ortholog"],"manually_check":true,"total_pulls":620},"biotools":{"id":"NGSEP","home":"http://ngsep.sf.net","license":"GPL-3.0","summary":"NGSEP (Next Generation Sequencing Experience Platform) - accurate variant calling across species and sequencing protocols.","addition_date":"2019-08-09T13:13:24Z","last_update_date":"2024-11-24T21:01:21.962073Z","tool_type":["Command-line tool","Desktop application"],"accessibility":"Open access","biotools_curie":"biotools:NGSEP","cost":"Free of charge","credit":[{"email":"ja.duitama@uniandes.edu.co","name":"Jorge Duitama","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://sourceforge.net/p/ngsep/wiki/Home/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Imputation","uri":"http://edamontology.org/operation_3557"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"}]}],"maturity":"Mature","name":"NGSEP","operating_system":["Linux","Mac","Windows"],"owner":"hans","publication":[{"doi":"10.1093/bioinformatics/btz275","metadata":{"abstract":"Accurate detection, genotyping and downstream analysis of genomic variants from high-throughput sequencing data are fundamental features in modern production pipelines for genetic-based diagnosis in medicine or genomic selection in plant and animal breeding. Our research group maintains the Next-Generation Sequencing Experience Platform (NGSEP) as a precise, efficient and easy-to-use software solution for these features. Results: Understanding that incorrect alignments around short tandem repeats are an important source of genotyping errors, we implemented in NGSEP new algorithms for realignment and haplotype clustering of reads spanning indels and short tandem repeats. We performed extensive benchmark experiments comparing NGSEP to state-of-the-art software using real data from three sequencing protocols and four species with different distributions of repetitive elements. NGSEP consistently shows comparative accuracy and better efficiency compared to the existing solutions. We expect that this work will contribute to the continuous improvement of quality in variant calling needed for modern applications in medicine and agriculture.","authors":[{"name":"Cardozo N."},{"name":"Duitama J."},{"name":"Gil J."},{"name":"Loaiza C.D."},{"name":"Riascos J.J."},{"name":"Tello D."}],"citationCount":48,"date":"2019-11-01T00:00:00Z","journal":"Bioinformatics","title":"NGSEP3: Accurate variant calling across species and sequencing protocols"},"pmcid":"PMC6853766","pmid":"31099384","type":["Primary"]}],"topic":[{"term":"Agricultural science","uri":"http://edamontology.org/topic_3810"},{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"bioschemas":{"name":"NGSEP","home":"https://bio.tools/NGSEP","license":"GPL-3.0","summary":"NGSEP (Next Generation Sequencing Experience Platform) - accurate variant calling across species and sequencing protocols.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ngsep/app/ngsep.sf.net","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":50,"citations":[{"count":1,"year":"2026"},{"count":4,"year":"2020"},{"count":6,"year":"2022"},{"count":7,"year":"2023"},{"count":10,"year":"2024"},{"count":11,"year":"2021"},{"count":11,"year":"2025"}],"doi":"10.1093/bioinformatics/btz275","pmcid":"PMC6853766","pmid":"31099384","ref_count":39,"refs":[{"count":1,"year":"1999"},{"count":1,"year":"2009"},{"count":2,"year":"2010"},{"count":2,"year":"2011"},{"count":2,"year":"2012"},{"count":3,"year":"2013"},{"count":4,"year":"2018"},{"count":5,"year":"2015"},{"count":5,"year":"2017"},{"count":6,"year":"2016"},{"count":8,"year":"2014"}],"title":"NGSEP3: accurate variant calling across species and sequencing protocols.","year":2019}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright