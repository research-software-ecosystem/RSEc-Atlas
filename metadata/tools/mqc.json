{"tool_name":"mqc","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"mqc","identifiers":["doi:10.1016/j.cmpb.2018.10.018"],"license":"GNU General Public License v3.0","summary":"Qualtiy control tool to assess the mapping quality of a ribosome profiling experiment","home_url":"https://github.com/Biobix/mQC","keywords":["Cell Line, Tumor","Colonic Neoplasms","Computational Biology","Cycloheximide","Gene Expression Profiling","Genome-Wide Association Study","HCT116 Cells","HEK293 Cells","High-Throughput Nucleotide Sequencing","Humans","Open Reading Frames","Quality Control","RNA, Messenger","Reproducibility of Results","Ribosomes","Sequence Analysis, DNA","Sequence Analysis, RNA"],"manually_check":true,"total_pulls":0},"biotools":{"id":"mQC","home":"https://github.com/Biobix/mQC","license":"GPL-3.0","summary":"Quality visualization tool specific for ribosome profiling data","addition_date":"2019-06-12T07:38:33Z","last_update_date":"2020-06-16T10:55:22Z","tool_type":["Command-line tool"],"version":["1.10"],"accessibility":"Open access","biotools_curie":"biotools:mQC","cost":"Free of charge","credit":[{"email":"Gerben.Menschaert@UGent.be","name":"Gerben Menschaert","note":"PI at Ghent University (BioBIx lab)","orcidid":"https://orcid.org/0000-0002-7575-2085","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"Steven.Verbruggen@UGent.be","name":"Steven Verbruggen","note":"PhD at Ghent University (BioBix lab)","orcidid":"https://orcid.org/0000-0001-9441-9539","typeEntity":"Person","typeRole":["Developer","Documentor","Support"]}],"documentation":[{"type":["User manual"],"url":"https://github.com/Biobix/mQC/blob/master/README.md"}],"edit_permission":{"type":"private"},"function":[{"cmd":"mQC.pl --help","input":[{"data":{"term":"Sequence alignment (nucleic acid)","uri":"http://edamontology.org/data_1383"},"format":[{"term":"SAM","uri":"http://edamontology.org/format_2573"}]}],"note":"Run mQC on genome-aligned ribosome profiling in either BAM or SAM format","operation":[{"term":"RNA-seq read count analysis","uri":"http://edamontology.org/operation_3563"},{"term":"Sequence alignment validation","uri":"http://edamontology.org/operation_0447"},{"term":"Sequencing quality control","uri":"http://edamontology.org/operation_3218"}],"output":[{"data":{"term":"Report","uri":"http://edamontology.org/data_2048"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"}]}]}],"maturity":"Mature","name":"mQC","operating_system":["Linux","Mac"],"owner":"StevenVerbruggen","publication":[{"doi":"10.1016/j.cmpb.2018.10.018","metadata":{"abstract":"\u00a9 2018 The AuthorsBackground and objective: Ribosome profiling is a recent next generation sequencing technique enabling the genome-wide study of gene expression in biomedical research at the translation level. Too often, researchers precipitously start trying to test their hypotheses after alignment of their data, without checking the quality and the general features of their mapped data. Despite the fact that these checks are essential to prevent errors and ensure valid conclusions afterwards, easy-to-use tools for visualizing the quality and overall outlook of mapped ribosome profiling data are lacking. Methods: We present mQC, a modular tool implemented as a Bioconda package and also available in the Galaxy tool shed. Herewith both bio-informaticians as well as non-experts can easily perform the indispensable visualization of both the quality and the general features of their mapped P-site corrected ribosome profiling reads. The user manual, the raw code and more information can be found on its GitHub repository (https://github.com/Biobix/mQC). Results: mQC was tested on multiple datasets to assess its general applicability and was compared to other tools that partly perform similar tasks. Conclusions: Our results demonstrate that mQC can accomplish an unfilled but essential position in the ribosome profiling data analysis procedure by performing a thorough RIBO-Seq-specific exploration of aligned and P-site corrected ribosome profiling data.","authors":[{"name":"Menschaert G."},{"name":"Verbruggen S."}],"citationCount":8,"date":"2019-11-01T00:00:00Z","journal":"Computer Methods and Programs in Biomedicine","title":"mQC: A post-mapping data exploration tool for ribosome profiling"},"pmid":"30401579","type":["Primary"]}],"topic":[{"term":"Data quality management","uri":"http://edamontology.org/topic_3572"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"mQC","home":"https://bio.tools/mQC","license":"GPL-3.0","version":"1.10","summary":"Quality visualization tool specific for ribosome profiling data","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mqc:1.10/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":10,"citations":[{"count":1,"year":"2022"},{"count":1,"year":"2026"},{"count":2,"year":"2019"},{"count":2,"year":"2021"},{"count":4,"year":"2020"}],"doi":"10.1016/j.cmpb.2018.10.018","pmid":"30401579","ref_count":0,"refs":[],"title":"mQC: A post-mapping data exploration tool for ribosome profiling.","year":2018}]}],"readme":false,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}},{"@id":"https://openebench.bsc.es/monitor/metric