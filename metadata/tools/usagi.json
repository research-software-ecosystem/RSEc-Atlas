{"tool_name":"usagi","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"usagi","home":"https://www.ohdsi.org/analytic-tools/usagi/","license":"Apache-2.0","summary":"Usagi is a software tool used to help in the process of mapping codes from a source system into terminologies, preferably standard ones, stored in the Observational Medical Outcomes Partnership (OMOP) Vocabulary (http://www.ohdsi.org/data-standardization/vocabulary-resources/). The word Usagi is Japanese for rabbit and was named after the first mapping exercise it was used for; mapping source codes used in a Japanese dataset into OMOP Vocabulary concepts.","addition_date":"2023-01-26T08:58:40.143653Z","last_update_date":"2023-02-01T12:13:00.462481Z","collections":["IMPaCT-Data"],"biotools_curie":"biotools:usagi","credit":[{"name":"Observational Health Data Sciences and Informatics   OHDSI","url":"https://www.ohdsi.org/"}],"documentation":[{"type":["Installation instructions"],"url":"https://www.ohdsi.org/web/wiki/doku.php?id=documentation:software:usagi"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Data handling","uri":"http://edamontology.org/operation_2409"},{"term":"Mapping","uri":"http://edamontology.org/operation_2429"}]}],"name":"Usagi","owner":"iacs-biocomputacion"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:usagi/undefined/www.ohdsi.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/usagi","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description