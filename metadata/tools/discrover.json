{"tool_name":"discrover","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"discrover","home":"https://github.com/maaskola/discrover","license":"GPL-3.0","summary":"Discover discriminative sequence motifs.","addition_date":"2022-03-16T11:12:25.563148Z","last_update_date":"2022-03-16T11:12:25.566044Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:discrover","cost":"Free of charge","credit":[{"email":"jonas@maaskola.de","name":"Jonas Maaskola"},{"name":"Nikolaus Rajewsky"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Nucleic acid feature detection","uri":"http://edamontology.org/operation_0415"}]}],"name":"discrover","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1093/nar/gku1083","metadata":{"abstract":"\u00a9 2014 The Author(s).We present a discriminative learning method for pattern discovery of binding sites in nucleic acid sequences based on hidden Markov models. Sets of positive and negative example sequences are mined for sequence motifs whose occurrence frequency varies between the sets. The method offers several objective functions, but we concentrate on mutual information of condition and motif occurrence. We perform a systematic comparison of our method and numerous published motif-finding tools. Our method achieves the highest motif discovery performance, while being faster than most published methods. We present case studies of data from various technologies, including ChIP-Seq, RIP-Chip and PAR-CLIP, of embryonic stem cell transcription factors and of RNA-binding proteins, demonstrating practicality and utility of the method. For the alternative splicing factor RBM10, our analysis finds motifs known to be splicing-relevant. The motif discovery method is implemented in the free software package Discrover. It is applicable to genome- and transcriptome-scale data, makes use of available repeat experiments and aside from binary contrasts also more complex data configurations can be utilized.","authors":[{"name":"Maaskola J."},{"name":"Rajewsky N."}],"citationCount":19,"date":"2014-12-01T00:00:00Z","journal":"Nucleic Acids Research","title":"Binding site discovery from nucleic acid sequences by discriminative learning of hidden Markov models"},"pmcid":"PMC4245949","pmid":"25389269"}],"topic":[{"term":"Nucleic acid sites, features and motifs","uri":"http://edamontology.org/topic_3511"}],"validated":1},"bioschemas":{"name":"discrover","home":"https://bio.tools/discrover","license":"GPL-3.0","summary":"Discover discriminative sequence motifs.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:discrover/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":false,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":14,"citations":[{"count":1,"year":"2016"},{"count":1,"year":"2019"},{"count":1,"year":"2021"},{"count":1,"year":"2023"},{"count":1,"year":"2024"},{"count":3,"year":"2017"},{"count":3,"year":"2018"},{"count":3,"year":"2020"}],"doi":"10.1093/nar/gku1083","pmcid":"PMC4245949","pmid":"25389269","ref_count":85,"refs":[{"count":1,"year":"1986"},{"count":1,"year":"1987"},{"count":1,"year":"1993"},{"count":2,"year":"1990"},{"count":2,"year":"1995"},{"count":2,"year":"2003"},{"count":2,"year":"2004"},{"count":2,"year":"2009"},{"count":2,"year":"2013"},{"count":2,"year":"2014"},{"count":3,"year":"1994"},{"count":3,"year":"2001"},{"count":4,"year":"1998"},{"count":4,"year":"2000"},{"count":4,"year":"2012"},{"count":5,"year":"2002"},{"count":5,"ye