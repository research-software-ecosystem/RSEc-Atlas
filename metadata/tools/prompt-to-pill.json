{"tool_name":"prompt-to-pill","contents":["biotools"],"identifiers":["biotools:prompt-to-pill"],"fetched_metadata":{"biotools":{"id":"prompt-to-pill","home":"https://github.com/ChatMED/Prompt-to-Pill","summary":"Prompt-to-Pill is a proof-of-concept multi-agent LLM framework for AI-driven drug discovery and clinical trial simulation, chaining target identification, generative molecule design, ADMET screening, structure-based docking, and virtual patient recruitment, demonstrated on the DPP4 target.","addition_date":"2026-11-04T09:53:35.354084Z","last_update_date":"2026-11-04T09:53:35.356997Z","biotools_curie":"biotools:prompt-to-pill","credit":[{"email":"ivana@ireason.mk","name":"Ivana Vichentijevikj","orcidid":"https://orcid.org/0009-0008-7050-6644","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Molecular docking","uri":"http://edamontology.org/operation_0478"},{"term":"Phasing","uri":"http://edamontology.org/operation_3454"},{"term":"Small molecule design","uri":"http://edamontology.org/operation_4009"}]}],"name":"Prompt-to-Pill","owner":"pub2tools2024","publication":[{"doi":"10.1093/BIOADV/VBAF323","pmcid":"PMC12800774","pmid":"41542364"}],"topic":[{"term":"Drug discovery","uri":"http://edamontology.org/topic_3336"},{"term":"Drug metabolism","uri":"http://edamontology.org/topic_3375"},{"term":"Molecular modelling","uri":"http://edamontology.org/topic_2275"},{"term":"Preclinical and clinical studies","uri":"http://edamontology.org/topic_3379"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}]}}}