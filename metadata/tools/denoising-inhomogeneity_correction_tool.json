{"tool_name":"denoising-inhomogeneity_correction_tool","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"denoising-inhomogeneity_correction_tool","home":"https://harbor.eucaim.cancerimage.eu/harbor/projects/4/repositories/denoising_inhomogeneity_correction_tool/info-tab","license":"CC-BY-NC-ND-4.0","summary":"The tool is designed to perform a customisable image pre-processing to reduce noise and inhomogeneity field effect, thus improving image quality and reproducibility of radiomics features. This tool consists of two independent steps: one for denoising using one of the 5 integrated filters (Bilateral Filter, Anisotropic Diffusion Filter (ADF), Curvature Flow Filter (CFF), SUSAN and Non Local Means (NLM)), and another for the ANTs N4 and another for the ANT's N4 bias correction filter. The parameter configuration of this tool has been optimised for TW1, T2W, DWI and DCE sequences in neuroblastoma (NB) and paediatric brain tumours, but it can also be configured with some of their parameters using a JSON parameter configuration file.","addition_date":"2025-05-29T08:55:46.088021Z","last_update_date":"2026-05-27T15:19:25.220262Z","tool_type":["Library"],"version":["1.1.0"],"collections":["EUCAIM"],"biotools_curie":"biotools:denoising-inhomogeneity_correction_tool","credit":[{"email":"carina_soler@iislafe.es","name":"Carina Soler-Pons","orcidid":"https://orcid.org/0009-0000-2991-1391","typeEntity":"Person","typeRole":["Documentor","Support"]},{"email":"leonor_cerda@iislafe.es","name":"Leonor Cerda-Alberich","orcidid":"https://orcid.org/0000-0002-5567-4278","typeEntity":"Person","typeRole":["Provider"]},{"email":"luis_marti@iislafe.es","name":"Luis Marti-Bonmati","orcidid":"https://orcid.org/0000-0002-8234-010X","typeEntity":"Person","typeRole":["Provider"]},{"email":"matias_fernandez@iislafe.es","name":"Matias Fernandez-Paton","orcidid":"https://orcid.org/0000-0001-9374-1411","typeEntity":"Person","typeRole":["Developer"]},{"email":"pedro