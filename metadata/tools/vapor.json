{"tool_name":"vapor","contents":["galaxy","oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"vapor","home":"https://github.com/wm75/vaporup","license":"GPL-3.0","summary":"VAPOR is a tool for classification of Influenza samples from raw short read sequence data for downstream bioinformatics analysis. VAPOR is provided with a fasta file of full-length sequences (> 20,000) for a given segment, a set of reads, and attempts to retrieve a reference that is closest to the sample strain.","addition_date":"2020-01-14T09:34:01Z","last_update_date":"2025-08-28T14:32:58.093703Z","tool_type":["Command-line tool"],"version":["1.0.3"],"biotools_curie":"biotools:vapor","edit_permission":{"authors":["ELIXIR-CZ","wm75"],"type":"group"},"function":[{"operation":[{"term":"Data retrieval","uri":"http://edamontology.org/operation_2422"},{"term":"De-novo assembly","uri":"http://edamontology.org/operation_0524"},{"term":"Read mapping","uri":"http://edamontology.org/operation_3198"}]}],"name":"VAPOR","owner":"Kigaard","publication":[{"doi":"10.1093/bioinformatics/btz814","metadata":{"abstract":"Motivation: Influenza viruses represent a global public health burden due to annual epidemics and pandemic potential. Due to a rapidly evolving RNA genome, inter-species transmission, intra-host variation, and noise in short-read data, reads can be lost during mapping, and de novo assembly can be time consuming and result in misassembly. We assessed read loss during mapping and designed a graph-based classifier, VAPOR, for selecting mapping references, assembly validation and detection of strains of non-human origin. Results: Standard human reference viruses were insufficient for mapping diverse influenza samples in simulation. VAPOR retrieved references for 257 real whole-genome sequencing samples with a mean of > 99:8% identity to assemblies, and increased the proportion of mapped reads by up to 13.3% compared to standard references. VAPOR has the potential to improve the robustness of bioinformatics pipelines for surveillance and could be adapted to other RNA viruses.","authors":[{"name":"Brown C.M."},{"name":"Bull M.J."},{"name":"Connor T.R."},{"name":"Corden S."},{"name":"Moore C."},{"name":"Southgate B."},{"name":"Southgate J.A."},{"name":"Watkins J."}],"citationCount":7,"date":"2020-01-01T00:00:00Z","journal":"Bioinformatics","title":"Influenza classification from short reads with VAPOR facilitates robust mapping pipelines and zoonotic strain detection for routine surveillance applications"},"pmcid":"PMC7703727","pmid":"31693070"}],"topic":[{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Whole genome sequencing","uri":"http://edamontology.org/topic_3673"}],"validated":1},"bioschemas":{"name":"VAPOR","home":"https://bio.tools/vapor","license":"GPL-3.0","version":"1.0.3","summary":"VAPOR is a tool for classification of Influenza samples from raw short read sequence data for downstream bioinformatics analysis. VAPOR is provided with a fasta file of full-length sequences (> 20,000) for a given segment, a set of reads, and attempts to retrieve a reference that is closest to the sample strain.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"@TOOL_VERSION@+galaxy@VERSION_SUFFIX@","first_commit":"2022-08-24","conda_name":"vapor","conda_version":"1.0.3","summary":"Classify Influenza samples from raw short read sequence data","edam_operations":["Data retrieval","De-novo assembly","Read mapping"],"edam_topics":["Whole genome sequencing","Mapping","Sequence assembly"],"toolshed_categories":["Sequence Analysis"],"toolshed_id":"vapor","users_5_years":315,"users_all_time":315,"usage_5_years":199315,"usage_all_time":199315,"bio_tools_summary":"VAPOR is a tool for classification of Influenza samples from raw short read sequence data for downstream bioinformatics analysis. VAPOR is provided with a fasta file of full-length sequences (> 20,000) for 