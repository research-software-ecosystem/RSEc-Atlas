{"tool_name":"visor","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"VISOR","home":"https://github.com/davidebolo1993/VISOR","license":"LGPL-3.0","summary":"Haplotype-aware structural variants simulator for short, long and linked reads","addition_date":"2020-01-09T17:53:02Z","last_update_date":"2021-01-02T16:12:40Z","version":["1.0"],"accessibility":"Open access","biotools_curie":"biotools:VISOR","cost":"Free of charge","credit":[{"email":"davidebolognini7@gmail.com","name":"Davide Bolognini","orcidid":"https://orcid.org/0000-0002-8735-8093","typeEntity":"Person","typeRole":["Developer","Documentor","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://davidebolo1993.github.io/visordoc/"}],"edit_permission":{"type":"public"},"function":[{"cmd":"VISOR {HACk, SHORtS, LASeR, XENIA} --help","input":[{"data":{"term":"DNA sequence","uri":"http://edamontology.org/data_3494"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]},{"data":{"term":"Sequence features metadata","uri":"http://edamontology.org/data_2914"},"format":[{"term":"BED","uri":"http://edamontology.org/format_3003"}]}],"operation":[{"term":"Alignment","uri":"http://edamontology.org/operation_2928"},{"term":"Genome visualisation","uri":"http://edamontology.org/operation_3208"},{"term":"Modelling and simulation","uri":"http://edamontology.org/operation_2426"}],"output":[{"data":{"term":"Sequence variations","uri":"http://edamontology.org/data_3498"},"format":[{"term":"BAM","uri":"http://edamontology.org/format_2572"}]},{"data":{"term":"Sequence variations","uri":"http://edamontology.org/data_3498"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]},{"data":{"term":"Sequence variations","uri":"http://edamontology.org/data_3498"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"}]}]}],"maturity":"Mature","name":"VISOR","owner":"davidebolo1993","publication":[{"doi":"10.1093/BIOINFORMATICS/BTZ719","metadata":{"abstract":"\u00a9 2020 Oxford University Press. All rights reserved.VISOR is a tool for haplotype-specific simulations of simple and complex structural variants (SVs). The method is applicable to haploid, diploid or higher ploidy simulations for bulk or single-cell sequencing data. SVs are implanted into FASTA haplotypes at single-basepair resolution, optionally with nearby single-nucleotide variants. Short or long reads are drawn at random from these haplotypes using standard error profiles. Double-or single-stranded data can be simulated and VISOR supports the generation of haplotype-tagged BAM files. The tool further includes methods to interactively visualize simulated variants in single-stranded data. The versatility of VISOR is unmet by comparable tools and it lays the foundation to simulate haplotype-resolved cancer heterogeneity data in bulk or at single-cell resolution.","authors":[{"name":"Benes V."},{"name":"Bolognini D."},{"name":"Korbel J.O."},{"name":"Magi A."},{"name":"Rausch T."},{"name":"Sanders A."}],"citationCount":2,"date":"2020-02-15T00:00:00Z","journal":"Bioinformatics","title":"VISOR: A versatile haplotype-aware structural variant simulator for short-and long-read sequencing"},"pmid":"31589307","type":["Method"]}],"topic":[{"term":"Bioinformatics","uri":"http://edamontology.org/topic_0091"},{"term":"DNA structural variation","uri":"http://edamontology.org/topic_3175"},{"term":"Nucleic acid sites, features and motifs","uri":"http://edamontology.org/topic_3511"}],"validated":1},"bioschemas":{"name":"VISOR","home":"https://bio.tools/VISOR","license":"LGPL-3.0","version":"1.0","summary":"Haplotype-aware structural variants simulator for short, long and linked reads","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:visor:1.0/undefined/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"b