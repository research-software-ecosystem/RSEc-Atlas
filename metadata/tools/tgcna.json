{"tool_name":"tgcna","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"tgcna","home":"https://github.com/QiZhangStat/TGCnA","license":"GPL-3.0","summary":"Temporal gene coexpression network analysis using a low-rank plus sparse framework.","addition_date":"2022-08-29T22:22:39.210230Z","last_update_date":"2024-11-24T15:45:22.435852Z","tool_type":["Library"],"accessibility":"Open access","biotools_curie":"biotools:tgcna","cost":"Free of charge","credit":[{"email":"qi.zhang@unl.edu","name":"Qi Zhang","orcidid":"https://orcid.org/0000-0001-6197-0973","typeEntity":"Person"},{"email":"zhang.chi@unl.edu","name":"Chi Zhang","typeEntity":"Person"},{"name":"Jinyu Li"},{"name":"Yutong Lai"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Expression correlation analysis","uri":"http://edamontology.org/operation_3463"},{"term":"Modelling and simulation","uri":"http://edamontology.org/operation_2426"},{"term":"Weighted correlation network analysis","uri":"http://edamontology.org/operation_3766"}]}],"name":"TGCnA","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1080/02664763.2019.1667311","metadata":{"abstract":"Various gene network models with distinct physical nature have been widely used in biological studies. For temporal transcriptomic studies, the current dynamic models either ignore the temporal variation in the network structure or fail to scale up to a large number of genes due to severe computational bottlenecks and sample size limitation. Although the correlation-based gene networks are computationally affordable, they have limitations after being applied to gene expression time-course data. We proposed Temporal Gene Coexpression Network Analysis (TGCnA) framework for the transcriptomic time-course data. The mathematical nature of TGCnA is the joint modeling of multiple covariance matrices across time points using a \u2018low-rank plus sparse\u2019 framework, in which the network similarity across time points is explicitly modeled in the low-rank component. We demonstrated the advantage of TGCnA in covariance matrix estimation and gene module discovery using both simulation data and real transcriptomic data. The code is available at https://github.com/QiZhangStat/TGCnA.","authors":[{"name":"Lai Y."},{"name":"Li J."},{"name":"Zhang C."},{"name":"Zhang Q."}],"citationCount":2,"date":"2020-04-25T00:00:00Z","journal":"Journal of Applied Statistics","title":"TGCnA: temporal gene coexpression network analysis using a low-rank plus sparse framework"},"pmcid":"PMC9041782","pmid":"35706920"}],"topic":[{"term":"Mathematics","uri":"http://edamontology.org/topic_3315"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Physics","uri":"http://edamontology.org/topic_3318"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"TGCnA","home":"https://bio.tools/tgcna","license":"GPL-3.0","summary":"Temporal gene coexpression network analysis using a low-rank plus sparse framework.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:tgcna/lib/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":3,"citations":[{"count":1,"year":"2019"},{"count":1,"year":"2020"},{"count":1,"year":"2025"}],"doi":"10.1080/02664763.2019.1667311","pmcid":"PMC9041782","pmid":"35706920","ref_count":40,"refs":[{"count