{"tool_name":"virtual_chip-seq","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"virtual_chip-seq","home":"https://virchip.hoffmanlab.org","license":"GPL-3.0","summary":"Predicting transcription factor binding by learning from the transcriptome.","addition_date":"2022-08-29T09:44:00.766074Z","last_update_date":"2022-08-29T09:44:00.768521Z","tool_type":["Command-line tool","Web application"],"accessibility":"Open access","biotools_curie":"biotools:virtual_chip-seq","cost":"Free of charge","credit":[{"name":"Mehran Karimzadeh"},{"name":"Michael M. Hoffman","orcidid":"https://orcid.org/0000-0002-4517-1562","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Binding site prediction","uri":"http://edamontology.org/operation_2575"},{"term":"Deposition","uri":"http://edamontology.org/operation_3431"},{"term":"Peak calling","uri":"http://edamontology.org/operation_3222"},{"term":"Transcription factor binding site prediction","uri":"http://edamontology.org/operation_0445"}]}],"name":"Virtual ChIP-seq","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1186/S13059-022-02690-2","metadata":{"abstract":"\u00a9 2022, The Author(s).Existing methods for computational prediction of transcription factor (TF) binding sites evaluate genomic regions with similarity to known TF sequence preferences. Most TF binding sites, however, do not resemble known TF sequence motifs, and many TFs are not sequence-specific. We developed Virtual ChIP-seq, which predicts binding of individual TFs in new cell types, integrating learned associations with gene expression and binding, TF binding sites from other cell types, and chromatin accessibility data in the new cell type. This approach outperforms methods that predict TF binding solely based on sequence preference, predicting binding for 36 TFs (MCC>0.3).","authors":[{"name":"Hoffman M.M."},{"name":"Karimzadeh M."}],"date":"2022-12-01T00:00:00Z","journal":"Genome Biology","title":"Virtual ChIP-seq: predicting transcription factor binding by learning from the transcriptome"},"pmcid":"PMC9185870","pmid":"35681170"}],"topic":[{"term":"ChIP-seq","uri":"http://edamontology.org/topic_3169"},{"term":"Chromosome conformation capture","uri":"http://edamontology.org/topic_3940"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"Virtual ChIP-seq","home":"https://bio.tools/virtual_chip-seq","license":"GPL-3.0","summary":"Predicting transcription factor binding by learning from the transcriptome.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:virtual_chip-seq/cmd/virchip.hoffmanlab.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":26,"citations":[{"count":1,"year":"2018"},{"count":1,"year":"2022"},{"count":2,"year":"2019"},{"count":2,"year":"2025"},{"count":2,"year":"2026"},{"count":3,"year":"2020"},{"count":4,"year":"2024"},{"count":5,"year":"2021"},{"count":6,"year":"2023"}],"doi":"10.1186/s13059-022-02690-2","pmcid":"PMC9185870","pmid":"35681170","ref_count":99,"refs":[{"count":1,"year":"1975"},{"count":1,"year":"1996"},{"count":1,"year":"2000"},{"count":1,"year":"2004"},{"count":1,"year":"2020"},{"count":1,"year":"2022"},{"count":2,"year":"1989"},{"count":2,"year":"1999"},{"count":2,"year":"2007"},{"count":2,"year":"2008"},{"count":2,"year":"2018"},{"count":3,"year":"2002"},{"count":4,"year":"2009"},{"count":4,"year":"2010"},{"count":5,"year":"2017"},{"count":6,"year":"2005"}