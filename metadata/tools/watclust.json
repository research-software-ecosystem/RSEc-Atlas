{"tool_name":"watclust","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"WATCLUST","home":"https://watclust.wordpress.com/","license":"Unlicense","summary":"Tool for improving the design of drugs based on protein-water interactions.","addition_date":"2019-08-04T14:19:50Z","last_update_date":"2024-11-24T21:06:44.902442Z","tool_type":["Desktop application"],"accessibility":"Open access","biotools_curie":"biotools:WATCLUST","cost":"Free of charge","credit":[{"email":"adrian@qi.fcen.uba.ar","name":"Adrian G. Turjanski","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"marcelo@qi.fcen.uba.ar","name":"Marcelo A. Marti","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"note":"Tutorial material","type":["Training material"],"url":"https://watclust.wordpress.com/examples/"},{"type":["General"],"url":"https://watclust.wordpress.com/using-watclust/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Molecular dynamics","uri":"http://edamontology.org/operation_2476"},{"term":"Protein folding analysis","uri":"http://edamontology.org/operation_2415"},{"term":"Protein-ligand docking","uri":"http://edamontology.org/operation_0482"}]}],"maturity":"Mature","name":"WATCLUST","operating_system":["Linux","Mac","Windows"],"owner":"Ruta","publication":[{"doi":"10.1093/bioinformatics/btv411","metadata":{"abstract":"Motivation: Water molecules are key players for protein folding and function. On the protein surface, water is not placed randomly, but display instead a particular structure evidenced by the presence of specific water sites (WS). These WS can be derived and characterized using explicit water Molecular Dynamics simulations, providing useful information for ligand binding prediction and design. Here we present WATCLUST, a WS determination and analysis tool running on the VMD platform. The tool also allows direct transfer of the WS information to Autodock program to perform biased docking. Availability and implementation: The WATCLUST plugin and documentation are freely available at http://sbg.qb.fcen.uba.ar/watclust/.","authors":[{"name":"Arcon J.P."},{"name":"Dumas V.G."},{"name":"Gauto D.F."},{"name":"Lopez E.D."},{"name":"Marti M.A."},{"name":"Modenutti C.P."},{"name":"Petruk A.A."},{"name":"Turjanski A.G."}],"citationCount":51,"date":"2015-05-25T00:00:00Z","journal":"Bioinformatics","title":"WATCLUST: A tool for improving the design of drugs based on protein-water interactions"},"pmid":"26198103","type":["Primary"]}],"topic":[{"term":"Molecular dynamics","uri":"http://edamontology.org/topic_0176"},{"term":"Molecular modelling","uri":"http://edamontology.org/topic_2275"},{"term":"Protein structural motifs and surfaces","uri":"http://edamontology.org/topic_0166"}],"validated":1},"bioschemas":{"name":"WATCLUST","home":"https://bio.tools/WATCLUST","license":"Unlicense","summary":"Tool for improving the design of drugs based on protein-water interactions.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:watclust/app/watclust.wordpress.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"packages":true,"source_packages":true},"project":{"build":{},"deployment":{},"documentation":{"general":true,"training_material":true},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":31,"citations":[{"count":1,"year":"2016"},{"count":1,"year":"2018"},{"count":1,"year":"2026"},{"count":2,"year":"2017"},{"count":2,"year":"2019"},{"count":2,"year":"2023"},{"count":4,"year":"2021"},{"count":4,"year":"2022"},{"count":4,"year":"2025"},{"count":5,"year":"2020"},{"count":5,"year":"2024"}],"doi":"10.1093/bioinformatics/btv411","pmid":"26198103","ref_count":0,"refs":[],"title":"WATCLUST: a tool for improving the design of drugs based on protein-water interactions.","year":2015}]}],"summary":{"des