{"tool_name":"chiron","contents":["biocontainers","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"chiron","version":"0.6.1.1","home":"https://github.com/haotianteng/chiron","license":"Mozilla Public License 2.0 (MPL 2.0)","summary":"A deep neural network basecaller for nanopore sequencing.","identifiers":["doi:10.1093/gigascience/giy037","biotools:Chiron"],"build":{"entry_points":["chiron=chiron.entry:main"],"noarch":"python","number":0,"script":" -m pip install . --no-deps --ignore-installed -vvv "},"requirements":{"host":["pip","python 2.7"],"run":["h5py >=2.7.0","mappy >=2.10.0","numpy >=1.13.3","python 2.7","statsmodels >=0.8.0","tqdm >=4.23.0","tensorflow >=1.3.0"]},"source_url":"https://pypi.io/packages/source/c/chiron/chiron-0.6.1.1.tar.gz"},"biocontainers":{"name":"chiron","identifiers":["doi:10.1093/gigascience/giy037","biotools:Chiron"],"license":"Mozilla Public License 2.0 (MPL 2.0)","summary":"A deep neural network basecaller for nanopore sequencing.","home_url":"https://github.com/haotianteng/chiron","keywords":["Base Pairing","Base Sequence","Escherichia coli","Machine Learning","Mycobacterium tuberculosis","Nanopores","Neural Networks, Computer","Nucleotides","Probability","Reproducibility of Results","Sequence Analysis, DNA","Signal Processing, Computer-Assisted","Machine learning","Sequencing","Sequence analysis"],"manually_check":true,"total_pulls":2},"biotools":{"id":"chiron","home":"https://github.com/haotianteng/chiron","summary":"A basecaller for Oxford Nanopore Technologies' sequencers.","addition_date":"2018-07-13T17:22:13Z","last_update_date":"2024-11-25T14:32:48.744532Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:chiron","credit":[{"email":"haotian.teng@uq.net.au","name":"Haotian Teng","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"l.coin@imb.uq.edu.au","name":"Lachlan J M Coin","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"ur