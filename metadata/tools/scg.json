{"tool_name":"scg","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"scg","identifiers":["biotools:scg","doi:10.1038/nmeth.3867"],"license":"GPL-3.0","summary":"Software for inference of clonal genotypes using targeted single cell nucleus sequencing.","home_url":"https://bitbucket.org/aroth85/scg/src","keywords":["Clone Cells","Cystadenocarcinoma, Serous","Female","Genome, Human","Genotype","High-Throughput Nucleotide Sequencing","Humans","Leukemia","Mammary Glands, Human","Models, Statistical","Ovarian Neoplasms","Polymorphism, Single Nucleotide","Single-Cell Analysis","Oncology","Sequence analysis","DNA mutation"],"manually_check":true,"total_pulls":0},"biotools":{"id":"scg","home":"http://shahlab.ca/projects/scg/","license":"GPL-3.0","summary":"A new statistical model and machine learning inference algorithm designed to determine the pattern of how DNA mutations are distributed in individual cells of a tumour. The software provides implementation of several probabilistic models for clustering single cell (nucleus) data and inferring clonal genotypes.","addition_date":"2017-08-20T15:59:02Z","last_update_date":"2024-11-25T14:04:59.260246Z","tool_type":["Library"],"collections":["Animal and Crop Genomics"],"biotools_curie":"biotools:scg","credit":[{"typeEntity":"Person","typeRole":["Primary contact"],"url":"https://groups.google.com/forum/#!forum/single-cell-genotyper-user-group"}],"documentation":[{"type":["General"],"url":"https://bitbucket.org/aroth85/scg/wiki/Usage"}],"edit_permission":{"authors":["animalandcropgenomics"],"type":"group"},"function":[{"operation":[{"term":"Variant pattern analysis","uri":"http://edamontology.org/operation_3504"}]}],"name":"Single Cell Genotyper (SCG)","operating_system":["Linux","Mac","Windows"],"owner":"admin","publication":[{"doi":"10.1038/nmeth.3867","metadata":{"abstract":"Single-cell DNA sequencing has great potential to reveal the clonal genotypes and population structur