{"tool_name":"rosettadock_server","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"rosettadock_server","home":"http://rosie.graylab.jhu.edu/","summary":"Structure prediction program that searches the rigid body and side chain conformational space of two interacting proteins to find a minimum free-energy complex for the protein-protein interaction structure.","addition_date":"2017-03-24T11:59:26Z","last_update_date":"2018-12-10T12:58:52Z","tool_type":["Web application"],"biotools_curie":"biotools:rosettadock_server","credit":[{"email":"sergey.lyskov@jhu.edu","name":"Sergey Lyskov","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://rosie.graylab.jhu.edu/documentation"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Molecular docking","uri":"http://edamontology.org/operation_0478"},{"term":"Protein interaction prediction","uri":"http://edamontology.org/operation_2492"},{"term":"Protein modelling (side chains)","uri":"http://edamontology.org/operation_0480"},{"term":"Protein structure prediction","uri":"http://edamontology.org/operation_0474"},{"term":"Protein-protein interaction prediction","uri":"http://edamontology.org/operation_2464"}]}],"name":"RosettaDock Server","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"metadata":{"abstract":"The RosettaDock server (http://rosettadock.graylab.jhu.edu) identifies low-energy conformations of a protein-protein interaction near a given starting configuration by optimizing rigid-body orientation and side-chain conformations. The server requires two protein structures as inputs and a starting location for the search. RosettaDock generates 1000 independent structures, and the server returns pictures, coordinate files and detailed scoring information for the 10 top-scoring models. A plot of the total energy of each of the 1000 models created shows the presence or absence of an energetic binding funnel. RosettaDock has been validated on the docking benchmark set and through the Critical Assessment of PRedicted Interactions blind prediction challenge.","authors":[{"name":"Gray J.J."},{"name":"Lyskov S."}],"citationCount":354,"date":"2008-01-01T00:00:00Z","journal":"Nucleic acids research","title":"The RosettaDock server for local protein-protein docking."},"pmid":"18442991"}],"topic":[{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Molecular modelling","uri":"http://edamontology.org/topic_2275"},{"term":"Protein interactions","uri":"http://edamontology.org/topic_0128"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"},{"term":"Structure prediction","uri":"http://edamontology.org/topic_0082"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:rosettadock_server/web/rosie.graylab.jhu.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":311,"citations":[{"count":1,"year":"2008"},{"count":7,"year":"2009"},{"count":10,"year":"2017"},{"count":11,"year":"2026"},{"count":14,"year":"2012"},{"count":15,"year":"2010"},{"count":15,"year":"2019"},{"count":15,"year":"2020"},{"count":15,"year":"2025"},{"count":16,"year":"2011"},{"count":16,"year":"2016"},{"count":16,"year":"2018"},{"count":17,"year":"2014"},{"count":18,"year":"2015"},{"count":21,"year":"2013"},{"count":21,"year":"2023"},{"count":23,"year":"2022"},{"count":28,"year":"2024"},{"count":32,"year":"2021"}],"doi":"10.1093/nar/gkn216","pmcid":"PMC2447798","pmid":"18442991","ref_count":37,"refs":[{"count":1,"year":"1997"},{"count":3,"year":"2000"},{"count":3,"year":"2004"},{"count":3,"year":"2008"},{"count":5,"year":"2003"},{"count":5,"year":"2005"},{"count":8,"year":"2006"},{"count