{"tool_name":"bandits","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"BANDITS","home":"https://bioconductor.org/packages/BANDITS","license":"GPL-3.0-or-later","summary":"BANDITS is a Bayesian hierarchical model for detecting differential splicing of genes and transcripts, via differential transcript usage (DTU), between two or more conditions. The method uses a Bayesian hierarchical framework, which allows for sample specific proportions in a Dirichlet-Multinomial model, and samples the allocation of fragments to the transcripts. Parameters are inferred via Markov chain Monte Carlo (MCMC) techniques and a DTU test is performed via a multivariate Wald test on the posterior densities for the average relative abundance of transcripts.","addition_date":"2019-11-14T18:05:08Z","last_update_date":"2026-08-30T02:02:50.549626Z","version":["1.28.0"],"collections":["BioConductor"],"biotools_curie":"biotools:BANDITS","credit":[{"name":"Simone Tiberi","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/BANDITS"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Differential gene expression analysis","uri":"http://edamontology.org/operation_3223"},{"term":"RNA-Seq quantification","uri":"http://edamontology.org/operation_3800"},{"term":"Splice transcript prediction","uri":"http://edamontology.org/operation_0264"}]}],"name":"BANDITS","owner":"Pub2Tools","publication":[{"doi":"10.1186/s13059-020-01967-8"}],"topic":[{"term":"RNA splicing","uri":"http://edamontology.org/topic_3320"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"BANDITS","home":"https://bio.tools/BANDITS","license":"GPL-3.0-or-later","version":"1.28.0","summary":"BANDITS is a Bayesian hierarchical model for detecting differential splicing of genes and 