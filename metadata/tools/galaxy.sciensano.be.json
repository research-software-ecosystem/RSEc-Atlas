{"tool_name":"galaxy.sciensano.be","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"galaxy.sciensano.be","home":"https://galaxy.sciensano.be/","summary":"Galaxy @Sciensano is a Galaxy server dedicated completely towards public health applications, focusing heavily on making available tools, pipelines and databases relevant for using WGS for routine pathogen typing and characterization in an applied public health setting. The main goal of this Galaxy instance is to serve as an \u2018all-in-one\u2019 portal for microbial public health applications. All staple bioinformatics utilities are incorporated (assembly, read mapping, sequence alignment etc.). Of particular interest, in-house developed tools provide entire solutions that perform all required steps, without the need to go through all individual steps of the NGS data analysis process. Typically only the raw read data needs to be specified and all steps are automated so that the user immediately gets the required output, which is in many cases contained within user-friendly interactive output reports that contain all required information.","addition_date":"2020-07-03T14:47:52Z","last_update_date":"2020-07-03T14:55:49Z","tool_type":["Bioinformatics portal","Web application","Workflow"],"accessibility":"Open access","biotools_curie":"biotools:galaxy.sciensano.be","cost":"Free of charge","edit_permission":{"type":"private"},"maturity":"Emerging","name":"galaxy.sciensano.be","operating_system":["Linux"],"owner":"KevinVanneste","topic":[{"term":"Computational biology","uri":"http://edamontology.org/topic_3307"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Nucleic acids","uri":"http://edamontology.org/topic_0077"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:galaxy.sciensano.be/web/galaxy.sciensano.be","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution"