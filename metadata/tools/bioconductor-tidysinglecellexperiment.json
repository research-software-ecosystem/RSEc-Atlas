{"tool_name":"bioconductor-tidysinglecellexperiment","contents":["oeb","biocontainers","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-tidysinglecellexperiment","identifiers":["doi:10.18129/b9.bioc.tidysinglecellexperiment"],"license":"GPL-3","summary":"Brings SingleCellExperiment to the Tidyverse","home_url":"https://bioconductor.org/packages/3.12/bioc/html/tidySingleCellExperiment.html","keywords":["Clustering","Transcriptomics"],"manually_check":true,"total_pulls":120},"biotools":{"id":"bioconductor-tidysinglecellexperiment","home":"https://bioconductor.org/packages/tidySummarizedExperiment","license":"GPL-3.0","summary":"The tidySummarizedExperiment package provides a set of tools for creating and manipulating tidy data representations of SummarizedExperiment objects. SummarizedExperiment is a widely used data structure in bioinformatics for storing high-throughput genomic data, such as gene expression or DNA sequencing data. The tidySummarizedExperiment package introduces a tidy framework for working with SummarizedExperiment objects. It allows users to convert their data into a tidy format, where each observation is a row and each variable is a column. This tidy representation simplifies data manipulation, integration with other tidyverse packages, and enables seamless integration with the broader ecosystem of tidy tools for data analysis.","addition_date":"2026-08-31T21:26:14.181212Z","last_update_date":"2026-09-06T01:51:24.768157Z","tool_type":["Command-line tool","Library"],"version":["1.22.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-tidysinglecellexperiment","credit":[{"name":"Stefano Mangiola","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/tidySummarizedExperiment"}],"edit_permission":{"type":"private"},"name":"tidySingleCellExperiment","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.1038/s41592-024-02299-2"},{"doi":"10.1038/s41592-024-02299-2"}]},"bioschemas":{"name":"tidySingleCellExperiment","home":"https://bio.tools/bioconductor-tidysinglecellexperiment","license":"GPL-3.0-only","version":"1.22.0","summary":"'tidySingleCellExperiment' is an adapter that abstracts the 'SingleCellExperiment' container in the form of a 'tibble'. This allows *tidy* data manipulation, nesting, and plotting. For example, a 'tidySingleCellExperiment' is directly compatible with functions from 'tidyverse' packages `dplyr` and `tidyr`, as well as plotting with `ggplot2` and `plotly`. In addition, the package provides various utility functions specific to single-cell omics data analysis (e.g., aggregation of cell-level data to pseudobulks).","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-tidysinglecellexperiment:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-tidysinglecellexperiment:1.10.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-tidysinglecellexperiment:1.12.0/cmd/bio