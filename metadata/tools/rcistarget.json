{"tool_name":"rcistarget","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"rcistarget","home":"https://bioconductor.org/packages/RcisTarget","license":"GPL-3.0","summary":"RcisTarget identifies transcription factor binding motifs (TFBS) over-represented on a gene list.  In a first step, RcisTarget selects DNA motifs that are significantly over-represented in the surroundings of the transcription start site (TSS) of the genes in the gene-set.  This is achieved by using a database that contains genome-wide cross-species rankings for each motif. The motifs that are then annotated to TFs and those that have a high Normalized Enrichment Score (NES) are retained.  Finally, for each motif and gene-set, RcisTarget predicts the candidate target genes (i.e. genes in the gene-set that are ranked above the leading edge).","addition_date":"2018-07-14T20:21:43Z","last_update_date":"2024-11-25T14:35:08.425464Z","tool_type":["Library"],"version":["1.32.0"],"collections":["BioConductor"],"biotools_curie":"biotools:rcistarget","credit":[{"name":"Belgium"},{"name":"Gert Hulselmans"},{"name":"Sara Aibar"},{"name":"Stein Aerts. Laboratory of Computational Biology.  VIB-KU Leuven Center for Brain & Disease Research. Leuven"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/RcisTarget"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene-set enrichment analysis","uri":"http://edamontology.org/operation_2436"}]},{"operation":[{"term":"Transcription factor binding site prediction","uri":"http://edamontology.org/operation_0445"}]}],"name":"RcisTarget","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[],"topic":[{"term":"Gene regulation","uri":"http://edamontology.org/topic_0204"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:rcistarget:1.0.2/lib/bioconductor.org","@licens