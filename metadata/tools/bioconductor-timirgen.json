{"tool_name":"bioconductor-timirgen","contents":["biocontainers","oeb"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-timirgen","identifiers":["doi:10.18129/b9.bioc.timirgen"],"license":"GPL-3.0","summary":"TimiRGeN (Time Incorporated miR-mRNA Generation of Networks) is a novel R package which functionally analyses and integrates time course miRNA-mRNA differential expression data. This tool can generate small networks within R or export results into cytoscape or pathvisio for more detailed network construction and hypothesis generation. This tool is created for researchers that wish to dive deep into time series multi-omic datasets. TimiRGeN goes further than many other tools in terms of data reduction. Here, potentially hundreds of thousands of potential miRNA-mRNA interactions can be whittled down into a handful of high confidence miRNA-mRNA interactions effecting a signalling pathway, across a time course.","home_url":"https://bioconductor.org/packages/3.12/bioc/html/TimiRGeN.html","keywords":["Clustering"],"manually_check":true,"total_pulls":114},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-timirgen:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-timirgen:1.0.3/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":