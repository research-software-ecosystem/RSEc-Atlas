{"tool_name":"cafe_sequence_analysis","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"cafe_sequence_analysis","home":"https://github.com/younglululu/CAFE","summary":"aCcelerated Alignment-FrEe sequence analysis. Compute overall 28 distance/dissimilarity measures including (1) conventional measures based on k-mer counts, (2) newly developed measures based on background adjusted k-mer counts, and (3) measures based on presence/absence of k-mers.","addition_date":"2018-07-24T09:49:15Z","last_update_date":"2018-12-10T12:59:00Z","tool_type":["Command-line tool","Desktop application"],"biotools_curie":"biotools:cafe_sequence_analysis","credit":[{"email":"fsun@usc.edu","name":"Prof. Fengzhu Sun","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"ylu465@usc.edu","name":"Yang Lu","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/younglululu/CAFE/blob/master/README.md"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Sequence alignment","uri":"http://edamontology.org/operation_0292"}]},{"operation":[{"term":"Sequence assembly","uri":"http://edamontology.org/operation_0310"},{"term":"k-mer counting","uri":"http://edamontology.org/operation_3472"}]}],"name":"CAFE","operating_system":["Linux","Mac","Windows"],"owner":"aotamendi.1","publication":[{"doi":"10.1093/nar/gkx351","metadata":{"abstract":"\u00a9The Author(s) 2017. Published by Oxford University Press on behalf of Nucleic Acids Research.Alignment-free genome and metagenome comparisons are increasingly important with the development of next generation sequencing (NGS) technologies. Recently developed state-of-the-art k-mer based alignment-free dissimilarity measures including CVTree, d2\u2217 and d2S are more computationally expensive than measures based solely on the k-mer frequencies. Here, we report a standalone software, aCcelerated Alignment-FrEe sequence analysis (CAFE), for efficient calculation of 28 alignment-free dissimilarity measures. CAFE allows for both assembled genome sequences and unassembled NGS shotgun reads as input, and wraps the output in a standard PHYLIP format. In downstream analyses, CAFE can also be used to visualize the pairwise dissimilarity measures, including dendrograms, heatmap, principal coordinate analysis and network display.","authors":[{"name":"Fuhrman J.A."},{"name":"Lu Y.Y."},{"name":"Ren J."},{"name":"Sun F."},{"name":"Tang K."},{"name":"Waterman M.S."}],"citationCount":30,"date":"2017-07-03T00:00:00Z","journal":"Nucleic Acids Research","title":"CAFE: A C celerated A lignment- F r E e sequence analysis"},"pmcid":"PMC5793812","pmid":"28472388","type":["Primary"]}],"topic":[{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"bioschemas":{"name":"CAFE","home":"https://bio.tools/cafe_sequence_analysis","summary":"aCcelerated Alignment-FrEe sequence analysis. Compute overall 28 distance/dissimilarity measures including (1) conventional measures based on k-mer counts, (2) newly developed measures based on background adjusted k-mer counts, and (3) measures based on presence/absence of k-mers.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:cafe_sequence_analysis/app/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":38,"citations":[{"count":1,"year":"2017"},{"cou