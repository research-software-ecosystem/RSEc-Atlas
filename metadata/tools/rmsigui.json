{"tool_name":"rmsigui","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"rmsigui","home":"https://bitbucket.org/lababi/rmsigui/","license":"GPL-3.0","summary":"RmsiGUI provides a graphical user interface (GUI) to analyze mass spectrometry imaging (MSI) data with the statistical language R. The interface is based on 'shiny' and visualized in a web browser.","addition_date":"2021-10-21T23:29:29.306797Z","last_update_date":"2024-11-24T13:48:30.788236Z","tool_type":["Command-line tool","Web application"],"accessibility":"Open access","biotools_curie":"biotools:rmsigui","cost":"Free of charge","credit":[{"email":"robert.winkler@cinvestav.mx","name":"Robert Winkler","orcidid":"https://orcid.org/0000-0001-6732-1958","typeEntity":"Person"},{"name":"Ignacio Rosas-Rom\u00e1n"}],"edit_permission":{"authors":["sizhengZhao"],"type":"group"},"function":[{"input":[{"data":{"term":"Mass spectrometry data","uri":"http://edamontology.org/data_2536"},"format":[{"term":"imzML metadata file","uri":"http://edamontology.org/format_3682"}]}],"operation":[{"term":"Image analysis","uri":"http://edamontology.org/operation_3443"},{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}],"output":[{"data":{"term":"Report","uri":"http://edamontology.org/data_2048"},"format":[{"term":"CSV","uri":"http://edamontology.org/format_3752"},{"term":"PDF","uri":"http://edamontology.org/format_3508"}]}]},{"input":[{"data":{"term":"Mass spectrometry data","uri":"http://edamontology.org/data_2536"},"format":[{"term":"imzML metadata file","uri":"http://edamontology.org/format_3682"}]}],"operation":[{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}],"output":[{"data":{"term":"Image","uri":"http://edamontology.org/data_2968"},"format":[{"term":"JPG","uri":"http://edamontology.org/format_3579"},{"term":"PNG","uri":"http://edamontology.org/format_3603"},{"term":"TIFF","uri":"http://edamontology.org/format_3591"}]}]}],"name":"RmsiGUI","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.7717/peerj-cs.585","metadata":{"abstract":"Mass spectrometry imaging (MSI) enables the unbiased characterization of surfaces with respect to their chemical composition. In biological MSI, zones with differential mass profiles hint towards localized physiological processes, such as the tissue-specific accumulation of secondary metabolites, or diseases, such as cancer. Thus, the efficient discovery of \u2018regions of interest\u2019 (ROI) is of utmost importance in MSI. However, often the discovery of ROIs is hampered by high background noise and artifact signals. Especially in ambient ionization MSI, unmasking biologically relevant information from crude data sets is challenging. Therefore, we implemented a Threshold Intensity Quantization (TrIQ) algorithm for augmenting the contrast in MSI data visualizations. The simple algorithm reduces the impact of extreme values (\u2018outliers\u2019) and rescales the dynamic range of mass signals. We provide an R script for post-processing MSI data in the imzML community format (https://bitbucket.org/lababi/msi.r) and implemented the TrIQ in our open-source imaging software RmsiGUI (https://bitbucket.org/lababi/rmsigui/). Applying these programs to different biologicalMSI data sets demonstrated the universal applicability of TrIQ for improving the contrast in the MSI data visualization. We show that TrIQ improves a subsequent detection of ROIs by sectioning. In addition, the adjustment of the dynamic signal intensity range makes MSI data sets comparable.","authors":[{"name":"Rosas-Roman I."},{"name":"Winkler R."}],"citationCount":3,"date":"2021-01-01T00:00:00Z","journal":"PeerJ Computer Science","title":"Contrast Optimization of Mass spectrometry Imaging (MSI) Data visualization by Threshold Intensity quantization (TrIQ)"},"pmcid":"PMC8205298","pmid":"34179452"}],"topic":[{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}],"validated":1},"bioschemas":{"name":"RmsiGUI","home":"https://bio.tools/rmsigui","license":"GPL-3.0","summary":"RmsiGUI provides a graphical user interface (GUI) to analyze mass spectrometry imaging (MSI) data with the statistical language R. The interface is based on 'shiny' and visualized in a web browser.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:rmsigui/cmd/bitbucket.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":3,"citations":[{"count":1,"year":"2025"},{"count":2,"year":"2024"}],"doi":"10.7717/peerj-cs.585","pmcid":"PMC8205298","pmid":"34179452","ref_count":25,"refs":[{"count":1,"year":"-1"},{"count":1,"year":"2006"},{"count":1,"year":"2007"},{"count":1,"year":"2011"},{"count":1,"year":"2014"},{"count":1,"year":"2018"},{"count":1,"year":"2020"},{"count":3,"year":"2010"},{"count":3,"year":"2012"},{"count":3,"year":"2017"},{"count":3,"year":"2019"},{"count":6,"year":"2015"}],"title":"Contrast optimization of mass spectrometry imaging (MSI) data visualization by threshold intensity quantization (TrIQ).","year":2021}]}],"readme":false,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":true,"resolve_time":nu