{"tool_name":"bioconductor-mscoreutils","contents":["oeb","biocontainers","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-mscoreutils","identifiers":["doi:10.18129/b9.bioc.mscoreutils"],"license":"Artistic-2.0","summary":"Core Utils for Mass Spectrometry Data","home_url":"https://bioconductor.org/packages/3.11/bioc/html/MsCoreUtils.html","keywords":["Proteomics","Mass spectra","Mass spectrometry","Metabolomics"],"manually_check":true,"total_pulls":4},"biotools":{"id":"bioconductor-mscoreutils","home":"https://bioconductor.org/packages/MetaboCoreUtils","license":"Artistic-2.0","summary":"MetaboCoreUtils defines metabolomics-related core functionality provided as low-level functions to allow a data structure-independent usage across various R packages. This includes functions to calculate between ion (adduct) and compound mass-to-charge ratios and masses or functions to work with chemical formulas. The package provides also a set of adduct definitions and information on some commercially available internal standard mixes commonly used in MS experiments.","addition_date":"2026-08-30T02:46:56.830697Z","last_update_date":"2026-09-13T07:26:24.455174Z","tool_type":["Command-line tool","Library"],"version":["1.20.1"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-mscoreutils","credit":[{"name":"fnd: MetaRbolomics4Galaxy project"},{"name":"Andrea Vicini","typeEntity":"Person","typeRole":["Developer"]},{"name":"Gabriele Tom\u00e8","typeEntity":"Person","typeRole":["Developer"]},{"name":"Johannes Rainer","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Liesa Salzer","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Michael Stravs","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Michael Witting","typeEntity":"Person","typeRole":["Developer"]},{"name":"Philippine Louail","typeEntity":"Person","typeRole":["Developer"]},{"name":"Roger Gine","typeEntity":"Person","typeRole":["Developer"]},{"name":"Sebastian Gibb","typeEntity":"Person","typeRole":["Developer"]},{"name":"William Kumler","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/MetaboCoreUtils"}],"edit_permission":{"type":"private"},"name":"MsCoreUtils","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.3390/metabo12020173"}]},"bioschemas":{"name":"MsCoreUtils","home":"https://bio.tools/bioconductor-mscoreutils","license":"Artistic-2.0","version":"1.24.0","summary":"MsCoreUtils defines low-level functions for mass spectrometry data and is independent of any high-level data structures. These functions include mass spectra processing functions (noise estimation, smoothing, binning, baseline estimation), quantitative aggregation functions (median polish, robust summarisation, ...), missing data imputation, data normalisation (quantiles, vsn, ...), misc helper functions, that are used across high-level data structure within the R for Mass Spectrometry packages.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-mscoreutils:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-mscoreutils:1.10.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"summar