{"tool_name":"bioconductor-scddboost","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-scddboost","home":"https://bioconductor.org/packages/scDDboost","license":"GPL-2.0-or-later","summary":"scDDboost is an R package to analyze changes in the distribution of single-cell expression data between two experimental conditions. Compared to other methods that assess differential expression, scDDboost benefits uniquely from information conveyed by the clustering of cells into cellular subtypes. Through a novel empirical Bayesian formulation it calculates gene-specific posterior probabilities that the marginal expression distribution is the same (or different) between the two conditions. The implementation in scDDboost treats gene-level expression data within each condition as a mixture of negative binomial distributions.","tool_type":["Command-line tool","Library"],"version":["1.14.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-scddboost","credit":[{"name":"Michael A. Newton","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Xiuyu Ma","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/scDDboost"}],"name":"scDDboost","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-scddboost:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-scddboost:1.2.0/cmd/