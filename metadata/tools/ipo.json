{"tool_name":"ipo","contents":["biocontainers","galaxy","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"bioconductor-ipo","version":"1.36.0","home":"https://bioconductor.org/packages/3.22/bioc/html/IPO.html","license":"GPL (>= 2) + file LICENSE","summary":"Automated Optimization of XCMS Data Processing parameters","identifiers":["biotools:ipo"],"description":"The outcome of XCMS data processing strongly depends on the parameter settings. IPO (`Isotopologue Parameter Optimization`) is a parameter optimization tool that is applicable for different kinds of samples and liquid chromatography coupled to high resolution mass spectrometry devices, fast and free of labeling steps. IPO uses natural, stable 13C isotopes to calculate a peak picking score. Retention time correction is optimized by minimizing the relative retention time differences within features and grouping parameters are optimized by maximizing the number of features showing exactly one peak from each injection of a pooled sample. The different parameter settings are achieved by design of experiment. The resulting scores are evaluated using response surface models.","license_file":"LICENSE","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-biocparallel >=1.44.0,<1.45.0","bioconductor-camera >=1.66.0,<1.67.0","bioconductor-xcms >=4.8.0,<4.9.0","r-base","r-rsm"],"run":["bioconductor-biocparallel >=1.44.0,<1.45.0","bioconductor-camera >=1.66.0,<1.67.0","bioconductor-xcms >=4.8.0,<4.9.0","r-base","r-rsm"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/IPO_1.36.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/IPO/IPO_1.36.0.tar.gz","https://bioarchive.galaxyproject.org/IPO_1.36.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-ipo/bioconductor-ipo_1.36.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('IPO')\""]},"parent_recipe":{"name":"bioconductor-ipo","path":"recipes/bioconductor-ipo","version":"1.8.0"}},"biocontainers":{"name":"ipo","identifiers":["biotools:ipo","doi:10.1186/s12859-015-0562-8"],"license":"Custom License","summary":"A Tool for automated Optimization of XCMS Parameters","home_url":"https://github.com/rietho/IPO","keywords":["Animals","Carbon Radioisotopes","Chromatography, Liquid","Electronic Data Processing","Heart","Humans","Lipids","Lung","Mass Spectrometry","Metabolomics","Mice","Muscles","Programming Languages","Reproducibility of Results","Saccharomyces cerevisiae","Proteomics experiment","Proteomics","Mass spectrometry"],"manually_check":true,"total_pulls":0},"biotools":{"id":"ipo","home":"https://bioconductor.org/packages/IPO","license":"GPL-2.0-or-later","summary":"The outcome of XCMS data processing strongly depends on the parameter settings. IPO (`Isotopologue Parameter Optimization`) is a parameter optimization tool that is applicable for different kinds of samples and liquid chromatography coupled to high resolution mass spectrometry devices, fast and free of labeling steps. IPO uses natural, stable 13C isotopes to calculate a peak picking score. Retention time correction is optimized by minimizing the relative retention time differences within features and grouping parameters are optimized by maximizing the number of features showing exactly one peak from each injection of a pooled sample. The different parameter settings are achieved by design of experiment. The resulting scores are evaluated using response surface models.","addition_date":"2017-01-17T15:04:45Z","last_update_date":"2026-08-30T02:20:16.081716Z","tool_type":["Command-line tool","Library"],"version":["1.38.0"],"collections":["BioConductor","Proteomics"],"biotools_curie":"biotools:ipo","credit":[{"name":"Christoph Magnes"},{"name":"Gunnar Libiseller"},{"name":"Thomas Lieb"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/IPO"}],"edit_permission":{"authors":["proteomics.bio.too