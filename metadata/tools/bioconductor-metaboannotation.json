{"tool_name":"bioconductor-metaboannotation","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-metaboannotation","home":"https://bioconductor.org/packages/MetaboCoreUtils","license":"Artistic-2.0","summary":"MetaboCoreUtils defines metabolomics-related core functionality provided as low-level functions to allow a data structure-independent usage across various R packages. This includes functions to calculate between ion (adduct) and compound mass-to-charge ratios and masses or functions to work with chemical formulas. The package provides also a set of adduct definitions and information on some commercially available internal standard mixes commonly used in MS experiments.","addition_date":"2026-08-30T02:45:50.131543Z","last_update_date":"2026-08-31T21:25:54.796331Z","tool_type":["Command-line tool","Library"],"version":["1.20.1"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-metaboannotation","credit":[{"name":"fnd: MetaRbolomics4Galaxy project"},{"name":"Andrea Vicini","typeEntity":"Person","typeRole":["Developer"]},{"name":"Gabriele Tom\u00e8","typeEntity":"Person","typeRole":["Developer"]},{"name":"Johannes Rainer","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Liesa Salzer","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Michael Stravs","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Michael Witting","typeEntity":"Person","typeRole":["Developer"]},{"name":"Philippine Louail","typeEntity":"Person","typeRole":["Developer"]},{"name":"Roger Gine","typeEntity":"Person","typeRole":["Developer"]},{"name":"Sebastian Gibb","typeEntity":"Person","typeRole":["Developer"]},{"name":"William Kumler","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/MetaboCoreUtils"}],"edit_permission":{"type":"private"},"name":"MetaboAnnotation","operating_system":["Linux","Mac","Windows"],"owner":"g