{"tool_name":"ceu_mass_mediator","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"ceu_mass_mediator","home":"http://ceumass.eps.uspceu.es/","license":"Unlicense","summary":"Tool for looking up metabolites in different databases (Kegg, HMDB, LipidMaps, Metlin and MINE) from experimental masses obtained by mass spectrometry.","addition_date":"2019-01-23T10:02:49Z","last_update_date":"2021-04-20T13:07:32Z","tool_type":["Web application"],"version":["3.0"],"accessibility":"Open access","biotools_curie":"biotools:ceu_mass_mediator","cost":"Free of charge","credit":[{"email":"cmm.cembio@ceu.es","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://ceumass.eps.uspceu.es/mediator/resources/CMM_manual_version_3.0.pdf"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Mass spectrometry spectra","uri":"http://edamontology.org/data_0943"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]},{"data":{"term":"Molecular mass","uri":"http://edamontology.org/data_0844"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}],"operation":[{"term":"Annotation","uri":"http://edamontology.org/operation_0226"},{"term":"Database search","uri":"http://edamontology.org/operation_2421"}],"output":[{"data":{"term":"Compound ID (HMDB)","uri":"http://edamontology.org/data_2622"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]},{"data":{"term":"PubChem ID","uri":"http://edamontology.org/data_2639"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]},{"data":{"term":"Score","uri":"http://edamontology.org/data_1772"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}]}],"maturity":"Mature","name":"CEU Mass Mediator","operating_system":["Linux","Mac","Windows"],"owner":"albertogilf","publication":[{"doi":"10.1016/j.jpba.2018.02.046","metadata":{"abstract":"\u00a9 2018 Elsevier B.V.CEU Mass Mediator (CMM) is an on-line tool for aiding researchers when performing metabolite annotation. Its database is comprised of 279,318 real compounds integrated from several metabolomic databases including Human Metabolome Database (HMDB), KEGG and LipidMaps and 672,042 simulated compounds from MINE. In addition, CMM scores the annotations which matched the query parameters using 122 rules based on expert knowledge. This knowledge, obtained from the Centre for Metabolomics and Bioanalysis (CEMBIO) and from a literature review, enables CMM expert system to automatically extract evidence to support or refute the annotations by checking relationships among them. CMM is the first metabolite annotation tool that uses a knowledge-driven approach to provide support to the researcher. This allows to focus on the most plausible annotations, thus saving time and minimizing mistakes.","authors":[{"name":"Barbas C."},{"name":"Fernandez Lopez M."},{"name":"Gil de la Fuente A."},{"name":"Godzien J."},{"name":"Otero A."},{"name":"Ruperez F.J."}],"citationCount":44,"date":"2018-05-30T00:00:00Z","journal":"Journal of Pharmaceutical and Biomedical Analysis","title":"Knowledge-based metabolite annotation tool: CEU Mass Mediator"},"pmid":"29547800","type":["Primary"],"version":"2.0"}],"topic":[{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"}],"validated":1},"bioschemas":{"name":"CEU Mass Mediator","home":"https://bio.tools/ceu_mass_mediator","license":"Unlicense","version":"3.0","summary":"Tool for looking up metabolites in different databases (Kegg, HMDB, LipidMaps, Metlin and MINE) from experimental masses obtained by mass spectrometry.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ceu_mass_mediator:3.0/web/ceumass.eps.uspceu.es","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"dist