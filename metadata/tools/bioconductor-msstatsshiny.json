{"tool_name":"bioconductor-msstatsshiny","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-msstatsshiny","home":"https://bioconductor.org/packages/MSstatsShiny","license":"Artistic-2.0","summary":"MSstatsShiny is an R-Shiny graphical user interface (GUI) integrated with the R packages MSstats, MSstatsTMT, and MSstatsPTM. It provides a point and click end-to-end analysis pipeline applicable to a wide variety of experimental designs. These include data-dependedent acquisitions (DDA) which are label-free or tandem mass tag (TMT)-based, as well as DIA, SRM, and PRM acquisitions and those targeting post-translational modifications (PTMs). The application automatically saves users selections and builds an R script that recreates their analysis, supporting reproducible data analysis.","tool_type":["Command-line tool","Library"],"version":["1.14.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-msstatsshiny","credit":[{"name":"Anthony Wu","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Cristina Pasi","typeEntity":"Person","typeRole":["Developer"]},{"name":"Deril Raju","typeEntity":"Person","typeRole":["Developer"]},{"name":"Devon Kohler","typeEntity":"Person","typeRole":["Developer"]},{"name":"Dhaval Mohandas","typeEntity":"Person","typeRole":["Developer"]},{"name":"Eduard Sabido","typeEntity":"Person","typeRole":["Developer"]},{"name":"Maanasa Kaza","typeEntity":"Person","typeRole":["Developer"]},{"name":"Mateusz Staniak","typeEntity":"Person","typeRole":["Developer"]},{"name":"Meena Choi","typeEntity":"Person","typeRole":["Developer"]},{"name":"Olga Vitek","typeEntity":"Person","typeRole":["Developer"]},{"name":"Ting Huang","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/MSstatsShiny"}],"name":"MSstatsShiny","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"do