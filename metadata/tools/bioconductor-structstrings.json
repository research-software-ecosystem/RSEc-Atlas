{"tool_name":"bioconductor-structstrings","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-structstrings","identifiers":["doi:10.18129/b9.bioc.structstrings"],"license":"Artistic-2.0","summary":"Implementation of the dot bracket annotations with Biostrings","home_url":"https://bioconductor.org/packages/3.9/bioc/html/Structstrings.html","keywords":[],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-structstrings","home":"https://bioconductor.org/packages/Structstrings","license":"Artistic-2.0","summary":"The Structstrings package implements the widely used dot bracket annotation for storing base pairing information in structured RNA. Structstrings uses the infrastructure provided by the Biostrings package and derives the DotBracketString and related classes from the BString class. From these, base pair tables can be produced for in depth analysis. In addition, the loop indices of the base pairs can be retrieved as well. For better efficiency, information conversion is implemented in C, inspired to a large extend by the ViennaRNA package.","addition_date":"2026-08-30T02:53:34.906689Z","last_update_date":"2026-08-30T02:53:34.908818Z","tool_type":["Command-line tool","Library"],"version":["1.28.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-structstrings","credit":[{"name":"Felix G.M. Ernst","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/Structstrings"}],"edit_permission":{"type":"private"},"name":"Structstrings","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.18129/B9.bioc.Structstrings"}]},"bioschemas":{"name":"Structstrings","home":"https://bio.tools/bioconductor-structstrings","license":"Artistic-2.0","version":"1.28.0","summary":"The Structstrings package implements the widely used dot bracket annotation for storing base pairing information in structured RNA. Structstrings uses the infrastructure provided by the Biostrings package and derives the DotBracketString and related classes from the BString class. From these, base pair tables can be produced for in depth analysis. In addition, the loop indices of the base pairs can be retrieved as well. For better efficiency, information conversion is implemented in C, inspired to a large extend by the ViennaRNA package.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-structstrings:1.0.3/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-structstrings:1.10.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-structstrings:1.14.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license"