{"tool_name":"nibr_2d-page","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"nibr_2d-page","home":"http://www.expasy.org/world-2dpage/","summary":"World-wide gel-based proteomics database.","addition_date":"2015-10-07T17:51:57Z","last_update_date":"2019-03-26T08:28:14Z","tool_type":["Database portal"],"collections":["DRCAT","Proteomics"],"biotools_curie":"biotools:nibr_2d-page","credit":[{"email":"Christine.Hoogland@isb-sib.ch","name":"Christine Hoogland","orcidid":"http://orcid.org/0000-0002-7341-1551","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"DRCAT","typeEntity":"Project","typeRole":["Documentor"]},{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://world-2dpage.expasy.org/contact"}],"documentation":[{"type":["General"],"url":"https://world-2dpage.expasy.org/portal/"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"input":[{"data":{"term":"Sequence accession (protein)","uri":"http://edamontology.org/data_1096"}}],"operation":[{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"}],"output":[{"data":{"term":"Experiment report","uri":"http://edamontology.org/data_2531"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"}]}]}],"name":"NIBR 2D-PAGE","operating_system":["Linux","Mac","Windows"],"owner":"DRCAT","publication":[{"doi":"10.1016/j.jprot.2008.02.005","metadata":{"abstract":"Since it was launched in 1993, the ExPASy server has been and is still a reference in the proteomics world. ExPASy users access various databases, many dedicated tools, and lists of resources, among other services. A significant part of resources available is devoted to two-dimensional electrophoresis data. Our latest contribution to the expansion of the pool of on-line proteomics data is the World-2DPAGE Constellation, accessible at http://world-2dpage.expasy.org/. It is composed of the established WORLD-2DPAGE List of 2-D PAGE database servers, the World-2DPAGE Portal that queries simultaneously world-wide proteomics databases, and the recently created World-2DPAGE Repository. The latter component is a public standards-compliant repository for gel-based proteomics data linked to protein identifications published in the literature. It has been set up using the Make2D-DB package, a software tool that helps building SWISS-2DPAGE-like databases on one's own Web site. The lack of necessary informatics infrastructure to build and run a dedicated website is no longer an obstacle to make proteomics data publicly accessible on the Internet. \u00a9 2008 Elsevier B.V. All rights reserved.","authors":[{"name":"Appel R.D."},{"name":"Hoogland C."},{"name":"Lisacek F."},{"name":"Mostaguir K."}],"citationCount":30,"date":"2008-07-21T00:00:00Z","journal":"Journal of Proteomics","title":"The World-2DPAGE Constellation to promote and publish gel-based proteomics data through the ExPASy server"},"pmid":"18617148","type":["Primary"]}],"topic":[{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"}],"validated":1},"bioschemas":{"name":"NIBR 2D-PAGE","home":"https://bio.tools/nibr_2d-page","summary":"World-wide gel-based proteomics database.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:nibr_2d-page/db/www.expasy.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":14,"citations":[{"count":1,"year":"2011"},{"count":1,"year":"2019"},{"count":1,"year":"2020"},{"count":1,"year":"2023"},{"count":1,"year":"2025"},{"count":2,"year":"2013"},{"count":2,"year":"2017"},{"count":2,"year":"2022"},{"count":3,"year":"2010"}],"doi":"10.1016/j.jprot.2008.02.005","pmid":"18617148","ref_count":0,"refs":[],"title":"The World-2DPAGE Constellation to promote and publish gel-based proteomics dat