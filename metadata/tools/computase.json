{"tool_name":"computase","contents":["biotools"],"fetched_metadata":{"biotools":{"id":"computase","home":"https://github.com/madhusudan-kulkarni/computase","license":"MIT","summary":"Local Python sequence utilities for nucleotide composition, DNA and RNA reverse complements, NCBI genetic-code translation, six-frame candidate ORF enumeration, and IUPAC motif searches. Computase accepts raw nucleotide strings or one FASTA record and returns structured, bounded results with explicit scientific conventions.","addition_date":"2026-08-11T15:36:24.023383Z","last_update_date":"2026-08-11T15:40:38.679598Z","tool_type":["Library"],"version":["0.1.1"],"biotools_curie":"biotools:computase","cost":"Free of charge","credit":[{"name":"Madhusudan Kulkarni","orcidid":"https://orcid.org/0009-0004-0270-9731","typeEntity":"Person","typeRole":["Developer","Maintainer","Primary contact"],"url":"https://github.com/madhusudan-kulkarni/computase"}],"documentation":[{"type":["Citation instructions","General","Installation instructions","Quick start guide"],"url":"https://github.com/madhusudan-kulkarni/computase#readme"},{"type":["Release notes"],"url":"https://github.com/madhusudan-kulkarni/computase/blob/main/CHANGELOG.md"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Nucleic acid sequence","uri":"http://edamontology.org/data_2977"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"},{"term":"plain text format (unformatted)","uri":"http://edamontology.org/format_1964"}]}],"note":"Enumerates sequence-defined candidate ORFs in six frames; it does not predict genes.","operation":[{"term":"Sequence feature detection","uri":"http://edamontology.org/operation_0253"}],"output":[{"data":{"term":"Sequence features","uri":"http://edamontology.org/data_1255"},"format":[{"term":"JSON","uri":"http://edamontology.org/format_3464"}]}]},{"input":[{"data":{"term":"Nucleic acid sequence","uri":"http://edamontology.org/data_2977"},"format":[{"term":"FASTA","u