{"tool_name":"hayai-annotation_plants","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"Hayai-Annotation_Plants","home":"https://github.com/kdri-genomics/Hayai-Annotation-Plants","license":"GPL-3.0","summary":"R package for an Ultra-Fast and Comprehensive Gene Annotation in Plants.","addition_date":"2019-08-09T13:10:11Z","last_update_date":"2024-11-24T21:02:28.489776Z","tool_type":["Library"],"accessibility":"Open access","biotools_curie":"biotools:Hayai-Annotation_Plants","cost":"Free of charge","credit":[{"email":"andreaghelfi@kazusa.or.jp","name":"Andrea Ghelfi","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/kdri-genomics/Hayai-Annotation-Plants/blob/master/README.md"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"}]}],"maturity":"Mature","name":"Hayai-Annotation Plants","operating_system":["Linux","Mac","Windows"],"owner":"hans","publication":[{"doi":"10.1093/bioinformatics/btz380","metadata":{"abstract":"Summary: Hayai-Annotation Plants is a browser-based interface for an ultra-fast and accurate functional gene annotation system for plant species using R. The pipeline combines the sequence-similarity searches, using USEARCH against UniProtKB (taxonomy Embryophyta), with a functional annotation step. Hayai-Annotation Plants provides five layers of annotation: i) protein name; ii) gene ontology terms consisting of its three main domains (Biological Process, Molecular Function and Cellular Component); iii) enzyme commission number; iv) protein existence level; and v) evidence type. It implements a new algorithm that gives priority to protein existence level to propagate GO and EC information and annotated Arabidopsis thaliana representative peptide sequences (Araport11) within 5 min at the PC level. Availability and implementation: The software is implemented in R and runs on Macintosh and Linux systems. It is freely available at https://github.com/kdri-genomics/Hayai-Annotation-Plants under the GPLv3 license. Supplementary information: Supplementary data are available at Bioinformatics online.","authors":[{"name":"Ghelfi A."},{"name":"Hirakawa H."},{"name":"Isobe S."},{"name":"Shirasawa K."}],"citationCount":14,"date":"2019-11-01T00:00:00Z","journal":"Bioinformatics","title":"Hayai-Annotation Plants: An ultra-fast and comprehensive functional gene annotation system in plants"},"pmcid":"PMC6821316","pmid":"31093654","type":["Primary"]}],"topic":[{"term":"Enzymes","uri":"http://edamontology.org/topic_0821"},{"term":"Plant biology","uri":"http://edamontology.org/topic_0780"},{"term":"Taxonomy","uri":"http://edamontology.org/topic_0637"}]},"bioschemas":{"name":"Hayai-Annotation Plants","home":"https://bio.tools/Hayai-Annotation_Plants","license":"GPL-3.0","summary":"R package for an Ultra-Fast and Comprehensive Gene Annotation in Plants.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:hayai-annotation_plants/lib/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":12,"citations":[{"count":1,"year":"2019"},{"count":1,"year":"2022"},{"count":2,"year":"2020"},{"count":2,"year":"2021"},{"count":2,"year":"2024"},{"count":4,"year":"2023"}],"doi":"10.1093/bioinformatics/btz380","pmcid":"PMC6821316","pmid":"31093654","ref_count":15,"refs":[{"count":1,"year":"1990"},{"count":1,"year":"1997"},{"count":1,"year":"2000"},{