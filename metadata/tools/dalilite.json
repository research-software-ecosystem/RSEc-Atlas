{"tool_name":"dalilite","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"dalilite","home":"http://www.ebi.ac.uk/Tools/structure/dalilite/","summary":"Pairwise structure alignment.","addition_date":"2015-01-29T15:48:13Z","last_update_date":"2024-11-24T15:03:58.687332Z","tool_type":["Web application","Web service"],"version":["Retired"],"collections":["EBI Tools"],"biotools_curie":"biotools:dalilite","credit":[{"name":"EMBL-EBI","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Liisa Holm","typeEntity":"Person","typeRole":["Developer"]},{"name":"University of Helsinki","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Job Dispatcher","typeEntity":"Project","typeRole":["Primary contact"],"url":"https://www.ebi.ac.uk/Tools/jdispatcher/"}],"documentation":[{"type":["General"],"url":"http://www.ebi.ac.uk/Tools/structure/dalilite/"},{"type":["Terms of use"],"url":"http://www.ebi.ac.uk/about/terms-of-use"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Protein structure","uri":"http://edamontology.org/data_1460"}}],"operation":[{"term":"Pairwise structure alignment","uri":"http://edamontology.org/operation_0503"}],"output":[{"data":{"term":"Structure alignment (protein)","uri":"http://edamontology.org/data_1481"}}]}],"maturity":"Legacy","name":"DaliLite (EBI)","operating_system":["Linux","Mac","Windows"],"owner":"jdispatcher","publication":[{"doi":"10.1093/nar/gkac240","metadata":{"abstract":"The EMBL-EBI search and sequence analysis tools frameworks provide integrated access to EMBL-EBI's data resources and core bioinformatics analytical tools. EBI Search (https://www.ebi.ac.uk/ebisearch) provides a full-text search engine across nearly 5 billion entries, while the Job Dispatcher tools framework (https://www.ebi.ac.uk/services) enables the scientific community to perform a diverse range of sequence analysis using popular bioinformatics applications. Both allow users to interact through user-friendly web applications, as well as via RESTful and SOAP-based APIs. Here, we describe recent improvements to these services and updates made to accommodate the increasing data requirements during the COVID-19 pandemic.","authors":[{"name":"Basutkar P."},{"name":"Edbali O."},{"name":"Kolesnikov A."},{"name":"Lee J."},{"name":"Lopez R."},{"name":"Madeira F."},{"name":"Madhusoodanan N."},{"name":"Pearce M."},{"name":"Tivey A.R.N."}],"citationCount":1248,"date":"2022-07-05T00:00:00Z","journal":"Nucleic Acids Research","title":"Search and sequence analysis tools services from EMBL-EBI in 2022"},"pmcid":"PMC9252731","pmid":"35412617","type":["Other"]},{"doi":"10.1093/bioinformatics/16.6.566","metadata":{"abstract":"DaliLite is a program for pairwise structure comparison and for structure database searching. It is a standalone version of the search engine of the popular Dali server. A web interface is provided to view the results, multiple alignments and 3D superimpositions of structures.","authors":[{"name":"Holm L."},{"name":"Park J."}],"citationCount":782,"date":"2000-01-01T00:00:00Z","journal":"Bioinformatics","title":"DaliLite workbench for protein structure comparison"},"pmid":"10980157","type":["Other"]}],"topic":[{"term":"Protein structure analysis","uri":"http://edamontology.org/topic_2814"},{"term":"Structure analysis","uri":"http://edamontology.org/topic_0081"}],"validated":1},"bioschemas":{"name":"DaliLite (EBI)","home":"https://bio.tools/dalilite","version":"Retired","summary":"Pairwise structure alignment.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:dalilite:Retired/soap/www.ebi.ac.uk","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true,"terms_of_use":true},"publications":[{"entries":[{"cit_count":1279,"citations":[{"count":1,"year":"-1"},{"count":73,"year":"2