{"tool_name":"anarci","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"anarci","identifiers":["biotools:anarci","doi:10.1093/bioinformatics/btv552"],"license":"Not available","summary":"Anarci: antibody numbering and antigen receptor classification","home_url":"http://opig.stats.ox.ac.uk/webapps/newsabdab/sabpred/anarci/","keywords":["Antibodies","Computational Biology","Humans","Immunoglobulin Variable Region","Models, Molecular","Receptors, Antigen, T-Cell","Proteomics","Protein structure analysis"],"manually_check":true,"total_pulls":4101},"biotools":{"id":"anarci","home":"http://opig.stats.ox.ac.uk/webapps/sabdab-sabpred/ANARCI.php","summary":"Tool for numbering amino-acid sequences of antibody and T-cell receptor variable domains.","addition_date":"2017-08-03T18:35:48Z","last_update_date":"2024-11-25T14:17:15.343704Z","tool_type":["Desktop application","Web application"],"collections":["Proteomics"],"biotools_curie":"biotools:anarci","credit":[{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://opig.stats.ox.ac.uk/"}],"documentation":[{"type":["General"],"url":"http://opig.stats.ox.ac.uk/webapps/sabdab-sabpred/ANARCI.php"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"operation":[{"term":"Protein binding site prediction","uri":"http://edamontology.org/operation_2575"}]},{"operation":[{"term":"Protein sequence analysis","uri":"http://edamontology.org/operation_2479"}]}],"name":"ANARCI","operating_system":["Linux","Mac","Windows"],"owner":"mbs_import","publication":[{"doi":"10.1093/bioinformatics/btv552","metadata":{"abstract":"Motivation: Antibody amino-acid sequences can be numbered to identify equivalent positions. Such annotations are valuable for antibody sequence comparison, protein structure modelling and engineering. Multiple different numbering schemes exist, they vary in the nomenclature they use to annotate residue positions, their definitions of position equivalence and their popularity within different scientific disciplines. However, currently no publicly available software exists that can apply all the most widely used schemes or for which an executable can be obtained under an open license. Results: ANARCI is a tool to classify and number antibody and T-cell receptor amino-acid variable domain sequences. It can annotate sequences with the five most popular numbering schemes: Kabat, Chothia, Enhanced Chothia, IMGT and AHo. Availability and implementation: ANARCI is available for download under GPLv3 license at opig.stats.ox.ac.uk/webapps/anarci. A web-interface to the program is available at the same address. Contact:","authors":[{"name":"Deane C.M."},{"name":"Dunbar J."}],"citationCount":193,"date":"2016-01-15T00:00:00Z","journal":"Bioinformatics","title":"ANARCI: Antigen receptor numbering and receptor classification"},"pmcid":"PMC4708101","pmid":"26424857"}],"topic":[{"term":"Protein structure analysis","uri":"http://edamontology.org/topic_2814"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"}],"validated":1},"bioschemas":{"name":"ANARCI","home":"https://bio.tools/anarci","summary":"Tool for numbering amino-acid sequences of antibody and T-cell receptor variable domains.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:anarci/app/opig.stats.ox.ac.uk","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":272,"citations":[{"count":2,"year":"2016"},{"count":5,"year":"2017"},{"count":10,"year":"-1"},{"count":10,"year":"2018"},{"count":10,"year":"2020"},{"count":15,"year":"2019"},{"count":19,"year":"2021"},{"count":25,"year":"2023"},{"count":28,"year":"2022"},{"count":43,"year":"2026"},{"count":52,"year