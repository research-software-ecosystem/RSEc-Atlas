{"tool_name":"egglib","contents":["biocontainers","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"egglib","version":"3.6.1","home":"https://egglib.org","documentation":"https://www.egglib.org/index.html","license":"GPL-3.0-or-later","summary":"Evolutionary Genetics and Genomics Library","identifiers":["doi:10.1111/1755-0998.13672","biotools:egglib"],"description":"EggLib is a C++/Python library and program package for evolutionary\ngenetics and genomics. Main features are sequence data management, sequence\npolymorphism analysis, and coalescent simulations. EggLib is a flexible\nPython module with a performant underlying C++ library and allows fast\nand intuitive development of Python programs and scripts.\n","license_file":"LICENSE","build":{"entry_points":["egglib-config = egglib.cli.config:main","egglib-test = egglib.cli.test:main"],"number":0,"run_exports":[null],"script":["export LDFLAGS=\"${LDFLAGS} -L${PREFIX}/lib\"","export CPPFLAGS=\"${CPPFLAGS} -I${PREFIX}/include\"","export CFLAGS=\"${CFLAGS} -O3 -Wno-implicit-function-declaration\"","export CPATH=\"${PREFIX}/include\"","export LIBRARY_PATH=\"${PREFIX}/lib\"","-m pip install . --no-deps --no-build-isolation --no-cache-dir -vvv"],"script_env":["SETUPTOOLS_SCM_PRETEND_VERSION=3.6.1"],"skip":true},"requirements":{"build":[null,null,null,"cmake","make","pkg-config"],"host":["python","pip","setuptools-scm","svgwrite","sphinx","numpydoc","htslib","swig"],"run":["python","platformdirs","click","htslib","scipy"]},"source_url":"https://pypi.org/packages/source/e/egglib/egglib-3.6.1.tar.gz","test":{"commands":["egglib-config --help","egglib-test --help"],"imports":["egglib","egglib.coalesce","egglib.io","egglib.stats","egglib.tools","egglib.wrappers"]},"recipe_maintainers":["ranwez"]},"biocontainers":{"name":"egglib","identifiers":["doi:10.1186/1471-2156-13-27"],"license":"GPL-3.0","summary":"EggLib is a C++/Python library and program package for evolutionary genetics and genomics. Main features are sequence data management, sequence polymorphism analysis, and coalescent simulations. EggLib is a flexible Python module with a performant underlying C++ library and allows fast and intuitive development of Python programs and scripts.","home_url":"http://mycor.nancy.inra.fr/egglib/","keywords":["Computer Simulation","Genetics, Population","Genomics"],"manually_check":true,"total_pulls":2},"biotools":{"id":"egglib","home":"https://egglib.org/","license":"GPL-3.0","summary":"A python package for population genetics and genomics.","addition_date":"2022-09-13T17:45:13.871122Z","last_update_date":"2022-09-13T17:45:13.874472Z","tool_type":["Library"],"version":["3.1.0"],"accessibility":"Open access","biotools_curie":"biotools:egglib","cost":"Free of charge","edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Editing","uri":"http://edamontology.org/operation_3096"}]}],"name":"egglib","operating_system":["Mac","Windows"],"owner":"Chan019","publication":[{"doi":"10.1111/1755-0998.13672","metadata":{"abstract":"\u00a9 2022 John Wiley & Sons Ltd.Rapid and repeatable polymorphism analyses have become a necessity with the current amount of genomic data that can be collected in many organisms. Traditionally, such analyses are conducted using a variety of tools in combination, often requiring numerous format translation and manipulation. Here, we present a massively updated version of our previous software package egglib, intended to alleviate such costly and error-prone tinkering with the data. egglib has been streamlined into a python package and thoroughly updated and optimized to accommodate modern-day sized dataset. We show the main characteristics of the package making it a tool of choice to perform population genetics analyses. Once the data are imported (whatever their encoding), they can be filtered, edited, analysed and compared to coalescent simulations very easily and efficiently. Furthermore, the list of diversity and polymorphism statistics that can now be calculated has been greatly expanded. The software and its full documentation are available at https://egglib.org/.","authors":[{"name":"Coudoux T."},{"name":"De Mita S."},{"name":"Ravel S."},{"name":"Siol M."}],"date":"2022-01-01T00:00:00Z","journal":"Molecular Ecology Resources","title":"EggLib 3: A python package for population genetics and genomics"},"pmid":"35753060"}],"topic":[{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"Population genetics","uri":"http://edamontology.org/topic_3056"},{"term":"Population genomics","uri":"http://edamontology.org/topic_3796"}],"validated":1},"bioschemas":{"name":"egglib","home":"https://bio.tools/egglib","license":"GPL-3.0","version":"3.1.0","summary":"A python package for population genetics and genomics.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:egglib:3.1.0/lib/egglib.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false,"repository":{}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":14,"citations":[{"count":2,"year":"2023"},{"count":2,"year":"2026"},{"count":4,"year":"2025"},{"count":6,"year":"2024"}],"doi":"10.1111/1755-0998.13672","pmid":"35753060","ref_count":0,"refs":[],"title":"EggLib 3: A python package for population genetics and genomics.","year":2022}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:egglib:3.0.0b21/cmd/mycor.nancy.inra.fr","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{