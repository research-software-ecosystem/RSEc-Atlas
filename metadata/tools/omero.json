project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":22,"citations":[{"count":1,"year":"2017"},{"count":1,"year":"2018"},{"count":1,"year":"2023"},{"count":1,"year":"2026"},{"count":2,"year":"2016"},{"count":2,"year":"2019"},{"count":2,"year":"2024"},{"count":2,"year":"2025"},{"count":3,"year":"2021"},{"count":7,"year":"2022"}],"doi":"10.1016/j.ymeth.2015.10.006","pmcid":"PMC4773399","pmid":"26476368","ref_count":33,"refs":[{"count":1,"year":"2002"},{"count":1,"year":"2003"},{"count":1,"year":"2005"},{"count":1,"year":"2008"},{"count":3,"year":"2015"},{"count":4,"year":"2010"},{"count":4,"year":"2011"},{"count":4,"year":"2014"},{"count":5,"year":"2013"},{"count":9,"year":"2012"}],"title":"Metadata management for high content screening in OMERO.","year":2015}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://www.openmicroscopy.org/omero/"}],"ssl":true,"ssl_err":null}},"support":{"email":false}},{"@id":"https://openebench.bsc.es/monitor/metrics/omero","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://www.openmicroscopy.org/omero/"}],"ssl":true,"ssl_err":null}}}]},"neubias":{"body":[{"format":"markdown","processed":"","summary":"","value":"OMERO is a free, open source image management software. It is client-server based system which supports 5D images, including big images and high-content screening data. Data are stored on a server using relational database. They are accessed using 3 main clients, a desktop client, a web client and a command line tool. There are bindings from OMERO to other image analysis packages, like FLIMfit, OMERO.searcher. The data in OMERO are organized in groups. A user can be a member of one or more groups. This groups can be collaborative or private, there are 4 levels of permissions to access/edit/annotate/delete the data of other users.\r\n\r\nThe package is supported not only by community forums, but also by a dedicated team which helps users to solve their problems and deals with the bugs submitted via error submission system. \r\n\r\n###Strengths\r\n\r\nOpen source, scalable software, Supports diverse sets of imaging applications and domains (EM,LM, HCS, DigPath) Cross-platform, Java-based application, API support for Java, Python, C++, Django, On-line Forums, Automatic QA and upload of software errors Multi-dimensional images, Web access, Free Demo-server accounts \r\n\r\n### Limitations\r\n\r\n Enterprise-scale software, so complex install, requires expertise, Actively developing API, Python scripts and functions still developing\r\n"}],"changed":[{"format":"Y-m-d\\TH:i:sP","value":"2018-10-18T15:38:19+00:00"}],"created":[{"format":"Y-m-d\\TH:i:sP","value":"2013-10-15T18:00:59+00:00"}],"default_langcode":[{"value":true}],"attribution_instructions":[],"comments_2023":[],"free_tagging":[{"target_id":4649,"target_type":"taxonomy_term","target_uuid":"db6ee13e-3762-46e9-a207-703c94be1799","url":"/taxonomy/term/4649"},{"target_id":4651,"target_type":"taxonomy_term","target_uuid":"f7c82b80-d213-494b-ac63-74e5a9b22cb3","url":"/taxonomy/term/4651"},{"target_id":4465,"target_type":"taxonomy_term","target_uuid":"da111da4-3e5a-4216-b292-7adacf86e6f2","url":"/taxonomy/term/4465"},{"target_id":4497,"target_type":"taxonomy_term","target_uuid":"f216975b-bbf3-4489-bfa4-d29978296516","url":"/taxonomy/term/4497"},{"target_id":4631,"target_type":"taxonomy_term","target_uuid":"326da89b-ad9f-4f88-b4cb-5dc21b111a4e","url":"/taxonomy/term/4631"},{"target_id":4652,"target_type":"taxonomy_term","target_uuid":"b3de1b5c-8e8c-4216-9d1a-12c75a9cb72a","url":"/taxonomy/term/4652"}],"give_feedba