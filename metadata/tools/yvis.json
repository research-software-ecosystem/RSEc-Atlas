{"tool_name":"yvis","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"Yvis","home":"http://bioinfo.icb.ufmg.br/yvis/","license":"Unlicense","summary":"Antibody high-density alignment visualization and analysis platform with an integrated database.","addition_date":"2019-08-09T13:13:55Z","last_update_date":"2020-06-16T10:55:26Z","tool_type":["Database portal","Web application"],"accessibility":"Open access","biotools_curie":"biotools:Yvis","cost":"Free of charge","credit":[{"email":"milenebc@ufsj.edu.br","name":"Milene B Carvalho","orcidid":"https://orcid.org/0000-0001-7776-8446","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"liza@icb.ufmg.br","name":"Liza F Felicori","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"note":"Tutorial material","type":["Training material"],"url":"http://bioinfo.icb.ufmg.br/yvis/#help"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Deposition","uri":"http://edamontology.org/operation_3431"},{"term":"Filtering","uri":"http://edamontology.org/operation_3695"}]}],"maturity":"Mature","name":"Yvis","operating_system":["Linux","Mac","Windows"],"owner":"hans","publication":[{"doi":"10.1093/NAR/GKZ387","metadata":{"abstract":"\u00a9 2019 The Author(s). Published by Oxford University Press on behalf of Nucleic Acids Research.As antibodies are a very important tool for diagnosis, therapy, and experimental biology, a large number of antibody structures and sequences have become available in recent years. Therefore, tools that allow the analysis, comparison, and visualization of this large amount of antibody data are crucially needed. We developed the antibody high-density alignment visualization and analysis (Yvis) platform to provide an innovative, robust and high-density data visualization of antibody sequence alignments, called Collier de Diamants. The Yvis platform also provides an integrated structural database, which is updated weekly, and many different search and filter options. This platform can help to formulate hypotheses concerning the key residues in antibody structures or interactions to improve the understanding of antibody properties. The Yvis platform is available at http://bioinfo.icb.ufmg.br/yvis/.","authors":[{"name":"Carvalho M.B."},{"name":"Felicori L.F."},{"name":"Molina F."}],"date":"2019-07-01T00:00:00Z","journal":"Nucleic Acids Research","title":"Yvis: Antibody high-density alignment visualization and analysis platform with an integrated database"},"pmcid":"PMC6602444","pmid":"31106372","type":["Primary"]}],"topic":[{"term":"Carbohydrates","uri":"http://edamontology.org/topic_0152"},{"term":"Immunoproteins, genes and antigens","uri":"http://edamontology.org/topic_2830"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}],"validated":1},"bioschemas":{"name":"Yvis","home":"https://bio.tools/Yvis","license":"Unlicense","summary":"Antibody high-density alignment visualization and analysis platform with an integrated database.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:yvis/db/bioinfo.icb.ufmg.br","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"training_material":true},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":3,"citations":[{"count":1,"year":"2022"},{"count":1,"year":"2023"},{"count":1,"year":"2025"}],"doi":"10.1093/nar/gkz387","pmcid":"PMC6602444","pmid":"31106372","ref_count":21,"refs":[{"count":1,"year":"2002"},{"count":1,"year":"2004"},{"count":1,"year":"2006"},{"count":1,"year":"2009"},{"count":1,"year":"2010"},{"count":1,"year":"2012"},{"count":2,"year":"2003"},{"count":2,"year":"2016"},{"count":2,"year":"2019"},{"count":3,"year":"2013"},{"count":3,"year":"2015"},{"count":3,"year":"2018"}],"title":"Yvis: antibody high-density alignme