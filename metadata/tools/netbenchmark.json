{"tool_name":"netbenchmark","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"netbenchmark","home":"http://bioconductor.org/packages/release/bioc/html/netbenchmark.html","license":"CC-BY-NC-SA-4.0","summary":"This package implements a benchmarking of several gene network inference algorithms from gene expression data.","addition_date":"2017-01-17T15:03:25Z","last_update_date":"2019-01-11T01:27:06Z","tool_type":["Command-line tool","Library"],"version":["1.6.0"],"collections":["BioConductor"],"biotools_curie":"biotools:netbenchmark","credit":[{"email":"albert@tsc.upc.edu","name":"Albert Oliveras-Verg\u00e9s","orcidid":"http://orcid.org/0000-0003-1574-5622","typeEntity":"Person","typeRole":["Contributor"]},{"email":"pau.bellot@upc.edu","name":"Pau Bellot","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/html/netbenchmark.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Pathway or network prediction","uri":"http://edamontology.org/operation_3439"}]}],"name":"netbenchmark","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1186/s12859-015-0728-4","metadata":{"abstract":"\u00a9 2015 Bellot et al.Background: In the last decade, a great number of methods for reconstructing gene regulatory networks from expression data have been proposed. However, very few tools and datasets allow to evaluate accurately and reproducibly those methods. Hence, we propose here a new tool, able to perform a systematic, yet fully reproducible, evaluation of transcriptional network inference methods. Results: Our open-source and freely available Bioconductor package aggregates a large set of tools to assess the robustness of network inference algorithms against different simulators, topologies, sample sizes and noise intensities. Conclusions: The benchmarking framework that uses various datasets highlights the specialization of some methods toward network types and data. As a result, it is possible to identify the techniques that have broad overall performances.","authors":[{"name":"Bellot P."},{"name":"Meyer P.E."},{"name":"Oliveras-Verges A."},{"name":"Olsen C."},{"name":"Salembier P."}],"citationCount":25,"date":"2015-09-29T00:00:00Z","journal":"BMC Bioinformatics","title":"NetBenchmark: A bioconductor package for reproducible benchmarks of gene regulatory network inference"},"pmcid":"PMC4587916","pmid":"26415849","type":["Primary"]}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"}],"validated":1},"bioschemas":{"name":"netbenchmark","home":"https://bio.tools/netbenchmark","license":"CC-BY-NC-SA-4.0","version":"1.6.0","summary":"This package implements a benchmarking of several gene network inference algorithms from gene expression data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:netbenchmark:1.6.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":22,"citations":[{"count":1,"year":"2019"},{"count":1,"year":"2024"},{"count":2,"year":"2016"},{"count":2,"year":"2020"},{"count":2,"year":"2021"},{"count":2,"year":"2025"},{"count":3,"year":"2017"},{"count":3,"year":"2018"},{"count":3,"year":"2022"},{"count":3,"year":"2023"}],"doi":"10.1186/s12859-015-0728-4","pmcid":"PMC4587916","pmid":"26415849","ref_count":27,"refs":[{"count":1,"year":"2000"},{"count":1,"year":"2002"},{"count":1,"year":"2004"},{"count":1,"year":"2008"},{"count":1,"year":"2011"},{"count":1,"year":"20