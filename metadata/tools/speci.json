{"tool_name":"speci","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"speci","home":"http://vm-lux.embl.de/~mende/specI/","license":"GPL-3.0","summary":"SpecI is a species identification tool using genomic sequences to delineate prokaryotic species. It facilitates fast, accurate and automated taxonomic assignments of newly sequenced genomes based on comparisons of 40 universal, single-copy phylogenetic marker genes extracted from a comprehensive database of sequenced prokaryotic genomes.","addition_date":"2016-02-11T12:02:14Z","last_update_date":"2020-09-22T22:49:02Z","tool_type":["Command-line tool","Web service"],"version":["1.0"],"collections":["de.NBI"],"accessibility":"Open access","biotools_curie":"biotools:speci","cost":"Free of charge","credit":[{"email":"zeller@embl.de","name":"Georg Zeller","orcidid":"http://orcid.org/0000-0003-1429-7485","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"European Molecular Biology Laboratory (EMBL)","typeEntity":"Institute","typeRole":["Provider"],"url":"https://www.embl.de/"},{"name":"HD-HuB","typeEntity":"Institute","typeRole":["Provider"],"url":"https://www.hd-hub.de/"}],"documentation":[{"type":["General"],"url":"http://vm-lux.embl.de/~mende/specI/overview.html"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Nucleic acid sequence record","uri":"http://edamontology.org/data_2887"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]},{"data":{"term":"Protein sequence record","uri":"http://edamontology.org/data_2886"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}],"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"},{"term":"Taxonomic classification","uri":"http://edamontology.org/operation_3460"}],"output":[{"data":{"term":"Taxon","uri":"http://edamontology.org/data_1868"}}]}],"maturity":"Mature","name":"SpecI","operating_system":["Linux","Mac","Windows"],"owner":"hdhub","publication":[{"doi":"10.1038/nmeth.2575","metadata":{"abstract":"The exponentially increasing number of sequenced genomes necessitates fast, accurate, universally applicable and automated approaches for the delineation of prokaryotic species. We developed specI (species identification tool; http://www.bork.embl.de/software/specI/), a method to group organisms into species clusters based on 40 universal, single-copy phylogenetic marker genes. Applied to 3,496 prokaryotic genomes, specI identified 1,753 species clusters. Of 314 discrepancies with a widely used taxonomic classification, >62% were resolved by literature support. \u00a9 2013 Nature America, Inc. All rights reserved.","authors":[{"name":"Bork P."},{"name":"Mende D.R."},{"name":"Sunagawa S."},{"name":"Zeller G."}],"citationCount":192,"date":"2013-09-01T00:00:00Z","journal":"Nature Methods","title":"Accurate and universal delineation of prokaryotic species"},"pmid":"23892899","type":["Primary"]}],"topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"}],"validated":1},"bioschemas":{"name":"SpecI","home":"https://bio.tools/speci","license":"GPL-3.0","version":"1.0","summary":"SpecI is a species identification tool using genomic sequences to delineate prokaryotic species. It facilitates fast, accurate and automated taxonomic assignments of newly sequenced genomes based on comparisons of 40 universal, single-copy phylogenetic marker genes extracted from a comprehensive database of sequenced prokaryotic genomes.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:speci:1.0/cmd/vm-lux.embl.de","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"