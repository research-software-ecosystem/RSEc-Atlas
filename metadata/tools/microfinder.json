{"tool_name":"microfinder","contents":["biotools"],"identifiers":["biotools:microfinder"],"fetched_metadata":{"biotools":{"id":"microfinder","home":"https://github.com/sanger-tol/MicroFinder","summary":"MicroFinder is a pipeline designed to improve bird genome assembly by identifying and ordering putative dot microchromosome scaffolds. It uses conserved protein sets to anchor the manual curation of tiny, hard-to-assemble microchromosomes in draft genome assemblies.","addition_date":"2026-11-04T14:48:41.654626Z","last_update_date":"2026-11-04T14:48:41.656487Z","biotools_curie":"biotools:microfinder","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genome assembly","uri":"http://edamontology.org/operation_0525"},{"term":"Mapping","uri":"http://edamontology.org/operation_2429"},{"term":"Mapping assembly","uri":"http://edamontology.org/operation_0523"},{"term":"Scaffolding","uri":"http://edamontology.org/operation_3216"}]}],"name":"MicroFinder","owner":"pub2tools2024","publication":[{"doi":"10.1093/GIGASCIENCE/GIAG036","pmcid":"PMC13192246","pmid":"41934175"}],"topic":[{"term":"Biodiversity","uri":"http://edamontology.org/topic_3050"},{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Hi-C","uri":"http://edamontology.org/topic_4052"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"}]}}}