{"tool_name":"metaproteomeanalyzer","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"metaproteomeanalyzer","home":"https://code.google.com/p/meta-proteome-analyzer/","summary":"Pipeline to analyze metaproteomics data, supporting MGF and X!Tandem, OMSSA and Mascot.","addition_date":"2017-01-17T14:50:25Z","last_update_date":"2024-11-25T14:14:08.852113Z","tool_type":["Desktop application"],"collections":["Proteomics","ms-utils"],"biotools_curie":"biotools:metaproteomeanalyzer","credit":[{"email":"webmaster@ms-utils.org","typeEntity":"Person","typeRole":["Documentor"],"url":"http://ms-utils.org"}],"documentation":[{"type":["General"],"url":"https://github.com/compomics/meta-proteome-analyzer"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"input":[{"data":{"term":"Data","uri":"http://edamontology.org/data_0006"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"},{"term":"MGF","uri":"http://edamontology.org/format_3651"}]}],"operation":[{"term":"Peptide database search","uri":"http://edamontology.org/operation_3646"}]}],"name":"MetaProteomeAnalyzer","operating_system":["Linux","Windows"],"owner":"msutils_import","publication":[{"doi":"10.1021/pr501246w","metadata":{"abstract":"The enormous challenges of mass spectrometry-based metaproteomics are primarily related to the analysis and interpretation of the acquired data. This includes reliable identification of mass spectra and the meaningful integration of taxonomic and functional meta-information from samples containing hundreds of unknown species. To ease these difficulties, we developed a dedicated software suite, the MetaProteomeAnalyzer, an intuitive open-source tool for metaproteomics data analysis and interpretation, which includes multiple search engines and the feature to decrease data redundancy by grouping protein hits to so-called meta-proteins. We also designed a graph database back-end for the MetaProteomeAnalyzer to allow seamless analysis of results. The functionality of the MetaProteomeAnalyzer is demonstrated using a sample of a microbial community taken from a biogas plant.","authors":[{"name":"Behne A."},{"name":"Benndorf D."},{"name":"Heyer R."},{"name":"Hoffmann M."},{"name":"Kohrs F."},{"name":"Lehteva M."},{"name":"Martens L."},{"name":"Muth T."},{"name":"Rapp E."},{"name":"Reichl U."}],"citationCount":139,"date":"2015-03-06T00:00:00Z","journal":"Journal of Proteome Research","title":"The MetaProteomeAnalyzer: A powerful open-source software suite for metaproteomics data analysis and interpretation"},"pmid":"25660940"}],"topic":[{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"}],"validated":1},"bioschemas":{"name":"MetaProteomeAnalyzer","home":"https://bio.tools/metaproteomeanalyzer","summary":"Pipeline to analyze metaproteomics data, supporting MGF and X!Tandem, OMSSA and Mascot.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:metaproteomeanalyzer/app/code.google.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":61,"citations":[{"count":1,"year":"-1"},{"count":2,"year":"2015"},{"count":3,"year":"2023"},{"count":3,"year":"2026"},{"count":4,"year":"2018"},{"count":4,"year":"2021"},{"count":5,"year":"2020"},{"count":5,"year":"2024"},{"count":5,"year":"2025"},{"count":6,"year":"2017"},{"count":7,"year":"2016"},{"count":7,"year":"2022"},{"count":9,"year":"2019"}],"doi":"10.1021/pr501246w","pmid":"2566094