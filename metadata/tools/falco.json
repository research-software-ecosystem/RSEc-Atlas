0a9 2019 de Sena Brandine G and Smith AD.Quality control is an essential first step in sequencing data analysis, and software tools for quality control are deeply entrenched in standard pipelines at most sequencing centers. Although the associated computations are straightforward, in many settings the total computing effort required for quality control is appreciable and warrants optimization. We present falco, an emulation of the popular FastQC tool that runs on average three times faster while generating equivalent results. Compared to FastQC, falco also provides greater scalability for datasets with longer reads and more flexible visualization of HTML reports.","authors":[{"name":"Smith A.D."},{"name":"de Sena Brandine G."}],"citationCount":6,"date":"2019-01-01T00:00:00Z","journal":"F1000Research","title":"Falco: high-speed FastQC emulation for quality control of sequencing data"}}],"topic":[{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}],"validated":1},"bioschemas":{"name":"Falco","home":"https://bio.tools/falco","license":"GPL-3.0","summary":"A high-speed FastQC emulation for quality control of sequencing data.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"@TOOL_VERSION@+galaxy@VERSION_SUFFIX@","first_commit":"2024-04-17","conda_name":"falco","conda_version":"2.0.1","summary":"A high throughput sequence QC analysis tool","edam_operations":["Sequencing quality control","Visualisation","Read mapping"],"edam_topics":["Workflows","Mapping","Imaging"],"toolshed_categories":["Sequence Analysis"],"toolshed_id":"falco","users_5_years":5141,"users_all_time":5141,"usage_5_years":183923,"usage_all_time":183923,"bio_tools_summary":"A high-speed FastQC emulation for quality control of sequencing data.","bio_tools_ids":"falco","bio_tools_name":"Falco","related_tutorials":["https://training.galaxyproject.org/training-materi