{"tool_name":"strling","contents":["biocontainers","oeb","biotools"],"fetched_metadata":{"biocontainers":{"name":"strling","identifiers":[],"license":"MIT","summary":"STRling (pronounced like \u201csterling\u201d) is a method to detect large STR expansions from short-read sequencing data.","home_url":"https://github.com/quinlan-lab/STRling","keywords":[],"manually_check":true,"total_pulls":8},"biotools":{"id":"strling","home":"https://github.com/quinlan-lab/STRling","summary":"STRling (pronounced like \u201csterling\u201d) is a method to detect large STR expansions from short-read sequencing data. It is capable of detecting novel STR expansions, that is expansions where there is no STR in the reference genome at that position (or a different repeat unit from what is in the reference). It can also detect STR expansions that are annotated in the reference genome. STRling uses kmer counting to recover mis-mapped STR reads. It then uses soft-clipped reads to precisely discover the position of the STR expansion in the reference genome.","addition_date":"2021-04-22T01:24:48Z","last_update_date":"2021-04-22T14:47:03Z","version":["v0.4.2"],"biotools_curie":"biotools:strling","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Repeat sequence detection","uri":"http://edamontology.org/operation_0379"}]}],"name":"STRling","owner":"leipzig"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:strling:v0.4.2/undefined/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"publications":[],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true