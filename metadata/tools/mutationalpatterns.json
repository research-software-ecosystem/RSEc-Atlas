{"tool_name":"mutationalpatterns","contents":["bioconda","bioconductor","bioschemas","biotools","oeb"],"identifiers":["biotools:mutationalpatterns","bioconductor:mutationalpatterns","bioconda:bioconductor-mutationalpatterns"],"fetched_metadata":{"biotools":{"id":"mutationalpatterns","home":"http://bioconductor.org/packages/release/bioc/html/MutationalPatterns.html","license":"MIT","summary":"An extensive toolset for the characterization and visualization of a wide range of mutational patterns in base substitution data.","addition_date":"2017-01-17T15:03:51Z","last_update_date":"2018-12-10T12:58:52Z","tool_type":["Command-line tool","Library"],"version":["1.0.0"],"collections":["BioConductor"],"biotools_curie":"biotools:mutationalpatterns","credit":[{"email":"F.Blokzijl@umcutrecht.nl","name":"Francis Blokzijl","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"R.R.E.Janssen-10@umcutrecht.nl","name":"Roel Janssen","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/html/MutationalPatterns.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Polymorphism detection","uri":"http://edamontology.org/operation_3202"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"MutationalPatterns","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1101/071761","type":["Primary"]}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"Genetics","uri":"http://edamontology.org/topic_3053"}],"validated":1},"bioschemas":{"name":"MutationalPatterns","home":"https://bio.tools/mutationalpatterns","license":"MIT","version":"1.0.0","summary":"An extensive toolset for the characterization and visualization of a wide range of mutational patterns in base substitution data.","tool_type":"sc:SoftwareApplication"},"bioconductor":{"name":"MutationalPatterns","version":"3.22.0","license":"MIT + file LICENSE","summary":"Comprehensive genome-wide analysis of mutational processes","description":"Mutational processes leave characteristic footprints in genomic DNA. This package provides a comprehensive set of flexible functions that allows researchers to easily evaluate and visualize a multitude of mutational patterns in base substitution catalogues of e.g. healthy samples, tumour samples, or DNA-repair deficient cells. The package covers a wide range of patterns including: mutational signatures, transcriptional and replicative strand bias, lesion segregation, genomic distribution and association with genomic features, which are collectively meaningful for studying the activity of mutational processes. The package works with single nucleotide variants (SNVs), insertions and deletions (Indels), double base substitutions (DBSs) and larger multi base substitutions (MBSs). The package provides functionalities for both extracting mutational signatures de novo and determining the contribution of previously identified mutational signatures on a single sample level. MutationalPatterns integrates with common R genomic analysis workflows and allows easy association with (publicly available) annotation data.","home":"https://doi.org/doi:10.1186/s12864-022-08357-3","author":"Freek Manders [aut] (ORCID: <https://orcid.org/0000-0001-6197-347X>), Francis Blokzijl [aut] (ORCID: <https://orcid.org/0000-0002-8084-8444>), Roel Janssen [aut] (ORCID: <https://orcid.org/0000-0003-4324-5350>), Jurrian de Kanter [ctb] (ORCID: <https://orcid.org/0000-0001-5665-3711>), Rurika Oka [ctb] (ORCID: <https://orcid.org/0000-0003-4107-7250>), Mark van Roosmalen [cre], Ruben van Boxtel [aut, cph] (ORCID: <https://orcid.org/0000-0003-1285-2836>), Edwin Cuppen [aut] (ORCID: <https://orcid.org/0000-0002-0400-9542>)","maintainer":"Mark van Roosmalen <vanBoxtelBioinformatics@prinsesmaxim