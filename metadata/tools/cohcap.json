{"tool_name":"cohcap","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-cohcap","version":"1.48.0","home":"https://bioconductor.org/packages/3.18/bioc/html/COHCAP.html","license":"GPL-3.0-only","summary":"CpG Island Analysis Pipeline for Illumina Methylation Array and Targeted BS-Seq Data","identifiers":["biotools:cohcap"],"description":"COHCAP (pronounced \"co-cap\") provides a pipeline to analyze single-nucleotide resolution methylation data (Illumina 450k/EPIC methylation array, targeted BS-Seq, etc.). It provides differential methylation for CpG Sites, differential methylation for CpG Islands, integration with gene expression data, with visualizaton options. Discussion Group: https://sourceforge.net/p/cohcap/discussion/bioconductor/","license_file":"/lib/R/share/licenses/GPL-3","build":{"number":1,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"build":[null,null,"make"],"host":["bioconductor-cohcapanno >=1.38.0,<1.39.0","r-base","r-bh","r-gplots","r-rcolorbrewer","r-rcpp","r-rcpparmadillo","r-writexls","libblas","liblapack","perl >=5.6.0"],"run":["bioconductor-cohcapanno >=1.38.0,<1.39.0","r-base","r-bh","r-gplots","r-rcolorbrewer","r-rcpp","r-rcpparmadillo","r-writexls","perl >=5.6.0"]},"source_url":["https://bioconductor.org/packages/3.18/bioc/src/contrib/COHCAP_1.48.0.tar.gz","https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/COHCAP/COHCAP_1.48.0.tar.gz","https://bioarchive.galaxyproject.org/COHCAP_1.48.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-cohcap/bioconductor-cohcap_1.48.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('COHCAP')\""]},"parent_recipe":{"name":"bioconductor-cohcap","path":"recipes/bioconductor-cohcap","version":"1.26.0"}},"biotools":{"id":"cohcap","home":"http://bioconductor.org/packages/release/bioc/html/COHCAP.html","license":"GPL-3.0","summary":"This package provides a pipeline to analyze single-nucleotide resolution methylation data (Illumina 450k/EPIC methylation array, targeted BS-Seq, etc.). It provides differential methylation for CpG Sites, differential methylation for CpG Islands, integration with gene expression data, with visualizaton options.","addition_date":"2017-01-17T15:02:48Z","last_update_date":"2019-01-09T16:50:19Z","tool_type":["Command-line tool","Library"],"version":["1.16.0"],"collections":["BioConductor"],"biotools_curie":"biotools:cohcap","credit":[{"email":"cwarden45@gmail.com","name":"Charles Warden","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/html/COHCAP.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Methylation analysis","uri":"http://edamontology.org/operation_3204"},{"term":"Sequence visualisation","uri":"http://edamontology.org/operation_0564"}]}],"name":"COHCAP","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1093/nar/gkt242","metadata":{"abstract":"COHCAP (City of Hope CpG Island Analysis Pipeline) is an algorithm to analyze single-nucleotide resolution DNA methylation data produced by either an Illumina methylation array or targeted bisulfite sequencing. The goal of the COHCAP algorithm is to identify CpG islands that show a consistent pattern of methylation among CpG sites. COHCAP is currently the only DNA methylation package that provides integration with gene expression data to identify a subset of CpG islands that are most likely to regulate downstream gene expression, and it can generate lists of differentially methylated CpG islands with \u223c50% concordance with gene expression from both cell line data and heterogeneous patient data. For example, this article describes known breast cancer biomarkers (such as estrogen receptor) with a negative correlation between DNA methylation and gene expression. COHCAP also provides visualization for quality control metrics, regions of differential methylation and correlation between methylation and gene expression. This software is freely available at https://sourceforge. net/projects/cohcap/. \u00a9 2013 The Author(s).","authors":[{"name":"Jove R."},{"name":"Lee H."},{"name":"Li X."},{"name":"Riggs A.D."},{"name":"Tompkins J.D."},{"name":"Wang C."},{"name":"Warden C.D."},{"name":"Yu H."},{"name":"Yuan Y.-C."}],"citationCount":74,"date":"2013-01-01T00:00:00Z","journal":"Nucleic Acids Research","title":"COHCAP: An integrative genomic pipeline for single-nucleotide resolution DNA methylation analysis"},"pmcid":"PMC3675470","pmid":"23598999","type":["Primary"]}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Microarray experiment","uri":"http://edamontology.org/topic_3518"}],"validated":1},"bioschemas":{"name":"COHCAP","home":"https://bio.tools/cohcap","license":"GPL-3.0","version":"1.16.0","summary":"This package provides a pipeline to analyze single-nucleotide resolution methylation data (Illumina 450k/EPIC methylation array, targeted BS-Seq, etc.). It provides differential methylation for CpG Sites, differential methylation for CpG Islands, integration with gene expression data, with visualizaton options.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:cohcap:1.16.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":61,"citations":[{"count":1,"year":"2026"},{"count":2,"year":"2016"},{"count":3,"year":"2019"},{"count":3,"year":"2022"},{"count":4,"year":"2014"},{"count":4,"year":"2023"},{"count":5,"year":"2020"},{"count":6,"year":"2021"},{"count":7,"year":"2024"},{"count":8,"year":"2015"},{