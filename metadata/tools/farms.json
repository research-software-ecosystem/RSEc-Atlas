{"tool_name":"farms","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-farms","version":"1.52.0","home":"https://bioconductor.org/packages/3.17/bioc/html/farms.html","license":"LGPL (>= 2.1)","summary":"FARMS - Factor Analysis for Robust Microarray Summarization","identifiers":["biotools:farms"],"description":"The package provides the summarization algorithm called Factor Analysis for Robust Microarray Summarization (FARMS) and a novel unsupervised feature selection criterion called \"I/NI-calls\"","license_file":"/lib/R/share/licenses/LGPL-3","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"]},"requirements":{"host":["bioconductor-affy >=1.78.0,<1.79.0","bioconductor-biobase >=2.60.0,<2.61.0","r-base","r-mass"],"run":["bioconductor-affy >=1.78.0,<1.79.0","bioconductor-biobase >=2.60.0,<2.61.0","r-base","r-mass"]},"source_url":["https://bioconductor.org/packages/3.17/bioc/src/contrib/farms_1.52.0.tar.gz","https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/farms/farms_1.52.0.tar.gz","https://bioarchive.galaxyproject.org/farms_1.52.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-farms/bioconductor-farms_1.52.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('farms')\""]},"parent_recipe":{"name":"bioconductor-farms","path":"recipes/bioconductor-farms","version":"1.32.0"}},"biotools":{"id":"farms","home":"http://bioconductor.org/packages/release/bioc/html/farms.html","license":"GPL-2.0","summary":"The package provides the summarization algorithm called Factor Analysis for Robust Microarray Summarization and a novel unsupervised feature selection criterion called \"I/NI-calls\".","addition_date":"2017-01-17T15:03:16Z","last_update_date":"2018-12-16T14:33:44Z","tool_type":["Command-line tool","Library"],"version":["1.26.0"],"collections":["BioConductor"],"biotools_curie":"biotools:farms","credit":[{"email":"okko@clevert.de","name":"Djork-Arne Clevert","orcidid":"http://orcid.org/0000-0003-4191-2156","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/html/farms.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Read summarisation","uri":"http://edamontology.org/operation_3793"}]}],"name":"farms","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1093/bioinformatics/btl033","metadata":{"abstract":"Motivation: We propose a new model-based technique for summarizing high-density oligonucleotide array data at probe level for Affymetrix GeneChips. The new summarization method is based on a factor analysis model for which a Bayesian maximum a posteriori method optimizes the model parameters under the assumption of Gaussian measurement noise. Thereafter, the RNA concentration is estimated from the model. In contrast to previous methods our new method called 'Factor Analysis for Robust Microarray Summarization (FARMS)' supplies both P -values indicating interesting information and signal intensity values. Results: We compare FARMS on Affymetrix's spike-in and Gene Logic's dilution data to established algorithms like Affymetrix Microarray Suite (MAS) 5.0, Model Based Expression Index (MBEI), Robust Multi-array Average (RMA). Further, we compared FARMS with 43 other methods via the 'Affycomp II' competition. The experimental results show that FARMS with default parameters outperforms previous methods if both sensitivity and specificity are simultaneously considered by the area under the receiver operating curve (AUC). We measured two quantities through the AUC: correctly detected expression changes versus wrongly detected (fold change) and correctly detected significantly different expressed genes in two sets of arrays versus wrongly detected (P-value). Furthermore FARMS is computationally less expensive then RMA, MAS and MBEI. \u00a9 2006 Oxford University Press.","authors":[{"name":"Clevert D.-A."},{"name":"Hochreiter S."},{"name":"Obermayer K."}],"citationCount":184,"date":"2006-04-01T00:00:00Z","journal":"Bioinformatics","title":"A new summarization method for affymetrix probe level data"},"pmid":"16473874","type":["Primary"]}],"topic":[{"term":"Microarray experiment","uri":"http://edamontology.org/topic_3518"}],"validated":1},"bioschemas":{"name":"farms","home":"https://bio.tools/farms","license":"GPL-2.0","version":"1.26.0","summary":"The package provides the summarization algorithm called Factor Analysis for Robust Microarray Summarization and a novel unsupervised feature selection criterion called \"I/NI-calls\".","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:farms:1.26.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":121,"citations":[{"count":1,"year":"2006"},{"count":1,"year":"2023"},{"count":1,"year":"2026"},{"count":2,"year":"2007"},{"count":2,"year":"2024"},{"count":2,"year":"2025"},{"count":3,"year":"2018"},{"count":4,"year":"2022"},{"count":5,"year":"2008"},{"count":5,"year":"2009"},{"count":5,"year":"2019"},{"count":6,"year":"2020"},{"count":6,"year":"2021"},{"count":7,"year":"2010"},{"count":8,"year":"2015"},{"count":8,"year":"2017"},{"count":9,"year":"2013"},{"count":10,"year":"2012"},{"count":10,"year":"2016"},{"count":12,"year":"2014"},{"count":14,"year":"2011"}],"doi":"10.1093/bioinformatics/btl033","pmid":"16473874","ref_count":0,"refs":[],"title":"A new summarization method for Affymetrix probe level data.","year":2006}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":40