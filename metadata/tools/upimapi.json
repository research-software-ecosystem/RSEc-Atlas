{"tool_name":"upimapi","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"upimapi","identifiers":[],"license":"BSD-3-Clause","summary":"UniProt Id Mapping through API","home_url":"https://github.com/iquasere/UPIMAPI","keywords":["Genomics","Protein Sequences"],"manually_check":true,"total_pulls":5},"biotools":{"id":"upimapi","home":"https://github.com/iquasere/UPIMAPI","license":"BSD-3-Clause","summary":"UniProt Id Mapping through API","addition_date":"2021-04-27T11:12:49Z","last_update_date":"2024-11-24T20:08:58.317936Z","tool_type":["Command-line tool"],"version":["1.7.4"],"accessibility":"Open access","biotools_curie":"biotools:upimapi","cost":"Free of charge","credit":[{"email":"jsequeira@ceb.uminho.pt","name":"Jo\u00e3o Sequeira","orcidid":"http://orcid.org/0000-0002-2691-9950","typeEntity":"Person","typeRole":["Developer"],"url":"https://www.ceb.uminho.pt/People/Details/9fca8b19-e2c7-4d5f-acb8-c7e15c98ca47"}],"documentation":[{"type":["Quick start guide"],"url":"https://github.com/iquasere/UPIMAPI#readme"}],"edit_permission":{"type":"private"},"function":[{"cmd":"upimapi.py --input path/to/proteins.faa --output path/to/output_folder --use-diamond --database path/to/database.faa --full-id","input":[{"data":{"term":"Protein sequence record","uri":"http://edamontology.org/data_2886"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}],"note":"\"database.fasta\" must be the UniProt database or a subsection of it\nIf IDs come in full format (e.g. tr|K2QF36|K2QF36_METFP) the \"--full-id\" parameter must be set","operation":[{"term":"Gene functional annotation","uri":"http://edamontology.org/operation_3672"},{"term":"ID mapping","uri":"http://edamontology.org/operation_3282"}],"output":[{"data":{"term":"Protein family report","uri":"http://edamontology.org/data_0907"}},{"data":{"term":"Sequence search results","uri":"http://edamontology.org/data_0857"},"format":[{"term":"TSV","uri":"http://edamontology.org/format_3475"}]}]}],"maturity":"Emerging","name":"UPIMAPI","operating_system":["Linux","Mac"],"owner":"iquasere","publication":[{"doi":"10.1016/j.csbj.2022.03.042","metadata":{"abstract":"Omics and meta-omics technologies are powerful approaches to explore microorganisms\u2019 functions, but the sheer size and complexity of omics datasets often turn the analysis into a challenging task. Software developed for omics and meta-omics analyses, together with knowledgebases encompassing information on genes, proteins, taxonomic and functional annotation, among other types of information, are valuable resources for analyzing omics data. Although several bioinformatics resources are available for meta-omics analyses, many require significant computational expertise. Web interfaces are more user-friendly, but often struggle to handle large data files, such as those obtained in metagenomics, metatranscriptomics, or metaproteomics experiments. In this work, we present three novel bioinformatics tools, which are available through user-friendly command-line interfaces, can be run sequentially or stand-alone, and combine popular resources for functional annotation. UPIMAPI performs sequence homology-based annotation and obtains data from UniProtKB (e.g., protein names, EC numbers, Gene Ontology, Taxonomy, cross-references to external databases). reCOGnizer performs multithreaded domain homology-based annotation of protein sequences with several functional databases (i.e., CDD, NCBIfam, Pfam, Protein Clusters, SMART, TIGRFAM, COG and KOG) and in addition, obtains information on domain names and descriptions and EC numbers. KEGGCharter represents omics results, including differential gene expression, in KEGG metabolic pathways. In addition, it shows the taxonomic assignment of the enzymes represented, which is particularly useful in metagenomics studies in which several microorganisms are present. reCOGnizer, UPIMAPI and KEGGCharter together provide a comprehensive and complete functional characterization of large datasets, facilitating the interpretation of microbial activities in nature and in biotechnological processes.","authors":[{"name":"Alves M.M."},{"name":"Rocha M."},{"name":"Salvador A.F."},{"name":"Sequeira J.C."}],"citationCount":13,"date":"2022-01-01T00:00:00Z","journal":"Computational and Structural Biotechnology Journal","title":"UPIMAPI, reCOGnizer and KEGGCharter: Bioinformatics tools for functional annotation and visualization of (meta)-omics datasets"},"pmcid":"PMC9034014","pmid":"35495109","type":["Primary"]}],"topic":[{"term":"Functional genomics","uri":"http://edamontology.org/topic_0085"}]},"bioschemas":{"name":"UPIMAPI","home":"https://bio.tools/upimapi","license":"BSD-3-Clause","version":"1.7.4","summary":"UniProt Id Mapping through API","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:upimapi:1.2.0/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"readme":false,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:upimapi:1.7.4/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":tr