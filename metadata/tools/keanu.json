{"tool_name":"keanu","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"keanu","home":"https://github.com/IGBB/keanu","license":"GPL-3.0","summary":"A Novel Visualization Tool to Explore Biodiversity in Metagenomes.\n\nA tool for viewing the contents of metagenomic samples.\n\nformat_input.py: takes a file that contains a single BLAST query and taxon ID per line and formats it correctly as input for Keanu.\n\nThe following command is used to create the taxonomy.dat and merged_deleted.dat databases necessary for running Keanu. There are no optional parameters. The input files - names.dmb, nodes.dmp, delnodes.dmp, and merged.dmp - come from the taxdmp file located at the NCBI Taxonomy FTP site: ftp://ftp.ncbi.nlm.nih.gov/pub/taxonomy/.","addition_date":"2021-01-18T07:30:25Z","last_update_date":"2021-02-12T10:23:46Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:keanu","credit":[{"name":"Natalia Vinas","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"},{"term":"Sequence assembly","uri":"http://edamontology.org/operation_0310"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"Keanu","owner":"Niclaskn","publication":[{"pmcid":"PMC6936898"}],"topic":[{"term":"Biodiversity","uri":"http://edamontology.org/topic_3050"},{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Taxonomy","uri":"http://edamontology.org/topic_0637"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:keanu/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"proje