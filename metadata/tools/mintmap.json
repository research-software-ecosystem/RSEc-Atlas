{"tool_name":"mintmap","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"mintmap","identifiers":["biotools:mintmap","doi:10.1038/srep41184"],"license":"Not available","summary":"Generate trf profiles from short rna-seq datasets","home_url":"https://github.com/TJU-CMC-Org/MINTmap","keywords":["Animals","Cell Nucleus","High-Throughput Nucleotide Sequencing","Humans","Male","Mice","Mitochondria","Models, Molecular","Nucleic Acid Conformation","RNA, Transfer","Sequence Analysis, RNA","Functional, regulatory and non-coding RNA","RNA-seq","Cell biology"],"manually_check":true,"total_pulls":0},"biotools":{"id":"mintmap","home":"https://cm.jefferson.edu/MINTcodes/","license":"GPL-3.0","summary":"Generate tRF profiles from short RNA-Seq datasets.","addition_date":"2018-08-07T09:24:02Z","last_update_date":"2018-12-10T12:59:01Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:mintmap","credit":[{"email":"isidore.rigoutsos@jefferson.edu","name":"Isidore Rigoutsos","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/TJU-CMC-Org/MINTmap/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Sequence classification","uri":"http://edamontology.org/operation_2995"}]}],"name":"MINTmap","operating_system":["Linux"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1038/srep41184","metadata":{"abstract":"\u00a9 The Author(s) 2017.Transfer RNA fragments (tRFs) are an established class of constitutive regulatory molecules that arise from precursor and mature tRNAs. RNA deep sequencing (RNA-seq) has greatly facilitated the study of tRFs. However, the repeat nature of the tRNA templates and the idiosyncrasies of tRNA sequences necessitate the development and use of methodologies that differ markedly from those used to analyze RNA-seq data when studying microRNAs (miRNAs) or messenger RNAs (mRNAs). Here we present MINTmap (for MItochondrial and Nuclear TRF mapping), a method and a software package that was developed specifically for the quick, deterministic and exhaustive identification of tRFs in short RNA-seq datasets. In addition to identifying them, MINTmap is able to unambiguously calculate and report both raw and normalized abundances for the discovered tRFs. Furthermore, to ensure specificity, MINTmap identifies the subset of discovered tRFs that could be originating outside of tRNA space and flags them as candidate false positives. Our comparative analysis shows that MINTmap exhibits superior sensitivity and specificity to other available methods while also being exceptionally fast. The MINTmap codes are available through https://github.com/TJU-CMC-Org/MINTmap/ under an open source GNU GPL v3.0 license.","authors":[{"name":"Loher P."},{"name":"Rigoutsos I."},{"name":"Telonis A.G."}],"citationCount":53,"date":"2017-02-21T00:00:00Z","journal":"Scientific Reports","title":"MINTmap: Fast and exhaustive profiling of nuclear and mitochondrial tRNA fragments from short RNA-seq data"},"pmcid":"PMC5318995","pmid":"28220888"}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"RNA-seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"bioschemas":{"name":"MINTmap","home":"https://bio.tools/mintmap","license":"GPL-3.0","summary":"Generate tRF profiles from short RNA-Seq datasets.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mintmap/cmd/cm.jefferson.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":