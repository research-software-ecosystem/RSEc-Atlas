{"tool_name":"binoculars","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"binoculars","home":"https://github.com/id03/binoculars","license":"GPL-3.0","summary":"BINoculars is a tool for data reduction and analysis of large sets of surface diffraction data that have been acquired with a two-dimensional X-ray detector.","addition_date":"2018-09-25T01:17:30Z","last_update_date":"2018-12-10T12:59:01Z","tool_type":["Command-line tool","Desktop application"],"biotools_curie":"biotools:binoculars","credit":[{"email":"binoculars@uithetblauw.nl","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["Training material"],"url":"https://github.com/id03/binoculars/wiki"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Image analysis","uri":"http://edamontology.org/operation_3443"}]}],"name":"BINoculars","operating_system":["Linux","Mac","Windows"],"owner":"daniel_stefan","publication":[{"doi":"10.1107/S1600576715009607","metadata":{"abstract":"BINoculars is a tool for data reduction and analysis of large sets of surface diffraction data that have been acquired with a two-dimensional X-ray detector. The intensity of each pixel of a two-dimensional detector is projected onto a three-dimensional grid in reciprocal-lattice coordinates using a binning algorithm. This allows for fast acquisition and processing of high-resolution data sets and results in a significant reduction of the size of the data set. The subsequent analysis then proceeds in reciprocal space. It has evolved from the specific needs of the ID03 beamline at the ESRF, but it has a modular design and can be easily adjusted and extended to work with data from other beamlines or from other measurement techniques. This paper covers the design and the underlying methods employed in this software package and explains how BINoculars can be used to improve the workflow of surface X-ray diffraction measurements and analysis.","authors":[{"name":"Drnec J."},{"name":"Felici R."},{"name":"Frenken J."},{"name":"Onderwaater W."},{"name":"Roobol S."}],"citationCount":26,"date":"2015-08-01T00:00:00Z","journal":"Journal of Applied Crystallography","title":"BINoculars: Data reduction and analysis software for two-dimensional detectors in surface X-ray diffraction"},"pmcid":"PMC4520292","pmid":"26306093","type":["Primary"]}],"topic":[{"term":"X-ray diffraction","uri":"http://edamontology.org/topic_2828"}],"validated":1},"bioschemas":{"name":"BINoculars","home":"https://bio.tools/binoculars","license":"GPL-3.0","summary":"BINoculars is a tool for data reduction and analysis of large sets of surface diffraction data that have been acquired with a two-dimensional X-ray detector.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:binoculars/app/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"training_material":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":11,"citations":[{"count":1,"year":"2017"},{"count":1,"year":"2019"},{"count":1,"year":"2021"},{"count":1,"year":"2026"},{"count":2,"year":"2022"},{"count":2,"year":"2023"},{"count":3,"year":"2024"}],"doi":"10.1107/S1600576715009607","pmcid":"PMC4520292","pmid":"26306093","ref_count":7,"refs":[{"count":1,"year":"1990"},{"count":1,"year":"1998"},{"count":1,"year":"2010"},{"count":2,"year":"2013"},{"count":2,"year":"2014"}],"title":"","year":2015}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":tru