{"tool_name":"countsimqc","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"countsimqc","home":"https://github.com/csoneson/countsimQC","license":"GPL-2.0","summary":"Compare characteristic features of count data sets.","addition_date":"2018-06-20T19:01:07Z","last_update_date":"2024-11-25T14:43:20.254333Z","tool_type":["Library"],"biotools_curie":"biotools:countsimqc","credit":[{"email":"charlotte.soneson@uzh.ch","name":"Charlotte Soneson","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"mark.robinson@imls.uzh.ch","name":"Mark Robinson","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/csoneson/countsimQC"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Literature search","uri":"http://edamontology.org/operation_0305"},{"term":"Sequence feature comparison","uri":"http://edamontology.org/operation_0256"}]}],"name":"countsimQC","operating_system":["Linux","Mac","Windows"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1093/bioinformatics/btx631","metadata":{"abstract":"Summary Statistical tools for biological data analysis are often evaluated using synthetic data, designed to mimic the features of a specific type of experimental data. The generalizability of such evaluations depends on how well the synthetic data reproduce the main characteristics of the experimental data, and we argue that an assessment of this similarity should accompany any synthetic dataset used for method evaluation. We describe countsimQC, which provides a straightforward way to generate a stand-alone report that shows the main characteristics of (e.g. RNA-seq) count data and can be provided alongside a publication as verification of the appropriateness of any utilized synthetic data. Availability and implementation countsimQC is implemented as an R package (for R versions \u2265 3.4) and is available from https://github.com/csoneson/countsimQC under a GPL (\u22652) license. Contact charlotte.soneson@uzh.ch or mark.robinson@imls.uzh.ch","authors":[{"name":"Robinson M.D."},{"name":"Soneson C."}],"citationCount":27,"date":"2018-02-15T00:00:00Z","journal":"Bioinformatics","title":"Towards unified quality verification of synthetic count data with countsimQC"},"pmcid":"PMC5860609","pmid":"29028961"}],"topic":[{"term":"Literature and language","uri":"http://edamontology.org/topic_3068"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Simulation experiment","uri":"http://edamontology.org/topic_3524"},{"term":"Statistics and probability","uri":"http://edamontology.org/topic_2269"}],"validated":1},"bioschemas":{"name":"countsimQC","home":"https://bio.tools/countsimqc","license":"GPL-2.0","summary":"Compare characteristic features of count data sets.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:countsimqc/lib/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":25,"citations":[{"count":1,"year":"2019"},{"count":1,"year":"2022"},{"count":1,"year":"2026"},{"count":2,"year":"2024"},{"count":4,"year":"2020"},{"count":4,"year":"2023"},{"count":6,"year":"2018"},{"count":6,"year":"2021"}],"doi":"10.1093/bioinformatics/btx631","pmcid":"PMC5860609","pmid":"29028961","ref_count":7,"refs":[{"count":1,"year":"2009"},{"count":1,"year":"2016"},{"count":1,"year":"2018"},{"count":2,"year":"2014"},{"count":2,"year":"2017"}],"title":"Towards unified quality verification of synthetic count da