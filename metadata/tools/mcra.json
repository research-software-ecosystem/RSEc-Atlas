{"tool_name":"mcra","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"mcra","home":"https://mcra.rivm.nl","license":"Not licensed","summary":"MCRA stands for Monte Carlo Risk Assessment. It is a web-based platform containing various models that users can use to assess these health risks for specific populations in various scenarios. In MCRA, more than 50 modules are available to address all major areas of risk assessment, including hazard identification, hazard characterisation, exposure assessment and risk assessment. MCRA contains models following the guidelines of the European Commission and the European Food Safety Authority (EFSA), and also includes novel scientific models that could improve or refine future risk assessment.","addition_date":"2023-05-10T13:33:06.042950Z","last_update_date":"2023-05-10T13:33:06.046205Z","tool_type":["Command-line tool","Web API","Web application"],"version":["9.2"],"biotools_curie":"biotools:mcra","documentation":[{"type":["User manual"],"url":"https://mcra.rivm.nl/documentation"}],"edit_permission":{"type":"private"},"maturity":"Mature","name":"MCRA","owner":"jwkruisselbrink","topic":[{"term":"Topic","uri":"http://edamontology.org/topic_0003"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mcra:9.2/cmd/mcra.rivm.nl","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mcra:9.2/rest/mcra.rivm.nl","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"manual":true},"lice