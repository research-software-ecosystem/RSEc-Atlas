{"tool_name":"openprimer","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"openprimer","home":"https://bioconductor.org/packages/openPrimeR","license":"GPL-2.0","summary":"An implementation of methods for designing, evaluating, and comparing primer sets for multiplex PCR. Primers are designed by solving a set cover problem such that the number of covered template sequences is maximized with the smallest possible set of primers. To guarantee that high-quality primers are generated, only primers fulfilling constraints on their physicochemical properties are selected. A Shiny app providing a user interface for the functionalities of this package is provided by the 'openPrimeRui' package.","addition_date":"2018-07-24T15:49:41Z","last_update_date":"2018-12-10T12:59:00Z","tool_type":["Library"],"version":["1.34.0"],"collections":["BioConductor"],"biotools_curie":"biotools:openprimer","cost":"Free of charge","credit":[{"name":"Matthias D\u00f6ring","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Nico Pfeifer","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/openPrimeR"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Comparison","uri":"http://edamontology.org/operation_2424"}]},{"operation":[{"term":"Design","uri":"http://edamontology.org/operation_2430"}]}],"name":"openPrimeR","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[],"topic":[{"term":"Probes and primers","uri":"http://edamontology.org/topic_0632"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:openprimer:1.2.0/lib/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"source_packages":true,"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license"