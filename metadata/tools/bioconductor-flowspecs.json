{"tool_name":"bioconductor-flowspecs","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-flowspecs","identifiers":["doi:10.18129/b9.bioc.flowspecs"],"license":"MIT","summary":"Tools for processing of high-dimensional cytometry data","home_url":"https://bioconductor.org/packages/3.11/bioc/html/flowSpecs.html","keywords":[],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-flowspecs","home":"https://bioconductor.org/packages/flowSpecs","license":"MIT","summary":"This package is intended to fill the role of conventional cytometry pre-processing software, for spectral decomposition, transformation, visualization and cleanup, and to aid further downstream analyses, such as with DepecheR, by enabling transformation of flowFrames and flowSets to dataframes. Functions for flowCore-compliant automatic 1D-gating/filtering are in the pipe line. The package name has been chosen both as it will deal with spectral cytometry and as it will hopefully give the user a nice pair of spectacles through which to view their data.","addition_date":"2026-09-01T07:20:16.309957Z","last_update_date":"2026-09-01T07:20:16.312502Z","tool_type":["Command-line tool","Library"],"version":["1.26.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-flowspecs","credit":[{"name":"Jakob Theorell","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/flowSpecs"}],"edit_permission":{"type":"private"},"name":"flowSpecs","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.18129/B9.bioc.flowSpecs"}]},"bioschemas":{"name":"flowSpecs","home":"https://bio.tools/bioconductor-flowspecs","license":"MIT","version":"1.26.0","summary":"This package is intended to fill the role of conventional cytometry pre-processing software, for spectral decomposition, transformation, visualization