{"tool_name":"bioconductor-meskit","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-meskit","identifiers":["doi:10.18129/b9.bioc.meskit"],"license":"Not available","summary":"A tool kit for dissecting cancer evolution from multi-region derived tumor biopsies via somatic alterations","home_url":"https://bioconductor.org/packages/3.12/bioc/html/MesKit.html","keywords":["Genetics"],"manually_check":true,"total_pulls":919},"biotools":{"id":"bioconductor-meskit","home":"https://bioconductor.org/packages/MesKit","license":"GPL-3.0","summary":"MesKit provides commonly used analysis and visualization modules based on mutational data generated by multi-region sequencing (MRS). This package allows to depict mutational profiles, measure heterogeneity within or between tumors from the same patient, track evolutionary dynamics, as well as characterize mutational patterns on different levels. Shiny application was also developed for a need of GUI-based analysis. As a handy tool, MesKit can facilitate the interpretation of tumor heterogeneity and the understanding of evolutionary relationship between regions in MRS study.","tool_type":["Command-line tool","Library"],"version":["1.22.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-meskit","credit":[{"name":"Jianyu Chen","typeEntity":"Person","typeRole":["Contributor","Developer"]},{"name":"Mengni Liu","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Xin Wang","typeEntity":"Person","typeRole":["Contributor","Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/MesKit"}],"name":"MesKit","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.18129/B9.bioc.MesKit"}]},"bioschemas":{"name":"MesKit","home":"https://bio.tools/bioconductor-meskit","license":"GPL-3.0-only","version":"1.22.0","summary":"MesKit provides commonly used analysis