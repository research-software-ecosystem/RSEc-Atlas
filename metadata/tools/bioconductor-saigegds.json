{"tool_name":"bioconductor-saigegds","contents":["biocontainers","oeb","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-saigegds","identifiers":["doi:10.18129/b9.bioc.saigegds"],"license":"GPL-3","summary":"Scalable Implementation of Generalized mixed models using GDS files in Phenome-Wide Association Studies","home_url":"https://bioconductor.org/packages/3.10/bioc/html/SAIGEgds.html","keywords":["Genomics","Genetics"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-saigegds","home":"https://bioconductor.org/packages/SAIGEgds","license":"GPL-3.0","summary":"Scalable implementation of generalized mixed models with highly optimized C++ implementation and integration with Genomic Data Structure (GDS) files. It is designed for single variant tests and set-based aggregate tests in large-scale Phenome-wide Association Studies (PheWAS) with millions of variants and samples, controlling for sample structure and case-control imbalance. The implementation is based on the SAIGE R package (v0.45, Zhou et al. 2018 and Zhou et al. 2020), and it is extended to include the state-of-the-art ACAT-O set-based tests. Benchmarks show that SAIGEgds is significantly faster than the SAIGE R package. Optional OpenCL-based GPU acceleration is supported for the GRM cross-product computation in null model fitting and for GRM construction.","addition_date":"2026-10-11T01:45:27.914380Z","last_update_date":"2026-10-11T01:45:27.917649Z","tool_type":["Command-line tool","Library"],"version":["2.12.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-saigegds","credit":[{"name":"J. Wade Davis","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Wei Zhou","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Xiuwen Zheng","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/SAIGEgds"}],"edit_permission":{"type":"private"},"name":"SAIGE