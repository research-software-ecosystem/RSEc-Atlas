{"tool_name":"pepe","contents":["biotools"],"identifiers":["biotools:pepe"],"fetched_metadata":{"biotools":{"id":"pepe","home":"https://zenodo.org/records/20268104","license":"MIT","summary":"PEPE is a high-throughput, streaming-based command-line tool designed for the efficient, scalable extraction of diverse, multi-modal representations (embeddings) from Protein Language Models (PLMs). It enables researchers to generate massive datasets of protein embeddings for downstream structural, functional, and evolutionary analyses.","addition_date":"2026-11-05T13:45:06.821074Z","last_update_date":"2026-11-05T13:45:06.824965Z","biotools_curie":"biotools:pepe","credit":[{"email":"jahn.zhong@medisin.uio.no","name":"Jahn Zhong","orcidid":"https://orcid.org/0000-0002-7247-1392","typeEntity":"Person"},{"email":"victor.greiff@medisin.uio.no","name":"Victor Greiff","orcidid":"https://orcid.org/0000-0003-2622-5032","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Feature extraction","uri":"http://edamontology.org/operation_3937"},{"term":"Information extraction","uri":"http://edamontology.org/operation_3907"},{"term":"Protein modelling","uri":"http://edamontology.org/operation_0477"}]}],"name":"PEPE: Parallel Extraction for Protein Embeddings (pepe-cli)","owner":"pub2tools2024","publication":[{"doi":"10.1093/BIOINFORMATICS/BTAG375","pmcid":"PMC13326402","pmid":"42286792"}],"topic":[{"term":"Computer science","uri":"http://edamontology.org/topic_3316"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}]}}}