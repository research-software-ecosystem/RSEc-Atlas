{"tool_name":"tofu-maapo","contents":["biotools"],"identifiers":["biotools:tofu-maapo"],"fetched_metadata":{"biotools":{"id":"tofu-maapo","home":"https://github.com/ikmb/TOFU-MAaPO","summary":"TOFU-MAaPO is a portable, automated Nextflow pipeline designed for the fast, scalable, and reproducible analysis of large metagenome sequencing data. It performs pre-processing, assembly of metagenome-assembled genomes, and taxonomic/functional annotation directly from the SRA.","addition_date":"2026-11-05T13:45:20.402491Z","last_update_date":"2026-11-05T13:45:20.405412Z","biotools_curie":"biotools:tofu-maapo","credit":[{"email":"d.ellinghaus@ikmb.uni-kiel.de","name":"David Ellinghaus","orcidid":"https://orcid.org/0000-0002-4332-6110","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Genome annotation","uri":"http://edamontology.org/operation_0362"},{"term":"Sequence assembly","uri":"http://edamontology.org/operation_0310"},{"term":"Sequence trimming","uri":"http://edamontology.org/operation_3192"},{"term":"Taxonomic classification","uri":"http://edamontology.org/operation_3460"}]}],"name":"TOFU-MAaPO: Metagenomic Assembly and Profiling Workflow","owner":"pub2tools2024","publication":[{"doi":"10.1038/S41467-026-74033-9","pmcid":"PMC13260335","pmid":"42277027"}],"topic":[{"term":"Metagenomic sequencing","uri":"http://edamontology.org/topic_3837"},{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Microbiology","uri":"http://edamontology.org/topic_3301"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]}}}