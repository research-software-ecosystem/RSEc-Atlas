{"tool_name":"libsbml","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"libsbml","identifiers":["biotools:libsbml","doi:10.1093/bioinformatics/btn051"],"license":"LGPL-2.1","summary":"LibSBML is an application programming interface library for reading, writing, manipulating and validating content expressed in the Systems Biology Markup Language (SBML) format. It is written in ISO C and C++, provides language bindings for Common Lisp, Java, Python, Perl, MATLAB and Octave, and includes many features that facilitate adoption and use of both SBML and the library. Developers can embed libSBML in their applications, saving themselves the work of implementing their own SBML parsing, manipulation and validation software.","home_url":"https://sourceforge.net/p/sbml/code/HEAD/tree/trunk/libsbml/","keywords":["Computer Simulation","Models, Biological","Programming Languages","Proteome","Signal Transduction","Systems Biology","User-Computer Interface","Systems biology","Data management"],"manually_check":true,"total_pulls":5382},"biotools":{"id":"libsbml","home":"http://sbml.org/Software/libSBML","summary":"A free, open-source programming library to help you read, write, manipulate, translate, and validate SBML files and data streams. It is not an application itself (though it does come with example programs), but rather a library you can embed in your own applications.","addition_date":"2017-08-03T18:48:23Z","last_update_date":"2025-07-08T14:11:36.777222Z","tool_type":["Library"],"biotools_curie":"biotools:libsbml","credit":[{"email":"libsbml-team@googlegroups.com","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://sbml.org/About#The_SBML_Team"}],"documentation":[{"type":["General"],"url":"http://sbml.org/Documents"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Data handling","uri":"http://edamontology.org/operation_2409"}]}],"name":"LibSBML","operating_system":["Linux","Mac","W