{"tool_name":"bioconductor-siamcat","contents":["oeb","bioschemas","biocontainers","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-siamcat","identifiers":["doi:10.18129/b9.bioc.siamcat"],"license":"GPL-3","summary":"Statistical Inference of Associations between Microbial Communities And host phenoTypes","home_url":"https://bioconductor.org/packages/3.8/bioc/html/SIAMCAT.html","keywords":["Clustering","Genomics","Metagenomics"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-siamcat","home":"https://bioconductor.org/packages/SIAMCAT","license":"GPL-3.0","summary":"Pipeline for Statistical Inference of Associations between Microbial Communities And host phenoTypes (SIAMCAT). A primary goal of analyzing microbiome data is to determine changes in community composition that are associated with environmental factors. In particular, linking human microbiome composition to host phenotypes such as diseases has become an area of intense research. For this, robust statistical modeling and biomarker extraction toolkits are crucially needed. SIAMCAT provides a full pipeline supporting data preprocessing, statistical association testing, statistical modeling (LASSO logistic regression) including tools for evaluation and interpretation of these models (such as cross validation, parameter selection, ROC analysis and diagnostic model plots).","addition_date":"2026-09-01T07:31:13.853657Z","last_update_date":"2026-09-01T07:31:13.856537Z","tool_type":["Command-line tool","Library"],"version":["2.16.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-siamcat","credit":[{"name":"Georg Zeller","typeEntity":"Person","typeRole":["Developer"]},{"name":"Jakob Wirbel","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Kersten Breuer","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Konrad Zych","typeEntity":"Person","typeRole":["Developer"]},{"name":"Morgan Essex","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Nicolai Karcher","typeEntity":"Person","typeRole":["Contributor"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/SIAMCAT"}],"edit_permission":{"type":"private"},"name":"SIAMCAT","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.1186/s13059-021-02306-1"}]},"bioschemas":{"name":"SIAMCAT","home":"https://bio.tools/bioconductor-siamcat","license":"GPL-3.0-only","version":"2.16.0","summary":"Pipeline for Statistical Inference of Associations between Microbial Communities And host phenoTypes (SIAMCAT). A primary goal of analyzing microbiome data is to determine changes in community composition that are associated with environmental factors. In particular, linking human microbiome composition to host phenotypes such as diseases has become an area of intense research. For this, robust statistical modeling and biomarker extraction toolkits are crucially needed. SIAMCAT provides a full pipeline supporting data preprocessing, statistical association testing, statistical modeling (LASSO logistic regression) including tools for evaluation and interpretation of these models (such as cross validation, parameter selection, ROC analysis and diagnostic model plots).","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-siamcat:1.10.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-siamcat:1.12.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0