{"tool_name":"r-missforest","contents":["biocontainers","oeb"],"fetched_metadata":{"biocontainers":{"name":"r-missforest","identifiers":["doi:10.1093/bioinformatics/btr597"],"license":"GPL (>= 2)","summary":"The function missForest in this package is used to impute missing values particularly in the case of mixed-type data. It uses a random forest trained on the observed values of a data matrix to predict the missing values. It can be used to impute continuous and/or categorical data including complex interactions and non-linear relations. It yields an out-of-bag (OOB) imputation error estimate without the need of a test set or elaborate cross-validation. It can be run in parallel to save computation time.","home_url":"https://github.com/stekhoven/missForest","keywords":[],"manually_check":true,"total_pulls":0},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:r-missforest:1.4/cmd/conda.anaconda.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://pypi.org/project/gdsctools/"},{"status":301,"url":"https://pypi.org/pypi/gdsctools"},{"status":301,"url":"https://pypi.org/pypi/gdsctools/"},{"status":301,"url":"https://pypi.python.org/pypi/gdsctools"}],"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/r-missforest","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://pypi.org/project/gdsctools/"},{"statu