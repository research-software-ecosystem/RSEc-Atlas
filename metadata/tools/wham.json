{"tool_name":"wham","contents":["biocontainers","bioschemas","debian","biotools","oeb"],"fetched_metadata":{"biocontainers":{"name":"wham","identifiers":["biotools:Wham6216","doi:10.1371/journal.pcbi.1004572"],"license":"MIT","summary":"Structural variant detection and association testing","home_url":"https://github.com/zeeev/wham","keywords":["Base Sequence","Chromosome Mapping","Genetic Association Studies","Genetic Variation","Genome, Human","Genomic Structural Variation","Humans","Molecular Sequence Data"],"manually_check":true,"total_pulls":6},"biotools":{"id":"wham","home":"http://www.cs.wisc.edu/wham/","license":"GPL-3.0","summary":"High-throughput sequence alignment tool.","addition_date":"2017-01-13T13:17:03Z","last_update_date":"2019-03-12T14:53:13Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:wham","credit":[{"email":"yinan@cs.wisc.edu","name":"Yinan Li","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://research.cs.wisc.edu/wham/tutorial/"},{"type":["User manual"],"url":"http://research.cs.wisc.edu/wham/manual/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Read mapping","uri":"http://edamontology.org/operation_3198"}]}],"maturity":"Mature","name":"WHAM","owner":"seqwiki_import","publication":[{"doi":"10.1145/2389241.2389247","metadata":{"abstract":"Over the last decade, the cost of producing genomic sequences has dropped dramatically due to the current so-called next-generation sequencing methods. However, these next-generation sequencing methods are critically dependent on fast and sophisticated data processing methods for aligning a set of query sequences to a reference genome using rich string matching models. The focus of this work is on the design, development and evaluation of a data processing system for this crucial \"short read alignment\" problem. Our system, called WHAM, employs hash-based indexing methods and bitwise operations for sequence alignments. It allows rich match models and it is significantly faster than the existing state-of-the-art methods. In addition, its relative speedup over the existing method is poised to increase in the future in which read sequence lengths will increase. \u00a9 2012 ACM.","authors":[{"name":"Li Y."},{"name":"Patel J.M."},{"name":"Terrell A."}],"citationCount":16,"date":"2012-12-01T00:00:00Z","journal":"ACM Transactions on Database Systems","title":"WHAM: A high-throughput sequence alignment method"},"type":["Primary"]}],"topic":[{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"bioschemas":{"name":"WHAM","home":"https://bio.tools/wham","license":"GPL-3.0","summary":"High-throughput sequence alignment tool.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:wham/cmd/www.cs.wisc.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true,"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1145/2389241.2389247","ref_count":0,"refs":[]}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":500,"redirects":[{"status":301,"url":"http://research.cs.wisc.edu/wham/"},{"status":301,"url":"https://www.cs.wisc.edu/wham/"},{"status":302,"url":"https://research.cs.wisc.edu/wham/"}],"ssl":true,"ssl_err":null}},"support":{"email":true}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:wham:1.7.0.162/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"reposi