{"tool_name":"recount_bioconductor","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"recount_bioconductor","home":"https://bioconductor.org/packages/recount","license":"Artistic-2.0","summary":"Explore and download data from the recount project available at https://jhubiostatistics.shinyapps.io/recount/. Using the recount package you can download RangedSummarizedExperiment objects at the gene, exon or exon-exon junctions level, the raw counts, the phenotype metadata used, the urls to the sample coverage bigWig files or the mean coverage bigWig file for a particular study. The RangedSummarizedExperiment objects can be used by different packages for performing differential expression analysis. Using http://bioconductor.org/packages/derfinder you can perform annotation-agnostic differential expression analyses with the data from the recount project as described at http://www.nature.com/nbt/journal/v35/n4/full/nbt.3838.html.","addition_date":"2018-07-25T15:03:49Z","last_update_date":"2026-08-30T02:29:44.470900Z","tool_type":["Library"],"version":["1.38.0"],"collections":["BioConductor"],"biotools_curie":"biotools:recount_bioconductor","cost":"Free of charge","credit":[{"name":"Abhinav Nellore","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Andrew E. Jaffe","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Ben Langmead","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Jeffrey T. Leek","typeEntity":"Person","typeRole":["Developer"]},{"name":"Kai Kammers","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Kasper Daniel Hansen","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Leonardo Collado-Torres","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Margaret A. Taub","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Shannon E. Ellis","typeEntity":"Person","typeRole":["Contributor"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/r