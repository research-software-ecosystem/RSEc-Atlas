{"tool_name":"bioconductor-metnet","contents":["biocontainers","oeb","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-metnet","identifiers":["doi:10.18129/b9.bioc.metnet"],"license":"GPL (>= 3)","summary":"Inferring metabolic networks from untargeted high-resolution mass spectrometry data","home_url":"https://bioconductor.org/packages/3.8/bioc/html/MetNet.html","keywords":["Mass spectrometry","Metabolomics"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-metnet","home":"https://bioconductor.org/packages/MetNet","license":"GPL-3.0-or-later","summary":"MetNet contains functionality to infer metabolic network topologies from quantitative data and high-resolution mass/charge information. Using statistical models (including correlation, mutual information, regression and Bayes statistics) and quantitative data (intensity values of features) adjacency matrices are inferred that can be combined to a consensus matrix. Mass differences calculated between mass/charge values of features will be matched against a data frame of supplied mass/charge differences referring to transformations of enzymatic activities. In a third step, the two levels of information are combined to form a adjacency matrix inferred from both quantitative and structure information.","tool_type":["Command-line tool","Library"],"version":["1.30.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-metnet","credit":[{"name":"Elva Maria Novoa-del-Toro","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Liesa Salzer","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Thomas Naake","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/MetNet"}],"name":"MetNet","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-me