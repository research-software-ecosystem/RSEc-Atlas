{"tool_name":"snver","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"snver","identifiers":["biotools:snver","doi:10.1093/nar/gkr599"],"license":"GPL-3.0","summary":"SNVer is a statistical tool for calling common and rare variants in analysis of pool or individual next-generation sequencing data. It reports one single overall p-value for evaluating the significance of a candidate locus being a variant, based on which multiplicity control can be obtained. Loci with any (low) coverage can be tested and depth of coverage will be quantitatively factored into final significance calculation. SNVer runs very fast, making it feasible for analysis of whole-exome sequencing data, or even whole-genome sequencing data.","home_url":"http://snver.sourceforge.net/","keywords":["Gene Frequency","Genetic Variation","High-Throughput Nucleotide Sequencing","Models, Statistical","Polymorphism, Single Nucleotide","DNA polymorphism","Genetics"],"manually_check":true,"total_pulls":0},"biotools":{"id":"snver","home":"http://snver.sourceforge.net/","summary":"Tool for variant calling in pooled or individual sequence data.","addition_date":"2017-01-13T13:16:33Z","last_update_date":"2024-11-25T15:22:21.768177Z","tool_type":["Desktop application"],"biotools_curie":"biotools:snver","credit":[{"email":"ww42@njit.edu","name":"Wei Wang","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://snver.sourceforge.net/manual.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"}]}],"name":"SNVer","operating_system":["Linux","Mac","Windows"],"owner":"seqwiki_import","publication":[{"doi":"10.1093/nar/gkr599","pmcid":"PMC3201884","pmid":"21813454"}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"}],"validated":1},"bioschemas":{"name":"SNVer","home":"https://bio.tools/snver","sum