{"tool_name":"cpvsnp","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-cpvsnp","version":"1.42.0","home":"https://bioconductor.org/packages/3.22/bioc/html/cpvSNP.html","license":"Artistic-2.0","summary":"Gene set analysis methods for SNP association p-values that lie in genes in given gene sets","identifiers":["biotools:cpvsnp","doi:10.1038/nmeth.3252"],"description":"Gene set analysis methods exist to combine SNP-level association p-values into gene sets, calculating a single association p-value for each gene set. This package implements two such methods that require only the calculated SNP p-values, the gene set(s) of interest, and a correlation matrix (if desired). One method (GLOSSI) requires independent SNPs and the other (VEGAS) can take into account correlation (LD) among the SNPs. Built-in plotting functions are available to help users visualize results.","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-biocparallel >=1.44.0,<1.45.0","bioconductor-genomicfeatures >=1.62.0,<1.63.0","bioconductor-gseabase >=1.72.0,<1.73.0","r-base","r-corpcor","r-ggplot2","r-plyr"],"run":["bioconductor-biocparallel >=1.44.0,<1.45.0","bioconductor-genomicfeatures >=1.62.0,<1.63.0","bioconductor-gseabase >=1.72.0,<1.73.0","r-base","r-corpcor","r-ggplot2","r-plyr"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/cpvSNP_1.42.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/cpvSNP/cpvSNP_1.42.0.tar.gz","https://bioarchive.galaxyproject.org/cpvSNP_1.42.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-cpvsnp/bioconductor-cpvsnp_1.42.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('cpvSNP')\""]},"parent_recipe":{"name":"bioconductor-cpvsnp","path":"recipes/bioconductor-cpvsnp","version":"1.12.0"}},"biotools":{"id":"cpvsnp","home":"https://bioconductor.org/packages/cpvSNP","licens