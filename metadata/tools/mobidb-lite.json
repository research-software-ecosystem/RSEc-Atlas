{"tool_name":"mobidb-lite","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"mobidb-lite","home":"http://protein.bio.unipd.it/mobidblite/","license":"CC-BY-NC-ND-4.0","summary":"MobiDB-lite is an optimized method for highly specific predictions of long intrinsically disordered regions","addition_date":"2018-03-12T09:45:00Z","last_update_date":"2024-11-25T14:39:51.264257Z","tool_type":["Command-line tool"],"version":["1.0"],"biotools_curie":"biotools:mobidb-lite","credit":[{"email":"silvio.tosatto@unipd.it","name":"Silvio C.E. Tosatto","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://protein.bio.unipd.it"},{"name":"ELIXIR-ITA-PADOVA","url":"http://elixir.bio.unipd.it/"},{"name":"University of Padua, Department of Biomedical Sciences, BioComputing UP lab","url":"http://protein.bio.unipd.it/"}],"documentation":[{"type":["General"],"url":"http://protein.bio.unipd.it/mobidblite/"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Protein sequence","uri":"http://edamontology.org/data_2976"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}],"operation":[{"term":"Protein feature detection","uri":"http://edamontology.org/operation_3092"},{"term":"Structure analysis","uri":"http://edamontology.org/operation_2480"}],"output":[{"data":{"term":"Protein features","uri":"http://edamontology.org/data_1277"},"format":[{"term":"JSON","uri":"http://edamontology.org/format_3464"},{"term":"Sequence feature table format","uri":"http://edamontology.org/format_2548"}]}]}],"maturity":"Mature","name":"MobiDB-lite","operating_system":["Linux"],"owner":"ELIXIR-ITA-PADOVA","publication":[{"doi":"10.1093/bioinformatics/btx015","metadata":{"abstract":"Motivation: Intrinsic disorder (ID) is established as an important feature of protein sequences. Its use in proteome annotation is however hampered by the availability of many methods with similar performance at the single residue level, which have mostly not been optimized to predict long ID regions of size comparable to domains. Results: Here, we have focused on providing a single consensus-based prediction, MobiDB-lite, optimized for highly specific (i.e. few false positive) predictions of long disorder. The method uses eight different predictors to derive a consensus which is then filtered for spurious short predictions. Consensus prediction is shown to outperform the single methods when annotating long ID regions. MobiDB-lite can be useful in large-scale annotation scenarios and has indeed already been integrated in the MobiDB, DisProt and InterPro databases.","authors":[{"name":"Dosztanyi Z."},{"name":"Necci M."},{"name":"Piovesan D."},{"name":"Tosatto S.C.E."}],"citationCount":139,"date":"2017-05-01T00:00:00Z","journal":"Bioinformatics","title":"MobiDB-lite: Fast and highly specific consensus prediction of intrinsic disorder in proteins"},"pmid":"28453683"}],"topic":[{"term":"Protein sites, features and motifs","uri":"http://edamontology.org/topic_3510"}],"validated":1},"bioschemas":{"name":"MobiDB-lite","home":"https://bio.tools/mobidb-lite","license":"CC-BY-NC-ND-4.0","version":"1.0","summary":"MobiDB-lite is an optimized method for highly specific predictions of long intrinsically disordered regions","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mobidb-lite:1.0/cmd/protein.bio.unipd.it","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"packages":true,"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":117,"citations":[{"count":2,"year":"2017"},{"count":8,"year":"2026"},{"count":9,"year":"2018"},{"count":9,"year":"2019"},{"count":11,"year":"2024"},{"count":13,"year":"2023"},{"count":15,"year":"2021"},{"count":15,"year":"2