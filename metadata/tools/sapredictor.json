{"tool_name":"sapredictor","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"sapredictor","home":"http://www.sapredictor.cn","summary":"An Expert System for Screening Chemicals Against Structural Alerts.","addition_date":"2022-10-09T15:36:03.577214Z","last_update_date":"2024-11-24T15:28:12.955112Z","tool_type":["Web application"],"accessibility":"Open access","biotools_curie":"biotools:sapredictor","cost":"Free of charge","credit":[{"email":"lixiao1688@163.com","name":"Xiao Li","typeEntity":"Person"},{"name":"Huizhu Guo"},{"name":"Ruiqiu Zhang"},{"name":"Yinping Shi"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"SMILES string","uri":"http://edamontology.org/data_2301"}}],"operation":[{"term":"Fold recognition","uri":"http://edamontology.org/operation_0303"},{"term":"Small molecule design","uri":"http://edamontology.org/operation_4009"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"SApredictor","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.3389/fchem.2022.916614","metadata":{"abstract":"The rapid and accurate evaluation of chemical toxicity is of great significance for estimation of chemical safety. In the past decades, a great number of excellent computational models have been developed for chemical toxicity prediction. But most machine learning models tend to be \u201cblack box\u201d, which bring about poor interpretability. In the present study, we focused on the identification and collection of structural alerts (SAs) responsible for a series of important toxicity endpoints. Then, we carried out effective storage of these structural alerts and developed a web-server named SApredictor (www.sapredictor.cn) for screening chemicals against structural alerts. People can quickly estimate the toxicity of chemicals with SApredictor, and the specific key substructures which cause the chemical toxicity will be intuitively displayed to provide valuable information for the structural optimization by medicinal chemists.","authors":[{"name":"Cui X."},{"name":"Guo H."},{"name":"Hua Y."},{"name":"Li X."},{"name":"Liu B."},{"name":"Shi Y."},{"name":"Zhang R."}],"citationCount":12,"date":"2022-07-13T00:00:00Z","journal":"Frontiers in Chemistry","title":"SApredictor: An Expert System for Screening Chemicals Against Structural Alerts"},"pmcid":"PMC9326022","pmid":"35910729"}],"topic":[{"term":"Compound libraries and screening","uri":"http://edamontology.org/topic_3343"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"},{"term":"Toxicology","uri":"http://edamontology.org/topic_2840"},{"term":"Zoology","uri":"http://edamontology.org/topic_3500"}],"validated":1},"bioschemas":{"name":"SApredictor","home":"https://bio.tools/sapredictor","summary":"An Expert System for Screening Chemicals Against Structural Alerts.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:sapredictor/web/www.sapredictor.cn","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":10,"citations":[{"count":1,"year":"2022"},{"count":1,"year":"2023"},{"count":2,"year":"2025"},{"count":3,"year":"2024"},{"count":3,"year":"2026"}],"doi":"10.3389/fchem.2022.916614","pmcid":"PMC9326022","pmid":"35910729","ref_count":50,"refs":[{"count":1,"year":"-1"},{"count":1,"year":"1984"},{"count":1,"year":"1988"},{"count":1,"year":"2000"},{"count":1,"year":"2002"},{"count":1,"year":"2008"},{"count":2,"year":"2010"},{"count":2,"year":"2011"},{"count":2,"year":"2013"},{"count":2,"year":"2016"},{"count":3,"year":"2012"},{"count":3,"year":"2014"},{"count":3,"year":"2015"},{"count":3,"year":"2020"},{"count":5,"year":"2017