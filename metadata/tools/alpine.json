"parent_recipe":{"name":"bioconductor-alpine","path":"recipes/bioconductor-alpine","version":"1.6.0"}},"biotools":{"id":"alpine","home":"http://bioconductor.org/packages/release/bioc/html/alpine.html","license":"GPL-2.0","summary":"Fragment sequence bias modeling and correction for RNA-seq transcript abundance estimation.","addition_date":"2017-01-17T14:57:47Z","last_update_date":"2019-01-13T17:33:47Z","tool_type":["Command-line tool","Library"],"version":["1.0.0"],"collections":["BioConductor"],"biotools_curie":"biotools:alpine","credit":[{"email":"michaelisaiahlove@gmail.com","name":"Michael Love","orcidid":"http://orcid.org/0000-0001-8401-0545","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/html/alpine.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Modelling and simulation","uri":"http://edamontology.org/operation_2426"}]}],"name":"alpine","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1038/nbt.3682","metadata":{"abstract":"\u00a9 2016 Nature America, Inc., part of Springer Nature. All rights reserved.We find that current computational methods for estimating transcript abundance from RNA-seq data can lead to hundreds of false-positive results. We show that these systematic errors stem largely from a failure to model fragment GC content bias. Sample-specific biases associated with fragment sequence features lead to misidentification of transcript isoforms. We introduce alpine, a method for estimating sample-specific bias-corrected transcript abundance. By incorporating fragment sequence features, alpine greatly increases the accuracy of transcript abundance estimates, enabling a fourfold reduction in the number of false positives for reported changes in expression compared with Cufflinks. Using simulated data, we also show that alpine retains the ability to discover true positives, similar to other approaches. The method is available as an R/Bioconductor package that includes data visualization tools useful for bias discovery.","authors":[{"name":"Hogenesch J.B."},{"name":"Irizarry R.A."},{"name":"Love M.I."}],"citationCount":53,"date":"2016-12-01T00:00:00Z","journal":"Nature Biotechnology","title":"Modeling of RNA-seq fragment sequence bias reduces systematic errors in transcript abundance estimation"},"pmcid":"PMC5143225","pmid":"27669167","type":["Primary"]}],"topic":[{"term":"RNA-seq","uri":"http://edamontology.org/topic_3170"},{"term":"Systems biology","uri":"http://edamontology.org/topic_2259"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"alpine","home":"https://bio.tools/alpine","license":"GPL-2.0","version":"1.0.0","summary":"Fragment sequence bias modeling and correction for RNA-seq transcript abundance estimation.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:alpine:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":100,"citations":[{"count":1,"year":"2015"},{"count":1,"year":"2016"},{"count":4,"year":"2026"},{"count":8,"year":"2023"},{"count":9,"year":"2017"},{"count":9,"year":"2020"},{"count":10,"year":"2018"},{"count":11,"year":"2019"},{"count":11,"year":"2025"},{"count":12,"year":"2021"},{"count":12,"year":"2022"},{"count":12,"year":"2024"}],"doi":"10.1038/nbt.3682","pmcid":"PMC5143225","pmid":"27669167","ref_count":34,"refs":[{"count":1,"year":"2009"},{"count":1,"year":"2016"},{"count":4,"year":"2013"},{"count":5,"year":"2010"},{"count":5,"year":"2012"},{"count":5,"year":"2015"},{"count":6,"year":"2011"},{