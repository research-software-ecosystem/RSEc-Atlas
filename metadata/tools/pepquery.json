{"tool_name":"pepquery","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"pepquery","identifiers":["doi:10.1101/gr.235028.118"],"license":"GPL-3","summary":"PepQuery is a peptide-centric search engine for novel peptide identification and validation.","home_url":"https://github.com/bzhanglab/PepQuery","keywords":["Genome, Human","Humans","Polymorphism, Genetic","Proteome","Sequence Analysis, DNA","Sequence Analysis, Protein","Proteomics","Genomics"],"manually_check":true,"total_pulls":5},"biotools":{"id":"PepQuery","home":"http://www.pepquery.org/","summary":"Peptide-centric search engine for novel peptide identification and validation.","addition_date":"2019-06-23T14:40:09Z","last_update_date":"2024-11-24T21:09:09.656671Z","tool_type":["Web application"],"accessibility":"Open access","biotools_curie":"biotools:PepQuery","cost":"Free of charge","credit":[{"name":"Gitter","typeRole":["Primary contact"],"url":"https://gitter.im/PepQuery/Lobby"},{"name":"PepQuery Google Group","typeRole":["Primary contact"],"url":"https://groups.google.com/forum/#!forum/pepquery"}],"documentation":[{"type":["General"],"url":"http://www.pepquery.org/document.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Blind peptide database search","uri":"http://edamontology.org/operation_3647"},{"term":"PTM localisation","uri":"http://edamontology.org/operation_3755"},{"term":"Target-Decoy","uri":"http://edamontology.org/operation_3649"}]}],"maturity":"Mature","name":"PepQuery","operating_system":["Linux","Mac","Windows"],"owner":"Ruta","publication":[{"doi":"10.1101/gr.235028.118","metadata":{"abstract":"Massively parallel or second-generation sequencing-based genomic studies continuously identify new genomic alterations that may lead to novel protein sequences, which are attractive candidates for disease biomarkers and therapeutic targets after proteomic validation. Integrative proteogenomic methods have been developed to use mass spectrometry (MS)-based proteomics data for such validation. These methods replace the reference sequence database in proteomic database searching with a customized protein database that incorporates sample- or disease-specific sequences derived from DNA or RNA sequencing, thus enabling the identification of novel protein sequences. Although useful, this spectrum-centric approach requires a full evaluation of all possible spectrum-peptide pairs, which is time-consuming, error-prone, and difficult to apply. Here, we present PepQuery, a peptide-centric approach that focuses on only novel DNA or protein sequences of interest. PepQuery allows quick and easy proteomic validation of genomic alterations without customized database construction. We demonstrated the sensitivity and specificity of the approach in validating completely novel proteins, novel splice junctions, and single amino acid variants using simulations and experimental data. Notably, enabling unrestricted modification searching in PepQuery reduced false positives by up to 95%. We implemented PepQuery as both web-based and stand-alone applications. The web version provides direct access to more than half a billion MS/MS spectra from the Clinical Proteomic Tumor Analysis Consortium (CPTAC) and other cancer proteomic studies. The stand-alone version supports batch analysis and user-provided MS/MS data. PepQuery will increase the usage of proteogenomics beyond the proteomics community and will broaden the application of proteogenomics in personalized medicine.","authors":[{"name":"Wang X."},{"name":"Wen B."},{"name":"Zhang B."}],"citationCount":64,"date":"2019-03-01T00:00:00Z","journal":"Genome Research","title":"PepQuery enables fast, accurate, and convenient proteomic validation of novel genomic alterations"},"pmcid":"PMC6396417","pmid":"30610011","type":["Primary"]}],"topic":[{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}],"validated":1},"bioschemas":{"name":"PepQuery","home":"https://bio.tools/PepQuery","summary":"Peptide-centric search engine for novel peptide identification and validation.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pepquery/web/www.pepquery.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":68,"citations":[{"count":2,"year":"2019"},{"count":4,"year":"2026"},{"count":7,"year":"2025"},{"count":9,"year":"2020"},{"count":10,"year":"2022"},{"count":10,"year":"2024"},{"count":12,"year":"2021"},{"count":14,"year":"2023"}],"doi":"10.1101/gr.235028.118","pmcid":"PMC6396417","pmid":"30610011","ref_count":21,"refs":[{"count":1,"year":"1990"},{"count":1,"year":"2004"},{"count":1,"year":"2006"},{"count":1,"year":"2013"},{"count":1,"year":"2014"},{"count":1,"year":"2019"},{"count":2,"year":"2011"},{"count":2,"year":"2012"},{"count":2,"year":"2017"},{"count":3,"year":"2007"},{"count":3,"year":"2015"},{"count":3,"year":"2016"}],"title":"PepQuery enables fast, accurate, and convenient proteomic validation of novel genomic alterations.","year":2019}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":200,"ssl":null,"ssl_err":null}},"support":{"issue_tracking":{}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:pepquery:1.2.0/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":true,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public"