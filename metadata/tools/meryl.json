{"tool_name":"meryl","contents":["biocontainers","galaxy","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"meryl","version":"1.4.2","home":"https://github.com/marbl/meryl","documentation":"https://github.com/marbl/meryl","license":"Public Domain","summary":"meryl is a multi-threaded, multi-process, out-of-core k-mer counter","identifiers":["biotools:meryl","usegalaxy-eu:meryl","doi:10.1186/s13059-020-02134-9"],"build":{"number":0,"run_exports":[null]},"requirements":{"build":[null,null,"make"],"host":["llvm-openmp","libgomp","zlib","bzip2","xz","libcurl","openssl"]},"source_url":"https://github.com/marbl/meryl/releases/download/v1.4.2/meryl-1.4.2.tar.xz","test":{"commands":["meryl 2>&1 | grep \"usage: meryl\"","meryl-analyze 2>&1 | grep \"usage: meryl-analyze\"","meryl-import 2>&1 | grep \"usage: meryl-import\"","meryl-lookup 2>&1 | grep \"usage: meryl-lookup\"","meryl-simple 2>&1 | grep \"usage: meryl-simple\""]}},"biocontainers":{"name":"meryl","identifiers":[],"license":"GPL-2+","summary":"In- and out-of-core kmer counting and utilities","home_url":"http://kmer.sourceforge.net","keywords":[],"manually_check":true,"total_pulls":0},"biotools":{"id":"meryl","home":"https://github.com/marbl/meryl","license":"Freeware","summary":"Meryl is a tool for counting and working with sets of k-mers that was originally developed for use in the Celera Assembler and has since been migrated and maintained as part of Canu.","addition_date":"2022-07-26T11:42:13.104607Z","last_update_date":"2024-11-24T14:36:28.305612Z","tool_type":["Command-line tool"],"version":["1.3"],"biotools_curie":"biotools:meryl","cost":"Free of charge","edit_permission":{"type":"public"},"function":[{"input":[{"data":{"term":"Sequence trace","uri":"http://edamontology.org/data_0924"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"},{"term":"FASTQ","uri":"http://edamontology.org/format_1930"}]}],"operation":[{"term":"k-mer counting","uri":"http://edamontology.org/operation_3472"}],"output":[{"data":{"term":"Count matrix","uri":"http://edamontology.org/data_3917"},"format":[{"term":"K-mer countgraph","uri":"http://edamontology.org/format_3665"}]}]}],"maturity":"Mature","name":"Meryl","owner":"alexcorm","publication":[{"doi":"10.1186/s13059-020-02134-9","metadata":{"abstract":"Recent long-read assemblies often exceed the quality and completeness of available reference genomes, making validation challenging. Here we present Merqury, a novel tool for reference-free assembly evaluation based on efficient k-mer set operations. By comparing k-mers in a de novo assembly to those found in unassembled high-accuracy reads, Merqury estimates base-level accuracy and completeness. For trios, Merqury can also evaluate haplotype-specific accuracy, completeness, phase block continuity, and switch errors. Multiple visualizations, such as k-mer spectrum plots, can be generated for evaluation. We demonstrate on both human and plant genomes that Merqury is a fast and robust method for assembly validation.","authors":[{"name":"Koren S."},{"name":"Phillippy A.M."},{"name":"Rhie A."},{"name":"Walenz B.P."}],"citationCount":1013,"date":"2020-09-14T00:00:00Z","journal":"Genome Biology","title":"Merqury: Reference-free quality, completeness, and phasing assessment for genome assemblies"},"pmcid":"PMC7488777","pmid":"32928274"}],"topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"},{"term":"Whole genome sequencing","uri":"http://edamontology.org/topic_3673"}]},"bioschemas":{"name":"Meryl","home":"https://bio.tools/meryl","license":"Freeware","version":"1.3","summary":"Meryl is a tool for counting and working with sets of k-mers that was originally developed for use in the Celera Assembler and has since been migrated and maintained as part of Canu.","tool_type":"sc:SoftwareApplication"},"galax