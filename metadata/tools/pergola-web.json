{"tool_name":"pergola-web","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"Pergola-web","home":"http://pergola.crg.eu/","license":"GPL-3.0","summary":"Web server for the visualization and analysis of longitudinal behavioral data using repurposed genomics tools and standards.","addition_date":"2019-08-09T13:12:25Z","last_update_date":"2020-06-16T10:55:26Z","tool_type":["Web application","Web service"],"accessibility":"Open access","biotools_curie":"biotools:Pergola-web","cost":"Free of charge","credit":[{"email":"cedric.notredame@crg.es","name":"Cedric Notredame","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"julia.ponomarenko@crg.eu","name":"Julia Ponomarenko","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://pergola.crg.eu/help"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Formatting","uri":"http://edamontology.org/operation_0335"},{"term":"Splitting","uri":"http://edamontology.org/operation_3359"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"maturity":"Mature","name":"Pergola-web","operating_system":["Linux","Mac","Windows"],"owner":"hans","publication":[{"doi":"10.1093/NAR/GKZ414","metadata":{"abstract":"\u00a9 2019 The Author(s).We present a new web application to query and visualize time-series behavioral data: the Pergola web-server. This server provides a user-friendly interface for exploring longitudinal behavioral data taking advantage of the Pergola Python library. Using the server, users can process the data applying some basic operations, such as binning or grouping, while formatting the data into existing genomic formats. Thanks to this repurposing of genomics standards, the application automatically renders an interactive data visualization based on sophisticated genome visualization tools. Our tool allows behavioral scientists to share, display and navigate complex behavioral data comprising multiple individuals and multiple data types, in a scalable and flexible manner. A download option allows for further analysis using genomic tools. The server can be a great resource for the field in a time where behavioral science is entering a data-intensive cycle thanks to high-throughput behavioral phenotyping platforms. Pergola is publicly available at http://pergola.crg.eu/.","authors":[{"name":"Dierssen M."},{"name":"Erb I."},{"name":"Espinosa-Carrasco J."},{"name":"Notredame C."},{"name":"Ponomarenko J."},{"name":"Pulido T.H."}],"citationCount":1,"date":"2019-07-01T00:00:00Z","journal":"Nucleic Acids Research","title":"Pergola-web: a web server for the visualization and analysis of longitudinal behavioral data using repurposed genomics tools and standards"},"pmcid":"PMC6602478","pmid":"31106365","type":["Primary"]}],"topic":[{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"}],"validated":1},"bioschemas":{"name":"Pergola-web","home":"https://bio.tools/Pergola-web","license":"GPL-3.0","summary":"Web server for the visualization and analysis of longitudinal behavioral data using repurposed genomics tools and standards.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pergola-web/soap/pergola.crg.eu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":2,"citations":[{"count":1,"year":"2019"},{"count":1,"year":"2026"}],"doi":"10.1093/nar/gkz414","pmcid":"PMC6602478","pmid":"31106365","ref_count":20,"refs":[{"count":1,"