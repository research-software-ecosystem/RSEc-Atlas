{"tool_name":"presrat","contents":["biotools","oeb"],"identifiers":["biotools:presrat"],"fetched_metadata":{"biotools":{"id":"presrat","home":"http://www.hpppi.iicb.res.in/presrat","summary":"A server for identification of bacterial small-RNA sequences and their targets with probable binding region.\n\nPredicting small RNAs and their Targets.\n\nHere, we present a webserver, PresRAT which aims to identify novel sRNA and its target genes.\n\nPresRAT aims to predict potential bacterial sRNA and the potential target of that sRNA against a bacterial genome containing mRNA sequences. With an added advantage PresRAT can build and perform molecular dynamics simulation on 3D models these sRNA and sRNA-mRNA bound duplex regions.\n\nBacterial small-RNAs (sRNA) are RNAs of varied length (40 to 500 nucleotide long) mostly encoded in the intergenic regions of bacterial chromosomes. Most sRNAs act as regulatory elements by base pairing with the 5' untranslated region of mRNA transcripts.These sRNAs play important roles in gene regulation by modifying the stability and expression of the target transcript.","addition_date":"2021-01-18T08:32:42Z","last_update_date":"2026-11-12T14:24:58.242043Z","biotools_curie":"biotools:presrat","credit":[{"email":"saikat273@gmail.com","typeEntity":"Person"},{"email":"saikat@iicb.res.in","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Molecular dynamics","uri":"http://edamontology.org/operation_2476"},{"term":"RNA secondary structure analysis","uri":"http://edamontology.org/operation_2439"},{"term":"cis-regulatory element prediction","uri":"http://edamontology.org/operation_0441"},{"term":"trans-regulatory element prediction","uri":"http://edamontology.org/operation_0443"}]}],"name":"PresRAT","owner":"zsmag19","publication":[{"doi":"10.1080/15476286.2020.1836455","type":["Primary"]},{"doi":"10.1101/2020.04.03.024935","type":["Preprint"]}],"topic":[{"term":"DNA binding sites","uri":"http://edamontology.org/topic_3125"},{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:presrat/undefined/www.hpppi.iicb.res.in","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1101/2020.04.03.024935","pmcid":null,"pmid":null,"ref_count":0,"refs":[],"title":null,"year":null}]},{"entries":[{"cit_count":9,"citations":[{"count":1,"year":2022},{"count":1,"year":2025},{"count":2,"year":2023},{"count":5,"year":2024}],"doi":"10.1080/15476286.2020.1836455","pmcid":"PMC8244778","pmid":"33103602","ref_count":55,"refs":[{"count":1,"year":-1},{"count":1,"year":2003},{"count":1,"year":2004},{"count":1,"year":2014},{"count":1,"year":2018},{"count":1,"year":2019},{"count":2,"year":2001},{"count":2,"year":2007},{"count":4,"year":2005},{"count":4,"year":2012},{"count":5,"year":2008},{"count":5,"year":2010},{"count":6,"year":2006},{"count":6,"year":2009},{"count":7,"year":2011},{"count":8,"year":2013}],"title":"PresRAT: a server for identification of bacterial small-RNA sequences and their targets with probable binding region.","year":2020}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":200,"redirects":[{"status":301,"url":"http://www.hpppi.iicb.res.in/presrat/"}],"ssl":null,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/presrat","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"b