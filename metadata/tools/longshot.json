{"tool_name":"longshot","contents":["biocontainers","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"longshot","version":"1.0.0","home":"https://github.com/pjedge/longshot","documentation":"https://github.com/pjedge/longshot/blob/v(( version }}/README.md","license":"MIT","summary":"Diploid SNV caller for error-prone reads.","identifiers":["doi:10.1038/s41467-019-12493-y","biotools:longshot"],"license_file":"LICENSE","build":{"number":3,"run_exports":[null]},"requirements":{"build":[null,null,null,"pkg-config","clangdev","cmake","make"],"host":["zlib","xz","clangdev"]},"source_url":"https://github.com/pjedge/longshot/archive/v1.0.0.tar.gz","test":{"commands":["longshot --help","longshot --version"]}},"biocontainers":{"name":"longshot","identifiers":["doi:10.1101/564443"],"license":"MIT","summary":"Longshot is a variant calling tool for diploid genomes using long error prone reads such as Pacific Biosciences (PacBio) SMRT and Oxford Nanopore Technologies (ONT)","home_url":"https://github.com/pjedge/longshot","keywords":[],"manually_check":true,"total_pulls":7},"biotools":{"id":"longshot","home":"https://github.com/pjedge/longshot","license":"MIT","summary":"Longshot is a variant calling tool for diploid genomes using long error prone reads such as Pacific Biosciences (PacBio) SMRT and Oxford Nanopore Technologies (ONT). It takes as input an aligned BAM file and outputs a phased VCF file with variants and haplotype information. It can also genotype and phase input VCF files. It can output haplotype-separated BAM files that can be used for downstream analysis. Currently, it only calls single nucleotide variants (SNVs), but it can genotype indels if they are given in an input VCF.","addition_date":"2022-03-21T12:36:31.306716Z","last_update_date":"2024-11-24T20:10:49.447193Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:longshot","cost":"Free of charge","credit":[{"email":"vibansal@ucsd.edu","name":"Vikas Bansal","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["Installation instructions"],"url":"https://bioconda.github.io/recipes/longshot/README.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"}]}],"name":"Longshot","owner":"Kigaard","publication":[{"doi":"10.1038/s41467-019-12493-y","metadata":{"abstract":"Whole-genome sequencing using sequencing technologies such as Illumina enables the accurate detection of small-scale variants but provides limited information about haplotypes and variants in repetitive regions of the human genome. Single-molecule sequencing (SMS) technologies such as Pacific Biosciences and Oxford Nanopore generate long reads that can potentially address the limitations of short-read sequencing. However, the high error rate of SMS reads makes it challenging to detect small-scale variants in diploid genomes. We introduce a variant calling method, Longshot, which leverages the haplotype information present in SMS reads to accurately detect and phase single-nucleotide variants (SNVs) in diploid genomes. We demonstrate that Longshot achieves very high accuracy for SNV detection using whole-genome Pacific Biosciences data, outperforms existing variant calling methods, and enables variant detection in duplicated regions of the genome that cannot be mapped using short reads.","authors":[{"name":"Bansal V."},{"name":"Edge P."}],"citationCount":132,"date":"2019-12-01T00:00:00Z","journal":"Nature Communications","title":"Longshot enables accurate variant calling in diploid genomes from single-molecule long read sequencing"},"pmcid":"PMC6788989","pmid":"31604920","type":["Primary"]}],"topic":[{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"}]},"bioschemas":{"name":"Longshot","home":"https://bio.tools/longshot","license":"MIT","summary":"Longshot is a variant calling tool for diploid genomes using long error prone reads such as Pacific Biosciences (PacBio) SMRT and Oxford Nanopore Technologies (ONT). It takes as input an aligned BAM file and outputs a phased VCF file with variants and haplotype information. It can also genotype and phase input VCF files. It can output haplotype-separated BAM files that can be used for downstream analysis. Currently, it only calls single nucleotide variants (SNVs), but it can genotype indels if they are given in an input VCF.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:longshot/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":158,"citations":[{"count":11,"year":"2020"},{"count":16,"year":"2026"},{"count":22,"year":"2021"},{"count":24,"year":"2023"},{"count":26,"year":"2022"},{"count":27,"year":"2025"},{"count":32,"year":"2024"}],"doi":"10.1038/s41467-019-12493-y","pmcid":"PMC6788989","pmid":"31604920","ref_count":50,"refs":[{"count":1,"year":"2007"},{"count":1,"year":"2008"},{"count":1,"year":"2013"},{"count":2,"year":"2009"},{"count":2,"year":"2010"},{"count":3,"year":"2011"},{"count":3,"year":"2012"},{"count":3,"year":"2017"},{"count":6,"year":"2014"},{"count":6,"year":"2015"},{"count":6,"year":"2019"},{"count":7,"year":"2016"},{"count":9,"year":"2018"}],"title":"Longshot enables accurate variant calling in diploid genomes from single-molecule long read sequencing.","year":2019}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl