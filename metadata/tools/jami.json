{"tool_name":"jami","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"jami","home":"https://github.com/SchulzLab/JAMI","summary":"Fast computation of conditional mutual information for ceRNA network analysis.","addition_date":"2018-06-02T07:23:31Z","last_update_date":"2024-11-25T14:36:57.112060Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:jami","credit":[{"email":"mlist@mpi-inf.mpg.de","name":"Markus List","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"mschulz@mmci.uni-saarland.de","name":"Marcel H Schulz","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://jami.readthedocs.io/en/latest/index.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Pathway or network analysis","uri":"http://edamontology.org/operation_2497"}]}],"name":"JAMI","operating_system":["Linux","Mac"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1093/bioinformatics/bty221","metadata":{"abstract":"Motivation: Genome-wide measurements of paired miRNA and gene expression data have enabled the prediction of competing endogenous RNAs (ceRNAs). It has been shown that the sponge effect mediated by protein-coding as well as non-coding ceRNAs can play an important regulatory role in the cell in health and disease. Therefore, many computational methods for the computational identification of ceRNAs have been suggested. In particular, methods based on Conditional Mutual Information (CMI) have shown promising results. However, the currently available implementation is slow and cannot be used to perform computations on a large scale. Results: Here, we present JAMI, a Java tool that uses a non-parametric estimator for CMI values from gene and miRNA expression data. We show that JAMI speeds up the computation of ceRNA networks by a factor of \u223c70 compared to currently available implementations. Further, JAMI supports multi-threading to make use of common multi-core architectures for further performance gain.","authors":[{"name":"Hornakova A."},{"name":"List M."},{"name":"Schulz M.H."},{"name":"Vreeken J."}],"citationCount":11,"date":"2018-09-01T00:00:00Z","journal":"Bioinformatics","title":"JAMI: fast computation of conditional mutual information for ceRNA network analysis"},"pmcid":"PMC6129307","pmid":"29659721"}],"topic":[{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"}],"validated":1},"bioschemas":{"name":"JAMI","home":"https://bio.tools/jami","summary":"Fast computation of conditional mutual information for ceRNA network analysis.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:jami/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"publications":[{"entries":[{"cit_count":10,"citations":[{"count":1,"year":"2020"},{"count":1,"year":"2023"},{"count":1,"year":"2025"},{"count":2,"year":"2021"},{"count":2,"year":"2022"},{"count":3,"year":"2019"}],"doi":"10.1093/bioinformatics/bty221","pmcid":"PMC6129307","pmid":"29659721","ref_count":17,"refs":[{"count":1,"year":"2003"},{"count":1,"year":"2012"},{"count":1,"year":"2013"},{"count":1,"year":"2015"},{"count":2,"year":"2008"},{"count":2,"year":"2011"},{"count":3,"year":"2010"},{"count":3,"year":"2014"},{"count":3,"year":"2017"}],"title":"JAMI: fast computation of conditional mutual information for ceRNA network a