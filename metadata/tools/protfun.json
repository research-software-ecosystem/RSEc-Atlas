{"tool_name":"protfun","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"protfun","home":"http://cbs.dtu.dk/services/ProtFun/","license":"Other","summary":"Prediction of cellular role, enzyme class and Gene Ontology category.","addition_date":"2015-06-29T10:21:37Z","last_update_date":"2018-12-14T10:06:19Z","tool_type":["Web application","Web service"],"version":["2.2"],"biotools_curie":"biotools:protfun","cost":"Free of charge (with restrictions)","credit":[{"email":"lars.juhl.jensen@cpr.ku.dk","name":"Lars Juhl Jensen"},{"name":"CBS","typeEntity":"Institute","typeRole":["Provider"]},{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.bioinformatics.dtu.dk/english/Service/Contact"}],"documentation":[{"type":["General"],"url":"http://www.cbs.dtu.dk/services/ProtFun/instructions.php"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Sequence","uri":"http://edamontology.org/data_2044"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}],"note":"ab initio predictions of enzyme class (if any) from sequence","operation":[{"term":"Protein function prediction","uri":"http://edamontology.org/operation_1777"}],"output":[{"data":{"term":"Protein features","uri":"http://edamontology.org/data_1277"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}]}],"maturity":"Emerging","name":"ProtFun","operating_system":["Linux","Mac","Windows"],"owner":"CBS","publication":[{"doi":"10.1016/S0022-2836(02)00379-0","metadata":{"abstract":"We have developed an entirely sequence-based method that identifies and integrates relevant features that can be used to assign proteins of unknown function to functional classes and enzyme categories for enzymes. We show that strategies for the elucidation of protein function may benefit from a number of functional attributes that are more directly related to the linear sequence of amino acids and hence easier to predict than protein structure. These attributes include features associated with post-translational modifications and protein sorting but also much simpler aspects such as the length isoelectric point and composition of the polypeptide chain. \u00a9 2002 Elsevier Science Ltd. All rights reserved.","authors":[{"name":"Andersen C.A.F."},{"name":"Blom N."},{"name":"Brunak S."},{"name":"Devos D."},{"name":"Gupta R."},{"name":"Jensen L.J."},{"name":"Kesmir C."},{"name":"Knudsen S."},{"name":"Krogh A."},{"name":"Nielsen H."},{"name":"Rapacki K."},{"name":"Staerfeldt H.H."},{"name":"Tamames J."},{"name":"Valencia A."},{"name":"Workman C."}],"citationCount":260,"date":"2002-01-01T00:00:00Z","journal":"Journal of Molecular Biology","title":"Prediction of human protein function from post-translational modifications and localization features"},"pmid":"12079362","type":["Primary"]}],"topic":[{"term":"Protein sites, features and motifs","uri":"http://edamontology.org/topic_3510"}],"validated":1},"bioschemas":{"name":"ProtFun","home":"https://bio.tools/protfun","license":"Other","version":"2.2","summary":"Prediction of cellular role, enzyme class and Gene Ontology category.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:protfun:2.2/soap/cbs.dtu.dk","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":83,"citations":[{"count":1,"year":"2002"},{"count":1,"year":"2021"},{"count":1,"year":"2022"},{"count":1,"year":"2023"},{"count":2,"year":"2004"},{"count":2,"year":"2014"},{"count":3,"year":"2006"},{"count":3,"year":"2017"},{"count":3,"year":"2019"},{"count":3,"year":"2020"},{"count":3,"year":"2025"},{"count":4,"year":"2003"},{"count":4,"year":"2010"},{"count":4,"year":"2011"},{"count":5,"year":"2005"},{"count":5,"ye