{"tool_name":"snprelate","contents":["oeb","bioschemas","biotools","bioconda"],"fetched_metadata":{"bioconda":{"name":"bioconductor-snprelate","version":"1.44.0","home":"https://bioconductor.org/packages/3.22/bioc/html/SNPRelate.html","license":"GPL-3","summary":"Parallel Computing Toolset for Relatedness and Principal Component Analysis of SNP Data","identifiers":["biotools:snprelate"],"description":"Genome-wide association studies (GWAS) are widely used to investigate the genetic basis of diseases and traits, but they pose many computational challenges. We developed an R package SNPRelate to provide a binary format for single-nucleotide polymorphism (SNP) data in GWAS utilizing CoreArray Genomic Data Structure (GDS) data files. The GDS format offers the efficient operations specifically designed for integers with two bits, since a SNP could occupy only two bits. SNPRelate is also designed to accelerate two key computations on SNP data using parallel computing for multi-core symmetric multiprocessing computer architectures: Principal Component Analysis (PCA) and relatedness analysis using Identity-By-Descent measures. The SNP GDS format is also used by the GWASTools package with the support of S4 classes and generic functions. The extended GDS format is implemented in the SeqArray package to support the storage of single nucleotide variations (SNVs), insertion/deletion polymorphism (indel) and structural variation calls in whole-genome and whole-exome variant data.","license_file":"/lib/R/share/licenses/GPL-3","build":{"number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"build":[null,null,"make"],"host":["bioconductor-gdsfmt >=1.46.0,<1.47.0","r-base","r-rhpcblasctl","libblas","liblapack","zlib","liblzma-devel"],"run":["bioconductor-gdsfmt >=1.46.0,<1.47.0","r-base","r-rhpcblasctl"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/SNPRelate_1.44.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SNPRelate/SNPRelate_1.44.0.tar.gz","https://bioarchive.galaxyproject.org/SNPRelate_1.44.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-snprelate/bioconductor-snprelate_1.44.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('SNPRelate')\""]},"parent_recipe":{"name":"bioconductor-snprelate","path":"recipes/bioconductor-snprelate","version":"1.14.0"}},"biotools":{"id":"snprelate","home":"https://bioconductor.org/packages/SAIGEgds","license":"GPL-3.0","summary":"Scalable implementation of generalized mixed models with highly optimized C++ implementation and integration with Genomic Data Structure (GDS) files. It is designed for single variant tests and set-based aggregate tests in large-scale Phenome-wide Association Studies (PheWAS) with millions of variants and samples, controlling for sample structure and case-control imbalance. The implementation is based on the SAIGE R package (v0.45, Zhou et al. 2018 and Zhou et al. 2020), and it is extended to include the state-of-the-art ACAT-O set-based tests. Benchmarks show that SAIGEgds is significantly faster than the SAIGE R package. Optional OpenCL-based GPU acceleration is supported for the GRM cross-product computation in null model fitting and for GRM construction.","addition_date":"2017-01-17T15:03:54Z","last_update_date":"2026-09-13T07:36:45.759489Z","tool_type":["Command-line tool","Library"],"version":["2.12.0"],"collections":["BioConductor"],"biotools_curie":"biotools:snprelate","credit":[{"name":"J. Wade Davis","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Wei Zhou","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Xiuwen Zheng","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/SAIGEgds"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genetic variation analysis","uri":"http://edamontology.org/operation_3197"},{"term":"Statistical calculation","uri":"http://edamontology.org/operation_2238"}]}],"name":"SNPRelate","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1038/s41588-018-0184-y"},{"doi":"10.1093/bioinformatics/btaa731"},{"doi":"10.1093/bioinformatics/btx145"}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"GWAS study","uri":"http://edamontology.org/topic_3517"},{"term":"Genetics","uri":"http://edamontology.org/topic_3053"}],"validated":1},"bioschemas":{"name":"SNPRelate","home":"https://bio.tools/snprelate","license":"LGPL-3.0-only","version":"1.48.2","summary":"Provides a high-level R interface to CoreArray Genomic Data Structure (GDS) data files. GDS is portable across platforms with hierarchical structure to store multiple scalable array-oriented data sets with metadata information. It is suited for large-scale datasets, especially for data which are much larger than the available random-access memory. The gdsfmt package offers the efficient operations specifically designed for integers of less than 8 bits, since a diploid genotype, like single-nucleotide polymorphism (SNP), usually occupies fewer bits than a byte. Data compression and decompression are available with relatively efficient random access. It is also allowed to read a GDS file in parallel with multiple R processes supported by the package parallel.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:snprelate:1.8.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":1360,"citations":[{"count":1,"year":2012},{"count":2,"year":-1},{"count":3,"year":2013},{"count":17,"year":2014},{"count":23,"year":2015},{