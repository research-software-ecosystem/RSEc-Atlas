{"tool_name":"aquila","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"aquila","identifiers":["doi:10.1101/660605"],"license":"MIT","summary":"Diploid personal genome assembly and comprehensive variant detection based on linked-reads","home_url":"https://github.com/maiziex/Aquila","keywords":["Genomics"],"manually_check":true,"total_pulls":0},"biotools":{"id":"aquila","home":"https://aquila.cheunglab.org/","license":"Other","summary":"A spatial omics database and analysis platform.","addition_date":"2022-12-20T09:10:27.698984Z","last_update_date":"2024-11-24T15:17:16.115287Z","tool_type":["Database portal","Web application"],"biotools_curie":"biotools:aquila","cost":"Free of charge","credit":[{"email":"echeung@um.edu.mo","name":"Edwin Cheung","typeEntity":"Person"}],"documentation":[{"type":["General"],"url":"https://aquila.cheunglab.org/about"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Gene expression profiling","uri":"http://edamontology.org/operation_0314"},{"term":"Protein architecture analysis","uri":"http://edamontology.org/operation_0247"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"Aquila","operating_system":["Linux","Mac","Windows"],"owner":"Chan019","publication":[{"doi":"10.1093/nar/gkac874","metadata":{"abstract":"Spatial omics is a rapidly evolving approach for exploring tissue microenvironment and cellular networks by integrating spatial knowledge with transcript or protein expression information. However, there is a lack of databases for users to access and analyze spatial omics data. To address this limitation, we developed Aquila, a comprehensive platform for managing and analyzing spatial omics data. Aquila contains 107 datasets from 30 diseases, including 6500+ regions of interest, and 15.7 million cells. The database covers studies from spatial transcriptome and proteome analyses, 2D and 3D experiments, and different technologies. Aquila provides visualization of spatial omics data in multiple formats such as spatial cell distribution, spatial expression and co-localization of markers. Aquila also lets users perform many basic and advanced spatial analyses on any dataset. In addition, users can submit their own spatial omics data for visualization and analysis in a safe and secure environment. Finally, Aquila can be installed as an individual app on a desktop and offers the RESTful API service for power users to access the database. Overall, Aquila provides a detailed insight into transcript and protein expression in tissues from a spatial perspective. Aquila is available at https://aquila.cheunglab.org.","authors":[{"name":"Chen Y."},{"name":"Cheung E."},{"name":"Ding X."},{"name":"Wong K.H."},{"name":"Zheng Y."}],"citationCount":12,"date":"2023-01-06T00:00:00Z","journal":"Nucleic Acids Research","title":"Aquila: a spatial omics database and analysis platform"},"pmcid":"PMC9825501","pmid":"36243967"}],"topic":[{"term":"Data security","uri":"http://edamontology.org/topic_3263"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"Aquila","home":"https://bio.tools/aquila","license":"Other","summary":"A spatial omics database and analysis platform.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:aquila/db/aquila.cheunglab.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":23,"citations":[{"count":1,"year":"2023"},{"count":6,"year":"2025"},