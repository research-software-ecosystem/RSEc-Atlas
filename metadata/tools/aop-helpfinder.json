{"tool_name":"aop-helpfinder","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"aop-helpfinder","home":"http://aop-helpfinder.u-paris-sciences.fr/index.php","license":"CECILL-2.1","summary":"AOP-helpFinder is a web tool for identification and extraction of associations between stressors and biological events at various level of the biological organization (molecular initiating event (MIE), key event (KE), and adverse outcome (AO)). AOP-helpFinder is a hybrid tool, combining text mining and graph theory. Currently, AOP-helpFinder screens all the >30 millions of abstracts available from the PubMed database, to decipher co-mentioned terms (e.g. a stressor and a MIE).","addition_date":"2022-03-28T08:47:29.917259Z","last_update_date":"2022-03-28T08:47:52.908685Z","tool_type":["Web application"],"biotools_curie":"biotools:aop-helpfinder","credit":[{"email":"karine.audouze@u-paris.fr","name":"Karine Audouze","orcidid":"https://orcid.org/0000-0001-7525-4089","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Literature search","uri":"http://edamontology.org/operation_0305"},{"term":"Parsing","uri":"http://edamontology.org/operation_1812"},{"term":"Text mining","uri":"http://edamontology.org/operation_0306"}]}],"name":"AOP-helpFinder","operating_system":["Linux","Mac","Windows"],"owner":"Kigaard","publication":[{"doi":"10.1093/BIOINFORMATICS/BTAB750","pmcid":"PMC8796376","pmid":"34718414","type":["Primary"]}],"topic":[{"term":"Endocrinology and metabolism","uri":"http://edamontology.org/topic_3407"},{"term":"Literature and language","uri":"http://edamontology.org/topic_3068"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Toxicology","uri":"http://edamontology.org/topic_2840"}]},"bioschemas":{"name":"AOP-helpFinder","home":"https://bio.too