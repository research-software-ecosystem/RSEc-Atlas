{"tool_name":"lobstahs","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-lobstahs","version":"1.36.0","home":"https://bioconductor.org/packages/3.22/bioc/html/LOBSTAHS.html","license":"GPL (>= 3) + file LICENSE","summary":"Lipid and Oxylipin Biomarker Screening through Adduct Hierarchy Sequences","identifiers":["biotools:lobstahs"],"description":"LOBSTAHS is a multifunction package for screening, annotation, and putative identification of mass spectral features in large, HPLC-MS lipid datasets. In silico data for a wide range of lipids, oxidized lipids, and oxylipins can be generated from user-supplied structural criteria with a database generation function. LOBSTAHS then applies these databases to assign putative compound identities to features in any high-mass accuracy dataset that has been processed using xcms and CAMERA. Users can then apply a series of orthogonal screening criteria based on adduct ion formation patterns, chromatographic retention time, and other properties, to evaluate and assign confidence scores to this list of preliminary assignments. During the screening routine, LOBSTAHS rejects assignments that do not meet the specified criteria, identifies potential isomers and isobars, and assigns a variety of annotation codes to assist the user in evaluating the accuracy of each assignment.","license_file":"LICENSE","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-camera >=1.66.0,<1.67.0","bioconductor-xcms >=4.8.0,<4.9.0","r-base"],"run":["bioconductor-camera >=1.66.0,<1.67.0","bioconductor-xcms >=4.8.0,<4.9.0","r-base"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/LOBSTAHS_1.36.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/LOBSTAHS/LOBSTAHS_1.36.0.tar.gz","https://bioarchive.galaxyproject.org/LOBSTAHS_1.36.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-lobstahs/bioconductor-lobstahs_1.36.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('LOBSTAHS')\""]},"parent_recipe":{"name":"bioconductor-lobstahs","path":"recipes/bioconductor-lobstahs","version":"1.8.0"}},"biotools":{"id":"lobstahs","home":"https://bioconductor.org/packages/LOBSTAHS","license":"GPL-3.0-or-later","summary":"LOBSTAHS is a multifunction package for screening, annotation, and putative identification of mass spectral features in large, HPLC-MS lipid datasets. In silico data for a wide range of lipids, oxidized lipids, and oxylipins can be generated from user-supplied structural criteria with a database generation function. LOBSTAHS then applies these databases to assign putative compound identities to features in any high-mass accuracy dataset that has been processed using xcms and CAMERA. Users can then apply a series of orthogonal screening criteria based on adduct ion formation patterns, chromatographic retention time, and other properties, to evaluate and assign confidence scores to this list of preliminary assignments. During the screening routine, LOBSTAHS rejects assignments that do not meet the specified criteria, identifies potential isomers and isobars, and assigns a variety of annotation codes to assist the user in evaluating the accuracy of each assignment.","addition_date":"2017-01-17T15:01:29Z","last_update_date":"2026-08-30T02:21:13.720529Z","tool_type":["Command-line tool","Library"],"version":["1.38.0"],"collections":["BioConductor"],"biotools_curie":"biotools:lobstahs","credit":[{"name":"Benjamin Van Mooy","typeEntity":"Person","typeRole":["Developer"]},{"name":"Bethanie Edwards","typeEntity":"Person","typeRole":["Developer"]},{"name":"Daniel Lowenstein","typeEntity":"Person","typeRole":["Developer"]},{"name":"Helen Fredricks","typeEntity":"Person","typeRole":["Developer"]},{"name":"Henry Holm","typeEntity":"Person","typeRole":["Developer"]},{"name":"James Collins","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/LOBSTAHS"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"operation":[{"term":"Annotation","uri":"http://edamontology.org/operation_0226"},{"term":"Spectral analysis","uri":"http://edamontology.org/operation_3214"}]}],"name":"LOBSTAHS","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1021/acs.analchem.6b01260"},{"doi":"10.18129/B9.bioc.LOBSTAHS"}],"topic":[{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}],"validated":1},"bioschemas":{"name":"LOBSTAHS","home":"https://bio.tools/lobstahs","license":"GPL-3.0-or-later","version":"1.38.0","summary":"LOBSTAHS is a multifunction package for screening, annotation, and putative identification of mass spectral features in large, HPLC-MS lipid datasets. In silico data for a wide range of lipids, oxidized lipids, and oxylipins can be generated from user-supplied structural criteria with a database generation function. LOBSTAHS then applies these databases to assign putative compound identities to features in any high-mass accuracy dataset that has been processed using xcms and CAMERA. Users can then apply a series of orthogonal screening criteria based on adduct ion formation patterns, chromatographic retention time, and other properties, to evaluate and assign confidence scores to this list of preliminary assignments. During the screening routine, LOBSTAHS rejects assignments that do not meet the specified criteria, identifies potential isomers and isobars, and assigns a variety of annotation codes to assist the user in evaluating the accuracy of each assignment.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:lobstahs:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/b