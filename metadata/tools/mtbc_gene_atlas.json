{"tool_name":"mtbc_gene_atlas","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"mtbc_gene_atlas","home":"https://mtbc.gclab.fr","license":"CC-BY-4.0","summary":"Continuously updated functional re-annotation of the Mycobacterium tuberculosis complex gene set, anchored on the MTBC0 ancestral genome rather than on a single strain. Serves one record per gene combining Pfam domains, ESMFold structures with Foldseek search, protein language-model features, orthology, curated knowledge, protein association networks and intra-species selection inferred from 145209 sequenced genomes, with dated sources and a graded confidence level for every field. Intended as a successor to Mycobrowser, which is no longer maintained.","addition_date":"2026-08-12T08:26:48.264972Z","last_update_date":"2026-08-12T08:26:48.267500Z","tool_type":["Database portal","Web API","Web application"],"version":["1"],"collections":["Mycobacterium tuberculosis complex"],"accessibility":"Open access","biotools_curie":"biotools:mtbc_gene_atlas","cost":"Free of charge","credit":[{"email":"guyeux@gmail.com","name":"Christophe Guyeux","note":"FEMTO-ST Institute (CNRS UMR 6174), Universite Marie et Louis Pasteur, Besancon, France.","orcidid":"https://orcid.org/0000-0003-0195-4378","typeEntity":"Person","typeRole":["Developer","Maintainer","Primary contact"]},{"name":"FEMTO-ST Institute, CNRS UMR 6174","typeEntity":"Institute","typeRole":["Provider"],"url":"https://www.femto-st.fr"}],"documentation":[{"note":"Scope, evidence layers, citation and coordinate-system conventions.","type":["General"],"url":"https://mtbc.gclab.fr/about"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Gene ID","uri":"http://edamontology.org/data_2295"}},{"data":{"term":"Gene symbol","uri":"http://edamontology.org/data_1026"}}],"note":"Query by H37Rv locus tag (Rv1908c) or gene name (katG); every field carries its provenance and confidence.","operation":[{"term":"Data retrieval","uri":"htt