{"tool_name":"bioconductor-proteomm","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-proteomm","identifiers":["doi:10.18129/b9.bioc.proteomm"],"license":"MIT","summary":"Multi-dataset model-based differential expression proteomics analysis platform","home_url":"https://bioconductor.org/packages/3.11/bioc/html/ProteoMM.html","keywords":["Proteomics"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-proteomm","home":"https://bioconductor.org/packages/ProteoMM","license":"MIT","summary":"ProteoMM is a statistical method to perform model-based peptide-level differential expression analysis of single or multiple datasets. For multiple datasets ProteoMM produces a single fold change and p-value for each protein across multiple datasets. ProteoMM provides functionality for normalization, missing value imputation and differential expression. Model-based peptide-level imputation and differential expression analysis component of package follows the analysis described in \u201cA statistical framework for protein quantitation in bottom-up MS based proteomics\" (Karpievitch et al. Bioinformatics 2009). EigenMS normalisation is implemented as described in \"Normalization of peak intensities in bottom-up MS-based proteomics using singular value decomposition.\" (Karpievitch et al. Bioinformatics 2009).","tool_type":["Command-line tool","Library"],"version":["1.30.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-proteomm","credit":[{"name":"Tim Stuart and Sufyaan Mohamed"},{"name":"Yuliya V Karpievitch"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/ProteoMM"}],"name":"ProteoMM","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.18129/B9.bioc.ProteoMM"}]},"bioschemas":{"name":"ProteoMM","home":"https://bio.tools/bioconductor-proteomm","license":"MIT","version":"1.30.0","summary":"Pr