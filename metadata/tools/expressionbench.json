{"tool_name":"expressionbench","contents":["biotools"],"identifiers":["biotools:expressionbench"],"fetched_metadata":{"biotools":{"id":"expressionbench","home":"https://expressionbench.com/","summary":"Free web tool that helps biologists interpret RNA-seq differential expression results without coding. It is built to turn statistical output into findings researchers can act on, instead of tables of numbers they must learn to read. Load one results table from DESeq2, edgeR, limma or Seurat to get an interactive volcano plot, annotated genes and pathway enrichment against GO Biological Process, Reactome and WikiPathways. Enrichment uses a hypergeometric test with Benjamini-Hochberg correction. A generated methods paragraph states the test, cutoffs and database versions for reproducibility. Supports human and mouse. All analysis runs in the browser, so data never leaves your computer.","addition_date":"2026-11-18T22:05:35.882117Z","last_update_date":"2026-11-18T22:05:35.884154Z","tool_type":["Web application"],"accessibility":"Open access","biotools_curie":"biotools:expressionbench","cost":"Free of charge","documentation":[{"type":["User manual"],"url":"https://expressionbench.com/guides/"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Expression data","uri":"http://edamontology.org/data_2603"},"format":[{"term":"CSV","uri":"http://edamontology.org/format_3752"},{"term":"TSV","uri":"http://edamontology.org/format_3475"}]}],"operation":[{"term":"Expression data visualisation","uri":"http://edamontology.org/operation_0571"},{"term":"Gene functional annotation","uri":"http://edamontology.org/operation_3672"},{"term":"Gene-set enrichment analysis","uri":"http://edamontology.org/operation_2436"},{"term":"Pathway analysis","uri":"http://edamontology.org/operation_3928"},{"term":"Statistical calculation","uri":"http://edamontology.org/operation_2238"}],"output":[{"data":{"term":"Gene report","uri":"http://edamontology.org/data_0916"},"format":[{