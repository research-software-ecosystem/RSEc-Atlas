{"tool_name":"mirth","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"mirth","home":"https://github.com/reznik-lab/MIRTH","license":"Other","summary":"Imputation via Rank-Transformation and Harmonization (MIRTH), a method to impute unmeasured metabolite abundances by jointly modeling metabolite covariation across datasets which have heterogeneous coverage of metabolite features.","addition_date":"2022-11-12T18:14:14.468289Z","last_update_date":"2024-11-24T15:21:26.549622Z","tool_type":["Command-line tool","Script"],"biotools_curie":"biotools:mirth","credit":[{"email":"reznike@mskcc.org","name":"Ed Reznik","orcidid":"https://orcid.org/0000-0002-6511-5947","typeEntity":"Person"},{"email":"tanseyw@mskcc.org","name":"Wesley Tansey","typeEntity":"Person"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Aggregation","uri":"http://edamontology.org/operation_3436"},{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Imputation","uri":"http://edamontology.org/operation_3557"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"}]}],"name":"MIRTH","owner":"Chan019","publication":[{"doi":"10.1186/s13059-022-02738-3","metadata":{"abstract":"Out of the thousands of metabolites in a given specimen, most metabolomics experiments measure only hundreds, with poor overlap across experimental platforms. Here, we describe Metabolite Imputation via Rank-Transformation and Harmonization (MIRTH), a method to impute unmeasured metabolite abundances by jointly modeling metabolite covariation across datasets which have heterogeneous coverage of metabolite features. MIRTH successfully recovers masked metabolite abundances both within single datasets and across multiple, independently-profiled datasets. MIRTH demonstrates that latent information about otherwise unmeasured metabolites is embedded within existing metabolomics data, and can be used to generate novel hypotheses and simplify existing metabolomic workflows.","authors":[{"name":"Freeman B.A."},{"name":"Jaro S."},{"name":"Keene S."},{"name":"Park T."},{"name":"Reznik E."},{"name":"Tansey W."}],"citationCount":2,"date":"2022-12-01T00:00:00Z","journal":"Genome Biology","title":"MIRTH: Metabolite Imputation via Rank-Transformation and Harmonization"},"pmcid":"PMC9438248","pmid":"36050754"}],"topic":[{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}],"validated":1},"bioschemas":{"name":"MIRTH","home":"https://bio.tools/mirth","license":"Other","summary":"Imputation via Rank-Transformation and Harmonization (MIRTH), a method to impute unmeasured metabolite abundances by jointly modeling metabolite covariation across datasets which have heterogeneous coverage of metabolite features.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mirth/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":6,"citations":[{"count":1,"year":"2022"},{"count":1,"year":"2023"},{"count":1,"year":"2024"},{"count":1,"year":"2026"},{"count":2,"year":"2025"}],"doi":"10.1186/s13059-022-02738-3","pmcid":"PMC9438248","pmid":"36050754","ref_count":31,"refs":[{"count":1,"year":"1992"},{"count":1,"year":"2004"},{"count":1,"year":"2006"},{"count":1,"year":"2007"},{"count":1,"year":"2008"},{"count":1,"year":"2009"},{"count":1,"year":"2010"},{"count":2,"year":"2016"},{"count":4,"year":"2019"},{"count":4,"year":"2021"},{"count":4,"year":"2022"},{"count":5,"year":"2018"},{"count":5,"year":"2020"}],"title":"MIRTH: Metabolite Imputation via Rank-Transformation and