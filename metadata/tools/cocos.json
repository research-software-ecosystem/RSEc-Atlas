{"tool_name":"cocos","contents":["biotools"],"identifiers":["biotools:cocos"],"fetched_metadata":{"biotools":{"id":"cocos","home":"https://github.com/DEAL-US/Cocos","license":"GPL-3.0","summary":"Web framework for integrating and running antimicrobial resistance (AMR) prediction models on genomic data. Users upload sequencing reads (Illumina or ONT), an assembly or a Bakta annotation; Cocos discovers which registered models can be applied to the sample, runs the assembly, annotation and gene extraction each model needs, and returns resistance predictions with their provenance (PROV-O, RO-Crate) and a trust level. Models are plug-ins described in RDF with the AMRF application profile and validated with SHACL, so new models can be added without changing the code.","addition_date":"2026-11-09T14:27:52.928657Z","last_update_date":"2026-11-10T15:52:42.287167Z","tool_type":["Web application"],"accessibility":"Open access","biotools_curie":"biotools:cocos","cost":"Free of charge","credit":[{"email":"mquiros1@us.es","name":"Mar\u00eda Quir\u00f3s Quiroga","orcidid":"https://orcid.org/0009-0005-7434-9883","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"note":"How to add new prediction models and services.","type":["Other"],"url":"https://deal-us.github.io/Cocos/extending"},{"note":"How to deploy Cocos on a server.","type":["Installation instructions"],"url":"https://deal-us.github.io/Cocos/production"},{"note":"How to set up Cocos locally for development.","type":["Installation instructions"],"url":"https://deal-us.github.io/Cocos/development"},{"note":"License of the software.","type":["Terms of use"],"url":"https://github.com/DEAL-US/Cocos/blob/main/LICENSE"},{"note":"Overview of Cocos and entry point to the documentation","type":["General"],"url":"https://deal-us.github.io/Cocos/"},{"note":"The AMRF semantic layer: vocabulary, SHACL shapes, RO-Crate export and SPARQL.","type":["Other"],"url":"https://deal-us.github.io/Cocos/semantic-layer"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"DNA sequence","uri":"http://edamontology.org/data_3494"},"format":[{"term":"FASTQ","uri":"http://edamontology.org/format_1930"},{"term":"FASTQ-illumina","uri":"http://edamontology.org/format_1931"}]},{"data":{"term":"Feature table","uri":"http://edamontology.org/data_1270"},"format":[{"term":"JSON","uri":"http://edamontology.org/format_3464"}]},{"data":{"term":"Sequence assembly","uri":"http://edamontology.org/data_0925"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}],"operation":[{"term":"Antimicrobial resistance prediction","uri":"http://edamontology.org/operation_3482"}],"output":[{"data":{"term":"Report","uri":"http://edamontology.org/data_2048"},"format":[{"term":"CSV","uri":"http://edamontology.org/format_3752"}]},{"data":{"term":"Resource metadata","uri":"http://edamontology.org/data_2337"},"format":[{"term":"JSON-LD","uri":"http://edamontology.org/format_3749"},{"term":"Turtle","uri":"http://edamontology.org/format_3255"}]}]}],"maturity":"Emerging","name":"Cocos","operating_system":["Linux","Windows"],"owner":"maria9","topic":[{"term":"Antimicrobial resistance","uri":"http://edamontology.org/topic_4013"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Microbiology","uri":"http://edamontology.org/topic_3301"},{"term":"Ontology and terminology","uri":"http://edamontology.org/topic_0089"}]}}}