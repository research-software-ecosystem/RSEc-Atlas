{"tool_name":"sina","contents":["biocontainers","galaxy","bioschemas","debian","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"sina","version":"1.7.2","home":"https://github.com/epruesse/SINA","documentation":"https://sina.readthedocs.io","license":"GPLv3","summary":"Reference based multiple sequence alignment","identifiers":["biotools:SINA","doi:10.1093/bioinformatics/bts252"],"description":"SINA allows incorporating additional sequences into an existing\nmultiple sequence alignment (MSA) without modifying the original\nalignment. While adding sequences to an MSA with SINA is usually\nfaster than re-computing the entire MSA from an augmented set of\nunaligned sequences, the primary benefit lies in protecting\ninvestments made into the original MSA such as manual curation of the\nalignment, compute intensive phylogenetic tree reconstruction and\ntaxonomic annotation of the resulting phylogeny.\n\nAdditionally, SINA includes a homology search which uses the\npreviously computed alignment to determine the most similar\nsequences. Based on the search results, a LCA based classification of\nthe query sequence can be computed using taxonomic classifications\nassigned to the sequences comprising the reference MSA.\n\nSINA is used to compute the small and large subunit ribosomal RNA\nalignments provided by the SILVA_ project and is able to use the ARB_\nformat reference databases released by the project.\n","build":{"number":0},"requirements":{"build":["make",null,"pkg-config","bc"],"host":["arb-bio-devel","boost-cpp","zlib","tbb-devel","glib"],"run":["arb-bio-tools","libarbdb","boost-cpp","zlib","tbb",null]},"source_url":"https://github.com/epruesse/SINA/releases/download/v1.7.2/sina-1.7.2.tar.gz","test":{"commands":["sina --help"]},"recipe_maintainers":["epruesse"]},"biocontainers":{"name":"sina","identifiers":["biotools:SINA","doi:10.1093/bioinformatics/bts252"],"license":"GPL-3.0","summary":"Reference based multiple sequence alignment","home_url":"https://github.com/epruesse/SINA","keywords":["Base Sequence","Computational Biology","Databases, Nucleic Acid","Genes, rRNA","RNA, Ribosomal","Sequence Alignment","Sequencing","RNA","Nucleic acid structure analysis","Taxonomy","Sequence analysis"],"manually_check":true,"total_pulls":3234},"biotools":{"id":"sina","home":"https://sina.readthedocs.io","license":"GPL-3.0","summary":"Aligns and optionally taxonomically classifies your rRNA gene sequences.\n\nReference based multiple sequence alignment","addition_date":"2017-08-03T18:59:43Z","last_update_date":"2024-11-25T14:22:22.697934Z","tool_type":["Web application"],"version":["1.3.1","1.5.0"],"collections":["SINA"],"biotools_curie":"biotools:sina","cost":"Free of charge","credit":[{"email":"contact@arb-silva.de","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.arb-silva.de/contact/"}],"documentation":[{"type":["General"],"url":"https://github.com/epruesse/SINA"}],"edit_permission":{"authors":["epruesse"],"type":"group"},"function":[{"input":[{"data":{"term":"Nucleic acid sequence","uri":"http://edamontology.org/data_2977"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}],"operation":[{"term":"Multiple sequence alignment","uri":"http://edamontology.org/operation_0492"},{"term":"Structure-based sequence alignment","uri":"http://edamontology.org/operation_0294"},{"term":"Taxonomic classification","uri":"http://edamontology.org/operation_3460"}],"output":[{"data":{"term":"Nucleic acid sequence","uri":"http://edamontology.org/data_2977"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}]},{"operation":[{"term":"Sequence alignment analysis","uri":"http://edamontology.org/operation_0258"}]}],"maturity":"Mature","name":"SINA","operating_system":["Linux","Mac","Windows"],"owner":"epruesse","publication":[{"doi":"10.1093/bioinformatics/bts252","metadata":{"abstract":"Motivation: In the analysis of homologous sequences, computation of multiple sequence alignments (MSAs) has become a bottleneck. This is especially troublesome for marker genes like the ribosomal RNA (rRNA) where already millions of sequences are publicly available and individual studies can easily produce hundreds of thousands of new sequences. Methods have been developed to cope with such numbers, but further improvements are needed to meet accuracy requirements.Results: In this study, we present the SILVA Incremental Aligner (SINA) used to align the rRNA gene databases provided by the SILVA ribosomal RNA project. SINA uses a combination of k-mer searching and partial order alignment (POA) to maintain very high alignment accuracy while satisfying high throughput performance demands. SINA was evaluated in comparison with the commonly used high throughput MSA programs PyNAST and mothur. The three BRAliBase III benchmark MSAs could be reproduced with 99.3, 97.6 and 96.1 accuracy. A larger benchmark MSA comprising 38 772 sequences could be reproduced with 98.9 and 99.3% accuracy using reference MSAs comprising 1000 and 5000 sequences. SINA was able to achieve higher accuracy than PyNAST and mothur in all performed benchmarks. \u00a9 The Author(s) 2012. Published by Oxford University Press.","authors":[{"name":"Glockner F.O."},{"name":"Peplies J."},{"name":"Pruesse E."}],"citationCount":2327,"date":"2012-07-01T00:00:00Z","journal":"Bioinformatics","title":"SINA: Accurate high-throughput multiple sequence alignment of ribosomal RNA genes"},"pmcid":"PMC3389763","pmid":"22556368"}],"topic":[{"term":"Nucleic acid structure analysis","uri":"http://edamontology.org/topic_0097"},{"term":"RNA","uri":"http://edamontology.org/topic_0099"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"},{"term":"Taxonomy","uri":"http://edamontology.org/topic_0637"},{"term":"Taxonomy","uri":"http://edamontology.org/topic_0637"}],"validated":1},"bioschemas":{"name":"SINA","home":"https://bio.tools/sina","license":"GPL-3.0","version":["1.3.1","1.5.0"],"summary":"Aligns and optionally taxonomically classifies your rRNA gene sequences.\n\nReference based multiple sequence alignment","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"@TOOL_VERSION@+galaxy@VERSION_SUFFIX@","first_commit":"2019-10-11","conda_name":"sina","conda_version":"1.7.2","summary":"SINA reference based multiple sequence alignment","edam_operations":["Sequence alignment analysis","Multiple sequence alignment","Taxonomic classification","Structure-based sequence alignment"],"edam_topics":["Sequencing","RNA","Nucleic acid structure analysis","Taxonomy","Sequence analysis","Taxonomy"],"toolshed_categories":["Sequence Analysis"],"toolshed_id":"sina","users_5_years":500,"users_all_time":603,"usage_5_years":3221,"usage_all_time":4050,"bio_tools_summary":"Aligns and optionally taxonomically classifies your rRNA gene sequences.Reference based multiple sequence alignment","bio_tools_ids":"sina","bio_tools_name":"SINA","related_tutorials":[],"related_workflows":[],"tool_ids":["sina"],"tool_output_formats":["fasta","data","tabular","txt"],"homepage":"https://sina.readthedocs.io/en/latest/","suite_source":"https://github.com/galaxyproject/tools-iuc/tree/main/tools/sina","suite_owner":"iuc","suite_parsed_folder":"https://github.com/galaxyproject/tools-iuc/tree/master/tools/sina","suite_version_status":"To update","no_of_tools":{"eu":1,"org":1,"org.au":0,"be":1,"cz":1,"fr":0,"no":1,"apostl":0,"cirm_cfbp":0,"chemflow":0,"coloc_stats":0,"gaslini":0,"aubi":0,"pasteur":0,"trakr":0,"hyphy":0,"ipk":0,"immport":0,"interactomix":0,"lebanese":0,"mbac":0,"mississippi":0,"mandoiu":0,"oqtans":0,"palfinder":0,"pepsimili":0,"vvv":0},"runs_by_server":{"eu":1492,"fr":0,"org":2558,"org.au":0,"eu_5_years":1180,"fr_5_years":0,"org_5_years":2041,"org.au_5_years":0},"users_by_server":{"eu":143,"fr":0,"org":460,"org.au":0,"eu_5_years":123,"fr_5_years":0,"org_5_years":377,"org.au_5_years":0}},"oeb":{"metrics":[{"@id":"htt