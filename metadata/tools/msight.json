{"tool_name":"msight","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"msight","home":"https://web.expasy.org/MSight/","summary":"MSight: An image analysis software for liquid chromatography-mass spectrometry. MSight is a tool specifically developed for the representation of mass spectra along with data from a separation step. It provides simple ways to navigate through very large volumes of data, with the ability to display small regions for closer scrutiny.","addition_date":"2017-12-06T18:14:43Z","last_update_date":"2024-11-24T13:46:57.552126Z","tool_type":["Web application"],"collections":["Proteomics"],"biotools_curie":"biotools:msight","credit":[{"email":"msight-support@isb-sib.ch","name":"MSight Support","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://web.expasy.org/MSight/"}],"edit_permission":{"authors":["n.m.palmblad@lumc.nl","proteomics.bio.tools","sizhengZhao"],"type":"group"},"function":[{"input":[{"data":{"term":"Mass spectrometry data","uri":"http://edamontology.org/data_2536"},"format":[{"term":"imzML metadata file","uri":"http://edamontology.org/format_3682"}]}],"operation":[{"term":"Comparison","uri":"http://edamontology.org/operation_2424"},{"term":"Image analysis","uri":"http://edamontology.org/operation_3443"},{"term":"Mass spectra calibration","uri":"http://edamontology.org/operation_3627"},{"term":"Protein quantification","uri":"http://edamontology.org/operation_3630"}],"output":[{"data":{"term":"Mass spectrometry data","uri":"http://edamontology.org/data_2536"},"format":[{"term":"imzML metadata file","uri":"http://edamontology.org/format_3682"}]}]},{"input":[{"data":{"term":"Mass spectrometry data","uri":"http://edamontology.org/data_2536"},"format":[{"term":"imzML metadata file","uri":"http://edamontology.org/format_3682"}]}],"operation":[{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}],"output":[{"data":{"term":"Image","uri":"ht