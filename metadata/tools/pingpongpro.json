{"tool_name":"pingpongpro","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"PingPongPro","home":"https://github.com/suhrig/pingpongpro","license":"GPL-3.0","summary":"Tool for the detection of piRNA-mediated transposon-silencing in small RNA-Seq data.","addition_date":"2019-07-06T07:12:47Z","last_update_date":"2024-11-24T21:07:39.307687Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:PingPongPro","cost":"Free of charge","credit":[{"email":"s.uhrig@dkfz.de","name":"Sebastian Uhrig","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/suhrig/pingpongpro/blob/master/README.md"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Expression analysis","uri":"http://edamontology.org/operation_2495"},{"term":"Transposon prediction","uri":"http://edamontology.org/operation_0427"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"}]}],"maturity":"Mature","name":"PingPongPro","operating_system":["Linux","Mac"],"owner":"Ruta","publication":[{"doi":"10.1093/bioinformatics/bty578","metadata":{"abstract":"Piwi-interacting RNAs (piRNAs) are a class of small non-coding RNAs which guide endonucleases to mRNAs of actively transcribed transposons in order to prevent their translation. The resulting mRNA fragments induce a positive feedback loop (the ' \u20ac' ping-pong cycle'), which reinforces piRNA production and hence the transposon-silencing effect. PingPongPro is a command-line tool to scan small RNA-Seq data for signs of ping-pong cycle activity. It implements a novel algorithm that combines empirical probabilities in a multi-factor model to accurately identify transposons which are suppressed through the ping-pong cycle. Availability and implementation Source code, a user manual, and binaries for Microsoft Windows and Linux are available at https://github.com/suhrig/pingpongpro under the GPLv3 license. Supplementary informationSupplementary dataare available at Bioinformatics online.","authors":[{"name":"Klein H."},{"name":"Uhrig S."}],"citationCount":17,"date":"2019-01-15T00:00:00Z","journal":"Bioinformatics","title":"PingPongPro: A tool for the detection of piRNA-mediated transposon-silencing in small RNA-Seq data"},"pmid":"29985981","type":["Primary"]}],"topic":[{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"Mobile genetic elements","uri":"http://edamontology.org/topic_0798"}],"validated":1},"bioschemas":{"name":"PingPongPro","home":"https://bio.tools/PingPongPro","license":"GPL-3.0","summary":"Tool for the detection of piRNA-mediated transposon-silencing in small RNA-Seq data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pingpongpro/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":17,"citations":[{"count":1,"year":"2019"},{"count":1,"year":"2023"},{"count":1,"year":"2024"},{"count":1,"year":"2026"},{"count":2,"year":"2025"},{"count":3,"year":"2020"},{"count":4,"year":"2021"},{"count":4,"year":"2022"}],"doi":"10.1093/bioinformatics/bty578","pmid":"29985981","ref_count":0,"refs":[],"title":"PingPongPro: a tool for the detection of piRNA-mediated transposon-silencing in small RNA-Seq data.","year":2019}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":fa