{"tool_name":"straglr","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"straglr","home":"https://github.com/bcgsc/straglr","license":"GPL-3.0","summary":"Straglr is a tool that can be used for genome-wide scans for tandem repeat(TR) expansions or targeted genotyping using long-read alignments.","addition_date":"2021-12-13T22:15:34.250736Z","last_update_date":"2022-01-17T12:09:00.090610Z","tool_type":["Command-line tool"],"collections":["Rare Disease"],"accessibility":"Open access","biotools_curie":"biotools:straglr","cost":"Free of charge","credit":[{"email":"ibirol@bcgsc.ca","name":"Inanc Birol","orcidid":"https://orcid.org/0000-0003-0950-7839","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"Indhu-Shree Rajan-Babu"},{"name":"Jan M. Friedman"},{"name":"Readman Chiu"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Haplotype mapping","uri":"http://edamontology.org/operation_0487"},{"term":"Scaffolding","uri":"http://edamontology.org/operation_3216"},{"term":"Sequence motif recognition","uri":"http://edamontology.org/operation_0239"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"}]}],"name":"Straglr","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1186/S13059-021-02447-3","metadata":{"abstract":"\u00a9 2021, The Author(s).Tandem repeat (TR) expansion is the underlying cause of over 40 neurological disorders. Long-read sequencing offers an exciting avenue over conventional technologies for detecting TR expansions. Here, we present Straglr, a robust software tool for both targeted genotyping and novel expansion detection from long-read alignments. We benchmark Straglr using various simulations, targeted genotyping data of cell lines carrying expansions of known diseases, and whole genome sequencing data with chromosome-scale assembly. Our results suggest that Straglr may be useful for investigating disease-associated TR expansions using long-read sequencing.","authors":[{"name":"Birol I."},{"name":"Chiu R."},{"name":"Friedman J.M."},{"name":"Rajan-Babu I.-S."}],"date":"2021-12-01T00:00:00Z","journal":"Genome Biology","title":"Straglr: discovering and genotyping tandem repeat expansions using whole genome long-read sequences"},"pmcid":"PMC8361843","pmid":"34389037","type":["Primary"]}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Exome sequencing","uri":"http://edamontology.org/topic_3676"},{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Neurology","uri":"http://edamontology.org/topic_3334"},{"term":"Whole genome sequencing","uri":"http://edamontology.org/topic_3673"}],"validated":1},"bioschemas":{"name":"Straglr","home":"https://bio.tools/straglr","license":"GPL-3.0","summary":"Straglr is a tool that can be used for genome-wide scans for tandem repeat(TR) expansions or targeted genotyping using long-read alignments.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:straglr/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":61,"citations":[{"count":1,"year":"2021"},{"count":6,"year":"2022"},{"count":6,"year":"2023"},{"count":9,"year":"2026"},{"count":15,"year":"2024"},{"count":24,"year":"2025"}],"doi":"10.1186/s13059-021-02447-3","pmcid":"PMC8361843","pmid":"34389037","ref_count":44,"refs":[{"count":1,"year":"1992"},{"count":1,"year":"1996"},{"count