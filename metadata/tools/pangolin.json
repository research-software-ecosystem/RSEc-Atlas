{"tool_name":"pangolin","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"pangolin","identifiers":["doi:10.1093/molbev/msu300","doi:10.1093/molbev/msx281","doi:10.1093/sysbio/syq010","doi:10.1093/bioinformatics/bty191"],"license":"GPL-3.0","summary":"Phylogenetic Assignment of Named Global Outbreak LINeages","home_url":"https://github.com/hCoV-2019/pangolin","keywords":["Phylogenetics","Sequence Alignment","Genetics"],"manually_check":true,"total_pulls":24},"biotools":{"id":"pangolin","home":"https://github.com/tkzeng/Pangolin","license":"GPL-3.0","summary":"Pangolin is a deep-learning based method for predicting splice site strengths (for details, see Zeng and Li, Genome Biology 2022). It is available as a command-line tool that can be run on a VCF or CSV file containing variants of interest; Pangolin will predict changes in splice site strength due to each variant, and return a file of the same format. Pangolin's models can also be used with custom sequences.","addition_date":"2022-07-26T10:11:09.660345Z","last_update_date":"2026-07-21T21:15:53.848510Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:pangolin","cost":"Free of charge","credit":[{"email":"yangili1@uchicago.edu","name":"Yang I Li","orcidid":"https://orcid.org/0000-0002-0736-251X","typeEntity":"Person"},{"name":"Tony Zeng"}],"edit_permission":{"authors":["xiangjun_zhao"],"type":"group"},"function":[{"input":[{"data":{"term":"Sequence","uri":"http://edamontology.org/data_2044"},"format":[{"term":"CSV","uri":"http://edamontology.org/format_3752"},{"term":"VCF","uri":"http://edamontology.org/format_3016"}]}],"operation":[{"term":"Alternative splicing prediction","uri":"http://edamontology.org/operation_0264"},{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Sequence merging","uri":"http://edamontology.org/operation_0232"},{"term":"Splice site prediction","uri":"http://edamontology.org/operation_0433"},{"term":"Variant classification","uri":"http://edamontology.org/operation_3225"}]}],"name":"Pangolin","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1186/s13059-022-02664-4","metadata":{"abstract":"Recent progress in deep learning has greatly improved the prediction of RNA splicing from DNA sequence. Here, we present Pangolin, a deep learning model to predict splice site strength in multiple tissues. Pangolin outperforms state-of-the-art methods for predicting RNA splicing on a variety of prediction tasks. Pangolin improves prediction of the impact of genetic variants on RNA splicing, including common, rare, and lineage-specific genetic variation. In addition, Pangolin identifies loss-of-function mutations with high accuracy and recall, particularly for mutations that are not missense or nonsense, demonstrating remarkable potential for identifying pathogenic variants.","authors":[{"name":"Li Y.I."},{"name":"Zeng T."}],"citationCount":52,"date":"2022-12-01T00:00:00Z","journal":"Genome Biology","title":"Predicting RNA splicing from DNA sequence using Pangolin"},"pmcid":"PMC9022248","pmid":"35449021"}],"topic":[{"term":"Exome sequencing","uri":"http://edamontology.org/topic_3676"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"RNA splicing","uri":"http://edamontology.org/topic_3320"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"bioschemas":{"name":"Pangolin","home":"https://bio.tools/pangolin","license":"GPL-3.0","summary":"Pangolin is a deep-learning based method for predicting splice site strengths (for details, see Zeng and Li, Genome Biology 2022). It is available as a command-line tool that can be run on a VCF or CSV file containing variants of interest; Pangolin will predict changes in splice site strength due to each variant, and return a file of the same format. Pangolin's models can also be used with custom sequences.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pangolin/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":175,"citations":[{"count":3,"year":"2022"},{"count":18,"year":"2023"},{"count":32,"year":"2024"},{"count":60,"year":"2025"},{"count":62,"year":"2026"}],"doi":"10.1186/s13059-022-02664-4","pmcid":"PMC9022248","pmid":"35449021","ref_count":30,"refs":[{"count":1,"year":"1990"},{"count":1,"year":"1997"},{"count":1,"year":"2000"},{"count":1,"year":"2004"},{"count":1,"year":"2006"},{"count":1,"year":"2011"},{"count":1,"year":"2012"},{"count":1,"year":"2014"},{"count":1,"year":"2017"},{"count":2,"year":"2015"},{"count":2,"year":"2016"},{"count":3,"year":"2020"},{"count":4,"year":"2018"},{"count":5,"year":"2019"},{"count":5,"year":"2021"}],"title":"Predicting RNA splicing from DNA sequence using Pangolin.","year":2022}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://github.com/cov-lineages/pangolin"}],"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":true,"resolve_time":"PT241452S"}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:pangolin:4.1.3/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"li