{"tool_name":"easer","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"easer","home":"http://easer.sourceforge.net/","license":"GPL-3.0","summary":"A Python program (easer.py) based in PyCogent library for the homology-based retrieval of several sequence data types from Ensembl. A Perl program (enamer.pl) for the identification of sequence descriptions.","addition_date":"2021-05-06T16:04:46Z","last_update_date":"2024-11-24T20:25:50.559766Z","tool_type":["Command-line tool","Desktop application","Workflow"],"version":["1.7.0"],"accessibility":"Open access","biotools_curie":"biotools:easer","cost":"Free of charge","credit":[{"email":"emaldonado@ciimar.up.pt","name":"Emanuel Maldonado","orcidid":"https://orcid.org/0000-0002-0084-6116","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"},{"term":"Sequence editing","uri":"http://edamontology.org/operation_0231"}]}],"maturity":"Mature","name":"EASER","operating_system":["Linux","Mac","Windows"],"owner":"emaldonado","publication":[{"doi":"10.4137/ebo.s11335","metadata":{"abstract":"The rapid advances in genome sequencing technologies have increased the pace at which biological sequence databases are becoming available to the broad scientific community. Thus, obtaining and preparing an appropriate sequence dataset is a crucial first step for all types of genomic analyses. Here, we present a script that can widely facilitate the easy, fast, and effortless downloading and preparation of a proper biological sequence data-set for various genomics studies. This script retrieves Ensembl defined genomic features, associated with a given Ensembl identifier. Coding (CDS) and genomic sequences can be easily retrieved based on a selected relationship from a set of relationship types, either considering all available organisms or a user specified subset of organisms. The script is very user-friendly and by default starts with an interactive mode if no command-line options are specified. \u00a9 the authors, publisher and licensee Libertas Academica Limited. \u00a9 the authors, publisher and licensee Libertas Academica Limited.","authors":[{"name":"Antunes A."},{"name":"Khan I."},{"name":"Maldonado E."},{"name":"Philip S."},{"name":"Vasconcelos V."}],"citationCount":5,"date":"2013-11-24T00:00:00Z","journal":"Evolutionary Bioinformatics","title":"Easer: Ensembl easy sequence retriever"},"pmcid":"PMC3855309","pmid":"24324324"}],"topic":[{"term":"Data acquisition","uri":"http://edamontology.org/topic_3077"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Molecular genetics","uri":"http://edamontology.org/topic_3321"}]},"bioschemas":{"name":"EASER","home":"https://bio.tools/easer","license":"GPL-3.0","version":"1.7.0","summary":"A Python program (easer.py) based in PyCogent library for the homology-based retrieval of several sequence data types from Ensembl. A Perl program (enamer.pl) for the identification of sequence descriptions.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:easer:1.7.0/app/easer.sourceforge.net","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":7,"citations":[{"count":1,"year":"2023"},{"count":1,"year":"2024"},{"count":1,"year":"2026"},{"count":2,"year":"2016"},{"count":2,"year":"2019"}],"doi":"10.4137/EBO.S11335","pmcid":"PMC3855309","pmid":"24324324","ref_count":6,"refs":[{"count":1,"year":"2004"},{"count":1,"year":"2009"},{"count":1,"year":"2011"},{"count":1,"year":"2012"},{"count":2,"year":"2007"}],"title":"EASER: Ensembl Easy Sequence Retriever.","year":2013}]}],"summary":{"descripti