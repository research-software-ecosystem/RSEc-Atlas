{"tool_name":"rinchi","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"rinchi","home":"https://www.inchi-trust.org/downloads/","license":"CC-BY-4.0","summary":"International chemical identifier for reactions .","addition_date":"2018-08-25T12:14:17Z","last_update_date":"2024-11-25T14:30:20.003953Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:rinchi","credit":[{"email":"jmg11@cam.ac.uk","name":"Jonathan M. Goodman","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"https://www.inchi-trust.org/download/RInChI/RInChI%20V1-00-0.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Molecular model refinement","uri":"http://edamontology.org/operation_0322"}]}],"name":"RInChI","operating_system":["Linux"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1186/s13321-018-0277-8","metadata":{"abstract":"The Reaction InChI (RInChI) extends the idea of the InChI, which provides a unique descriptor of molecular structures, towards reactions. Prototype versions of the RInChI have been available since 2011. The first official release (RInChI-V1.00), funded by the InChI Trust, is now available for download (http://www.inchi-trust.org/downloads/). This release defines the format and generates hashed representations (RInChIKeys) suitable for database and web operations. The RInChI provides a concise description of the key data in chemical processes, and facilitates the manipulation and analysis of reaction data.","authors":[{"name":"Blanke G."},{"name":"Goodman J.M."},{"name":"Grethe G."},{"name":"Kraut H."}],"citationCount":27,"date":"2018-12-01T00:00:00Z","journal":"Journal of Cheminformatics","title":"International chemical identifier for reactions (RInChI)"},"pmcid":"PMC5940998","pmid":"29740723"}],"topic":[{"term":"Cheminformatics","uri":"http://edamontology.org/topic_2258"},{"term":"Chemistry","uri":"http://edamontology.org/topic_3314"},{"term":"Molecul