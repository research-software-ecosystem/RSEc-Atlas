{"tool_name":"msgfplus","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"msgfplus","home":"http://bioconductor.org/packages/release/bioc/html/MSGFplus.html","license":"GPL-2.0","summary":"This package contains function to perform peptide identification using MS-GF+.","addition_date":"2017-01-17T15:04:48Z","last_update_date":"2024-11-25T14:07:56.609560Z","tool_type":["Command-line tool","Library"],"version":["1.8.0"],"collections":["BioConductor","Proteomics"],"biotools_curie":"biotools:msgfplus","credit":[{"email":"thomasp85@gmail.com","name":"Thomas Lin Pedersen","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/html/MSGFplus.html"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"operation":[{"term":"Peptide identification","uri":"http://edamontology.org/operation_3631"}]}],"name":"MSGFplus","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1021/pr400937n","metadata":{"abstract":"One can interpret fragmentation spectra stemming from peptides in mass-spectrometry-based proteomics experiments using so-called database search engines. Frequently, one also runs post-processors such as Percolator to assess the confidence, infer unique peptides, and increase the number of identifications. A recent search engine, MS-GF+, has shown promising results, due to a new and efficient scoring algorithm. However, MS-GF+ provides few statistical estimates about the peptide-spectrum matches, hence limiting the biological interpretation. Here, we enabled Percolator processing for MS-GF+ output and observed an increased number of identified peptides for a wide variety of data sets. In addition, Percolator directly reports p values and false discovery rate estimates, such as q values and posterior error probabilities, for peptide-spectrum matches, peptides, and proteins, functions that are useful for the whole proteomics community. \u00a9 2013 American Chemical Society.","authors":[{"name":"Granholm V."},{"name":"Kall L."},{"name":"Kim S."},{"name":"Navarro J.C.F."},{"name":"Sjolund E."},{"name":"Smith R.D."}],"citationCount":70,"date":"2014-02-07T00:00:00Z","journal":"Journal of Proteome Research","title":"Fast and accurate database searches with MS-GF+percolator"},"pmcid":"PMC3975676","pmid":"24344789","type":["Other"]}],"topic":[{"term":"Protein expression","uri":"http://edamontology.org/topic_0108"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}],"validated":1},"bioschemas":{"name":"MSGFplus","home":"https://bio.tools/msgfplus","license":"GPL-2.0","version":"1.8.0","summary":"This package contains function to perform peptide identification using MS-GF+.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:msgfplus:1.8.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":59,"citations":[{"count":1,"year":"-1"},{"count":1,"year":"2026"},{"count":2,"year":"2017"},{"count":2,"year":"2020"},{"count":3,"year":"2024"},{"count":4,"year":"2014"},{"count":4,"year":"2015"},{"count":5,"year":"2016"},{"count":5,"year":"2022"},{"count":5,"year":"2025"},{"count":6,"year":"2021"},{"count":7,"year":"2018"},{"count":7,"year":"2019"},{"count":7,"year":"2023"}],"doi":"10.1021/pr400937n","pmcid":"PMC3975676","pmid":"24344789","ref_count":35,"refs":[{"count":1,"year":"1994"},{"count":1,"year":"1999"},{"count":1,"year":"2002"},{"count":1,"year":"2004"},{"count":1,"year":"2005"},{"count":1,"year":"2013"},{"count