{"tool_name":"birewire","contents":["bioconda","oeb","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-birewire","version":"3.41.0","home":"https://bioconductor.org/packages/3.22/bioc/html/BiRewire.html","license":"GPL-3","summary":"High-performing routines for the randomization of a bipartite graph (or a binary event matrix), undirected and directed signed graph preserving degree distribution (or marginal totals)","identifiers":["biotools:birewire"],"description":"Fast functions for bipartite network rewiring through N consecutive switching steps (See References) and for the computation of the minimal number of switching steps to be performed in order to maximise the dissimilarity with respect to the original network. Includes functions for the analysis of the introduced randomness across the switching steps and several other routines to analyse the resulting networks and their natural projections. Extension to undirected networks and directed signed networks is also provided. Starting from version 1.9.7 a more precise bound (especially for small network) has been implemented. Starting from version 2.2.0 the analysis routine is more complete and a visual montioring of the underlying Markov Chain has been implemented. Starting from 3.6.0 the library can handle also matrices with NA (not for the directed signed graphs). Since version 3.27.1 it is possible to add a constraint for dsg generation: usually positive and negative arc between two nodes could be not accepted.","license_file":"/lib/R/share/licenses/GPL-3","build":{"number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"build":[null,"make"],"host":["r-base","r-igraph","r-matrix","r-rtsne","r-slam","libblas","liblapack","zlib","liblzma-devel"],"run":["r-base","r-igraph","r-matrix","r-rtsne","r-slam"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/BiRewire_3.41.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BiRewire/BiRewire_3.41.0.tar.gz","https://bioarchive.galaxyproject.org/BiRewire_3.41.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-birewire/bioconductor-birewire_3.41.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('BiRewire')\""]},"parent_recipe":{"name":"bioconductor-birewire","path":"recipes/bioconductor-birewire","version":"3.12.0"}},"biotools":{"id":"birewire","home":"https://bioconductor.org/packages/BiRewire","license":"GPL-3.0","summary":"Fast functions for bipartite network rewiring through N consecutive switching steps (See References) and for the computation of the minimal number of switching steps to be performed in order to maximise the dissimilarity with respect to the original network. Includes functions for the analysis of the introduced randomness across the switching steps and several other routines to analyse the resulting networks and their natural projections. Extension to undirected networks and directed signed networks is also provided. Starting from version 1.9.7 a more precise bound (especially for small network) has been implemented. Starting from version 2.2.0 the analysis routine is more complete and a visual montioring of the underlying Markov Chain has been implemented. Starting from 3.6.0 the library can handle also matrices with NA (not for the directed signed graphs). Since version 3.27.1 it is possible to add a constraint for dsg generation: usually positive and negative arc between two nodes could be not accepted.","addition_date":"2017-01-17T15:05:40Z","last_update_date":"2019-01-10T15:26:33Z","tool_type":["Command-line tool","Library"],"version":["3.43.1"],"collections":["BioConductor"],"biotools_curie":"biotools:birewire","credit":[{"name":"Davide Albanese"},{"name":"Giuseppe Jurman"},{"name":"Julio Saez-Rodriguez"},{"name":"Andrea Gobbi","typeEntity":"Person","typeRole":["Developer"]},{"name":"Francesco Iorio","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioc