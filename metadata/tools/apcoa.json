{"tool_name":"apcoa","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"apcoa","home":"https://biostatistics.mdanderson.org/shinyapps/aPCoA/","license":"GPL-2.0","summary":"A R package and Shiny app for covariate adjusted principal coordinates analysis.","addition_date":"2021-01-18T08:43:19Z","last_update_date":"2021-01-24T18:36:25Z","tool_type":["Library","Web application"],"biotools_curie":"biotools:apcoa","credit":[{"email":"cbpeterson@mdanderson.org","name":"Christine B Peterson","typeEntity":"Person"},{"email":"rrjenq@mdanderson.org","name":"Robert R Jenq","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"aPCoA","owner":"Kigaard","publication":[{"doi":"10.1093/BIOINFORMATICS/BTAA276","metadata":{"abstract":"\u00a9 2020 The Author(s). Published by Oxford University Press. All rights reserved.In fields, such as ecology, microbiology and genomics, non-Euclidean distances are widely applied to describe pairwise dissimilarity between samples. Given these pairwise distances, principal coordinates analysis is commonly used to construct a visualization of the data. However, confounding covariates can make patterns related to the scientific question of interest difficult to observe. We provide adjusted principal coordinates analysis as an easy-to-use tool, available as both an R package and a Shiny app, to improve data visualization in this context, enabling enhanced presentation of the effects of interest.","authors":[{"name":"Do K.-A."},{"name":"Jenq R.R."},{"name":"Peterson C.B."},{"name":"Shi Y."},{"name":"Zhang L."}],"date":"2020-07-01T00:00:00Z","journal":"Bioinformatics","title":"APCoA: Covariate adjusted principal coordinates analysis"},"pmcid":"PMC7332564","pmid":"32339223"}],"topic":[{"term":"Ecology","uri":"http://edamontology.org/topic_0610"},{"term":"Microbiology","uri":"http://edamontology.org/topic_3301"},{"term":"Oncology","uri":"http://edamontology.org/topic_2640"}],"validated":1},"bioschemas":{"name":"aPCoA","home":"https://bio.tools/apcoa","license":"GPL-2.0","summary":"A R package and Shiny app for covariate adjusted principal coordinates analysis.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:apcoa/lib/biostatistics.mdanderson.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":41,"citations":[{"count":1,"year":"2021"},{"count":4,"year":"2022"},{"count":5,"year":"2023"},{"count":8,"year":"2026"},{"count":10,"year":"2024"},{"count":13,"year":"2025"}],"doi":"10.1093/bioinformatics/btaa276","pmcid":"PMC7332564","pmid":"32339223","ref_count":6,"refs":[{"count":1,"year":"2005"},{"count":1,"year":"2006"},{"count":1,"year":"2007"},{"count":1,"year":"2011"},{"count":1,"year":"2016"},{"count":1,"year":"2019"}],"title":"aPCoA: covariate adjusted principal coordinates analysis.","year":2020}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:apcoa/web/biostatistics.mdanderson.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":41,"citations":[{"count":1,"year":"2021"},{"count":4,"year":"2022"},{"count":5,"year":"2023"},{"count":8,"year":"2026"},{"count":