{"tool_name":"omtools","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"omtools","home":"https://github.com/TF-Chan-Lab/OMTools","summary":"Visualizing and processing optical mapping data.","addition_date":"2018-06-07T16:38:49Z","last_update_date":"2024-11-25T14:39:33.449743Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:omtools","credit":[{"email":"kevinyip@cse.cuhk.edu.hk","name":"Kevin Y. Yip","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"tf.chan@cuhk.edu.hk","name":"Ting-Fung Chan","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/TF-Chan-Lab/OMTools/blob/master/OMToolsManual.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"DNA mapping","uri":"http://edamontology.org/operation_2520"},{"term":"Sequence analysis","uri":"http://edamontology.org/operation_2403"},{"term":"Sequence visualisation","uri":"http://edamontology.org/operation_0564"}]}],"name":"OMTools","operating_system":["Linux","Mac","Windows"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1093/bioinformatics/btx317","metadata":{"abstract":"Summary: Optical mapping is a molecular technique capturing specific patterns of fluorescent labels along DNA molecules. It has been widely applied in assisted-scaffolding in sequence assemblies, microbial strain typing and detection of structural variations. Various computational methods have been developed to analyze optical mapping data. However, existing tools for processing and visualizing optical map data still have many shortcomings. Here, we present OMTools, an efficient and intuitive data processing and visualization suite to handle and explore large-scale optical mapping profiles. OMTools includes modules for visualization (OMView), data processing and simulation. These modules together form an accessible and convenient pipeline for optical mapping analyses. Availability and implementation: OMTools is implemented in Java 1.8 and released under a GPL license. OMTools can be downloaded from https://github.com/aldenleung/OMTools and run on any standard desktop computer equipped with a Java virtual machine.","authors":[{"name":"Chan T.-F."},{"name":"Jin N."},{"name":"Leung A.K.-Y."},{"name":"Yip K.Y."}],"citationCount":18,"date":"2017-09-15T00:00:00Z","journal":"Bioinformatics","title":"OMTools: A software package for visualizing and processing optical mapping data"},"pmcid":"PMC5870549","pmid":"28505226"}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"bioschemas":{"name":"OMTools","home":"https://bio.tools/omtools","summary":"Visualizing and processing optical mapping data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:omtools/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":16,"citations":[{"count":1,"year":"2017"},{"count":1,"year":"2020"},{"count":1,"year":"2024"},{"count":1,"year":"2025"},{"count":2,"year":"2023"},{"count":2,"year":"2026"},{"count":4,"year":"2019"},{"count":4,"year":"2021"}],"doi":"10.1093/bioinformatics/btx317","pmcid":"PMC5870549","pmid":"28505226","ref_count":8,"refs":[{"count":1,"year":"2009"},{"count":1,"year":"2010"},{"count":1,"year":"2014"},{"count":1,"year":"2017"},{"count":2,"year":"2012"},{"count":2,"year":"2015"}],"title":"OMTools: a software package for visual