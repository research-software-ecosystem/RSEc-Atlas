inityrnaseq/trinityrnaseq/","keywords":["Base Sequence","Gene Expression Profiling","Molecular Sequence Data","RNA","Reference Values","Sequence Analysis, RNA","Transcriptome","Transcriptomics","Gene expression","Gene transcripts","RNA-Seq"],"manually_check":true,"total_pulls":3241},"biotools":{"id":"trinity","home":"https://github.com/trinityrnaseq/trinityrnaseq/wiki","summary":"Trinity is a transcriptome assembler which relies on three different tools, inchworm an assembler, chrysalis which pools contigs and butterfly which amongst others compacts a graph resulting from butterfly with reads.","addition_date":"2017-01-13T13:16:54Z","last_update_date":"2024-11-24T16:00:22.814130Z","tool_type":["Suite"],"biotools_curie":"biotools:trinity","credit":[{"email":"aregev@broad.mit.edu","name":"Aviv Regev","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"nir@cs.huji.ac.il","name":"Nir Friedman","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/trinityrnaseq/trinityrnaseq/wiki"}],"edit_permission":{"authors":["sergitobara"],"type":"group"},"function":[{"operation":[{"term":"Transcriptome assembly","uri":"http://edamontology.org/operation_3258"}]}],"name":"Trinity","operating_system":["Linux"],"owner":"seqwiki_import","publication":[{"doi":"10.1038/nprot.2013.084","metadata":{"abstract":"De novo assembly of RNA-seq data enables researchers to study transcriptomes without the need for a genome sequence; this approach can be usefully applied, for instance, in research on 'non-model organisms' of ecological and evolutionary importance, cancer samples or the microbiome. In this protocol we describe the use of the Trinity platform for de novo transcriptome assembly from RNA-seq data in non-model organisms. We also present Trinity-supported companion utilities for downstream applications, including RSEM for transcript abundance estimation, R/Bioconductor packages for identifying differentially expressed transcripts across samples and approaches to identify protein-coding genes. In the procedure, we provide a workflow for genome-independent transcriptome analysis leveraging the Trinity platform. The software, documentation and demonstrations are freely available from http://trinityrnaseq.sourceforge.net. The run time of this protocol is highly dependent on the size and complexity of data to be analyzed. The example data set analyzed in the procedure detailed herein can be processed in less than 5 h.","authors":[{"name":"Blood P.D."},{"name":"Bowden J."},{"name":"Couger M.B."},{"name":"Dewey C.N."},{"name":"Eccles D."},{"name":"Friedman N."},{"name":"Grabherr M."},{"name":"Haas B.J."},{"name":"Henschel R."},{"name":"Leduc R.D."},{"name":"Li B."},{"name":"Lieber M."},{"name":"Macmanes M.D."},{"name":"Orvis J."},{"name":"Ott M."},{"name":"Papanicolaou A."},{"name":"Pochet N."},{"name":"Regev A."},{"name":"Strozzi F."},{"name":"Weeks N."},{"name":"Westerman R."},{"name":"William T."},{"name":"Yassour M."}],"citationCount":5875,"date":"2013-08-01T00:00:00Z","journal":"Nature Protocols","title":"De novo transcript sequence reconstruction from RNA-seq using the Trinity platform for reference generation and analysis"},"pmcid":"PMC3875132","pmid":"23845962"},{"doi":"10.1038/nbt.1883","pmcid":"PMC3571712","pmid":"21572440"}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"Trinity","home":"https://bio.tools/trinity","summary":"Trinity is a transcriptome assembler which relies on three different tools, inchworm an assembler, chrysalis which pools contigs and butterfly which amongst others compacts a graph resulting from butterfly with reads.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"2.15.1","first_commit":"2015-11-09","conda_name":"trinity","conda_ve