{"tool_name":"rjmcmcnucleosomes","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"rjmcmcnucleosomes","home":"https://bioconductor.org/packages/consensusSeekeR","license":"Artistic-2.0","summary":"This package compares genomic positions and genomic ranges from multiple experiments to extract common regions. The size of the analyzed region is adjustable as well as the number of experiences in which a feature must be present in a potential region to tag this region as a consensus region. In genomic analysis where feature identification generates a position value surrounded by a genomic range, such as ChIP-Seq peaks and nucleosome positions, the replication of an experiment may result in slight differences between predicted values. This package enables the conciliation of the results into consensus regions.","addition_date":"2018-07-13T09:52:43Z","last_update_date":"2026-08-30T02:30:32.902261Z","tool_type":["Library"],"version":["1.40.0"],"collections":["BioConductor"],"biotools_curie":"biotools:rjmcmcnucleosomes","credit":[{"name":"Arnaud Droit","typeEntity":"Person","typeRole":["Developer"]},{"name":"Astrid Desch\u00eanes","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Fabien Claude Lamaze","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Pascal Belleau","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/consensusSeekeR"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene expression profiling","uri":"http://edamontology.org/operation_0314"}]}],"name":"RJMCMCNucleosomes","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[{"doi":"10.1515/sagmb-2014-0098"}],"topic":[{"term":"ChIP-seq","uri":"http://edamontology.org/topic_3169"},{"term":"DNA packaging","uri":"http://edamontology.org/topic_3176"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"