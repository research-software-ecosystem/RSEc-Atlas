{"tool_name":"jasmine-sv","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"jasmine-sv","home":"https://github.com/mkirsche/Jasmine","license":"MIT","summary":"JASMINE (Jointly Accurate Sv Merging with Intersample Network Edges) is an automated pipeline for alignment and SV calling in long-read datasets. The tool is used to merge structural variants (SVs) across samples. Each sample has a number of SV calls, consisting of position information (chromosome, start, end, length), type and strand information, and a number of other values. Jasmine represents the set of all SVs across samples as a network, and uses a modified minimum spanning forest algorithm to determine the best way of merging the variants such that each merged variants represents a set of analogous variants occurring in different samples.","addition_date":"2021-10-04T08:06:10.058660Z","last_update_date":"2021-10-04T08:06:10.061166Z","tool_type":["Workflow"],"biotools_curie":"biotools:jasmine-sv","credit":[{"email":"mschatz@cs.jhu.edu","name":"Michael C. Schatz","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"sergeyaganezovjr@gmail.com","name":"Sergey Aganezov","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"https://github.com/mkirsche/Jasmine/wiki/Jasmine-User-Manual"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genome indexing","uri":"http://edamontology.org/operation_3211"},{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"Jasmine","owner":"Kigaard","publication":[{"doi":"10.1101/2021.05.27.445886","type":["Primary"]}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"RNA-Seq","uri":"http://edamontolo