{"tool_name":"iranges","contents":["bioschemas","debian","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"bioconductor-iranges","version":"2.44.0","home":"https://bioconductor.org/packages/3.22/bioc/html/IRanges.html","license":"Artistic-2.0","summary":"Foundation of integer range manipulation in Bioconductor","identifiers":["biotools:iranges"],"description":"Provides efficient low-level and highly reusable S4 classes for storing, manipulating and aggregating over annotated ranges of integers. Implements an algebra of range operations, including efficient algorithms for finding overlaps and nearest neighbors. Defines efficient list-like classes for storing, transforming and aggregating large grouped data, i.e., collections of atomic vectors and DataFrames.","build":{"number":1,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"build":[null,"make"],"host":["bioconductor-biocgenerics >=0.56.0,<0.57.0","bioconductor-s4vectors >=0.48.0,<0.49.0","r-base","libblas","liblapack","zlib","liblzma-devel"],"run":["bioconductor-biocgenerics >=0.56.0,<0.57.0","bioconductor-s4vectors >=0.48.0,<0.49.0","r-base"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/IRanges_2.44.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/IRanges/IRanges_2.44.0.tar.gz","https://bioarchive.galaxyproject.org/IRanges_2.44.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-iranges/bioconductor-iranges_2.44.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('IRanges')\""]},"parent_recipe":{"name":"bioconductor-iranges","path":"recipes/bioconductor-iranges","version":"2.14.12"}},"biotools":{"id":"iranges","home":"https://bioconductor.org/packages/GenomicAlignments","license":"Artistic-2.0","summary":"Provides efficient containers for storing and manipulating short genomic alignments (typically obtained by aligning short reads to a reference genome). This includes read counting, computing the coverage, ju