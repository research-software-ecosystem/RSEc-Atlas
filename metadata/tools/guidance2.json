{"tool_name":"guidance2","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"guidance2","identifiers":["biotools:guidance2","doi:10.1093/NAR/GKV318"],"license":"GPL-3.0","summary":"Server for alignment confidence score.","home_url":"http://guidance.tau.ac.il/ver2/","keywords":["Internet","Sequence Alignment","Uncertainty","Nucleic acid structure analysis","Sequencing","Data quality management"],"manually_check":true,"total_pulls":0},"biotools":{"id":"guidance2","home":"http://guidance.tau.ac.il/ver2/","summary":"Accurate detection of unreliable alignment regions accounting for the uncertainty of multiple parameters.","addition_date":"2018-05-16T12:32:39Z","last_update_date":"2018-12-10T12:58:58Z","tool_type":["Web application"],"biotools_curie":"biotools:guidance2","credit":[{"email":"bioSequence@tauex.tau.ac.il","name":"Support","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://guidance.tau.ac.il/ver2/overview.php"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Sequence alignment analysis","uri":"http://edamontology.org/operation_0258"}]}],"name":"GUIDANCE2","operating_system":["Linux","Mac","Windows"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1093/NAR/GKV318","metadata":{"abstract":"\u00a9 2015 The Author(s).Inference of multiple sequence alignments (MSAs) is a critical part of phylogenetic and comparative genomics studies. However, from the same set of sequences different MSAs are often inferred, depending on the methodologies used and the assumed parameters. Much effort has recently been devoted to improving the ability to identify unreliable alignment regions. Detecting such unreliable regions was previously shown to be important for downstream analyses relying on MSAs, such as the detection of positive selection. Here we developed GUIDANCE2, a new integrative methodology that accounts for: (i) uncertainty in the process of indel formation, (ii) uncertainty in the assumed guide tree and (iii) co-optimal solutions in the pairwise alignments, used as building blocks in progressive alignment algorithms. We compared GUIDANCE2 with seven methodologies to detect unreliable MSA regions using extensive simulations and empirical benchmarks. We show that GUIDANCE2 outperforms all previously developed methodologies. Furthermore, GUIDANCE2 also provides a set of alternative MSAs which can be useful for downstream analyses. The novel algorithm is implemented as a web-server, available at: http://guidance.tau.ac.il.","authors":[{"name":"Ashkenazy H."},{"name":"Katoh K."},{"name":"Pupko T."},{"name":"Sela I."}],"citationCount":384,"date":"2015-01-01T00:00:00Z","journal":"Nucleic Acids Research","title":"GUIDANCE2: Accurate detection of unreliable alignment regions accounting for the uncertainty of multiple parameters"},"pmcid":"PMC4489236","pmid":"25883146"}],"topic":[{"term":"Data quality management","uri":"http://edamontology.org/topic_3572"},{"term":"Nucleic acid structure analysis","uri":"http://edamontology.org/topic_0097"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"bioschemas":{"name":"GUIDANCE2","home":"https://bio.tools/guidance2","summary":"Accurate detection of unreliable alignment regions accounting for the uncertainty of multiple parameters.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:guidance2/web/guidance.tau.ac.il","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":376,"citations":[{"count":2,"year":"2015"},{"count":14,"year":"2016"},{"count":17,"year":"2026"},{"count":27,"year":"2023"},{"count":28,"year":"2025"},{"count":30,"year":"2017"},{"count":34,"year":"2018"},{"count":35,"year":"2020"},{"count"