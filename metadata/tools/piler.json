{"tool_name":"piler","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"piler","identifiers":["doi:10.1093/bioinformatics/bti1003"],"license":"Apache-2.0","summary":"PILER is public domain software for analyzing repetitive DNA found in genome sequences.","home_url":"http://www.drive5.com/piler/","keywords":["Animals","Arabidopsis","Computational Biology","Drosophila melanogaster","Gene Library","Genome","Genome, Human","Genomics","Humans","Microsatellite Repeats","Models, Genetic","Terminal Repeat Sequences"],"manually_check":true,"total_pulls":4888},"biotools":{"id":"piler","home":"https://www.drive5.com/piler/","license":"Freeware","summary":"PILER is a tool for identification and classification of genomic repeats.","addition_date":"2021-05-27T08:41:53Z","last_update_date":"2024-11-24T20:20:58.319953Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:piler","cost":"Free of charge","credit":[{"email":"bob@drive5.com","name":"Robert C. Edgar","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"https://www.drive5.com/piler/piler_userguide.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Database search","uri":"http://edamontology.org/operation_2421"},{"term":"Global alignment","uri":"http://edamontology.org/operation_0496"},{"term":"Local alignment","uri":"http://edamontology.org/operation_0495"}]}],"name":"PILER","owner":"Kigaard","publication":[{"doi":"10.1093/bioinformatics/bti1003","metadata":{"abstract":"Summary: Repeated elements such as satellites and transposons are ubiquitous in eukaryotic genomes. De novo computational identification and classification of such elements is a challenging problem. Therefore, repeat annotation of sequenced genomes has historically largely relied on sequence similarity to hand-curated libraries of known repeat families. We present a new approach to de novo repeat annotation that exploits characteristic patterns of local alignments induced by certain classes of repeats. We describe PILER, a package of efficient search algorithms for identifying such patterns. Novel repeats found using PILER are reported for Homo sapiens, Arabidopsis thalania and Drosophila melanogaster. \u00a9 The Author 2005. Published by Oxford University Press. All rights reserved.","authors":[{"name":"Edgar R.C."},{"name":"Myers E.W."}],"citationCount":469,"date":"2005-01-01T00:00:00Z","journal":"Bioinformatics","title":"PILER: Identification and classification of genomic repeats"},"pmid":"15961452","type":["Primary"]}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Mobile genetic elements","uri":"http://edamontology.org/topic_0798"}]},"bioschemas":{"name":"PILER","home":"https://bio.tools/piler","license":"Freeware","summary":"PILER is a tool for identification and classification of genomic repeats.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:piler/cmd/www.drive5.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":368,"citations":[{"count":2,"year":"2005"},{"count":5,"year":"2007"},{"count":5,"year":"2008"},{"count":6,"year":"2006"},{"count":6,"year":"2026"},{"count":7,"year":"2010"},{"count":9,"year":"2009"},{"count":10,"year":"2017"},{"count":11,"year":"2012"},{"count":11,"year":"2013"},{"count":13,"year":"2014"},{"count":13,"year":"2015"},{"count":16,"year":"2016"},{"count":16,"year":"2018"},{"count":17,"year":"2011"},{"count":24,"year":"2020"},{"count":27,"year":"2024"},{"count":31,"year":"2019"},{"count":31,"year":"2023"},{"count":35,"year":"2025"},{"count":36,"