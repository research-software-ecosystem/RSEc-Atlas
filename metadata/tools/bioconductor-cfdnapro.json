{"tool_name":"bioconductor-cfdnapro","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-cfdnapro","identifiers":["doi:10.18129/b9.bioc.cfdnapro"],"license":"GPL-3.0","summary":"cfDNA fragment size metrics are important features for utilizing liquid biopsy in tumor early detection, diagnosis, therapy personlization and monitoring. Analyzing and visualizing insert size metrics could be time intensive. This package intends to simplify this exploration process, and it offers two sets of functions for data characterization and data visualization.","home_url":"https://bioconductor.org/packages/3.12/bioc/html/cfDNAPro.html","keywords":["Whole genome sequencing"],"manually_check":true,"total_pulls":362},"biotools":{"id":"bioconductor-cfdnapro","home":"https://bioconductor.org/packages/cfDNAPro","license":"GPL-3.0","summary":"cfDNA fragments carry important features for building cancer sample classification ML models, such as fragment size, and fragment end motif etc. Analyzing and visualizing fragment size metrics, as well as other biological features in a curated, standardized, scalable, well-documented, and reproducible way might be time intensive. This package intends to resolve these problems and simplify the process. It offers two sets of functions for cfDNA feature characterization and visualization.","tool_type":["Command-line tool","Library"],"version":["1.18.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-cfdnapro","credit":[{"name":"Christopher Smith","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Elkie Chan","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Florian Markowetz","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Haichao Wang","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Hui Zhao","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Nitzan Rosenfeld","typeEntity":"Person","typeRole":["Contributor"]},