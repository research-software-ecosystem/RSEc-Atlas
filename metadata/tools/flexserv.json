{"tool_name":"flexserv","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"flexserv","home":"http://mmb.irbbarcelona.org/FlexServ","summary":"Web portal offering a complete set of macromolecular  flexibility analyses from a coarse-grained or atomistic MD trajectory","addition_date":"2016-10-03T14:08:36Z","last_update_date":"2024-11-25T14:27:27.749794Z","tool_type":["Web application"],"version":["1.0"],"collections":["BioExcel","ELIXIR-ES","IRB-BSC"],"biotools_curie":"biotools:flexserv","cost":"Free of charge","credit":[{"email":"adam.hospital@irbbarcelona.org","name":"Institute for Research in Biomedicine Barcelona","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://mmb.irbbarcelona.org/FlexServ/"}],"edit_permission":{"authors":["adam.hospital@irbbarcelona.org","gelpi@ub.edu"],"type":"group"},"function":[{"input":[{"data":{"term":"Protein structure","uri":"http://edamontology.org/data_1460"},"format":[{"term":"PDB","uri":"http://edamontology.org/format_1476"}]}],"operation":[{"term":"Protein flexibility and motion analysis","uri":"http://edamontology.org/operation_0244"}],"output":[{"data":{"term":"Report","uri":"http://edamontology.org/data_2048"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}]}],"maturity":"Mature","name":"FlexServ","operating_system":["Linux","Mac","Windows"],"owner":"jdianes","publication":[{"doi":"10.1093/bioinformatics/btp304","metadata":{"abstract":"Summary: FlexServ is a web-based tool for the analysis of protein flexibility. The server incorporates powerful protocols for the coarse-grained determination of protein dynamics using different versions of Normal Mode Analysis (NMA), Brownian dynamics (BD) and Discrete Dynamics (DMD). It can also analyze user provided trajectories. The server allows a complete analysis of flexibility using a large variety of metrics, including basic geometrical analysis, B-factors, essential dynamics, stiffness analysis, collectivity measures, Lindemann's indexes, residue correlation, chain-correlations, dynamic domain determination, hinge point detections, etc. Data is presented through a web interface as plain text, 2D and 3D graphics. \u00a9 The Author 2009. Published by Oxford University Press. All rights reserved.","authors":[{"name":"Camps J."},{"name":"Carrillo O."},{"name":"Cicin-Sain D."},{"name":"D'Abramo M."},{"name":"Emperador A."},{"name":"Gelpi J.L."},{"name":"Hospital A."},{"name":"Orellana L."},{"name":"Orozco M."},{"name":"Rueda M."}],"citationCount":73,"date":"2009-06-29T00:00:00Z","journal":"Bioinformatics","title":"FlexServ: An integrated tool for the analysis of protein flexibility"},"pmid":"19429600","type":["Primary"]}],"topic":[{"term":"Molecular dynamics","uri":"http://edamontology.org/topic_0176"}],"validated":1},"bioschemas":{"name":"FlexServ","home":"https://bio.tools/flexserv","version":"1.0","summary":"Web portal offering a complete set of macromolecular  flexibility analyses from a coarse-grained or atomistic MD trajectory","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:flexserv:1.0/web/mmb.irbbarcelona.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true,"help":true,"tutorial":true},"publications":[{"entries":[{"cit_count":34,"citations":[{"count":1,"year":"2015"},{"count":1,"year":"2017"},{"count":1,"year":"2019"},{"count":1,"year":"2022"},{"count":1,"year":"2023"},{"count":1,"year":"2025"},{"count":1,"year":"2026"},{"count":2,"year":"2016"},{"count":2,"year":"2024"},{"count":3,"year":"2011"},{"count":3,"year":"2014"},{"count":3,"year":"2018"},{"count":4,"year":"2020"},{"count":5,"year":"2012"},{"count":5,"year":"2013"}],"doi":"10.1093/bioinformatics/btp304","pmid":"19429600