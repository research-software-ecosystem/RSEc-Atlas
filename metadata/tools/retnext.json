{"tool_name":"retnext","contents":["biotools","oeb"],"identifiers":["biotools:retnext"],"fetched_metadata":{"biotools":{"id":"retnext","home":"https://github.com/frudakis-research-group/retnext-paper","summary":"RetNeXt is a pretrained, multi-task transfer learning model designed for predicting gas adsorption properties across the vast chemical space of Metal-Organic Frameworks (MOFs). It utilizes 3D potential energy surface images and convolutional neural networks to improve sample efficiency in data-scarce adsorption modeling.","addition_date":"2026-11-04T10:31:14.202954Z","last_update_date":"2026-11-04T10:31:14.205510Z","biotools_curie":"biotools:retnext","credit":[{"email":"frudakis@uoc.gr","name":"George E. Froudakis","orcidid":"https://orcid.org/0000-0002-6907-1822","typeEntity":"Person"}],"edit_permission":{"type":"private"},"name":"RetNeXt: Pretrained Model for MOF Adsorption Modeling","owner":"pub2tools2024","publication":[{"doi":"10.1021/ACS.JCIM.5C02698","pmcid":"PMC12933712","pmid":"41633776"}],"topic":[{"term":"Chemistry","uri":"http://edamontology.org/topic_3314"},{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:retnext/undefined/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","project":{"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1021/acs.jcim.5c02698","pmcid":"PMC12933712","pmid":"41633776","ref_count":21,"refs":[{"count":1,"year":2012},{"count":1,"year":2013},{"count":1,"year":2018},{"count":1,"year":2019},{"count":1,"year":2021},{"count":2,"year":2025},{"count":3,"year":2011},{"count":3,"year":2020},{"count":3,"year":2024},{"count":5,"year":2023}],"title":"RetNeXt: A Pretrained Model for Transfer Learning Across the MOF Adsorption Space.","year":2026}]}]}}]}}}