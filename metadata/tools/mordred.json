{"tool_name":"mordred","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"mordred","identifiers":["biotools:mordred","doi:10.1186/s13321-018-0258-y"],"license":"BSD-3-Clause","summary":"A molecular descriptor calculator","home_url":"https://github.com/mordred-descriptor/mordred","keywords":["Small molecules","Structure analysis","Molecular modelling"],"manually_check":true,"total_pulls":11135},"biotools":{"id":"mordred","home":"https://github.com/mordred-descriptor/mordred","license":"BSD-3-Clause","summary":"Descriptor-calculation software application that can calculate more than 1800 two- and three-dimensional descriptors.","addition_date":"2018-07-28T13:15:00Z","last_update_date":"2018-12-10T12:59:00Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:mordred","credit":[{"email":"hirotomo.moriwaki@gmail.com","name":"Moriwaki H","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/mordred-descriptor/mordred"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Molecular model refinement","uri":"http://edamontology.org/operation_0322"}]}],"name":"Mordred","operating_system":["Linux","Mac"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1186/s13321-018-0258-y","metadata":{"abstract":"\u00a9 2018 The Author(s).Molecular descriptors are widely employed to present molecular characteristics in cheminformatics. Various molecular-descriptor-calculation software programs have been developed. However, users of those programs must contend with several issues, including software bugs, insufficient update frequencies, and software licensing constraints. To address these issues, we propose Mordred, a developed descriptor-calculation software application that can calculate more than 1800 two- and three-dimensional descriptors. It is freely available via GitHub. Mordred can be easily installed and used in the command line interface, as a web application, or as a high-flexibility Python package on all major platforms (Windows, Linux, and macOS). Performance benchmark results show that Mordred is at least twice as fast as the well-known PaDEL-Descriptor and it can calculate descriptors for large molecules, which cannot be accomplished by other software. Owing to its good performance, convenience, number of descriptors, and a lax licensing constraint, Mordred is a promising choice of molecular descriptor calculation software that can be utilized for cheminformatics studies, such as those on quantitative structure-property relationships.[Figure not available: see fulltext.]","authors":[{"name":"Kawashita N."},{"name":"Moriwaki H."},{"name":"Takagi T."},{"name":"Tian Y.-S."}],"citationCount":154,"date":"2018-02-06T00:00:00Z","journal":"Journal of Cheminformatics","title":"Mordred: A molecular descriptor calculator"},"pmcid":"PMC5801138","pmid":"29411163"}],"topic":[{"term":"Molecular modelling","uri":"http://edamontology.org/topic_2275"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"},{"term":"Structure analysis","uri":"http://edamontology.org/topic_0081"}],"validated":1},"bioschemas":{"name":"Mordred","home":"https://bio.tools/mordred","license":"BSD-3-Clause","summary":"Descriptor-calculation software application that can calculate more than 1800 two- and three-dimensional descriptors.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mordred/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"o