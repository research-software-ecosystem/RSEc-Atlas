{"tool_name":"multifit","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"multifit","home":"http://modbase.compbio.ucsf.edu/multifit/","summary":"MultiFit is a web server for fitting multiple protein structures into their electron microscopy density map. The server takes as input a set of protein structures in the PDB format and an EM density map in the MRC format. The output is an ensemble of models ranked by their quality-of-fit to the density map.","addition_date":"2017-02-14T09:35:05Z","last_update_date":"2018-12-10T12:58:56Z","tool_type":["Web application"],"biotools_curie":"biotools:multifit","credit":[{"email":"multifit@salilab.org","name":"MultiFit Support","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://modbase.compbio.ucsf.edu/multifit/help.cgi?type=help"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Formatting","uri":"http://edamontology.org/operation_0335"},{"term":"Mapping","uri":"http://edamontology.org/operation_2429"},{"term":"Protein model validation","uri":"http://edamontology.org/operation_0321"},{"term":"Protein modelling","uri":"http://edamontology.org/operation_0477"},{"term":"Protein modelling (mutation)","uri":"http://edamontology.org/operation_0331"}]}],"name":"Multifit","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"metadata":{"abstract":"Advances in electron microscopy (EM) allow for structure determination of large biological assemblies at increasingly higher resolutions. A key step in this process is fitting multiple component structures into an EM-derived density map of their assembly. Here, we describe a web server for this task. The server takes as input a set of protein structures in the PDB format and an EM density map in the MRC format. The output is an ensemble of models ranked by their quality of fit to the density map. The models can be viewed online or downloaded from the website. The service is available at; http://salilab.org/multifit/ and http://bioinfo3d.cs.tau.ac.il/. \u00a9 2011 The Author(s).","authors":[{"name":"Lasker K."},{"name":"Sali A."},{"name":"Tjioe E."},{"name":"Webb B."},{"name":"Wolfson H.J."}],"citationCount":22,"date":"2011-07-01T00:00:00Z","journal":"Nucleic Acids Research","title":"MultiFit: A web server for fitting multiple protein structures into their electron microscopy density map"},"pmid":"21715383"}],"topic":[{"term":"Electron microscopy","uri":"http://edamontology.org/topic_0611"},{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Molecular modelling","uri":"http://edamontology.org/topic_2275"},{"term":"Protein structure analysis","uri":"http://edamontology.org/topic_2814"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:multifit/web/modbase.compbio.ucsf.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true,"help":true},"publications":[{"entries":[{"cit_count":16,"citations":[{"count":1,"year":"2014"},{"count":1,"year":"2015"},{"count":1,"year":"2017"},{"count":1,"year":"2021"},{"count":1,"year":"2024"},{"count":2,"year":"2016"},{"count":2,"year":"2018"},{"count":2,"year":"2019"},{"count":2,"year":"2023"},{"count":3,"year":"2013"}],"doi":"10.1093/nar/gkr490","pmcid":"PMC3125811","pmid":"21715383","ref_count":33,"refs":[{"count":1,"year":"1995"},{"count":1,"year":"2000"},{"count":1,"year":"2003"},{"count":1,"year":"2007"},{"count":2,"year":"-1"},{"count":2,"year":"2002"},{"count":2,"year":"2005"},{"count":2,"year":"2008"},{"count":2,"year":"2011"},{"count":3,"year":"2001"},{"count":3,"year":"2009"},{"count":4,"year":"2006"},{"count":9,"year":"2010"}],"title":"MultiFit: a web server for fitting multiple protein structures into their electron microscopy density map.","