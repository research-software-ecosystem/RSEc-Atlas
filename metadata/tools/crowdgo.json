{"tool_name":"crowdgo","contents":["biotools","oeb"],"identifiers":["biotools:crowdgo"],"fetched_metadata":{"biotools":{"id":"CrowdGO","home":"https://gitlab.com/mreijnders/CrowdGO","license":"GPL-3.0","summary":"A wisdom of the crowd-based Gene Ontology annotation tool | Abstract Motivation Protein function prediction tools vary widely in their methodologies, resulting in different sets of GO terms being correctly predicted. Ideally, multiple tools are combined to achieve a higher recall of GO terms while increasing precision. Results CrowdGO combines input predictions from any number of tools and combines them based on the Gene Ontology Directed Acyclic Graph. Using each GO terms information content, the semantic similarity between GO predictions of different tools, and a Support Vector Machine model, it achieves improved precision and recall compared to each of the tools separately (Figure 1). Availability CrowdGO can be found at https: gitlab.com mreijnders CrowdGO","addition_date":"2019-11-14T18:13:04Z","last_update_date":"2026-11-12T14:25:44.556481Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:CrowdGO","credit":[{"email":"mreijnders@live.nl","name":"Maarten Reijnders","orcidid":"https://orcid.org/0000-0002-5657-4762","typeEntity":"Person"}],"edit_permission":{"type":"public"},"name":"CrowdGO","owner":"Pub2Tools","publication":[{"doi":"10.1101/731596","type":["Preprint"]},{"doi":"10.1371/journal.pcbi.1010075","type":["Primary"]}],"topic":[{"term":"Ecology","uri":"http://edamontology.org/topic_0610"},{"term":"Ontology and terminology","uri":"http://edamontology.org/topic_0089"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:crowdgo/cmd/gitlab.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications