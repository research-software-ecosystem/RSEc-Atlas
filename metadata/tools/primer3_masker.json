{"tool_name":"primer3_masker","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"primer3_masker","home":"https://github.com/bioinfo-ut/primer3_masker","license":"GPL-3.0","summary":"A sequence masking tool, both Primer3 integrated and standalone variants.","addition_date":"2018-06-28T14:57:56Z","last_update_date":"2024-11-25T14:44:28.232713Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:primer3_masker","credit":[{"email":"maido.remm@ut.ee","name":"Maido Remm","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/bioinfo-ut/primer3_masker"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"PCR primer design","uri":"http://edamontology.org/operation_0308"}]}],"name":"Primer3_masker","operating_system":["Linux"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1093/bioinformatics/bty036","metadata":{"abstract":"Designing PCR primers for amplifying regions of eukaryotic genomes is a complicated task because the genomes contain a large number of repeat sequences and other regions unsuitable for amplification by PCR. We have developed a novel k-mer based masking method that uses a statistical model to detect and mask failure-prone regions on the DNA template prior to primer design. We implemented the software as a standalone software primer3-masker and integrated it into the primer design program Primer3.","authors":[{"name":"Andreson R."},{"name":"Kaplinski L."},{"name":"Koressaar T."},{"name":"Lepamets M."},{"name":"Raime K."},{"name":"Remm M."}],"citationCount":296,"date":"2018-06-01T00:00:00Z","journal":"Bioinformatics","title":"Primer3-masker: Integrating masking of template sequence with primer design software"},"pmid":"29360956"}],"topic":[{"term":"PCR experiment","uri":"http://edamontology.org/topic_3519"},{"term":"Probes and primers","uri":"http://edamontology.org/topic_0632"},{"term":"Sequence analysis","uri":"http://edamontology