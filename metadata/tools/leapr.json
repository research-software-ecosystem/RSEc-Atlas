{"tool_name":"leapr","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"leapr","home":"https://github.com/biodataganache/leapR","summary":"An R Package for Multiomic Pathway Analysis\nLayered Enrichment Analysis of Pathways in R (leapR) a tool that carries out statistical enrichment analysis on single- or multi-omics data.","addition_date":"2021-05-28T06:58:29Z","last_update_date":"2024-11-24T20:22:02.461586Z","tool_type":["Library"],"accessibility":"Open access","biotools_curie":"biotools:leapr","cost":"Free of charge","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Enrichment analysis","uri":"http://edamontology.org/operation_3501"},{"term":"Pathway analysis","uri":"http://edamontology.org/operation_3928"},{"term":"Principal component analysis","uri":"http://edamontology.org/operation_3960"}]}],"name":"leapR","owner":"Niclaskn","publication":[{"doi":"10.1021/acs.jproteome.0c00963","metadata":{"abstract":"A generalized goal of many high-throughput data studies is to identify functional mechanisms that underlie observed biological phenomena, whether they be disease outcomes or metabolic output. Increasingly, studies that rely on multiple sources of high-throughput data (genomic, transcriptomic, proteomic, metabolomic) are faced with a challenge of summarizing the data to generate testable hypotheses. However, this requires a time-consuming process to evaluate numerous statistical methods across numerous data sources. Here, we introduce the leapR package, a framework to rapidly assess biological pathway activity using diverse statistical tests and data sources, allowing facile integration of multisource data. The leapR package with a user manual and example workflow is available for download from GitHub (https://github.com/biodataganache/leapR).","authors":[{"name":"Anderson L."},{"name":"Danna V."},{"name":"Godinez I."},{"name":"Gosline S.J.C."},{"name":"McDermott J.E."},{"name":"Mitchell H."},{"name":"Teeguarden J."}],"citationCount":5,"date":"2021-04-02T00:00:00Z","journal":"Journal of Proteome Research","title":"LeapR: An R Package for Multiomic Pathway Analysis"},"pmcid":"PMC9000964","pmid":"33703901"}],"topic":[{"term":"Endocrinology and metabolism","uri":"http://edamontology.org/topic_3407"},{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}]},"bioschemas":{"name":"leapR","home":"https://bio.tools/leapr","summary":"An R Package for Multiomic Pathway Analysis\nLayered Enrichment Analysis of Pathways in R (leapR) a tool that carries out statistical enrichment analysis on single- or multi-omics data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:leapr/lib/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":6,"citations":[{"count":2,"year":"2022"},{"count":2,"year":"2023"},{"count":2,"year":"2026"}],"doi":"10.1021/acs.jproteome.0c00963","pmcid":"PMC9000964","pmid":"33703901","ref_count":19,"refs":[{"count":1,"year":"2004"},{"count":1,"year":"2005"},{"count":1,"year":"2007"},{"count":1,"year":"2008"},{"count":1,"year":"2010"},{"count":1,"year":"2012"},{"count":1,"year":"2014"},{"count":1,"year":"2017"},{"count":1,"year":"2018"},{"count":2,"year":"2016"},{"count":3,"year":"2020"},{"count":5,"year":"2019"}],"title":"leapR: An R Package for Multiomic Pathway Analysis.","ye