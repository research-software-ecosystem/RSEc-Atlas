{"tool_name":"j-express","contents":["biotools","oeb"],"identifiers":["biotools:j-express"],"fetched_metadata":{"biotools":{"id":"j-express","home":"https://jexpress.resonalis.com/","summary":"J-Express is a browser-based platform for interactive exploration and analysis of multidimensional scientific data. Originally developed for gene expression analysis, J-Express now supports bulk and single-cell RNA-seq workflows, principal component analysis (PCA), correspondence analysis, clustering, heatmaps, feature selection, and visualization of high-dimensional embeddings.\n\nThe platform combines interactive visualizations with statistical analysis and optional AI-assisted workflows through the Model Context Protocol (MCP). Analyses run locally in the browser, and the application can be used without programming.","addition_date":"2017-12-18T00:07:56Z","last_update_date":"2026-11-16T08:37:34.253541Z","tool_type":["Web application"],"version":["2026"],"biotools_curie":"biotools:j-express","cost":"Free of charge","credit":[{"email":"bjarte.dysvik@gmail.com","name":"Bjarte Dysvik","orcidid":"https://orcid.org/0009-0003-5350-8895","typeEntity":"Person","typeRole":["Primary contact"],"url":"https://resonalis.com/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"}]},{"operation":[{"term":"Differential gene expression profiling","uri":"http://edamontology.org/operation_3223"}]},{"operation":[{"term":"Dimensionality reduction","uri":"http://edamontology.org/operation_3935"}]},{"operation":[{"term":"Gene expression profiling","uri":"http://edamontology.org/operation_0314"}]},{"operation":[{"term":"Gene-set enrichment analysis","uri":"http://edamontology.org/operation_2436"}]},{"operation":[{"term":"Principal component analysis","uri":"http://edamontology.org/operation_3960"}]},{"operation":[{"term":"Principal component visualisation","uri":"http://edamontology.org/operation_2939"}]},{"operation":[