{"tool_name":"pals-v","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"pals-v","home":"https://pals.glasgowcompbio.org/","summary":"Decomposing metabolite set activity levels with PALS.\n\nPathway analysis is an important task in understanding complex metabolomic data. Here we introduce PALS (Pathway Activity Level Scoring), a complete tool that performs database queries of pathways, decomposes activity levels in pathways via the PLAGE method, as well as presents the results in a user-friendly manner. The results are found to be more robust to noise and missing peaks compared to the alternatives (ORA, GSEA). This is particularly important for metabolomics peak data, where noise and missing peaks are prevalent.","addition_date":"2021-01-18T09:36:20Z","last_update_date":"2021-03-15T14:51:11Z","tool_type":["Web application"],"biotools_curie":"biotools:pals-v","credit":[{"email":"ronan.daly@glasgow.ac.uk","name":"R\u00f3n\u00e1n Daly","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Expression profile pathway mapping","uri":"http://edamontology.org/operation_0533"},{"term":"Gene-set enrichment analysis","uri":"http://edamontology.org/operation_2436"},{"term":"Metabolic pathway prediction","uri":"http://edamontology.org/operation_3929"},{"term":"Natural product identification","uri":"http://edamontology.org/operation_3803"}]}],"name":"PALS-V","owner":"Niclaskn","publication":[{"doi":"10.1101/2020.06.07.138974"}],"topic":[{"term":"Endocrinology and metabolism","uri":"http://edamontology.org/topic_3407"},{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Plant biology","uri":"http://edamontology.org/topic_0780"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}]},"bioschemas":{"name":"PALS-V","home":"https://bio.tools/pals-v","summary":"Decomposing metabolite set activity levels with PALS.\n\nPathway analysis is an important task in understanding complex metabolomic data. Here we introduce PALS (Pathway Activity Level Scoring), a complete tool that performs database queries of pathways, decomposes activity levels in pathways via the PLAGE method, as well as presents the results in a user-friendly manner. The results are found to be more robust to noise and missing peaks compared to the alternatives (ORA, GSEA). This is particularly important for metabolomics peak data, where noise and missing peaks are prevalent.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pals-v/web/pals.glasgowcompbio.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1101/2020.06.07.138974","ref_count":0,"refs":[]}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://pals.glasgowcompbio.org/"},{"status":301,"url":"https://pals.glasgowcompbio.org/"},{"status":301,"url":"https://pals.glasgowcompbio.org/"},{"status":301,"url":"https://pals.glasgowcompbio.org/"},{"status":301,"url":"https://pals.glasgowcompbio.org/"},{"status":301,"url":"https://pals.glasgowcompbio.org/"},{"status":301,"url":"https://pals.glasgowcompbio.org/"},{"status":301,"url":"https://pals.glasgowcompbio.org/"},{"status":301,"url":"https://pals.glasgowcompbio.org/"},{"status":301,"url":"https://pals.glasgowcompbio.org/"}],"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/pals-v","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"descriptio