{"tool_name":"photomodplus","contents":["biotools","oeb"],"identifiers":["biotools:photomodplus"],"fetched_metadata":{"biotools":{"id":"photomodplus","home":"http://bicep.kmutt.ac.th/photomod","summary":"A webserver for photosynthetic protein prediction from a genome neighborhood feature.\n\nMulti-label classifier for predicting photosynthetic protein via genome neighborhood feature.\n\nA Tool for Exploring Photosynthetic functions and evolution.\n\nPhotoModPlus is a genome neighborhood-based platform for exploring photosynthetic functions and evolution in photosynthetic prokaryotes. Currently, there are two main applications inside, PhotoModPlus GNN and PhotoModPlus Prediction. *User can access this site on a mobile phone, tablet, desktop computer or wide-screen.","addition_date":"2021-01-18T09:01:04Z","last_update_date":"2026-11-12T14:37:55.184845Z","biotools_curie":"biotools:photomodplus","credit":[{"email":"marasri.rue@kmutt.ac.th","name":"Marasri Ruengjitchatchawalya","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Protein feature detection","uri":"http://edamontology.org/operation_3092"},{"term":"Protein function prediction","uri":"http://edamontology.org/operation_1777"},{"term":"Protein modelling","uri":"http://edamontology.org/operation_0477"}]}],"name":"PhotoModPlus","owner":"zsmag19","publication":[{"doi":"10.1101/2020.05.10.087635","type":["Preprint"]},{"doi":"10.1371/journal.pone.0248682","type":["Primary"]}],"topic":[{"term":"Evolutionary biology","uri":"http://edamontology.org/topic_3299"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:photomodplus/undefined/bicep.kmutt.ac.th","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpret