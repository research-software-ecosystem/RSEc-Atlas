{"tool_name":"basics","contents":["bioconda","bioconductor","bioschemas","biotools","oeb"],"identifiers":["biotools:basics","bioconductor:basics","bioconda:bioconductor-basics"],"fetched_metadata":{"biotools":{"id":"basics","home":"https://bioconductor.org/packages/BASiCS","license":"GPL-3.0","summary":"Bayesian Analysis of Single-Cell Sequencing data is an integrated Bayesian hierarchical model to perform statistical analyses of single-cell RNA sequencing datasets in the context of supervised experiments. It could perform built-in data normalisation and technical noise quantification. BASiCS provides an intuitive detection criterion for highly variable genes within a single group of cells. Also, it can compare gene expression patterns between two or more pre-specified groups of cells.","addition_date":"2018-06-25T07:11:57Z","last_update_date":"2026-10-02T15:52:40.152478Z","tool_type":["Library"],"version":["2.24.0"],"collections":["BioConductor"],"biotools_curie":"biotools:basics","credit":[{"name":"Alan O'Callaghan","typeEntity":"Person","typeRole":["Developer"]},{"name":"Catalina Vallejos","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"John Marioni","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Nils Eling","typeEntity":"Person","typeRole":["Developer"]},{"name":"Sylvia Richardson","typeEntity":"Person","typeRole":["Contributor"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/BASiCS"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Differential gene expression profiling","uri":"http://edamontology.org/operation_3223"}]},{"operation":[{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"BASiCS","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[{"doi":"10.1186/s13059-016-0930-3","pmcid":"PMC4832562","pmid":"27083558","type":["Other"]},{"doi":"10.1371/journal.pcbi.1004333","pmcid":"PMC4480965","pmid":"26107944","type":["Primary"]},{"doi":"10.1101/237214","type":["Other"]}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"BASiCS","home":"https://bio.tools/basics","license":"GPL-3.0","version":"2.24.0","summary":"Bayesian Analysis of Single-Cell Sequencing data is an integrated Bayesian hierarchical model to perform statistical analyses of single-cell RNA sequencing datasets in the context of supervised experiments. It could perform built-in data normalisation and technical noise quantification. BASiCS provides an intuitive detection criterion for highly variable genes within a single group of cells. Also, it can compare gene expression patterns between two or more pre-specified groups of cells.","tool_type":"sc:SoftwareApplication"},"bioconductor":{"name":"BASiCS","version":"2.24.0","license":"GPL-3","summary":"Bayesian Analysis of Single-Cell Sequencing data","description":"Single-cell mRNA sequencing can uncover novel cell-to-cell heterogeneity in gene expression levels in seemingly homogeneous populations of cells. However, these experiments are prone to high levels of technical noise, creating new challenges for identifying genes that show genuine heterogeneous expression within the population of cells under study. BASiCS (Bayesian Analysis of Single-Cell Sequencing data) is an integrated Bayesian hierarchical model to perform statistical analyses of single-cell RNA sequencing datasets in the context of supervised experiments (where the groups of cells of interest are known a priori, e.g. experimental conditions or cell types). BASiCS performs built-in data normalisation (global scaling) and technical noise quantification (based on spike-in genes). BASiCS provides an intuitive detection criterion for highly (or lowly) variable genes within a single group of cells. Additionally, BASiCS can compare gene expression patterns between two or more pre-specified groups of cells. Unlike traditional differential expression tools, BASiCS quantifies changes in expression that lie beyond comparisons of means, also allowing the study of changes in cell-to-cell heterogeneity. The latter can be quantified via a biological over-dispersion parameter that measures the excess of variability that is observed with respect to Poisson sampling noise, after normalisation and technical noise removal. Due to the strong mean/over-dispersion confounding that is typically observed for scRNA-seq datasets, BASiCS also tests for changes in residual over-dispersion, defined by residual values with respect to a global mean/over-dispersion trend.","home":"https://github.com/catavallejos/BASiCS","author":"Catalina Vallejos [aut, cre] (ORCID: <https://orcid.org/0000-0003-3638-1960>), Nils Eling [aut], Alan O'Callaghan [aut], Sylvia Richardson [ctb], John Marioni [ctb]","maintainer":"Catalina Vallejos <catalina.vallejos@igmm.ed.ac.uk>","bioc_views":["Bayesian","CellBiology","DifferentialExpression","GeneExpression","ImmunoOncology","Normalization","RNASeq","Sequencing","SingleCell","Software","Transcriptomics"],"git_url":"https://git.bioconductor.org/packages/BASiCS","last_commit_date":"2026-04-28"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:basics:1.2.1/lib/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"source_packages":true,"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1101/237214","pmcid":null,"pmid":null,"ref_count":0,"refs