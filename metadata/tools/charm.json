{"tool_name":"charm","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"charm","home":"http://bioconductor.org/packages/release/bioc/html/charm.html","license":"GPL-2.0","summary":"This package implements analysis tools for DNA methylation data generated using Nimblegen microarrays and the McrBC protocol. It finds differentially methylated regions between samples, calculates percentage methylation estimates and includes array quality assessment tools.","addition_date":"2017-01-17T15:02:53Z","last_update_date":"2018-12-29T15:03:54Z","tool_type":["Command-line tool","Library"],"version":["2.20.0"],"collections":["BioConductor"],"biotools_curie":"biotools:charm","credit":[{"email":"pmurakam@jhu.edu","name":"Peter Murakami","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/html/charm.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Methylation analysis","uri":"http://edamontology.org/operation_3204"}]}],"name":"charm","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1093/biostatistics/kxq055","metadata":{"abstract":"DNA methylation is a key regulator of gene function in a multitude of both normal and abnormal biological processes, but tools to elucidate its roles on a genome-wide scale are still in their infancy. Methylation sensitive restriction enzymes and microarrays provide a potential high-throughput, low-cost platform to allow methylation profiling. However, accurate absolute methylation estimates have been elusive due to systematic errors and unwanted variability. Previous microarray preprocessing procedures, mostly developed for expression arrays, fail to adequately normalize methylation-related data since they rely on key assumptions that are violated in the case of DNA methylation. We develop a normalization strategy tailored to DNA methylation data and an empirical Bayes percentage methylation estimator that together yield accurate absolute methylation estimates that can be compared across samples. We illustrate the method on data generated to detect methylation differences between tissues and between normal and tumor colon samples. \u00a9 2010 The Author.","authors":[{"name":"Aryee M.J."},{"name":"Feinberg A.P."},{"name":"Herb B."},{"name":"Irizarry R.A."},{"name":"Ladd-Acosta C."},{"name":"Wu Z."},{"name":"Yegnasubramanian S."}],"citationCount":57,"date":"2011-04-01T00:00:00Z","journal":"Biostatistics","title":"Accurate genome-scale percentage DNA methylation estimates from microarray data"},"pmcid":"PMC3062148","pmid":"20858772","type":["Primary"]}],"topic":[{"term":"Methylated DNA immunoprecipitation","uri":"http://edamontology.org/topic_3674"},{"term":"Microarray experiment","uri":"http://edamontology.org/topic_3518"}],"validated":1},"bioschemas":{"name":"charm","home":"https://bio.tools/charm","license":"GPL-2.0","version":"2.20.0","summary":"This package implements analysis tools for DNA methylation data generated using Nimblegen microarrays and the McrBC protocol. It finds differentially methylated regions between samples, calculates percentage methylation estimates and includes array quality assessment tools.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:charm:2.20.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":47,"citations":[{"count":1,"year":"2010"},{"count":1,"year":"2020"},{"count":1,"year":"2021"},{"count":1,"year":"2023"},{"count":2,"year":"2017"},{"count":3,"year":"2011"},{"count":3,"year":"2018"},{"count":5,"year":"2015"},{"count":6,"yea