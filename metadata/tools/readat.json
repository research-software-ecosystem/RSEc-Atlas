{"tool_name":"readat","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"readat","home":"http://bioconductor.org/packages/release/bioc/html/readat.html","license":"GPL-3.0","summary":"This package contains functionality to import, transform and annotate data from ADAT files generated by the SomaLogic SOMAscan platform.","addition_date":"2017-01-17T15:01:37Z","last_update_date":"2019-07-19T17:57:22Z","tool_type":["Command-line tool","Library"],"version":["1.0.0"],"collections":["BioConductor","Proteomics"],"biotools_curie":"biotools:readat","credit":[{"email":"richierocks@gmail.com","name":"Richard Cotton","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"Johannes Graumann","orcidid":"http://orcid.org/0000-0002-3015-5850","typeEntity":"Person","typeRole":["Contributor"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/html/readat.html"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"operation":[{"term":"Differential protein expression analysis","uri":"http://edamontology.org/operation_3741"},{"term":"Sequence annotation","uri":"http://edamontology.org/operation_0361"}]}],"name":"readat","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1186/s12859-016-1007-8","metadata":{"abstract":"\u00a9 2016 Cotton et al.Background: SomaLogic's SOMAscan\u2122 assay platform allows the analysis of the relative abundance of over 1300 proteins directly from biological matrices such as blood plasma and serum. The data resulting from the assay is provided in a proprietary text-based format not easily imported into R. Results: readat is an R package for working with the SomaLogic ADAT file format. It provides functionality for importing, transforming and annotating data from these files. The package is free, open source, and available on Bioconductor and Bitbucket. Conclusions:readat integrates into both Bioconductor and traditional R workflows, rendering it easy to make use of ADAT files.","authors":[{"name":"Cotton R.J."},{"name":"Graumann J."}],"citationCount":5,"date":"2016-05-04T00:00:00Z","journal":"BMC Bioinformatics","title":"readat: An R package for reading and working with SomaLogic ADAT files"},"pmcid":"PMC4857291","pmid":"27146037","type":["Primary"]}],"topic":[{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"}],"validated":1},"bioschemas":{"name":"readat","home":"https://bio.tools/readat","license":"GPL-3.0","version":"1.0.0","summary":"This package contains functionality to import, transform and annotate data from ADAT files generated by the SomaLogic SOMAscan platform.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:readat:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":12,"citations":[{"count":1,"year":"2017"},{"count":1,"year":"2018"},{"count":1,"year":"2019"},{"count":1,"year":"2020"},{"count":1,"year":"2021"},{"count":2,"year":"2024"},{"count":2,"year":"2025"},{"count":3,"year":"2022"}],"doi":"10.1186/s12859-016-1007-8","pmcid":"PMC4857291","pmid":"27146037","ref_count":11,"refs":[{"count":1,"year":"1989"},{"count":1,"year":"2006"},{"count":1,"year":"2008"},{"count":1,"year":"2009"},{"count":1,"year":"2010"},{"count":2,"year":"1990"},{"count":2,"year":"1991"},{"count":2,"year":"2015"}],"title":"readat: An R package for reading and working with SomaLogic ADAT files.","year":2016}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":404,"redirects":[{"status":301,"url":"https://bioconductor.org/packages/release/b