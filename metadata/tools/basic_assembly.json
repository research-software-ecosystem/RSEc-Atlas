{"tool_name":"basic_assembly","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"basic_assembly","home":"http://ttic.uchicago.edu/~aakhan/BASIC/","license":"MIT","summary":"Semi-de novo assembly method for assembling BCR and TCR genes from single cell RNA-seq data.","addition_date":"2018-12-01T11:19:09Z","last_update_date":"2018-12-10T12:59:01Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:basic_assembly","cost":"Free of charge","credit":[{"email":"aakhan@ttic.edu","name":"Aly Azeem Khan","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://ttic.uchicago.edu/~aakhan/BASIC/"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"RNA sequence","uri":"http://edamontology.org/data_3495"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}],"operation":[{"term":"Sequence assembly","uri":"http://edamontology.org/operation_0310"}],"output":[{"data":{"term":"Sequence","uri":"http://edamontology.org/data_2044"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}]}],"maturity":"Emerging","name":"BASIC","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"doi":"10.1093/bioinformatics/btw631","metadata":{"abstract":"\u00a9 2016 The Author 2016. Published by Oxford University Press.Motivation: The B-cell receptor enables individual B cells to identify diverse antigens, including bacterial and viral proteins. While advances in RNA-sequencing (RNA-seq) have enabled high throughput profiling of transcript expression in single cells, the unique task of assembling the full-length heavy and light chain sequences from single cell RNA-seq (scRNA-seq) in B cells has been largely unstudied. Results: We developed a new software tool, BASIC, which allows investigators to use scRNA-seq for assembling BCR sequences at single-cell resolution. To demonstrate the utility of our software, we subjected nearly 200 single human B cells to scRNA-seq, assembled the full-length heavy and the light chains, and experimentally confirmed these results by using single-cell primer-based nested PCRs and Sanger sequencing. Availability and Implementation: http://ttic.uchicago.edu/\u223caakhan/BASIC Contact: Aakhan@ttic.edu Supplementary information: Supplementary data are available at Bioinformatics online.","authors":[{"name":"Canzar S."},{"name":"Khan A.A."},{"name":"Neu K.E."},{"name":"Tang Q."},{"name":"Wilson P.C."}],"citationCount":36,"date":"2017-02-01T00:00:00Z","journal":"Bioinformatics","title":"BASIC: BCR assembly from single cells"}}],"topic":[{"term":"Immunoproteins, genes and antigens","uri":"http://edamontology.org/topic_2830"},{"term":"RNA-seq","uri":"http://edamontology.org/topic_3170"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"}],"validated":1},"bioschemas":{"name":"BASIC","home":"https://bio.tools/basic_assembly","license":"MIT","summary":"Semi-de novo assembly method for assembling BCR and TCR genes from single cell RNA-seq data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:basic_assembly/cmd/ttic.uchicago.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":55,"citations":[{"count":2,"year":"2026"},{"count":3,"year":"2017"},{"count":3,"year":"2025"},{"count":5,"year":"2021"},{"count":5,"year":"2022"},{"count":6,"year":"2024"},{"count":7,"year":"2019"},{"count":7,"year":"2020"},{"count":8,"year":"2023"},{