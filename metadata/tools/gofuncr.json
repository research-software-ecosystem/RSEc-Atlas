{"tool_name":"gofuncr","contents":["bioconda","bioconductor","bioschemas","biotools","oeb"],"identifiers":["biotools:gofuncr","bioconductor:gofuncr","bioconda:bioconductor-gofuncr"],"fetched_metadata":{"biotools":{"id":"gofuncr","home":"https://bioconductor.org/packages/GOfuncR","license":"GPL-2.0-or-later","summary":"It performs a gene ontology enrichment analysis based on the ontology enrichment software FUNC. GO-annotations are obtained from OrganismDb or OrgDb packages; the GO-graph is included in the package and updated regularly. GOfuncR provides the standard candidate vs. background enrichment analysis using the hypergeometric test, as well as three additional tests.","addition_date":"2018-07-09T13:30:08Z","last_update_date":"2026-10-02T15:58:55.560286Z","tool_type":["Library"],"version":["1.31.0"],"collections":["BioConductor"],"biotools_curie":"biotools:gofuncr","credit":[{"name":"Steffi Grote"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/GOfuncR"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Annotation","uri":"http://edamontology.org/operation_0226"}]},{"operation":[{"term":"Gene-set enrichment analysis","uri":"http://edamontology.org/operation_2436"}]}],"name":"GOfuncR","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[{"doi":"10.18129/B9.bioc.GOfuncR"}],"topic":[{"term":"Ontology and terminology","uri":"http://edamontology.org/topic_0089"}],"validated":1},"bioschemas":{"name":"GOfuncR","home":"https://bio.tools/gofuncr","license":"GPL-2.0-or-later","version":"1.31.0","summary":"It performs a gene ontology enrichment analysis based on the ontology enrichment software FUNC. GO-annotations are obtained from OrganismDb or OrgDb packages; the GO-graph is included in the package and updated regularly. GOfuncR provides the standard candidate vs. background enrichment analysis using the hypergeometric test, as well as three additional tests.","tool_type":"sc:SoftwareApplication"},"bioconductor":{"name":"GOfuncR","version":"1.31.0","license":"GPL (>= 2)","summary":"Gene ontology enrichment using FUNC","description":"GOfuncR performs a gene ontology enrichment analysis based on the ontology enrichment software FUNC. GO-annotations are obtained from OrganismDb or OrgDb packages ('Homo.sapiens' by default); the GO-graph is included in the package and updated regularly (01-May-2021). GOfuncR provides the standard candidate vs. background enrichment analysis using the hypergeometric test, as well as three additional tests: (i) the Wilcoxon rank-sum test that is used when genes are ranked, (ii) a binomial test that is used when genes are associated with two counts and (iii) a Chi-square or Fisher's exact test that is used in cases when genes are associated with four counts. To correct for multiple testing and interdependency of the tests, family-wise error rates are computed based on random permutations of the gene-associated variables. GOfuncR also provides tools for exploring the ontology graph and the annotations, and options to take gene-length or spatial clustering of genes into account. It is also possible to provide custom gene coordinates, annotations and ontologies.","author":"Steffi Grote","maintainer":"Steffi Grote <grote.steffi@gmail.com>","bioc_views":["GO","GeneSetEnrichment","Software"],"git_url":"https://git.bioconductor.org/packages/GOfuncR","last_commit_date":"2025-10-29"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:gofuncr:1.0.0/lib/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"source_packages":true,"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":null,"pmcid":null,"pmid":null,"ref_count":0,"refs":[],"title":nu