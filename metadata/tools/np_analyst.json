{"tool_name":"np_analyst","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"np_analyst","home":"http://www.npanalyst.org","license":"MIT","summary":"NP Analyst is a platform-independent tool for integrating bio-activity data with metabolomics data.","addition_date":"2022-07-06T14:56:25.613228Z","last_update_date":"2022-07-06T14:56:25.615848Z","tool_type":["Command-line tool","Web application"],"accessibility":"Open access","biotools_curie":"biotools:np_analyst","cost":"Free of charge","credit":[{"email":"rliningt@sfu.ca","name":"Roger G. Linington","orcidid":"https://orcid.org/0000-0003-1818-4971","typeEntity":"Person"},{"name":"Sanghoon Lee"},{"name":"Tim U. H. Baumeister"},{"name":"Weng Ruh Wong"}],"documentation":[{"type":["User manual"],"url":"https://liningtonlab.github.io/npanalyst_documentation/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Formatting","uri":"http://edamontology.org/operation_0335"},{"term":"Mapping","uri":"http://edamontology.org/operation_2429"},{"term":"Spectrum calculation","uri":"http://edamontology.org/operation_3860"}]}],"name":"NP Analyst","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1021/ACSCENTSCI.1C01108","metadata":{"abstract":"\u00a9 2022 The Authors. Published by American Chemical SocietyFew tools exist in natural products discovery to integrate biological screening and untargeted mass spectrometry data at the library scale. Previously, we reported Compound Activity Mapping as a strategy for predicting compound bioactivity profiles directly from primary screening results on extract libraries. We now present NP Analyst, an open online platform for Compound Activity Mapping that accepts bioassay data of almost any type, and is compatible with mass spectrometry data from major instrument manufacturers via the mzML format. In addition, NP Analyst will accept processed mass spectrometry data from the MZmine 2 and GNPS open-source platforms, making it a versatile tool for integration with existing discovery workflows. We demonstrate the utility of this new tool for both the dereplication of known compounds and the discovery of novel bioactive natural products using a challenging low-resolution antimicrobial bioassay data set. This new platform is available at www.npanalyst.org.","authors":[{"name":"Baumeister T.U.H."},{"name":"Farzaneh N."},{"name":"Lee S."},{"name":"Linington R.G."},{"name":"Liu D.Y."},{"name":"Pye C.R."},{"name":"Wong W.R."},{"name":"van Santen J.A."}],"date":"2022-02-23T00:00:00Z","journal":"ACS Central Science","title":"NP Analyst: An Open Online Platform for Compound Activity Mapping"},"pmcid":"PMC8874762","pmid":"35233454"}],"topic":[{"term":"Compound libraries and screening","uri":"http://edamontology.org/topic_3343"},{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}],"validated":1},"bioschemas":{"name":"NP Analyst","home":"https://bio.tools/np_analyst","license":"MIT","summary":"NP Analyst is a platform-independent tool for integrating bio-activity data with metabolomics data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:np_analyst/cmd/www.npanalyst.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":28,"citations":[{"count