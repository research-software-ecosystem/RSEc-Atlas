{"tool_name":"rnablueprint","contents":["biocontainers","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"rnablueprint","version":"1.3.3","home":"https://github.com/ViennaRNA/RNAblueprint","documentation":"https://viennarna.github.io/RNAblueprint","license":"GPL-3.0-or-later","summary":"The RNAblueprint library solves the problem of uniformly sampling RNA/DNA sequences compatible to multiple structural constraints and sequence constraints.","identifiers":["biotools:rnablueprint","doi:10.1093/bioinformatics/btx263"],"build":{"number":0,"run_exports":[null]},"requirements":{"build":["make",null,"automake","autoconf","libtool","pkg-config","gnuconfig"],"host":["swig","boost-cpp","python","perl","gmp"],"run":["python","boost-cpp","gmp"]},"source_url":"https://github.com/ViennaRNA/RNAblueprint/archive/refs/tags/v1.3.3.tar.gz","test":{"commands":["echo '.' | RNAblueprint -n 1"]}},"biocontainers":{"name":"rnablueprint","identifiers":["biotools:rnablueprint","doi:10.1093/bioinformatics/btx263"],"license":"GPL-3.0","summary":"The RNAblueprint library solves the problem of uniformly sampling RNA/DNA sequences compatible to multiple structural constraints and sequence constraints.","home_url":"https://github.com/ViennaRNA/RNAblueprint","keywords":["Models, Molecular","Nucleic Acid Conformation","RNA","Synthetic Biology","Nucleic acids","Data visualisation"],"manually_check":true,"total_pulls":0},"biotools":{"id":"rnablueprint","home":"https://github.com/ViennaRNA/RNAblueprint","summary":"Flexible multiple target nucleic acid sequence design.","addition_date":"2018-06-07T15:28:35Z","last_update_date":"2024-11-25T14:39:21.952127Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:rnablueprint","credit":[{"email":"ivo@tbi.univie.ac.at","name":"Ivo L. Hofacker","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"s.hammer@univie.ac.at","name":"Stefan Hammer","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"sven@tbi.univie.ac.at","name":"Sven Findei\u00df","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/ViennaRNA/RNAblueprint"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Nucleic acid design","uri":"http://edamontology.org/operation_3095"}]}],"name":"RNAblueprint","operating_system":["Linux","Mac"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1093/bioinformatics/btx263","metadata":{"abstract":"Motivation: Realizing the value of synthetic biology in biotechnology and medicine requires the design of molecules with specialized functions. Due to its close structure to function relationship, and the availability of good structure prediction methods and energy models, RNA is perfectly suited to be synthetically engineered with predefined properties. However, currently available RNA design tools cannot be easily adapted to accommodate new design specifications. Furthermore, complicated sampling and optimization methods are often developed to suit a specific RNA design goal, adding to their inflexibility. Results: We developed a C library implementing a graph coloring approach to stochastically sample sequences compatible with structural and sequence constraints from the typically very large solution space. The approach allows to specify and explore the solution space in a well defined way. Our library also guarantees uniform sampling, which makes optimization runs performant by not only avoiding re-evaluation of already found solutions, but also by raising the probability of finding better solutions for long optimization runs. We show that our software can be combined with any other software package to allow diverse RNA design applications. Scripting interfaces allow the easy adaption of existing code to accommodate new scenarios, making the whole design process very flexible. We implemented example design approaches written in Python to demonstrate these advantages. Availability and implementation: RNAblueprint, Python implementations and benchmark datasets are available at github: https://github.com/ViennaRNA.","authors":[{"name":"Findeiss S."},{"name":"Flamm C."},{"name":"Hammer S."},{"name":"Hofacker I.L."},{"name":"Tschiatschek B."}],"citationCount":21,"date":"2017-09-15T00:00:00Z","journal":"Bioinformatics","title":"RNAblueprint: Flexible multiple target nucleic acid sequence design"},"pmcid":"PMC5870862","pmid":"28449031"}],"topic":[{"term":"Data visualisation","uri":"http://edamontology.org/topic_0092"},{"term":"Nucleic acids","uri":"http://edamontology.org/topic_0077"},{"term":"RNA","uri":"http://edamontology.org/topic_0099"}],"validated":1},"bioschemas":{"name":"RNAblueprint","home":"https://bio.tools/rnablueprint","summary":"Flexible multiple target nucleic acid sequence design.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:rnablueprint/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":false,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":10,"citations":[{"count":1,"year":"2017"},{"count":1,"year":"2019"},{"count":1,"year":"2024"},{"count":1,"year":"2026"},{"count":3,"year":"2021"},{"count":3,"year":"2025"}],"doi":"10.1093/bioinformatics/btx263","pmcid":"PMC5870862","pmid":"28449031","ref_count":22,"refs":[{"count":1,"year":"2001"},{"count":1,"year":"2004"},{"count":1,"year":"2008"},{"count":1,"year":"2010"},{"count":1,"year":"2016"},{"count":2,"year":"2011"},{"count":2,"year":"2013"},{"count":4,"year":"2012"},{"count":4,"year":"2015"},{"count":5,"year":"2014"}],"title":"RNAblueprint: fle