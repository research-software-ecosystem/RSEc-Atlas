{"tool_name":"bioconductor-struct","contents":["oeb","biocontainers","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-struct","identifiers":["doi:10.18129/b9.bioc.struct"],"license":"GPL-3","summary":"Statistics in R Using Class-based Templates","home_url":"https://bioconductor.org/packages/3.11/bioc/html/struct.html","keywords":[],"manually_check":true,"total_pulls":4},"biotools":{"id":"bioconductor-struct","home":"https://bioconductor.org/packages/struct","license":"GPL-3.0","summary":"Defines and includes a set of class-based templates for developing and implementing data processing and analysis workflows, with a strong emphasis on statistics and machine learning. The templates can be used and where needed extended to 'wrap' tools and methods from other packages into a common standardised structure to allow for effective and fast integration. Model objects can be combined into sequences, and sequences nested in iterators using overloaded operators to simplify and improve readability of the code. Ontology lookup has been integrated and implemented to provide standardised definitions for methods, inputs and outputs wrapped using the class-based templates.","addition_date":"2026-09-01T07:32:28.903196Z","last_update_date":"2026-09-13T07:26:35.023991Z","tool_type":["Command-line tool","Library"],"version":["1.24.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-struct","credit":[{"name":"Gavin Rhys Lloyd","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Ralf Johannes Maria Weber","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/struct"}],"edit_permission":{"type":"private"},"name":"struct","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.1093/bioinformatics/btaa1031"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-struct:1.0.0/cmd/bio