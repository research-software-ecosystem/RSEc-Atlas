{"tool_name":"genomicranges","contents":["bioschemas","debian","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"bioconductor-genomicranges","version":"1.62.1","home":"https://bioconductor.org/packages/3.22/bioc/html/GenomicRanges.html","license":"Artistic-2.0","summary":"Representation and manipulation of genomic intervals","identifiers":["biotools:genomicranges"],"description":"The ability to efficiently represent and manipulate genomic annotations and alignments is playing a central role when it comes to analyzing high-throughput sequencing data (a.k.a. NGS data). The GenomicRanges package defines general purpose containers for storing and manipulating genomic intervals and variables defined along a genome. More specialized containers for representing and manipulating short alignments against a reference genome, or a matrix-like summarization of an experiment, are defined in the GenomicAlignments and SummarizedExperiment packages, respectively. Both packages build on top of the GenomicRanges infrastructure.","build":{"number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"build":[null,"make"],"host":["bioconductor-biocgenerics >=0.56.0,<0.57.0","bioconductor-iranges >=2.44.0,<2.45.0","bioconductor-s4vectors >=0.48.0,<0.49.0","bioconductor-seqinfo >=1.0.0,<1.1.0","r-base","libblas","liblapack","zlib","liblzma-devel"],"run":["bioconductor-biocgenerics >=0.56.0,<0.57.0","bioconductor-iranges >=2.44.0,<2.45.0","bioconductor-s4vectors >=0.48.0,<0.49.0","bioconductor-seqinfo >=1.0.0,<1.1.0","r-base"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/GenomicRanges_1.62.1.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GenomicRanges/GenomicRanges_1.62.1.tar.gz","https://bioarchive.galaxyproject.org/GenomicRanges_1.62.1.tar.gz","https://depot.galaxyproject.org/software/bioconductor-genomicranges/bioconductor-genomicranges_1.62.1_src_all.tar.gz"],"test":{"commands":["$R -e \"library('GenomicRanges')\""]},"parent_recipe":{"name":"bioconductor-genomicranges","path":"recipes/bioconductor-genomicranges","version":"1.32.7"}},"biotools":{"id":"genomicranges","home":"https://bioconductor.org/packages/GenomicFeatures","license":"Artistic-2.0","summary":"Extract the genomic locations of genes, transcripts, exons, introns, and CDS, for the gene models stored in a TxDb object. A TxDb object is a small database that contains the gene models of a given organism/assembly. Bioconductor provides a small collection of TxDb objects in the form of ready-to-install TxDb packages for the most commonly studied organisms. Additionally, the user can easily make a TxDb object (or package) for the organism/assembly of their choice by using the tools from the txdbmaker package.","addition_date":"2017-01-17T14:58:17Z","last_update_date":"2026-08-31T21:26:46.219379Z","tool_type":["Command-line tool","Library"],"version":["1.64.0"],"collections":["BioConductor"],"biotools_curie":"biotools:genomicranges","credit":[{"name":"D. Sarkar","typeEntity":"Person","typeRole":["Developer"]},{"name":"D. Tenenbaum","typeEntity":"Person","typeRole":["Contributor"]},{"name":"D. Van Twisk","typeEntity":"Person","typeRole":["Contributor"]},{"name":"H. Pag\u00e8s","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"J. MacDonald","typeEntity":"Person","typeRole":["Contributor"]},{"name":"L. Shepherd","typeEntity":"Person","typeRole":["Contributor"]},{"name":"M. Carlson","typeEntity":"Person","typeRole":["Developer"]},{"name":"M. Lawrence","typeEntity":"Person","typeRole":["Developer"]},{"name":"M. Morgan","typeEntity":"Person","typeRole":["Developer"]},{"name":"M. Ramos","typeEntity":"Person","typeRole":["Contributor"]},{"name":"P. Aboyoun","typeEntity":"Person","typeRole":["Developer"]},{"name":"P. Shannon","typeEntity":"Person","typeRole":["Contributor"]},{"name":"S. Arora","typeEntity":"Person","typeRole":["Contributor"]},{"name":"S. Falcon","typeEntity":"Person","typeRole":[