{"tool_name":"cov-genome-tracker","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"cov-genome-tracker","home":"http://cov.genometracker.org","license":"BSD-3-Clause","summary":"CoV Genome Tracker is a web portal dedicated to trace Covid-19 outbreaks in real time using a haplotype network, an accurate and scalable representation of genomic changes in a rapidly evolving population. We resolve the direction of mutations by using a bat-associated genome as outgroup. At a broader evolutionary time scale, a companion browser provides gene-by-gene and codon-by-codon evolutionary rates to facilitate the search for molecular targets of clinical interventions.","addition_date":"2021-01-18T08:40:14Z","last_update_date":"2021-02-17T18:49:11Z","tool_type":["Web application"],"collections":["COVID-19"],"biotools_curie":"biotools:cov-genome-tracker","credit":[{"email":"dilie66@gmail.com","name":"Lia Di","typeEntity":"Person"},{"email":"weigang@genectr.hunter.cuny.edu","name":"Weigang Qiu","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Haplotype mapping","uri":"http://edamontology.org/operation_0487"},{"term":"Network visualisation","uri":"http://edamontology.org/operation_3925"},{"term":"Phylogenetic reconstruction","uri":"http://edamontology.org/operation_3478"},{"term":"Sequence trimming","uri":"http://edamontology.org/operation_3192"}]}],"name":"CoV Genome Tracker","owner":"Kigaard","publication":[{"doi":"10.1101/2020.04.10.036343"}],"topic":[{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Phylogeny","uri":"http://edamontology.org/topic_0084"},{"term":"Physics","uri":"http://edamontology.org/topic_3318"},{"term":"Public health and epidemiology","uri":"http://edamontology.org/topic_3305"}]},"bioschemas":{"name":"CoV Genome Tracker","home