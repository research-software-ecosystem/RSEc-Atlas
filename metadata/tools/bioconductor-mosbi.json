{"tool_name":"bioconductor-mosbi","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-mosbi","home":"https://bioconductor.org/packages/mosbi","license":"AGPL-3.0","summary":"This package is a implementation of biclustering ensemble method MoSBi (Molecular signature Identification from Biclustering). MoSBi provides standardized interfaces for biclustering results and can combine their results with a multi-algorithm ensemble approach to compute robust ensemble biclusters on molecular omics data. This is done by computing similarity networks of biclusters and filtering for overlaps using a custom error model. After that, the louvain modularity it used to extract bicluster communities from the similarity network, which can then be converted to ensemble biclusters. Additionally, MoSBi includes several network visualization methods to give an intuitive and scalable overview of the results. MoSBi comes with several biclustering algorithms, but can be easily extended to new biclustering algorithms.","addition_date":"2026-09-01T07:24:36.638771Z","last_update_date":"2026-09-01T07:24:36.640870Z","tool_type":["Command-line tool","Library"],"version":["1.17.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-mosbi","credit":[{"name":"Josch Konstantin Pauling","typeEntity":"Person","typeRole":["Developer"]},{"name":"Nikolai Koehler","typeEntity":"Person","typeRole":["Developer"]},{"name":"Tim Daniel Rose","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/mosbi"}],"edit_permission":{"type":"private"},"name":"mosbi","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.1073/pnas.2118210119"}]},"bioschemas":{"name":"mosbi","home":"https://bio.tools/bioconductor-mosbi","license":"AGPL-3.0-only","version":"1.17.0","summary":"This package is a implementation of biclustering ensemble method MoSBi (Molecular signature Identification from Biclustering). MoSBi provides standardized interfaces for biclustering results and can combine their results with a multi-algorithm ensemble approach to compute robust ensemble biclusters on molecular omics data. This is done by computing similarity networks of biclusters and filtering for overlaps using a custom error model. After that, the louvain modularity it used to extract bicluster communities from the similarity network, which can then be converted to ensemble biclusters. Additionally, MoSBi includes several network visualization methods to give an intuitive and scalable overview of the results. MoSBi comes with several biclustering algorithms, but can be easily extended to new biclustering algorithms.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-mosbi:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-mosbi:1.0.3/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-mosbi:1.4.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@n