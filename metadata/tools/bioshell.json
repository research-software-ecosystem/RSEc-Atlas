{"tool_name":"bioshell","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bioshell","home":"https://bioshell.readthedocs.io","license":"Apache-2.0","summary":"BioShell is a suite of command line tools and a library for structural bioinformatics.","addition_date":"2021-01-18T08:06:58Z","last_update_date":"2021-02-04T14:58:24Z","tool_type":["Command-line tool","Library"],"biotools_curie":"biotools:bioshell","credit":[{"email":"dgront@chem.uw.edu.pl","name":"Dominik Gront","orcidid":"https://orcid.org/0000-0002-2260-2083","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Sequence assembly","uri":"http://edamontology.org/operation_0310"},{"term":"Simulation analysis","uri":"http://edamontology.org/operation_0244"}]}],"name":"BioShell","owner":"Kigaard","publication":[{"doi":"10.3390/BIOM10030461","metadata":{"abstract":"\u00a9 2020 by the authors. Licensee MDPI, Basel, Switzerland.BioShell is an open-source package for processing biological data, particularly focused on structural applications. The package provides parsers, data structures and algorithms for handling and analyzing macromolecular sequences, structures and sequence profiles. The most frequently used routines are accessible by a set of easy-to-use command line utilities for a Linux environment. The full functionality of the package assumes knowledge of C++ or Python to assemble an application using this software library. Since the last publication that announced the version 2.0, the package has been greatly expanded and rewritten in C++ standard 11 (C++11) to improve its modularity and efficiency. A new testing platform has been implemented to continuously test the correctness and integrity of the package. More than two hundred test programs have been published to provide simple examples that can be used as templates. This makes BioShell an easy to use library that greatly speeds up development of bioinformatics applications and web services without compromising computational efficiency.","authors":[{"name":"Badaczewska-Dawid A.E."},{"name":"Gront D."},{"name":"Krys J.D."},{"name":"Macnar J.M."},{"name":"Szulc N.A."}],"citationCount":2,"date":"2020-03-01T00:00:00Z","journal":"Biomolecules","title":"Bioshell 3.0: Library for processing structural biology data"},"pmcid":"PMC7175226","pmid":"32188163"}],"topic":[{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Structural biology","uri":"http://edamontology.org/topic_1317"},{"term":"Structure analysis","uri":"http://edamontology.org/topic_0081"}]},"bioschemas":{"name":"BioShell","home":"https://bio.tools/bioshell","license":"Apache-2.0","summary":"BioShell is a suite of command line tools and a library for structural bioinformatics.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:bioshell/cmd/bioshell.readthedocs.io","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false,"repository":{}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":5,"citations":[{"count":1,"year":"2022"},{"count":1,"year":"2024"},{"count":1,"year":"2025"},{"count":2,"year":"2021"}],"doi":"10.3390/biom10030461","pmcid":"PMC7175226","pmid":"32188163","ref_count":13,"refs":[{"count":1,"year":"2002"},{"count":1,"year":"2003"},{"count":1,"year":"2010"},{"count":1,"year":"2015"},{"count":1,"year":"2016"},{"count":1,"year":"2018"},{"count":1,"year":"2019"},{"count":2,"year":"2005"},{"count":2,"year":"2006"},{"count":2,"year":"2008"}],"title":"BioShell 3.0: Library for Processing Structural Biology Data.","year":2020}]}],"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":302,"url":"https://bioshell.readthedocs.