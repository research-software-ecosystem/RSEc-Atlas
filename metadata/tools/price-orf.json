{"tool_name":"price-orf","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"price-orf","home":"https://github.com/erhard-lab/price","license":"Apache-2.0","summary":"A method to identify open reading frames (ORF) using Ribosome profiling (Ribo-seq) experiments embedded in a pipeline for data analysis. It is part of GEDI software platform.","addition_date":"2018-05-29T13:51:44Z","last_update_date":"2024-11-25T14:35:32.565956Z","tool_type":["Plug-in"],"biotools_curie":"biotools:price-orf","cost":"Free of charge","credit":[{"email":"Florian.Erhard@bio.ifi.lmu.de","name":"Florian Erhard","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/erhard-lab/gedi"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Nucleic acid sequence (raw)","uri":"http://edamontology.org/data_2975"},"format":[{"term":"FASTQ","uri":"http://edamontology.org/format_1930"}]}],"operation":[{"term":"Coding region prediction","uri":"http://edamontology.org/operation_0436"},{"term":"Sequence analysis","uri":"http://edamontology.org/operation_2403"},{"term":"Statistical calculation","uri":"http://edamontology.org/operation_2238"}],"output":[{"data":{"term":"Report","uri":"http://edamontology.org/data_2048"},"format":[{"term":"Graph format","uri":"http://edamontology.org/format_3617"}]}]}],"maturity":"Mature","name":"PRICE","owner":"ELIXIR-EE","publication":[{"doi":"10.1038/nmeth.4631","metadata":{"abstract":"Ribosome profiling has been used to predict thousands of short open reading frames (sORFs) in eukaryotic cells, but it suffers from substantial levels of noise. PRICE (https://github.com/erhard-lab/price) is a computational method that models experimental noise to enable researchers to accurately resolve overlapping sORFs and noncanonical translation initiation. We experimentally validated translation using major histocompatibility complex class I (MHC I) peptidomics and observ