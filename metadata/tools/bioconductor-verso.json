{"tool_name":"bioconductor-verso","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-verso","identifiers":["doi:10.1101/2020.04.22.044404"],"license":"Not available","summary":"Viral evolution reconstruction (verso)","home_url":"https://bioconductor.org/packages/3.12/bioc/html/VERSO.html","keywords":[],"manually_check":true,"total_pulls":109},"biotools":{"id":"bioconductor-verso","home":"https://bioconductor.org/packages/VERSO","summary":"Mutations that rapidly accumulate in viral genomes during a pandemic can be used to track the evolution of the virus and, accordingly, unravel the viral infection network. To this extent, sequencing samples of the virus can be employed to estimate models from genomic epidemiology and may serve, for instance, to estimate the proportion of undetected infected people by uncovering cryptic transmissions, as well as to predict likely trends in the number of infected, hospitalized, dead and recovered people. VERSO is an algorithmic framework that processes variants profiles from viral samples to produce phylogenetic models of viral evolution. The approach solves a Boolean Matrix Factorization problem with phylogenetic constraints, by maximizing a log-likelihood function. VERSO includes two separate and subsequent steps; in this package we provide an R implementation of VERSO STEP 1.","tool_type":["Command-line tool","Library"],"version":["1.22.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-verso","credit":[{"name":"Alex Graudenzi","typeEntity":"Person","typeRole":["Developer"]},{"name":"Daniele Ramazzotti","typeEntity":"Person","typeRole":["Developer"]},{"name":"Davide Maspero","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Fabrizio Angaroni","typeEntity":"Person","typeRole":["Developer"]},{"name":"Luca De Sano","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/VERSO"}],"name":"VERSO","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.18129/B9.bioc.VERSO"}]},"bioschemas":{"name":"VERSO","home":"https://bio.tools/bioconductor-verso","version":"1.22.0","summary":"Mutations that rapidly accumulate in viral genomes during a pandemic can be used to track the evolution of the virus and, accordingly, unravel the viral infection network. To this extent, sequencing samples of the virus can be employed to estimate models from genomic epidemiology and may serve, for instance, to estimate the proportion of undetected infected people by uncovering cryptic transmissions, as well as to predict likely trends in the number of infected, hospitalized, dead and recovered people. VERSO is an algorithmic framework that processes variants profiles from viral samples to produce phylogenetic models of viral evolution. The approach solves a Boolean Matrix Factorization problem with phylogenetic constraints, by maximizing a log-likelihood function. VERSO includes two separate and subsequent steps; in this package we provide an R implementation of VERSO STEP 1.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-verso:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-verso:1.10.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"d