{"tool_name":"hupho","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"hupho","home":"http://hupho.uniroma2.it","summary":"Online web resource for recovering information about human phosphatases.","addition_date":"2015-01-22T11:45:55Z","last_update_date":"2019-01-09T15:41:40Z","tool_type":["Web application"],"version":["1"],"biotools_curie":"biotools:hupho","credit":[{"email":"cesareni@uniroma2.it","name":"Gianni Cesareni","orcidid":"https://orcid.org/0000-0002-9528-6018","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"Livia Perfetto","orcidid":"http://orcid.org/0000-0003-4392-8725","typeRole":["Contributor"]},{"name":"Alberto Calderone","typeEntity":"Person","typeRole":["Developer"]},{"name":"ELIXIR-ITA-TORVERGATA","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Molecular Genetic Group, University of Rome \"Tor Vergata\", Rome, Italy","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Susanna Liberti","typeEntity":"Person","typeRole":["Developer"]},{"name":"Francesca Sacco","typeRole":["Contributor"]},{"name":"Marta Iannuccelli","typeRole":["Contributor"]}],"documentation":[{"type":["General"],"url":"http://hupho.uniroma2.it/DBinfo.php"}],"edit_permission":{"type":"private"},"function":[{"note":"Biological databases and data management","operation":[{"term":"Database search","uri":"http://edamontology.org/operation_2421"}]}],"name":"Hupho","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-ITA-TORVERGATA","publication":[{"doi":"10.1111/j.1742-4658.2012.08712.x","metadata":{"abstract":"Phosphatases and kinases contribute to the regulation of protein phosphorylation homeostasis in the cell. Phosphorylation is a key post-translational modification underlying the regulation of many cellular processes. Thus, a comprehensive picture of phosphatase function and the identification of their target substrates would aid a systematic approach to a mechanistic description of cell signalling. Here we present a website designed to facilitate the retrieval of information about human protein phosphatases. To this end we developed a search engine to recover and integrate information annotated in several publicly available web resources. In addition we present a text-mining-assisted annotation effort aimed at extracting phosphatase related data reported in the scientific literature. The HuPho (human phosphatases) website can be accessed at http://hupho.uniroma2.it. \u00a9 2012 The Authors Journal compilation \u00a9 2012 FEBS.","authors":[{"name":"Calderone A."},{"name":"Castagnoli L."},{"name":"Cesareni G."},{"name":"Iannuccelli M."},{"name":"Liberti S."},{"name":"Nardozza A.P."},{"name":"Palma A."},{"name":"Panni S."},{"name":"Perfetto L."},{"name":"Sacco F."},{"name":"Santonico E."}],"citationCount":36,"date":"2013-01-01T00:00:00Z","journal":"FEBS Journal","title":"HuPho: The human phosphatase portal"},"pmid":"22804825","type":["Primary"]}],"topic":[{"term":"Data management","uri":"http://edamontology.org/topic_3071"},{"term":"Enzymes","uri":"http://edamontology.org/topic_0821"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"}],"validated":1},"bioschemas":{"name":"Hupho","home":"https://bio.tools/hupho","version":"1","summary":"Online web resource for recovering information about human phosphatases.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:hupho:1/web/hupho.uniroma2.it","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":28,"citations":[{"count":1,"year":"2012"},{"count":1,"year":"2015"},{"count":1,"year":"2016"},{"count":1,"year":"2018"},{"count":1,"year":"2021"},{"count":1,"year":"2024"},{"count":2,"year":"2013"},{"count":3,"year":"2019"},{"count":3,"year":"2022"},{"count":