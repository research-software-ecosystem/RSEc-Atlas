{"tool_name":"vicmpred","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"vicmpred","home":"http://webs.iiitd.edu.in/raghava/vicmpred/","summary":"Classification of bacterial proteins into virulence factors, information molecule, cellular process and metabolism molecule.","addition_date":"2017-08-03T19:03:54Z","last_update_date":"2024-11-24T15:35:46.076355Z","tool_type":["Web application"],"biotools_curie":"biotools:vicmpred","credit":[{"email":"raghava@imtech.res.in","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://crdd.osdd.net/raghava/vicmpred/contact.html"}],"documentation":[{"type":["General"],"url":"http://crdd.osdd.net/raghava/vicmpred/help.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Variant classification","uri":"http://edamontology.org/operation_3225"}]}],"name":"VICMpred","operating_system":["Linux","Mac","Windows"],"owner":"raghavagps","publication":[{"doi":"10.1016/s1672-0229(06)60015-6","metadata":{"abstract":"In this study, an attempt has been made to predict the major functions of gram-negative bacterial proteins from their amino acid sequences. The dataset used for training and testing consists of 670 non-redundant gram-negative bacterial proteins (255 of cellular process, 60 of information molecules, 285 of metabolism, and 70 of virulence factors). First we developed an SVM-based method using amino acid and dipeptide composition and achieved the overall accuracy of 52.39% and 47.01%, respectively. We introduced a new concept for the classification of proteins based on tetrapeptides, in which we identified the unique tetrapeptides significantly found in a class of proteins. These tetrapeptides were used as the input feature for predicting the function of a protein and achieved the overall accuracy of 68.66%. We also developed a hybrid method in which the tetrapeptide information was used with amino acid composition and achieved the overall accuracy of 70.75%. A five-fold cross validation was used to evaluate the performance of these methods. The web server VICMpred has been developed for predicting the function of gram-negative bacterial proteins (http://www.imtech.res.in/raghava/vicmpred/).","authors":[{"name":"Raghava G.P.S."},{"name":"Saha S."}],"citationCount":108,"date":"2006-01-01T00:00:00Z","journal":"Genomics, Proteomics and Bioinformatics","title":"VICMpred: An SVM-based method for the prediction of functional proteins of gram-negative bacteria using amino acid patterns and composition"},"pmcid":"PMC5054027","pmid":"16689701"}],"topic":[{"term":"Endocrinology and metabolism","uri":"http://edamontology.org/topic_3407"},{"term":"Gene and protein families","uri":"http://edamontology.org/topic_0623"},{"term":"Microbiology","uri":"http://edamontology.org/topic_3301"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"}],"validated":1},"bioschemas":{"name":"VICMpred","home":"https://bio.tools/vicmpred","summary":"Classification of bacterial proteins into virulence factors, information molecule, cellular process and metabolism molecule.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:vicmpred/web/webs.iiitd.edu.in","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":62,"citations":[{"count":1,"year":"2007"},{"count":1,"year":"2009"},{"count":1,"year":"2012"},{"count":1,"year":"2013"},{"count":2,"year":"2008"},{"count":2,"year":"2016"},{"count":2,"year":"2017"},{"count":2,"year":"2018"},{"count":3,"year":"2014"},{"count":3,"year":"2015"},{"count":3,"year":"2019"},{"count":3,"year":"2024"},{"count":4,"year":"2026"},{"count":6,"year":"2020"},{"count":6,"year":"2023"},{"count":6,"year":"2025"},{"count":8,"year":"2021"},{"count":8,"ye