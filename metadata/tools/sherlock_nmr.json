{"tool_name":"sherlock_nmr","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"sherlock_nmr","home":"https://github.com/michaelwenk/sherlock","license":"MIT","summary":"Free and Open-Source System for the Computer-Assisted Structure Elucidation of Organic Compounds from NMR Data.","addition_date":"2023-08-08T14:43:10.104936Z","last_update_date":"2024-11-24T14:44:25.274676Z","tool_type":["Desktop application"],"accessibility":"Open access","biotools_curie":"biotools:sherlock_nmr","cost":"Free of charge","credit":[{"email":"christoph.steinbeck@uni-jena.de","name":"Christoph Steinbeck","orcidid":"https://orcid.org/0000-0001-6966-0814","typeEntity":"Person"},{"email":"michael.wenk@uni-jena.de","name":"Michael Wenk","orcidid":"https://orcid.org/0000-0002-7868-2473","typeEntity":"Person"}],"documentation":[{"type":["User manual"],"url":"https://github.com/michaelwenk/sherlock-frontend/blob/master/public/Sherlock_manual.pdf"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"NMR spectrum","uri":"http://edamontology.org/data_3488"},"format":[{"term":"JCAMP-DX","uri":"http://edamontology.org/format_3859"}]}],"operation":[{"term":"Correlation","uri":"http://edamontology.org/operation_3465"},{"term":"Data retrieval","uri":"http://edamontology.org/operation_2422"},{"term":"Peak detection","uri":"http://edamontology.org/operation_3215"},{"term":"Spectrum calculation","uri":"http://edamontology.org/operation_3860"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"Sherlock","operating_system":["Linux","Mac","Windows"],"owner":"Pub2Tools","publication":[{"doi":"10.3390/molecules28031448","metadata":{"abstract":"The structure elucidation of small organic molecules (<1500 Dalton) through 1D and 2D nuclear magnetic resonance (NMR) data analysis is a potentially challenging, combinatorial problem. This publication presents Sherlock, a free and open-source Computer-Assisted Structure Elucidation (CASE) software where the user controls the chain of elementary operations through a versatile graphical user interface, including spectral peak picking, addition of automatically or user-defined structure constraints, structure generation, ranking and display of the solutions. A set of forty-five compounds was selected in order to illustrate the new possibilities offered to organic chemists by Sherlock for improving the reliability and traceability of structure elucidation results.","authors":[{"name":"Nuzillard J.-M."},{"name":"Steinbeck C."},{"name":"Wenk M."}],"citationCount":7,"date":"2023-02-01T00:00:00Z","journal":"Molecules","title":"Sherlock\u2014A Free and Open-Source System for the Computer-Assisted Structure Elucidation of Organic Compounds from NMR Data"},"pmcid":"PMC9920390","pmid":"36771127"}],"topic":[{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"},{"term":"Molecular biology","uri":"http://edamontology.org/topic_3047"},{"term":"NMR","uri":"http://edamontology.org/topic_0593"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}]},"bioschemas":{"name":"Sherlock","home":"https://bio.tools/sherlock_nmr","license":"MIT","summary":"Free and Open-Source System for the Computer-Assisted Structure Elucidation of Organic Compounds from NMR Data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:sherlock_nmr/app/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false,"repository":{}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":4,"citations":[{"count":1,"year":"2023"},{"count":1,"year":"2026"},{"count":2,"year":"2024"}],"doi":"10.3390/molecules28031448","pmcid":"PMC9920390","pmid":"36771127","ref_count":16,"refs":[{"count":1,"year":"2