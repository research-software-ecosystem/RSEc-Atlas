{"tool_name":"toxtempassistant","contents":["biotools","oeb"],"identifiers":["biotools:toxtempassistant"],"fetched_metadata":{"biotools":{"id":"toxtempassistant","home":"https://toxtempassistant.vhp4safety.nl/","license":"AGPL-3.0","summary":"ToxTempAssistant helps scientists document cell-based toxicological test methods more efficiently. Based on the ToxTemp template from OECD Guidance Document 211, the tool guides users through 77 structured questions to create clear, standardised test method descriptions.\n\nUsing large language models, ToxTempAssistant extracts and organises information from uploaded documents, turning manual data entry into an expert-review process. Its goal is to reduce the documentation burden and support the wider acceptance of New Approach Methodologies.","addition_date":"2026-11-07T11:10:37.206467Z","last_update_date":"2026-11-07T11:19:00.099485Z","tool_type":["Web API","Web application"],"version":["3.64.2"],"accessibility":"Restricted access","biotools_curie":"biotools:toxtempassistant","cost":"Free of charge","credit":[{"email":"Jente.Houweling@rivm.nl","name":"Jente Houweling","orcidid":"https://orcid.org/0009-0005-3680-0645","rorid":"01cesdt21","typeEntity":"Person","typeRole":["Maintainer"]}],"edit_permission":{"type":"private"},"maturity":"Emerging","name":"ToxTempAssistant","operating_system":["Linux"],"owner":"jente_johanne_margrieta","publication":[{"doi":"10.1080/2833373X.2026.2638036","type":["Primary"],"version":"1.3.1"}],"topic":[{"term":"Toxicology","uri":"http://edamontology.org/topic_2840"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:toxtempassistant:3.64.2/rest/toxtempassistant.vhp4safety.nl","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","project":{"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1080/2833373X.2026.2638036","pmcid":null,"pmid":null,"ref_count":0,"refs":[],"title":null,"year":null}]}]}},{"@id":"https://o