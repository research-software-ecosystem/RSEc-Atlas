{"tool_name":"biostructmap","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"BioStructMap","home":"https://biostructmap.burnet.edu.au","license":"MIT","summary":"Python tool for integration of protein structure and sequence-based features.","addition_date":"2019-07-06T14:58:20Z","last_update_date":"2020-06-16T10:55:23Z","tool_type":["Script","Web application","Web service"],"accessibility":"Open access","biotools_curie":"biotools:BioStructMap","cost":"Free of charge","credit":[{"email":"jack.richards@burnet.edu.au","name":"Dr. Jack Richards"},{"email":"andrew.guy@burnet.edu.au","name":"Andrew Guy","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"paul.ramsland@rmit.edu.au","name":"Dr. Paul Ramsland","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/andrewguy/biostructmap"},{"type":["User manual"],"url":"https://biostructmap.burnet.edu.au/#/help"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Aggregation","uri":"http://edamontology.org/operation_3436"},{"term":"Protein threading","uri":"http://edamontology.org/operation_0302"}]}],"maturity":"Mature","name":"BioStructMap","operating_system":["Linux","Mac","Windows"],"owner":"Ruta","publication":[{"doi":"10.1093/bioinformatics/bty474","metadata":{"abstract":"\u00a9 The Author(s) 2018. Published by Oxford University Press.Summary A sliding window analysis over a protein or genomic sequence is commonly performed, and we present a Python tool, BioStructMap, that extends this concept to three-dimensional (3D) space, allowing the application of a 3D sliding window analysis over a protein structure. BioStructMap is easily extensible, allowing the user to apply custom functions to spatially aggregated data. BioStructMap also allows mapping of underlying genomic sequences to protein structures, allowing the user to perform genetic-based analysis over spatially linked codons - this has applications when selection pressures arise at the level of protein structure. Availability and implementation The Python BioStructMap package is available at https://github.com/andrewguy/biostructmap and released under the MIT License. An online server implementing standard functionality is available at https://biostructmap.burnet.edu.au. Supplementary informationSupplementary dataare available at Bioinformatics online.","authors":[{"name":"Guy A.J."},{"name":"Irani V."},{"name":"Ramsland P.A."},{"name":"Richards J.S."}],"date":"2018-11-15T00:00:00Z","journal":"Bioinformatics","title":"BioStructMap: A Python tool for integration of protein structure and sequence-based features"},"type":["Primary"]}],"topic":[{"term":"Immunoproteins, genes and antigens","uri":"http://edamontology.org/topic_2830"},{"term":"Protein folds and structural domains","uri":"http://edamontology.org/topic_0736"},{"term":"Protein structural motifs and surfaces","uri":"http://edamontology.org/topic_0166"}],"validated":1},"bioschemas":{"name":"BioStructMap","home":"https://bio.tools/BioStructMap","license":"MIT","summary":"Python tool for integration of protein structure and sequence-based features.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:biostructmap/script/biostructmap.burnet.edu.au","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true,"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":11,"citations":[{"count":1,"year":"2023"},{"count":2,"year":"2022"},{"count":2,"year":"2024"},{"count":3,"year":"2021"},{"count":