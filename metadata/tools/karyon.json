{"tool_name":"karyon","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"karyon","home":"https://github.com/Gabaldonlab/karyon","license":"GPL-3.0","summary":"Karyon is a computational framework for the diagnosis of hybrids, aneuploids, and other non-standard architectures in genome assemblies. Karyon is a pipeline for the assembly and analysis of highly heterozygous genomes. It uses redundans (Pryszcz & Gabald\u00f3n, 2016) to reduce heterozygosity during the assembly process, and then maps the original libraries against the reduced assembly to analyze the distribution of heterozygous regions. With this information, it generates a series of plots that can aid researchers to generate informed hypotheses with regard of the architecture of their genomes.","addition_date":"2021-10-04T09:21:44.724348Z","last_update_date":"2024-11-24T14:55:28.021365Z","tool_type":["Workbench","Workflow"],"version":["1.2"],"collections":["IMPaCT-Data"],"biotools_curie":"biotools:karyon","credit":[{"email":"toni.gabaldon.bcn@gmail.com","name":"Toni Gabald\u00f3n","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"De-novo assembly","uri":"http://edamontology.org/operation_0524"},{"term":"Genome assembly","uri":"http://edamontology.org/operation_0525"},{"term":"Mapping assembly","uri":"http://edamontology.org/operation_0523"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"},{"term":"de Novo sequencing","uri":"http://edamontology.org/operation_3644"}]}],"name":"Karyon","owner":"Gabaldonlab","publication":[{"doi":"10.1101/2021.05.23.445324","type":["Primary"]}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Whole genome sequencing","uri":"http://edamontology.org/topic_3673"},{"term":"