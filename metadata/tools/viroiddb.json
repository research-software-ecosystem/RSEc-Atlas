{"tool_name":"viroiddb","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"viroiddb","home":"https://viroids.org","license":"MIT","summary":"ViroidDB is the most comprehensive collection of viroid, satellite RNA, retrozyme, and deltavirus genome sequences available on the internet.","addition_date":"2022-03-09T22:13:40.051235Z","last_update_date":"2022-03-09T22:13:40.053937Z","tool_type":["Database portal","Web application"],"accessibility":"Open access","biotools_curie":"biotools:viroiddb","cost":"Free of charge","credit":[{"email":"benjamindlee@me.com","name":"Benjamin D Lee","orcidid":"https://orcid.org/0000-0002-7133-8397","typeEntity":"Person"},{"email":"koonin@ncbi.nlm.nih.gov","name":"Eugene V Koonin","orcidid":"https://orcid.org/0000-0003-3943-8299","typeEntity":"Person"},{"name":"Caleb J Oh"},{"name":"Peter Simmonds"},{"name":"Uri Neri"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Data retrieval","uri":"http://edamontology.org/operation_2422"},{"term":"RNA secondary structure alignment","uri":"http://edamontology.org/operation_0502"},{"term":"RNA secondary structure prediction","uri":"http://edamontology.org/operation_0278"},{"term":"Sequence alignment","uri":"http://edamontology.org/operation_0292"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"ViroidDB","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1093/NAR/GKAB974","metadata":{"abstract":"Published by Oxford University Press on behalf of Nucleic Acids Research 2021.We introduce ViroidDB, a value-added database that attempts to collect all known viroid and viroid-like circular RNA sequences into a single resource. Spanning about 10 000 unique sequences, ViroidDB includes viroids, retroviroid-like elements, small circular satellite RNAs, ribozyviruses, and retrozymes. Each sequence's secondary structure, ribozyme content, and cluster membership are predicted via a custom pipeline optimized for handling circular RNAs. The data can be explored via a purpose-built user interface that features visualizations, multiple sequence alignments, and a portal for downloading bulk data. Users can browse the data by sequence type, taxon, or typo-tolerant search of metadata fields. The database is freely accessible at https://viroids.org.","authors":[{"name":"Koonin E.V."},{"name":"Lee B.D."},{"name":"Neri U."},{"name":"Oh C.J."},{"name":"Simmonds P."}],"citationCount":1,"date":"2022-01-07T00:00:00Z","journal":"Nucleic acids research","title":"ViroidDB: a database of viroids and viroid-like circular RNAs"},"pmcid":"PMC8728161","pmid":"34751403"}],"topic":[{"term":"Plant biology","uri":"http://edamontology.org/topic_0780"},{"term":"Protein structure analysis","uri":"http://edamontology.org/topic_2814"},{"term":"RNA","uri":"http://edamontology.org/topic_0099"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"}],"validated":1},"bioschemas":{"name":"ViroidDB","home":"https://bio.tools/viroiddb","license":"MIT","summary":"ViroidDB is the most comprehensive collection of viroid, satellite RNA, retrozyme, and deltavirus genome sequences available on the internet.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:viroiddb/db/viroids.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":16,"citations":[{"count":2,"year":"2026"},{"count":3,"year":"2022"},{"count":3,"year":"2024"},{"count":4,