{"tool_name":"cei","contents":["biotools"],"identifiers":["biotools:cei"],"fetched_metadata":{"biotools":{"id":"cei","home":"https://github.com/a2iEditing/CEI","summary":"The Cytoplasmic Editing Index (CEI) is an open-source pipeline designed to quantify ADAR1-mediated adenosine-to-inosine RNA editing specifically within cytoplasmic transcripts. It is crucial for assessing the immunogenicity risk associated with endogenous double-stranded RNA structures in the life sciences.","addition_date":"2026-11-05T13:47:00.977698Z","last_update_date":"2026-11-05T13:47:00.980774Z","biotools_curie":"biotools:cei","credit":[{"email":"elieis@post.tau.ac.il","name":"Eli Eisenberg","typeEntity":"Person"},{"email":"erez.levanon@biu.ac.il","name":"Erez Y. Levanon","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene expression profiling","uri":"http://edamontology.org/operation_0314"},{"term":"RNA-binding protein prediction","uri":"http://edamontology.org/operation_3901"},{"term":"Structure editing","uri":"http://edamontology.org/operation_3080"}]}],"name":"Cytoplasmic Editing Index (CEI)","owner":"pub2tools2024","publication":[{"doi":"10.1186/S13059-026-04154-3","pmcid":"PMC13508285","pmid":"42310695"}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Immunogenetics","uri":"http://edamontology.org/topic_3930"},{"term":"Probes and primers","uri":"http://edamontology.org/topic_0632"},{"term":"RNA","uri":"http://edamontology.org/topic_0099"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}]}}}