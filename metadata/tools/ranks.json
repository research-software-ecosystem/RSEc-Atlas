{"tool_name":"ranks","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"RANKS","home":"https://cran.r-project.org/package=RANKS","license":"GPL-3.0","summary":"Tool for node label ranking and classification in biological networks.","addition_date":"2019-08-04T11:24:49Z","last_update_date":"2024-11-24T21:06:26.885975Z","tool_type":["Library"],"accessibility":"Open access","biotools_curie":"biotools:RANKS","cost":"Free of charge","credit":[{"email":"valentini@di.unimi.it","name":"Giorgio Valentini","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://cran.r-project.org/web/packages/RANKS/RANKS.pdf"}],"edit_permission":{"type":"private"},"maturity":"Mature","name":"RANKS","operating_system":["Linux","Mac","Windows"],"owner":"Ruta","publication":[{"doi":"10.1093/bioinformatics/btw235","metadata":{"abstract":"RANKS is a flexible software package that can be easily applied to any bioinformatics task formalizable as ranking of nodes with respect to a property given as a label, such as automated protein function prediction, gene disease prioritization and drug repositioning. To this end RANKS provides an efficient and easy-to-use implementation of kernelized score functions, a semi-supervised algorithmic scheme embedding both local and global learning strategies for the analysis of biomolecular networks. To facilitate comparative assessment, baseline network-based methods, e.g. label propagation and random walk algorithms, have also been implemented.","authors":[{"name":"Armano G."},{"name":"Frasca M."},{"name":"Lin J."},{"name":"Mesiti M."},{"name":"Re M."},{"name":"Valentini G."}],"citationCount":26,"date":"2016-09-15T00:00:00Z","journal":"Bioinformatics","title":"RANKS: A flexible tool for node label ranking and classification in biological networks"},"pmid":"27256314","type":["Primary"]}],"topic":[{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topi