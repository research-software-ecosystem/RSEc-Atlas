{"tool_name":"giniclust","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"giniclust","home":"https://github.com/lanjiangboston/GiniClust","license":"MIT","summary":"Detecting Rare Cell Types from Single-Cell Gene Expression Data with Gini Index.","addition_date":"2018-08-13T12:08:30Z","last_update_date":"2024-11-25T14:28:37.626615Z","tool_type":["Desktop application"],"biotools_curie":"biotools:giniclust","credit":[{"email":"gcyuan@jimmy.harvard.edu","name":"Guo-Cheng YuanEmail author","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/lanjiangboston/GiniClust"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Expression analysis","uri":"http://edamontology.org/operation_2495"}]}],"name":"GiniClust","operating_system":["Linux","Mac"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1186/s13059-016-1010-4","metadata":{"abstract":"High-throughput single-cell technologies have great potential to discover new cell types; however, it remains challenging to detect rare cell types that are distinct from a large population. We present a novel computational method, called GiniClust, to overcome this challenge. Validation against a benchmark dataset indicates that GiniClust achieves high sensitivity and specificity. Application of GiniClust to public single-cell RNA-seq datasets uncovers previously unrecognized rare cell types, including Zscan4-expressing cells within mouse embryonic stem cells and hemoglobin-expressing cells in the mouse cortex and hippocampus. GiniClust also correctly detects a small number of normal cells that are mixed in a cancer cell population.","authors":[{"name":"Chen H."},{"name":"Jiang L."},{"name":"Pinello L."},{"name":"Yuan G.-C."}],"citationCount":201,"date":"2016-07-01T00:00:00Z","journal":"Genome Biology","title":"GiniClust: Detecting rare cell types from single-cell gene expression data with Gini index"},"pmcid":"PMC4930624","pmid":"27368803"}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Taxonomy","uri":"http://edamontology.org/topic_0637"}],"validated":1},"bioschemas":{"name":"GiniClust","home":"https://bio.tools/giniclust","license":"MIT","summary":"Detecting Rare Cell Types from Single-Cell Gene Expression Data with Gini Index.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:giniclust/app/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":154,"citations":[{"count":1,"year":"-1"},{"count":1,"year":"2016"},{"count":11,"year":"2026"},{"count":12,"year":"2017"},{"count":13,"year":"2025"},{"count":14,"year":"2024"},{"count":15,"year":"2021"},{"count":16,"year":"2022"},{"count":17,"year":"2020"},{"count":17,"year":"2023"},{"count":18,"year":"2019"},{"count":19,"year":"2018"}],"doi":"10.1186/s13059-016-1010-4","pmcid":"PMC4930624","pmid":"27368803","ref_count":24,"refs":[{"count":1,"year":"2008"},{"count":1,"year":"2009"},{"count":1,"year":"2010"},{"count":2,"year":"2012"},{"count":3,"year":"2013"},{"count":8,"year":"2014"},{"count":8,"year":"2015"}],"title":"GiniClust: detecting rare cell types from single-cell gene expression data with Gini index.","year":2016}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"email":