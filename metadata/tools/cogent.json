{"tool_name":"cogent","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"cogent","identifiers":["doi:10.1186/gb-2007-8-8-r171"],"license":"GPL-2","summary":"Framework for genomic biology","home_url":"https://github.com/pycogent/pycogent","keywords":["Animals","BRCA1 Protein","Databases, Genetic","Genomics","Humans","Phylogeny","Protein Conformation","Proteobacteria","Sequence Analysis","von Willebrand Factor"],"manually_check":true,"total_pulls":5815},"biotools":{"id":"cogent","home":"https://github.com/lbozhilova/COGENT","summary":"COGENT (COnsistency of Gene Expression NeTworks) is an R package designed to aid the construction of gene co-expression networks without the need for annotation or other external validation data. COGENT can be used to choose between competing co-expression measures (e.g. Pearson vs. Kendall correlation coefficients), as well as to inform score cut-off choice. While designed for gene expression data, COGENT can be applied to other cases where network construction relies on similarity profiling, e.g. microbiome or synthetic lethality data.","addition_date":"2021-01-18T09:41:31Z","last_update_date":"2021-02-14T16:39:02Z","tool_type":["Library"],"biotools_curie":"biotools:cogent","credit":[{"email":"deane@stats.ox.ac.uk","name":"Charlotte M. Deane","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Expression correlation analysis","uri":"http://edamontology.org/operation_3463"},{"term":"Protein interaction network analysis","uri":"http://edamontology.org/operation_0276"},{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"COGENT","owner":"Kigaard","publication":[{"doi":"10.1101/2020.06.21.163535"}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Microbial ecology","uri":"http://edamontology.org/topic_3697"},{"term":"Protein interactions","uri":"http://edam