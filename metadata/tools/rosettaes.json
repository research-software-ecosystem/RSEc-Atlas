{"tool_name":"rosettaes","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"rosettaes","home":"https://www.rosettacommons.org/","license":"Other","summary":"An automated tool that uses a fragment-based sampling strategy for de novo model completion of macromolecular structures from cryo-EM density maps at 3\u20135-\u00c5 resolution.","addition_date":"2018-06-04T16:46:37Z","last_update_date":"2024-11-25T14:37:56.751132Z","tool_type":["Plug-in"],"biotools_curie":"biotools:rosettaes","cost":"Free of charge (with restrictions)","credit":[{"email":"dimaio@u.washington.edu","name":"Frank Dimaio","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://media.nature.com/original/nature-assets/nmeth/journal/v14/n8/extref/nmeth.4340-S2.pdf"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Protein sequence","uri":"http://edamontology.org/data_2976"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]},{"data":{"term":"Structure image","uri":"http://edamontology.org/data_1710"},"format":[{"term":"PDB","uri":"http://edamontology.org/format_1476"}]}],"operation":[{"term":"Image analysis","uri":"http://edamontology.org/operation_3443"},{"term":"Structure analysis","uri":"http://edamontology.org/operation_2480"}],"output":[{"data":{"term":"Structural profile","uri":"http://edamontology.org/data_0889"},"format":[{"term":"Workflow format","uri":"http://edamontology.org/format_2032"}]}]}],"maturity":"Mature","name":"RosettaES","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"doi":"10.1038/nmeth.4340","metadata":{"abstract":"Accurate atomic modeling of macromolecular structures into cryo-electron microscopy (cryo-EM) maps is a major challenge, as the moderate resolution makes accurate placement of atoms difficult. We present Rosetta enumerative sampling (RosettaES), an automated tool that uses a fragment-based sampling strategy for de novo model completion of macromolecular structures from cryo-EM density maps at 3-5-\u00c5 resolution. On a benchmark set of nine proteins, RosettaES was able to identify near-native conformations in 85% of segments. RosettaES was also used to determine models for three challenging macromolecular structures.","authors":[{"name":"Di Maio F."},{"name":"Egelman E.H."},{"name":"Frenz B."},{"name":"Veesler D."},{"name":"Walls A.C."}],"citationCount":85,"date":"2017-07-28T00:00:00Z","journal":"Nature Methods","title":"RosettaES: A sampling strategy enabling automated interpretation of difficult cryo-EMmaps"},"pmcid":"PMC6009829","pmid":"28628127"}],"topic":[{"term":"Electron microscopy","uri":"http://edamontology.org/topic_0611"},{"term":"Structural biology","uri":"http://edamontology.org/topic_1317"},{"term":"Structure analysis","uri":"http://edamontology.org/topic_0081"}],"validated":1},"bioschemas":{"name":"RosettaES","home":"https://bio.tools/rosettaes","license":"Other","summary":"An automated tool that uses a fragment-based sampling strategy for de novo model completion of macromolecular structures from cryo-EM density maps at 3\u20135-\u00c5 resolution.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:rosettaes/plugin/www.rosettacommons.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":81,"citations":[{"count":2,"year":"2026"},{"count":3,"year":"2017"},{"count":3,"year":"2024"},{"count":3,"year":"2025"},{"count":8,"year":"2022"},{"count":9,"year":"2023"},{"count":11,"year":"2018"},{"count":12,"year":"2019"},{"count":14,"year":"2020"},{"count":16,"year":"2021"}],"doi":"10.1038/nmeth.4340","pmcid":"PMC6009829","pmid":"28628127","ref_count":30,"refs":[{"count":1,"year":"199