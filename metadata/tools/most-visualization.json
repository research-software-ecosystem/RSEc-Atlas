{"tool_name":"most-visualization","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"MOST-visualization","home":"http://most.ccib.rutgers.edu/","license":"GPL-3.0","summary":"Software for producing automated textbook-style maps of genome-scale metabolic networks.","addition_date":"2019-08-04T09:12:30Z","last_update_date":"2024-11-24T21:06:13.972809Z","tool_type":["Desktop application"],"accessibility":"Open access","biotools_curie":"biotools:MOST-visualization","cost":"Free of charge","credit":[{"email":"dslun@rutgers.edu","name":"Desmond S. Lun","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"note":"Tutorial material","type":["Training material"],"url":"http://most.ccib.rutgers.edu/tutorials.html"},{"type":["General"],"url":"http://most.ccib.rutgers.edu/help.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Expression profile pathway mapping","uri":"http://edamontology.org/operation_0533"},{"term":"Metabolic network modelling","uri":"http://edamontology.org/operation_3660"},{"term":"Natural product identification","uri":"http://edamontology.org/operation_3803"}]}],"maturity":"Mature","name":"MOST-visualization","operating_system":["Linux","Mac","Windows"],"owner":"Ruta","publication":[{"doi":"10.1093/bioinformatics/btx240","metadata":{"abstract":"Visualization of metabolites, reactions and pathways in genome-scale metabolic networks (GEMs) can assist in understanding cellular metabolism. Three attributes are desirable in software used for visualizing GEMs: (i) automation, since GEMs can be quite large; (ii) production of understandable maps that provide ease in identification of pathways, reactions and metabolites; and (iii) visualization of the entire network to show how pathways are interconnected. No software currently exists for visualizing GEMs that satisfies all three characteristics, but MOST-Visualization, an extension of the software package MOST (Metabolic Optimization and Simulation Tool), satisfies (i), and by using a pre-drawn overview map of metabolism based on the Roche map satisfies (ii) and comes close to satisfying (iii).","authors":[{"name":"Kelley J.J."},{"name":"Kim M.K."},{"name":"Lane A."},{"name":"Lun D.S."},{"name":"Maor S."}],"citationCount":3,"date":"2017-08-15T00:00:00Z","journal":"Bioinformatics","title":"MOST-visualization: Software for producing automated textbook-style maps of genome-scale metabolic networks"},"pmid":"28430868","type":["Primary"]}],"topic":[{"term":"Endocrinology and metabolism","uri":"http://edamontology.org/topic_3407"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}],"validated":1},"bioschemas":{"name":"MOST-visualization","home":"https://bio.tools/MOST-visualization","license":"GPL-3.0","summary":"Software for producing automated textbook-style maps of genome-scale metabolic networks.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:most-visualization/app/most.ccib.rutgers.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":false,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true,"training_material":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":4,"citations":[{"count":1,"year":"2018"},{"count":1,"year":"2020"},{"count":1,"year":"2023"},{"count":1,"year":"2025"}],"doi":"10.1093/bioinformatics/btx240","pmid":"28430868","ref_count":0,"refs":[],"title":"MOST-visualization: software for producing automated textbook-style maps of genome-scale metabolic