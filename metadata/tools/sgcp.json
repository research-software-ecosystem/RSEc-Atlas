{"tool_name":"sgcp","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"sgcp","home":"https://bioconductor.org/packages/SGCP","license":"GPL-3.0","summary":"SGC is a semi-supervised pipeline for gene clustering in gene co-expression networks. SGC consists of multiple novel steps that enable the computation of highly enriched modules in an unsupervised manner. But unlike all existing frameworks, it further incorporates a novel step that leverages Gene Ontology information in a semi-supervised clustering method that further improves the quality of the computed modules.","addition_date":"2026-01-14T19:29:25.046414Z","last_update_date":"2026-01-14T19:29:25.048443Z","version":["1.11.1"],"collections":["BioConductor"],"biotools_curie":"biotools:sgcp","credit":[{"name":"Ioannis Koutis","typeEntity":"Person","typeRole":["Developer"]},{"name":"Niloofar AghaieAbiane","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/SGCP"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"},{"term":"Expression correlation analysis","uri":"http://edamontology.org/operation_3463"},{"term":"Weighted correlation network analysis","uri":"http://edamontology.org/operation_3766"}]}],"name":"SGCP","owner":"pub2tools2024","publication":[],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Ontology and terminology","uri":"http://edamontology.org/topic_0089"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:sgcp/undefined/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metr