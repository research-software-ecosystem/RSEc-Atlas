{"tool_name":"bioconductor-mira","contents":["biocontainers","oeb","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-mira","identifiers":["doi:10.18129/b9.bioc.mira"],"license":"GPL-3","summary":"Methylation-Based Inference of Regulatory Activity","home_url":"https://bioconductor.org/packages/3.8/bioc/html/MIRA.html","keywords":["Genomics","Genetics"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-mira","home":"https://bioconductor.org/packages/MIRA","license":"GPL-3.0","summary":"DNA methylation contains information about the regulatory state of the cell. MIRA aggregates genome-scale DNA methylation data into a DNA methylation profile for a given region set with shared biological annotation. Using this profile, MIRA infers and scores the collective regulatory activity for the region set. MIRA facilitates regulatory analysis in situations where classical regulatory assays would be difficult and allows public sources of region sets to be leveraged for novel insight into the regulatory state of DNA methylation datasets.","tool_type":["Command-line tool","Library"],"version":["1.34.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-mira","credit":[{"name":"Christoph Bock","typeEntity":"Person","typeRole":["Contributor"]},{"name":"John Lawson","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Nathan Sheffield","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/MIRA"}],"name":"MIRA","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-mira:1.10.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"o