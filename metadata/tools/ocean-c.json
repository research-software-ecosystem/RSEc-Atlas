{"tool_name":"ocean-c","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"ocean-c","home":"https://github.com/ChengLiLab/OCEAN-C/","license":"CC-BY-4.0","summary":"Mapping hubs of open chromatin interactions across the genome reveals gene regulatory networks.","addition_date":"2018-08-15T10:22:30Z","last_update_date":"2024-11-25T14:28:45.143967Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:ocean-c","credit":[{"email":"cheng_li@pku.edu.cn","name":"Cheng Li","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/ChengLiLab/OCEAN-C/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genetic mapping","uri":"http://edamontology.org/operation_0282"}]}],"name":"OCEAN-C","owner":"d.gabrielaitis","publication":[{"doi":"10.1186/s13059-018-1430-4","metadata":{"abstract":"We develop a method called open chromatin enrichment and network Hi-C (OCEAN-C) for antibody-independent mapping of global open chromatin interactions. By integrating FAIRE-seq and Hi-C, OCEAN-C detects open chromatin interactions enriched by active cis-regulatory elements. We identify more than 10,000 hubs of open chromatin interactions (HOCIs) in human cells, which are mainly active promoters and enhancers bound by many DNA-binding proteins and form interaction networks crucial for gene transcription. In addition to identifying large-scale topological structures, including topologically associated domains and A/B compartments, OCEAN-C can detect HOCI-mediated chromatin interactions that are strongly associated with gene expression, super-enhancers, and broad H3K4me3 domains.","authors":[{"name":"Cao Y."},{"name":"Chen Q."},{"name":"Jia L."},{"name":"Li C."},{"name":"Li T."}],"citationCount":41,"date":"2018-04-24T00:00:00Z","journal":"Genome Biology","title":"OCEAN-C: Mapping hubs of open chromatin interactions across the genome reveals gene regulatory networks"},"pmcid":"PMC5926533","pmid":"29690904"}],"topic":[{"term":"Gene regulation","uri":"http://edamontology.org/topic_0204"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"}],"validated":1},"bioschemas":{"name":"OCEAN-C","home":"https://bio.tools/ocean-c","license":"CC-BY-4.0","summary":"Mapping hubs of open chromatin interactions across the genome reveals gene regulatory networks.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ocean-c/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":40,"citations":[{"count":1,"year":"2018"},{"count":3,"year":"2019"},{"count":3,"year":"2025"},{"count":3,"year":"2026"},{"count":4,"year":"2023"},{"count":5,"year":"2020"},{"count":5,"year":"2024"},{"count":7,"year":"2021"},{"count":9,"year":"2022"}],"doi":"10.1186/s13059-018-1430-4","pmcid":"PMC5926533","pmid":"29690904","ref_count":42,"refs":[{"count":1,"year":"2002"},{"count":1,"year":"2007"},{"count":1,"year":"2010"},{"count":1,"year":"2017"},{"count":2,"year":"2011"},{"count":2,"year":"2014"},{"count":2,"year":"2018"},{"count":3,"year":"2008"},{"count":3,"year":"2009"},{"count":4,"year":"2006"},{"count":4,"year":"2013"},{"count":5,"year":"2016"},{"count":6,"year":"2012"},{"count":7,"year":"2015"}],"title":"OCEAN-C: mapping hubs of open chromatin interactions across the genome reveals gene regulatory networks.","year":2018}]}],"readme":true,"summary":{"description":true},"website":{"bioschema