{"tool_name":"bioconductor-bumpymatrix","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-bumpymatrix","home":"https://bioconductor.org/packages/BumpyMatrix","license":"MIT","summary":"Implements the BumpyMatrix class and several subclasses for holding non-scalar objects in each entry of the matrix. This is akin to a ragged array but the raggedness is in the third dimension, much like a bumpy surface - hence the name. Of particular interest is the BumpyDataFrameMatrix, where each entry is a Bioconductor data frame. This allows us to naturally represent multivariate data in a format that is compatible with two-dimensional containers like the SummarizedExperiment and MultiAssayExperiment objects.","addition_date":"2026-08-30T02:38:52.145842Z","last_update_date":"2026-08-30T02:38:52.148173Z","tool_type":["Command-line tool","Library"],"version":["1.20.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-bumpymatrix","credit":[{"name":"Genentech"},{"name":"Inc."},{"name":"Aaron Lun","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/BumpyMatrix"}],"edit_permission":{"type":"private"},"name":"BumpyMatrix","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.18129/B9.bioc.BumpyMatrix"}]},"bioschemas":{"name":"BumpyMatrix","home":"https://bio.tools/bioconductor-bumpymatrix","license":"MIT","version":"1.20.0","summary":"Implements the BumpyMatrix class and several subclasses for holding non-scalar objects in each entry of the matrix. This is akin to a ragged array but the raggedness is in the third dimension, much like a bumpy surface - hence the name. Of particular interest is the BumpyDataFrameMatrix, where each entry is a Bioconductor data frame. This allows us to naturally represent multivariate data in a format that is compatible with two-dimensional containers like the Sum