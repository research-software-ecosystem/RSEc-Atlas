{"tool_name":"caspule","contents":["biotools"],"identifiers":["biotools:caspule"],"fetched_metadata":{"biotools":{"id":"caspule","home":"https://caspule.github.io/caspule/","summary":"CASPULE is a computational pipeline designed to simulate and analyze biological condensates made of sticker-spacer polymers. It uses a unique force field coupled with Langevin dynamics to study the non-trivial biophysics of these subcellular structures.","addition_date":"2026-11-04T17:37:48.469236Z","last_update_date":"2026-11-04T17:37:48.471689Z","biotools_curie":"biotools:caspule","credit":[{"email":"shakhnovich@chemistry.harvard.edu","name":"Eugene I. Shakhnovich","orcidid":"https://orcid.org/0000-0002-4769-2265","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Molecular dynamics","uri":"http://edamontology.org/operation_2476"},{"term":"Nucleic acid structure prediction","uri":"http://edamontology.org/operation_0475"},{"term":"Phasing","uri":"http://edamontology.org/operation_3454"}]}],"name":"CASPULE","owner":"pub2tools2024","publication":[{"doi":"10.1371/JOURNAL.PCBI.1014282","pmcid":"PMC13186343","pmid":"42133743"}],"topic":[{"term":"Biophysics","uri":"http://edamontology.org/topic_3306"},{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]}}}