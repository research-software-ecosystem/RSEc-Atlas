{"tool_name":"transcriptr","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-transcriptr","version":"1.38.3","home":"https://bioconductor.org/packages/3.22/bioc/html/transcriptR.html","license":"GPL-3","summary":"An Integrative Tool for ChIP- And RNA-Seq Based Primary Transcripts Detection and Quantification","identifiers":["biotools:transcriptr","doi:10.1038/nmeth.3252"],"description":"The differences in the RNA types being sequenced have an impact on the resulting sequencing profiles. mRNA-seq data is enriched with reads derived from exons, while GRO-, nucRNA- and chrRNA-seq demonstrate a substantial broader coverage of both exonic and intronic regions. The presence of intronic reads in GRO-seq type of data makes it possible to use it to computationally identify and quantify all de novo continuous regions of transcription distributed across the genome. This type of data, however, is more challenging to interpret and less common practice compared to mRNA-seq. One of the challenges for primary transcript detection concerns the simultaneous transcription of closely spaced genes, which needs to be properly divided into individually transcribed units. The R package transcriptR combines RNA-seq data with ChIP-seq data of histone modifications that mark active Transcription Start Sites (TSSs), such as, H3K4me3 or H3K9/14Ac to overcome this challenge. The advantage of this approach over the use of, for example, gene annotations is that this approach is data driven and therefore able to deal also with novel and case specific events. Furthermore, the integration of ChIP- and RNA-seq data allows the identification all known and novel active transcription start sites within a given sample.","license_file":"/lib/R/share/licenses/GPL-3","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-biocgenerics >=0.56.0,<0.57.0","bioconductor-chipseq >=1.60.0,<1.61.0","bioconductor-genomeinfodb >=1.46.0,<1.47.0","bioconductor-genomicalignments >=1.46.0,<1.47.0","bioconductor-genomicfeatures >=1.62.0,<1.63.0","bioconductor-genomicranges >=1.62.0,<1.63.0","bioconductor-iranges >=2.44.0,<2.45.0","bioconductor-rsamtools >=2.26.0,<2.27.0","bioconductor-rtracklayer >=1.70.0,<1.71.0","bioconductor-s4vectors >=0.48.0,<0.49.0","r-base","r-caret","r-ggplot2","r-proc","r-reshape2"],"run":["bioconductor-biocgenerics >=0.56.0,<0.57.0","bioconductor-chipseq >=1.60.0,<1.61.0","bioconductor-genomeinfodb >=1.46.0,<1.47.0","bioconductor-genomicalignments >=1.46.0,<1.47.0","bioconductor-genomicfeatures >=1.62.0,<1.63.0","bioconductor-genomicranges >=1.62.0,<1.63.0","bioconductor-iranges >=2.44.0,<2.45.0","bioconductor-rsamtools >=2.26.0,<2.27.0","bioconductor-rtracklayer >=1.70.0,<1.71.0","bioconductor-s4vectors >=0.48.0,<0.49.0","r-base","r-caret","r-ggplot2","r-proc","r-reshape2"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/transcriptR_1.38.3.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/transcriptR/transcriptR_1.38.3.tar.gz","https://bioarchive.galaxyproject.org/transcriptR_1.38.3.tar.gz","https://depot.galaxyproject.org/software/bioconductor-transcriptr/bioconductor-transcriptr_1.38.3_src_all.tar.gz"],"test":{"commands":["$R -e \"library('transcriptR')\""]},"parent_recipe":{"name":"bioconductor-transcriptr","path":"recipes/bioconductor-transcriptr","version":"1.8.0"}},"biotools":{"id":"transcriptr","home":"https://bioconductor.org/packages/transcriptR","license":"GPL-3.0","summary":"The differences in the RNA types being sequenced have an impact on the resulting sequencing profiles. mRNA-seq data is enriched with reads derived from exons, while GRO-, nucRNA- and chrRNA-seq demonstrate a substantial broader coverage of both exonic and intronic regions. The presence of intronic reads in GRO-seq type of data makes it possible to use it to computationally identify and quantify all de novo continuous regions of transcription distributed across the genome. This type of data, however, is more challenging to interpret and less common practice compared to mRNA-seq. One of the challenges for primary transcript detection concerns the simultaneous transcription of closely spaced genes, which needs to be properly divided into individually transcribed units. The R package transcriptR combines RNA-seq data with ChIP-seq data of histone modifications that mark active Transcription Start Sites (TSSs), such as, H3K4me3 or H3K9/14Ac to overcome this challenge. The advantage of this approach over the use of, for example, gene annotations is that this approach is data driven and therefore able to deal also with novel and case specific events. Furthermore, the integration of ChIP- and RNA-seq data allows the identification all known and novel active transcription start sites within a given sample.","addition_date":"2017-01-17T14:57:13Z","last_update_date":"2024-11-25T15:29:24.681367Z","tool_type":["Command-line tool","Library"],"version":["1.40.0"],"collections":["BioConductor"],"biotools_curie":"biotools:transcriptr","credit":[{"name":"Armen R. Karapetyan"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/transcriptR"}],"edit_permission":{"authors":["ELIXIR-EE"],"type":"group"},"function":[{"operation":[{"term":"De-novo assembly","uri":"http://edamontology.org/operation_0524"},{"term":"RNA-Seq analysis","uri":"http://edamontology.org/operation_3680"},{"term":"Transcriptome assembly","uri":"http://edamontology.org/operation_3258"}]}],"name":"transcriptR","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.18129/B9.bioc.transcriptR"}],"topic":[{"term":"ChIP-seq","uri":"http://edamontology.org/topic_3169"},{"term":"Data mining","uri":"http://edamontology.org/topic_3473"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"transcriptR","home":"https://bio.tools/transcriptr","license":"GPL-3.0-only","version":"1.40.0","summary":"The differences in the RNA types being sequenced have an impact on the resulting sequencing profiles. mRNA-seq data is enriched with reads derived from exons, while GRO-, nucRNA- and chrRNA-seq demonstrate a substantial broader coverage of both exonic and intronic regions. The presence of intronic reads in GRO-seq type of data makes it possible to use it to computationally identify and quantify all de novo continuous regions of transcription distributed across the genome. This type of data, however, is more challenging to interpret and less common practice compared to mRNA-seq. One of the challenges for primary transcript detection concerns the simultaneous transcription of closely spaced genes, which needs to be properly divided into individually transcribed units. The R package transcriptR combines RNA-seq data with ChIP-seq data of histone modifications that mark active Transcription Start Sites (TSSs), such as, H3K4me3 or H3K9/14Ac to overcome this challenge. The advantage of this approach over the use of, for example, gene annotations is that this approach is data driven and therefore able to deal also with novel and case specific events. Furthermore, the integration of ChIP- and RNA-seq data allows the identification all known and novel active transcription start sites within a given sample.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:transcriptr:1.6.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[