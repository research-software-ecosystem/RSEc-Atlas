{"tool_name":"eurisco","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"eurisco","home":"http://eurisco.ecpgr.org","summary":"Search catalogue providing information about plant genetic resources collections maintained in Europe. It is based on a European network of ex situ and in situ National Inventories (NIs). Currently, it comprises information about 2.1 million germplasm accessions from more than 400 holding institutions from 43 countries. It contains both passport data and phenotypic data.","addition_date":"2016-10-05T07:15:57Z","last_update_date":"2024-12-18T16:46:20.716446Z","tool_type":["Web application"],"version":["2.1.1"],"biotools_curie":"biotools:eurisco","cost":"Free of charge","credit":[{"email":"weise@ipk-gatersleben.de","name":"Stephan Weise","orcidid":"http://orcid.org/0000-0003-4031-9131","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"weise@ipk-gatersleben.de","name":"Stephan Weise","orcidid":"http://orcid.org/0000-0003-4031-9131","typeRole":["Developer"]},{"name":"European Cooperative Programme for Plant Genetic Resources (ECPGR)","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Leibniz Institute of Plant Genetics and Crop Plant Research (IPK) Gatersleben","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["Citation instructions","General","Terms of use"],"url":"http://eurisco.ecpgr.org/"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Keyword","uri":"http://edamontology.org/data_0968"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}],"note":"Based on the Multi Crop Passport Descriptors (MCPD) format","operation":[{"term":"Database search","uri":"http://edamontology.org/operation_2421"}],"output":[{"data":{"term":"Database search results","uri":"http://edamontology.org/data_2080"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"}]}]}],"maturity":"Mature","name":"EURISCO","operating_system":["Linux"],"owner":"ipk","publication":[{"doi":"10.1093/nar/gkac852","metadata":{"abstract":"The European Search Catalogue for Plant Genetic Resources (EURISCO) is a central entry point for information on crop plant germplasm accessions from institutions in Europe and beyond. In total, it provides data on more than two million accessions, making an important contribution to unlocking the vast genetic diversity that lies deposited in >400 germplasm collections in 43 countries. EURISCO serves as the reference system for the Plant Genetic Resources Strategy for Europe and represents a significant approach for documenting and making available the world's agrobiological diversity. EURISCO is well established as a resource in this field and forms the basis for a wide range of research projects. In this paper, we present current developments of EURISCO, which is accessible at http://eurisco.ecpgr.org.","authors":[{"name":"Kotni P."},{"name":"Maggioni L."},{"name":"Oppermann M."},{"name":"Van Hintum T."},{"name":"Weise S."}],"citationCount":6,"date":"2023-01-06T00:00:00Z","journal":"Nucleic Acids Research","title":"EURISCO update 2023: the European Search Catalogue for Plant Genetic Resources, a pillar for documentation of genebank material"},"pmcid":"PMC9825528","pmid":"36189883","type":["Primary"]},{"doi":"10.1093/nar/gkw755","metadata":{"abstract":"The European Search Catalogue for Plant Genetic Resources, EURISCO, provides information about 1.8 million crop plant accessions preserved by almost 400 institutes in Europe and beyond. EURISCO is being maintained on behalf of the European Cooperative Programme for Plant Genetic Resources. It is based on a network of National Inventories of 43 member countries and represents an important effort for the preservation of world's agrobiological diversity by providing information about the large genetic diversity kept by the collaborating collections. Moreover, EURISCO also assists its member countries in fulfilling legal obligations and commitments, e.g. with respect to the International Treaty on Plant Genetic Resources, the Second Global Plan of Action for Plant Genetic Resources for Food and Agriculture of the United Nation's Food and Agriculture Organization, or the Convention on Biological Diversity. EURISCO is accessible at http://eurisco.ecpgr.org.","authors":[{"name":"Knupffer H."},{"name":"Maggioni L."},{"name":"Oppermann M."},{"name":"Van Hintum T."},{"name":"Weise S."}],"citationCount":47,"date":"2017-01-01T00:00:00Z","journal":"Nucleic Acids Research","title":"EURISCO: The European search catalogue for plant genetic resources"},"pmcid":"PMC5210606","pmid":"27580718","type":["Primary"]}],"topic":[{"term":"Data management","uri":"http://edamontology.org/topic_3071"}],"validated":1},"bioschemas":{"name":"EURISCO","home":"https://bio.tools/eurisco","version":"2.1.1","summary":"Search catalogue providing information about plant genetic resources collections maintained in Europe. It is based on a European network of ex situ and in situ National Inventories (NIs). Currently, it comprises information about 2.1 million germplasm accessions from more than 400 holding institutions from 43 countries. It contains both passport data and phenotypic data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:eurisco:1.5.4/web/eurisco.ecpgr.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"citation":true,"general":true,"terms_of_use":true},"publications":[{"entries":[{"cit_count":16,"citations":[{"count":1,"year":"2018"},{"count":1,"year":"2019"},{"count":1,"year":"2022"},{"count":1,"year":"2024"},{"count":1,"year":"2026"},{"count":3,"year":"2023"},{"count":4,"year":"2020"},{"count":4,"year":"2021"}],"doi":"10.1093/nar/gkw755","pmcid":"PMC5210606","pmid":