{"tool_name":"motifsampler","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"motifsampler","home":"http://homes.esat.kuleuven.be/~sistawww/bioi/thijs/Work/MotifSampler.html","summary":"MotifSampler tries to find over-represented motifs in the upstream region of a set of co-regulated genes. This motif finding algorithm uses Gibbs sampling to find the position probability matrix that represents the motif. In this implementation we focus on the use of higher-order background models to improve the robustness of the motif finding. At the moment the MotifSampler comes with background models for several organisms .","addition_date":"2017-12-18T00:09:31Z","last_update_date":"2024-11-25T14:59:14.879613Z","tool_type":["Command-line tool"],"version":["3.2"],"biotools_curie":"biotools:motifsampler","credit":[{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://homes.esat.kuleuven.be/~bioiuser/person.php?persid=81"}],"documentation":[{"type":["General"],"url":"http://homes.esat.kuleuven.be/~sistawww/bioi/thijs/help/help_motifsampler.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Detection","uri":"http://edamontology.org/operation_2423"}]},{"operation":[{"term":"Gibbs sampling","uri":"http://edamontology.org/operation_2238"}]},{"operation":[{"term":"Motif detection","uri":"http://edamontology.org/operation_0239"}]}],"name":"MotifSampler","operating_system":["Linux","Mac","Windows"],"owner":"mbs_import","publication":[{"doi":"10.1093/bioinformatics/17.12.1113","pmid":"11751219","type":["Primary"]}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Organisms","uri":"http://edamontology.org/topic_0621"},{"term":"Probability","uri":"http://edamontology.org/topic_2269"}],"validated":1},"bioschemas":{"name":"MotifSampler","home":"https://bio.tools/motifsampler","version":"3.2","summary":"MotifSampler tries to find over-represented motifs in the upstream region of a set of co-regula