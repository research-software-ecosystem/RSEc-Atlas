{"tool_name":"reactor","contents":["biotools"],"identifiers":["biotools:reactor"],"fetched_metadata":{"biotools":{"id":"reactor","home":"https://www.github.com/elolab/REACTOR","summary":"REACTOR is a computational tool used to detect differential activity of transcriptional regulators (regulons) and their target genes using single-cell RNA-sequencing data. It extends regulon analysis by introducing a statistical test to contrast different biological conditions (e.g., disease vs. control).","addition_date":"2026-11-04T17:32:57.436572Z","last_update_date":"2026-11-04T17:32:57.438974Z","biotools_curie":"biotools:reactor","credit":[{"email":"katury@utu.fi","name":"Kalle T Rytk\u00f6nen","orcidid":"https://orcid.org/0000-0002-5138-0889","typeEntity":"Person"},{"email":"laura.elo@utu.fi","name":"Laura L Elo","orcidid":"https://orcid.org/0000-0001-5648-4532","typeEntity":"Person"},{"email":"tomi.suomi@utu.fi","name":"Tomi Suomi","orcidid":"https://orcid.org/0000-0003-3639-979X","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Differential gene expression profiling","uri":"http://edamontology.org/operation_3223"},{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Gene regulatory network prediction","uri":"http://edamontology.org/operation_2437"}]}],"name":"REACTOR: REgulon Activity analysis and Comparison Tool","owner":"pub2tools2024","publication":[{"doi":"10.1093/BIOINFORMATICS/BTAG203","pmcid":"PMC13218382","pmid":"42082398"}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Multiomics","uri":"http://edamontology.org/topic_4021"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}]}}}