{"tool_name":"r-loom","contents":["biocontainers","oeb"],"fetched_metadata":{"biocontainers":{"name":"r-loom","identifiers":[],"license":"GPL-3","summary":"An interface for the single-cell rnaseq-oriented loom format. loom files are an hdf5-based format for storing and interacting with large single-cell rnaseq datasets. loomr provides an interface for working with loom files in a loom-specific way; we provide routines for validating loom files, iterating with chunks through data within the loom file, and provide a platform for other packages to build support for loom files.","home_url":"https://github.com/mojaveazure/loomR","keywords":["Genomics","RNA-Seq"],"manually_check":true,"total_pulls":3},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:r-loom:0.2.0.1/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":true,"source_packages":false,"sourcecode":{"free":null,"interpreted":null,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"readme":false,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:r-loom:0.2.0.2/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":true,"source_packages":false,"sourcecode":{"free":null,"interpreted":null,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false}