{"tool_name":"infernal","contents":["biocontainers","galaxy","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"infernal","version":"1.1.5","home":"http://eddylab.org/infernal","documentation":"http://eddylab.org/infernal/Userguide.pdf","license":"BSD-3-Clause","summary":"Infernal is for searching DNA sequence databases for RNA structure and sequence similarities.","identifiers":["doi:10.1093/bioinformatics/btt509","biotools:infernal"],"description":"Infernal (INFERence of RNA ALignment) is for searching DNA sequence databases for RNA structure and sequence similarities.","license_file":"LICENSE","build":{"number":4,"run_exports":[null]},"requirements":{"build":[null,"make","autoconf","automake","libtool"],"host":["perl","libgomp","llvm-openmp","wget"],"run":["libgomp","llvm-openmp"]},"source_url":"http://eddylab.org/infernal/infernal-1.1.5.tar.gz","test":{"commands":["cmalign -h","cmbuild -h","cmcalibrate -h","cmconvert -h","cmemit -h","cmfetch -h","cmpress -h","cmscan -h","cmsearch -h","cmstat -h"]}},"biocontainers":{"name":"infernal","identifiers":["doi:10.1093/bioinformatics/btt509"],"license":"GPL-3.0","summary":"Inference of rna secondary structural alignments","home_url":"https://github.com/EddyRivasLab/infernal","keywords":["Nucleic Acid Conformation","RNA","Sequence Alignment","Sequence Analysis, RNA","Sequence Homology, Nucleic Acid"],"manually_check":true,"total_pulls":5463},"biotools":{"id":"infernal","home":"http://eddylab.org/infernal/","license":"BSD-3-Clause","summary":"Infernal (\"INFERence of RNA ALignment\") is for searching DNA sequence databases for RNA structure and sequence similarities. It is an implementation of a special case of profile stochastic context-free grammars called covariance models (CMs). A CM is like a sequence profile, but it scores a combination of sequence consensus and RNA secondary structure consensus, so in many cases, it is more capable of identifying RNA homologs that conserve their secondary structure more than their primary sequence.","addition_date":"2021-02-16T16:35:35Z","last_update_date":"2024-11-24T14:09:20.030815Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:infernal","edit_permission":{"authors":["ELIXIR-CZ","alexcorm","bebatut","sergitobara"],"type":"group"},"function":[{"input":[{"data":{"term":"Sequence profile","uri":"http://edamontology.org/data_1354"},"format":[{"term":"Sequence profile format","uri":"http://edamontology.org/format_2069"}]}],"operation":[{"term":"Nucleic acid feature detection","uri":"http://edamontology.org/operation_0415"}],"output":[{"data":{"term":"Database search results","uri":"http://edamontology.org/data_2080"}}]}],"name":"Infernal","owner":"leipzig","publication":[{"doi":"10.1093/bioinformatics/btt509","metadata":{"abstract":"Summary: Infernal builds probabilistic profiles of the sequence and secondary structure of an RNA family called covariance models (CMs) from structurally annotated multiple sequence alignments given as input. Infernal uses CMs to search for new family members in sequence databases and to create potentially large multiple sequence alignments. Version 1.1 of Infernal introduces a new filter pipeline for RNA homology search based on accelerated profile hidden Markov model (HMM) methods and HMM-banded CM alignment methods. This enables \u223c100-fold acceleration over the previous version and \u223c10 000-fold acceleration over exhaustive non-filtered CM searches. \u00a9 The Author 2013. Published by Oxford University Press. All rights reserved.","authors":[{"name":"Eddy S.R."},{"name":"Nawrocki E.P."}],"citationCount":2024,"date":"2013-11-15T00:00:00Z","journal":"Bioinformatics","title":"Infernal 1.1: 100-fold faster RNA homology searches"},"pmcid":"PMC3810854","pmid":"24008419","type":["Primary"]}],"topic":[{"term":"Sequence sites, features and motifs","uri":"http://edamontology.org/topic_0160"},{"term":"Structural genomics","uri":"http://edamontology.org/topic_0122"}]},"bi