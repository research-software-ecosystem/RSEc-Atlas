{"tool_name":"bioconductor-scmerge","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-scmerge","identifiers":["doi:10.18129/b9.bioc.scmerge"],"license":"GPL-3","summary":"scMerge: Merging multiple batches of scRNA-seq data","home_url":"https://bioconductor.org/packages/3.9/bioc/html/scMerge.html","keywords":["RNA-Seq","Transcriptomics","Gene Expression"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-scmerge","home":"https://bioconductor.org/packages/scMerge","license":"GPL-3.0","summary":"Like all gene expression data, single-cell data suffers from batch effects and other unwanted variations that makes accurate biological interpretations difficult. The scMerge method leverages factor analysis, stably expressed genes (SEGs) and (pseudo-) replicates to remove unwanted variations and merge multiple single-cell data. This package contains all the necessary functions in the scMerge pipeline, including the identification of SEGs, replication-identification methods, and merging of single-cell data.","tool_type":["Command-line tool","Library"],"version":["1.28.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-scmerge","credit":[{"name":"Kevin Wang","typeEntity":"Person","typeRole":["Developer"]},{"name":"Sydney Bioinformatics and Biometrics Group","typeEntity":"Funding agency","typeRole":["Contributor"]},{"name":"Yingxin Lin","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/scMerge"}],"name":"scMerge","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1073/pnas.1820006116"}]},"bioschemas":{"name":"scMerge","home":"https://bio.tools/bioconductor-scmerge","license":"GPL-3.0-only","version":"1.28.0","summary":"Like all gene expression data, single-cell data suffers from batch effects and other unwanted variations that ma