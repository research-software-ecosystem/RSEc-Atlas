{"tool_name":"velot","contents":["biotools"],"identifiers":["biotools:velot"],"fetched_metadata":{"biotools":{"id":"velot","home":"https://velot.readthedocs.io","summary":"VelOT is a kinetic-free framework that infers RNA velocity by treating cellular dynamics as a geometry and transport problem. It uses optimal transport, flow-field smoothing, and VAMP coarse-graining to analyze single-cell RNA sequencing data.","addition_date":"2026-11-05T13:46:22.762137Z","last_update_date":"2026-11-05T13:46:22.766292Z","biotools_curie":"biotools:velot","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene expression profiling","uri":"http://edamontology.org/operation_0314"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"}]}],"name":"VelOT: Kinetic-free RNA velocity inference","owner":"pub2tools2024","publication":[{"doi":"10.64898/2026.06.04.730132"}],"topic":[{"term":"RNA","uri":"http://edamontology.org/topic_0099"},{"term":"Single-cell sequencing","uri":"http://edamontology.org/topic_4028"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"}]}}}