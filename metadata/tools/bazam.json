{"tool_name":"bazam","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bazam","identifiers":["doi:10.1186/s13059-019-1688-1"],"license":"LGPL-2.1","summary":"A tool to extract paired reads in fastq format from coordinate sorted bam files","home_url":"https://github.com/ssadedin/bazam","keywords":["High-Throughput Nucleotide Sequencing","Sequence Alignment"],"manually_check":true,"total_pulls":0},"biotools":{"id":"Bazam","home":"https://github.com/ssadedin/bazam","license":"LGPL-2.1","summary":"Method for read extraction and realignment of high-throughput sequencing data.","addition_date":"2019-08-03T14:51:35Z","last_update_date":"2020-06-16T10:55:24Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:Bazam","cost":"Free of charge","credit":[{"name":"Simon Sadedin","typeEntity":"Person","typeRole":["Primary contact"],"url":"https://github.com/ssadedin"}],"documentation":[{"type":["General"],"url":"https://github.com/ssadedin/bazam/blob/master/README.md"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Read mapping","uri":"http://edamontology.org/operation_3198"},{"term":"Sequence trimming","uri":"http://edamontology.org/operation_3192"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"}]}],"maturity":"Mature","name":"Bazam","operating_system":["Linux","Mac"],"owner":"Ruta","publication":[{"doi":"10.1186/s13059-019-1688-1","metadata":{"abstract":"\u00a9 2019 The Author(s).The vast quantities of short-read sequencing data being generated are often exchanged and stored as aligned reads. However, aligned data becomes outdated as new reference genomes and alignment methods become available. Here we describe Bazam, a tool that efficiently extracts the original paired FASTQ from alignment files (BAM or CRAM format) in a format that directly allows efficient realignment. Bazam facilitates up to a 90% reduction in the time for realignment compared to standard methods. Bazam can support selective extraction of read pairs from focused genomic regions for applications such as targeted region analyses, quality control, structural variant calling, and alignment comparisons.","authors":[{"name":"Oshlack A."},{"name":"Sadedin S.P."}],"citationCount":3,"date":"2019-04-18T00:00:00Z","journal":"Genome Biology","title":"Bazam: A rapid method for read extraction and realignment of high-throughput sequencing data"},"pmcid":"PMC6472072","pmid":"30999943","type":["Primary"]}],"topic":[{"term":"Mapping","uri":"http://edamontology.org/topic_0102"}],"validated":1},"bioschemas":{"name":"Bazam","home":"https://bio.tools/Bazam","license":"LGPL-2.1","summary":"Method for read extraction and realignment of high-throughput sequencing data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:bazam/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":18,"citations":[{"count":1,"year":"2019"},{"count":1,"year":"2021"},{"count":1,"year":"2022"},{"count":1,"year":"2026"},{"count":2,"year":"2020"},{"count":2,"year":"2024"},{"count":4,"year":"2023"},{"count":6,"year":"2025"}],"doi":"10.1186/s13059-019-1688-1","pmcid":"PMC6472072","pmid":"30999943","ref_count":6,"refs":[{"count":1,"year":"2009"},{"count":1,"year":"2012"},{"count":1,"year":"2014"},{"count":1,"year":"2016"},{"count":1,"year":"2018"},{"count":1,"year":"2019"}],"title":"Bazam: a rapid method for read extraction and realignment of high-throu