{"tool_name":"gonomics","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"gonomics","home":"https://github.com/vertgenlab/gonomics","license":"BSD-3-Clause","summary":"A collection of genomics software tools written in Go (golang).","addition_date":"2024-01-29T07:35:44.385594Z","last_update_date":"2024-01-29T07:35:44.388159Z","tool_type":["Command-line tool","Workflow"],"accessibility":"Open access","biotools_curie":"biotools:gonomics","cost":"Free of charge","credit":[{"email":"craig.lowe@duke.edu","name":"Craig B Lowe","orcidid":"https://orcid.org/0000-0002-6838-1976","typeEntity":"Person"},{"name":"Christiana Fauci","typeEntity":"Person"},{"name":"Eric H Au","typeEntity":"Person"}],"documentation":[{"type":["User manual"],"url":"https://pkg.go.dev/github.com/vertgenlab/gonomics"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Formatting","uri":"http://edamontology.org/operation_0335"},{"term":"Gene-set enrichment analysis","uri":"http://edamontology.org/operation_2436"},{"term":"Parsing","uri":"http://edamontology.org/operation_1812"},{"term":"Sorting","uri":"http://edamontology.org/operation_3802"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"}]}],"name":"Gonomics","owner":"Pub2Tools","publication":[{"doi":"10.1093/BIOINFORMATICS/BTAD516","metadata":{"abstract":"Many existing software libraries for genomics require researchers to pick between competing considerations: the performance of compiled languages and the accessibility of interpreted languages. Go, a modern compiled language, provides an opportunity to address this conflict. We introduce Gonomics, an open-source collection of command line programs and bioinformatic libraries implemented in Go that unites readability and performance for genomic analyses. Gonomics contains packages to read, write, and manipulate a wide array of file formats (e.g. FASTA, FASTQ, BED, BEDPE, SAM, BAM, and VCF), and can convert and interface between these formats. Furthermore, our modular library structure provides a flexible platform for researchers developing their own software tools to address specific questions. These commands can be combined and incorporated into complex pipelines to meet the growing need for high-performance bioinformatic resources.","authors":[{"name":"Au E.H."},{"name":"Fauci C."},{"name":"Lowe C.B."},{"name":"Luo Y."},{"name":"Mangan R.J."},{"name":"Shoben C.R."},{"name":"Simpson S.K."},{"name":"Snellings D.A."},{"name":"Weaver S."}],"date":"2023-08-01T00:00:00Z","journal":"Bioinformatics","title":"Gonomics: uniting high performance and readability for genomics with Go"},"pmcid":"PMC10466080","pmid":"37624924"}],"topic":[{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"Mathematics","uri":"http://edamontology.org/topic_3315"},{"term":"Software engineering","uri":"http://edamontology.org/topic_3372"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]},"bioschemas":{"name":"Gonomics","home":"https://bio.tools/gonomics","license":"BSD-3-Clause","summary":"A collection of genomics software tools written in Go (golang).","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:gonomics/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":7,"citations":[{"count":3,"year":"2026"},{"count":4,"year":"2025"}],"doi":"10.1093/bioinformatics/btad516","pmcid":"PMC10466080","pmid":"37624924","ref_count":19,"refs":[{"count":1,"year":"2012"},{"count":1,"year":"2018"},{"count":1,"year":"2020"},{"count":1,"year":"2023"},{"count":2,"year":"2009"},{"count":2,"year":"2010"},{"count":2,"year":"2016"},{"count":3,"year":"2019"},{"count":3,"year":"2021"},{"count":3,"year":"2022"}]