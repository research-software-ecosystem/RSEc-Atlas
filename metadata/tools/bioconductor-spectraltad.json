{"tool_name":"bioconductor-spectraltad","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-spectraltad","identifiers":["doi:10.18129/b9.bioc.spectraltad"],"license":"MIT","summary":"Spectraltad: hierarchical tad detection using spectral clustering","home_url":"https://bioconductor.org/packages/3.11/bioc/html/SpectralTAD.html","keywords":["Metabolomics","Clustering"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-spectraltad","home":"https://bioconductor.org/packages/SpectralTAD","license":"MIT","summary":"SpectralTAD is an R package designed to identify Topologically Associated Domains (TADs) from Hi-C contact matrices. It uses a modified version of spectral clustering that uses a sliding window to quickly detect TADs. The function works on a range of different formats of contact matrices and returns a bed file of TAD coordinates. The method does not require users to adjust any parameters to work and gives them control over the number of hierarchical levels to be returned.","addition_date":"2026-08-30T02:53:00.238441Z","last_update_date":"2026-08-30T02:53:00.240867Z","tool_type":["Command-line tool","Library"],"version":["1.28.2"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-spectraltad","credit":[{"name":"John Stansfield","typeEntity":"Person","typeRole":["Developer"]},{"name":"Kellen Cresswell","typeEntity":"Person","typeRole":["Developer"]},{"name":"Mikhail Dozmorov","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/SpectralTAD"}],"edit_permission":{"type":"private"},"name":"SpectralTAD","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.1186/s12859-020-03652-w"}]},"bioschemas":{"name":"SpectralTAD","home":"https://bio.tools/bioconductor-spectraltad","license":"MIT","version":"1.28.0","summary":"SpectralTAD is an R p