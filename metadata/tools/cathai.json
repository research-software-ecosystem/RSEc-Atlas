{"tool_name":"cathai","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"cathai","home":"https://cathai.fordelab.com","license":"GPL-3.0","summary":"Cluster analysis tool for healthcare-associated infections.","addition_date":"2023-11-07T11:24:36.904974Z","last_update_date":"2024-11-24T14:33:05.360017Z","tool_type":["Web application"],"accessibility":"Open access","biotools_curie":"biotools:cathai","cost":"Free of charge","credit":[{"email":"b.forde@uq.edu.au","name":"Brian M Forde","orcidid":"https://orcid.org/0000-0002-2264-4785","typeEntity":"Person"},{"name":"Budi Permana","typeEntity":"Person"},{"name":"Patrick N A Harris","typeEntity":"Person"},{"name":"Scott A Beatson","typeEntity":"Person"},{"name":"Thom Cuddihy","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"CATHAI","operating_system":["Linux","Mac","Windows"],"owner":"Pub2Tools","publication":[{"doi":"10.1093/bioadv/vbac040","metadata":{"abstract":"Motivation: Whole genome sequencing (WGS) is revolutionizing disease surveillance where it facilitates high-resolution clustering of related organism and outbreak detection. However, visualizing and efficiently communicating genomic data back to clinical staff is crucial for the successful deployment of a targeted infection control response. Results: CATHAI (cluster analysis tool for healthcare-associated infections) is an interactive web-based visualization platform that couples WGS informed clustering with associated metadata, thereby converting sequencing data into informative and accessible clinical information for the management of healthcare-associated infections (HAI) and nosocomial outbreaks.","authors":[{"name":"Beatson S.A."},{"name":"Cuddihy T."},{"name":"Forde B.M."},{"name":"Harris P.N.A."},{"name":"Permana B."}],"citationCount":5,