{"tool_name":"umis","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"umis","identifiers":["biotools:umis","doi:10.1038/nmeth.4220"],"license":"MIT","summary":"Tools for processing UMI RNA-tag data","home_url":"https://github.com/vals/umis","keywords":["Animals","Embryonic Stem Cells","Freezing","Mice","Poly A","RNA, Messenger","Sensitivity and Specificity","Sequence Analysis, RNA","Single-Cell Analysis","Workflow","Gene expression","RNA-seq","RNA-Seq"],"manually_check":true,"total_pulls":22},"biotools":{"id":"umis","home":"https://github.com/vals/umis/","license":"MIT","summary":"A package that provides tools for estimating expression in RNA-Seq data which performs sequencing of end tags of transcript, and incorporate molecular tags to correct for amplification bias.","addition_date":"2018-06-11T12:08:47Z","last_update_date":"2024-11-25T13:49:31.005840Z","tool_type":["Suite"],"accessibility":"Open access","biotools_curie":"biotools:umis","cost":"Free of charge","credit":[{"email":"vale@ebi.ac.uk","name":"Valentine Svensson","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"RNA sequence (raw)","uri":"http://edamontology.org/data_3496"},"format":[{"term":"FASTQ","uri":"http://edamontology.org/format_1930"}]}],"operation":[{"term":"RNA-Seq analysis","uri":"http://edamontology.org/operation_3680"},{"term":"RNA-Seq quantification","uri":"http://edamontology.org/operation_3800"}],"output":[{"data":{"term":"Report","uri":"http://edamontology.org/data_2048"}}]}],"maturity":"Mature","name":"umis","owner":"ELIXIR-EE","publication":[{"doi":"10.1038/nmeth.4220","metadata":{"abstract":"single-cell rnA sequencing (scrnA-seq) has become an established and powerful method to investigate transcriptomic cell-to-cell variation, thereby revealing new cell types and providing insights into developmental processes and transcriptional stochasticity. A key question is how the variety of available protocols compare in terms of their ability to detect and accurately quantify gene expression. here, we assessed the protocol sensitivity and accuracy of many published data sets, on the basis of spike-in standards and uniform data processing. For our work?ow, we developed a flexible tool for counting the number of unique molecular identifers (https://github.com/ vals/umis/). We compared 15 protocols computationally and 4 protocols experimentally for batch-matched cell populations, in addition to investigating the effects of spike-in molecular degradation. our analysis provides an integrated framework for comparing scrnA-seq protocols.","authors":[{"name":"Cvejic A."},{"name":"Labalette C."},{"name":"Ly L.H."},{"name":"Macaulay I.C."},{"name":"Miragaia R.J."},{"name":"Natarajan K.N."},{"name":"Svensson V."},{"name":"Teichmann S.A."}],"citationCount":392,"date":"2017-03-06T00:00:00Z","journal":"Nature Methods","title":"Power analysis of single-cell rnA-sequencing experiments"},"pmcid":"PMC5376499","pmid":"28263961"}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"bioschemas":{"name":"umis","home":"https://bio.tools/umis","license":"MIT","summary":"A package that provides tools for estimating expression in RNA-Seq data which performs sequencing of end tags of transcript, and incorporate molecular tags to correct for amplification bias.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:umis/suite/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}