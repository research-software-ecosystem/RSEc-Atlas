{"tool_name":"bioconductor-metabocoreutils","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-metabocoreutils","home":"https://bioconductor.org/packages/Spectra","license":"Artistic-2.0","summary":"The Spectra package defines an efficient infrastructure for storing and handling mass spectrometry spectra and functionality to subset, process, visualize and compare spectra data. It provides different implementations (backends) to store mass spectrometry data. These comprise backends tuned for fast data access and processing and backends for very large data sets ensuring a small memory footprint.","addition_date":"2026-08-30T02:45:52.318905Z","last_update_date":"2026-09-01T06:33:14.586239Z","tool_type":["Command-line tool","Library"],"version":["1.22.2"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-metabocoreutils","credit":[{"name":"Ahlam Mentag","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Guillaume Deflandre","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Jan Stanstrup","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Johannes Rainer","typeEntity":"Person","typeRole":["Developer"]},{"name":"Laurent Gatto","typeEntity":"Person","typeRole":["Developer"]},{"name":"Mar Garcia-Aloy","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Nir Shahaf","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Philippine Louail","typeEntity":"Person","typeRole":["Developer"]},{"name":"RforMassSpectrometry Package Maintainer","typeEntity":"Person","typeRole":["Maintainer"]},{"name":"Sebastian Gibb","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/Spectra"}],"edit_permission":{"type":"private"},"name":"MetaboCoreUtils","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.3390/metabo12020173"}]},"bioschemas":{"name":"MetaboCoreUtils","home":"https://bio.tools/bioconductor-metabocoreutils","license":"Artistic-2.0","version":"1.20.1","summary":"MetaboCoreUtils defines metabolomics-related core functionality provided as low-level functions to allow a data structure-independent usage across various R packages. This includes functions to calculate between ion (adduct) and compound mass-to-charge ratios and masses or functions to work with chemical formulas. The package provides also a set of adduct definitions and information on some commercially available internal standard mixes commonly used in MS experiments.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-metabocoreutils:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-metabocoreutils:1.10.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-metabocoreutils:1.2.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publica