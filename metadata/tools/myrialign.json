{"tool_name":"myrialign","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"myrialign","home":"http://savannah.nongnu.org/projects/myrialign","summary":"Software to align short reads produced by a short read genome sequencer to a reference genome. It performs brute force alignment using a variant on the \"bitap\" algorithm that aligns several thousand reads to a reference in parallel. It uses bit-parallelism, multiple processors, and Cell SPUs if available.\nIt will find alignments with any number of errors up to a user specified cutoff. The emphasis is on doing a 100% accurate search as fast as is possible.","addition_date":"2017-01-13T13:15:37Z","last_update_date":"2018-12-10T12:58:59Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:myrialign","credit":[{"name":"Paul Harrison","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://savannah.nongnu.org/users/pfh"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Read mapping","uri":"http://edamontology.org/operation_3198"},{"term":"Sequence alignment","uri":"http://edamontology.org/operation_0292"}]}],"maturity":"Legacy","name":"Myrialign","operating_system":["Linux","Mac","Windows"],"owner":"seqwiki_import","topic":[{"term":"Mapping","uri":"http://edamontology.org/topic_0102"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:myrialign/cmd/savannah.nongnu.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":200,"ssl":null,"ssl_err":null}},"support":{"email":false}},{"@id":"https://openebench.bsc.es/monitor/metrics/myrialign","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","proj