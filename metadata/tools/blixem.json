{"tool_name":"blixem","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"blixem","identifiers":["biotools:blixem","doi:10.1093/bioinformatics/10.3.301"],"license":"GPL-3.0+","summary":"Interactive browser of sequence alignments","home_url":"http://www.sanger.ac.uk/science/tools/seqtools","keywords":["Amino Acid Sequence","Base Sequence","DNA","Exons","Molecular Sequence Data","Sequence Alignment","Sequence Homology, Nucleic Acid","Software Design","Sequence analysis","Phylogenetics"],"manually_check":true,"total_pulls":0},"biotools":{"id":"blixem","home":"http://sonnhammer.sbc.su.se/Blixem.html","license":"GPL-3.0","summary":"A graphical blast viewer","addition_date":"2017-01-13T13:13:51Z","last_update_date":"2024-11-25T14:18:13.695928Z","tool_type":["Desktop application"],"collections":["BLAST utility"],"biotools_curie":"biotools:blixem","credit":[{"email":"Erik.Sonnhammer@scilifelab.se","name":"Erik Sonnhammer","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://sonnhammer.sbc.su.se/Blixem.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Sequence visualisation","uri":"http://edamontology.org/operation_0564"}]}],"name":"Blixem","operating_system":["Linux"],"owner":"seqwiki_import","publication":[{"doi":"10.1093/bioinformatics/10.3.301","metadata":{"abstract":"When routinely analysing very long stretches of DNA sequences produced by genome sequencing projects, detailed analysis of database search results becomes exceedingly time consuming. To reduce the tedious browsing of large quantities of protein similarities, two programs, MSPcrunch and Blixem, were developed, which assist in processing the results from the database search programs in the BLAST suite. MSPcrunch removes biased composition and redundant matches while keeping weak matches that are consistent with a larger gapped alignment. This makes BLASTsearching in practice more sensitive and reduces the risk of overlooking distant similarities. Blixem is a multiple sequence alignment viewer for X-windows which makes it significantly easier to scan and evaluate the matches ratified by MSPcrunch. In Blixem, matches to the translated DNA query sequence are simultaneously aligned in three frames. Also, the distribution of matches over the whole DNA query is displayed. Examples of usage are drawn from 36 C.elegans cosmid clones totalling 1.2 megabases, to which these tools were applied. \u00a9 1994 Oxford University Press.","authors":[{"name":"Durbin R."},{"name":"Sonnhammer E.L.L."}],"citationCount":111,"date":"1994-06-01T00:00:00Z","journal":"Bioinformatics","title":"A workbench for large-scale sequence homology analysis"},"pmid":"7922687"}],"topic":[{"term":"Phylogenetics","uri":"http://edamontology.org/topic_3293"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"bioschemas":{"name":"Blixem","home":"https://bio.tools/blixem","license":"GPL-3.0","summary":"A graphical blast viewer","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:blixem/app/sonnhammer.sbc.su.se","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":38,"citations":[{"count":1,"year":"2005"},{"count":1,"year":"2010"},{"count":1,"year":"2011"},{"count":1,"year":"2016"},{"count":2,"year":"1996"},{"count":2,"year":"2002"},{"count":2,"year":"2004"},{"count":2,"year":"2008"},{"count":2,"year":"2012"},{"count":2,"year":"2014"},{"count":3,"year":"1998"},{"count":3,"year":"1999"},{"count":3,"year":"2001"},{"count":4,"year":"1997"},{"count":4,"year":"2000"},{"count":5,"year":"2003"}],"doi":"10.1093/bioinformatics/10.3.301","pmid":"7922687","ref_count":0,"refs":[],"titl