{"tool_name":"phenoscanner","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"PhenoScanner","home":"http://www.phenoscanner.medschl.cam.ac.uk/","license":"Unlicense","summary":"Database of human genotype-phenotype associations.","addition_date":"2019-07-04T11:42:52Z","last_update_date":"2024-11-25T13:45:01.968448Z","tool_type":["Command-line tool","Database portal","Web API","Web application"],"version":["2"],"accessibility":"Open access","biotools_curie":"biotools:PhenoScanner","cost":"Free of charge","credit":[{"email":"phenoscanner@gmail.com","typeEntity":"Project","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://www.phenoscanner.medschl.cam.ac.uk/information/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene expression QTL analysis","uri":"http://edamontology.org/operation_3232"},{"term":"Haplotype mapping","uri":"http://edamontology.org/operation_0487"},{"term":"Linkage disequilibrium calculation","uri":"http://edamontology.org/operation_0488"}]}],"maturity":"Mature","name":"PhenoScanner","operating_system":["Linux","Mac","Windows"],"owner":"Ruta","publication":[{"doi":"10.1093/bioinformatics/btz469","metadata":{"abstract":"PhenoScanner is a curated database of publicly available results from large-scale genetic association studies in humans. This online tool facilitates 'phenome scans', where genetic variants are cross-referenced for association with many phenotypes of different types. Here we present a major update of PhenoScanner ('PhenoScanner V2'), including over 150 million genetic variants and more than 65 billion associations (compared to 350 million associations in PhenoScanner V1) with diseases and traits, gene expression, metabolite and protein levels, and epigenetic markers. The query options have been extended to include searches by genes, genomic regions and phenotypes, as well as for genetic variants. All variants are positionally annotated using the Variant Effect Predictor and the phenotypes are mapped to Experimental Factor Ontology terms. Linkage disequilibrium statistics from the 1000 Genomes project can be used to search for phenotype associations with proxy variants.","authors":[{"name":"Blackshaw J.A."},{"name":"Burgess S."},{"name":"Butterworth A.S."},{"name":"Danesh J."},{"name":"Kamat M.A."},{"name":"Staley J.R."},{"name":"Surendran P."},{"name":"Young R."}],"citationCount":1222,"date":"2019-11-01T00:00:00Z","journal":"Bioinformatics","title":"PhenoScanner V2: An expanded tool for searching human genotype-phenotype associations"},"pmcid":"PMC6853652","pmid":"31233103","type":["Primary"]}],"topic":[{"term":"Epigenetics","uri":"http://edamontology.org/topic_3295"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Phenomics","uri":"http://edamontology.org/topic_3298"}],"validated":1},"bioschemas":{"name":"PhenoScanner","home":"https://bio.tools/PhenoScanner","license":"Unlicense","version":"2","summary":"Database of human genotype-phenotype associations.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:phenoscanner:2/cmd/www.phenoscanner.medschl.cam.ac.uk","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":1238,"citations":[{"count":1,"year":"-1"},{"count":6,"year":"2019"},{"count":40,"year":"2020"},{"count":65,"year":"2026"},{"count":89,"year":"2021"},{"count":134,"year":"2022"},{"count":214,"year":"2025"},{"count":253,"year":"2023"},{"count":436,"year":"2024"}],"doi":