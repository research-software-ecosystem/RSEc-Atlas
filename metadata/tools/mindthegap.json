{"tool_name":"mindthegap","contents":["biocontainers","bioschemas","debian","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"mindthegap","version":"2.3.0","home":"https://github.com/GATB/mindthegap","license":"AGPL-3.0-or-later","summary":"MindTheGap performs detection and assembly of DNA insertion variants in NGS read datasets with respect to a reference genome. MindTheGap can also be used as a genome assembly finishing tool, it can fill the gaps between a set of input contigs without any a priori on their relative order and orientation.","identifiers":["biotools:mindthegap","doi:10.1093/bioinformatics/btu545"],"license_file":"LICENSE","build":{"number":6,"run_exports":[null]},"requirements":{"build":["make",null,null,"cmake","pkg-config"],"host":["cppunit","zlib"]},"source_url":"https://github.com/GATB/mindthegap/releases/download/v2.3.0/mindthegap-v2.3.0-Source.tar.gz","test":{"commands":["MindTheGap fill"]}},"biocontainers":{"name":"mindthegap","identifiers":["biotools:mindthegap","doi:10.1093/bioinformatics/btu545"],"license":"AGPL-3.0-only","summary":"Mindthegap performs detection and assembly of dna insertion variants in ngs read datasets with respect to a reference genome.","home_url":"https://github.com/GATB/MindTheGap","keywords":["Animals","Caenorhabditis elegans","Genome","Humans","Mutagenesis, Insertional","Sequence Analysis, DNA","Genetic variation","Genomics","Metagenomics"],"manually_check":true,"total_pulls":24},"biotools":{"id":"mindthegap","home":"https://gatb.inria.fr/software/mind-the-gap/","summary":"Performs detection and assembly of DNA insertion variants in NGS read datasets with respect to a reference genome.","addition_date":"2015-01-21T15:12:24Z","last_update_date":"2024-11-24T20:58:48.627968Z","tool_type":["Command-line tool"],"version":["1.0"],"collections":["GATB"],"biotools_curie":"biotools:mindthegap","cost":"Free of charge","credit":[{"email":"claire.lemaitre@inria.fr","name":"Claire Lemaitre","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"GenOuest","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["General"],"url":"https://gatb.inria.fr/software/mind-the-gap/"}],"edit_permission":{"authors":["GenOuest"],"type":"group"},"function":[{"input":[{"data":{"term":"Nucleic acid sequence (raw)","uri":"http://edamontology.org/data_2975"},"format":[{"term":"FASTQ-like format (text)","uri":"http://edamontology.org/format_2182"}]}],"note":"Performs detection and assembly of DNA insertion variants in NGS read datasets with respect to a reference genome.","operation":[{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"}],"output":[{"data":{"term":"Nucleic acid sequence","uri":"http://edamontology.org/data_2977"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}]}],"maturity":"Emerging","name":"MindTheGap","operating_system":["Linux","Mac","Windows"],"owner":"clemaitre","publication":[{"doi":"10.1093/bioinformatics/btu545","metadata":{"abstract":"Motivation: Insertions play an important role in genome evolution. However, such variants are difficult to detect from short-read sequencing data, especially when they exceed the paired-end insert size. Many approaches have been proposed to call short insertion variants based on paired-end mapping. However, there remains a lack of practical methods to detect and assemble long variants. Results: We propose here an original method, called MindTheGap, for the integrated detection and assembly of insertion variants from re-sequencing data. Importantly, it is designed to call insertions of any size, whether they are novel or duplicated, homozygous or heterozygous in the donor genome. MINDTHEGAP uses an efficient k-mer-based method to detect insertion sites in a reference genome, and subsequently assemble them from the donor reads. MINDTHEGAP showed high recall and precision on simulated datasets of various genome complexities. When applied to real Caenorhabditis elegans and human NA12878 datasets, MINDTHEGAP detected and correctly assembled insertions>1kb, using at most 14GB of memory.","authors":[{"name":"Chikhi R."},{"name":"Gouin A."},{"name":"Lemaitre C."},{"name":"Rizk G."}],"citationCount":41,"date":"2014-12-15T00:00:00Z","journal":"Bioinformatics","title":"MindTheGap: Integrated detection and assembly of short and long insertions"},"pmcid":"PMC4253827","pmid":"25123898","type":["Primary"]}],"topic":[{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"}],"validated":1},"bioschemas":{"name":"MindTheGap","home":"https://bio.tools/mindthegap","version":"1.0","summary":"Performs detection and assembly of DNA insertion variants in NGS read datasets with respect to a reference genome.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mindthegap:1.0/cmd/gatb.inria.fr","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":27,"citations":[{"count":1,"year":"2018"},{"count":1,"year":"2021"},{"count":1,"year":"2023"},{"count":1,"year":"2026"},{"count":2,"year":"2017"},{"count":2,"year":"2019"},{"count":2,"year":"2025"},{"count":3,"year":"2016"},{"count":3,"year":"2022"},{"count":5,"year":"2015"},{"count":6,"year":"2020"}],"doi":"10.1093/bioinformatics/btu545","pmcid":"PMC4253827","pmid":"25123898","ref_count":23,"refs":[{"count":2,"year":"2012"},{"count":2,"year":"2014"},{"count":4,"year":"2011"},{"count":4,"year":"2013"},{"count":5,"year":"2009"},{"count":6,"year":"2010"}],"title":"MindTheGap: integrated detection and assembly of short and long insertions.","year":2014}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"email":true}},{"@id":"https://openebench.bsc.