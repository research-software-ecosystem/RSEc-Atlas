{"tool_name":"eagle","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"eagle","identifiers":["biotools:eagle","doi:10.1093/bioinformatics/btv189"],"license":"MIT","summary":"Eagle is a webtool for genome variants and snp analysis","home_url":"https://bitbucket.org/christopherschroeder/eagle","keywords":["DNA, Viral","Disease Outbreaks","Ebolavirus","Genome, Human","Genome, Viral","Hemorrhagic Fever, Ebola","Humans","Sequence Analysis, DNA","Viral Proteins","Genomics","Sequencing","Virology"],"manually_check":true,"total_pulls":0},"biotools":{"id":"eagle","home":"http://bioinformatics.ua.pt/software/eagle/","license":"GPL-3.0","summary":"EAGLE is an alignment-free method and associated program to compute relative absent words (RAW) in genomic sequences using a reference sequence.","addition_date":"2017-08-20T15:34:45Z","last_update_date":"2024-11-25T14:05:49.078710Z","tool_type":["Command-line tool"],"collections":["Animal and Crop Genomics"],"biotools_curie":"biotools:eagle","credit":[{"email":"jlo@ua.pt","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/pratas/eagle/blob/master/README.md"}],"edit_permission":{"authors":["animalandcropgenomics"],"type":"group"},"function":[{"operation":[{"term":"Sequence feature detection","uri":"http://edamontology.org/operation_0253"},{"term":"Sequence word comparison","uri":"http://edamontology.org/operation_0288"}]}],"name":"Eagle","operating_system":["Linux"],"owner":"admin","publication":[{"doi":"10.1093/bioinformatics/btv189","metadata":{"abstract":"Motivation: Ebola virus causes high mortality hemorrhagic fevers, with more than 25 000 cases and 10000 deaths in the current outbreak. Only experimental therapies are available, thus, novel diagnosis tools and druggable targets are needed. Results: Analysis of Ebola virus genomes from the current outbreak reveals the presence of short DNA sequences that appear nowhere in the human genome. We identify the shortest such sequences with lengths between 12 and 14. Only three absent sequences of length 12 exist and they consistently appear at the same location on two of the Ebola virus proteins, in all Ebola virus genomes, but nowhere in the human genome. The alignment-free method used is able to identify pathogen-specific signatures for quick and precise action against infectious agents, of which the current Ebola virus outbreak provides a compelling example.","authors":[{"name":"Castro L."},{"name":"Ferreira P.J.S.G."},{"name":"Pinho A.J."},{"name":"Pratas D."},{"name":"Silva R.M."}],"citationCount":37,"date":"2015-08-01T00:00:00Z","journal":"Bioinformatics","title":"Three minimal sequences found in Ebola virus genomes and absent from human DNA"},"pmcid":"PMC4514932","pmid":"25840045","type":["Primary"]}],"topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"},{"term":"Virology","uri":"http://edamontology.org/topic_0781"}],"validated":1},"bioschemas":{"name":"Eagle","home":"https://bio.tools/eagle","license":"GPL-3.0","summary":"EAGLE is an alignment-free method and associated program to compute relative absent words (RAW) in genomic sequences using a reference sequence.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:eagle/cmd/bioinformatics.ua.pt","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1093