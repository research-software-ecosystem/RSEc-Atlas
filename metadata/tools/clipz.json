{"tool_name":"clipz","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"clipz","home":"http://www.clipz.unibas.ch","summary":"Automatic functional annotation of short reads resulting primarily from crosslinking and immunoprecipitation experiments (CLIP) performed with RNA-binding proteins to identify the binding sites of these proteins. The functional annotation could be also applied to short reads resulting from other type of experiments. The platform enables visualization and mining of individual data sets as well as analysis involving multiple experimental data sets.","addition_date":"2017-03-27T08:35:30Z","last_update_date":"2024-11-25T15:54:48.451222Z","tool_type":["Database portal"],"biotools_curie":"biotools:clipz","credit":[{"email":"mihaela.zavolan@unibas.ch","name":"Mihaela Zavolan","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://en.wikipedia.org/wiki/CLIPZ"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Peak calling","uri":"http://edamontology.org/operation_3222"},{"term":"Protein binding site prediction","uri":"http://edamontology.org/operation_2575"},{"term":"Transcription factor binding site prediction","uri":"http://edamontology.org/operation_0445"},{"term":"Transcriptional regulatory element prediction","uri":"http://edamontology.org/operation_0438"}]}],"name":"CLIPZ","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"doi":"10.1093/nar/gkq940","pmcid":"PMC3013791","pmid":"21087992"}],"topic":[{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"Protein binding sites","uri":"http://edamontology.org/topic_3534"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"}],"validated