{"tool_name":"cindex","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-cindex","version":"1.34.0","home":"https://bioconductor.org/packages/3.20/bioc/html/CINdex.html","license":"GPL (>= 2)","summary":"Chromosome Instability Index","identifiers":["biotools:cindex","doi:10.1038/nmeth.3252"],"description":"The CINdex package addresses important area of high-throughput genomic analysis. It allows the automated processing and analysis of the experimental DNA copy number data generated by Affymetrix SNP 6.0 arrays or similar high throughput technologies. It calculates the chromosome instability (CIN) index that allows to quantitatively characterize genome-wide DNA copy number alterations as a measure of chromosomal instability. This package calculates not only overall genomic instability, but also instability in terms of copy number gains and losses separately at the chromosome and cytoband level.","license_file":"/lib/R/share/licenses/GPL-3","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-genomeinfodb >=1.42.0,<1.43.0","bioconductor-genomicranges >=1.58.0,<1.59.0","bioconductor-iranges >=2.40.0,<2.41.0","bioconductor-s4vectors >=0.44.0,<0.45.0","r-base","r-bitops","r-dplyr","r-gplots","r-gridextra","r-png","r-som","r-stringr"],"run":["bioconductor-genomeinfodb >=1.42.0,<1.43.0","bioconductor-genomicranges >=1.58.0,<1.59.0","bioconductor-iranges >=2.40.0,<2.41.0","bioconductor-s4vectors >=0.44.0,<0.45.0","r-base","r-bitops","r-dplyr","r-gplots","r-gridextra","r-png","r-som","r-stringr"]},"source_url":["https://bioconductor.org/packages/3.20/bioc/src/contrib/CINdex_1.34.0.tar.gz","https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/CINdex/CINdex_1.34.0.tar.gz","https://bioarchive.galaxyproject.org/CINdex_1.34.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-cindex/bioconductor-cindex_1.34.0_src_all.tar.gz"],"te