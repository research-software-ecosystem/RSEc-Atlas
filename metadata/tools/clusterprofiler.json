{"tool_name":"clusterprofiler","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-clusterprofiler","version":"4.18.4","home":"https://bioconductor.org/packages/3.22/bioc/html/clusterProfiler.html","license":"Artistic-2.0","summary":"A universal enrichment tool for interpreting omics data","identifiers":["biotools:clusterprofiler"],"description":"This package supports functional characteristics of both coding and non-coding genomics data for thousands of species with up-to-date gene annotation. It provides a universal interface for gene functional annotation from a variety of sources and thus can be applied in diverse scenarios. It provides a tidy interface to access, manipulate, and visualize enrichment results to help users achieve efficient data interpretation. Datasets obtained from multiple treatments and time points can be analyzed and compared in a single run, easily revealing functional consensus and differences among distinct gene clusters.","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-annotationdbi >=1.72.0,<1.73.0","bioconductor-dose >=4.4.0,<4.5.0","bioconductor-enrichplot >=1.30.0,<1.31.0","bioconductor-go.db >=3.22.0,<3.23.0","bioconductor-gosemsim >=2.36.0,<2.37.0","bioconductor-qvalue >=2.42.0,<2.43.0","r-base","r-dplyr","r-gson >=0.0.7","r-httr","r-igraph","r-magrittr","r-plyr","r-rlang","r-tidyr","r-yulab.utils >=0.2.3"],"run":["bioconductor-annotationdbi >=1.72.0,<1.73.0","bioconductor-dose >=4.4.0,<4.5.0","bioconductor-enrichplot >=1.30.0,<1.31.0","bioconductor-go.db >=3.22.0,<3.23.0","bioconductor-gosemsim >=2.36.0,<2.37.0","bioconductor-qvalue >=2.42.0,<2.43.0","r-base","r-dplyr","r-gson >=0.0.7","r-httr","r-igraph","r-magrittr","r-plyr","r-rlang","r-tidyr","r-yulab.utils >=0.2.3"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/clusterProfiler_4.18.4.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/clusterProfiler/clusterProfiler_4.18.4.tar.gz","https://bioarchive.galaxyproject.org/clusterProfiler_4.18.4.tar.gz","https://depot.galaxyproject.org/software/bioconductor-clusterprofiler/bioconductor-clusterprofiler_4.18.4_src_all.tar.gz"],"test":{"commands":["$R -e \"library('clusterProfiler')\""]},"parent_recipe":{"name":"bioconductor-clusterprofiler","path":"recipes/bioconductor-clusterprofiler","version":"3.8.1"}},"biotools":{"id":"clusterprofiler","home":"https://bioconductor.org/packages/clusterProfiler","license":"Artistic-2.0","summary":"A universal tool for interpreting functional characteristics of omics data. It supports Over-Representation Analysis (ORA) and Gene Set Enrichment Analysis (GSEA) for both coding and non-coding genomics data of thousands of species. It provides a unified and tidy interface to access, manipulate, and visualize enrichment results. A key capability is the simultaneous analysis and comparison of datasets from multiple treatments or time points. Furthermore, it integrates Large Language Model (LLM) capabilities to provide automated and insightful interpretation of enrichment results.","addition_date":"2017-01-17T14:58:04Z","last_update_date":"2026-08-30T02:07:18.715036Z","tool_type":["Command-line tool","Library"],"version":["4.20.0"],"collections":["BioConductor"],"biotools_curie":"biotools:clusterprofiler","cost":"Free of charge","credit":[{"name":"Chun-Hui Gao","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Giovanni Dall'Olio","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Guangchuang Yu","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Li-Gen Wang","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Meijun Chen","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Wanqian Wei","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Xiao Luo","typeEntity":"Person","typeRole":["Contributor"]}],"documentation":[{"type":["User manual