{"tool_name":"plasmidfinder","contents":["biocontainers","galaxy","bioschemas","biotools","oeb"],"fetched_metadata":{"biocontainers":{"name":"plasmidfinder","identifiers":["doi:10.1128/AAC.02412-14"],"license":"Apache Version 2.0","summary":"Plasmidfinder allows identification of plasmids in total or partial sequenced isolates of bacteria.","home_url":"https://bitbucket.org/genomicepidemiology/plasmidfinder","keywords":["Computer Simulation","Databases, Genetic","Drug Resistance, Bacterial","Enterobacteriaceae","Genome, Bacterial","Internet","Multilocus Sequence Typing","Plasmids","Replicon","Reproducibility of Results"],"manually_check":true,"total_pulls":4},"biotools":{"id":"PlasmidFinder","home":"https://cge.cbs.dtu.dk/services/PlasmidFinder/","summary":"PlasmidFinder is a tool for the identification and typing of Plasmid Replicons in Whole-Genome Sequencing (WGS).","addition_date":"2020-01-09T17:51:12Z","last_update_date":"2024-11-24T14:09:31.990632Z","biotools_curie":"biotools:PlasmidFinder","edit_permission":{"authors":["ELIXIR-CZ","Imran_24","hakimul80"],"type":"group"},"function":[{"operation":[{"term":"Genome assembly","uri":"http://edamontology.org/operation_0525"},{"term":"Multilocus sequence typing","uri":"http://edamontology.org/operation_3840"},{"term":"Scaffolding","uri":"http://edamontology.org/operation_3216"}]}],"name":"PlasmidFinder","owner":"Pub2Tools","publication":[{"doi":"10.1007/978-1-4939-9877-7_20","metadata":{"abstract":"PlasmidFinder and in silico plasmid multiLocus sequence typing (pMLST) are two easy-to-use web tools for detection and characterization of plasmid sequences in whole-genome sequencing (WGS) data from Enterobacteriaceae. These tools have been adopted worldwide and facilitate plasmid detection and typing based on draft genomes of multi-drug-resistant Enterobacteriaceae. The PlasmidFinder database currently includes 133 unique plasmid replicon sequences. It was built starting with 126 sequences devised on fully sequenced plasmids available at the NCBI nucleotide database in 2014 and has been continuously updated to include novel replicons detected in more recently sequenced plasmids associated with the family Enterobacteriaceae. PlasmidFinder is usable for replicon sequence analysis of raw as well as assembled sequencing data. For pMLST analysis, a weekly updated database was generated from www.pubmlst.org and integrated into a web tool called in silico pMLST.","authors":[{"name":"Carattoli A."},{"name":"Hasman H."}],"citationCount":304,"date":"2020-01-01T00:00:00Z","journal":"Methods in Molecular Biology","title":"PlasmidFinder and In Silico pMLST: Identification and Typing of Plasmid Replicons in Whole-Genome Sequencing (WGS)"},"pmid":"31584170"}],"topic":[{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Probes and primers","uri":"http://edamontology.org/topic_0632"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Whole genome sequencing","uri":"http://edamontology.org/topic_3673"}],"validated":1},"bioschemas":{"name":"PlasmidFinder","home":"https://bio.tools/PlasmidFinder","summary":"PlasmidFinder is a tool for the identification and typing of Plasmid Replicons in Whole-Genome Sequencing (WGS).","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"2.1.6","first_commit":"2022-09-19","conda_name":"plasmidfinder","conda_version":"2.1.6","summary":"Identify plasmids in total or partial sequenced isolates of bacteria.","edam_operations":["Genome assembly","Scaffolding","Multilocus sequence typing"],"edam_topics":["Whole genome sequencing","Sequence assembly","Mapping","Probes and primers"],"toolshed_categories":["Sequence Analysis"],"toolshed_id":"plasmidfinder","users_5_years":1897,"users_all_time":1897,"usage_5_years":61941,"usage_all_time":61941,"bio_tools_summary":"PlasmidFinder is a tool for the identification and typing of Plasmid Replicons in Whole-Genome Sequencing (WGS).","bio_tools_ids":"PlasmidFinder","bio_tools_name"