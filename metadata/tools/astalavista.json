{"tool_name":"astalavista","contents":["biocontainers","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"astalavista","version":"4.0","home":"http://sammeth.net/confluence/display/ASTA/Home","license":"BSD","summary":"AStalavista is a computer program to extract alternative splicing (AS) events from a given genomic annotation of exon-intron gene coordinates. By comparing all given transcripts, AStalavista detects the variations in their splicing structure and identify all AS events (like exon skipping, alternate donor, etc) by assigning to each of them an AS code.","identifiers":["biotools:astalavista","doi:10.1101/gr.121947.111"],"build":{"noarch":"generic","number":2},"requirements":{"run":["openjdk"]},"source_url":"http://sammeth.net/data/public/astalavista-4.0.tgz","test":{"commands":["astalavista --help 2>&1 | grep \"List of available tools\" > /dev/null"]}},"biocontainers":{"name":"astalavista","identifiers":["biotools:astalavista","doi:10.1101/gr.121947.111"],"license":"BSD-3-Clause","summary":"Alternative splicing trascriptional landscape visualization tool retrieves all alternative splicing events from generic transcript annotations.","home_url":"http://sammeth.net/confluence/display/ASTA/Home","keywords":["African Continental Ancestry Group","Alternative Splicing","Cell Line","Computational Biology","European Continental Ancestry Group","Gene Expression Profiling","Gene Expression Regulation","Genetic Variation","Humans","Nucleic acid structure analysis"],"manually_check":true,"total_pulls":0},"biotools":{"id":"astalavista","home":"http://sammeth.net/confluence/display/ASTA/Home","license":"BSD-3-Clause","summary":"Alternative splicing trascriptional landscape visualization tool retrieves all alternative splicing events from generic transcript annotations.","addition_date":"2016-06-07T13:17:41Z","last_update_date":"2024-11-25T15:42:23.141551Z","tool_type":["Command-line tool"],"version":["3.2"],"biotools_curie":"biotools:astalavista","cost":"Free of charge","credit":[{"email":"micha@sammeth.net","name":"Micha Sammeth","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"Lab Roderic Guigo Group","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Micha Sammeth","typeEntity":"Person","typeRole":["Developer"]},{"name":"crg.eu","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["General"],"url":"http://sammeth.net/confluence/display/ASTA/2+-+Download"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Nucleic acid features","uri":"http://edamontology.org/data_1276"}}],"note":"The AStalavista web server extracts and displays alternative splicing (AS) events from a given genomic annotation of exon-intron gene coordinates. By comparing all given transcripts, AStalavista detects the variations in their splicing structure and identify all AS events (like exon skipping, alternate donor, etc) by assigning to each of them an AS code. AStalavista provides a vizual summary of the AS landscape in the analyzed dataset, the possibility to browse the results on the UCSC website or to download them in GTF or ASTA format. You can use AStalavista for any genome by providing your own annotation set, the identifier of your gene(s) of interest, or analyze the AS landscape of reference annotation datasets like Gencode, RefSeq, Ensembl, FlyBase,...","operation":[{"term":"Sequence annotation","uri":"http://edamontology.org/operation_0361"},{"term":"Sequence visualisation","uri":"http://edamontology.org/operation_0564"}],"output":[{"data":{"term":"Sequence features","uri":"http://edamontology.org/data_1255"},"format":[{"term":"Image format","uri":"http://edamontology.org/format_3547"}]}]}],"name":"AStalavista","operating_system":["Linux","Mac","Windows"],"owner":"francisco.camara@crg.eu","publication":[{"doi":"10.1101/gr.121947.111","pmcid":"PMC3290788","pmid":"22113879","type":["Primary"]}],"topic":[{"term":"Nucleic acid structure analysis","u