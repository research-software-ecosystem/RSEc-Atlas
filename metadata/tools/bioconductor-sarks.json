{"tool_name":"bioconductor-sarks","contents":["oeb","bioschemas","biocontainers","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-sarks","identifiers":["doi:10.1093/bioinformatics/btz198"],"license":"Not available","summary":"Suffix array kernel smoothing for discovery of correlative sequence motifs and multi-motif domains","home_url":"https://bioconductor.org/packages/3.12/bioc/html/sarks.html","keywords":["Transcriptomics"],"manually_check":true,"total_pulls":114},"biotools":{"id":"bioconductor-sarks","home":"https://bioconductor.org/packages/sarks","license":"BSD-3-Clause","summary":"Suffix Array Kernel Smoothing (see https://academic.oup.com/bioinformatics/article-abstract/35/20/3944/5418797), or SArKS, identifies sequence motifs whose presence correlates with numeric scores (such as differential expression statistics) assigned to the sequences (such as gene promoters). SArKS smooths over sequence similarity, quantified by location within a suffix array based on the full set of input sequences. A second round of smoothing over spatial proximity within sequences reveals multi-motif domains. Discovered motifs can then be merged or extended based on adjacency within MMDs. False positive rates are estimated and controlled by permutation testing.","addition_date":"2026-09-01T07:29:52.036015Z","last_update_date":"2026-09-01T07:29:52.037827Z","tool_type":["Command-line tool","Library"],"version":["1.24.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-sarks","credit":[{"name":"Dennis Wylie","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/sarks"}],"edit_permission":{"type":"private"},"name":"sarks","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.1093/bioinformatics/btz198"}]},"bioschemas":{"name":"sarks","home":"https://bio.tools/bioconductor-sarks","license":"BSD-3-Clause","version":"1