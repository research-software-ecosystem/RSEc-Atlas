{"tool_name":"orfipy","contents":["biocontainers","galaxy","bioschemas","biotools","oeb"],"fetched_metadata":{"biocontainers":{"name":"orfipy","identifiers":["doi:10.1101/2020.10.20.348052"],"license":"MIT","summary":"orfipy: fast and flexible search for open reading frames in fasta sequences","home_url":"https://github.com/urmi-21/orfipy","keywords":["Peptides","Transcriptome"],"manually_check":true,"total_pulls":4153},"biotools":{"id":"orfipy","home":"https://anaconda.org/bioconda/orfipy","license":"MIT","summary":"A fast and flexible tool for extracting ORFs.\n\norfipy is a tool written in python/cython to extract ORFs in extremely an fast and flexible manner. Other popular ORF searching tools are OrfM and getorf. Compared to OrfM and getorf, orfipy provides the most options to fine tune ORF searches. orfipy uses multiple CPU cores and is particularly faster for data containing multiple smaller fasta sequences such as de-novo transcriptome assemblies. Please read the preprint here.","addition_date":"2021-01-18T11:14:57Z","last_update_date":"2024-11-24T14:34:26.870494Z","tool_type":["Library"],"biotools_curie":"biotools:orfipy","credit":[{"email":"mash@iastate.edu","name":"Eve Syrkin Wurtele","typeEntity":"Person"}],"edit_permission":{"authors":["ELIXIR-CZ"],"type":"group"},"function":[{"operation":[{"term":"Coding region prediction","uri":"http://edamontology.org/operation_0436"},{"term":"Database search","uri":"http://edamontology.org/operation_2421"},{"term":"De-novo assembly","uri":"http://edamontology.org/operation_0524"},{"term":"Transcriptome assembly","uri":"http://edamontology.org/operation_3258"}]}],"name":"orfipy","owner":"Niclaskn","publication":[{"doi":"10.1101/2020.10.20.348052"}],"topic":[{"term":"Computer science","uri":"http://edamontology.org/topic_3316"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic