{"tool_name":"bioconductor-iasva","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-iasva","identifiers":["doi:10.18129/b9.bioc.iasva"],"license":"GPL-2","summary":"Iteratively Adjusted Surrogate Variable Analysis","home_url":"https://bioconductor.org/packages/3.8/bioc/html/iasva.html","keywords":["RNA-Seq"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-iasva","home":"https://bioconductor.org/packages/iasva","license":"GPL-2.0","summary":"Iteratively Adjusted Surrogate Variable Analysis (IA-SVA) is a statistical framework to uncover hidden sources of variation even when these sources are correlated. IA-SVA provides a flexible methodology to i) identify a hidden factor for unwanted heterogeneity while adjusting for all known factors; ii) test the significance of the putative hidden factor for explaining the unmodeled variation in the data; and iii), if significant, use the estimated factor as an additional known factor in the next iteration to uncover further hidden factors.","addition_date":"2026-09-01T07:22:05.224104Z","last_update_date":"2026-09-01T07:22:05.227980Z","tool_type":["Command-line tool","Library"],"version":["1.30.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-iasva","credit":[{"name":"Anthony Cheng","typeEntity":"Person","typeRole":["Developer"]},{"name":"Donghyung Lee","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Duygu Ucar","typeEntity":"Person","typeRole":["Developer"]},{"name":"Nathan Lawlor","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/iasva"}],"edit_permission":{"type":"private"},"name":"iasva","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.18129/B9.bioc.iasva"}]},"bioschemas":{"name":"iasva","home":"https://bio.tools/bioconductor-iasva","license":"GPL-2.0-only","version":"1