{"tool_name":"ribodetector","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"ribodetector","version":"0.3.3","home":"https://github.com/hzi-bifo/RiboDetector","license":"GPL-3.0-or-later","summary":"Accurate and rapid RiboRNA sequences Detector based on deep learning","identifiers":["biotools:ribodetector"],"license_file":"LICENSE","build":{"entry_points":["ribodetector = ribodetector.detect:main","ribodetector_cpu = ribodetector.detect_cpu:main"],"noarch":"python","number":0,"run_exports":[null],"script":" -m pip install . --no-deps --no-build-isolation -vvv"},"requirements":{"host":["pip","python >=3.8,<=3.10"],"run":["python >=3.8,<=3.10","pandas","numpy","tqdm","biopython","onnxruntime","pytorch"]},"source_url":"https://files.pythonhosted.org/packages/ed/92/ddeb9ca3e7cc936669f19d6ad181cca2ce8ca7afab00cbbee9f88ad50a84/ribodetector-0.3.3.tar.gz","test":{"commands":["ribodetector --help","ribodetector_cpu --help"],"imports":["ribodetector"]},"recipe_maintainers":["alienzj"]},"biotools":{"id":"ribodetector","home":"https://github.com/hzi-bifo/RiboDetector","license":"GPL-3.0","summary":"RiboDetector is a software developed to accurately yet rapidly detect and remove rRNA sequences from metagenomeic, metatranscriptomic, and ncRNA sequencing data. It was developed based on LSTMs and optimized for both GPU and CPU.","addition_date":"2023-03-30T08:51:19.974315Z","last_update_date":"2024-11-24T14:50:24.353891Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:ribodetector","edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Sequence comparison","uri":"http://edamontology.org/operation_2451"},{"term":"Sequence contamination filtering","uri":"http://edamontology.org/operation_3187"}]}],"name":"RiboDetector","owner":"alexcorm","publication":[{"doi":"10.1093/nar/gkac112","metadata":{"abstract":"Advances in transcriptomic and translatomic techniques enable in-depth studies of RNA activity profiles and RNA-based regulatory mechanisms. Ribosomal RNA (rRNA) sequences are highly abundant among cellular RNA, but if the target sequences do not include polyadenylation, these cannot be easily removed in library preparation, requiring their post-hoc removal with computational techniques to accelerate and improve downstream analyses. Here, we describe RiboDetector, a novel software based on a Bi-directional Long Short-Term Memory (BiLSTM) neural network, which rapidly and accurately identifies rRNA reads from transcriptomic, metagenomic, metatranscriptomic, noncoding RNA, and ribosome profiling sequence data. Compared with state-of-the-art approaches, RiboDetector produced at least six times fewer misclassifications on the benchmark datasets. Importantly, the few false positives of RiboDetector were not enriched in certain Gene Ontology (GO) terms, suggesting a low bias for downstream functional profiling. RiboDetector also demonstrated a remarkable generalizability for detecting novel rRNA sequences that are divergent from the training data with sequence identities of <90%. On a personal computer, RiboDetector processed 40M reads in less than 6 min, which was \u223c50 times faster in GPU mode and \u223c15 times in CPU mode than other methods. RiboDetector is available under a GPL v3.0 license at https://github.com/hzi-bifo/RiboDetector.","authors":[{"name":"Deng Z.-L."},{"name":"McHardy A.C."},{"name":"Mreches R."},{"name":"Munch P.C."}],"citationCount":26,"date":"2022-06-10T00:00:00Z","journal":"Nucleic Acids Research","title":"Rapid and accurate identification of ribosomal RNA sequences via deep learning"},"pmcid":"PMC9177968","pmid":"35188571"}],"topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"}]},"bioschemas":{"name":"RiboDetector","home":"https://bio.tools/ribodetector","license":"GPL-3.0","summary":"RiboDetector is a software developed to accurately yet rapidly detect and remove rRNA sequences from metagenomeic, metatranscriptomic, and ncRNA sequencing data. It was developed based on LSTMs and optimized for both GPU and CPU.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ribodetector/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":81,"citations":[{"count":6,"year":"2023"},{"count":18,"year":"2026"},{"count":19,"year":"2024"},{"count":38,"year":"2025"}],"doi":"10.1093/nar/gkac112","pmcid":"PMC9177968","pmid":"35188571","ref_count":42,"refs":[{"count":1,"year":"2005"},{"count":1,"year":"2006"},{"count":1,"year":"2014"},{"count":1,"year":"2021"},{"count":2,"year":"1997"},{"count":2,"year":"2001"},{"count":2,"year":"2009"},{"count":2,"year":"2017"},{"count":3,"year":"2012"},{"count":3,"year":"2015"},{"count":3,"year":"2016"},{"count":4,"year":"2010"},{"count":4,"year":"2011"},{"count":5,"year":"2019"},{"count":8,"year":"2018"}],"title":"Rapid and accurate identification of ribosomal RNA sequences via deep learning.","year":2022}]}],"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:ribodetector:0.2.8/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:ribodetector:0.2.9/cmd/github.com","@license":"https://