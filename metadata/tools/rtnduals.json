{"tool_name":"rtnduals","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"rtnduals","home":"https://bioconductor.org/packages/RTNduals","license":"Artistic-2.0","summary":"RTNduals identifies co-regulatory loops between pairs of regulons inferred by the RTN package by evaluating their shared target genes. It infers dual regulons and tests whether regulator pairs exhibit cooperative or competitive influences on common targets.","addition_date":"2018-07-14T19:25:07Z","last_update_date":"2026-08-31T21:27:24.229691Z","tool_type":["Library"],"version":["1.36.0"],"collections":["BioConductor"],"biotools_curie":"biotools:rtnduals","credit":[{"name":"Clarice S. Groeneveld"},{"name":"Gordon Robertson"},{"name":"Kerstin B. Meyer"},{"name":"Mauro A. A. Castro"},{"name":"Vinicius S. Chagas"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/RTNduals"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Pathway or network analysis","uri":"http://edamontology.org/operation_2497"}]}],"name":"RTNduals","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[{"doi":"10.1038/ng.3458"},{"doi":"10.1093/bioinformatics/btz534"}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Gene regulation","uri":"http://edamontology.org/topic_0204"}],"validated":1},"bioschemas":{"name":"RTNduals","home":"https://bio.tools/rtnduals","license":"Artistic-2.0","version":"1.36.0","summary":"RTNsurvival integrates regulons inferred by the RTN package with survival data. For each regulon, a two-tailed GSEA framework computes a differential Enrichment Score (dES) at the individual-sample level. The resulting dES distribution across samples is then used to evaluate survival associations within the cohort. Two primary workflows are supported: (i) Cox proportional hazards models, in which regulon activities are treated as predictors of survival time, and (ii) Kaplan\u2013Meier analyses assessing cohort stratification based on regulon activity. All graphical outputs are customizable according to user specifications.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:rtnduals:1.4.0/lib/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"source_packages":true,"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":136,"citations":[{"count":1,"year":"-1"},{"count":6,"year":"2016"},{"count":7,"year":"2017"},{"count":8,"year":"2020"},{"count":9,"year":"2024"},{"count":10,"year":"2026"},{"count":11,"year":"2018"},{"count":12,"year":"2019"},{"count":14,"year":"2025"},{"count":16,"year":"2023"},{"count":19,"year":"2022"},{"count":23,"year":"2021"}],"doi":"10.1038/ng.3458","pmcid":"PMC4697365","pmid":"26618344","ref_count":51,"refs":[{"count":1,"year":"1998"},{"count":1,"year":"2004"},{"count":2,"year":"2005"},{"count":2,"year":"2006"},{"count":2,"year":"2008"},{"count":3,"year":"2009"},{"count":3,"year":"2014"},{"count":3,"year":"2015"},{"count":5,"year":"2010"},{"count":7,"year":"2013"},{"count":10,"year":"2011"},{"count":12,"year":"2012"}],"title":"Regulators of genetic risk of breast cancer identified by integrative network analysis.","year":2015}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://bioconductor.org/packages/release/bioc/html/RTNduals.html"}],"ssl":true,"ssl_err":null}},"support":{"email":true}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:rtnduals:1.10.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":