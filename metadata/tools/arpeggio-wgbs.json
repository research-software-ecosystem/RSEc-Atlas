{"tool_name":"arpeggio-wgbs","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"arpeggio-wgbs","home":"https://github.com/supermaxiste/ARPEGGIO","license":"GPL-3.0","summary":"ARPEGGIO (Automated Reproducible Polyploid EpiGenetic GuIdance workflOw) is a snakemake workflow that analyzes whole genome bisulfite sequencing (WGBS) data coming from (allo)polyploid species. The workflow includes all basic steps in WGBS data analysis (trimming, quality check and alignment), a read sorting tool specific for allopolyploids, the most comprehensive statistical tool for Differential Methylation (DM) analysis and a set of downstream analyses to obtain a list of genes showing differential methylation.","addition_date":"2021-01-18T09:57:06Z","last_update_date":"2021-03-17T07:12:00Z","tool_type":["Workflow"],"biotools_curie":"biotools:arpeggio-wgbs","credit":[{"email":"mark.robinson@imls.uzh.ch","name":"Mark D. Robinson","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Bisulfite mapping","uri":"http://edamontology.org/operation_3186"},{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Sequence trimming","uri":"http://edamontology.org/operation_3192"},{"term":"Sorting","uri":"http://edamontology.org/operation_3802"}]}],"name":"ARPEGGIO","owner":"Kigaard","publication":[{"doi":"10.1101/2020.07.16.206193"}],"topic":[{"term":"Epigenetics","uri":"http://edamontology.org/topic_3295"},{"term":"Methylated DNA immunoprecipitation","uri":"http://edamontology.org/topic_3674"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]},"bioschemas":{"name":"ARPEGGIO","home":"https://bio.tools/arpeggio-wgbs","license":"GPL-3.0","summary":"ARPEGGIO (Automated Reproducible Polyploid EpiGenetic GuIdance workflOw) is a snakemake workflow that analyzes whole ge