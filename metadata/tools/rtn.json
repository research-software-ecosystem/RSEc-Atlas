{"tool_name":"rtn","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"rtn","home":"https://bioconductor.org/packages/RTNsurvival","license":"Artistic-2.0","summary":"RTNsurvival integrates regulons inferred by the RTN package with survival data. For each regulon, a two-tailed GSEA framework computes a differential Enrichment Score (dES) at the individual-sample level. The resulting dES distribution across samples is then used to evaluate survival associations within the cohort. Two primary workflows are supported: (i) Cox proportional hazards models, in which regulon activities are treated as predictors of survival time, and (ii) Kaplan\u2013Meier analyses assessing cohort stratification based on regulon activity. All graphical outputs are customizable according to user specifications.","addition_date":"2017-01-17T15:03:29Z","last_update_date":"2026-08-31T21:27:22.347101Z","tool_type":["Command-line tool","Library"],"version":["1.36.0"],"collections":["BioConductor"],"biotools_curie":"biotools:rtn","credit":[{"name":"Clarice S. Groeneveld"},{"name":"Mauro A. A. Castro"},{"name":"Vinicius S. Chagas"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/RTNsurvival"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Pathway or network analysis","uri":"http://edamontology.org/operation_2497"}]}],"name":"RTN","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1038/ng.3458"},{"doi":"10.1093/bioinformatics/btz229"}],"topic":[{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"RTN","home":"https://bio.tools/rtn","license":"Artistic-2.0","version":"2.36.0","summary":"A transcriptional regulatory network (TRN) consists of a collection of transcription factors (TFs) and the regulated target genes. TFs are regulators that recognize specific DNA sequences and guide the expression of the genome, either activating or repressing the expression the target genes. The set of genes controlled by the same TF forms a regulon. This package provides classes and methods for the reconstruction of TRNs and analysis of regulons.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:rtn:1.12.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":147,"citations":[{"count":1,"year":"-1"},{"count":3,"year":"2013"},{"count":5,"year":"2014"},{"count":6,"year":"2026"},{"count":7,"year":"2016"},{"count":8,"year":"2018"},{"count":9,"year":"2020"},{"count":10,"year":"2015"},{"count":11,"year":"2017"},{"count":11,"year":"2023"},{"count":11,"year":"2024"},{"count":12,"year":"2019"},{"count":17,"year":"2022"},{"count":18,"year":"2021"},{"count":18,"year":"2025"}],"doi":"10.1038/ncomms3464","pmcid":"PMC3778544","pmid":"24043118","ref_count":55,"refs":[{"count":1,"year":"2000"},{"count":1,"year":"2001"},{"count":1,"year":"2002"},{"count":2,"year":"2003"},{"count":3,"year":"2004"},{"count":3,"year":"2005"},{"count":3,"year":"2006"},{"count":3,"year":"2013"},{"count":6,"year":"2009"},{"count":6,"year":"2010"},{"count":6,"year":"2011"},{"count":6,"year":"2012"},{"count":7,"year":"2007"},{"count":7,"year":"2008"}],"title":"Master regulators of FGFR2 signalling and breast cancer risk.","year":2013}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://bioconductor.org/packages/release/bioc/html/RTN.html"}],"ssl":true,"ssl_err":null}}