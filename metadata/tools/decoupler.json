{"tool_name":"decoupler","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"decoupler","home":"https://bioconductor.org/packages/decoupleR","license":"GPL-3.0","summary":"Many methods allow us to extract biological activities from omics data using information from prior knowledge resources, reducing the dimensionality for increased statistical power and better interpretability. Here, we present decoupleR, a Bioconductor package containing different statistical methods to extract these signatures within a unified framework. decoupleR allows the user to flexibly test any method with any resource. It incorporates methods that take into account the sign and weight of network interactions. decoupleR can be used with any omic, as long as its features can be linked to a biological process based on prior knowledge. For example, in transcriptomics gene sets regulated by a transcription factor, or in phospho-proteomics phosphosites that are targeted by a kinase.","addition_date":"2022-05-15T10:10:28.517294Z","last_update_date":"2026-09-01T06:40:18.696006Z","tool_type":["Library"],"version":["2.17.0"],"collections":["BioConductor"],"accessibility":"Open access","biotools_curie":"biotools:decoupler","cost":"Free of charge","credit":[{"name":"Aur\u00e9lien Dugourd","typeEntity":"Person","typeRole":["Developer"]},{"name":"Celina Geiss","typeEntity":"Person","typeRole":["Developer"]},{"name":"Christian H. Holland","typeEntity":"Person","typeRole":["Developer"]},{"name":"Daniel Dimitrov","typeEntity":"Person","typeRole":["Developer"]},{"name":"Jana Braunger","typeEntity":"Person","typeRole":["Developer"]},{"name":"Jes\u00fas V\u00e9lez-Santiago","typeEntity":"Person","typeRole":["Developer"]},{"name":"Julio Saez-Rodriguez","typeEntity":"Person","typeRole":["Developer"]},{"name":"Pau Badia-i-Mompel","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Petr Taus","typeEntity":"Person","typeRole":["Developer"]},{"name":"Ricardo O. Ramirez