{"tool_name":"localcider","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"localcider","home":"https://github.com/Pappulab/localCIDER","license":"GPL-2.0","summary":"Enables rapid and high-throughput analyses of a wide range of physico-chemical properties encoded by intrinsically disordered protein and region sequences.","addition_date":"2018-08-05T07:24:43Z","last_update_date":"2019-03-26T08:21:45Z","tool_type":["Command-line tool"],"collections":["Proteomics"],"biotools_curie":"biotools:localcider","credit":[{"email":"alex@holehouse.org","name":"Alex Holehouse","orcidid":"http://orcid.org/0000-0002-4155-5729","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"pappu@wustl.edu","name":"Rohit V. Pappu","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://pappulab.github.io/localCIDER/"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"operation":[{"term":"Sequence analysis","uri":"http://edamontology.org/operation_2403"}]}],"name":"localCIDER","operating_system":["Linux","Mac","Windows"],"owner":"daniel_stefan","publication":[{"doi":"10.1016/j.bpj.2016.11.3200","metadata":{"abstract":"\u00a9 2017 Biophysical SocietyIntrinsically disordered proteins and regions (IDPs) represent a large class of proteins that are defined by conformational heterogeneity and lack of persistent tertiary/secondary structure. IDPs play important roles in a range of biological functions, and their dysregulation is central to numerous diseases, including neurodegeneration and cancer. The conformational ensembles of IDPs are encoded by their amino acid sequences. Here, we present two computational tools that are designed to enable rapid and high-throughput analyses of a wide range of physicochemical properties encoded by IDP sequences. The first, CIDER, is a user-friendly webserver that enables rapid analysis of IDP sequences. The second, localCIDER, is a high-performance software package that enables a wide range of analyses relevant to IDP sequences. In addition to introducing the two packages, we demonstrate the utility of these resources using examples where sequence analysis offers biophysical insights.","authors":[{"name":"Ahad J.N."},{"name":"Das R.K."},{"name":"Holehouse A.S."},{"name":"Pappu R.V."},{"name":"Richardson M.O.G."}],"citationCount":116,"date":"2017-01-10T00:00:00Z","journal":"Biophysical Journal","title":"CIDER: Resources to Analyze Sequence-Ensemble Relationships of Intrinsically Disordered Proteins"},"pmcid":"PMC5232785","pmid":"28076807","type":["Primary"]}],"topic":[{"term":"Protein folding, stability and design","uri":"http://edamontology.org/topic_0130"},{"term":"Protein sites, features and motifs","uri":"http://edamontology.org/topic_3510"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"}],"validated":1},"bioschemas":{"name":"localCIDER","home":"https://bio.tools/localcider","license":"GPL-2.0","summary":"Enables rapid and high-throughput analyses of a wide range of physico-chemical properties encoded by intrinsically disordered protein and region sequences.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:localcider/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":316,"citations":[{"count":2,"year":"2016"},{"count":6,"year":"2017"},{"count":14,"year":"2018"},{"count":21,"year":"2019"},{"count":31,"year":"2026"},{"count":34,"year":"2020"},{"cou