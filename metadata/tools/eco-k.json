{"tool_name":"eco-k","contents":["biotools"],"identifiers":["biotools:eco-k"],"fetched_metadata":{"biotools":{"id":"eco-k","home":"https://github.com/MathOnco/ECO_K","summary":"ECO-K is an inverse game theory framework designed to quantify frequency-dependent interaction coefficients among karyotypically defined cancer subpopulations. It applies this approach to model intratumoral ecological dynamics, revealing potential vulnerabilities in tumor evolution.","addition_date":"2026-11-04T13:54:49.295488Z","last_update_date":"2026-11-04T13:54:49.297644Z","biotools_curie":"biotools:eco-k","credit":[{"email":"noemi.andor@gmail.com","name":"Noemi Andor","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Ecological modelling","uri":"http://edamontology.org/operation_3946"}]}],"name":"ECO-K (Ecological-Karyotypes)","owner":"pub2tools2024","publication":[{"doi":"10.1371/JOURNAL.PCBI.1013897","pmcid":"PMC13108871","pmid":"41805696"}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Ecology","uri":"http://edamontology.org/topic_0610"},{"term":"Evolutionary biology","uri":"http://edamontology.org/topic_3299"},{"term":"Immunology","uri":"http://edamontology.org/topic_0804"},{"term":"Oncology","uri":"http://edamontology.org/topic_2640"}]}}}