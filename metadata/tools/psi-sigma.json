{"tool_name":"psi-sigma","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"PSI-Sigma","home":"https://github.com/wososa/PSI-Sigma","license":"Other","summary":"Splicing-detection method for short-read and long-read RNA-seq analysis.","addition_date":"2019-08-09T13:08:33Z","last_update_date":"2024-11-24T21:01:33.516515Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:PSI-Sigma","cost":"Free of charge","credit":[{"email":"klin@cshl.edu","name":"Kuan-Ting Lin","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/wososa/PSI-Sigma/blob/master/README.md"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"RNA-Seq analysis","uri":"http://edamontology.org/operation_3680"},{"term":"RNA-Seq quantification","uri":"http://edamontology.org/operation_3800"},{"term":"Read binning","uri":"http://edamontology.org/operation_3798"}]}],"maturity":"Mature","name":"PSI-Sigma","operating_system":["Linux","Mac","Windows"],"owner":"hans","publication":[{"doi":"10.1093/bioinformatics/btz438","metadata":{"abstract":"Motivation: Percent Spliced-In (PSI) values are commonly used to report alternative pre-mRNA splicing (AS) changes. Previous PSI-detection tools were limited to specific AS events and were evaluated by in silico RNA-seq data. We developed PSI-Sigma, which uses a new PSI index, and we employed actual (non-simulated) RNA-seq data from spliced synthetic genes (RNA Sequins) to benchmark its performance (i.e. precision, recall, false positive rate and correlation) in comparison with three leading tools (rMATS, SUPPA2 and Whippet). Results: PSI-Sigma outperformed these tools, especially in the case of AS events with multiple alternative exons and intron-retention events. We also briefly evaluated its performance in long-read RNA-seq analysis, by sequencing a mixture of human RNAs and RNA Sequins with nanopore long-read sequencers. Availability and implementation: PSI-Sigma is implemented is available at https://github.com/wososa/PSI-Sigma.","authors":[{"name":"Krainer A.R."},{"name":"Lin K.-T."}],"citationCount":34,"date":"2019-12-01T00:00:00Z","journal":"Bioinformatics","title":"PSI-Sigma: A comprehensive splicing-detection method for short-read and long-read RNA-seq analysis"},"pmcid":"PMC6901072","pmid":"31135034","type":["Primary"]}],"topic":[{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"RNA splicing","uri":"http://edamontology.org/topic_3320"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"bioschemas":{"name":"PSI-Sigma","home":"https://bio.tools/PSI-Sigma","license":"Other","summary":"Splicing-detection method for short-read and long-read RNA-seq analysis.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:psi-sigma/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":36,"citations":[{"count":1,"year":"2019"},{"count":2,"year":"2020"},{"count":3,"year":"2021"},{"count":4,"year":"2025"},{"count":4,"year":"2026"},{"count":5,"year":"2022"},{"count":8,"year":"2023"},{"count":9,"year":"2024"}],"doi":"10.1093/bioinformatics/btz438","pmcid":"PMC6901072","pmid":"31135034","ref_count":21,"refs":[{"count":1,"year":"1999"},{"count":1,"year":"2001"},{"count":1,"year":"2005"},{"count":1,"year":"2013"},{"count":1,"year":"2014"},{"count":2,"year":"2010"},{"count":2,"year":"2012"},{"count":2,"year":"2015"},