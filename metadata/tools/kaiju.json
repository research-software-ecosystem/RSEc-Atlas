{"tool_name":"kaiju","contents":["biocontainers","galaxy","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"kaiju","version":"1.10.2","home":"https://github.com/bioinformatics-centre/kaiju","documentation":"https://github.com/bioinformatics-centre/kaiju/blob/v1.10.2/README.md","license":"GPL-3.0-or-later","summary":"Fast and sensitive taxonomic classification for metagenomics.","identifiers":["biotools:kaiju","usegalaxy-eu:kaiju_kaiju2krona","usegalaxy-eu:kaiju_kaiju2table","usegalaxy-eu:kaiju_mergeoutputs","usegalaxy-eu:kaiju_kaiju","usegalaxy-eu:kaiju_addtaxonnames","doi:10.1038/ncomms11257"],"license_file":"LICENSE","build":{"no_link":["bin/kaiju-makedb.sh"],"number":0,"run_exports":[null]},"requirements":{"build":["make",null,null,null,"pkg-config"],"host":["zlib"],"run":["perl","wget","python","curl"]},"source_url":"https://github.com/bioinformatics-centre/kaiju/archive/v1.10.2.tar.gz","test":{"commands":["kaiju 2>&1 | grep \"Kaiju\""]}},"biocontainers":{"name":"kaiju","identifiers":["biotools:kaiju","doi:10.1038/ncomms11257"],"license":"GPL-3.0","summary":"Fast and sensitive taxonomic classification for metagenomics","home_url":"https://github.com/bioinformatics-centre/kaiju","keywords":["Amino Acid Sequence","Animals","Classification","Humans","Metagenome","Metagenomics","Proteins","Genomics","Protein Sequences"],"manually_check":true,"total_pulls":326},"biotools":{"id":"kaiju","home":"http://kaiju.binf.ku.dk","license":"GPL-3.0","summary":"Program for the taxonomic assignment of high-throughput sequencing reads, e.g., Illumina or Roche/454, from whole-genome sequencing of metagenomic DNA. Reads are directly assigned to taxa using the NCBI taxonomy and a reference database of protein sequences from Bacteria, Archaea, Fungi, microbial eukaryotes and viruses.","addition_date":"2016-10-19T14:56:00Z","last_update_date":"2024-11-24T14:14:44.341821Z","tool_type":["Command-line tool","Web application"],"version":["1.4.4"],"biotools_curie":"biotools:kaiju","cost":"Free of charge","credit":[{"email":"krogh@binf.ku.dk","name":"Anders Krogh","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"pmenzel@gmail.com","name":"Peter Menzel","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"Elixir","typeEntity":"Consortium"},{"name":"Anders Krogh","typeEntity":"Person","typeRole":["Developer"]},{"name":"Peter Menzel","typeEntity":"Person","typeRole":["Developer"]},{"name":"Section for Bioinformatics, Department of Biology, University of Copenhagen","typeEntity":"Institute","typeRole":["Provider"]},{"name":"binf.ku.dk","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Kim Lee Ng","typeRole":["Contributor"]}],"documentation":[{"type":["General"],"url":"http://kaiju.binf.ku.dk"}],"edit_permission":{"authors":["wenzel@sund.ku.dk"],"type":"group"},"function":[{"input":[{"data":{"term":"Nucleic acid sequence (raw)","uri":"http://edamontology.org/data_2975"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"},{"term":"FASTQ","uri":"http://edamontology.org/format_1930"}]}],"note":"Raw high-throughput sequencing reads (e.g. Illumina, Roche 454)","operation":[{"term":"Taxonomic classification","uri":"http://edamontology.org/operation_3460"}],"output":[{"data":{"term":"Taxonomy","uri":"http://edamontology.org/data_3028"},"format":[{"term":"TSV","uri":"http://edamontology.org/format_3475"}]}]}],"maturity":"Mature","name":"Kaiju","operating_system":["Linux","Mac"],"owner":"ptr@binf.ku.dk","publication":[{"doi":"10.1038/ncomms11257","metadata":{"abstract":"Metagenomics emerged as an important field of research not only in microbial ecology but also for human health and disease, and metagenomic studies are performed on increasingly larger scales. While recent taxonomic classification programs achieve high speed by comparing genomic k-mers, they often lack sensitivity for overcoming evolutionary divergence, so that large fractions of the metagenomic reads remain unclassified. Here we present the novel metagenome classifier Kaiju, which finds maximum (in-)exact matches on the protein-level using the Burrows-Wheeler transform. We show in a genome exclusion benchmark that Kaiju classifies reads with higher sensitivity and similar precision compared with current k-mer-based classifiers, especially in genera that are underrepresented in reference databases. We also demonstrate that Kaiju classifies up to 10 times more reads in real metagenomes. Kaiju can process millions of reads per minute and can run on a standard PC. Source code and web server are available at http://kaiju.binf.ku.dk.","authors":[{"name":"Krogh A."},{"name":"Menzel P."},{"name":"Ng K.L."}],"citationCount":1213,"date":"2016-04-13T00:00:00Z","journal":"Nature Communications","title":"Fast and sensitive taxonomic classification for metagenomics with Kaiju"},"pmcid":"PMC4833860","pmid":"27071849","type":["Primary"]}],"topic":[{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"}],"validated":1},"bioschemas":{"name":"Kaiju","home":"https://bio.tools/kaiju","license":"GPL-3.0","version":"1.4.4","summary":"Program for the taxonomic assignment of high-throughput sequencing reads, e.g., Illumina or Roche/454, from whole-genome sequencing of metagenomic DNA. Reads are directly assigned to taxa using the NCBI taxonomy and a reference database of protein sequences from Bacteria, Archaea, Fungi, microbial eukaryotes and viruses.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"1.10.2","first_commit":"2025-04-22","conda_name":"kaiju","conda_version":"1.10.2","summary":"taxonomic classification of high-throughput sequencing reads","edam_operations":["Taxonomic classification"],"edam_topics":["Metagenomics"],"toolshed_categories":["Metagenomics"],"toolshed_id":"kaiju","users_5_years":2,"users_all_time":2,"usage_5_years":2,"usage_all_time":2,"bio_tools_summary":"Program for the taxonomic assignment of high-throughput sequencing reads, e.g., Illumina or Roche/45