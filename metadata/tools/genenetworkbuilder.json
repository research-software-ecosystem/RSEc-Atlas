{"tool_name":"genenetworkbuilder","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-genenetworkbuilder","version":"1.52.0","home":"https://bioconductor.org/packages/3.22/bioc/html/GeneNetworkBuilder.html","license":"GPL (>= 2)","summary":"GeneNetworkBuilder: a bioconductor package for building regulatory network using ChIP-chip/ChIP-seq data and Gene Expression Data","identifiers":["biotools:genenetworkbuilder"],"description":"Appliation for discovering direct or indirect targets of transcription factors using ChIP-chip or ChIP-seq, and microarray or RNA-seq gene expression data. Inputting a list of genes of potential targets of one TF from ChIP-chip or ChIP-seq, and the gene expression results, GeneNetworkBuilder generates a regulatory network of the TF.","license_file":"/lib/R/share/licenses/GPL-3","build":{"number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"build":[null,null,"make"],"host":["bioconductor-graph >=1.88.0,<1.89.0","bioconductor-rcy3 >=2.30.0,<2.31.0","bioconductor-rgraphviz >=2.54.0,<2.55.0","r-base","r-htmlwidgets","r-plyr","r-rcpp >=0.9.13","r-rjson","r-xml","libblas","liblapack","zlib","liblzma-devel"],"run":["bioconductor-graph >=1.88.0,<1.89.0","bioconductor-rcy3 >=2.30.0,<2.31.0","bioconductor-rgraphviz >=2.54.0,<2.55.0","r-base","r-htmlwidgets","r-plyr","r-rcpp >=0.9.13","r-rjson","r-xml"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/GeneNetworkBuilder_1.52.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GeneNetworkBuilder/GeneNetworkBuilder_1.52.0.tar.gz","https://bioarchive.galaxyproject.org/GeneNetworkBuilder_1.52.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-genenetworkbuilder/bioconductor-genenetworkbuilder_1.52.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('GeneNetworkBuilder')\""]}},"biotools":{"id":"genenetworkbuilder","home":"https://bioconductor.org/packages/ChIPpeakAnno","license":"GPL-2.0-or-later","summary":"The package encompasses a range of functions for identifying the closest gene, exon, miRNA, or custom features\u2014such as highly conserved elements and user-supplied transcription factor binding sites. Additionally, users can retrieve sequences around the peaks and obtain enriched Gene Ontology (GO) or Pathway terms. In version 2.0.5 and beyond, new functionalities have been introduced. These include features for identifying peaks associated with bi-directional promoters along with summary statistics (peaksNearBDP), summarizing motif occurrences in peaks (summarizePatternInPeaks), and associating additional identifiers with annotated peaks or enrichedGO (addGeneIDs). The package integrates with various other packages such as biomaRt, IRanges, Biostrings, BSgenome, GO.db, multtest, and stat to enhance its analytical capabilities.","addition_date":"2017-01-17T15:04:05Z","last_update_date":"2024-11-25T15:26:41.819106Z","tool_type":["Command-line tool","Library"],"version":["3.46.1"],"collections":["BioConductor"],"biotools_curie":"biotools:genenetworkbuilder","credit":[{"name":"Claude Gazin"},{"name":"David Lapointe"},{"name":"Haibo Liu"},{"name":"Herv\u00e9 Pag\u00e8s"},{"name":"Jianhong Ou"},{"name":"Jun Yu"},{"name":"Junhui Li"},{"name":"Kai Hu"},{"name":"Lihua Julie Zhu"},{"name":"Michael Green"},{"name":"Nathan Lawson"},{"name":"Ryan Thompson"},{"name":"Simon Lin"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/ChIPpeakAnno"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Pathway or network prediction","uri":"http://edamontology.org/operation_3439"}]}],"name":"GeneNetworkBuilder","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1007/978-1-62703-607-8_8"},{"doi":"10.1186/1471-2105-11-237"}],"topic":[{"term":"ChIP-seq","uri":"http://edamontology.org/topic_3169"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"}],"validated":1},"bioschemas":{"name":"GeneNetworkBuilder","home":"https://bio.tools/genenetworkbuilder","license":"GPL-2.0-or-later","version":"3.46.0","summary":"The package encompasses a range of functions for identifying the closest gene, exon, miRNA, or custom features\u2014such as highly conserved elements and user-supplied transcription factor binding sites. Additionally, users can retrieve sequences around the peaks and obtain enriched Gene Ontology (GO) or Pathway terms. In version 2.0.5 and beyond, new functionalities have been introduced. These include features for identifying peaks associated with bi-directional promoters along with summary statistics (peaksNearBDP), summarizing motif occurrences in peaks (summarizePatternInPeaks), and associating additional identifiers with annotated peaks or enrichedGO (addGeneIDs). The package integrates with various other packages such as biomaRt, IRanges, Biostrings, BSgenome, GO.db, multtest, and stat to enhance its analytical capabilities.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:genenetworkbuilder:1.16.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":63,"citations":[{"count":1,"year":"2026"},{"count":3,"year":"2016"},{"count":5,"year":"2018"},{"count":5,"year":"2022"},{"count":6,"year":"2019"},{"count":6,"year":"2021"},{"count":7,"year":"2020"},{"count":7,"year":"2023"},{"count":7,"year":"2024"},{"count":8,"year":"2017"},{"count":8,"year":"2025"}],"doi":"10.1007/978-1-62703-607-8_8","pmid":"23975789","ref_count":0,"refs":[],"title":"In