{"tool_name":"angsd","contents":["biocontainers","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"angsd","version":"0.94","home":"http://www.popgen.dk/angsd/index.php/ANGSD","license":"GPLv3, MIT","summary":"ANGSD: Analysis of next generation Sequencing Data","identifiers":["biotools:angsd","doi:10.1186/s12859-014-0356-4"],"build":{"number":4,"run_exports":[null],"skip":true},"requirements":{"build":["make",null,null],"host":["zlib","bzip2","xz","htslib"],"run":["htslib","zlib","bzip2","xz"]},"source_url":"http://popgen.dk/software/download/angsd/angsd0.940.tar.gz","test":{"commands":["angsd 2>&1 | grep \"angsd version\"","thetaStat 2>&1 | grep \"neutrality test\""]}},"biocontainers":{"name":"angsd","identifiers":["biotools:angsd","doi:10.1186/s12859-014-0356-4"],"license":"GPL-3.0","summary":"ANGSD: Analysis of next generation Sequencing Data","home_url":"https://github.com/ANGSD/angsd","keywords":["Gene Frequency","Genetics, Population","Genotype","High-Throughput Nucleotide Sequencing","Likelihood Functions","Polymorphism, Single Nucleotide","Population genetics","Statistics and probability"],"manually_check":true,"total_pulls":4},"biotools":{"id":"angsd","home":"http://www.popgen.dk/angsd","license":"GPL-2.0","summary":"Software for analyzing next generation sequencing data. The software can handle a number of different input types from mapped reads to imputed genotype probabilities. Most methods take genotype uncertainty into account instead of basing the analysis on called genotypes. This is especially useful for low and medium depth data.","addition_date":"2015-06-15T07:16:12Z","last_update_date":"2024-11-24T20:19:21.933450Z","tool_type":["Command-line tool"],"version":["0.901"],"biotools_curie":"biotools:angsd","credit":[{"email":"thorfinn@binf.ku.dk","name":"Thorfinn Korneliussen","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"albrecht@binf.ku.dk","name":"Anders Albrechtsen","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://popgen.dk/albrecht/web/WelcomePage.html"},{"name":"binf.ku.dk","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["Citation instructions"],"url":"http://www.popgen.dk/angsd/index.php/Citing_angsd"},{"type":["General"],"url":"http://www.popgen.dk/angsd"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Data","uri":"http://edamontology.org/data_0006"},"format":[{"term":"BAM","uri":"http://edamontology.org/format_2572"},{"term":"CRAM","uri":"http://edamontology.org/format_3462"},{"term":"VCF","uri":"http://edamontology.org/format_3016"}]}],"operation":[{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Sequence analysis","uri":"http://edamontology.org/operation_2403"},{"term":"Statistical calculation","uri":"http://edamontology.org/operation_2238"}],"output":[{"data":{"term":"Data","uri":"http://edamontology.org/data_0006"},"format":[{"term":"MAF","uri":"http://edamontology.org/format_3008"},{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}]}],"name":"ANGSD","operating_system":["Linux","Mac","Windows"],"owner":"admin","publication":[{"doi":"10.1186/s12859-014-0356-4","metadata":{"abstract":"Background: High-throughput DNA sequencing technologies are generating vast amounts of data. Fast, flexible and memory efficient implementations are needed in order to facilitate analyses of thousands of samples simultaneously. Results: We present a multithreaded program suite called ANGSD. This program can calculate various summary statistics, and perform association mapping and population genetic analyses utilizing the full information in next generation sequencing data by working directly on the raw sequencing data or by using genotype likelihoods. Conclusions: The open source c/c++ program ANGSD is available at . The program is tested and validated on GNU/Linux systems. The program facilitates multiple input formats including BAM and imputed beagle genotype probability files. The program allow the user to choose between combinations of existing methods and can perform analysis that is not implemented elsewhere.","authors":[{"name":"Albrechtsen A."},{"name":"Korneliussen T.S."},{"name":"Nielsen R."}],"citationCount":1633,"date":"2014-11-25T00:00:00Z","journal":"BMC Bioinformatics","title":"ANGSD: Analysis of Next Generation Sequencing Data"},"pmcid":"PMC4248462","pmid":"25420514","type":["Primary"]}],"topic":[{"term":"Population genetics","uri":"http://edamontology.org/topic_3056"},{"term":"Statistics and probability","uri":"http://edamontology.org/topic_2269"}],"validated":1},"bioschemas":{"name":"ANGSD","home":"https://bio.tools/angsd","license":"GPL-2.0","version":"0.901","summary":"Software for analyzing next generation sequencing data. The software can handle a number of different input types from mapped reads to imputed genotype probabilities. Most methods take genotype uncertainty into account instead of basing the analysis on called genotypes. This is especially useful for low and medium depth data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:angsd:0.901/cmd/www.popgen.dk","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"citation":true,"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":1454,"citations":[{"count":1,"year":"-1"},{"count":1,"year":"2014"},{"count":17,"year":"2015"},{"count":41,"year":"2016"},{"count":55,"year":"2017"},{"count":65,"year":"2018"},{"count":104,"year":"2019"},{"count":105,"year":"2020"},{"count":15