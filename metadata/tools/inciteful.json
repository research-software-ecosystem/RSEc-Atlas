{"tool_name":"inciteful","contents":["biotools"],"identifiers":["biotools:inciteful"],"fetched_metadata":{"biotools":{"id":"inciteful","home":"https://incitefulmed.com/academic/","license":"AGPL-3.0","summary":"Free literature discovery from the citation graph. From one or more seed papers (DOI, PMID or OpenAlex ID), it builds a citation network over OpenAlex data and ranks similar papers, important papers and reviews, authors and journals, and shows the citation paths between two papers. Covers biomedical literature and all other fields. Open-access full text comes from PubMed Central through its MCP server, which also lets AI assistants use the graph.","addition_date":"2026-11-09T20:13:06.536103Z","last_update_date":"2026-11-09T20:14:36.812382Z","tool_type":["Web application","Web service"],"accessibility":"Open access","biotools_curie":"biotools:inciteful","cost":"Free of charge","documentation":[{"type":["General"],"url":"https://incitefulmed.com/academic/help/"},{"type":["User manual"],"url":"https://incitefulmed.com/academic/help/methods"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Data retrieval","uri":"http://edamontology.org/operation_2422"}]},{"operation":[{"term":"Network visualisation","uri":"http://edamontology.org/operation_3925"}]},{"operation":[{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"}]}],"maturity":"Mature","name":"Inciteful","operating_system":["Android","Linux","Mac","Windows","iOS"],"owner":"michael8","topic":[{"term":"Bioinformatics","uri":"http://edamontology.org/topic_0091"},{"term":"Literature and language","uri":"http://edamontology.org/topic_3068"}]}}}