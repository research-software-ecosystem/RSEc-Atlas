{"tool_name":"nullarbor","contents":["biocontainers","oeb","biotools"],"fetched_metadata":{"biocontainers":{"name":"nullarbor","identifiers":["biotools:nullarbor"],"license":"GPL-2.0","summary":"Reads to report pipeline for bacterial isolate ngs data","home_url":"https://github.com/tseemann/nullarbor","keywords":["Genomics","Model organisms"],"manually_check":true,"total_pulls":1},"biotools":{"id":"nullarbor","home":"https://github.com/tseemann/nullarbor","license":"GPL-2.0","summary":"Pipeline to generate complete public health microbiology reports from isolates sequenced with Illumina paired-end sequencing.","addition_date":"2016-09-02T00:45:28Z","last_update_date":"2018-12-10T12:58:52Z","tool_type":["Command-line tool"],"version":["1"],"biotools_curie":"biotools:nullarbor","credit":[{"email":"torsten.seemann@gmail.com","name":"Torsten Seemann","typeEntity":"Person","typeRole":["Primary contact"],"url":"https://github.com/tseemann/nullarbor/issues"},{"name":"Torsten Seemann","typeEntity":"Person","typeRole":["Developer"]},{"name":"University of Melbourne, Australia","typeEntity":"Institute","typeRole":["Provider"]},{"name":"unimelb.edu.au","typeEntity":"Institute","typeRole":["Provider"]},{"name":"Australia","typeEntity":"Person","typeRole":["Primary contact"],"url":"https://github.com/tseemann/nullarbor/issues"},{"name":"A Goncalves da Silva","typeRole":["Contributor"]},{"name":"BP Howden","typeRole":["Contributor"]},{"name":"DM Bulach","typeRole":["Contributor"]},{"name":"JC Kwong","typeRole":["Contributor"]},{"name":"MB Schultz","typeRole":["Contributor"]}],"documentation":[{"type":["Citation instructions","General"],"url":"https://github.com/tseemann/nullarbor/blob/master/README.md"}],"edit_permission":{"type":"private"},"function":[{"note":"Nullarbor is a pipeline that can perform the following processing and analysis steps on paired-end Illumina sequencing reads from microbiological clinical isolates:\nPer isolate\n\n    Clean reads (Trimmomatic)\n    Species identification against known genome database (Kraken)\n    De novo assembly (MEGA-HIT, SPAdes)\n    Annotation (Prokka)\n    MLST Genotyping (mlst)\n    Detection of known antibiotic resistance variants (abricate)\n    Variant calling (Snippy)\n\nPer isolate set\n\n    Core genome SNPs (Snippy-core)\n    Draw tree (FastTree, afa-pairwise)\n    Pan genome analysis (Roary)\n    Report\n        Table of isolates, yield, coverage, species, MLST (HTML + Plotly.JS + DataTables)","operation":[{"term":"De-novo assembly","uri":"http://edamontology.org/operation_0524"},{"term":"Genome annotation","uri":"http://edamontology.org/operation_0362"},{"term":"Genome visualisation","uri":"http://edamontology.org/operation_3208"},{"term":"Nucleic acid feature detection","uri":"http://edamontology.org/operation_0415"},{"term":"Phylogenetic tree generation","uri":"http://edamontology.org/operation_0323"},{"term":"Phylogenetic tree visualisation","uri":"http://edamontology.org/operation_0567"},{"term":"Sequence trimming","uri":"http://edamontology.org/operation_3192"},{"term":"Sequencing quality control","uri":"http://edamontology.org/operation_3218"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"},{"term":"Variant pattern analysis","uri":"http://edamontology.org/operation_3504"},{"term":"k-mer counting","uri":"http://edamontology.org/operation_3472"}]}],"name":"nullarbor","operating_system":["Linux","Mac"],"owner":"griffinp@unimelb.edu.au","topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"},{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:nullarbor:1/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"s