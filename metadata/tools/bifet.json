{"tool_name":"bifet","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bifet","home":"https://bioconductor.org/packages/BiFET","license":"GPL-3.0","summary":"BiFET identifies TFs whose footprints are over-represented in target regions compared to background regions after correcting for the bias arising from the imbalance in read counts and GC contents between the target and background regions. For a given TF k, BiFET tests the null hypothesis that the target regions have the same probability of having footprints for the TF k as the background regions while correcting for the read count and GC content bias. For this, we use the number of target regions with footprints for TF k, t_k as a test statistic and calculate the p-value as the probability of observing t_k or more target regions with footprints under the null hypothesis.","addition_date":"2018-07-05T12:12:40Z","last_update_date":"2026-09-01T06:32:43.583138Z","tool_type":["Library"],"version":["1.32.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bifet","credit":[{"name":"Ahrim Youn","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Duygu Ucar","typeEntity":"Person","typeRole":["Developer"]},{"name":"Eladio Marquez","typeEntity":"Person","typeRole":["Developer"]},{"name":"Michael Stitzel","typeEntity":"Person","typeRole":["Developer"]},{"name":"Nathan Lawlor","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/BiFET"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Enrichment analysis","uri":"http://edamontology.org/operation_3501"}]}],"name":"BiFET","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[{"doi":"10.18129/B9.bioc.BiFET"}],"topic":[{"term":"Epigenetics","uri":"http://edamontology.org/topic_3295"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Gene regulation","uri":"http://edam