{"tool_name":"bioconductor-metabocoreutils","contents":["biotools","oeb","bioschemas"],"fetched_metadata":{"biotools":{"id":"bioconductor-metabocoreutils","home":"https://bioconductor.org/packages/CompoundDb","license":"Artistic-2.0","summary":"The Spectra package defines an efficient infrastructure for storing and handling mass spectrometry spectra and functionality to subset, process, visualize and compare spectra data. It provides different implementations (backends) to store mass spectrometry data. These comprise backends tuned for fast data access and processing and backends for very large data sets ensuring a small memory footprint.","addition_date":"2026-08-30T02:45:52.318905Z","last_update_date":"2026-10-02T15:54:32.846544Z","tool_type":["Command-line tool","Library"],"version":["1.16.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-metabocoreutils","credit":[{"name":"Andrea Vicini","typeEntity":"Person","typeRole":["Developer"]},{"name":"Jan Stanstrup","typeEntity":"Person","typeRole":["Developer"]},{"name":"Johannes Rainer","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Josep M. Badia","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Prateek Arora","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Roger Gine","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/CompoundDb"}],"edit_permission":{"type":"private"},"name":"MetaboCoreUtils","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.3390/metabo12020173"}]},"bioschemas":{"name":"MetaboCoreUtils","home":"https://bio.tools/bioconductor-metabocoreutils","license":"Artistic-2.0","version":"1.20.1","summary":"MetaboCoreUtils defines metabolomics-related core functionality provided as low-level functions to allow a data structure-independent usage across various R packages. This includes functions to calculate between ion (ad