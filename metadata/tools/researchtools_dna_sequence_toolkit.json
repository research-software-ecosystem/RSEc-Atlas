{"tool_name":"researchtools_dna_sequence_toolkit","contents":["biotools"],"fetched_metadata":{"biotools":{"id":"researchtools_dna_sequence_toolkit","home":"https://tools.biotech-insight.com/tools/dna-sequence-toolkit/","license":"Freeware","summary":"ResearchTools DNA Sequence Toolkit is a free, browser-based tool for basic DNA sequence analysis. It generates reverse complements, calculates GC content, and identifies CpG dinucleotides and their positions.\n\nThe tool supports multiple FASTA sequences, IUPAC ambiguity codes, and downloadable FASTA and CSV results. Sequences are processed locally in the user's browser and are not uploaded to a server.\n\nThe toolkit is intended for molecular biology research and education. It does not perform genome alignment, primer design, or DNA methylation measurement.","addition_date":"2026-10-12T02:28:45.218659Z","last_update_date":"2026-10-12T02:29:37.692431Z","tool_type":["Web application"],"version":["1.7.1"],"accessibility":"Open access","biotools_curie":"biotools:researchtools_dna_sequence_toolkit","cost":"Free of charge","credit":[{"email":"david@biotech-insight.com","name":"David Cheishvili","orcidid":"https://orcid.org/0000-0001-9136-8967","typeEntity":"Person","typeRole":["Developer","Maintainer"],"url":"https://biotech-insight.com/"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"DNA sequence","uri":"http://edamontology.org/data_3494"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}],"operation":[{"term":"Reverse complement","uri":"http://edamontology.org/operation_0363"},{"term":"Sequence composition calculation","uri":"http://edamontology.org/operation_0236"},{"term":"Sequence motif recognition","uri":"http://edamontology.org/operation_0239"}],"output":[{"data":{"term":"DNA sequence","uri":"http://edamontology.org/data_3494"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}]}],"maturity":"Emerging","name":"ResearchTools DNA Sequence Toolki