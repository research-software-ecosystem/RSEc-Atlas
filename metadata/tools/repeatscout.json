{"tool_name":"repeatscout","contents":["biocontainers","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"repeatscout","version":"1.0.7","home":"https://github.com/Dfam-consortium/RepeatScout","documentation":"https://github.com/Dfam-consortium/RepeatScout/blob/v1.0.7/README.md","license":"CC0","summary":"De novo identification of repeat families in large genomes.","identifiers":["biotools:RepeatScout"],"license_file":"LICENSE","build":{"number":1,"run_exports":[null]},"requirements":{"build":["make",null],"run":["trf","nseg","perl","perl-file-temp","perl-file-which"]},"source_url":"https://github.com/Dfam-consortium/RepeatScout/archive/refs/tags/v1.0.7.tar.gz","test":{"commands":["RepeatScout 2>&1 | grep Version","build_lmer_table 2>&1 | grep Version","filter-stage-1.prl -h 2>&1 | grep -i repeatscout","filter-stage-2.prl -h 2>&1 | grep -i repeatmasker","compare-out-to-gff.prl -h 2>&1 | grep -i repeatmasker"]}},"biocontainers":{"name":"repeatscout","identifiers":[],"license":"GPL","summary":"De novo identification of repeat families in large genomes.","home_url":"http://repeatscout.bioprojects.org","keywords":[],"manually_check":true,"total_pulls":0},"biotools":{"id":"RepeatScout","home":"http://bix.ucsd.edu/repeatscout/","summary":"RepeatScout is a tool to discover repetitive substrings in DNA.","addition_date":"2019-12-23T00:45:32Z","last_update_date":"2024-11-24T15:19:49.802302Z","biotools_curie":"biotools:RepeatScout","edit_permission":{"authors":["sergitobara"],"type":"group"},"function":[{"operation":[{"term":"k-mer counting","uri":"http://edamontology.org/operation_3472"}]}],"name":"RepeatScout","owner":"admin","publication":[{"doi":"10.1093/bioinformatics/bti1018","metadata":{"abstract":"Motivation: De novo repeat family identification is a challenging algorithmic problem of great practical importance. As the number of genome sequencing projects increases, there is a pressing need to identify the repeat families present in large, newly sequenced genomes. We develop a new method for identification of repeat families via extension of consensus seeds; our method enables a rigorous definition of repeat boundaries, a key issue in repeat analysis. Results: Our RepeatScout algorithm is more sensitive and is orders of magnitude faster than RECON, the dominant tool for de novo repeat family identification in newly sequenced genomes. Using RepeatScout, we estimate that \u223c2% of the human genome and 4% of mouse and rat genomes consist of previously unannotated repetitive sequence. \u00a9 The Author 2005. Published by Oxford University Press. All rights reserved.","authors":[{"name":"Jones N.C."},{"name":"Pevzner P.A."},{"name":"Price A.L."}],"citationCount":1433,"date":"2005-01-01T00:00:00Z","journal":"Bioinformatics","title":"De novo identification of repeat families in large genomes"},"pmid":"15961478"}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"}],"validated":1},"bioschemas":{"name":"RepeatScout","home":"https://bio.tools/RepeatScout","summary":"RepeatScout is a tool to discover repetitive substrings in DNA.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:repeatscout/undefined/bix.ucsd.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":1347,"citations":[{"count":2,"year":"2005"},{"count":5,"year":"2006"},{"count":7,"year":"2007"},{"count":9,"year":"2008"},{"count":11,"year":"2009"},{"count":12,"year":"2010"},{"count":25,"year":"2012"},{"count":28,"year":"2011"},{"count":32,"year":"2017"},{"count":36,"year":"2013"},{"count":47,"year":"2015"},{"count":53,"year":"2014"},{"count":58,"year":"2018"},{"count":59,"year":"2016"},{"count":81,"year":"2019"},{"count":81,"year":"2026"},{"count":90,"year":"2020"},{"count":123,"year":"2021"},{"count":127,"year":"2023"},{"coun