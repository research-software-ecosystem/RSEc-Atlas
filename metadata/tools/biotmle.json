{"tool_name":"biotmle","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"biotmle","home":"https://bioconductor.org/packages/biotmle","license":"MIT","summary":"Tools for differential expression biomarker discovery based on microarray and next-generation sequencing data that leverage efficient semiparametric estimators of the average treatment effect for variable importance analysis. Estimation and inference of the (marginal) average treatment effects of potential biomarkers are computed by targeted minimum loss-based estimation, with joint, stable inference constructed across all biomarkers using a generalization of moderated statistics for use with the estimated efficient influence function. The procedure accommodates the use of ensemble machine learning for the estimation of nuisance functions.","addition_date":"2018-07-16T14:26:13Z","last_update_date":"2026-08-30T02:04:29.900969Z","tool_type":["Library"],"version":["1.36.1"],"collections":["BioConductor"],"biotools_curie":"biotools:biotmle","cost":"Free of charge","credit":[{"name":"Alan Hubbard","typeEntity":"Person","typeRole":["Developer"]},{"name":"Mark van der Laan","typeEntity":"Person","typeRole":["Developer"]},{"name":"Nima Hejazi","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Philippe Boileau","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Weixin Cai","typeEntity":"Person","typeRole":["Contributor"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/biotmle"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Differential gene expression analysis","uri":"http://edamontology.org/operation_3223"}]}],"name":"biotmle","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[{"doi":"10.18129/B9.bioc.biotmle"},{"doi":"10.21105/joss.00295"},{"doi":"10.21105/joss.00295"}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Microarray ex