{"tool_name":"fuzdb","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"fuzdb","home":"https://fuzdb.org","license":"CC-BY-NC-SA-4.0","summary":"The FuzDB database assembles experimentally observed fuzzy protein complexes\ninvolved in a variety of cellular processes and biomolecular condensates","addition_date":"2022-05-08T11:03:50.138449Z","last_update_date":"2022-05-08T11:03:50.141001Z","tool_type":["Database portal"],"version":["4.0"],"accessibility":"Open access","biotools_curie":"biotools:fuzdb","cost":"Free of charge","credit":[{"email":"damiano.piovesan@unipd.it","name":"Damiano Piovesan","orcidid":"https://orcid.org/0000-0001-8210-2390","typeEntity":"Person"},{"email":"monika.fuxreiter@unipd.it","name":"Monika Fuxreiter","orcidid":"https://orcid.org/0000-0002-4463-6727","typeEntity":"Person"},{"name":"Alexander Miguel Monzon","orcidid":"https://orcid.org/0000-0003-0362-8218"},{"name":"Andras Hatos","orcidid":"https://orcid.org/0000-0001-9224-9820"},{"name":"Silvio C E Tosatto","orcidid":"https://orcid.org/0000-0003-4525-7793"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Database search","uri":"http://edamontology.org/operation_2421"},{"term":"PTM site prediction","uri":"http://edamontology.org/operation_0417"},{"term":"Phasing","uri":"http://edamontology.org/operation_3454"},{"term":"Sequence assembly","uri":"http://edamontology.org/operation_0310"}]}],"name":"FuzDB","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1093/NAR/GKAB1060","metadata":{"abstract":"\u00a9 2022 The Author(s). Published by Oxford University Press on behalf of Nucleic Acids Research.Fuzzy interactions are specific, variable contacts between proteins and other biomolecules (proteins, DNA, RNA, small molecules) formed in accord to the cellular context. Fuzzy interactions have recently been demonstrated to regulate biomolecular condensates generated by liquid-liquid phase separation. The FuzDB v4.0 database (https://fuzdb.org) assembles experimentally identified examples of fuzzy interactions, where disordered regions mediate functionally important, context-dependent contacts between the partners in stoichiometric and higher-order assemblies. The new version of FuzDB establishes cross-links with databases on structure (PDB, BMRB, PED), function (ELM, UniProt) and biomolecular condensates (PhaSepDB, PhaSePro, LLPSDB). FuzDB v4.0 is a source to decipher molecular basis of complex cellular interaction behaviors, including those in protein droplets.","authors":[{"name":"Fuxreiter M."},{"name":"Hatos A."},{"name":"Monzon A.M."},{"name":"Piovesan D."},{"name":"Tosatto S.C.E."}],"citationCount":2,"date":"2022-01-07T00:00:00Z","journal":"Nucleic Acids Research","title":"FuzDB: A new phase in understanding fuzzy interactions"},"pmcid":"PMC8728163","pmid":"34791357"}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Protein modifications","uri":"http://edamontology.org/topic_0601"},{"term":"RNA","uri":"http://edamontology.org/topic_0099"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"}],"validated":1},"bioschemas":{"name":"FuzDB","home":"https://bio.tools/fuzdb","license":"CC-BY-NC-SA-4.0","version":"4.0","summary":"The FuzDB database assembles experimentally observed fuzzy protein complexes\ninvolved in a variety of cellular processes and biomolecular condensates","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:fuzdb:4.0/db/fuzdb.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":26,"citations":[{"count":2,"year":"2026"},{"count":4,"year":"2024"},{"count":5