{"tool_name":"havoc","contents":["biotools","oeb"],"identifiers":["biotools:havoc"],"fetched_metadata":{"biotools":{"id":"havoc","home":"https://www.helsinki.fi/en/projects/havoc","summary":"Bioinformatic pipeline for reference-based consensus assembly and lineage assignment for SARS-CoV-2 sequences.\n\nHAVoC, a bioinformatic pipeline for reference-based consensus assembly and lineage assignment for SARS-CoV-2 sequences. HAVoC is a pipeline utilizing several bioinformatic tools to perform multiple necessary analyses for investigating genetic variance among SARS-CoV-2 samples.The pipeline is ideal for those who need a more accessible and fast tool to detect and monitor the spread of SARS-CoV-2 variants of concern during local outbreaks.","addition_date":"2021-03-19T08:56:12Z","last_update_date":"2026-11-12T14:24:07.967216Z","tool_type":["Command-line tool"],"collections":["COVID-19"],"biotools_curie":"biotools:havoc","credit":[{"email":"Ravi.Kant@helsinki.fi","name":"Ravi Kant","typeEntity":"Person"},{"email":"Teemu.Smura@helsinki.fi","name":"Teemu Smura","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"},{"term":"Sequence alignment","uri":"http://edamontology.org/operation_0292"},{"term":"Sequence assembly","uri":"http://edamontology.org/operation_0310"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"}]}],"name":"HaVoC","owner":"Niclaskn","publication":[{"doi":"10.1101/2021.02.12.431018","type":["Preprint"]},{"doi":"10.1186/s12859-021-04294-2","type":["Primary"]}],"topic":[{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:havoc/cmd/www.helsinki.fi","@license":"https://crea