{"tool_name":"mouse_gpcrs_and_human_and_rat_orthologs","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"mouse_gpcrs_and_human_and_rat_orthologs","home":"https://esbl.nhlbi.nih.gov/Databases/GPCRs/","summary":"data about  GPCR expression in different organ systems","addition_date":"2024-02-08T21:51:12.947604Z","last_update_date":"2024-11-24T14:15:22.235220Z","tool_type":["Database portal"],"collections":["gpcr"],"biotools_curie":"biotools:mouse_gpcrs_and_human_and_rat_orthologs","edit_permission":{"authors":["mbermudez1"],"type":"group"},"name":"Mouse GPCRs and Human and Rat orthologs","owner":"Friederike","publication":[{"doi":"10.1152/ajprenal.00077.2021","metadata":{"abstract":"Kidney transport and other renal functions are regulated by multiple G protein-coupled receptors (GPCRs) expressed along the renal tubule. The rapid, recent appearance of comprehensive unbiased gene expression data in the various renal tubule segments, chiefly RNA sequencing and protein mass spectrometry data, has provided a means of identifying patterns of GPCR expression along the renal tubule. To allow for comprehensive mapping, we first curated a comprehensive list of GPCRs in the genomes of mice, rats, and humans (https://hpcwebapps.cit.nih.gov/ESBL/Database/GPCRs/) using multiple online data sources. We used this list to mine segment-specific and cell type-specific expression data from RNA-sequencing studies in microdissected mouse tubule segments to identify GPCRs that are selectively expressed in discrete tubule segments. Comparisons of these mapped mouse GPCRs with other omics datasets as well as functional data from isolated perfused tubule and micropuncture studies confirmed patterns of expression for well-known receptors and identified poorly studied GPCRs that are likely to play roles in the regulation of renal tubule function. Thus, we provide data resources for GPCR expression across the renal tubule, highlighting both well-known GPCRs and understudied receptors to provide guidance for future studies.","authors":[{"name":"Chen L."},{"name":"Chou C.-L."},{"name":"Knepper M.A."},{"name":"Poll B.G."},{"name":"Raghuram V."}],"citationCount":14,"date":"2021-01-01T00:00:00Z","journal":"American Journal of Physiology - Renal Physiology","title":"Landscape of GPCR expression along the mouse nephron"},"pmcid":"PMC8321805","pmid":"34029142"}],"topic":[{"term":"Laboratory animal science","uri":"http://edamontology.org/topic_3386"},{"term":"Medicines research and development","uri":"http://edamontology.org/topic_3376"},{"term":"Protein expression","uri":"http://edamontology.org/topic_0108"}]},"bioschemas":{"name":"Mouse GPCRs and Human and Rat orthologs","home":"https://bio.tools/mouse_gpcrs_and_human_and_rat_orthologs","summary":"data about  GPCR expression in different organ systems","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mouse_gpcrs_and_human_and_rat_orthologs/db/esbl.nhlbi.nih.gov","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":20,"citations":[{"count":1,"year":"2021"},{"count":1,"year":"2022"},{"count":1,"year":"2023"},{"count":4,"year":"2024"},{"count":4,"year":"2026"},{"count":9,"year":"2025"}],"doi":"10.1152/ajprenal.00077.2021","pmcid":"PMC8321805","pmid":"34029142","ref_count":192,"refs":[{"count":1,"year":"-1"},{"count":1,"year":"1968"},{"count":1,"year":"1972"},{"count":1,"year":"1977"},{"count":1,"year":"1979"},{"count":1,"year":"1982"},{"count":1,"year":"1983"},{"count":1,"year":"1995"},{"count":1,"year":"2001"},{"count":2,"year":"1976"},{"count":2,"year":"1984"},{"count":2,"year":"1991"},{"count":2,"year":"1992"},{"count":2,"year":"1994"},{"count":2,"year":"1999"},{"count":2,"year":"2004"},{"count":2,"year":"2005"},{"count":2,"year":"2010"},{"count":3,"year":"1975"},{"count":3,"year":"