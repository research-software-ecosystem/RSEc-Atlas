{"tool_name":"ipaqtl-atlas","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"ipaqtl-atlas","home":"http://bioinfo.szbl.ac.cn/ipaQTL","license":"Other","summary":"An atlas of intronic polyadenylation quantitative trait loci across human tissues.","addition_date":"2022-10-22T16:39:58.490928Z","last_update_date":"2024-11-24T15:26:24.825676Z","tool_type":["Database portal","Web application"],"biotools_curie":"biotools:ipaqtl-atlas","cost":"Free of charge","credit":[{"name":"Xuelian Ma"},{"name":"Lei Li","orcidid":"https://orcid.org/0000-0003-3924-2544"}],"documentation":[{"type":["User manual"],"url":"http://bioinfo.szbl.ac.cn/ipaQTL/Help.php"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Gene expression QTL analysis","uri":"http://edamontology.org/operation_3232"},{"term":"Genetic mapping","uri":"http://edamontology.org/operation_0282"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"}]}],"name":"ipaQTL-atlas","operating_system":["Linux","Mac","Windows"],"owner":"Chan019","publication":[{"doi":"10.1093/nar/gkac736","metadata":{"abstract":"Functional interpretation of disease-associated noncoding variants remains a significant challenge in the post-GWAS era. Our recent study has identified 3UTR alternative polyadenylation (APA) quantitative trait loci (3aQTLs) and connects APA events with QTLs as a major driver of human traits and diseases. Besides 3UTR, APA events can also occur in intron regions, and increasing evidence has connected intronic polyadenylation with disease risk. However, systematic investigation of the roles of intronic polyadenylation in human diseases remained challenging due to the lack of a comprehensive database across a variety of human tissues. Here, we developed ipaQTL-atlas (http://bioinfo.szbl.ac.cn/ ipaQTL) as the first comprehensive portal for intronic polyadenylation. The ipaQTL-atlas is based on the analysis of 15 170 RNA-seq data from 838 individuals across 49 Genotype-Tissue Expression (GTEx v8) tissues and contains \u223c0.98 million SNPs associated with intronic APA events. It provides an interface for ipaQTLs search, genome browser, boxplots, and data download, as well as the visualization of GWAS and ipaQTL colocalization results. ipaQTL-atlas provides a one-stop portal to access intronic polyadenylation information and could significantly advance the discovery of APA-associated disease susceptibility genes.","authors":[{"name":"Cheng S."},{"name":"Ding R."},{"name":"Guang S."},{"name":"Jing H."},{"name":"Li L."},{"name":"Ma X."},{"name":"Ni T."},{"name":"Wang Q."},{"name":"Yu C."},{"name":"Zhao Z."},{"name":"Zou X."}],"citationCount":5,"date":"2023-01-06T00:00:00Z","journal":"Nucleic Acids Research","title":"ipaQTL-atlas: an atlas of intronic polyadenylation quantitative trait loci across human tissues"},"pmcid":"PMC9825496","pmid":"36043442"}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"GWAS study","uri":"http://edamontology.org/topic_3517"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"Pathology","uri":"http://edamontology.org/topic_0634"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"bioschemas":{"name":"ipaQTL-atlas","home":"https://bio.tools/ipaqtl-atlas","license":"Other","summary":"An atlas of intronic polyadenylation quantitative trait loci across human tissues.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ipaqtl-atlas/db/bioinfo.szbl.ac.cn","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":8,"citations":[{"count":1,"year":"2025"},{"count":2,"year":"2024"},{"cou