{"tool_name":"manual-frame-drift-registration","contents":["neubias"],"fetched_metadata":{"neubias":{"body":[{"format":"markdown","processed":"","summary":"","value":"An ImageJ macro for correcting frame drift occurred during image acquisition. \r\n\r\nIt often happens that you have an image sequence that shows problematic drifting of image frame and at the same time you have some landmarks that could be used for correcting the drift. This ImageJ macro allows you to Manually track the landmark using ImageJ Manual Tracking Plugin. Using the coordinates recorded in the Result window, each frame is shifted back so that the landmark stays in a single place.\r\n"}],"changed":[{"format":"Y-m-d\\TH:i:sP","value":"2018-10-18T15:28:46+00:00"}],"created":[{"format":"Y-m-d\\TH:i:sP","value":"2013-10-22T19:35:40+00:00"}],"default_langcode":[{"value":true}],"attribution_instructions":[],"comments_2023":[],"free_tagging":[],"give_feedback_on_this_soft":[{"cid":0,"comment_count":0,"last_comment_name":null,"last_comment_timestamp":1505205044,"last_comment_uid":164,"status":2}],"has_author":[{"value":"Kota Miura"}],"has_biological_terms":[],"has_comparison":[],"has_documentation":[],"has_doi":[],"has_entry_curator":[{"target_id":94,"target_type":"user","target_uuid":"aa749c9e-5b9a-4fdf-83ce-6b94538fe57c","url":"/user/94"}],"has_function":[{"target_id":4055,"target_type":"taxonomy_term","target_uuid":"http://edamontology.org/operation_Image_registration","url":"/image-registration"},{"target_id":4133,"target_type":"taxonomy_term","target_uuid":"http://edamontology.org/operation__RBh3vNecu5XlIPh3kbMM4Cq","url":"/drift-correction"},{"target_id":4067,"target_type":"taxonomy_term","target_uuid":"http://edamontology.org/operation__R7MFwdgojfmkZ07yWbdcda0","url":"/image-correction"}],"has_implementation":[],"has_interaction_level":[{"target_id":3574,"target_type":"taxonomy_term","target_uuid":"a22a3a50-0fbb-41ee-944a-38e0b86ac077","url":"/taxonomy/term/3574"}],"has_license":[],"has_locatio