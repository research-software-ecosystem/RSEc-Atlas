{"tool_name":"bioconda/fair-bioheaders","contents":["bioconda"],"identifiers":["bioconda:fair-bioheaders"],"fetched_metadata":{"bioconda":{"name":"fair-bioheaders","version":"0.8.1","home":"https://github.com/FAIR-bioHeaders/FAIR-bioHeaders-Tools","documentation":"https://github.com/FAIR-bioHeaders/FHR-Specification","license":"MPL-2.0","summary":"Validate and convert FAIR-bioHeaders (FHR) metadata in JSON, YAML, JSON-LD, HTML microdata, FASTA and GFA.","identifiers":["doi:10.1093/bib/bbae122","doi:10.5281/zenodo.6762547"],"description":"FAIR-bioHeaders embed provenance metadata in reference genome FASTA and GFA\nfiles (the FHR header). These tools convert between JSON, YAML, JSON-LD,\nHTML microdata and embedded FASTA/GFA headers, validate metadata against\nthe schema, attach and strip headers, and verify the SHA-512/256 file\nchecksum. bioheaders assess checks how FAIR the header of a FASTA, GFF3,\nVCF, GFA or other text file is.\nPlain and gzip/bgzip-compressed files are streamed with bounded memory.\nFormerly published on PyPI as fhr; the fhr-* commands are kept.\n","license_file":"LICENSE","build":{"entry_points":["bioheaders = bioheaders.cli:main","fhr-convert = bioheaders.cli:convert_main","fhr-validate = bioheaders.cli:validate_main","fhr-fasta-strip = bioheaders.cli:fasta_strip_main","fhr-fasta-combine = bioheaders.cli:fasta_combine_main","fhr-fasta-validate = bioheaders.cli:fasta_validate_main","fhr-gfa-strip = bioheaders.cli:gfa_strip_main","fhr-gfa-combine = bioheaders.cli:gfa_combine_main","fhr-gfa-validate = bioheaders.cli:gfa_validate_main"],"noarch":"python","number":0,"run_exports":[null],"script":"-m pip install . --no-deps --no-build-isolation --no-cache-dir -vvv"},"requirements":{"host":["python .*","pip","poetry-core >=1.0.0"],"run":["python >=","jsonschema-with-format >=4.21.1,<5","pyyaml >=6.0.1,<7"]},"source_url":"https://pypi.org/packages/source/f/fair-bioheaders/fair_bioheaders-0.8.1.tar.gz","test":{"commands":["python -m pip check","bioheaders --version","bioheaders validate --help","bioheaders assess --help","fhr-convert --version","fhr-validate --help","fhr-fasta-combine --help","fhr-fasta-strip --help","fhr-fasta-validate --help","fhr-gfa-combine --help","fhr-gfa-strip --help","fhr-gfa-validate --help"],"imports":["bioheaders","bioheaders.cli","fhr"],"requires":["python","pip"]},"recipe_maintainers":["adamjohnwright"]}}}