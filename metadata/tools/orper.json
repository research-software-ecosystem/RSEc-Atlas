{"tool_name":"orper","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"orper","home":"https://github.com/Lcornet/ORPER","license":"Not licensed","summary":"A Workflow for Constrained SSU rRNA Phylogenies.","addition_date":"2022-05-19T21:08:45.301229Z","last_update_date":"2022-05-19T21:08:45.303965Z","tool_type":["Command-line tool","Workflow"],"accessibility":"Open access","biotools_curie":"biotools:orper","cost":"Free of charge","credit":[{"email":"denis.baurain@uliege.be","name":"Denis Baurain","orcidid":"https://orcid.org/0000-0003-2388-6185","typeEntity":"Person"},{"email":"luc.cornet@sciensano.be","name":"Luc Cornet","typeEntity":"Person"},{"name":"Anne-Catherine Ahn"},{"name":"Annick Wilmotte"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Filtering","uri":"http://edamontology.org/operation_3695"},{"term":"Phylogenetic inference","uri":"http://edamontology.org/operation_0323"},{"term":"Phylogenetic tree bootstrapping","uri":"http://edamontology.org/operation_0552"}]}],"name":"ORPER","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.3390/GENES12111741","metadata":{"abstract":"\u00a9 2021 by the authors. Licensee MDPI, Basel, Switzerland.The continuous increase in sequenced genomes in public repositories makes the choice of interesting bacterial strains for future sequencing projects ever more complicated, as it is difficult to estimate the redundancy between these strains and the already available genomes. Therefore, we developed the Nextflow workflow \u201cORPER\u201d, for \u201cORganism PlacER\u201d, containerized in Singu-larity, which allows the determination the phylogenetic position of a collection of organisms in the genomic landscape. ORPER constrains the phylogenetic placement of SSU (16S) rRNA sequences in a multilocus reference tree based on ribosomal protein genes extracted from public genomes. We demonstrate the utility of ORPER on the Cyanobacteria phylum, by placing 152 strains of the BCCM/ULC collection.","authors":[{"name":"Ahn A.-C."},{"name":"Baurain D."},{"name":"Cornet L."},{"name":"Wilmotte A."}],"date":"2021-11-01T00:00:00Z","journal":"Genes","title":"Orper: A workflow for constrained ssu rrna phylogenies"},"pmcid":"PMC8623055","pmid":"34828348"}],"topic":[{"term":"Computer science","uri":"http://edamontology.org/topic_3316"},{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"Phylogenomics","uri":"http://edamontology.org/topic_0194"},{"term":"Phylogeny","uri":"http://edamontology.org/topic_0084"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}],"validated":1},"bioschemas":{"name":"ORPER","home":"https://bio.tools/orper","license":"Not licensed","summary":"A Workflow for Constrained SSU rRNA Phylogenies.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:orper/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":2,"citations":[{"count":1,"year":"2022"},{"count":1,"year":"2026"}],"doi":"10.3390/genes12111741","pmcid":"PMC8623055","pmid":"34828348","ref_count":50,"refs":[{"count":1,"year":"2005"},{"count":1,"year":"2006"},{"count":1,"year":"2009"},{"count":1,"year":"2016"},{"count":2,"year":"2004"},{"count":2,"year":"2007"},{"count":2,"year":"2008"},{"count":2,"year":"2011"},{"count":2,"year":"2012"},{"count":2,"year":"2013"},{"count":2,"year":"2014"},{"count":2,"year":"2015"},{"count":3,"year":"2010"},{"count":4,"year":"2018"},{"count":4,"y