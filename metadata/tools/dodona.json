{"tool_name":"dodona","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"dodona","home":"https://dodona.ugent.be","summary":"Dodona is a free online exercise platform for learning to code. It wants to teach students how to program in the most meaningful and effective way possible, by using different techniques to apply the advantages of personalized coaching in contexts where students usually only have access to traditional coaching (e.g. lectures or exercise sessions) or even no coaching at all (e.g. independent learning or homework).","addition_date":"2021-04-25T20:44:38Z","last_update_date":"2021-04-25T20:46:53Z","tool_type":["Web application"],"version":["4.2"],"biotools_curie":"biotools:dodona","documentation":[{"type":["General"],"url":"https://docs.dodona.be"}],"edit_permission":{"type":"private"},"maturity":"Mature","name":"Dodona","owner":"bmesuere"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:dodona:4.2/web/dodona.ugent.be","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://dodona.be/"}],"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/dodona","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://dodona.be/"}],"ssl":true,"ssl_err":null}}}]}}}