{"tool_name":"lilikoi","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"Lilikoi","home":"https://cran.r-project.org/web/packages/lilikoi/index.html","license":"GPL-2.0","summary":"R package for personalized pathway-based classification modeling using metabolomics data.","addition_date":"2019-08-11T16:35:27Z","last_update_date":"2020-06-16T10:55:25Z","tool_type":["Library"],"accessibility":"Open access","biotools_curie":"biotools:Lilikoi","cost":"Free of charge","credit":[{"email":"falakwaa@hawaii.edu","name":"Fadhl Alakwaa","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"https://cran.r-project.org/web/packages/lilikoi/lilikoi.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Enrichment analysis","uri":"http://edamontology.org/operation_3501"},{"term":"Expression profile pathway mapping","uri":"http://edamontology.org/operation_0533"},{"term":"Regression analysis","uri":"http://edamontology.org/operation_3659"}]}],"maturity":"Mature","name":"Lilikoi","operating_system":["Linux","Mac","Windows"],"owner":"Ruta","publication":[{"doi":"10.1093/gigascience/giy136","metadata":{"abstract":"Lilikoi (the Hawaiian word for passion fruit) is a new and comprehensive R package for personalized pathway-based classification modeling using metabolomics data. Four basic modules are presented as the backbone of the package: feature mapping module, which standardizes the metabolite names provided by users and maps them to pathways; dimension transformation module, which transforms the metabolomic profiles to personalized pathway-based profiles using pathway deregulation scores; feature selection module, which helps to select the significant pathway features related to the disease phenotypes; and classification and prediction module, which offers various machine learning classification algorithms. The package is freely available under the GPLv3 license through the github repository at: https://github.com/lanagarmire/lilikoi and CRAN: https://cran.r-project.org/web/packages/lilikoi/index.html.","authors":[{"name":"Al-Akwaa F.M."},{"name":"Alhajaji H."},{"name":"Garmire L.X."},{"name":"Huang S."},{"name":"Yunits B."}],"citationCount":13,"date":"2018-12-01T00:00:00Z","journal":"GigaScience","title":"Lilikoi: an R package for personalized pathway-based classification modeling using metabolomics data"},"pmcid":"PMC6290884","pmid":"30535020","type":["Primary"]}],"topic":[{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}],"validated":1},"bioschemas":{"name":"Lilikoi","home":"https://bio.tools/Lilikoi","license":"GPL-2.0","summary":"R package for personalized pathway-based classification modeling using metabolomics data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:lilikoi/lib/cran.r-project.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":17,"citations":[{"count":1,"year":"2018"},{"count":1,"year":"2022"},{"count":1,"year":"2023"},{"count":1,"year":"2025"},{"count":2,"year":"2019"},{"count":3,"year":"2020"},{"count":3,"year":"2024"},{"count":5,"year":"2021"}],"doi":"10.1093/gigascience/giy136","pmcid":"PMC6290884","pmid":"30535020","ref_count":26,"refs":[{"count":1,"year":"2006"},{"count":1,"year":"2008"},{"count":1,"year":"2009"},{"