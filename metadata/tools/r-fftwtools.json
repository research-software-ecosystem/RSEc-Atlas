{"tool_name":"r-fftwtools","contents":["biocontainers","oeb"],"fetched_metadata":{"biocontainers":{"name":"r-fftwtools","identifiers":[],"license":"GPL (>= 2)","summary":"Provides a wrapper for several FFTW functions. This package provides access to the two-dimensional FFT, the multivariate FFT, and the one-dimensional real to complex FFT using FFTW3. The package includes the functions fftw and mvfftw which are designed to mimic the functionality of the R functions fft and mvfft. The FFT functions have a parameter that allows them to not return the redundant complex conjugate when the input is real data. ","home_url":"None","keywords":[],"manually_check":true,"total_pulls":0},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:r-fftwtools:0.9.7/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":true,"source_packages":false,"sourcecode":{"free":null,"interpreted":null,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"readme":false,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://github.com/krahim/fftwtools"}],"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/r-fftwtools","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":null,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"publications":[],"r