{"tool_name":"resprox","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"resprox","home":"http://www.resprox.ca/","summary":"ResProx (Resolution-by-proxy or Res(p)) is a web server that predicts the atomic resolution of NMR protein structures using only PDB coordinate data as input. More specfically, ResProx uses machine learning techniques to accurately estimate (with a correlation coefficient of 0.92 between observed and calculated) the atomic resolution of a protein structure from 25 measurable features that can be derived from its atomic coordinates.","addition_date":"2017-08-03T18:58:37Z","last_update_date":"2024-11-25T16:08:56.400735Z","tool_type":["Web application"],"biotools_curie":"biotools:resprox","credit":[{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.resprox.ca/contact.html"}],"documentation":[{"type":["General"],"url":"http://www.resprox.ca/documentation.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Protein structure prediction","uri":"http://edamontology.org/operation_0474"}]}],"name":"ResProx","operating_system":["Linux","Mac","Windows"],"owner":"mbs_import","publication":[{"doi":"10.1007/s10858-012-9637-2","pmid":"22678091"}],"topic":[{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"NMR","uri":"http://edamontology.org/topic_0593"},{"term":"Structure prediction","uri":"http://edamontology.org/topic_0082"}],"validated":1},"bioschemas":{"name":"ResProx","home":"https://bio.tools/resprox","summary":"ResProx (Resolution-by-proxy or Res(p)) is a web server that predicts the atomic resolution of NMR protein structures using only PDB coordinate data as input. More specfically, ResProx uses machine learning techniques to accurately estimate (with a correlation coefficient of 0.92 between observed and calculated) the atomic resolution of a protein structure from 25 measurable features that can be derived from its atomic coordinates.","tool