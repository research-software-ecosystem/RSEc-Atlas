{"tool_name":"simffpe","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"simffpe","home":"https://bioconductor.org/packages/SimFFPE","license":"LGPL-3.0","summary":"The NGS (Next-Generation Sequencing) reads from FFPE (Formalin-Fixed Paraffin-Embedded) samples contain numerous artifact chimeric reads (ACRS), which can lead to false positive structural variant calls. These ACRs are derived from the combination of two single-stranded DNA (ss-DNA) fragments with short reverse complementary regions (SRCRs). This package simulates these artifact chimeric reads as well as normal reads for FFPE samples on the whole genome / several chromosomes / large regions.","addition_date":"2022-01-28T02:11:36.146992Z","last_update_date":"2022-01-28T02:11:36.149428Z","tool_type":["Library"],"version":["1.24.0"],"collections":["BioConductor"],"accessibility":"Open access","biotools_curie":"biotools:simffpe","cost":"Free of charge","credit":[{"name":"Lanying Wei","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/SimFFPE"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"},{"term":"Variant filtering","uri":"http://edamontology.org/operation_3675"}]}],"name":"SimFFPE","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.18129/B9.bioc.SimFFPE"}],"topic":[{"term":"Sample collections","uri":"http://edamontology.org/topic_3277"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"},{"term":"Structural variation","uri":"http://edamontology.org/topic_3175"}],"validated":1},"bioschemas":{"name":"SimFFPE","home":"https://bio.tools/simffpe","license":"LGPL-3.0-only","version":"1.24.0","summary":"The NGS (Next-Generation Sequencing) reads from FFPE (Form