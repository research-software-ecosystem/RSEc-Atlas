{"tool_name":"bioconductor-omnipathr","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-omnipathr","identifiers":["doi:10.18129/b9.bioc.omnipathr"],"license":"MIT","summary":"Import omnipath network","home_url":"https://bioconductor.org/packages/3.11/bioc/html/OmnipathR.html","keywords":[],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-omnipathr","home":"https://bioconductor.org/packages/OmnipathR","license":"MIT","summary":"A client for the OmniPath web service (https://www.omnipathdb.org) and many other resources. It also includes functions to transform and pretty print some of the downloaded data, functions to access a number of other resources such as BioPlex, ConsensusPathDB, EVEX, Gene Ontology, Guide to Pharmacology (IUPHAR/BPS), Harmonizome, HTRIdb, Human Phenotype Ontology, InWeb InBioMap, KEGG Pathway, Pathway Commons, Ramilowski et al. 2015, RegNetwork, ReMap, TF census, TRRUST and Vinayagam et al. 2011. Furthermore, OmnipathR features a close integration with the NicheNet method for ligand activity prediction from transcriptomics data, and its R implementation `nichenetr` (available only on github).","addition_date":"2026-08-30T02:47:50.846134Z","last_update_date":"2026-08-30T02:47:50.849170Z","tool_type":["Command-line tool","Library"],"version":["4.0.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-omnipathr","credit":[{"name":"Alberto Valdeolivas","typeEntity":"Person","typeRole":["Developer"]},{"name":"Attila Gabor","typeEntity":"Person","typeRole":["Developer"]},{"name":"Aurelien Dugourd","typeEntity":"Person","typeRole":["Developer"]},{"name":"Denes Turei","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Diego Mananes","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/OmnipathR"}],"edit_permission":{"type":"private"},"name":"OmnipathR