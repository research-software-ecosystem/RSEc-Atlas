{"tool_name":"omssa","contents":["biocontainers","oeb","biotools"],"fetched_metadata":{"biocontainers":{"name":"omssa","identifiers":[],"license":"Public Domain","summary":"Open Mass Spectrometry Search Algorithm (OMSSA)","home_url":"ftp://ftp.ncbi.nlm.nih.gov/pub/lewisg/omssa/","keywords":[],"manually_check":true,"total_pulls":0},"biotools":{"id":"OMSSA","home":"https://pubchem.ncbi.nlm.nih.gov/omssa/","summary":"The Open Mass Spectrometry Search Algorithm (OMSSA) is an efficient search engine for identifying MS/MS peptide spectra by searching libraries of known protein sequences. OMSSA scores significant hits with a probability score developed using classical hypothesis testing, the same statistical method used in BLAST. It is developed at the National Center for Biotechnology Information.","addition_date":"2019-02-20T16:17:02Z","last_update_date":"2019-09-04T08:38:55Z","tool_type":["Command-line tool"],"collections":["Proteomics","ms-utils"],"biotools_curie":"biotools:OMSSA","credit":[{"email":"info@ncbi.nlm.nih.gov","name":"see publication","typeEntity":"Person","typeRole":["Maintainer"]}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"name":"OMSSA","owner":"admin","publication":[{"metadata":{"abstract":"Large numbers of MS/MS peptide spectra generated in proteomics experiments require efficient, sensitive and specific algorithms for peptide identification. In the Open Mass Spectrometry Search Algorithm (OMSSA), specificity is calculated by a classic probability score using an explicit model for matching experimental spectra to sequences. At default thresholds, OMSSA matches more spectra from a standard protein cocktail than a comparable algorithm. OMSSA is designed to be faster than published algorithms in searching large MS/MS datasets.","authors":[{"name":"Bryant S.H."},{"name":"Geer L.Y."},{"name":"Kowalak J.A."},{"name":"Markey S.P."},{"name":"Maynard D.M."},{"name":"Shi W."},{"name":"Wagner L."},{"name":"Xu M."},{"name":"Yang X."}],