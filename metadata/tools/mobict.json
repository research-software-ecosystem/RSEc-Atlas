{"tool_name":"mobict","contents":["biotools"],"identifiers":["biotools:mobict"],"fetched_metadata":{"biotools":{"id":"mobict","home":"https://github.com/SimCab-CHU/MobiCT","summary":"MobiCT is a Nextflow pipeline built on nf-core guidelines that detects ultra-low-frequency variants in cell-free DNA using unique molecular identifiers, via UMI deduplication, alignment to a reference genome, and variant calling; it was validated on cancer patient and control samples with ~90% sensitivity, precision, and F1-score.","addition_date":"2026-11-04T09:54:20.616239Z","last_update_date":"2026-11-04T09:54:20.620933Z","biotools_curie":"biotools:mobict","credit":[{"email":"j-solassol@chu-montpellier.fr","name":"J\u00e9r\u00f4me Solassol","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Validation","uri":"http://edamontology.org/operation_2428"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"},{"term":"Variant prioritisation","uri":"http://edamontology.org/operation_3226"}]}],"name":"MobiCT","owner":"pub2tools2024","publication":[{"doi":"10.1093/NARGAB/LQAF212","pmcid":"PMC12770973","pmid":"41503160"}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Oncology","uri":"http://edamontology.org/topic_2640"},{"term":"Probes and primers","uri":"http://edamontology.org/topic_0632"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]}}}