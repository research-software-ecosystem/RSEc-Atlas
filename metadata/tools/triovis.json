{"tool_name":"triovis","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"triovis","home":"http://www.bytebucket.org/vda-lab/triovis/wiki/Home","summary":"It is a visualisation tool developed to assist filtering on coverage and variant frequency for genomic variants from exome sequencing of parent-child trios. It organises the variant data by grouping each variant based on the laws of Mendelian inheritance. Taking three Variant Call Format files as input, the tool provides a user interface to test different coverage thresholds, to find the optimal threshold values, and to gain insights into the global effects of filtering.","addition_date":"2017-12-18T00:13:51Z","last_update_date":"2018-12-10T12:58:59Z","tool_type":["Desktop application"],"version":["20130409"],"biotools_curie":"biotools:triovis","credit":[{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://homes.esat.kuleuven.be/~bioiuser"}],"documentation":[{"type":["General"],"url":"https://bitbucket.org/vda-lab/triovis/wiki/Home"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Filtering","uri":"http://edamontology.org/operation_3695"}]},{"operation":[{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"TrioVis","operating_system":["Linux","Mac","Windows"],"owner":"mbs_import","topic":[{"term":"Exome sequencing","uri":"http://edamontology.org/topic_3676"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:triovis:20130409/app/www.bytebucket.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":null,"public":true,"readme":false,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"dep