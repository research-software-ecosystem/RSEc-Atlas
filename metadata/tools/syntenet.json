{"tool_name":"syntenet","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"syntenet","home":"https://bioconductor.org/packages/syntenet","license":"GPL-3.0","summary":"syntenet can be used to infer synteny networks from whole-genome protein sequences and analyze them. Anchor pairs are detected with the MCScanX algorithm, which was ported to this package with the Rcpp framework for R and C++ integration. Anchor pairs from synteny analyses are treated as an undirected unweighted graph (i.e., a synteny network), and users can perform: i. network clustering; ii. phylogenomic profiling (by identifying which species contain which clusters) and; iii. microsynteny-based phylogeny reconstruction with maximum likelihood.","addition_date":"2022-12-29T11:36:16.544229Z","last_update_date":"2024-11-24T14:52:00.704591Z","tool_type":["Command-line tool","Library"],"version":["1.14.0"],"collections":["BioConductor","VIB"],"accessibility":"Open access","biotools_curie":"biotools:syntenet","cost":"Free of charge","credit":[{"name":"Fabr\u00edcio Almeida-Silva","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Kristian K Ullrich","typeEntity":"Person","typeRole":["Developer"]},{"name":"Tao Zhao","typeEntity":"Person","typeRole":["Developer"]},{"name":"Yves Van de Peer","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/syntenet"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Phylogenetic inference","uri":"http://edamontology.org/operation_0323"},{"term":"Protein identification","uri":"http://edamontology.org/operation_3767"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"Syntenet","operating_system":["Linux","Mac","Windows"],"owner":"bits@vib.be","publication":[{"doi":"10.1093/bioinformatics/btac806"}],"topic":[{"term":"Functional genomics","uri":"http://edamontology.org/topic_0085"},{"term":"Gene