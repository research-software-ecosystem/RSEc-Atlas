{"tool_name":"bioconductor-delayeddataframe","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-delayeddataframe","identifiers":["doi:10.18129/b9.bioc.delayeddataframe"],"license":"GPL-3","summary":"Delayed operation on DataFrame using standard DataFrame metaphor","home_url":"https://bioconductor.org/packages/3.9/bioc/html/DelayedDataFrame.html","keywords":[],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-delayeddataframe","home":"https://bioconductor.org/packages/DelayedDataFrame","license":"GPL-3.0","summary":"Based on the standard DataFrame metaphor, we are trying to implement the feature of delayed operation on the DelayedDataFrame, with a slot of lazyIndex, which saves the mapping indexes for each column of DelayedDataFrame. Methods like show, validity check, [/[[ subsetting, rbind/cbind are implemented for DelayedDataFrame to be operated around lazyIndex. The listData slot stays untouched until a realization call e.g., DataFrame constructor OR as.list() is invoked.","addition_date":"2026-09-01T07:18:24.472836Z","last_update_date":"2026-09-01T07:18:24.476001Z","tool_type":["Command-line tool","Library"],"version":["1.28.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-delayeddataframe","credit":[{"name":"Herv\u00e9 Pag\u00e8s","typeEntity":"Person","typeRole":["Developer"]},{"name":"Martin Morgan","typeEntity":"Person","typeRole":["Developer"]},{"name":"Qian Liu","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/DelayedDataFrame"}],"edit_permission":{"type":"private"},"name":"DelayedDataFrame","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.18129/B9.bioc.DelayedDataFrame"}]},"bioschemas":{"name":"DelayedDataFrame","home":"https://bio.tools/bioconductor-delayeddataframe","license":"GPL-3.0-only","version":"1.28.0