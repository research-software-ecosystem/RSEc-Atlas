{"tool_name":"vep","contents":["bioconda","bioschemas","biotools","debian","galaxy","oeb"],"identifiers":["biotools:vep","bioconda:ensembl-vep","galaxy:ensembl_vep","debian:ensembl-vep"],"fetched_metadata":{"biotools":{"id":"vep","home":"http://www.ensembl.org/vep","license":"Apache-2.0","summary":"Tool for predicting effects of variants for any genome in Ensembl or with genome annotation (via GFF). This includes vertebrates and also plants, fungi, protists, metazoa and bacteria.  There is a web and a REST API version but the most powerful is the Perl script version. See McLaren et al., 2016, Genome Biology","addition_date":"2017-01-13T13:16:56Z","last_update_date":"2024-11-25T13:46:15.572887Z","tool_type":["Command-line tool","Script","Web application","Web service"],"collections":["Animal and Crop Genomics","EBI Tools","Ensembl Tools"],"accessibility":"Open access","biotools_curie":"biotools:vep","cost":"Free of charge","credit":[{"name":"Contact Form","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.ensembl.org/Help/Contact"},{"name":"Ensembl","typeRole":["Developer"],"url":"http://www.ensembl.org/vep"}],"documentation":[{"type":["General"],"url":"http://www.ensembl.org/info/docs/tools/vep/online/index.html"},{"type":["General"],"url":"http://www.ensembl.org/info/docs/tools/vep/script/index.html"}],"edit_permission":{"authors":["ELIXIR-EE","Fiona","animalandcropgenomics","lmatalonga"],"type":"group"},"function":[{"operation":[{"term":"Genetic variation analysis","uri":"http://edamontology.org/operation_3197"},{"term":"SNP annotation","uri":"http://edamontology.org/operation_3661"}]}],"maturity":"Mature","name":"Variant Effect Predictor (VEP)","operating_system":["Linux","Mac","Windows"],"owner":"Fiona","publication":[{"doi":"10.1186/s13059-016-0974-4","metadata":{"abstract":"The Ensembl Variant Effect Predictor is a powerful toolset for the analysis, annotation, and prioritization of genomic variants in coding and non-coding regions. It prov