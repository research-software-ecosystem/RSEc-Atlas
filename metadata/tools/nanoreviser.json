{"tool_name":"nanoreviser","contents":["biotools","oeb"],"identifiers":["biotools:nanoreviser"],"fetched_metadata":{"biotools":{"id":"nanoreviser","home":"https://github.com/pkubioinformatics/NanoReviser","summary":"An Error-correction Tool for Nanopore Sequencing Based on a Deep Learning Algorithm.\n\nNanopore sequencing is regarded as one of the most promising third-generation sequencing (TGS) technologies. However, the nanopore sequencing reads are susceptible to a fairly high error rate owing to the difficulty in identifying the DNA bases from the complex electrical signals. Here we proposed a DNA basecalling reviser, NanoReviser, based on a deep learning algorithm to correct the basecalling errors introduced by current basecallers provided by default. In our module, we re-segmented the raw electrical signals based on the basecalled sequences provided by the default basecallers. By employing convolution neural networks (CNNs) and bidirectional long short-term memory (Bi-LSTM) networks, we took advantage of the information from the raw electrical signals and the basecalled sequences from the basecallers.","addition_date":"2021-01-18T09:52:01Z","last_update_date":"2026-11-12T14:22:43.220544Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:nanoreviser","credit":[{"email":"hqzhu@pku.edu.cn","name":"Huaiqiu Zhu","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Base-calling","uri":"http://edamontology.org/operation_3185"},{"term":"Read pre-processing","uri":"http://edamontology.org/operation_3219"},{"term":"Sequencing error detection","uri":"http://edamontology.org/operation_3195"}]}],"name":"NanoReviser","owner":"Niclaskn","publication":[{"doi":"10.1101/2020.07.25.220855","type":["Preprint"]},{"doi":"10.3389/fgene.2020.00900","type":["Primary"]}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Whole genome sequencing","uri":"http://edamontology.org/topic_3673"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:nanoreviser/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1101/2020.07.25.220855","pmcid":null,"pmid":null,"ref_count":0,"refs":[],"title":null,"year":null}]},{"entries":[{"cit_count":17,"citations":[{"count":1,"year":2023},{"count":2,"year":2025},{"count":3,"year":2024},{"count":4,"year":2026},{"count":7,"year":2021}],"doi":"10.3389/fgene.2020.00900","pmcid":"PMC7434944","pmid":"32903372","ref_count":21,"refs":[{"count":1,"year":1997},{"count":1,"year":2019},{"count":3,"year":2015},{"count":5,"year":2017},{"count":5,"year":2018},{"count":6,"year":2016}],"title":"NanoReviser: An Error-Correction Tool for Nanopore Sequencing Based on a Deep Learning Algorithm.","year":2020}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":true,"resolve_time":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/nanoreviser","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"publications":[],"readme":true,"summary":{"description":true},"website":{"bios