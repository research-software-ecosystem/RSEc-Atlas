{"tool_name":"bioconductor-voyager","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-voyager","home":"https://bioconductor.org/packages/SpatialFeatureExperiment","license":"Artistic-2.0","summary":"A new S4 class integrating Simple Features with the R package sf to bring geospatial data analysis methods based on vector data to spatial transcriptomics. Also implements management of spatial neighborhood graphs and geometric operations. This pakage builds upon SpatialExperiment and SingleCellExperiment, hence methods for these parent classes can still be used.","addition_date":"2026-08-30T02:55:10.478613Z","last_update_date":"2026-09-06T01:51:28.222351Z","tool_type":["Command-line tool","Library"],"version":["1.14.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-voyager","credit":[{"name":"Alik Huseynov","typeEntity":"Person","typeRole":["Developer"]},{"name":"Lambda Moses","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Lior Pachter","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/SpatialFeatureExperiment"}],"edit_permission":{"type":"private"},"name":"Voyager","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.1101/2023.07.20.549945"}]},"bioschemas":{"name":"Voyager","home":"https://bio.tools/bioconductor-voyager","license":"Artistic-2.0","version":"1.14.0","summary":"SpatialFeatureExperiment (SFE) is a new S4 class for working with spatial single-cell genomics data. The voyager package implements basic exploratory spatial data analysis (ESDA) methods for SFE. Univariate methods include univariate global spatial ESDA methods such as Moran's I, permutation testing for Moran's I, and correlograms. Bivariate methods include Lee's L and cross variogram. Multivariate methods include MULTISPATI PCA and multivariate local Geary's C recently developed by Anselin. The Voyager package also implements plotting functions to plot SFE data and ESDA results.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-voyager:1.0.3/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-voyager:1.2.3/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-voyager:1.4.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconductor-voyager","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operation