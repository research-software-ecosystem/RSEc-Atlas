{"tool_name":"sonicparanoid","contents":["biocontainers","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"sonicparanoid","version":"2.0.9","home":"https://gitlab.com/salvo981/sonicparanoid2","documentation":"https://gitlab.com/salvo981/sonicparanoid2/-/wikis/home","license":"GPL-3.0-only","summary":"SonicParanoid: fast, accurate, and comprehensive orthology inference with machine learning and language models","identifiers":["doi:10.1101/2023.05.14.540736","doi:10.1093/bioinformatics/bty631","biotools:SonicParanoid"],"license_file":"LICENSE.md","build":{"entry_points":["sonicparanoid = sonicparanoid.sonic_paranoid:main","sonicparanoid-get-test-data = sonicparanoid.get_test_data:main","sonicparanoid-get-profiles = sonicparanoid.get_pfam_profiles:main","sonicparanoid-extract = sonicparanoid.sonic_paranoid_extract:main","sonic-debug-infer-ortho-table = sonicparanoid.sonic_infer_ortho_table:main"],"number":0,"run_exports":[null],"script":["mkdir -p ${PREFIX}/bin","-m pip install . --no-deps --no-build-isolation --no-cache-dir --use-pep517 -vvv"],"skip":true},"requirements":{"build":[null],"host":["python","pip","python-build >=1.2.1","cython <3.1.0","numpy"],"run":["python","numpy","pandas >=2.2.0","scipy <1.13","biopython >=1.83","psutil >=6.0.0","scikit-learn >=1.5.0","filetype >=1.2.0","gdown >=5.2.0","gensim >=4.2.0","mypy >=1.10.0","smart-open >=7.0.1","tqdm >=4.66.0","mmseqs2 >=13.45111","diamond >=2.0.12","blast >=2.12.0","mcl >=14.137"]},"source_url":"https://pypi.org/packages/source/s/sonicparanoid/sonicparanoid-2.0.9.tar.gz","test":{"commands":["sonicparanoid --help","sonicparanoid-get-test-data --help","sonicparanoid-get-profiles --help","sonicparanoid-extract --help"],"imports":["sonicparanoid"]}},"biocontainers":{"name":"sonicparanoid","identifiers":["doi:10.1093/bioinformatics/bty631"],"license":"GPL-3.0","summary":"SonicParanoid: fast, easy and accurate orthology inference","home_url":"http://iwasakilab.bs.s.u-tokyo.ac.jp/sonicparanoid/","keywords":["Computational Biology","Databases, Genetic","Genome","Genomics","Clustering","Protein Sequences","Ortholog"],"manually_check":true,"total_pulls":0},"biotools":{"id":"SonicParanoid","home":"http://iwasakilab.bs.s.u-tokyo.ac.jp/sonicparanoid/","license":"GPL-3.0","summary":"SonicParanoid is a stand-alone software tool for the identification of orthologous relationships among multiple species.","addition_date":"2019-05-30T08:55:18Z","last_update_date":"2024-11-25T14:10:07.668484Z","tool_type":["Command-line tool"],"version":["1.0.9"],"biotools_curie":"biotools:SonicParanoid","cost":"Free of charge","credit":[{"email":"salvocos@bs.s.u-tokyo.ac.jp","name":"Salvatore Cosentino","orcidid":"https://orcid.org/0000-0002-1066-8659","typeEntity":"Person","typeRole":["Developer","Primary contact"]},{"email":"iwasaki@bs.s.u-tokyo.ac.jp","name":"Wataru Iwasaki","orcidid":"http://orcid.org/0000-0002-1066-8659","typeEntity":"Person","url":"http://iwasakilab.bs.s.u-tokyo.ac.jp/eindex.html"}],"documentation":[{"type":["General"],"url":"http://iwasakilab.bs.s.u-tokyo.ac.jp/sonicparanoid/#usage"}],"edit_permission":{"type":"private"},"function":[{"cmd":"sonicparanoid -i ./test_input -o ./test_output -m fast -t 4 --project-id my_first_run","operation":[{"term":"Genome comparison","uri":"http://edamontology.org/operation_3209"},{"term":"Phylogenetic tree analysis","uri":"http://edamontology.org/operation_0324"},{"term":"Prediction and recognition","uri":"http://edamontology.org/operation_2423"},{"term":"Sequence alignment","uri":"http://edamontology.org/operation_0292"}]}],"maturity":"Mature","name":"SonicParanoid","operating_system":["Linux","Mac"],"owner":"javi-gv94","publication":[{"doi":"10.1093/bioinformatics/bty631","metadata":{"abstract":"Motivation Orthology inference constitutes a common base of many genome-based studies, as a pre-requisite for annotating new genomes, finding target genes for biotechnological applications and revealing the evolutionary history of life. Although its importance keeps rising with the ever-growing number of sequenced genomes, existing tools are computationally demanding and difficult to employ. Results Here, we present SonicParanoid, which is faster than, but comparably accurate to, the well-established tools with a balanced precision-recall trade-off. Furthermore, SonicParanoid substantially relieves the difficulties of orthology inference for those who need to construct and maintain their own genomic datasets. Availability and implementation SonicParanoid is available with a GNU GPLv3 license on the Python Package Index and BitBucket. Documentation is available at http://iwasakilab.bs.s.u-Tokyo.ac.jp/sonicparanoid.","authors":[{"name":"Cosentino S."},{"name":"Iwasaki W."}],"citationCount":82,"date":"2019-01-01T00:00:00Z","journal":"Bioinformatics","title":"SonicParanoid: Fast, accurate and easy orthology inference"},"pmcid":"PMC6298048","pmid":"30032301","type":["Primary"]}],"topic":[{"term":"Bioinformatics","uri":"http://edamontology.org/topic_0091"},{"term":"Comparative genomics","uri":"http://edamontology.org/topic_0797"},{"term":"Phylogeny","uri":"http://edamontology.org/topic_0084"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"bioschemas":{"name":"SonicParanoid","home":"https://bio.tools/SonicParanoid","license":"GPL-3.0","version":"1.0.9","summary":"SonicParanoid is a stand-alone software tool for the identification of orthologous relationships among multiple species.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:sonicparanoid:1.0.9/cmd/iwasakilab.bs.s.u-tokyo.ac.jp","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"source_packages":true,"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"p