{"tool_name":"pdid","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"pdid","home":"http://biomine.cs.vcu.edu/servers/PDID/index.php","license":"Other","summary":"Database of molecular-level putative protein-drug interactions in the structural human proteome.","addition_date":"2018-05-12T11:05:52Z","last_update_date":"2024-11-24T21:05:28.562592Z","tool_type":["Database portal","Web application"],"collections":["Proteomics"],"accessibility":"Open access","biotools_curie":"biotools:pdid","cost":"Free of charge","credit":[{"email":"lkurgan@vcu.edu","name":"Lukasz Kurgan","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"note":"Tutorial material","type":["Training material"],"url":"http://biomine.cs.vcu.edu/servers/PDID/help.html"},{"type":["General"],"url":"http://biomine.cs.vcu.edu/servers/PDID/about.html"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"operation":[{"term":"Database search","uri":"http://edamontology.org/operation_2421"}]}],"maturity":"Mature","name":"PDID","operating_system":["Linux","Mac","Windows"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1093/bioinformatics/btv597","metadata":{"abstract":"Motivation: Many drugs interact with numerous proteins besides their intended therapeutic targets and a substantial portion of these interactions is yet to be elucidated. Protein-Drug Interaction Database (PDID) addresses incompleteness of these data by providing access to putative protein-drug interactions that cover the entire structural human proteome. Results: PDID covers 9652 structures from 3746 proteins and houses 16 800 putative interactions generated from close to 1.1 million accurate, all-atom structure-based predictions for several dozens of popular drugs. The predictions were generated with three modern methods: ILbind, SMAP and eFindSite. They are accompanied by propensity scores that quantify likelihood of interactions and coordinates of the putative location of the binding drugs in the corresponding protein structures. PDID complements the current databases that focus on the curated interactions and the BioDrugScreen database that relies on docking to find putative interactions. Moreover, we also include experimentally curated interactions which are linked to their sources: DrugBank, BindingDB and Protein Data Bank. Our database can be used to facilitate studies related to polypharmacology of drugs including repurposing and explaining side effects of drugs. Availability and implementation: PDID database is freely available at http://biomine.ece.ualberta.ca/PDID/.","authors":[{"name":"Brylinski M."},{"name":"Hu G."},{"name":"Kurgan L."},{"name":"Wang C."},{"name":"Wang K."},{"name":"Xie L."}],"citationCount":38,"date":"2016-02-15T00:00:00Z","journal":"Bioinformatics","title":"PDID: Database of molecular-level putative protein-drug interactions in the structural human proteome"},"pmcid":"PMC5963357","pmid":"26504143","type":["Primary"]}],"topic":[{"term":"Drug development","uri":"http://edamontology.org/topic_3373"},{"term":"Human biology","uri":"http://edamontology.org/topic_2815"},{"term":"Protein interactions","uri":"http://edamontology.org/topic_0128"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"}],"validated":1},"bioschemas":{"name":"PDID","home":"https://bio.tools/pdid","license":"Other","summary":"Database of molecular-level putative protein-drug interactions in the structural human proteome.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pdid/db/biomine.cs.vcu.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true,"training_material":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":23,"citations":[{"count":1,"year":"2016"},{"count":1,"year":"20