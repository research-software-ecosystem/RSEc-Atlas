{"tool_name":"proxl","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"proxl","home":"https://github.com/yeastrc/proxl-web-app","license":"Apache-2.0","summary":"Platform for the analysis, visualization and sharing of protein cross-linking mass spectrometry data","addition_date":"2019-01-23T09:32:42Z","last_update_date":"2020-06-16T10:55:24Z","tool_type":["Web application"],"collections":["Proteomics"],"accessibility":"Open access","biotools_curie":"biotools:proxl","cost":"Free of charge","credit":[{"email":"proxl-help@yeastrc.org","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"https://proxl-web-app.readthedocs.io/en/latest/"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"input":[{"data":{"term":"Protein interaction data","uri":"http://edamontology.org/data_0906"},"format":[{"term":"XML","uri":"http://edamontology.org/format_2332"}]}],"operation":[{"term":"Protein structure analysis","uri":"http://edamontology.org/operation_2406"},{"term":"Sequence visualisation","uri":"http://edamontology.org/operation_0564"},{"term":"Structure visualisation","uri":"http://edamontology.org/operation_0570"}],"output":[{"data":{"term":"Protein features","uri":"http://edamontology.org/data_1277"},"format":[{"term":"svg","uri":"http://edamontology.org/format_3604"}]},{"data":{"term":"Protein structure","uri":"http://edamontology.org/data_1460"},"format":[{"term":"svg","uri":"http://edamontology.org/format_3604"}]}]}],"maturity":"Mature","name":"ProXL","operating_system":["Linux","Mac","Windows"],"owner":"n.m.palmblad@lumc.nl","publication":[{"doi":"10.1021/acs.jproteome.6b00274","metadata":{"abstract":"\u00a9 2016 American Chemical Society.ProXL is a Web application and accompanying database designed for sharing, visualizing, and analyzing bottom-up protein cross-linking mass spectrometry data with an emphasis on structural analysis and quality control. ProXL is designed to be independent of any particular software pipeline. The import process is simplified by the use of the ProXL XML data format, which shields developers of data importers from the relative complexity of the relational database schema. The database and Web interfaces function equally well for any software pipeline and allow data from disparate pipelines to be merged and contrasted. ProXL includes robust public and private data sharing capabilities, including a project-based interface designed to ensure security and facilitate collaboration among multiple researchers. ProXL provides multiple interactive and highly dynamic data visualizations that facilitate structural-based analysis of the observed cross-links as well as quality control. ProXL is open-source, well-documented, and freely available at https://github.com/yeastrc/proxl-web-app.","authors":[{"name":"Davis T.N."},{"name":"Jaschob D."},{"name":"Riffle M."},{"name":"Zelter A."}],"citationCount":28,"date":"2016-08-05T00:00:00Z","journal":"Journal of Proteome Research","title":"ProXL (protein cross-linking database): A platform for analysis, visualization, and sharing of protein cross-linking mass spectrometry data"},"pmcid":"PMC4977572","pmid":"27302480","type":["Primary"]}],"topic":[{"term":"Protein interactions","uri":"http://edamontology.org/topic_0128"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"}],"validated":1},"bioschemas":{"name":"ProXL","home":"https://bio.tools/proxl","license":"Apache-2.0","summary":"Platform for the analysis, visualization and sharing of protein cross-linking mass spectrometry data","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:proxl/web/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free"