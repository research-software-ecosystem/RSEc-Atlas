{"tool_name":"rcellminer","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"rcellminer","home":"https://bioconductor.org/packages/rcellminer","license":"LGPL-3.0","summary":"The NCI-60 cancer cell line panel has been used over the course of several decades as an anti-cancer drug screen. This panel was developed as part of the Developmental Therapeutics Program (DTP, http://dtp.nci.nih.gov/) of the U.S. National Cancer Institute (NCI). Thousands of compounds have been tested on the NCI-60, which have been extensively characterized by many platforms for gene and protein expression, copy number, mutation, and others (Reinhold, et al., 2012). The purpose of the CellMiner project (http://discover.nci.nih.gov/ cellminer) has been to integrate data from multiple platforms used to analyze the NCI-60 and to provide a powerful suite of tools for exploration of NCI-60 data.","addition_date":"2017-01-17T14:56:45Z","last_update_date":"2022-04-11T07:51:47.524045Z","tool_type":["Command-line tool","Library"],"version":["2.34.0"],"collections":["BioConductor"],"biotools_curie":"biotools:rcellminer","credit":[{"name":"Augustin Luna"},{"name":"Fabricio Sousa"},{"name":"Vinodh Rajapakse"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/rcellminer"}],"edit_permission":{"authors":["doctorayobami"],"type":"group"},"function":[{"input":[{"data":{"term":"Compound name","uri":"http://edamontology.org/data_0990"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}],"operation":[{"term":"Data retrieval","uri":"http://edamontology.org/operation_2422"}],"output":[{"data":{"term":"Drug identifier","uri":"http://edamontology.org/data_0993"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]},{"data":{"term":"Drug name","uri":"http://edamontology.org/data_2899"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}]}],"name":"rcellminer","operati