{"tool_name":"micc","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"micc","home":"http://bioinfo.au.tsinghua.edu.cn/member/xwwang/MICCusage/","summary":"R package which provides methods to detect chromatin interactions from ChIA-PET data.","addition_date":"2017-08-03T18:49:29Z","last_update_date":"2024-11-25T14:26:09.362695Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:micc","credit":[{"email":"michael.zhang@utdallas.edu","name":"Zhang MQ","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"xwwang@tsinghua.edu.cn","name":"Wang X","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://bioinfo.au.tsinghua.edu.cn/"}],"documentation":[{"type":["General"],"url":"http://bioinfo.au.tsinghua.edu.cn/member/xwwang/MICCusage/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Nucleic acid structure analysis","uri":"http://edamontology.org/operation_2481"}]}],"name":"MICC","operating_system":["Linux","Mac","Windows"],"owner":"mbs_import","publication":[{"doi":"10.1093/bioinformatics/btv445","metadata":{"abstract":"ChIA-PET is rapidly emerging as an important experimental approach to detect chromatin long-range interactions at high resolution. Here, we present Model based Interaction Calling from ChIA-PET data (MICC), an easy-to-use R package to detect chromatin interactions from ChIA-PET sequencing data. By applying a Bayesian mixture model to systematically remove random ligation and random collision noise, MICC could identify chromatin interactions with a significantly higher sensitivity than existing methods at the same false discovery rate.","authors":[{"name":"He C."},{"name":"Wang X."},{"name":"Zhang M.Q."}],"citationCount":27,"date":"2015-06-18T00:00:00Z","journal":"Bioinformatics","title":"MICC: An R package for identifying chromatin interactions from ChIA-PET data"},"pmcid":"PMC4653385","pmid":"26231426"}],"topic":[{"term":"DNA structural variation","uri":"http://edamontol