{"tool_name":"desubs","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"desubs","home":"http://bioconductor.org/packages/DEsubs/","license":"GPL-3.0","summary":"A network-based systems biology package that extracts disease-perturbed subpathways within a pathway network as recorded by RNA-seq experiments. It contains framework covering a broad range of operation modes at all stages of the subpathway analysis, enabling a case-specific approach. The operation modes refer to the pathway network construction and processing, the subpathway extraction, visualization and enrichment analysis with regard to various biological and pharmacological features.","addition_date":"2017-07-21T16:28:34Z","last_update_date":"2024-11-25T13:49:10.543235Z","tool_type":["Command-line tool","Library"],"version":["1.2.0"],"accessibility":"Open access","biotools_curie":"biotools:desubs","cost":"Free of charge","credit":[{"email":"balomenos@upatras.gr","name":"Panos Balomenos","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"bezer@upatras.gr","name":"Anastasios Bezerianos","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/manuals/DEsubs/man/DEsubs.pdf"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Gene expression matrix","uri":"http://edamontology.org/data_3112"}}],"operation":[{"term":"Gene expression analysis","uri":"http://edamontology.org/operation_2495"},{"term":"Pathway or network analysis","uri":"http://edamontology.org/operation_2497"}],"output":[{"data":{"term":"Pathway or network","uri":"http://edamontology.org/data_2600"}},{"data":{"term":"Plot","uri":"http://edamontology.org/data_2884"}}]}],"maturity":"Mature","name":"DEsubs","operating_system":["Linux","Mac","Windows"],"owner":"balomenos","publication":[{"doi":"10.1093/bioinformatics/btw544","metadata":{"abstract":"DEsubs is a network-based systems biology R package that extracts disease-perturbed subpathways within a pathway network as recorded by RNA-seq experiments. It contains an extensive and customized framework with a broad range of operation modes at all stages of the subpathway analysis, enabling so a case-specific approach. The operation modes include pathway network construction and processing, subpathway extraction, visualization and enrichment analysis with regard to various biological and pharmacological features. Its capabilities render DEsubs a tool-guide for both the modeler and experimentalist for the identification of more robust systems-level drug targets and biomarkers for complex diseases.","authors":[{"name":"Balomenos P."},{"name":"Bezerianos A."},{"name":"Tsakalidis A.K."},{"name":"Vrahatis A.G."}],"citationCount":2,"date":"2016-12-15T00:00:00Z","journal":"Bioinformatics","title":"DeSUBS: An R package for flexible identification of differentially expressed subpathways using RNA-seq experiments"},"pmid":"27542770"}],"topic":[{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Systems biology","uri":"http://edamontology.org/topic_2259"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"DEsubs","home":"https://bio.tools/desubs","license":"GPL-3.0","version":"1.2.0","summary":"A network-based systems biology package that extracts disease-perturbed subpathways within a pathway network as recorded by RNA-seq experiments. It contains framework covering a broad range of operation modes at all stages of the subpathway analysis, enabling a case-specific approach. The operation modes refer to the pathway network construction and processing, the subpathway extraction, visualization and enrichment analysis with regard to various biological and pharmacological features.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:desubs:1.2.