{"tool_name":"lollipop","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"lollipop","version":"0.5.3","home":"https://github.com/cbg-ethz/LolliPop","license":"GNU General Public License v3 or later (GPLv3+)","summary":"A tool for Deconvolution for Wastewater Genomics","identifiers":["biotools:lollipop","doi:10.1101/2022.11.02.22281825"],"license_file":"LICENSE.md","build":{"noarch":"python","number":0,"run_exports":[null],"script":["-m pip install '.[cli]' --ignore-installed --no-deps -v","mkdir -p ${PREFIX}/share/LolliPop/{presets,examples}","cp -vr presets/*  ${PREFIX}/share/LolliPop/presets/","cp -vr *preprint*yaml ${PREFIX}/share/LolliPop/examples/"]},"requirements":{"host":["python >=3.10","pip","poetry-core >=1.0.8","poetry-dynamic-versioning"],"run":["python >=3.10","numpy","scipy","pandas","threadpoolctl","zstandard","ruamel.yaml >=0.18","strictyaml","tqdm","click","click-option-group","bcbio-gff"]},"source_url":"https://github.com/cbg-ethz/LolliPop/archive/v0.5.3.tar.gz","test":{"commands":["test \"$(lollipop --version|tee >(cat 1>&2)|grep -oE '[0-9]+(\\.[0-9a-z]+)*$')\" == \"0.5.3\"","lollipop generate-mutlist --help","lollipop getmutations from-basecount --help","lollipop deconvolute --help"],"imports":["lollipop"]},"recipe_maintainers":["DrYak"]},"biotools":{"id":"lollipop","home":"https://github.com/cbg-ethz/LolliPop","license":"GPL-3.0","summary":"Tool for Deconvolution for Wastewater Genomics - The LolliPop package comprises a python module and an optional set of command-line tools using it to build curves of viral variants over time  within environmental sample. It runs a  kernel-based deconvolution and leverages the time series nature of the samples.","addition_date":"2023-04-09T09:21:44.579279Z","last_update_date":"2024-11-24T14:49:45.535498Z","tool_type":["Command-line tool"],"collections":["COVID-19"],"biotools_curie":"biotools:lollipop","cost":"Free of charge","documentation":[{"type":["Quick start gui