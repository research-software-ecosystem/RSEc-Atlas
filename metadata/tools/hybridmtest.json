{"tool_name":"hybridmtest","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-hybridmtest","version":"1.54.0","home":"https://bioconductor.org/packages/3.22/bioc/html/HybridMTest.html","license":"GPL Version 2 or later","summary":"Hybrid Multiple Testing","identifiers":["biotools:hybridmtest","doi:10.1038/nmeth.3252"],"description":"Performs hybrid multiple testing that incorporates method selection and assumption evaluations into the analysis using empirical Bayes probability (EBP) estimates obtained by Grenander density estimation. For instance, for 3-group comparison analysis, Hybrid Multiple testing considers EBPs as weighted EBPs between F-test and H-test with EBPs from Shapiro Wilk test of normality as weigth. Instead of just using EBPs from F-test only or using H-test only, this methodology combines both types of EBPs through EBPs from Shapiro Wilk test of normality. This methodology uses then the law of total EBPs.","license_file":"/lib/R/share/licenses/GPL-3","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-biobase >=2.70.0,<2.71.0","r-base","r-fdrtool","r-mass","r-survival"],"run":["bioconductor-biobase >=2.70.0,<2.71.0","r-base","r-fdrtool","r-mass","r-survival"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/HybridMTest_1.54.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HybridMTest/HybridMTest_1.54.0.tar.gz","https://bioarchive.galaxyproject.org/HybridMTest_1.54.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-hybridmtest/bioconductor-hybridmtest_1.54.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('HybridMTest')\""]},"parent_recipe":{"name":"bioconductor-hybridmtest","path":"recipes/bioconductor-hybridmtest","version":"1.24.0"}},"biotools":{"id":"hybridmtest","home":"https://bioconductor.org/packages/HybridMTest","license":"GPL-2.0-or-later","summary":"Performs hybrid multiple testing that incorporates method selection and assumption evaluations into the analysis using empirical Bayes probability (EBP) estimates obtained by Grenander density estimation. For instance, for 3-group comparison analysis, Hybrid Multiple testing considers EBPs as weighted EBPs between F-test and H-test with EBPs from Shapiro Wilk test of normality as weigth. Instead of just using EBPs from F-test only or using H-test only, this methodology combines both types of EBPs through EBPs from Shapiro Wilk test of normality. This methodology uses then the law of total EBPs.","addition_date":"2017-01-17T15:03:21Z","last_update_date":"2024-11-25T16:06:38.219079Z","tool_type":["Command-line tool","Library"],"version":["1.56.0"],"collections":["BioConductor"],"biotools_curie":"biotools:hybridmtest","credit":[{"name":"Demba Fofana"},{"name":"Stan Pounds"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/HybridMTest"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Statistical calculation","uri":"http://edamontology.org/operation_2238"}]}],"name":"HybridMTest","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.18129/B9.bioc.HybridMTest"}],"topic":[{"term":"Experimental design and studies","uri":"http://edamontology.org/topic_3678"},{"term":"Statistics and probability","uri":"http://edamontology.org/topic_2269"}],"validated":1},"bioschemas":{"name":"HybridMTest","home":"https://bio.tools/hybridmtest","license":"GPL-2.0-or-later","version":"1.56.0","summary":"Performs hybrid multiple testing that incorporates method selection and assumption evaluations into the analysis using empirical Bayes probability (EBP) estimates obtained by Grenander density estimation. For instance, for 3-group comparison analysis, Hybrid Multiple testing considers EBPs as weighted EBPs between F-test and H-test with EBPs from Shapiro Wilk test of normality as weig