{"tool_name":"cammiq","contents":["biotools","oeb"],"identifiers":["biotools:cammiq"],"fetched_metadata":{"biotools":{"id":"cammiq","home":"https://github.com/algo-cancer/CAMMiQ","license":"MIT","summary":"CAMMiQ is a software tool for microbial identification and quantification. Specifically, it builds a compact index to manage a database of microbial genomes (in particular, bacterial/viral genomes in NCBI RefSeq database) and answers queries of the following form: given a set of high throughput sequencing (HTS) reads obtained from a mixture of genomes in the database, identify the corresponding genomes (in the database) and compute their relative abundance.","addition_date":"2021-01-18T09:35:45Z","last_update_date":"2026-11-12T14:22:09.405634Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:cammiq","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genome indexing","uri":"http://edamontology.org/operation_3211"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"},{"term":"k-mer counting","uri":"http://edamontology.org/operation_3472"}]}],"name":"CAMMiQ","owner":"Kigaard","publication":[{"doi":"10.1038/s41467-022-33869-7","type":["Primary"]},{"doi":"10.1101/2020.06.12.149245","type":["Preprint"]}],"topic":[{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Metatranscriptomics","uri":"http://edamontology.org/topic_3941"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:cammiq/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_sou