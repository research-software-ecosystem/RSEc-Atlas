{"tool_name":"bindflow","contents":["biotools"],"identifiers":["biotools:bindflow"],"fetched_metadata":{"biotools":{"id":"bindflow","home":"https://bindflow.readthedocs.io","summary":"BindFlow is a free, open-source Python pipeline for automated absolute binding free energy (ABFE) calculations using FEP or MM(PB/GB)SA, built on the GROMACS MD engine with built-in support for GAFF, OpenFF, Espaloma, and custom small-molecule force fields.","addition_date":"2026-11-04T09:52:36.940661Z","last_update_date":"2026-11-04T09:52:36.943048Z","biotools_curie":"biotools:bindflow","credit":[{"email":"alejandro.martinezleon@uni-saarland.de","name":"Alejandro Mart\u00ednez Le\u00f3n","orcidid":"https://orcid.org/0009-0005-6162-7303","typeEntity":"Person"},{"email":"jochen.hub@uni-saarland.de","name":"Jochen S. Hub","orcidid":"https://orcid.org/0000-0001-7716-1767","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Molecular dynamics","uri":"http://edamontology.org/operation_2476"},{"term":"Molecular surface calculation","uri":"http://edamontology.org/operation_0387"},{"term":"Protein solubility prediction","uri":"http://edamontology.org/operation_0409"}]}],"name":"BindFlow","owner":"pub2tools2024","publication":[{"doi":"10.1021/ACS.JCTC.5C02026","pmcid":"PMC12854747","pmid":"41498855"}],"topic":[{"term":"Computer science","uri":"http://edamontology.org/topic_3316"},{"term":"Molecular dynamics","uri":"http://edamontology.org/topic_0176"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}]}}}