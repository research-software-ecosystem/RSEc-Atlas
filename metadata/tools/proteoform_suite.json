{"tool_name":"proteoform_suite","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"proteoform_suite","home":"http://smith-chem-wisc.github.io/ProteoformSuite/","license":"GPL-3.0","summary":"Proteoform Analysis and Construction of Proteoform Families in Proteoform Suite.","addition_date":"2022-09-04T13:25:48.224731Z","last_update_date":"2024-11-24T15:43:12.324597Z","tool_type":["Desktop application"],"accessibility":"Open access","biotools_curie":"biotools:proteoform_suite","cost":"Free of charge","credit":[{"email":"smith@chem.wisc.edu","name":"Lloyd M. Smith","typeEntity":"Person"},{"name":"Leah V. Schaffer"},{"name":"Michael R. Shortreed"}],"documentation":[{"type":["Quick start guide"],"url":"https://www.youtube.com/watch?v=P17Y_aNYbAM&ab_channel=LMSResearchGroup"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"PTM identification","uri":"http://edamontology.org/operation_3645"},{"term":"PTM site prediction","uri":"http://edamontology.org/operation_0417"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"}]}],"name":"Proteoform Suite","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1007/978-1-0716-2325-1_7","metadata":{"abstract":"Proteoform Suite is an interactive software program for the identification and quantification of intact proteoforms from mass spectrometry data. Proteoform Suite identifies proteoforms observed by intact-mass (MS1) analysis. In intact-mass analysis, unfragmented experimental proteoforms are compared to a database of known proteoform sequences and to one another, searching for mass differences corresponding to well-known post-translational modifications or amino acids. Intact-mass analysis enables proteoforms observed in the MS1 data without MS/MS (MS2) fragmentation to be identified. Proteoform Suite further facilitates the construction and visualization of proteoform families, which are the sets of proteoforms derived from individual genes. Bottom-up peptide identifications and top-down (MS2) proteoform identifications can be integrated into the Proteoform Suite analysis to increase the sensitivity and accuracy of the analysis. Proteoform Suite is open source and freely available at https://github.com/smith-chem-wisc/proteoform-suite.","authors":[{"name":"Schaffer L.V."},{"name":"Shortreed M.R."},{"name":"Smith L.M."}],"date":"2022-01-01T00:00:00Z","journal":"Methods in Molecular Biology","title":"Proteoform Analysis and Construction of Proteoform Families in Proteoform Suite"},"pmcid":"PMC9694099","pmid":"35657588"}],"topic":[{"term":"Protein modifications","uri":"http://edamontology.org/topic_0601"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}],"validated":1},"bioschemas":{"name":"Proteoform Suite","home":"https://bio.tools/proteoform_suite","license":"GPL-3.0","summary":"Proteoform Analysis and Construction of Proteoform Families in Proteoform Suite.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:proteoform_suite/app/smith-chem-wisc.github.io","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":true,"registration":false},"packages":true,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1007/978-1-0716-2325-1_7","pmcid":"PMC9694099","pmid":"35657588","ref_count":17,"refs":[{"count":1,"year":"2003"},{"count":1,"year":"2010"},{