{"tool_name":"ison","contents":["biotools"],"identifiers":["biotools:ison"],"fetched_metadata":{"biotools":{"id":"ison","home":"https://github.com/Durenlab/ISON","summary":"ISON is a unified computational method designed for integrative spatial multi-omics analysis. It accurately predicts chromatin accessibility profiles and reconstructs spatially resolved gene regulatory networks by combining single-cell multiome data and spatial transcriptomics data.","addition_date":"2026-11-05T13:47:32.830053Z","last_update_date":"2026-11-05T13:47:32.833436Z","biotools_curie":"biotools:ison","credit":[{"email":"zduren@iu.edu","name":"Zhana Duren","orcidid":"https://orcid.org/0000-0003-4685-811X","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Gene expression profiling","uri":"http://edamontology.org/operation_0314"},{"term":"Gene regulatory network prediction","uri":"http://edamontology.org/operation_2437"},{"term":"Gene-set enrichment analysis","uri":"http://edamontology.org/operation_2436"}]}],"name":"ISON (Integrated Spatial Omics Network)","owner":"pub2tools2024","publication":[{"doi":"10.1038/S41467-026-73948-7","pmcid":"PMC13396193","pmid":"42243114"}],"topic":[{"term":"Chromosome conformation capture","uri":"http://edamontology.org/topic_3940"},{"term":"Epigenomics","uri":"http://edamontology.org/topic_3173"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Multiomics","uri":"http://edamontology.org/topic_4021"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}]}}}