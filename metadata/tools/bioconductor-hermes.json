{"tool_name":"bioconductor-hermes","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-hermes","home":"https://bioconductor.org/packages/hermes","license":"Apache-2.0","summary":"Provides classes and functions for quality control, filtering, normalization and differential expression analysis of pre-processed `RNA-seq` data. Data can be imported from `SummarizedExperiment` as well as `matrix` objects and can be annotated from `BioMart`. Filtering for genes without too low expression or containing required annotations, as well as filtering for samples with sufficient correlation to other samples or total number of reads is supported. The standard normalization methods including cpm, rpkm and tpm can be used, and 'DESeq2` as well as voom differential expression analyses are available.","addition_date":"2026-08-30T02:43:37.571335Z","last_update_date":"2026-08-30T02:43:37.574394Z","tool_type":["Command-line tool","Library"],"version":["1.16.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-hermes","credit":[{"name":"Alex Richardson","typeEntity":"Person","typeRole":["Developer"]},{"name":"Benoit Falquet","typeEntity":"Person","typeRole":["Developer"]},{"name":"Carolyn Zhang","typeEntity":"Person","typeRole":["Developer"]},{"name":"Chendi Liao","typeEntity":"Person","typeRole":["Developer"]},{"name":"Daniel Saban\u00e9s Bov\u00e9","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"F. Hoffmann-La Roche AG","typeEntity":"Funding agency","typeRole":["Contributor"]},{"name":"Haocheng Li","typeEntity":"Person","typeRole":["Developer"]},{"name":"Jeff Luong","typeEntity":"Person","typeRole":["Developer"]},{"name":"Joseph N. Paulson","typeEntity":"Person","typeRole":["Developer"]},{"name":"Lyndsee Midori Zhang","typeEntity":"Person","typeRole":["Developer"]},{"name":"Mark Yan","typeEntity":"Person","typeRole":["Developer"]},{"name":"Namrata Bhatia","typeEntity":"Person","typeRole":["Developer"]}