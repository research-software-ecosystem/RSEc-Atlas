{"tool_name":"aldex2","contents":["galaxy","bioschemas","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"bioconductor-aldex2","version":"1.42.0","home":"https://bioconductor.org/packages/3.22/bioc/html/ALDEx2.html","license":"GPL (>=3)","summary":"Analysis Of Differential Abundance Taking Sample and Scale Variation Into Account","identifiers":["biotools:aldex2"],"description":"A differential abundance analysis for the comparison of two or more conditions. Useful for analyzing data from standard RNA-seq or meta-RNA-seq assays as well as selected and unselected values from in-vitro sequence selections. Uses a Dirichlet-multinomial model to infer abundance from counts, optimized for three or more experimental replicates. The method infers biological and sampling variation to calculate the expected false discovery rate, given the variation, based on a Wilcoxon Rank Sum test and Welch's t-test (via aldex.ttest), a Kruskal-Wallis test (via aldex.kw), a generalized linear model (via aldex.glm), or a correlation test (via aldex.corr). All tests report predicted p-values and posterior Benjamini-Hochberg corrected p-values. ALDEx2 also calculates expected standardized effect sizes for paired or unpaired study designs. ALDEx2 can now be used to estimate the effect of scale on the results and report on the scale-dependent robustness of results.","license_file":"/lib/R/share/licenses/GPL-3","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-biocparallel >=1.44.0,<1.45.0","bioconductor-genomicranges >=1.62.0,<1.63.0","bioconductor-iranges >=2.44.0,<2.45.0","bioconductor-multtest >=2.66.0,<2.67.0","bioconductor-s4vectors >=0.48.0,<0.49.0","bioconductor-summarizedexperiment >=1.40.0,<1.41.0","r-base","r-directlabels","r-lattice","r-latticeextra","r-rfast","r-zcompositions"],"run":["bioconductor-biocparallel >=1.44.0,<1.45.0","bioconductor-genomicranges >=1.62.0,<1.63.0","bioconductor-iranges >=2.44.0,<2.45.0","bioconductor-multtest >=2.66.0,<2.67.0","bioconductor-s4vectors >=0.48.0,<0.49.0","bioconductor-summarizedexperiment >=1.40.0,<1.41.0","r-base","r-directlabels","r-lattice","r-latticeextra","r-rfast","r-zcompositions"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/ALDEx2_1.42.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ALDEx2/ALDEx2_1.42.0.tar.gz","https://bioarchive.galaxyproject.org/ALDEx2_1.42.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-aldex2/bioconductor-aldex2_1.42.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('ALDEx2')\""]},"parent_recipe":{"name":"bioconductor-aldex2","path":"recipes/bioconductor-aldex2","version":"1.12.0"}},"biotools":{"id":"aldex2","home":"https://bioconductor.org/packages/ALDEx2","license":"GPL-3.0","summary":"A differential abundance analysis for the comparison of two or more conditions. Useful for analyzing data from standard RNA-seq or meta-RNA-seq assays as well as selected and unselected values from in-vitro sequence selections. Uses a Dirichlet-multinomial model to infer abundance from counts, optimized for three or more experimental replicates. The method infers biological and sampling variation to calculate the expected false discovery rate, given the variation, based on a Wilcoxon Rank Sum test and Welch's t-test (via aldex.ttest), a Kruskal-Wallis test (via aldex.kw), a generalized linear model (via aldex.glm), or a correlation test (via aldex.corr). All tests report predicted p-values and posterior Benjamini-Hochberg corrected p-values. ALDEx2 also calculates expected standardized effect sizes for paired or unpaired study designs. ALDEx2 can now be used to estimate the effect of scale on the results and report on the scale-dependent robustness of results.","addition_date":"2017-01-17T14:55:00Z","last_update_date":"2026-09-01T06:30:20.601210Z","tool_type":["Command-line tool","Library"],"version":["1.44.0"],"collections":["BioConductor"],"biotools_curie":"biotools:aldex2","credit":[{"name":"Andrew Fernandes"},{"name":"Arianne Albert"},{"name":"Brandon Lieng"},{"name":"Greg Gloor"},{"name":"Jean Macklaim"},{"name":"Jia Rong Wu"},{"name":"Matt Links"},{"name":"Michelle Nixon"},{"name":"Ruth Grace Wong"},{"name":"Thomas Quinn"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/ALDEx2"}],"edit_permission":{"authors":["ELIXIR-CZ"],"type":"group"},"function":[{"input":[{"data":{"term":"Gene expression profile","uri":"http://edamontology.org/data_0928"},"format":[{"term":"Gene expression report format","uri":"http://edamontology.org/format_2058"}]}],"operation":[{"term":"Statistical inference","uri":"http://edamontology.org/operation_3658"}],"output":[{"data":{"term":"Statistical estimate score","uri":"http://edamontology.org/data_0951"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}]}],"name":"ALDEx2","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1080/10618600.2015.1131161"},{"doi":"10.1186/2049-2618-2-15"},{"doi":"10.1371/journal.pone.0067019"}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Statistics and probability","uri":"http://edamontology.org/topic_2269"}],"validated":1},"bioschemas":{"name":"ALDEx2","home":"https://bio.tools/aldex2","license":"GPL-3.0-only","version":"1.44.0","summary":"A differential abundance analysis for the comparison of two or more conditions. Useful for analyzing data from standard RNA-seq or meta-RNA-seq assays as well as selected and unselected values from in-vitro sequence selections. Uses a Dirichlet-multinomial model to infer abundance from counts, optimized for three or more experimental replicates. The method infers biological and sampling variation to calculate the expected false discovery rate, given the variation, based on a Wilcoxon Rank Sum test and Welch's t-test (via aldex.ttest), a Kruskal-Wallis test (via aldex.kw), a generalized linear model (via aldex.glm), or a correlation test (via aldex.corr). All tests report predicted p-values and posterior Benjamini-Hochberg corrected p-values. ALDEx2 also calculates expected standardized effect sizes for paired or unpaired study designs. ALDEx2 can now be used to estimate the effect of scale on the results and report on the scale-dependent robustness of results.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"1.26.0","first_commit":"2022-06-29","conda_name":"bioconductor-aldex2","conda_version":"1.42.0","summary":"Performs analysis Of differential abundance taking sample variation into account","edam_operations":["Statistical inference"],"edam_topics":["Gene expression","Statistics and probability"],"toolshed_categories":["Metagenomics"],"toolshed_id":"aldex2","users_5_years":64,"users_all_time":64,"usage_5_years":356,"usage_all_time":356,"bio_tools_summary":"A differential abundance analysis for the comparison of two or more conditions. It uses a Dirichlet-multinomial model to infer abundance from counts, that has been optimized for three or more experimental replicates. Infers sampling variation and calculates the expected FDR given the biological and sampling variation using the Wilcox rank test and Welches t-test, or the glm and Kruskal Wallis tests. Reports both P and fdr values calculated by the Benjamini Hochberg correction.","bio_tools_ids":"aldex2","bio_tools_name":"ALDEx2","related_tutorials":[],"related_workflows":[],"tool_ids":["aldex2"],"tool_output_formats":["tabular","png","pdf"],"homepage":"https://github.com/ggloor/ALDEx_bioc","suite_source":"https://github.com/galaxyproject/tools-iuc/tree/main/tools/aldex2","suite_owner":"iuc","suite_parsed_folder":"https://github.com/galaxyproject/tools-iuc/tree/master/tools/aldex2","suite_version_status":"To update","no_of_tools":{"eu":1,"org":0,"org.au":0,"be":0,"cz":1,"fr":0,"no":0,"apostl":0,"cirm_cfbp":0,"chemflow":0,"coloc_stat