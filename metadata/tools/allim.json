{"tool_name":"allim","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"allim","home":"https://code.google.com/p/allim/","license":"MPL-1.1","summary":"The Allelic imbalance meter tool offers an integrated and user-friendly solution for measuring allele specific gene expression (ASE) within species.","addition_date":"2017-08-03T18:36:14Z","last_update_date":"2024-11-24T21:04:48.131057Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:allim","cost":"Free of charge","credit":[{"email":"christian.schloetterer@vetmeduni.ac.at","name":"Christian Schl\u00f6tterer","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"ramvinay.pandey@vetmeduni.ac.at","name":"Ram Vinay Pandey","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"susanne.franssen@vetmeduni.ac.at","name":"Susanne U. Franssen","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://sourceforge.net/projects/allim/"},{"type":["User manual"],"url":"https://code.google.com/archive/p/allim/wikis/Manual.wiki"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene expression analysis","uri":"http://edamontology.org/operation_2495"}]}],"maturity":"Mature","name":"Allim","operating_system":["Linux","Mac"],"owner":"mbs_import","publication":[{"doi":"10.1111/1755-0998.12110","metadata":{"abstract":"Estimating differences in gene expression among alleles is of high interest for many areas in biology and medicine. Here, we present a user-friendly software tool, Allim, to estimate allele-specific gene expression. Because mapping bias is a major problem for reliable estimates of allele-specific gene expression using RNA-seq, Allim combines two different strategies to account for the mapping biases. In order to reduce the mapping bias, Allim first generates a polymorphism-aware reference genome that accounts for the sequence variation between the alleles. Then, a sequence-specific simulation tool estimates the residual mapping bias. Statistical tests for allelic imbalance are provided that can be used with the bias corrected RNA-seq data. \u00a9 2013 John Wiley & Sons Ltd.","authors":[{"name":"Franssen S.U."},{"name":"Futschik A."},{"name":"Pandey R.V."},{"name":"Schlotterer C."}],"citationCount":27,"date":"2013-07-01T00:00:00Z","journal":"Molecular Ecology Resources","title":"Allelic imbalance metre (Allim), a new tool for measuring allele-specific gene expression with RNA-seq data"},"pmcid":"PMC3739924","pmid":"23615333","type":["Primary"]}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Genetics","uri":"http://edamontology.org/topic_3053"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"}],"validated":1},"bioschemas":{"name":"Allim","home":"https://bio.tools/allim","license":"MPL-1.1","summary":"The Allelic imbalance meter tool offers an integrated and user-friendly solution for measuring allele specific gene expression (ASE) within species.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:allim/cmd/code.google.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"general":true,"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":23,"citations":[{"count":1,"year":"2013"},{"count":1,"year":"2018"},{"count":1,"year":"2020"},{"count":1,"year":"2023"},{"count":2,"year":"2017"},{"count":2,"year":"2019"},{"count":2,"year":"2025"},{"count":2,"year":"2026"},{"count":3,"year":"2014"},{"count":4,"year":"2015"},{"count":4,"year":"2021"}],"doi":"10.1111/1755-0998.12110","pmcid":"PMC3739924","pmid":"23615333","ref_count":18,"refs":[{"count":1,"year":"1995"},{"count":2,"year":"2009"},{"count":3,"year