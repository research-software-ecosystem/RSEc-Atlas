{"tool_name":"seqbias","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"seqbias","home":"http://bioconductor.org/packages/release/bioc/html/seqbias.html","license":"GPL-3.0","summary":"This package implements a model of per-position sequencing bias in high-throughput sequencing data using a simple Bayesian network, the structure and parameters of which are trained on a set of aligned reads and a reference genome sequence.","addition_date":"2017-01-17T15:06:05Z","last_update_date":"2018-12-30T16:40:21Z","tool_type":["Command-line tool","Library"],"version":["1.22.0"],"collections":["BioConductor"],"biotools_curie":"biotools:seqbias","credit":[{"email":"dcjones@cs.washington.edu","name":"Daniel Jones","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/html/seqbias.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Sequence analysis","uri":"http://edamontology.org/operation_2403"}]}],"name":"seqbias","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1093/bioinformatics/bts055","metadata":{"abstract":"Motivation: Quantification of sequence abundance in RNA-Seq experiments is often conflated by protocol-specific sequence bias. The exact sources of the bias are unknown, but may be influenced by polymerase chain reaction amplification, or differing primer affinities and mixtures, for example. The result is decreased accuracy in many applications, such as de novo gene annotation and transcript quantification. Results: We present a new method to measure and correct for these influences using a simple graphical model. Our model does not rely on existing gene annotations, and model selection is performed automatically making it applicable with few assumptions. We evaluate our method on several datasets, and by multiple criteria, demonstrating that it effectively decreases bias and increases uniformity. Additionally, we provide theoretical and empirical results showing that the method is unlikely to have any effect on unbiased data, suggesting it can be applied with little risk of spurious adjustment. \u00a9 The Author(s) 2012. Published by Oxford University Press.","authors":[{"name":"Jones D.C."},{"name":"Katze M.G."},{"name":"Peng X."},{"name":"Ruzzo W.L."}],"citationCount":17,"date":"2012-04-01T00:00:00Z","journal":"Bioinformatics","title":"A new approach to bias correction in RNA-Seq"},"pmcid":"PMC3315719","pmid":"22285831","type":["Primary"]}],"topic":[{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"bioschemas":{"name":"seqbias","home":"https://bio.tools/seqbias","license":"GPL-3.0","version":"1.22.0","summary":"This package implements a model of per-position sequencing bias in high-throughput sequencing data using a simple Bayesian network, the structure and parameters of which are trained on a set of aligned reads and a reference genome sequence.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:seqbias:1.22.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":17,"citations":[{"count":1,"year":"2020"},{"count":1,"year":"2023"},{"count":1,"year":"2024"},{"count":2,"year":"2013"},{"count":2,"year":"2021"},{"count":3,"year":"2014"},{"count":3,"year":"2015"},{"count":4,"year":"2017"}],"doi":"10.1093/bioinformatics/bts055","pmcid":"PMC3315719","pmid":"22285831","ref_count":24,"refs":[{"count":1,"year":"2000"},{"count":1,"year":"2003"},{"count":1,"year":"2004"},{"count":1,"year":"2007"},{"count":1,"year":"2009"},{"count":2,"year":"2005"},{"count":2,"