{"tool_name":"arnaque","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"arnaque","home":"https://github.com/strevol-mpi-mis/aRNAque","license":"GPL-3.0","summary":"An evolutionary algorithm for inverse pseudoknotted RNA folding inspired by L\u00e9vy flights.","addition_date":"2022-10-05T17:51:16.766378Z","last_update_date":"2024-11-24T15:30:24.509671Z","tool_type":["Command-line tool","Script"],"biotools_curie":"biotools:arnaque","credit":[{"email":"nonosaha@mis.mpg.de","name":"Nono S. C. Merleau","orcidid":"https://orcid.org/0000-0003-3150-6250","typeEntity":"Person"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"RNA inverse folding","uri":"http://edamontology.org/operation_0483"},{"term":"RNA secondary structure prediction","uri":"http://edamontology.org/operation_0278"},{"term":"Structure visualisation","uri":"http://edamontology.org/operation_0570"}]}],"name":"aRNAque","operating_system":["Mac"],"owner":"Chan019","publication":[{"doi":"10.1186/s12859-022-04866-w","metadata":{"abstract":"Background: We study in this work the inverse folding problem for RNA, which is the discovery of sequences that fold into given target secondary structures. Results: We implement a L\u00e9vy mutation scheme in an updated version of aRNAque an evolutionary inverse folding algorithm and apply it to the design of RNAs with and without pseudoknots. We find that the L\u00e9vy mutation scheme increases the diversity of designed RNA sequences and reduces the average number of evaluations of the evolutionary algorithm. Compared to antaRNA, aRNAque CPU time is higher but more successful in finding designed sequences that fold correctly into the target structures. Conclusion: We propose that a L\u00e9vy flight offers a better standard mutation scheme for optimizing RNA design. Our new version of aRNAque is available on GitHub as a python script and the benchmark results show improved performance on both Pseudobase++ and the Eterna100 datasets, compared to existing inverse folding tools.","authors":[{"name":"Merleau N.S.C."},{"name":"Smerlak M."}],"citationCount":5,"date":"2022-12-01T00:00:00Z","journal":"BMC Bioinformatics","title":"aRNAque: an evolutionary algorithm for inverse pseudoknotted RNA folding inspired by L\u00e9vy flights"},"pmcid":"PMC9375295","pmid":"35964008"}],"topic":[{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"RNA","uri":"http://edamontology.org/topic_0099"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"bioschemas":{"name":"aRNAque","home":"https://bio.tools/arnaque","license":"GPL-3.0","summary":"An evolutionary algorithm for inverse pseudoknotted RNA folding inspired by L\u00e9vy flights.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:arnaque/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":5,"citations":[{"count":1,"year":"2026"},{"count":4,"year":"2025"}],"doi":"10.1186/s12859-022-04866-w","pmcid":"PMC9375295","pmid":"35964008","ref_count":36,"refs":[{"count":1,"year":"1999"},{"count":1,"year":"2000"},{"count":1,"year":"2005"},{"count":1,"year":"2012"},{"count":1,"year":"2017"},{"count":1,"year":"2021"},{"count":1,"year":"2022"},{"count":2,"year":"1976"},{"count":2,"year":"2006"},{"count":2,"year":"2009"},{"count":2,"year":"2011"},{"count":2,"year":"2014"},{"count":2,"year":"2015"},{"count":2,"year":"2016"},{"count":2,"year":"2018"},{"count":3,"year":"2004"},{"count":3,"year":"2008"},{"count":3,"year":"2013"},{"count":4,"year":"2010"}],"title":"aRNAque: an evolutionary algorithm for inverse pseudoknotted RNA folding inspired by L\u00e9vy flights.","year":2022}]}],"summary":{"description":