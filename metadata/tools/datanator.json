{"tool_name":"datanator","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"datanator","home":"https://www.datanator.info","license":"MIT","summary":"Datanator is an integrated database of genomic and biochemical data designed to help investigators find data about specific molecules and reactions in specific organisms and specific environments for meta-analyses and mechanistic models. Datanator currently includes metabolite concentrations, RNA modifications and half-lives, protein abundances and modifications, and reaction kinetics integrated from several databases and numerous publications. The Datanator website and REST API provide tools for extracting clouds of data about specific molecules and reactions in specific organisms and specific environments, as well as data about similar molecules and reactions in taxonomically similar organisms.","addition_date":"2020-05-22T02:53:39Z","last_update_date":"2020-09-23T19:35:26Z","tool_type":["Database portal","Web API"],"version":["2020.08.03"],"accessibility":"Open access","biotools_curie":"biotools:datanator","cost":"Free of charge","credit":[{"email":"zhouyang.lian@familian.life","name":"Zhouyang Lian","orcidid":"https://orcid.org/0000-0003-2698-4071","typeEntity":"Person","typeRole":["Developer"]},{"email":"bilalshaikh42@gmail.com","name":"Bilal Shaikh","orcidid":"http://orcid.org/0000-0001-5801-5510","typeEntity":"Person","typeRole":["Developer"],"url":"https://www.bshaikh.com/"},{"email":"karr@mssm.edu","name":"Jonathan Karr","orcidid":"https://orcid.org/0000-0002-2605-5080","typeEntity":"Person","typeRole":["Primary contact"],"url":"https://www.karrlab.org"},{"email":"yosef.roth@icahn.mssm.edu","name":"Yosef Roth","typeEntity":"Person","typeRole":["Developer"]},{"email":"saahith116@gmail.com","name":"Saahith Pochiraju","typeEntity":"Person","typeRole":["Developer"],"url":"http://saahith.com/"}],"documentation":[{"type":["API documentation"],"url":"https://api.datanator.info"},{"type":