{"tool_name":"cellphy","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"cellphy","home":"https://github.com/amkozlov/cellphy","license":"AGPL-3.0","summary":"CellPhy: accurate and fast probabilistic inference of single-cell phylogenies.","addition_date":"2022-06-10T14:09:50.491731Z","last_update_date":"2022-06-10T14:09:50.494225Z","tool_type":["Command-line tool","Workbench","Workflow"],"accessibility":"Open access","biotools_curie":"biotools:cellphy","cost":"Free of charge","credit":[{"email":"dposada@uvigo.es","name":"David Posada","orcidid":"https://orcid.org/0000-0003-1407-3406","typeEntity":"Person"}],"documentation":[{"type":["Training material"],"url":"https://github.com/amkozlov/cellphy/blob/master/doc/CellPhy-Tutorial.pdf"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Deposition","uri":"http://edamontology.org/operation_3431"},{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Phylogenetic inference","uri":"http://edamontology.org/operation_0323"},{"term":"Phylogenetic tree visualisation","uri":"http://edamontology.org/operation_0567"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"}]}],"name":"CellPhy","operating_system":["Linux","Mac"],"owner":"Chan019","publication":[{"doi":"10.1186/S13059-021-02583-W","metadata":{"abstract":"\u00a9 2022, The Author(s).We introduce CellPhy, a maximum likelihood framework for inferring phylogenetic trees from somatic single-cell single-nucleotide variants. CellPhy leverages a finite-site Markov genotype model with 16 diploid states and considers amplification error and allelic dropout. We implement CellPhy into RAxML-NG, a widely used phylogenetic inference package that provides statistical confidence measurements and scales well on large datasets with hundreds or thousands of cells. Comprehensive simulations suggest that CellPhy is more robust to single-cell genomics errors and outperforms state-of-the-art methods under realistic scenarios, both in accuracy and speed. CellPhy is freely available at https://github.com/amkozlov/cellphy.","authors":[{"name":"Alves J.M."},{"name":"Kozlov A."},{"name":"Posada D."},{"name":"Stamatakis A."}],"date":"2022-12-01T00:00:00Z","journal":"Genome Biology","title":"CellPhy: accurate and fast probabilistic inference of single-cell phylogenies from scDNA-seq data"},"pmcid":"PMC8790911","pmid":"35081992"}],"topic":[{"term":"Ecology","uri":"http://edamontology.org/topic_0610"},{"term":"Exome sequencing","uri":"http://edamontology.org/topic_3676"},{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Phylogeny","uri":"http://edamontology.org/topic_0084"}],"validated":1},"bioschemas":{"name":"CellPhy","home":"https://bio.tools/cellphy","license":"AGPL-3.0","summary":"CellPhy: accurate and fast probabilistic inference of single-cell phylogenies.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:cellphy/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"training_material":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":46,"citations":[{"count":8,"year":"2023"},{"count":8,"year":"2025"},{"count":9,"year":"2024"},{"count":10,"year":"2022"},{"count":11,"year":"2026"}],"doi":"10.1186/s13059-021-02583-w","pmcid":"PMC8790911","pmid":"35081992","ref_count":82,"refs":[{"count":1,"year":"-1"},{"count":1,"year":"1969"},{"count":1,"year":"1981"},{"count":1,"year":"1985"},{"count":1,"