{"tool_name":"sistema","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"sistema","home":"http://sistema.ens-lyon.fr","license":"Not licensed","summary":"A large and standardized collection of transcriptome data sets for human pluripotent stem cell research.","addition_date":"2021-11-20T21:36:41.637558Z","last_update_date":"2021-11-20T21:40:09.690425Z","tool_type":["Database portal","Web application"],"accessibility":"Open access","biotools_curie":"biotools:sistema","cost":"Free of charge","credit":[{"email":"cmartinat@istem.fr","name":"C\u00e9cile Martinat","typeEntity":"Person"},{"name":"Didier Auboeuf"},{"name":"Margot Jarrige"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Deposition","uri":"http://edamontology.org/operation_3431"},{"term":"Gene expression profiling","uri":"http://edamontology.org/operation_0314"},{"term":"RNA-Seq quantification","uri":"http://edamontology.org/operation_3800"}]}],"name":"SISTEMA","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1016/J.ISCI.2021.102767","metadata":{"abstract":"\u00a9 2021 The AuthorsHuman pluripotent stem cells have ushered in an exciting new era for disease modeling, drug discovery, and cell therapy development. Continued progress toward realizing the potential of human pluripotent stem cells will be facilitated by robust data sets and complementary resources that are easily accessed and interrogated by the stem cell community. In this context, we present SISTEMA, a quality-controlled curated gene expression database, built on a valuable catalog of human pluripotent stem cell lines, and their derivatives for which transcriptomic analyses have been generated using a single experimental pipeline. SISTEMA functions as a one-step resource that will assist the stem cell community to easily evaluate the expression level for genes of interest, while comparing them across different hPSC lines, cell types, pathological conditions, or after pharmacological treatments.","authors":[{"name":"Auboeuf D."},{"name":"Carteron A."},{"name":"Janczarski S."},{"name":"Jarrige M."},{"name":"Martinat C."},{"name":"Peschanski M."},{"name":"Polveche H."}],"date":"2021-07-23T00:00:00Z","journal":"iScience","title":"SISTEMA: A large and standardized collection of transcriptome data sets for human pluripotent stem cell research"},"pmcid":"PMC8271161","pmid":"34278269"}],"topic":[{"term":"Drug discovery","uri":"http://edamontology.org/topic_3336"},{"term":"Pathology","uri":"http://edamontology.org/topic_0634"},{"term":"Pharmacology","uri":"http://edamontology.org/topic_0202"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Regenerative medicine","uri":"http://edamontology.org/topic_3395"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"SISTEMA","home":"https://bio.tools/sistema","license":"Not licensed","summary":"A large and standardized collection of transcriptome data sets for human pluripotent stem cell research.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:sistema/db/sistema.ens-lyon.fr","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":2,"citations":[{"count":1,"year":"2021"},{"count":1,"year":"2024"}],"doi":"10.1016/j.isci.2021.102767","pmcid":"PMC8271161","pmid":"34278269","ref_count":44,"refs":[{"count":1,"year":"1995"},{"count":1,"year":"1998"},{"count":1,"year":"2001"},{"count":1,"year":"2003"},{"count":1,"year":"2004"},{"count":1,"year":"2005"},{"count":1,"year":"2008"},{"count":1,"year":"2012"},{"count":1,"year":"2020"},{"count":2,"year":"2010"},{"count":2,"year":"2011"},{"count":2,"year":"2013"},{"count":3,"year":"2007"},{"count":3,"year":"2009"},{"count":3