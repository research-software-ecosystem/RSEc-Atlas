{"tool_name":"ev-net","contents":["biotools"],"identifiers":["biotools:ev-net"],"fetched_metadata":{"biotools":{"id":"ev-net","home":"https://torrejonia.github.io/EV-Net/","summary":"EV-Net is a bioinformatics tool designed to model cell-to-cell communication mediated by extracellular vesicles (EVs). It processes EV omics data (proteomics and RNA-seq) to prioritize functional cargo molecules in specific recipient tissues.","addition_date":"2026-11-04T17:35:44.276155Z","last_update_date":"2026-11-04T17:35:44.278672Z","biotools_curie":"biotools:ev-net","edit_permission":{"type":"private"},"name":"EV-Net","owner":"pub2tools2024","publication":[{"doi":"10.64898/2026.04.02.716053"}],"topic":[{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"},{"term":"Pathology","uri":"http://edamontology.org/topic_0634"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}]}}}