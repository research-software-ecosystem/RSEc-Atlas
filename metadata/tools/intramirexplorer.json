{"tool_name":"intramirexplorer","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"intramirexplorer","home":"https://bioconductor.org/packages/IntramiRExploreR","license":"GPL-2.0","summary":"Intra-miR-ExploreR, an integrative miRNA target prediction bioinformatics tool, identifies targets combining expression and biophysical interactions of a given microRNA (miR). Using the tool, we have identified targets for 92 intragenic miRs in D. melanogaster, using available microarray expression data, from Affymetrix 1 and Affymetrix2 microarray array platforms, providing a global perspective of intragenic miR targets in Drosophila. Predicted targets are grouped according to biological functions using the DAVID Gene Ontology tool and are ranked based on a biologically relevant scoring system, enabling the user to identify functionally relevant targets for a given miR.","addition_date":"2018-07-10T11:20:19Z","last_update_date":"2018-12-10T12:59:00Z","tool_type":["Library"],"version":["1.34.0"],"collections":["BioConductor"],"biotools_curie":"biotools:intramirexplorer","credit":[{"name":"Surajit Bhattacharya and Daniel Cox"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/IntramiRExploreR"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene prediction","uri":"http://edamontology.org/operation_2454"}]}],"name":"IntramiRExploreR","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[{"doi":"10.18129/B9.bioc.IntramiRExploreR"}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Microarray experiment","uri":"http://edamontology.org/topic_3518"},{"term":"Statistics and probability","uri":"http://edamontology.org/topic_2269"}],"validated":1},"bioschemas":{"name":"IntramiRExploreR","home":"https://bio.tools/intramirexplorer","license":"GPL-2.0-only","version":"1.34.0","summary":"Intra-miR-ExploreR, an integrative miRNA target predict