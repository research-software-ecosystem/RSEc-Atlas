mics and RNA-Seq data. This software automates the de novo transcript assembly based on RNA-Seq data, construction of a protein reference database based on the de novo assembled transcripts, peptide identification, function analysis, and HTML-based report generation. Different function components are integrated using Docker technology. The Docker image of PPIP is available at https://hub.docker.com/r/shawndp/ppip, and the source code under GPL-3 license is available at https://github.com/Shawn-Xu/PPIP. A user manual of PPIP is available at https://shawn-xu.github.io/PPIP.","authors":[{"name":"Liao Q."},{"name":"Liu Z."},{"name":"Rong M."},{"name":"Xu S."},{"name":"Zeng Y."},{"name":"Zhou B."},{"name":"Zhou R."}],"citationCount":2,"date":"2019-02-01T00:00:00Z","journal":"Journal of Proteome Research","title":"PPIP: Automated Software for Identification of Bioactive Endogenous Peptides"},"pmid":"30540478","type":["Primary"]}],"topic":[{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"}],"validated":1},"bioschemas":{"name":"PPIP","home":"https://bio.tools/ppip","license":"GPL-3.0","summary":"An automated software for identification of bioactive endogenous peptides","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ppip/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":2,"citations":[{"count":1,"year":"2019"},{"count":1,"year":"2025"}],"doi":"10.1021/acs.jproteome.8b00718","pmid":"30540478","ref_count":0,"refs":[],"title":"PPIP: 