{"tool_name":"bioconductor-geometrid","contents":["biotools","oeb"],"fetched_metadata":{"biotools":{"id":"bioconductor-geometrid","home":"https://bioconductor.org/packages/InPAS","license":"GPL-2.0-or-later","summary":"The geomeTriD (Three-Dimensional Geometry) Package provides interactive 3D visualization of chromatin structures using the WebGL-based 'three.js' (https://threejs.org/) or the rgl rendering library. It is designed to identify and explore spatial chromatin patterns within genomic regions. The package generates dynamic 3D plots and HTML widgets that integrate seamlessly with Shiny applications, enabling researchers to visualize chromatin organization, detect spatial features, and compare structural dynamics across different conditions and data types.","addition_date":"2026-08-31T21:25:48.038623Z","last_update_date":"2026-10-02T15:53:50.066469Z","tool_type":["Command-line tool","Library"],"version":["2.20.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-geometrid","credit":[{"name":"Haibo Liu","typeEntity":"Person","typeRole":["Developer"]},{"name":"Jianhong Ou","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Lihua Julie Zhu","typeEntity":"Person","typeRole":["Developer"]},{"name":"Michael R. Green","typeEntity":"Person","typeRole":["Developer"]},{"name":"Sungmi M. Park","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/InPAS"}],"edit_permission":{"type":"private"},"name":"geomeTriD","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.31083/j.fbs1604021"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:bioconductor-geometrid:1.6.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","project":{"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1093/bioadv/vbaf299","pmcid":"PMC1