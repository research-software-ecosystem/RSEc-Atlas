{"tool_name":"pegit","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"pegit","home":"https://pegit.giehmlab.dk","license":"Not licensed","summary":"pegIT facilitates rapid and effective design of pegRNAs for prime editing based on simple inputs.","addition_date":"2021-10-28T19:43:30.935925Z","last_update_date":"2021-10-28T19:46:20.315252Z","tool_type":["Command-line tool","Web application"],"accessibility":"Open access","biotools_curie":"biotools:pegit","cost":"Free of charge","credit":[{"email":"giehm@biomed.au.dk","name":"Jacob Giehm Mikkelsen","orcidid":"https://orcid.org/0000-0002-1322-3209","typeEntity":"Person"},{"email":"madsanderson@gmail.com","name":"Mads Valdemar Anderson","orcidid":"https://orcid.org/0000-0002-6217-1353","typeEntity":"Person"},{"name":"Emil Aagaard Thomsen"},{"name":"Jakob Haldrup"},{"name":"Jonas Holst Wolff"}],"documentation":[{"type":["User manual"],"url":"https://pegit.giehmlab.dk/instructions"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Organism name","uri":"http://edamontology.org/data_2909"}},{"data":{"term":"Nucleic acid sequence","uri":"http://edamontology.org/data_2977"},"format":[{"term":"Alignment format (text)","uri":"http://edamontology.org/format_2554"}]}],"operation":[{"term":"Backbone modelling","uri":"http://edamontology.org/operation_0479"},{"term":"Data retrieval","uri":"http://edamontology.org/operation_2422"},{"term":"Editing","uri":"http://edamontology.org/operation_3096"},{"term":"PCR primer design","uri":"http://edamontology.org/operation_0308"}]}],"name":"pegIT","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1093/NAR/GKAB427","metadata":{"abstract":"\u00a9 2021 The Author(s) 2021. Published by Oxford University Press on behalf of Nucleic Acids Research.Prime editing (PE) is a novel CRISPR-derived genome editing technique facilitating precision editing without double-stranded DNA breaks. PE, mediated by a Cas9-reverse transcriptase fusion protein, is based on dual-functioning prime editing guide RNAs (pegRNAs), serving both as guide molecules and as templates carrying the desired edits. Due to such diverse functions, manual pegRNA design is a subject to error and not suited for large-scale setups. Here, we present pegIT, a user-friendly web tool for rapid pegRNA design for numerous user-defined edits, including large-scale setups. pegIT is freely available at https://pegit.giehmlab.dk.","authors":[{"name":"Anderson M.V."},{"name":"Haldrup J."},{"name":"Mikkelsen J.G."},{"name":"Thomsen E.A."},{"name":"Wolff J.H."}],"date":"2021-07-02T00:00:00Z","journal":"Nucleic Acids Research","title":"PegIT - A web-based design tool for prime editing"},"pmcid":"PMC8265180","pmid":"34060619"}],"topic":[{"term":"Bioinformatics","uri":"http://edamontology.org/topic_0091"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"Genetic engineering","uri":"http://edamontology.org/topic_3912"},{"term":"Molecular biology","uri":"http://edamontology.org/topic_3047"},{"term":"Probes and primers","uri":"http://edamontology.org/topic_0632"}],"validated":1},"bioschemas":{"name":"pegIT","home":"https://bio.tools/pegit","license":"Not licensed","summary":"pegIT facilitates rapid and effective design of pegRNAs for prime editing based on simple inputs.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pegit/cmd/pegit.giehmlab.dk","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":28,"citations":[{"count":2,"year":"2021"},{"count":4,"year":"2022"},{"count":4,"ye