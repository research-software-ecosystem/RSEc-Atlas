{"tool_name":"ipanemap","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"ipanemap","home":"https://github.com/afafbioinfo/IPANEMAP","summary":"Integrative Probing Analysis of Nucleic Acids Empowered by Multiple Accessibility Profiles.\n\nIPANEMAP is a software for predicting stable RNA secondary structures compatible from multiple chemical probing (SHAPE, DMS, Enzymatic...) reactivities profiles. From one or several input sequences, along with several reactivity profiles, it computes and outputs one or several secondary structures, corresponding to the conformers best supported by experimental data and thermodynamics.","addition_date":"2021-01-18T09:51:07Z","last_update_date":"2024-11-24T20:45:30.785868Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:ipanemap","credit":[{"email":"yann.ponty@lix.polytechnique.fr","name":"Yann Ponty","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Expression analysis","uri":"http://edamontology.org/operation_2495"},{"term":"Phasing","uri":"http://edamontology.org/operation_3454"},{"term":"RNA secondary structure prediction","uri":"http://edamontology.org/operation_0278"},{"term":"RNA structure prediction","uri":"http://edamontology.org/operation_2441"}]}],"name":"IPANEMAP","owner":"Niclaskn","publication":[{"doi":"10.1101/2020.07.03.186312"}],"topic":[{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"Nucleic acid structure analysis","uri":"http://edamontology.org/topic_0097"},{"term":"Probes and primers","uri":"http://edamontology.org/topic_0632"},{"term":"RNA","uri":"http://edamontology.org/topic_0099"},{"term":"Structure prediction","uri":"http://edamontology.org/topic_0082"}]},"bioschemas":{"name":"IPANEMAP","home":"https://bio.tools/ipanemap","summary":"Integrative Probing Analysis of Nucleic Acids Empowered by Multiple Accessibili