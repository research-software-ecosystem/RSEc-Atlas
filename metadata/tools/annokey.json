{"tool_name":"annokey","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"annokey","home":"http://bjpop.github.io/annokey/","summary":"Annokey is a command line tool for annotating gene lists with the results of a key-term search of the NCBI Gene database and linked PubMed article abstracts. Its purpose is to help users prioritise genes by relevance to a domain of interest, such as \u201cbreast cancer\u201d or \u201cDNA repair\u201d etcetera. The user steers the search by specifying a ranked list of keywords and terms that are likely to be highly correlated with their domain of interest.","addition_date":"2017-12-18T00:03:36Z","last_update_date":"2018-12-10T12:58:57Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:annokey","credit":[{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.berniepope.id.au/"}],"documentation":[{"type":["General"],"url":"http://bjpop.github.io/annokey/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Search","uri":"http://edamontology.org/operation_2421"}]}],"name":"Annokey","operating_system":["Linux","Mac"],"owner":"mbs_import","topic":[{"term":"Cancer","uri":"http://edamontology.org/topic_2640"},{"term":"DNA","uri":"http://edamontology.org/topic_0654"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:annokey/cmd/bjpop.github.io","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"ref_count":0,"refs":[]}]}],"readme":true,"summary":{"description":true},"website":{"bioschemas":false,"copyright":fa