{"tool_name":"systempiper","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-systempiper","version":"2.16.3","home":"https://bioconductor.org/packages/3.22/bioc/html/systemPipeR.html","license":"Artistic-2.0","summary":"systemPipeR: Workflow Environment for Data Analysis and Report Generation","identifiers":["biotools:systempiper"],"description":"systemPipeR is a multipurpose data analysis workflow environment that unifies R with command-line tools. It enables scientists to analyze many types of large- or small-scale data on local or distributed computer systems with a high level of reproducibility, scalability and portability. At its core is a command-line interface (CLI) that adopts the Common Workflow Language (CWL). This design allows users to choose for each analysis step the optimal R or command-line software. It supports both end-to-end and partial execution of workflows with built-in restart functionalities. Efficient management of complex analysis tasks is accomplished by a flexible workflow control container class. Handling of large numbers of input samples and experimental designs is facilitated by consistent sample annotation mechanisms. As a multi-purpose workflow toolkit, systemPipeR enables users to run existing workflows, customize them or design entirely new ones while taking advantage of widely adopted data structures within the Bioconductor ecosystem. Another important core functionality is the generation of reproducible scientific analysis and technical reports. For result interpretation, systemPipeR offers a wide range of plotting functionality, while an associated Shiny App offers many useful functionalities for interactive result exploration. The vignettes linked from this page include (1) a general introduction, (2) a description of technical details, and (3) a collection of workflow templates.","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-biocgenerics >=0.56.0,<0.57.0","bioconductor-biostrings >=2.78.0,<2.79.0","bioconductor-genomicranges >=1.62.0,<1.63.0","bioconductor-rsamtools >=2.26.0,<2.27.0","bioconductor-s4vectors >=0.48.0,<0.49.0","bioconductor-shortread >=1.68.0,<1.69.0","bioconductor-summarizedexperiment >=1.40.0,<1.41.0","r-base","r-crayon","r-ggplot2","r-htmlwidgets","r-magrittr","r-stringr","r-yaml"],"run":["bioconductor-biocgenerics >=0.56.0,<0.57.0","bioconductor-biostrings >=2.78.0,<2.79.0","bioconductor-genomicranges >=1.62.0,<1.63.0","bioconductor-rsamtools >=2.26.0,<2.27.0","bioconductor-s4vectors >=0.48.0,<0.49.0","bioconductor-shortread >=1.68.0,<1.69.0","bioconductor-summarizedexperiment >=1.40.0,<1.41.0","r-base","r-crayon","r-ggplot2","r-htmlwidgets","r-magrittr","r-stringr","r-yaml"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/systemPipeR_2.16.3.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/systemPipeR/systemPipeR_2.16.3.tar.gz","https://bioarchive.galaxyproject.org/systemPipeR_2.16.3.tar.gz","https://depot.galaxyproject.org/software/bioconductor-systempiper/bioconductor-systempiper_2.16.3_src_all.tar.gz"],"test":{"commands":["$R -e \"library('systemPipeR')\""]},"parent_recipe":{"name":"bioconductor-systempiper","path":"recipes/bioconductor-systempiper","version":"1.14.0"}},"biotools":{"id":"systempiper","home":"https://bioconductor.org/packages/systemPipeR","license":"Artistic-2.0","summary":"systemPipeR is a workflow management environment for reproducible data analysis that integrates R with command-line software. It enables researchers to design, execute, and report complex workflows on local machines and HPC systems. The framework combines R-based analysis with external tools through a Common Workflow Language (CWL) interface, manages workflow dependencies and restart capabilities, and automatically generates reproducible scientific analysis reports. The companion package systemPipeRdata provides ready-to-use workflow templates that simplify workflow setup and customization. Alternatively, workflow templates can be loaded from dedicated GitHub repositories.","addition_date":"2017-01-17T14:57:45Z","last_update_date":"2026-08-30T02:34:43.994058Z","tool_type":["Command-line tool","Library"],"version":["2.18.0"],"collections":["BioConductor"],"biotools_curie":"biotools:systempiper","credit":[{"name":"Thomas Girke"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/systemPipeR"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Sequence record","uri":"http://edamontology.org/data_0849"},"format":[{"term":"BAM","uri":"http://edamontology.org/format_2572"},{"term":"BCF","uri":"http://edamontology.org/format_3020"},{"term":"FASTQ","uri":"http://edamontology.org/format_1930"},{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}],"operation":[{"term":"RNA-Seq analysis","uri":"http://edamontology.org/operation_3680"},{"term":"Sequence alignment","uri":"http://edamontology.org/operation_0292"}],"output":[{"data":{"term":"Sequence alignment (nucleic acid)","uri":"http://edamontology.org/data_1383"},"format":[{"term":"FASTQ","uri":"http://edamontology.org/format_1930"},{"term":"SAM","uri":"http://edamontology.org/format_2573"}]}]}],"name":"systemPipeR","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1186/s12859-016-1241-0"},{"doi":"10.1186/s12859-016-1241-0"}],"topic":[{"term":"ChIP-seq","uri":"http://edamontology.org/topic_3169"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"bioschemas":{"name":"systemPipeR","home":"https://bio.tools/systempiper","license":"Artistic-2.0","version":"2.18.0","summary":"systemPipeR is a workflow management environment for reproducible data analysis that integrates R with command-line software. It enables researchers to design, execute, and report complex workflows 