{"tool_name":"squassh","contents":["neubias"],"fetched_metadata":{"neubias":{"body":[{"format":"basic_html","processed":"<p>\u0091\u0092\u0092Squassh\u0092\u0092\u0092 is a tool for 2D and 3D segmentation and quantification of subcellular shapes in fluorescence microscopy images. It provides globally optimal detection and segmentation of objects with constant internal intensity distribution, followed by object-based colocalization analysis. The segmentation computed by Region Competition can optionally correct for the PSF of the microscope, hence providing optimally deconvolved segmentations. Part of the mosaic suite</p>","summary":"","value":"<p>\u0091\u0092\u0092Squassh\u0092\u0092\u0092 is a tool for 2D and 3D segmentation and quantification of subcellular shapes in fluorescence microscopy images. It provides globally optimal detection and segmentation of objects with constant internal intensity distribution, followed by object-based colocalization analysis. The segmentation computed by Region Competition can optionally correct for the PSF of the microscope, hence providing optimally deconvolved segmentations. Part of the mosaic suite</p>\r\n"}],"changed":[{"format":"Y-m-d\\TH:i:sP","value":"2019-10-17T11:16:17+00:00"}],"created":[{"format":"Y-m-d\\TH:i:sP","value":"2013-10-15T10:45:51+00:00"}],"default_langcode":[{"value":true}],"attribution_instructions":[],"comments_2023":[],"free_tagging":[{"target_id":4686,"target_type":"taxonomy_term","target_uuid":"d016bd44-0982-4e95-b2ab-b79a3001a975","url":"/taxonomy/term/4686"},{"target_id":4687,"target_type":"taxonomy_term","target_uuid":"912759d5-2ab5-46a2-aff4-7ae70e18f858","url":"/taxonomy/term/4687"},{"target_id":4688,"target_type":"taxonomy_term","target_uuid":"373bf999-9c2b-48ef-af29-67812bec2801","url":"/taxonomy/term/4688"}],"give_feedback_on_this_soft":[{"cid":0,"comment_count":0,"last_comment_name":null,"last_comment_timestamp":1505209505,"last_comment_uid":164,"status":2}],"has_author":[{"value":"MOSAIC Grou