{"tool_name":"cellsort","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"CellSort","home":"https://tyolab.northwestern.edu/tools/","license":"Unlicense","summary":"Support vector machine tool for optimizing fluorescence-activated cell sorting and reducing experimental effort.","addition_date":"2019-07-08T07:32:20Z","last_update_date":"2020-06-16T10:55:23Z","tool_type":["Script"],"accessibility":"Open access","biotools_curie":"biotools:CellSort","cost":"Free of charge","credit":[{"email":"k-tyo@northwestern.edu","name":"Keith E. J. Tyo","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Enrichment analysis","uri":"http://edamontology.org/operation_3501"},{"term":"Metabolic network modelling","uri":"http://edamontology.org/operation_3660"},{"term":"Sorting","uri":"http://edamontology.org/operation_3802"}]}],"maturity":"Mature","name":"CellSort","operating_system":["Linux","Mac","Windows"],"owner":"Ruta","publication":[{"doi":"10.1093/bioinformatics/btw710","metadata":{"abstract":"\u00a9 The Author 2016.Motivation: High throughput screening by fluorescence activated cell sorting (FACS) is a common task in protein engineering and directed evolution. It can also be a rate-limiting step if high false positive or negative rates necessitate multiple rounds of enrichment. Current FACS software requires the user to define sorting gates by intuition and is practically limited to two dimensions. In cases when multiple rounds of enrichment are required, the software cannot forecast the enrichment effort required. Results: We have developed CellSort, a support vector machine (SVM) algorithm that identifies optimal sorting gates based on machine learning using positive and negative control populations. CellSort can take advantage of more than two dimensions to enhance the ability to distinguish between populations. We also present a Bayesian approach to predict the number of sorting rounds required to enrich a population from a given library size. This Bayesian approach allowed us to determine strategies for biasing the sorting gates in order to reduce the required number of enrichment rounds. This algorithm should be generally useful for improve sorting outcomes and reducing effort when using FACS.","authors":[{"name":"Adeniran A.V."},{"name":"Pertusi D.A."},{"name":"Tyo K.E.J."},{"name":"Wren J."},{"name":"Yu J.S."}],"citationCount":5,"date":"2017-01-01T00:00:00Z","journal":"Bioinformatics","title":"CellSort: A support vector machine tool for optimizing fluorescence-activated cell sorting and reducing experimental effort"},"type":["Primary"]}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"}],"validated":1},"bioschemas":{"name":"CellSort","home":"https://bio.tools/CellSort","license":"Unlicense","summary":"Support vector machine tool for optimizing fluorescence-activated cell sorting and reducing experimental effort.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:cellsort/script/tyolab.northwestern.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":6,"citations":[{"count":1,"year":"2019"},{"count":1,"year":"2020"},{"count":1,"year":"2022"},{"count":1,"year":"2024"},{"count":2,"year":"2021"}],"doi":"10.1093/bioinformatics/btw710","pmcid":"PMC5860017","pmid":"27998936","ref_count":14,"refs":[{"count":1,"year":"-1"},{"count":1,"year":"1972"},{"count":1,"year":"1995"},{"count":1,"year":"2000"},{"count":1,"year":"2001"},{"count":1,"year":"2002"},{"count":1,"year":"2009"},{"count":1,"year":"2010"},{"count":1,"year":"2012"},{"count":2,"year":"2015"},{"count":3,"year":"2006"}],"title":"CellSort: a support vector machine tool for optimizing fluorescence-activated cell sorting and reducing experimental effort.","year":2017}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://tyolab.northwestern.edu/tyogroup/tools"},{"status":301,"url":"https://tyolab.northwestern.edu/tyogroup/tyogroup/tools"},{"status":301,"url":"https://tyolab.northwestern.edu/tyogroup/tyogroup/tyogroup/tools"},{"status":301,"url":"https://tyolab.northwestern.edu/tyogroup/tyogroup/tyogroup/tyogroup/tools"},{"status":301,"url":"https://tyolab.northwestern.edu/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tools"},{"status":301,"url":"https://tyolab.northwestern.edu/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tools"},{"status":301,"url":"https://tyolab.northwestern.edu/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tools"},{"status":301,"url":"https://tyolab.northwestern.edu/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tools"},{"status":301,"url":"https://tyolab.northwestern.edu/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tools"},{"status":301,"url":"https://tyolab.northwestern.edu/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tyogroup/tools"}],"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/cellsort","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://tyolab.northwestern.edu/tyogroup/tools"},{"status":301,"url":"https:/