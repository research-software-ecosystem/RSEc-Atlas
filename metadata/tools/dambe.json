{"tool_name":"dambe","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"dambe","home":"http://dambe.bio.uottawa.ca/DAMBE/dambe.aspx","summary":"Comprehensive software package for genomic and phylogenetic data analysis.","addition_date":"2018-08-06T13:16:32Z","last_update_date":"2021-04-17T18:18:16Z","tool_type":["Desktop application"],"biotools_curie":"biotools:dambe","credit":[{"email":"xxia@uottawa.ca","name":"Xuhua Xia","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://dambe.bio.uottawa.ca/software_download/LabManualDAMBE.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Phylogenetic tree analysis","uri":"http://edamontology.org/operation_0324"},{"term":"Sequence alignment","uri":"http://edamontology.org/operation_0292"}]}],"name":"DAMBE7","operating_system":["Linux","Mac","Windows"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1093/molbev/msy073","metadata":{"abstract":"\u00a9 The Author(s) 2018.DAMBE is a comprehensive software package for genomic and phylogenetic data analysis on Windows, Linux, and Macintosh computers. New functions include imputing missing distances and phylogeny simultaneously (paving the way to build large phage and transposon trees), new bootstrapping/jackknifing methods for PhyPA (phylogenetics from pairwise alignments), and an improved function for fast and accurate estimation of the shape parameter of the gamma distribution for fitting rate heterogeneity over sites. Previous method corrects multiple hits for each site independently. DAMBE's new method uses all sites simultaneously for correction. DAMBE, featuring a user-friendly graphic interface, is freely available from http://dambe.bio.uottawa.ca (last accessed, April 17, 2018).","authors":[{"name":"Xia X."}],"citationCount":175,"date":"2018-06-01T00:00:00Z","journal":"Molecular Biology and Evolution","title":"DAMBE7: New and improved tools for data analysis in molecular biology and evolution"},"pmcid":"PMC5967572","pmid":"29669107"}],"topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Nucleic acid structure analysis","uri":"http://edamontology.org/topic_0097"},{"term":"Phylogenetics","uri":"http://edamontology.org/topic_3293"}],"validated":1},"bioschemas":{"name":"DAMBE7","home":"https://bio.tools/dambe","summary":"Comprehensive software package for genomic and phylogenetic data analysis.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:dambe/app/dambe.bio.uottawa.ca","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":345,"citations":[{"count":3,"year":"2018"},{"count":24,"year":"2019"},{"count":36,"year":"2020"},{"count":37,"year":"2026"},{"count":43,"year":"2024"},{"count":45,"year":"2023"},{"count":45,"year":"2025"},{"count":50,"year":"2022"},{"count":62,"year":"2021"}],"doi":"10.1093/molbev/msy073","pmcid":"PMC5967572","pmid":"29669107","ref_count":9,"refs":[{"count":1,"year":"1997"},{"count":1,"year":"1998"},{"count":1,"year":"2004"},{"count":1,"year":"2009"},{"count":1,"year":"2013"},{"count":1,"year":"2015"},{"count":1,"year":"2017"},{"count":2,"year":"2016"}],"title":"DAMBE7: New and Improved Tools for Data Analysis in Molecular Biology and Evolution.","year":2018}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://dambe.bio.uottawa.ca/DAMBE/dambe.aspx"}],"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/dambe","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschema