{"tool_name":"sabbac","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"sabbac","home":"https://mobyle.rpbs.univ-paris-diderot.fr/cgi-bin/portal.py#forms::SABBAC","license":"Freeware","summary":"Tool for the reconstruction of complete protein structures from their alpha-carbon descriptions.","addition_date":"2017-03-24T11:31:16Z","last_update_date":"2024-11-24T21:00:10.511557Z","tool_type":["Web application"],"version":["1.3"],"accessibility":"Open access","biotools_curie":"biotools:sabbac","cost":"Free of charge","credit":[{"email":"pierre.tuffery@univ-paris-diderot.fr","name":"Pierre Tuff\u00e9ry","orcidid":"https://orcid.org/0000-0003-1033-9895","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://bioserv.rpbs.univ-paris-diderot.fr/services/SABBAC/"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"C-alpha trace","uri":"http://edamontology.org/data_1470"},"format":[{"term":"PDB","uri":"http://edamontology.org/format_1476"}]}],"operation":[{"term":"Backbone modelling","uri":"http://edamontology.org/operation_0479"}],"output":[{"data":{"term":"Protein structure","uri":"http://edamontology.org/data_1460"},"format":[{"term":"PDB","uri":"http://edamontology.org/format_1476"}]}]}],"maturity":"Mature","name":"SABBAC","owner":"reyjul","publication":[{"doi":"10.1093/nar/gkl289","metadata":{"abstract":"SABBAC is an on-line service devoted to protein backbone reconstruction from alpha-carbon trace. It is based on the assembly of fragments taken from a library of reduced size, selected from the encoding of the protein trace in a hidden Markov model-derived structural alphabet. The assembly of the fragments is achieved by a greedy algorithm, using an energy- based scoring. Alpha-carbon coordinates remain unaffected. SABBAC simply positions the missing backbone atoms, no further refinement is performed. From our tests, SABBAC perform sequal or better than other similar on-line approach and is robust to deviations on the alpha-carbon coordinates. It can be accessed at http://bioserv.rpbs.jussieu.fr/SABBAC.html. \u00a9 The Author 2006. Published by Oxford University Press. All rights reserved.","authors":[{"name":"Gautier R."},{"name":"Maupetit J."},{"name":"Tuffery P."}],"citationCount":66,"date":"2006-07-01T00:00:00Z","journal":"Nucleic Acids Research","title":"SABBAC: Online structural alphabet-based protein backbone reconstruction from alpha-carbon trace"},"pmcid":"PMC1538914","pmid":"16844979"}],"topic":[{"term":"Molecular modelling","uri":"http://edamontology.org/topic_2275"}],"validated":1},"bioschemas":{"name":"SABBAC","home":"https://bio.tools/sabbac","license":"Freeware","version":"1.3","summary":"Tool for the reconstruction of complete protein structures from their alpha-carbon descriptions.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:sabbac/web/bioserv.rpbs.jussieu.fr","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":30,"citations":[{"count":1,"year":"2011"},{"count":1,"year":"2019"},{"count":1,"year":"2024"},{"count":2,"year":"2012"},{"count":2,"year":"2021"},{"count":3,"year":"2008"},{"count":3,"year":"2009"},{"count":3,"year":"2014"},{"count":4,"year":"2013"},{"count":5,"year":"2010"},{"count":5,"year":"2017"}],"doi":"10.1093/nar/gkl289","pmcid":"PMC1538914","pmid":"16844979","ref_count":23,"refs":[{"count":1,"year":"1984"},{"count":1,"year":"1986"},{"count":1,"year":"1990"},{"count":1,"year":"1991"},{"count":1,"year":"1992"},{"count":1,"year":"1994"},{"count":1,"year":"1995"},{"count":2,"year":"1989"},{"count":2,"year":"1993"},{"count":2,"year":"2002"},{"count":3,"year":"2000"},{"count":3,"year":"2004"},{"count":4,"year":"2005"}],"title":"SABBAC: online Structural Alphabet-based protein BackBone recons