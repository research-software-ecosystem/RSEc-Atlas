{"tool_name":"resfinder","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"resfinder","home":"http://cge.cbs.dtu.dk/services/ResFinder/","license":"Other","summary":"Identification of acquired antimicrobial resistance genes in total or partial sequenced isolates of bacteria.","addition_date":"2015-05-04T12:48:37Z","last_update_date":"2024-11-24T14:45:57.992611Z","tool_type":["Web application"],"version":["2.1"],"biotools_curie":"biotools:resfinder","cost":"Free of charge (with restrictions)","credit":[{"email":"lund@cbs.dtu.dk","name":"Ole Lund","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"CBS","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["General"],"url":"https://cge.cbs.dtu.dk//services/ResFinder/instructions.php"}],"edit_permission":{"authors":["Monjima","funmi_adewuyi","yukiohama"],"type":"group"},"function":[{"input":[{"data":{"term":"Sequence","uri":"http://edamontology.org/data_2044"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"},{"term":"FASTA-like","uri":"http://edamontology.org/format_2546"}]}],"note":"acquired antimicrobial resistance genes","operation":[{"term":"Genetic mapping","uri":"http://edamontology.org/operation_0282"}],"output":[{"data":{"term":"Sequence report","uri":"http://edamontology.org/data_2955"},"format":[{"term":"Binary format","uri":"http://edamontology.org/format_2333"}]}]}],"maturity":"Emerging","name":"ResFinder","operating_system":["Linux","Mac","Windows"],"owner":"CBS","publication":[{"doi":"10.1093/jac/dks261","metadata":{"abstract":"Objectives: Identification of antimicrobial resistance genes is important for understanding the underlying mechanisms and the epidemiology of antimicrobial resistance. As the costs of whole-genome sequencing (WGS) continue to decline, it becomes increasingly available in routine diagnostic laboratories and is anticipated to substitute traditional methods for resistance gene identification. Thus, the current challenge is to extract the relevant information from the large amount of generated data. Methods: We developed a web-based method, ResFinder that uses BLAST for identification of acquired antimicrobial resistance genes in whole-genome data. As input, the method can use both pre-assembled, complete or partial genomes, and short sequence reads from four different sequencing platforms. The method was evaluated on 1862 GenBank files containing 1411 different resistance genes, as well as on 23 de-novo-sequenced isolates. Results: When testing the 1862 GenBank files, the method identified the resistance genes with an ID = 100% (100% identity) to the genes in ResFinder. Agreement between in silico predictions and phenotypic testing was found when the method was further tested on 23 isolates of five different bacterial species, with available phenotypes. Furthermore, ResFinder was evaluated on WGS chromosomes and plasmids of 30 isolates. Seven of these isolates were annotated to have antimicrobial resistance, and in all cases, annotations were compatible with the ResFinder results. Conclusions: A web server providing a convenient way of identifying acquired antimicrobial resistance genes in completely sequenced isolates was created. ResFinder can be accessed at. www.genomicepidemiology.org. ResFinder will continuously be updated as new resistance genes are identified. \u00a9 The Author 2012. Published by Oxford University Press on behalf of the British Society for Antimicrobial Chemotherapy.","authors":[{"name":"Aarestrup F.M."},{"name":"Cosentino S."},{"name":"Hasman H."},{"name":"Larsen M.V."},{"name":"Lund O."},{"name":"Rasmussen S."},{"name":"Vestergaard M."},{"name":"Zankari E."}],"citationCount":3780,"date":"2012-11-01T00:00:00Z","journal":"Journal of Antimicrobial Chemotherapy","title":"Identification of acquired antimicrobial resistance genes"},"pmcid":"PMC3468078","pmid":"22782487","type":["Primary"]}],"topic":[{"term":"Immunology","uri":"http://edamontology.org/topic_0804"}],"validated":1},"bioschemas":{"name":"ResFinder","home":"https://bio.tools/resfinder","license":"Other","version":"2.1","summary":"Identification of acquired antimicrobial resistance genes in total or partial sequenced isolates of bacteria.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:resfinder:2.1/web/cge.cbs.dtu.dk","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":3035,"citations":[{"count":1,"year":"2012"},{"count":3,"year":"-1"},{"count":18,"year":"2013"},{"count":29,"year":"2014"},{"count":60,"year":"2015"},{"count":122,"year":"2016"},{"count":128,"year":"2026"},{"count":184,"year":"2025"},{"count":202,"year":"2024"},{"count":215,"year":"2017"},{"count":237,"year":"2018"},{"count":259,"year":"2023"},{"count":345,"year":"2022"},{"count":346,"year":"2019"},{"count":425,"year":"2021"},{"count":461,"year":"2020"}],"doi":"10.1093/jac/dks261","pmcid":"PMC3468078","pmid":"22782487","ref_count":10,"refs":[{"count":1,"year":"1993"},{"count":1,"year":"2000"},{"count":1,"year":"2002"},{"count":1,"year":"2005"},{"count":2,"year":"2008"},{"count":2,"year":"2011"},{"count":2,"year":"2012"}],"title":"Identification of acquired antimicrobial resistance genes.","year":2012}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":true,"https":true,"license":false,"operational":302,"redirects":[{"status":302,"url":"https://cge.cbs.dtu.dk/services/ResFinder/"}],"ssl":true,"ssl_err":null}},"support":{"email":true}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:resfinder:4.4.2/cmd/bitbucket.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"pro