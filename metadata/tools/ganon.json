{"tool_name":"ganon","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"ganon","identifiers":["doi:10.1101/406017"],"license":"MIT","summary":"ganon: a read classification tool using Interleaved Bloom Filters","home_url":"https://github.com/pirovc/ganon","keywords":["Clustering","Genomics","Metagenomics"],"manually_check":true,"total_pulls":16},"biotools":{"id":"ganon","home":"https://pirovc.github.io/ganon/","license":"MIT","summary":"ganon is designed to index large sets of genomic reference sequences and to classify reads against them efficiently. The tool uses Hierarchical Interleaved Bloom Filters as indices based on k-mers with optional minimizers. It was mainly developed, but not limited, to the metagenomics classification problem: quickly assign sequence fragments to their closest reference among thousands of references. After classification, taxonomic or sequence abundances are estimated and reported.","addition_date":"2021-01-18T09:52:08Z","last_update_date":"2026-02-12T13:50:27.711409Z","tool_type":["Library"],"biotools_curie":"biotools:ganon","credit":[{"email":"bernhard.renard@hpi.de","name":"Bernhard Y Renard","typeEntity":"Person"}],"edit_permission":{"authors":["vashokan"],"type":"group"},"function":[{"input":[{"data":{"term":"DNA sequence","uri":"http://edamontology.org/data_3494"},"format":[{"term":"FASTQ","uri":"http://edamontology.org/format_1930"}]}],"operation":[{"term":"Taxonomic classification","uri":"http://edamontology.org/operation_3460"}],"output":[{"data":{"term":"Taxonomy","uri":"http://edamontology.org/data_3028"},"format":[{"term":"DSV","uri":"http://edamontology.org/format_3751"}]}]},{"operation":[{"term":"Sequence assembly","uri":"http://edamontology.org/operation_0310"},{"term":"k-mer counting","uri":"http://edamontology.org/operation_3472"}]}],"name":"Ganon","owner":"pirovc","publication":[{"doi":"10.1093/nargab/lqaf094","pmcid":"PMC12267982","pmid":"40677913"}],"topic":[{"term"