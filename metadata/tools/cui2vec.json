{"tool_name":"cui2vec","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"cui2vec","home":"https://github.com/beamandrew/cui2vec","summary":"A R pacakge cui2vec, which provides code for fitting embeddings to your own co-occurrence data.","addition_date":"2020-01-14T20:19:34Z","last_update_date":"2020-12-25T13:55:25Z","tool_type":["Library"],"biotools_curie":"biotools:cui2vec","credit":[{"email":"andrew_beam@hms.harvard.edu","name":"Andrew L. Beam","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Named-entity and concept recognition","uri":"http://edamontology.org/operation_3280"},{"term":"Relation extraction","uri":"http://edamontology.org/operation_3625"},{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"cui2vec","owner":"Kigaard","publication":[{"metadata":{"abstract":"\u00a9 2019 The Authors.Word embeddings are a popular approach to unsupervised learning of word relationships that are widely used in natural language processing. In this article, we present a new set of embeddings for medical concepts learned using an extremely large collection of multimodal medical data. Leaning on recent theoretical insights, we demonstrate how an insurance claims database of 60 million members, a collection of 20 million clinical notes, and 1.7 million full text biomedical journal articles can be combined to embed concepts into a common space, resulting in the largest ever set of embeddings for 108,477 medical concepts. To evaluate our approach, we present a new benchmark methodology based on statistical power specifically designed to test embeddings of medical concepts. Our approach, called cui2vec, attains state-of-The-Art performance relative to previous methods in most instances. Finally, we provide a downloadable set of pre-Trained embeddings for other researchers to use, as well as an online tool for interactive exploration of the cui2vec embeddings.","authors":[{"name":"Beam A.L."},{"name":"Cai T."},{"name":"Fried I."},{"name":"Kohane I.S."},{"name":"Kompa B."},{"name":"Palmer N."},{"name":"Schmaltz A."},{"name":"Shi X."},{"name":"Weber G."}],"citationCount":9,"date":"2020-01-01T00:00:00Z","journal":"Pacific Symposium on Biocomputing","title":"Clinical concept embeddings learned from massive sources of multimodal medical data"},"pmcid":"PMC6922053","pmid":"31797605"}],"topic":[{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Medical informatics","uri":"http://edamontology.org/topic_3063"},{"term":"Medicine","uri":"http://edamontology.org/topic_3303"},{"term":"Natural language processing","uri":"http://edamontology.org/topic_0218"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:cui2vec/lib/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":72,"citations":[{"count":4,"year":"2026"},{"count":7,"year":"2022"},{"count":8,"year":"2024"},{"count":8,"year":"2025"},{"count":10,"year":"2019"},{"count":10,"year":"2021"},{"count":10,"year":"2023"},{"count":15,"year":"2020"}],"pmcid":"PMC6922053","pmid":"31797605","ref_count":13,"refs":[{"count":1,"year":"2001"},{"count":1,"year":"2004"},{"count":1,"year":"2006"},{"count":1,"year":"2010"},{"count":1,"year":"2017"},{"count":1,"year":"2018"},{"count":1,"year":"2020"},{"count":3,"year":"2014"},{"count":3,"year":"2016"}],"title":"Clinical Concept Embeddings Learned from Massive Sources of Multimodal Medical Data.","year":2020}]}],"readme":false,"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,