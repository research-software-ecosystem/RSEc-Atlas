{"tool_name":"vicast","contents":["biotools"],"identifiers":["biotools:vicast"],"fetched_metadata":{"biotools":{"id":"vicast","home":"https://github.com/mihinduk/VICAST","summary":"VICAST is an integrated software suite designed for viral cultured passage studies, combining semi-automated genome annotation with low-frequency variant calling. It supports diverse genome types and provides tools for comprehensive tracking of viral evolution.","addition_date":"2026-11-04T17:33:46.351253Z","last_update_date":"2026-11-04T17:33:46.353338Z","biotools_curie":"biotools:vicast","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genome annotation","uri":"http://edamontology.org/operation_0362"},{"term":"Validation","uri":"http://edamontology.org/operation_2428"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"}]}],"name":"VICAST: Viral Genome Annotation and Variant Toolkit","owner":"pub2tools2024","publication":[{"doi":"10.64898/2026.03.16.712174"}],"topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]}}}