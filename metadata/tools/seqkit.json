{"tool_name":"seqkit","contents":["biocontainers","galaxy","bioschemas","debian","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"seqkit","version":"2.13.0","home":"https://github.com/shenwei356/seqkit","documentation":"https://bioinf.shenwei.me/seqkit","license":"MIT","summary":"A cross-platform and ultrafast toolkit for FASTA/Q file manipulation.","identifiers":["biotools:seqkit","usegalaxy-eu:seqkit_head","usegalaxy-eu:seqkit_stats","usegalaxy-eu:seqkit_fx2tab","usegalaxy-eu:seqkit_locate","usegalaxy-eu:seqkit_translate","usegalaxy-eu:seqkit_sort","doi:10.1371/journal.pone.0163962"],"license_file":"LICENSE","build":{"number":0,"run_exports":[null]},"requirements":{"build":[null,"go-licenses"]},"source_url":"https://github.com/shenwei356/seqkit/archive/refs/tags/v2.13.0.tar.gz","test":{"commands":["seqkit version --help"]}},"biocontainers":{"name":"seqkit","identifiers":["doi:10.1371/journal.pone.0163962"],"license":"MIT","summary":"Cross-platform and ultrafast toolkit for fastaq file manipulation","home_url":"https://github.com/shenwei356/seqkit/","keywords":["Amino Acid Sequence","Base Sequence","Data Mining","Sequence Alignment","Web Browser","Protein Sequences"],"manually_check":true,"total_pulls":1153},"biotools":{"id":"seqkit","home":"https://bioinf.shenwei.me/seqkit/","summary":"FASTA and FASTQ are basic and ubiquitous formats for storing nucleotide and protein sequences. Common manipulations of FASTA/Q file include converting, searching, filtering, deduplication, splitting, shuffling, and sampling. Existing tools only implement some of these manipulations, and not particularly efficiently, and some are only available for certain operating systems. Furthermore, the complicated installation process of required packages and running environments can render these programs less user friendly. SeqKit demonstrates competitive performance in execution time and memory usage compared to similar tools. The efficiency and usability of SeqKit enable researchers to rapidly accomplish common FASTA/Q file manipulations.","addition_date":"2021-02-15T23:07:02Z","last_update_date":"2024-11-24T14:34:07.424182Z","biotools_curie":"biotools:seqkit","edit_permission":{"authors":["ELIXIR-CZ","alexcorm"],"type":"group"},"function":[{"input":[{"data":{"term":"DNA sequence","uri":"http://edamontology.org/data_3494"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"},{"term":"FASTQ","uri":"http://edamontology.org/format_1930"}]}],"operation":[{"term":"DNA transcription","uri":"http://edamontology.org/operation_0372"},{"term":"DNA translation","uri":"http://edamontology.org/operation_0371"},{"term":"Sequence conversion","uri":"http://edamontology.org/operation_0233"},{"term":"Sequence trimming","uri":"http://edamontology.org/operation_3192"}],"output":[{"data":{"term":"DNA sequence","uri":"http://edamontology.org/data_3494"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"},{"term":"FASTQ","uri":"http://edamontology.org/format_1930"}]}]}],"name":"seqkit","owner":"leipzig","publication":[{"doi":"10.1371/journal.pone.0163962","metadata":{"abstract":"FASTA and FASTQ are basic and ubiquitous formats for storing nucleotide and protein sequences. Common manipulations of FASTA/Q file include converting, searching, filtering, deduplication, splitting, shuffling, and sampling. Existing tools only implement some of these manipulations, and not particularly efficiently, and some are only available for certain operating systems. Furthermore, the complicated installation process of required packages and running environments can render these programs less user friendly. This paper describes a cross-platform ultrafast comprehensive toolkit for FASTA/Q processing. SeqKit provides executable binary files for all major operating systems, including Windows, Linux, and Mac OSX, and can be directly used without any dependencies or pre-configurations. SeqKit demonstrates competitive performance in execution time and memory usage compared to similar tools. The efficiency and usability of SeqKit enable researchers to rapidly accomplish common FASTA/Q file manipulations. SeqKit is open source and available on Github at https://github.com/shenwei356/seqkit.","authors":[{"name":"Hu F."},{"name":"Le S."},{"name":"Li Y."},{"name":"Shen W."}],"citationCount":1367,"date":"2016-10-01T00:00:00Z","journal":"PLoS ONE","title":"SeqKit: A cross-platform and ultrafast toolkit for FASTA/Q file manipulation"},"pmcid":"PMC5051824","pmid":"27706213"}],"topic":[{"term":"Database management","uri":"http://edamontology.org/topic_3489"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}]},"bioschemas":{"name":"seqkit","home":"https://bio.tools/seqkit","summary":"FASTA and FASTQ are basic and ubiquitous formats for storing nucleotide and protein sequences. Common manipulations of FASTA/Q file include converting, searching, filtering, deduplication, splitting, shuffling, and sampling. Existing tools only implement some of these manipulations, and not particularly efficiently, and some are only available for certain operating systems. Furthermore, the complicated installation process of required packages and running environments can render these programs less user friendly. SeqKit demonstrates competitive performance in execution time and memory usage compared to similar tools. The efficiency and usability of SeqKit enable researchers to rapidly accomplish common FASTA/Q file manipulations.","tool_type":"sc:SoftwareApplication"},"galaxy":{"version":"2.13.0","first_commit":"2022-06-01","conda_name":"seqkit","conda_version":"2.13.0","summary":"A cross-platform and ultrafast toolkit for FASTA/Q file manipulation","edam_operations":["DNA transcription","Sequence trimming","DNA translation","Sequence conversion"],"edam_topics":["Database management","Sequence analysis"],"toolshed_categories":["Sequence Analysis"],"toolshed_id":"seqkit","users_5_years":585,"users_all_time":585,"usa