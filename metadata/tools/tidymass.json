{"tool_name":"tidymass","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"tidymass","home":"https://www.tidymass.org/","license":"MIT","summary":"An Object-oriented Reproducible Analysis Framework for LC-MS Data.","addition_date":"2022-11-25T21:43:37.501728Z","last_update_date":"2025-11-03T16:45:44.856713Z","tool_type":["Library"],"accessibility":"Open access","biotools_curie":"biotools:tidymass","cost":"Free of charge","credit":[{"email":"caroline.johnson@yale.edu","name":"Caroline H. Johnson","typeEntity":"Person"},{"email":"mpsnyder@stanford.edu","name":"Michael P. Snyder","typeEntity":"Person"},{"name":"Hong Yan"},{"name":"Xiaotao Shen","orcidid":"http://orcid.org/0000-0002-9608-9964"}],"edit_permission":{"authors":["recetox-specdatri"],"type":"group"},"function":[{"operation":[{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"tidyMass","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1038/s41467-022-32155-w","metadata":{"abstract":"Reproducibility, traceability, and transparency have been long-standing issues for metabolomics data analysis. Multiple tools have been developed, but limitations still exist. Here, we present the tidyMass project (https://www.tidymass.org/), a comprehensive R-based computational framework that can achieve the traceable, shareable, and reproducible workflow needs of data processing and analysis for LC-MS-based untargeted metabolomics. TidyMass is an ecosystem of R packages that share an underlying design philosophy, grammar, and data structure, which provides a comprehensive, reproducible, and object-oriented computational framework. The modular architecture makes tidyMass a highly flexible and extensible tool, which other users can improve and integrate with other tools to customize their own pipeline.","authors":[{"name":"Gao P."},{"name":"Johnson C.H."},{"name":"Shen X."},{"name":"Snyder M.P."},{"name":"Wang C."},{"name":"Yan H."}],"citationCount":28,"date":"2022-12-01T00:00:00Z","journal":"Nature Communications","title":"TidyMass an object-oriented reproducible analysis framework for LC\u2013MS data"},"pmcid":"PMC9334349","pmid":"35902589"}],"topic":[{"term":"Metabolomics","uri":"http://edamontology.org/topic_3172"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}],"validated":1},"bioschemas":{"name":"tidyMass","home":"https://bio.tools/tidymass","license":"MIT","summary":"An Object-oriented Reproducible Analysis Framework for LC-MS Data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:tidymass/lib/www.tidymass.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":50,"citations":[{"count":1,"year":"2022"},{"count":7,"year":"2023"},{"count":11,"year":"2024"},{"count":13,"year":"2026"},{"count":18,"year":"2025"}],"doi":"10.1038/s41467-022-32155-w","pmcid":"PMC9334349","pmid":"35902589","ref_count":42,"refs":[{"count":1,"year":"2000"},{"count":1,"year":"2001"},{"count":1,"year":"2003"},{"count":1,"year":"2006"},{"count":1,"year":"2007"},{"count":1,"year":"2008"},{"count":1,"year":"2010"},{"count":1,"year":"2018"},{"count":2,"year":"2011"},{"count":2,"year":"2012"},{"count":2,"year":"2017"},{"count":3,"year":"2015"},{"count":3,"year":"2016"},{"count":3,"year":"2020"},{"count":4,"year":"2013"},{"count":5,"year":"2019"},{"count":5,"year":"2021"},{"count":5,"year":"2022"}],"title":"TidyMass an object-oriented reproducible analysis framework for LC-MS data.","year":2022}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational