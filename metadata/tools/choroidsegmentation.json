{"tool_name":"choroidsegmentation","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"choroidsegmentation","home":"https://www.mathworks.com/matlabcentral/fileexchange/61275-choroidsegmentation","license":"GPL-3.0","summary":"Open-source algorithm for automatic choroid segmentation of OCT volume reconstructions","addition_date":"2021-05-05T11:07:01Z","last_update_date":"2024-11-24T20:23:13.777350Z","tool_type":["Library"],"version":["2.0.0.0"],"collections":["File Exchange","MATLAB"],"accessibility":"Open access (with restrictions)","biotools_curie":"biotools:choroidsegmentation","cost":"Free of charge (with restrictions)","credit":[{"name":"javimazzaf","typeEntity":"Person","typeRole":["Primary contact"],"url":"https://www.mathworks.com/matlabcentral/profile/3319970-javimazzaf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Image analysis","uri":"http://edamontology.org/operation_3443"},{"term":"Scatter plot plotting","uri":"http://edamontology.org/operation_2940"},{"term":"Validation","uri":"http://edamontology.org/operation_2428"}]}],"name":"choroidSegmentation","operating_system":["Linux","Mac","Windows"],"owner":"Kigaard","publication":[{"doi":"10.1038/srep42112","metadata":{"abstract":"The use of optical coherence tomography (OCT) to study ocular diseases associated with choroidal physiology is sharply limited by the lack of available automated segmentation tools. Current research largely relies on hand-traced, single B-Scan segmentations because commercially available programs require high quality images, and the existing implementations are closed, scarce and not freely available. We developed and implemented a robust algorithm for segmenting and quantifying the choroidal layer from 3-dimensional OCT reconstructions. Here, we describe the algorithm, validate and benchmark the results, and provide an open-source implementation under the General Public License for any researcher to use (https://www.mathworks.com/matlabcentral/fileexchange/61275-choroidsegmentation).","authors":[{"name":"Beaton L."},{"name":"Costantino S."},{"name":"Hounye G."},{"name":"Mazzaferri J."},{"name":"Sayah D.N."}],"citationCount":52,"date":"2017-02-09T00:00:00Z","journal":"Scientific Reports","title":"Open-source algorithm for automatic choroid segmentation of OCT volume reconstructions"},"pmcid":"PMC5299605","pmid":"28181546","type":["Primary"]}],"topic":[{"term":"Biology","uri":"http://edamontology.org/topic_3070"},{"term":"Biomedical science","uri":"http://edamontology.org/topic_3344"},{"term":"Mathematics","uri":"http://edamontology.org/topic_3315"},{"term":"Physiology","uri":"http://edamontology.org/topic_3300"},{"term":"Tomography","uri":"http://edamontology.org/topic_3452"}]},"bioschemas":{"name":"choroidSegmentation","home":"https://bio.tools/choroidsegmentation","license":"GPL-3.0","version":"2.0.0.0","summary":"Open-source algorithm for automatic choroid segmentation of OCT volume reconstructions","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:choroidsegmentation:2.0.0.0/lib/www.mathworks.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":36,"citations":[{"count":1,"year":"2026"},{"count":2,"year":"2017"},{"count":2,"year":"2019"},{"count":3,"year":"2021"},{"count":3,"year":"2023"},{"count":4,"year":"2018"},{"count":4,"year":"2024"},{"count":4,"year":"2025"},{"count":6,"year":"2020"},{"count":7,"year":"2022"}],"doi":"10.1038/srep42112","pmcid":"PMC5299605","pmid":"28181546","ref_count":29,"refs":[{"count":2,"year":"2009"},{"count":2,"year":"2013"},{"count":4,"year":"2011"},{"count":5,"year":"2012"},{"count":6,"year":"2015"},{"count":10,"year":"2014"}],"title":"O