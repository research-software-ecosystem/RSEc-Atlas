 to retrieve data from PsyGeNET database and to perform comorbidity studies with PsyGeNET's and user's data.","addition_date":"2017-01-17T14:56:40Z","last_update_date":"2024-11-24T15:05:12.985907Z","tool_type":["Command-line tool","Library"],"version":["1.30.0"],"collections":["BioConductor"],"biotools_curie":"biotools:psygenet2r","credit":[{"email":"carles.hernandez@isglobal.org","name":"Carles Hernandez-Ferrer","orcidid":"https://orcid.org/0000-0002-8029-7160","typeEntity":"Person","typeRole":["Developer"],"url":"http://www.carleshf.com"},{"email":"alba.gutierrez@upf.edu","name":"Alba Gutierrez-Sacristan","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"juanr.gonzalez@isglobal.org","name":"Juan R Gonzalez","typeEntity":"Person","typeRole":["Support"]},{"email":"laura.furlong@upf.edu","name":"Laura I Furlong","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/html/psygenet2r.html"}],"edit_permission":{"authors":["chernan3"],"type":"group"},"function":[{"operation":[{"term":"Database search","uri":"http://edamontology.org/operation_2421"},{"term":"Enrichment analysis","uri":"http://edamontology.org/operation_3501"}]}],"name":"psygenet2r","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1093/bioinformatics/btx506","metadata":{"abstract":"Motivation: Psychiatric disorders have a great impact on morbidity and mortality. Genotype- phenotype resources for psychiatric diseases are key to enable the translation of research findings to a better care of patients. PsyGeNET is a knowledge resource on psychiatric diseases and their genes, developed by text mining and curated by domain experts. Results: We present psygenet2r, an R package that contains a variety of functions for leveraging PsyGeNET database and facilitating its analysis and interpretation. The package offers different types of queries to the database along with variety of analysis and visualization tools, including the study of the anatomical structures in which the genes are expressed and gaining insight of gene's molecular function. Psygenet2r is especially suited for network medicine analysis of psychiatric disorders.","authors":[{"name":"Furlong L.I."},{"name":"Gonzalez J.R."},{"name":"Gutierrez-Sacristan A."},{"name":"Hernandez-Ferrer C."}],"citationCount":4,"date":"2017-12-15T00:00:00Z","journal":"Bioinformatics","title":"Psygenet2r: A R/Bioconductor package for the analysis of psychiatric disease genes"},"pmcid":"PMC5860088","pmid":"28961763","type":["Review"]}],"topic":[{"term":"Data management","uri":"http://edamontology.org/topic_3071"},{"term":"Psychiatry","uri":"http://edamontology.org/topic_3419"}],"validated":1},"bioschemas":{"name":"psygenet2r","home":"https://bio.tools/psygenet2r","license":"MIT","version":"1.30.0","summary":"Package to retrieve data from PsyGeNET database and to perform comorbidity studies with PsyGeNET's and user's data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:psygenet2r:1.30.0/cmd/www.bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":9,"citations":[{"count":1,"year":"2023"},{"count":1,"year":"2024"},{"count":1,"year":"2026"},{"count":2,"year":"2020"},{"count":4,"year":"2025"}],"doi":"10.1093/bioinformatics/btx506","pmcid":"PMC5860088","pmid":"28961763","ref_count":5,"refs":[{"count":1,"year":"2017"},{"count":2,"year":"2015"},{"count":2,"year":"2016"}],"title":"psygenet2r: a R/Bioconductor package for the analysis of psychiatric disease genes.","year":2017}]}],"summary":{"description":true},"website":{"bioschemas":false,"c