{"tool_name":"scsnv","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"scsnv","home":"https://github.com/GWW/scsnv","license":"MIT","summary":"scSNV is an accurate dscRNA-seq SNV co-expression analysis using duplicate tag collapsing. scSNV is an alternative to Cell Ranger + velocyto for the alignment, quantification and SNV calling of 10X Single Cell RNA-seq data. Currently, scSNV supports 10X 5-prime and 3-prime 10X version 2 and 3 libraries.","addition_date":"2021-11-29T13:04:28.546333Z","last_update_date":"2021-11-29T13:04:28.549011Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:scsnv","credit":[{"email":"gavin.wilson@uhnresearch.ca","name":"Gavin W. Wilson","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"jonathan.yeung@uhn.ca","name":"Jonathan C. Yeung","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"DNA barcoding","uri":"http://edamontology.org/operation_3200"},{"term":"Demultiplexing","uri":"http://edamontology.org/operation_3933"},{"term":"Expression correlation analysis","uri":"http://edamontology.org/operation_3463"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"},{"term":"Variant calling","uri":"http://edamontology.org/operation_3227"}]}],"name":"scSNV","owner":"Kigaard","publication":[{"doi":"10.1186/S13059-021-02364-5","metadata":{"abstract":"\u00a9 2021, The Author(s).Identifying single nucleotide variants has become common practice for droplet-based single-cell RNA-seq experiments; however, presently, a pipeline does not exist to maximize variant calling accuracy. Furthermore, molecular duplicates generated in these experiments have not been utilized to optimally detect variant co-expression. Herein, we introduce scSNV designed from the ground up to \u201ccollapse\u201d molecular duplicates and accurately identify variants and their co-expression. We demonstrate that scSNV is fast, with a reduced false-positive variant call rate, and enables the co-detection of genetic variants and A>G RNA edits across twenty-two samples.","authors":[{"name":"Darling G.E."},{"name":"Derouet M."},{"name":"Wilson G.W."},{"name":"Yeung J.C."}],"citationCount":1,"date":"2021-12-01T00:00:00Z","journal":"Genome Biology","title":"scSNV: accurate dscRNA-seq SNV co-expression analysis using duplicate tag collapsing"},"pmcid":"PMC8103760","pmid":"33962667","type":["Primary"]}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Exome sequencing","uri":"http://edamontology.org/topic_3676"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}]},"bioschemas":{"name":"scSNV","home":"https://bio.tools/scsnv","license":"MIT","summary":"scSNV is an accurate dscRNA-seq SNV co-expression analysis using duplicate tag collapsing. scSNV is an alternative to Cell Ranger + velocyto for the alignment, quantification and SNV calling of 10X Single Cell RNA-seq data. Currently, scSNV supports 10X 5-prime and 3-prime 10X version 2 and 3 libraries.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:scsnv/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":false,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":9,"citations":[{"count":1,"year":"2021"},{"count":1,"year":"2025"},{"count":2,"year":"2024"},{"count":2,"year":"2026"},{"count":3,"year":"2023"}],"doi":"10.1186/s13059-0