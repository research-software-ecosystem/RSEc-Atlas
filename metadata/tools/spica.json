{"tool_name":"spica","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"spica","home":"https://spica.unil.ch","summary":"The Swiss Portal for Immune Cell Analysis (SPICA) is a web resource dedicated to the exploration and analysis of single-cell RNA-seq data of immune cells.","addition_date":"2022-03-13T18:32:50.182755Z","last_update_date":"2022-03-13T18:32:50.185456Z","tool_type":["Database portal","Web application"],"accessibility":"Open access","biotools_curie":"biotools:spica","cost":"Free of charge","credit":[{"email":"santiago.carmona@unil.ch","name":"Santiago J Carmona","orcidid":"https://orcid.org/0000-0002-2495-0671","typeEntity":"Person"},{"name":"Christian Iseli"},{"name":"Fabrice P A David"},{"name":"Nicolas Guex"},{"name":"Massimo Andreatta","orcidid":"https://orcid.org/0000-0002-8036-2647"}],"documentation":[{"type":["API documentation"],"url":"https://spica.unil.ch/home/api"},{"type":["User manual"],"url":"https://spica.unil.ch/tutorials"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Data retrieval","uri":"http://edamontology.org/operation_2422"},{"term":"Database search","uri":"http://edamontology.org/operation_2421"},{"term":"Differential gene expression profiling","uri":"http://edamontology.org/operation_3223"}]}],"name":"SPICA","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1093/NAR/GKAB1055","metadata":{"abstract":"\u00a9 The Author(s) 2021. Published by Oxford University Press on behalf of Nucleic Acids Research.Single-cell transcriptomics allows the study of immune cell heterogeneity at an unprecedented level of resolution. The Swiss portal for immune cell analysis (SPICA) is a web resource dedicated to the exploration and analysis of single-cell RNA-seq data of immune cells. In contrast to other single-cell databases, SPICA hosts curated, cell type-specific reference atlases that describe immune cell states at high resolution, and published single-cell datasets analysed in the context of these atlases. Additionally, users can privately analyse their own data in the context of existing atlases and contribute to the SPICA database. SPICA is available at https://spica.unil.ch.","authors":[{"name":"Andreatta M."},{"name":"Carmona S.J."},{"name":"David F.P.A."},{"name":"Guex N."},{"name":"Iseli C."}],"date":"2022-01-07T00:00:00Z","journal":"Nucleic acids research","title":"SPICA: Swiss portal for immune cell analysis"},"pmcid":"PMC8728228","pmid":"34747477"}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"SPICA","home":"https://bio.tools/spica","summary":"The Swiss Portal for Immune Cell Analysis (SPICA) is a web resource dedicated to the exploration and analysis of single-cell RNA-seq data of immune cells.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:spica/db/spica.unil.ch","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"api":true,"manual":true},"publications":[{"entries":[{"cit_count":7,"citations":[{"count":1,"year":"2023"},{"count":1,"year":"2026"},{"count":2,"year":"2024"},{"count":3,"year":"2025"}],"doi":"10.1093/nar/gkab1055","pmcid":"PMC8728228","pmid":"34747477","ref_count":8,"refs":[{"count":1,"year":"2016"},{"count":1,"year":"2018"},{"count":3,"year":"2020"},{"count":3,"year":"2021"}],"title":"SPICA: Swiss portal for immune cell analysis.","year":2022}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es