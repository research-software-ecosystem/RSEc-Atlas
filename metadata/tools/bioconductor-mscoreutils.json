{"tool_name":"bioconductor-mscoreutils","contents":["bioconda","bioconductor","biocontainers","bioschemas","biotools","oeb"],"identifiers":["biotools:bioconductor-mscoreutils","bioconductor:mscoreutils","bioconda:bioconductor-mscoreutils"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-mscoreutils","identifiers":["doi:10.18129/b9.bioc.mscoreutils"],"license":"Artistic-2.0","summary":"Core Utils for Mass Spectrometry Data","home_url":"https://bioconductor.org/packages/3.11/bioc/html/MsCoreUtils.html","keywords":["Proteomics","Mass spectra","Mass spectrometry","Metabolomics"],"manually_check":true,"total_pulls":4},"biotools":{"id":"bioconductor-mscoreutils","home":"https://bioconductor.org/packages/Spectra","license":"Artistic-2.0","summary":"Mass spectrometry (MS) data backend supporting import and handling of MS/MS spectra from NIST MSP Format (msp) files. Import of data from files with different MSP *flavours* is supported. Objects from this package add support for MSP files to Bioconductor's Spectra package. This package is thus not supposed to be used without the Spectra package that provides a complete infrastructure for MS data handling.","addition_date":"2026-08-30T02:46:56.830697Z","last_update_date":"2026-10-11T01:43:49.107833Z","tool_type":["Command-line tool","Library"],"version":["1.22.2"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-mscoreutils","credit":[{"name":"Ahlam Mentag","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Guillaume Deflandre","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Jan Stanstrup","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Johannes Rainer","typeEntity":"Person","typeRole":["Developer"]},{"name":"Laurent Gatto","typeEntity":"Person","typeRole":["Developer"]},{"name":"Mar Garcia-Aloy","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Nir Shahaf","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Philippine Louail","typeEntity":"Person","ty