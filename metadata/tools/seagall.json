{"tool_name":"seagall","contents":["biotools"],"identifiers":["biotools:seagall"],"fetched_metadata":{"biotools":{"id":"seagall","home":"https://github.com/gmalagol10/seagall","summary":"SEAGALL is a deep learning pipeline that uses geometry-regularised autoencoders (GRAE) and explainable graph attention networks (X-GAT) to analyze single-cell data. It quantifies molecular features to explain cell identity and extract stable signatures from multiomics experiments.","addition_date":"2026-11-04T14:50:42.071119Z","last_update_date":"2026-11-04T14:50:42.075220Z","biotools_curie":"biotools:seagall","credit":[{"email":"maria.colome@bmc.med.lmu.de","name":"Maria Colom\u00e9-Tatch\u00e9","typeEntity":"Person"},{"email":"wolfguy@mila.quebec","name":"Guy Wolf","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Differential gene expression profiling","uri":"http://edamontology.org/operation_3223"},{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Peak calling","uri":"http://edamontology.org/operation_3222"}]}],"name":"SEAGALL (Single-cell Explainable Geometry-Aware Graph Attention Learning pipeLine)","owner":"pub2tools2024","publication":[{"doi":"10.1186/S13059-026-04066-2","pmcid":"PMC13238118","pmid":"42026624"}],"topic":[{"term":"Evolutionary biology","uri":"http://edamontology.org/topic_3299"},{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Multiomics","uri":"http://edamontology.org/topic_4021"},{"term":"Plant biology","uri":"http://edamontology.org/topic_0780"},{"term":"Single-cell sequencing","uri":"http://edamontology.org/topic_4028"}]}}}