{"tool_name":"geometadb","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-geometadb","version":"1.72.0","home":"https://bioconductor.org/packages/3.22/bioc/html/GEOmetadb.html","license":"Artistic-2.0","summary":"A compilation of metadata from NCBI GEO","identifiers":["biotools:geometadb"],"description":"The NCBI Gene Expression Omnibus (GEO) represents the largest public repository of microarray data. However, finding data of interest can be challenging using current tools. GEOmetadb is an attempt to make access to the metadata associated with samples, platforms, and datasets much more feasible. This is accomplished by parsing all the NCBI GEO metadata into a SQLite database that can be stored and queried locally. GEOmetadb is simply a thin wrapper around the SQLite database along with associated documentation. Finally, the SQLite database is updated regularly as new data is added to GEO and can be downloaded at will for the most up-to-date metadata. GEOmetadb paper: http://bioinformatics.oxfordjournals.org/cgi/content/short/24/23/2798 .","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["r-base","r-r.utils","r-rsqlite"],"run":["r-base","r-r.utils","r-rsqlite"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/GEOmetadb_1.72.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GEOmetadb/GEOmetadb_1.72.0.tar.gz","https://bioarchive.galaxyproject.org/GEOmetadb_1.72.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-geometadb/bioconductor-geometadb_1.72.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('GEOmetadb')\""]},"parent_recipe":{"name":"bioconductor-geometadb","path":"recipes/bioconductor-geometadb","version":"1.42.0"}},"biotools":{"id":"geometadb","home":"https://bioconductor.org/packages/GEOmetadb","license":"Artistic-2.0","summary":"The NCBI Gene Expression Omnibus (GEO) represents the largest public repository of microarray data. However, finding data of interest can be challenging using current tools. GEOmetadb is an attempt to make access to the metadata associated with samples, platforms, and datasets much more feasible. This is accomplished by parsing all the NCBI GEO metadata into a SQLite database that can be stored and queried locally. GEOmetadb is simply a thin wrapper around the SQLite database along with associated documentation. Finally, the SQLite database is updated regularly as new data is added to GEO and can be downloaded at will for the most up-to-date metadata. GEOmetadb paper: http://bioinformatics.oxfordjournals.org/cgi/content/short/24/23/2798 .","addition_date":"2017-01-17T15:04:35Z","last_update_date":"2018-12-24T23:03:52Z","tool_type":["Command-line tool","Library"],"version":["1.74.0"],"collections":["BioConductor"],"biotools_curie":"biotools:geometadb","credit":[{"name":"Jack Zhu and Sean Davis"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/GEOmetadb"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Database search","uri":"http://edamontology.org/operation_2421"}]}],"name":"GEOmetadb","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1093/bioinformatics/btn520"}],"topic":[{"term":"Data acquisition","uri":"http://edamontology.org/topic_3077"},{"term":"Microarray experiment","uri":"http://edamontology.org/topic_3518"}],"validated":1},"bioschemas":{"name":"GEOmetadb","home":"https://bio.tools/geometadb","license":"Artistic-2.0","version":"1.74.0","summary":"The NCBI Gene Expression Omnibus (GEO) represents the largest public repository of microarray data. However, finding data of interest can be challenging using current tools. GEOmetadb is an attempt to make access to the metadata associated with samples, platforms, and datasets much more feasible. This is accomplished by parsing all the NCBI GEO metadata into a SQLite database that can be stored and queried locally. GEOmetadb is simply a thin wrapper around the SQLite database along with associated documentation. Finally, the SQLite database is updated regularly as new data is added to GEO and can be downloaded at will for the most up-to-date metadata. GEOmetadb paper: http://bioinformatics.oxfordjournals.org/cgi/content/short/24/23/2798 .","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:geometadb:1.34.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":86,"citations":[{"count":1,"year":"2026"},{"count":2,"year":"2012"},{"count":2,"year":"2013"},{"count":2,"year":"2014"},{"count":2,"year":"2025"},{"count":3,"year":"2010"},{"count":4,"year":"2009"},{"count":4,"year":"2011"},{"count":5,"year":"2015"},{"count":5,"year":"2019"},{"count":5,"year":"2020"},{"count":5,"year":"2022"},{"count":6,"year":"2017"},{"count":6,"year":"2018"},{"count":7,"year":"2023"},{"count":7,"year":"2024"},{"count":10,"year":"2016"},{"count":10,"year":"2021"}],"doi":"10.1093/bioinformatics/btn520","pmcid":"PMC2639278","pmid":"18842599","ref_count":6,"refs":[{"count":1,"year":"2001"},{"count":1,"year":"2002"},{"count":1,"year":"2004"},{"count":1,"year":"2006"},{"count":1,"year":"2007"},{"count":1,"year":"2008"}],"title":"GEOmetadb: powerful alternative search engine for the Gene Expression Omnibus.","year":2008}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://bioconductor.org/packages/release/bioc/html/GEOmetadb.html"}],"ssl":true,"ssl_err":null}},"support":{"email":true}