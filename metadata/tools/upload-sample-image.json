{"tool_name":"upload-sample-image","contents":["neubias"],"fetched_metadata":{"neubias":{"body":[{"format":"basic_html","processed":"<p>It is used to upload a file (not just images) meant for the ImageJ developers. You might need to do this e.g. when the file is too large for email attachments, or when you want to accompany a&nbsp;<a href=\"https://imagej.net/Report_a_Bug\">bug report</a> with a large image. To prevent abuse of this facility, access to the uploaded images is restricted to trusted admins.</p>","summary":"","value":"<p>It is used to upload a file (not just images) meant for the ImageJ developers. You might need to do this e.g. when the file is too large for email attachments, or when you want to accompany a&nbsp;<a href=\"https://imagej.net/Report_a_Bug\">bug report</a> with a large image. To prevent abuse of this facility, access to the uploaded images is restricted to trusted admins.</p>\r\n"}],"changed":[{"format":"Y-m-d\\TH:i:sP","value":"2023-05-03T14:15:04+00:00"}],"created":[{"format":"Y-m-d\\TH:i:sP","value":"2013-10-11T13:08:41+00:00"}],"default_langcode":[{"value":true}],"attribution_instructions":[],"comments_2023":[],"free_tagging":[{"target_id":4972,"target_type":"taxonomy_term","target_uuid":"0be1c34d-6bc3-445a-8343-b7478647478f","url":"/taxonomy/term/4972"},{"target_id":4984,"target_type":"taxonomy_term","target_uuid":"13346d19-0dbb-4e1d-9d91-16aef81e0854","url":"/taxonomy/term/4984"}],"give_feedback_on_this_soft":[{"cid":0,"comment_count":0,"last_comment_name":null,"last_comment_timestamp":1505206172,"last_comment_uid":164,"status":2}],"has_author":[{"value":"Johannes Schindelin"}],"has_biological_terms":[],"has_comparison":[],"has_documentation":[],"has_doi":[],"has_entry_curator":[{"target_id":98,"target_type":"user","target_uuid":"2ae7ecac-ed23-4375-8a06-79f6a294e65b","url":"/user/98"}],"has_function":[],"has_implementation":[],"has_interaction_level":[{"target_id":3572,"target_type":"taxonomy_term","target_uuid":"551f908e-bb43-410a