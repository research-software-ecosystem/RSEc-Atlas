{"tool_name":"hs-blastn","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"hs-blastn","identifiers":["biotools:hs-blastn","doi:10.1093/nar/gkv784"],"license":"GPL-3.0","summary":"hs-blastn, a fast and accurate nucleotide-nucleotide sequences aligner.","home_url":"https://github.com/chenying2016/queries","keywords":["Base Sequence","Databases, Nucleic Acid","Genome, Human","Humans","Sequence Alignment","Sequence assembly","Sequence analysis","DNA"],"manually_check":true,"total_pulls":1},"biotools":{"id":"hs-blastn","home":"https://github.com/chenying2016/queries","summary":"Nucleotide-Nucleotide aligner that searches nucleotide queries against a large nucleotide database.","addition_date":"2017-08-03T18:46:07Z","last_update_date":"2024-11-25T14:18:14.977674Z","tool_type":["Command-line tool"],"collections":["BLAST"],"biotools_curie":"biotools:hs-blastn","credit":[{"email":"chenying2016@gmail.com","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/chenying2016/queries/tree/master/hs-blastn-src"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Sequence","uri":"http://edamontology.org/data_2044"}}],"operation":[{"term":"Sequence alignment","uri":"http://edamontology.org/operation_0292"},{"term":"Sequence similarity search","uri":"http://edamontology.org/operation_0346"}],"output":[{"data":{"term":"Sequence search results","uri":"http://edamontology.org/data_0857"}}]}],"name":"HS-BLASTN","operating_system":["Linux"],"owner":"mbs_import","publication":[{"doi":"10.1093/nar/gkv784","metadata":{"abstract":"Sequence alignment is a long standing problem in bioinformatics. The Basic Local Alignment Search Tool (BLAST) is one of the most popular and fundamental alignment tools. The explosive growth of biological sequences calls for speedup of sequence alignment tools such as BLAST. To this end, we develop high speed BLASTN (HS-BLASTN), a parallel and fast nucleotide database search tool that accelerates MegaBLAST-the default module of NCBIBLASTN. HS-BLASTN builds a new lookup table using the FMD-index of the database and employs an accurate and effective seeding method to find short stretches of identities (called seeds) between the query and the database. HS-BLASTN produces the same alignment results as MegaBLAST and its computational speed is much faster than MegaBLAST. Specifically, our experiments conducted on a 12-core server show that HS-BLASTN can be 22 times faster than MegaBLAST and exhibits better parallel performance than MegaBLAST. HS-BLASTN is written in C++ and the related source code is available at https://github.com/chenying2016/queries under the GPLv3 license.","authors":[{"name":"Chen Y."},{"name":"Xu Y."},{"name":"Ye W."},{"name":"Zhang Y."}],"citationCount":353,"date":"2015-07-22T00:00:00Z","journal":"Nucleic Acids Research","title":"High speed BLASTN: An accelerated MegaBLAST search tool"},"pmcid":"PMC4652774","pmid":"26250111"}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"}],"validated":1},"bioschemas":{"name":"HS-BLASTN","home":"https://bio.tools/hs-blastn","summary":"Nucleotide-Nucleotide aligner that searches nucleotide queries against a large nucleotide database.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:hs-blastn/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":false,"license":false,"public":true,"readme":false,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation