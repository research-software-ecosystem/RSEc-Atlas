{"tool_name":"bioconductor-xina","contents":["biocontainers","oeb","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-xina","identifiers":["doi:10.18129/b9.bioc.xina"],"license":"GPL-3","summary":"Multiplexes Isobaric Mass Tagged-based Kinetics Data for Network Analysis","home_url":"https://bioconductor.org/packages/3.8/bioc/html/XINA.html","keywords":["Proteomics"],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-xina","home":"https://bioconductor.org/packages/XINA","license":"GPL-3.0","summary":"The aim of XINA is to determine which proteins exhibit similar patterns within and across experimental conditions, since proteins with co-abundance patterns may have common molecular functions. XINA imports multiple datasets, tags dataset in silico, and combines the data for subsequent subgrouping into multiple clusters. The result is a single output depicting the variation across all conditions. XINA, not only extracts coabundance profiles within and across experiments, but also incorporates protein-protein interaction databases and integrative resources such as KEGG to infer interactors and molecular functions, respectively, and produces intuitive graphical outputs.","tool_type":["Command-line tool","Library"],"version":["1.30.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-xina","credit":[{"name":"Lang Ho Lee"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/XINA"}],"name":"XINA","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-xina:1.2.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website