{"tool_name":"qfit_3","contents":["biotools","oeb"],"identifiers":["biotools:qfit_3"],"fetched_metadata":{"biotools":{"id":"qfit_3","home":"https://github.com/ExcitedStates/qfit-3.0","license":"MIT","summary":"Protein and ligand multiconformer modeling for X-ray crystallographic and single-particle cryo-EM density maps.\n\nqFit is a collection of programs for modeling multi-conformer protein structures.\n\nElectron density maps obtained from high-resolution X-ray diffraction data are a spatial and temporal average of all conformations within the crystal. qFit evaluates an extremely large number of combinations of sidechain conformers, backbone fragments and small-molecule ligands to locally explain the electron density.","addition_date":"2021-01-18T10:51:17Z","last_update_date":"2026-11-12T14:25:05.647956Z","biotools_curie":"biotools:qfit_3","credit":[{"email":"dkeedy@gc.cuny.edu","name":"Daniel A. Keedy","typeEntity":"Person"},{"email":"vdbedem@atomwise.com","name":"Henry van den Bedem","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Backbone modelling","uri":"http://edamontology.org/operation_0479"},{"term":"Loop modelling","uri":"http://edamontology.org/operation_0481"},{"term":"Protein structure validation","uri":"http://edamontology.org/operation_0321"},{"term":"Side chain modelling","uri":"http://edamontology.org/operation_0480"}]}],"name":"qFit 3","owner":"zsmag19","publication":[{"doi":"10.1002/pro.4001","type":["Primary"]},{"doi":"10.1101/2020.09.03.280222","type":["Preprint"]}],"topic":[{"term":"Drug discovery","uri":"http://edamontology.org/topic_3336"},{"term":"Electron microscopy","uri":"http://edamontology.org/topic_0611"},{"term":"Molecular dynamics","uri":"http://edamontology.org/topic_0176"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"},{"term":"X-ray diffraction","uri":"http://edamontology.org/topic_2828"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bi