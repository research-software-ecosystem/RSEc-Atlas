{"tool_name":"macpet","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"macpet","home":"http://bioconductor.org/packages/release/bioc/html/MACPET.html","license":"GPL-3.0","summary":"It can be used for binding site analysis for ChIA-PET data. MACPET reads ChIA-PET data in BAM or SAM format and separates the data into Self-ligated, Intra- and Inter-chromosomal PETs. Furthermore, MACPET breaks the genome into regions and applies 2D mixture models for identifying candidate peaks/binding sites using skewed generalized students-t distributions (SGT). It then uses a local poisson model for finding significant binding sites.","addition_date":"2018-07-11T12:25:21Z","last_update_date":"2018-12-10T12:59:00Z","tool_type":["Library"],"version":["1.0.0"],"collections":["BioConductor"],"biotools_curie":"biotools:macpet","credit":[{"email":"ioannis.vardaxis@ntnu.no","name":"Ioannis Vardaxis","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/manuals/MACPET/man/MACPET.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Classification","uri":"http://edamontology.org/operation_2990"}]},{"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"}]},{"operation":[{"term":"DNA structure prediction","uri":"http://edamontology.org/operation_2442"}]},{"operation":[{"term":"Peak detection","uri":"http://edamontology.org/operation_3215"}]}],"name":"MACPET","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[{"doi":"10.1101/272559","type":["Primary"]}],"topic":[{"term":"DNA binding sites","uri":"http://edamontology.org/topic_3125"},{"term":"Statistics and probability","uri":"http://edamontology.org/topic_2269"}],"validated":1},"bioschemas":{"name":"MACPET","home":"https://bio.tools/macpet","license":"GPL-3.0","version":"1.0.0","summary":"It can be used for binding site analysis for ChIA-PET d