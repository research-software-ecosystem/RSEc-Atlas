{"tool_name":"opencarp","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"opencarp","home":"https://www.openCARP.org","license":"Other","summary":"openCARP is an open cardiac electrophysiology simulator for in-silico experiments. Its source code is public and the software is freely available for academic purposes. openCARP is easy to use and offers single cell as well as multiscale simulations from ion channel to organ level. Additionally, openCARP includes a wide variety of functions for pre- and post-processing of data as well as visualization. The python-based CARPutils framework enables the user to develop and share simulation pipelines, i.e. automating in-silico experiments including all modeling/simulation steps.","addition_date":"2021-04-08T08:33:01Z","last_update_date":"2021-04-08T08:46:19Z","tool_type":["Command-line tool","Workflow"],"version":["1.0-5.0"],"accessibility":"Open access","biotools_curie":"biotools:opencarp","cost":"Free of charge (with restrictions)","documentation":[{"note":"Different documentation material","type":["General"],"url":"https://opencarp.org/documentation"}],"edit_permission":{"type":"group"},"function":[{"operation":[{"term":"Modelling and simulation","uri":"http://edamontology.org/operation_2426"}]}],"maturity":"Mature","name":"openCARP","operating_system":["Linux","Mac"],"owner":"axel.loewe","publication":[{"doi":"10.1101/2021.03.01.433036"}],"topic":[{"term":"Biomedical science","uri":"http://edamontology.org/topic_3344"}]},"bioschemas":{"name":"openCARP","home":"https://bio.tools/opencarp","license":"Other","version":"1.0-5.0","summary":"openCARP is an open cardiac electrophysiology simulator for in-silico experiments. Its source code is public and the software is freely available for academic purposes. openCARP is easy to use and offers single cell as well as multiscale simulations from ion channel to organ level. Additionally, openCARP includes a wide variety of functions for pre- and post-p