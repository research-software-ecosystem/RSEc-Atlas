ied genomic region, ggsashimi creates sashimi plots for individual RNA-seq experiments as well as aggregated plots for groups of experiments, a feature unique to this software. Compared to the existing versions of programs generating sashimi plots, it uses popular bioinformatics file formats, it is annotation-independent, and allows the visualization of splicing events even for large genomic regions by scaling down the genomic segments between splice sites. ggsashimi is freely available at https://github.com/guigolab/ggsashimi. It is implemented in python, and internally generates R code for plotting.","authors":[{"name":"Breschi A."},{"name":"Garrido-Martin D."},{"name":"Guigo R."},{"name":"Palumbo E."}],"citationCount":129,"date":"2018-08-01T00:00:00Z","journal":"PLoS Computational Biology","title":"ggsashimi: Sashimi plot revised for browser- and annotation-independent splicing visualization"},"pmcid":"PMC6114895","pmid":"30118475"}],"topic":[{"term":"Data visualisation","uri":"http://edamontology.org/topic_0092"},{"term":"RNA splicing","uri":"http://edamontology.org/topic_3320"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}]},"bioschemas":{"name":"ggsashimi","home":"https://bio.tools/ggsashimi","license":"MIT","version":"1.0.0","summary":"Command-line tool for the visualization of splicing events across multiple samples","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ggsashimi/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":167,"citations":[{"cou