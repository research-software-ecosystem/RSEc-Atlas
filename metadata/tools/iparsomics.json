{"tool_name":"iparsomics","contents":["biotools"],"identifiers":["biotools:iparsomics"],"fetched_metadata":{"biotools":{"id":"iparsomics","home":"https://parsomics.org","license":"GPL-3.0","summary":"parsomics is a data management tool designed to integrate and organize massive datasets generated during metagenomics analysis. It builds a standardized PostgreSQL relational database locally, making data storage and retrieval efficient for prokaryotic metagenomics research.","addition_date":"2026-11-04T13:53:29.586108Z","last_update_date":"2026-11-04T13:53:29.588201Z","biotools_curie":"biotools:iparsomics","credit":[{"email":"gabriela.persinoti@lnbr.cnpem.br","name":"Gabriela Felix Persinoti","orcidid":"https://orcid.org/0000-0002-0975-7283","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Data retrieval","uri":"http://edamontology.org/operation_2422"},{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"parsomics: Metagenomics Data Integration Framework","owner":"pub2tools2024","publication":[{"doi":"10.1093/BIOADV/VBAG049","pmcid":"PMC13006488","pmid":"41878469"}],"topic":[{"term":"Cybersecurity","uri":"http://edamontology.org/topic_4045"},{"term":"Database management","uri":"http://edamontology.org/topic_3489"},{"term":"Metabarcoding","uri":"http://edamontology.org/topic_4038"},{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]}}}