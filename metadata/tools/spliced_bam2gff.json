s://openebench.bsc.es/monitor/metrics/spliced_bam2gff","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":null,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"publications":[],"readme":false,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":null,"resolve_time":null}}}]},"bioconda":{"name":"spliced_bam2gff","version":"1.3","home":"https://github.com/nanoporetech/spliced_bam2gff","documentation":"https://github.com/nanoporetech/spliced_bam2gff","license":"MPL-2","summary":"A tool to convert spliced BAM alignments into GFF2 format","description":"The spliced_bam2gff tool converts BAM alignments, produced by spliced aligners (such as minimap2, gmap), into a GFF2 format.\n\nBy default, introns are created based on the N cigar feature. Alternatively, if -d (i.e. for deletion) is specified, any deletions larger than the limit will be classified as an intron. The orientation of the GFF2 features is determined by the XS strand tag and SAM flags depending on the aligner.\n\nThe tool supports splitting the output into loci and bundles of loci with a minimum number of features, which enables easy parallelisation of downstream analyses. \n","license_file":"src/github.com/nanoporetech/spliced_bam2gff/LICENSE.md","build":{"binary_relocation":false,"number":1,"script":["pushd src/github.com/nanoporetech/spliced_bam2gff","export GOPATH=`readlink -f src/github.com/nanoporetech/spliced_bam2gff/gopath`","pwd -P","go get -v -u github.com/biogo/biogo/feat","go get -v -u github.com/biogo/hts/bam","go build -v","mkdir -p /bin","cp spliced_bam2gff /bin"]},"requirements":{"build":[null]},"source_url":"https://github.com/nanoporetech/spliced_bam2gff/archive/v1.3.tar.gz","test":{"commands":["spliced_bam2gff -h"]}}}}