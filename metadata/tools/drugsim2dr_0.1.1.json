{"tool_name":"drugsim2dr_0.1.1","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"drugsim2dr_0.1.1","home":"https://cran.r-project.org/web/packages/DrugSim2DR/","summary":"A systematic biology tool was developed to repurpose drugs via a drug-drug functional similarity network. 'DrugSim2DR' first predict drug-drug functional similarity in the context of specific disease, and then using the similarity constructed a weighted drug similarity network. Finally, it used a network propagation algorithm on the network to identify drugs with significant target abnormalities as candidate drugs.","addition_date":"2023-10-13T09:57:26.968130Z","last_update_date":"2023-10-13T09:57:26.970631Z","version":["0.1.1"],"biotools_curie":"biotools:drugsim2dr_0.1.1","edit_permission":{"type":"private"},"name":"DrugSim2DR_0.1.1","owner":"Json"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:drugsim2dr_0.1.1:0.1.1/undefined/cran.r-project.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{}},"project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/drugsim2dr_0.1.1","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}}]}}}