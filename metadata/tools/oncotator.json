{"tool_name":"oncotator","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"oncotator","identifiers":["biotools:oncotator","doi:10.1002/humu.22771"],"license":"Custom OSS","summary":"Oncotator is a tool for annotating human genomic point mutations and indels with data relevant to cancer researchers.","home_url":"https://github.com/broadinstitute/oncotator","keywords":["Computational Biology","Databases, Genetic","Genetic Variation","Genomics","Humans","Internet","Neoplasms","Web Browser","Oncology","Human biology","DNA mutation"],"manually_check":true,"total_pulls":0},"biotools":{"id":"oncotator","home":"http://www.broadinstitute.org/oncotator/","summary":"Web application to annotate point mutations and indels with functional data relevant to cancer researchers. Annotations include gene names, functional consequence (e.g. Missense), PolyPhen-2 predictions, and cancer-specific annotations from resources such as COSMIC, Tumorscape, and published MutSig results.","addition_date":"2017-08-03T18:53:17Z","last_update_date":"2024-11-25T14:26:13.177298Z","tool_type":["Web application"],"biotools_curie":"biotools:oncotator","credit":[{"email":"oncotator@broadinstitute.org","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://portals.broadinstitute.org/oncotator/about/"}],"documentation":[{"type":["General"],"url":"http://portals.broadinstitute.org/oncotator/"},{"type":["User manual"],"url":"http://portals.broadinstitute.org/oncotator/help/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Sequence annotation","uri":"http://edamontology.org/operation_0361"}]}],"name":"Oncotator","operating_system":["Linux","Mac","Windows"],"owner":"mbs_import","publication":[{"doi":"10.1002/humu.22771","metadata":{"abstract":"Oncotator is a tool for annotating genomic point mutations and short nucleotide insertions/deletions (indels) with variant- and gene-centric information relevant to cancer researchers. This information is drawn from 14 different publicly available resources that have been pooled and indexed, and we provide an extensible framework to add additional data sources. Annotations linked to variants range from basic information, such as gene names and functional classification (e.g. missense), to cancer-specific data from resources such as the Catalogue of Somatic Mutations in Cancer (COSMIC), the Cancer Gene Census, and The Cancer Genome Atlas (TCGA). For local use, Oncotator is freely available as a python module hosted on Github (https://github.com/broadinstitute/oncotator). Furthermore, Oncotator is also available as a web service and web application at http://www.broadinstitute.org/oncotator/.","authors":[{"name":"Getz G."},{"name":"Gupta M."},{"name":"Lawrence M.S."},{"name":"Lichtenstein L."},{"name":"Meyerson M."},{"name":"Pugh T.J."},{"name":"Ramos A.H."},{"name":"Saksena G."}],"citationCount":384,"date":"2015-04-01T00:00:00Z","journal":"Human Mutation","title":"Oncotator: Cancer variant annotation tool"},"pmcid":"PMC7350419","pmid":"25703262"}],"topic":[{"term":"DNA mutation","uri":"http://edamontology.org/topic_2533"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Human biology","uri":"http://edamontology.org/topic_2815"},{"term":"Oncology","uri":"http://edamontology.org/topic_2640"}],"validated":1},"bioschemas":{"name":"Oncotator","home":"https://bio.tools/oncotator","summary":"Web application to annotate point mutations and indels with functional data relevant to cancer researchers. Annotations include gene names, functional consequence (e.g. Missense), PolyPhen-2 predictions, and cancer-specific annotations from resources such as COSMIC, Tumorscape, and published MutSig results.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:oncotator/web/www.broadinstitute.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@typ