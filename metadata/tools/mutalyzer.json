{"tool_name":"mutalyzer","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"mutalyzer","home":"https://mutalyzer.nl","license":"CC-BY-4.0","summary":"Tool that checks, analyzes and corrects descriptions of sequence variants according to the standard human sequence variant nomenclature of the Human Genome Sequence Variation Society (HGVS).","addition_date":"2017-03-05T09:50:41Z","last_update_date":"2020-06-16T10:55:23Z","tool_type":["Command-line tool","Web application"],"collections":["Rare Disease"],"accessibility":"Open access","biotools_curie":"biotools:mutalyzer","cost":"Free of charge","credit":[{"email":"j.k.vis@lumc.nl","name":"Vis JK","typeEntity":"Person","typeRole":["Primary contact"],"url":"https://mutalyzer.nl/about"}],"documentation":[{"type":["General"],"url":"https://mutalyzer.nl/"}],"edit_permission":{"authors":["ELIXIR-NL"],"type":"group"},"function":[{"operation":[{"term":"Genetic variation analysis","uri":"http://edamontology.org/operation_3197"},{"term":"Text annotation","uri":"http://edamontology.org/operation_3778"},{"term":"Validation","uri":"http://edamontology.org/operation_2428"}]}],"maturity":"Mature","name":"Mutalyzer","operating_system":["Linux"],"owner":"ELIXIR-EE","publication":[{"doi":"10.1093/bioinformatics/btv443","metadata":{"abstract":"\u00a9 The Author 2015. Published by Oxford University Press. All rights reserved.Motivation: Unambiguous sequence variant descriptions are important in reporting the outcome of clinical diagnostic DNA tests. The standard nomenclature of the Human Genome Variation Society (HGVS) describes the observed variant sequence relative to a given reference sequence. We propose an efficient algorithm for the extraction of HGVS descriptions from two sequences with three main requirements in mind: minimizing the length of the resulting descriptions, minimizing the computation time and keeping the unambiguous descriptions biologically meaningful. Results: Our algorithm is able to compute the HGVS descriptions of complete chromosomes or other large DNA strings in a reasonable amount of computation time and its resulting descriptions are relatively small. Additional applications include updating of gene variant database contents and reference sequence liftovers.","authors":[{"name":"Kok J.N."},{"name":"Laros J.F.J."},{"name":"Taschner P.E.M."},{"name":"Vermaat M."},{"name":"Vis J.K."}],"citationCount":13,"date":"2015-06-18T00:00:00Z","journal":"Bioinformatics","title":"An efficient algorithm for the extraction of HGVS variant descriptions from sequences"},"pmid":"26231427","type":["Primary"]}],"topic":[{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"Genetics","uri":"http://edamontology.org/topic_3053"},{"term":"Personalised medicine","uri":"http://edamontology.org/topic_3577"},{"term":"Rare diseases","uri":"http://edamontology.org/topic_3325"}],"validated":1},"bioschemas":{"name":"Mutalyzer","home":"https://bio.tools/mutalyzer","license":"CC-BY-4.0","summary":"Tool that checks, analyzes and corrects descriptions of sequence variants according to the standard human sequence variant nomenclature of the Human Genome Sequence Variation Society (HGVS).","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mutalyzer/cmd/mutalyzer.nl","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":17,"citations":[{"count":1,"year":"2016"},{"count":1,"year":"2018"},{"count":1,"year":"2020"},{"count":1,"year":"2022"},{"coun