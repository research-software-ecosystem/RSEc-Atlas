{"tool_name":"bioconductor-microstasis","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-microstasis","home":"https://bioconductor.org/packages/microSTASIS","license":"GPL-3.0","summary":"The toolkit '\u00b5STASIS', or microSTASIS, has been developed for the stability analysis of microbiota in a temporal framework by leveraging on iterative clustering. Concretely, the core function uses Hartigan-Wong k-means algorithm as many times as possible for stressing out paired samples from the same individuals to test if they remain together for multiple numbers of clusters over a whole data set of individuals. Moreover, the package includes multiple functions to subset samples from paired times, validate the results or visualize the output.","tool_type":["Command-line tool","Library"],"version":["1.12.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-microstasis","credit":[{"name":"Alfonso Ben\u00edtez-P\u00e1ez","typeEntity":"Person","typeRole":["Developer"]},{"name":"Pedro S\u00e1nchez-S\u00e1nchez","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/microSTASIS"}],"name":"microSTASIS","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-microstasis:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-microstasis:1.2.0/cmd/bioconductor.org","@license":"https://