{"tool_name":"fair-bioheaders","contents":["bioconda","biotools","galaxy"],"identifiers":["biotools:fair-bioheaders","bioconda:fair-bioheaders","galaxy:fair_bioheaders"],"fetched_metadata":{"biotools":{"id":"fair-bioheaders","home":"https://github.com/FAIR-bioHeaders/FAIR-bioHeaders-Tools","license":"MPL-2.0","summary":"Toolkit for FAIR-bioHeaders (FHR) metadata on genomic data files. It embeds validated provenance metadata headers with a checksum in FASTA, GFA and GFF3 files (combine), strips and verifies them, validates metadata against the FHR, FHP and FHGFF3 schemas, converts metadata between JSON, YAML, JSON-LD and HTML microdata, and assesses FAIRness. It ships as a Python library and command-line tool (bioheaders), with Galaxy tool wrappers, nf-core-style Nextflow modules and a Nextflow workflow.","addition_date":"2026-10-22T02:32:46.868155Z","last_update_date":"2026-10-22T04:05:31.461496Z","tool_type":["Command-line tool","Library","Workflow"],"version":["0.8.1"],"accessibility":"Open access","biotools_curie":"biotools:fair-bioheaders","cost":"Free of charge","credit":[{"email":"molik@fhref.org","name":"David Molik","orcidid":"https://orcid.org/0000-0003-3192-6538","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"email":"wright@fhref.org","name":"Adam Wright","orcidid":"https://orcid.org/0000-0002-5719-4024","typeEntity":"Person","typeRole":["Developer","Maintainer","Primary contact"]}],"documentation":[{"note":"FAIR-bioHeaders specification.","type":["General"],"url":"https://fhref.org/FAIR-bioHeaders-Specification/"},{"type":["Citation instructions"],"url":"https://github.com/FAIR-bioHeaders/FAIR-bioHeaders-Tools/blob/main/CITATION.cff"},{"type":["Code of conduct"],"url":"https://github.com/FAIR-bioHeaders/FAIR-bioHeaders-Tools/blob/main/CODE_OF_CONDUCT.md"},{"type":["Command-line options","Installation instructions","User manual"],"url":"https://github.com/FAIR-bioHeaders/FAIR-bioHeaders-Tools#readme"},{"type":["Contributions policy"],"url":"https://github.com/FAIR-bioHeaders/FAIR-bioHeaders-Tools/blob/main/CONTRIBUTING.md"},{"type":["Release notes"],"url":"https://github.com/FAIR-bioHeaders/FAIR-bioHeaders-Tools/blob/main/CHANGELOG.md"}],"edit_permission":{"type":"private"},"function":[{"cmd":"bioheaders combine metadata.yaml genome.fa -o genome.fhr.fa","input":[{"data":{"term":"Resource metadata","uri":"http://edamontology.org/data_2337"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"},{"term":"JSON","uri":"http://edamontology.org/format_3464"},{"term":"JSON-LD","uri":"http://edamontology.org/format_3749"},{"term":"YAML","uri":"http://edamontology.org/format_3750"}]},{"data":{"term":"Sequence","uri":"http://edamontology.org/data_2044"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]},{"data":{"term":"Sequence assembly","uri":"http://edamontology.org/data_0925"},"format":[{"term":"GFA 1","uri":"http://edamontology.org/format_3975"},{"term":"GFA 2","uri":"http://edamontology.org/format_3976"}]},{"data":{"term":"Sequence features","uri":"http://edamontology.org/data_1255"},"format":[{"term":"GFF3","uri":"http://edamontology.org/format_1975"}]}],"note":"combine: embed FHR (FASTA, GFA) or FHGFF3 (GFF3) metadata as a header with a computed checksum; plain or gzip/BGZF input.","operation":[{"term":"Annotation","uri":"http://edamontology.org/operation_0226"},{"term":"Data formatting","uri":"http://edamontology.org/operation_0335"}],"output":[{"data":{"term":"Sequence","uri":"http://edamontology.org/data_2044"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]},{"data":{"term":"Sequence assembly","uri":"http://edamontology.org/data_0925"},"format":[{"term":"GFA 1","uri":"http://edamontology.org/format_3975"},{"term":"GFA 2","uri":"http://edamontology.org/format_3976"}]},{"data":{"term":"Sequence features","uri":"http://edamontology.org/data_1255"},"format":[{"term":"GFF3","uri":"http://edamontology.org/format_1975"}]}]},{"cmd":"bioheaders convert genome.fhr.yaml genome.fhr.json","input":[{"data":{"term":"Resource metadata","uri":"http://edamontology.org/data_2337"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"},{"term":"JSON","uri":"http://edamontology.org/format_3464"},{"term":"JSON-LD","uri":"http://edamontology.org/format_3749"},{"term":"YAML","uri":"http://edamontology.org/format_3750"}]}],"note":"convert: convert FAIR-bioHeaders metadata between JSON, YAML, JSON-LD and HTML microdata, or extract it from a headed FASTA, GFA or GFF3 file.","operation":[{"term":"Conversion","uri":"http://edamontology.org/operation_3434"}],"output":[{"data":{"term":"Resource metadata","uri":"http://edamontology.org/data_2337"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"},{"term":"JSON","uri":"http://edamontology.org/format_3464"},{"term":"JSON-LD","uri":"http://edamontology.org/format_3749"},{"term":"YAML","uri":"http://edamontology.org/format_3750"}]}]},{"cmd":"bioheaders verify genome.fhr.fa","input":[{"data":{"term":"Resource metadata","uri":"http://edamontology.org/data_2337"},"format":[{"term":"JSON","uri":"http://edamontology.org/format_3464"},{"term":"JSON-LD","uri":"http://edamontology.org/format_3749"},{"term":"YAML","uri":"http://edamontology.org/format_3750"}]},{"data":{"term":"Sequence","uri":"http://edamontology.org/data_2044"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]},{"data":{"term":"Sequence assembly","uri":"http://edamontology.org/data_0925"},"format":[{"term":"GFA 1","uri":"http://edamontology.org/format_3975"},{"term":"GFA 2","uri":"http://edamontology.org/format_3976"}]},{"data":{"term":"Sequence features","uri":"http://edamontology.org/data_1255"},"format":[{"term":"GFF3","uri":"http://edamontology.org/format_1975"}]}],"note":"verify and validate: check a header or metadata file against the FHR, FHP or FHGFF3 schema and check the header checksum against the file content.","operation":[{"term":"Format validation","uri":"http://edamontology.org/operation_0336"}],"output":[{"data":{"term":"Report","uri":"http://edamontology.org/data_2048"}}]}],"maturity":"Emerging","name":"FAIR-bioHeaders Tools","operating_system":["Linux","Mac","Windows"],"owner":"adam7","publication":[{"doi":"10.5281/zenodo.6762547","note":"Zenodo concept DOI of the toolkit (all versions).","type":["Other"]},{"doi":"10.1093/bib/bbae122","type":["Primary"]}],"topic":[{"term":"Data curation and archival","uri":"http://edamontology.org/topic_0219"},{"term":"Data management","uri":"http://edamontology.org/topic_3071"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}]},"bioconda":{"name":"fair-bioheaders","version":"0.9.0","home":"https://github.com/FAIR-bioHeaders/FAIR-bioHeaders-Tools","documentation":"https://fhref.org/FAIR-bioHeaders-Specification/","license":"MPL-2.0","summary":"Validate and convert FAIR-bioHeaders metadata for genome FASTA and GFA (FHR), protein FASTA (FHP) and GFF3 (FHGFF3).","identifiers":["biotools:fair-bioheaders","doi:10.1093/bib/bbae122","doi:10.5281/zenodo.6762547"],"description":"FAIR-bioHeaders embed provenance metadata in reference genome FASTA and GFA\nfiles (the FHR header). These tools convert between JSON, YAML, JSON-LD,\nHTML microdata and embedded FASTA/GFA headers, validate metadata against\nthe schema, attach and strip headers, and verify the SHA-512/256 file\nchecksum. They also read, write and verify the draft headers for protein\nFASTA (FHP) and GFF3 annotations (FHGFF3). bioheaders assess checks how\nFAIR the header of a FASTA, GFF3, VCF, GFA or other text file is.\nPlain and gzip/bgzip-compressed files are streamed with bounded memory.\nFormerly published on PyPI as fhr; the fhr-* commands are kept.\n","license_file":"LICENSE","build":{"entry_points":["bioheaders = bioheaders.cli:main","fhr-convert = bioheaders.cli:convert_main","fhr-validate = bioheaders.cli:validate_main","fhr-fasta-strip = bioheaders.cli:fasta_strip_main","fhr-fasta-combine = bioheaders.cli:fasta_combine_main","fhr-fasta-validate = bioheaders.cli:fasta_validate_main","fhr-gfa-strip = bioheaders.cli:gfa_strip_main","fhr-gfa-combine = bioheaders.cli:gfa_combine_main","fhr-gfa-validate = bioheaders.cli:gfa_validate_main","fhr-gff3-strip = bioheaders.cli:gff3_strip_main","fhr-gff3-combine = bioheaders.cli:gff3_combine_main","fhr-gff3-validate = bioheaders.cli:gff3_validate_main"],"noarch":"python","number":0,"run_exports":[null],"script":"-m pip install . --no-deps --no-build-isolation --no-cache-dir -vvv"},"requirements":{"host":["python 3.11.*","pip","poetry-core >=1.0.0"],"run":["python >=3.11","jsonschema-with-format >=4.21.1,<5","pyyaml >=6.0.1,<7","pyld >=3.3"]},"source_url":"https://pypi.org/packages/source/f/fair-bioheaders/fair_bioheaders-0.9.0.tar.gz","test":{"commands":["python -m pip check","bioheaders --version","bioheaders validate --help","bioheaders assess --help","fhr-convert --version","fhr-validate --help","fhr-fasta-combine --help","fhr-fasta-strip --help","fhr-fasta-validate --help","fhr-gfa-combine --help","fhr-gfa-strip --help","fhr-gfa-validate --help","fhr-gff3-combine --help","fhr-gff3-strip --help","fhr-gff3-validate --help","printf '{\"schema\":\"https://w3id.org/fair-bioheaders/fhr/v0.4.0\",\"schemaVersion\":\"2.0\",\"genome\":\"test\",\"taxon\":{\"name\":\"Homo sapiens\",\"uri\":\"https://identifiers.org/taxonomy:9606\"},\"version\":\"1\",\"metadataAuthor\":[{\"name\":\"A\"}],\"assemblyAuthor\":[{\"name\":\"B\"}],\"dateCreated\":\"2024-01-01\",\"masking\":\"unknown\",\"checksum\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=\"}' > test.fhr.json","printf '>s1\\nACGT\\n' > test.fasta","bioheaders validate test.fhr.json","bioheaders combine test.fhr.json test.fasta -o test.fhr.fasta","bioheaders verify test.fhr.fasta","bioheaders convert test.fhr.json test.fhr.jsonld","python -c \"import json;d=json.load(open('test.fhr.jsonld'));c=d.pop('@context');json.dump({'@context':c,'@graph':[d]},open('graph.jsonld','w'))\"","bioheaders validate graph.jsonld"],"imports":["bioheaders","bioheaders.cli","fhr"],"requires":["python 3.11","pip"]},"recipe_maintainers":["adamjohnwright"]},"galaxy":{"version":"0.8.5","first_commit":"2026-10-27","conda_name":"fair-bioheaders","conda_version":"0.8.6","summary":"Add, verify, remove and convert FAIR-bioHeaders metadata headers in FASTA, GFA and GFF3","edam_operations":["Data formatting","Annotation","Format validation","Conversion"],"edam_topics":["Data curation and archival","Sequence analysis","Data management"],"toolshed_categories":["Sequence Analysis","Convert Formats"],"toolshed_id":"fair_bioheaders","users_5_years":0,"users_all_time":0,"usage_5_years":0,"usage_all_time":0,"bio_tools_summary":"Toolkit for FAIR-bioHeaders (FHR) metadata on genomic data files. It embeds validated provenance metadata headers with a checksum in FASTA, GFA and GFF3 files (combine), strips and verifies them, validates metadata against the FHR, FHP and FHGFF3 schemas, converts metadata between JSON, YAML, JSON-LD and HTML microdata, and assesses FAIRness. It ships as a Python library and command-line tool (bioheaders), with Galaxy tool wrappers, nf-core-style Nextflow modules and a Nextflow workflow.","bio_tools_ids":"fair-bioheaders","bio_tools_name":"FAIR-bioHeaders Tools","related_tutorials":[],"related_workflows":[],"tool_ids":["fair_bioheaders_combine","fair_bioheaders_convert","fair_bioheaders_strip","fair_bioheaders_verify"],"tool_output_formats":["yaml","txt"],"homepage":"https://github.com/FAIR-bioHeaders/FAIR-bioHeaders-Tools","suite_source":"https://github.com/galaxyproject/tools-iuc/tree/main/tools/fair_bioheaders","suite_owner":"iuc","suite_parsed_folder":"https://github.com/galaxyproject/tools-iuc/tree/master/tools/fair_bioheaders","suite_version_status":"To update","no_of_tools":{"eu":4,"org":0,"org.au":0,"be":0,"cz":0,"fr":0,"no":0,"chemflow":0,"aubi":0,"pasteur":0,"trakr":0,"hyphy":0,"ipk":0,"immport":0,"interactomix":0,"lebanese":0,"mbac":0,"mississippi":