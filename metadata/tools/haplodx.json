{"tool_name":"haplodx","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"haplodx","home":"https://github.com/remytuyeras/HaploDynamics","license":"GPL-3.0","summary":"The HaploDX library provides a collection of functions to generate simulated population-specific genomic data in VCF format. The library includes parameters and functions to control mutation rates, linkage disequilibrium strength and block lengths, and number of individuals. To generate genomic data, the HaploDX framework offers a pipeline of functions that can be used to simulate: (1) the allele frequency spectra of different populations; (2) the Hardy-Weinberg principle for genotypes and haplotypes; (3) linkage disequilibrium across different populations.","addition_date":"2023-08-10T06:34:50.688270Z","last_update_date":"2023-08-10T06:58:47.053221Z","tool_type":["Library"],"version":["0.2-beta.4"],"accessibility":"Open access","biotools_curie":"biotools:haplodx","cost":"Free of charge","documentation":[{"note":"Documentation on Github page","type":["API documentation"],"url":"https://github.com/remytuyeras/HaploDynamics#documentation"}],"edit_permission":{"type":"private"},"function":[{"cmd":"import HaploDynamics.HaploDX as hdx\n\nsimulated_data = hdx.genmatrix([20,5,20,35,30,15],strength=1,population=0.1,Npop=1000)\nhdx.create_vcfgz(\"genomic-data.simulation.v1\",*simulated_data)","operation":[{"term":"Modelling and simulation","uri":"http://edamontology.org/operation_2426"},{"term":"Nucleic acid sequence analysis","uri":"http://edamontology.org/operation_2478"}]}],"maturity":"Emerging","name":"HaploDX","operating_system":["Linux","Mac","Windows"],"owner":"rtuyeras","topic":[{"term":"Biological databases","uri":"http://edamontology.org/topic_3071"},{"term":"DNA mutation","uri":"http://edamontology.org/topic_2533"},{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"Experimental design and studies","uri":"http://edamontology.org/topic_3678"},{"term":"GWAS study","uri":"http://edamontology.org/topic_3517"},{"term":"Genetics","uri":"http://edamontology.org/topic_3053"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Nucleic acids","uri":"http://edamontology.org/topic_0077"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:haplodx:0.2-beta.4/lib/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"api":true},"license":{"open_source":true,"osi":true},"publications":[],"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/haplodx","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}}]}}}