{"tool_name":"biasaway","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"biasaway","identifiers":["doi:10.1093/bioinformatics/btaa928"],"license":"GPL-3.0","summary":"Biasaway: a tool to generate composition-matched background sequences","home_url":"https://bitbucket.org/CBGR/biasaway","keywords":[],"manually_check":true,"total_pulls":16},"biotools":{"id":"biasaway","home":"https://biasaway.uio.no","license":"GPL-3.0","summary":"BiasAway is a command-line and web server to generate nucleotide composition-matched DNA background sequences. The BiasAway tool provides users with six approaches to generate synthetic or genomic background sequences matching mono- and Dinucleotide composition of user-provided foreground sequences.","addition_date":"2021-01-18T11:48:27Z","last_update_date":"2024-11-24T20:46:09.680493Z","tool_type":["Command-line tool","Web application"],"biotools_curie":"biotools:biasaway","credit":[{"email":"anthony.mathelier@ncmm.uio.no","name":"Anthony Mathelier","typeEntity":"Person"}],"documentation":[{"type":["User manual"],"url":"https://biasaway.readthedocs.io"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Enrichment analysis","uri":"http://edamontology.org/operation_3501"},{"term":"Sequence motif analysis","uri":"http://edamontology.org/operation_2404"},{"term":"Sequencing quality control","uri":"http://edamontology.org/operation_3218"}]}],"name":"BiasAway","owner":"Kigaard","publication":[{"doi":"10.1093/bioinformatics/btaa928","metadata":{"abstract":"Motivation: Accurate motif enrichment analyses depend on the choice of background DNA sequences used, which should ideally match the sequence composition of the foreground sequences. It is important to avoid false positive enrichment due to sequence biases in the genome, such as GC-bias. Therefore, relying on an appropriate set of background sequences is crucial for enrichment analysis. Results: We developed BiasAway, a command line tool and its dedicated easy-to-use web server to generate synthetic sequences matching any k-mer nucleotide composition or select genomic DNA sequences matching the mononucleotide composition of the foreground sequences through four different models. For genomic sequences, we provide precomputed partitions of genomes from nine species with five different bin sizes to generate appropriate genomic background sequences.","authors":[{"name":"Boddie P."},{"name":"Khan A."},{"name":"Mathelier A."},{"name":"Puig R.R."}],"citationCount":12,"date":"2021-06-01T00:00:00Z","journal":"Bioinformatics","title":"BiasAway: command-line and web server to generate nucleotide composition-matched DNA background sequences"},"pmcid":"PMC8275979","pmid":"33135764"}],"topic":[{"term":"ChIP-seq","uri":"http://edamontology.org/topic_3169"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Sequence composition, complexity and repeats","uri":"http://edamontology.org/topic_0157"},{"term":"Sequence sites, features and motifs","uri":"http://edamontology.org/topic_0160"}]},"bioschemas":{"name":"BiasAway","home":"https://bio.tools/biasaway","license":"GPL-3.0","summary":"BiasAway is a command-line and web server to generate nucleotide composition-matched DNA background sequences. The BiasAway tool provides users with six approaches to generate synthetic or genomic background sequences matching mono- and Dinucleotide composition of user-provided foreground sequences.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:biasaway/cmd/biasaway.uio.no","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"repository":{}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{