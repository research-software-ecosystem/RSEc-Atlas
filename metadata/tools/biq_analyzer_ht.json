{"tool_name":"biq_analyzer_ht","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"biq_analyzer_ht","home":"http://biq-analyzer-ht.bioinf.mpi-inf.mpg.de/","summary":"BiQ Analyzer HT is an enhanced version of BiQ Analyzer that supports locus-specific analysis and visualization of high-throughput bisulfite sequencing data.","addition_date":"2017-01-13T13:13:49Z","last_update_date":"2024-11-24T20:35:25.349957Z","tool_type":["Desktop application"],"collections":["HD-Hub","de.NBI"],"biotools_curie":"biotools:biq_analyzer_ht","credit":[{"email":"plutsik@mpi-inf.mpg.de","name":"Pavlo Lutsik","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://biq-analyzer-ht.bioinf.mpi-inf.mpg.de/documentation.php"}],"edit_permission":{"authors":["ELIXIR-EE","Karl_JV"],"type":"group"},"function":[{"operation":[{"term":"Data handling","uri":"http://edamontology.org/operation_2409"},{"term":"Methylation analysis","uri":"http://edamontology.org/operation_3204"},{"term":"Sequence visualisation","uri":"http://edamontology.org/operation_0564"}]}],"maturity":"Mature","name":"BiQ Analyzer HT","operating_system":["Linux","Mac","Windows"],"owner":"hdhub","publication":[{"doi":"10.1093/nar/gkr312","metadata":{"abstract":"Bisulfite sequencing is a widely used method for measuring DNA methylation in eukaryotic genomes. The assay provides single-base pair resolution and, given sufficient sequencing depth, its quantitative accuracy is excellent. High-throughput sequencing of bisulfite-converted DNA can be applied either genome wide or targeted to a defined set of genomic loci (e.g. using locus-specific PCR primers or DNA capture probes). Here, we describe BiQ Analyzer HT (http://biq-analyzer-ht.bioinf.mpi-inf.mpg.de/), a user-friendly software tool that supports locus-specific analysis and visualization of high-throughput bisulfite sequencing data. The software facilitates the shift from time-consuming clonal bisulfite sequencing to the more quantitative and cost-efficient use of high-throughput sequencing for studying locus-specific DNA methylation patterns. In addition, it is useful for locus-specific visualization of genome-wide bisulfite sequencing data. \u00a9 2011 The Author(s).","authors":[{"name":"Arand J."},{"name":"Bock C."},{"name":"Feuerbach L."},{"name":"Lengauer T."},{"name":"Lutsik P."},{"name":"Walter J."}],"citationCount":103,"date":"2011-07-01T00:00:00Z","journal":"Nucleic Acids Research","title":"BiQ Analyzer HT: Locus-specific analysis of DNA methylation by high-throughput bisulfite sequencing"},"pmcid":"PMC3125748","pmid":"21565797"}],"topic":[{"term":"Data mining","uri":"http://edamontology.org/topic_3473"},{"term":"Data visualisation","uri":"http://edamontology.org/topic_0092"},{"term":"Epigenetics","uri":"http://edamontology.org/topic_3295"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"bioschemas":{"name":"BiQ Analyzer HT","home":"https://bio.tools/biq_analyzer_ht","summary":"BiQ Analyzer HT is an enhanced version of BiQ Analyzer that supports locus-specific analysis and visualization of high-throughput bisulfite sequencing data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:biq_analyzer_ht/app/biq-analyzer-ht.bioinf.mpi-inf.mpg.de","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"packages":true,"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":67,"citations":[{"count":1,"year":"2023"},{"count":1,"year":"2024"},{"count":1,"year":"2026"},{"count":2,"year":"2011"},{"count":2,"year":"2020"},{"count":3,"year":"2019"},{"count":4,"year":"2016"},{"count":4,"year":"2017"},{"count":5,"year":"2018"},{"count":6,"year":"2012"},{"count":6,"year":"2014"},{"count":7,"year":"2022"},{"count":8,"y