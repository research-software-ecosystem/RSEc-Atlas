{"tool_name":"snow","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"snow","home":"http://snow.bioinfo.cipf.es","summary":"SNOW is a web-based tool for the statistical analysis of protein-protein interaction networks. Input is a collection of protein or gene indentifiers onto the interactome scaffold. Output includes statistical significance estimates.","addition_date":"2017-02-14T09:35:41Z","last_update_date":"2018-12-10T12:58:53Z","tool_type":["Web application"],"biotools_curie":"biotools:snow","credit":[{"email":"babelomics@cipf.es","name":"BABELOMICS Support","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/babelomics/babelomics/wiki"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Pathway or network prediction","uri":"http://edamontology.org/operation_3439"},{"term":"Pathway or network visualisation","uri":"http://edamontology.org/operation_3083"},{"term":"Protein interaction analysis","uri":"http://edamontology.org/operation_2949"},{"term":"Protein interaction network analysis","uri":"http://edamontology.org/operation_0276"},{"term":"Scaffolding","uri":"http://edamontology.org/operation_3216"}]}],"name":"SNOW","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"metadata":{"abstract":"Understanding the structure and the dynamics of the complex intercellular network of interactions that contributes to the structure and function of a living cell is one of the main challenges of today's biology. SNOW inputs a collection of protein (or gene) identifiers and, by using the interactome as scaffold, draws the connections among them, calculates several relevant network parameters and, as a novelty among the rest of tools of its class, it estimates their statistical significance. The parameters calculated for each node are: connectivity, betweenness and clustering coefficient. It also calculates the number of components, number of bicomponents and articulation points. An interactive network viewer is also available to explore the resulting network. SNOW is available at http://snow.bioinfo.cipf.es.","authors":[{"name":"Al-Shahrour F."},{"name":"Dopazo J."},{"name":"Gotz S."},{"name":"Minguez P."},{"name":"Montaner D."}],"citationCount":38,"date":"2009-08-04T00:00:00Z","journal":"Nucleic Acids Research","title":"SNOW, a web-based tool for the statistical analysis of protein-protein interaction networks"},"pmid":"19454602"}],"topic":[{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Protein interaction experiment","uri":"http://edamontology.org/topic_3557"},{"term":"Protein interactions","uri":"http://edamontology.org/topic_0128"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"},{"term":"Statistics and probability","uri":"http://edamontology.org/topic_2269"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:snow/web/snow.bioinfo.cipf.es","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":31,"citations":[{"count":1,"year":"2010"},{"count":1,"year":"2018"},{"count":1,"year":"2019"},{"count":1,"year":"2020"},{"count":1,"year":"2021"},{"count":1,"year":"2023"},{"count":2,"year":"2011"},{"count":2,"year":"2013"},{"count":2,"year":"2017"},{"count":2,"year":"2025"},{"count":3,"year":"2014"},{"count":3,"year":"2016"},{"count":5,"year":"2015"},{"count":6,"year":"2012"}],"doi":"10.1093/nar/gkp402","pmcid":"PMC2703972","pmid":"19454602","ref_count":38,"refs":[{"count":1,"year":"1999"