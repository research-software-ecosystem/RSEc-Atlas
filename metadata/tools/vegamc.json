{"tool_name":"vegamc","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-vegamc","version":"3.48.0","home":"https://bioconductor.org/packages/3.22/bioc/html/VegaMC.html","license":"GPL-2","summary":"VegaMC: A Package Implementing a Variational Piecewise Smooth Model for Identification of Driver Chromosomal Imbalances in Cancer","identifiers":["biotools:vegamc","doi:10.1093/bioinformatics/bts453"],"description":"This package enables the detection of driver chromosomal imbalances including loss of heterozygosity (LOH) from array comparative genomic hybridization (aCGH) data. VegaMC performs a joint segmentation of a dataset and uses a statistical framework to distinguish between driver and passenger mutation. VegaMC has been implemented so that it can be immediately integrated with the output produced by PennCNV tool. In addition, VegaMC produces in output two web pages that allows a rapid navigation between both the detected regions and the altered genes. In the web page that summarizes the altered genes, the link to the respective Ensembl gene web page is reported.","license_file":"/lib/R/share/licenses/GPL-2","build":{"number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"build":[null,"make"],"host":["bioconductor-biobase >=2.70.0,<2.71.0","bioconductor-biomart >=2.66.0,<2.67.0","r-base","libblas","liblapack","zlib","liblzma-devel"],"run":["bioconductor-biobase >=2.70.0,<2.71.0","bioconductor-biomart >=2.66.0,<2.67.0","r-base"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/VegaMC_3.48.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/VegaMC/VegaMC_3.48.0.tar.gz","https://bioarchive.galaxyproject.org/VegaMC_3.48.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-vegamc/bioconductor-vegamc_3.48.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('VegaMC')\""]},"parent_recipe":{"name":"bioconductor-vegamc","path":"recipes/b