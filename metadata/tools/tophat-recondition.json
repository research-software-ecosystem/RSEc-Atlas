{"tool_name":"tophat-recondition","contents":["biocontainers","bioschemas","debian","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"tophat-recondition","version":"1.4","home":"https://github.com/cbrueffer/tophat-recondition","license":"BSD-2-Clause","summary":"Post-processor for TopHat unmapped reads","identifiers":["biotools:tophat-recondition","doi:10.1186/s12859-016-1058-x"],"build":{"noarch":"generic","number":4},"requirements":{"run":["python","pysam"]},"source_url":"https://github.com/cbrueffer/tophat-recondition/archive/v1.4.tar.gz","test":{"commands":["(tophat-recondition -v 2>&1) > /dev/null"]},"recipe_maintainers":["cbrueffer"]},"biocontainers":{"name":"tophat-recondition","identifiers":["biotools:tophat-recondition","doi:10.1186/s12859-016-1058-x"],"license":"Not available","summary":"Post-processor for tophat unmapped reads","home_url":"https://github.com/cbrueffer/tophat-recondition","keywords":["Computational Biology","RNA","RNA Splicing","Sequence Alignment","Sequence Analysis, RNA","Computational biology","Genomics"],"manually_check":true,"total_pulls":0},"biotools":{"id":"tophat-recondition","home":"https://github.com/cbrueffer/tophat-recondition","license":"BSD-2-Clause","summary":"A post-processor for TopHat/TopHat2 data that corrects several issues in the original data.","addition_date":"2020-07-15T10:44:57Z","last_update_date":"2024-11-24T20:58:41.323855Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:tophat-recondition","cost":"Free of charge","credit":[{"email":"christian.brueffer@med.lu.se","name":"Christian Brueffer","orcidid":"https://orcid.org/0000-0002-3826-0989"},{"email":"lao.saal@med.lu.se","name":"Lao H. Saal","orcidid":"https://orcid.org/0000-0002-0815-1896"}],"edit_permission":{"type":"private"},"maturity":"Mature","name":"TopHat-Recondition","owner":"cbrueffer","publication":[{"doi":"10.1186/s12859-016-1058-x","metadata":{"abstract":"Background: TopHat is a popular spliced junction mapper for RNA sequencing data, and writes files in the BAM format - the binary version of the Sequence Alignment/Map (SAM) format. BAM is the standard exchange format for aligned sequencing reads, thus correct format implementation is paramount for software interoperability and correct analysis. However, TopHat writes its unmapped reads in a way that is not compatible with other software that implements the SAM/BAM format. Results: We have developed TopHat-Recondition, a post-processor for TopHat unmapped reads that restores read information in the proper format. TopHat-Recondition thus enables downstream software to process the plethora of BAM files written by TopHat. Conclusions: TopHat-Recondition can repair unmapped read files written by TopHat and is freely available under a 2-clause BSD license on GitHub: https://github.com/cbrueffer/tophat-recondition.","authors":[{"name":"Brueffer C."},{"name":"Saal L.H."}],"citationCount":11,"date":"2016-05-04T00:00:00Z","journal":"BMC Bioinformatics","title":"TopHat-Recondition: A post-processor for TopHat unmapped reads"},"pmcid":"PMC4855331","pmid":"27142976"}],"topic":[{"term":"Computational biology","uri":"http://edamontology.org/topic_3307"}],"validated":1},"bioschemas":{"name":"TopHat-Recondition","home":"https://bio.tools/tophat-recondition","license":"BSD-2-Clause","summary":"A post-processor for TopHat/TopHat2 data that corrects several issues in the original data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:tophat-recondition/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"license":{"open_source":tru