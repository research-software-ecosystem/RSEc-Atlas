{"tool_name":"fusion","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"fusion","home":"https://fusion.cebitec.uni-bielefeld.de","license":"GPL-3.0","summary":"Web application for the integrative analysis of omics data providing a collection of new and established tools and visualization methods to support researchers in exploring multi-level omics data. The software focuses on data-rich high-throughout experiments from transcriptomics, proteomics and/or metabolomics, and offers convenient functionality for a) omics data manipulation, b) data analysis, c) cluster analysis, d) data visualization.","addition_date":"2017-05-08T10:31:53Z","last_update_date":"2026-02-04T22:38:42.566746Z","tool_type":["Web application"],"collections":["Proteomics","Transcriptomics","de.NBI","de.NBI-BiGi"],"accessibility":"Open access","biotools_curie":"biotools:fusion","cost":"Free of charge","credit":[{"email":"fusion-service@cebitec.uni-bielefeld.de","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.cebitec.uni-bielefeld.de/brf/index.php/fusion"}],"documentation":[{"type":["User manual"],"url":"https://fusion.cebitec.uni-bielefeld.de/QuickStartGuide.pdf"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"input":[{"data":{"term":"Gene expression matrix","uri":"http://edamontology.org/data_3112"},"format":[{"term":"xlsx","uri":"http://edamontology.org/format_3620"}]}],"operation":[{"term":"Box-Whisker plot plotting","uri":"http://edamontology.org/operation_2943"},{"term":"Data retrieval","uri":"http://edamontology.org/operation_2422"},{"term":"Enrichment analysis","uri":"http://edamontology.org/operation_3501"},{"term":"Gene expression clustering","uri":"http://edamontology.org/operation_0313"},{"term":"Gene expression correlation","uri":"http://edamontology.org/operation_3463"},{"term":"Gene to pathway mapping","uri":"http://edamontology.org/operation_0533"},{"term":"Heat map generation","uri":"http://