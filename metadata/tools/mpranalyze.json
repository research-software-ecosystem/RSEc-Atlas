{"tool_name":"mpranalyze","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"MPRAnalyze","home":"https://bioconductor.org/packages/MPRAnalyze","license":"GPL-3.0","summary":"MPRAnalyze provides statistical framework for the analysis of data generated by Massively Parallel Reporter Assays (MPRAs), used to directly measure enhancer activity. MPRAnalyze can be used for quantification of enhancer activity, classification of active enhancers and comparative analyses of enhancer activity between conditions. MPRAnalyze construct a nested pair of generalized linear models (GLMs) to relate the DNA and RNA observations, easily adjustable to various experimental designs and conditions, and provides a set of rigorous statistical testig schemes.","addition_date":"2019-11-14T19:45:47Z","last_update_date":"2020-12-29T10:22:08Z","tool_type":["Command-line tool"],"version":["1.30.0"],"collections":["BioConductor"],"biotools_curie":"biotools:MPRAnalyze","credit":[{"name":"Anat Kriemer","typeEntity":"Person","typeRole":["Contributor"]},{"name":"David S Fischer","typeEntity":"Person","typeRole":["Developer"]},{"name":"Fabian J Theis","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Nir Yosef","typeEntity":"Person","typeRole":["Contributor"]},{"name":"Tal Ashuach","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/MPRAnalyze"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Community profiling","uri":"http://edamontology.org/operation_3200"},{"term":"Enrichment analysis","uri":"http://edamontology.org/operation_3501"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"}]}],"name":"MPRAnalyze","owner":"Pub2Tools","publication":[],"topic":[{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Transcription factors an