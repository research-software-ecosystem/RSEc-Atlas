{"tool_name":"peptide-qc","contents":["biotools"],"fetched_metadata":{"biotools":{"id":"peptide-qc","home":"https://peptidomexico.com.mx/calculadora/","license":"MIT","summary":"peptide-qc analyzes a standard peptide sequence and returns residue composition, elemental formula, average and monoisotopic mass, approximate charge and pI, and Kyte-Doolittle hydropathy. It is a deterministic command-line tool and JavaScript library for research software tests and teaching. It does not identify unknown samples, certify purity, model unusual chemistry or provide clinical interpretation.","addition_date":"2026-08-12T11:51:25.085937Z","last_update_date":"2026-08-12T11:51:25.088151Z","tool_type":["Command-line tool","Library"],"version":["0.1.0"],"biotools_curie":"biotools:peptide-qc","credit":[{"email":"hola@peptidomexico.com.mx","name":"P\u00e9ptido M\u00e9xico","typeRole":["Developer","Maintainer","Provider"],"url":"https://peptidomexico.com.mx/"}],"documentation":[{"type":["Citation instructions"],"url":"https://github.com/PeptidoMexico/peptidomexico-open-science/blob/main/CITATION.cff"},{"type":["Quick start guide","User manual"],"url":"https://peptidomexico-open-science.readthedocs.io/en/latest/peptide-qc/"}],"edit_permission":{"type":"private"},"function":[{"cmd":"npx peptide-qc analyze --sequence ACDEFGHIK --ph 7 --json","input":[{"data":{"term":"Protein sequence","uri":"http://edamontology.org/data_2976"}}],"note":"Outputs deterministic sequence composition and approximate physicochemical properties for standard residues.","operation":[{"term":"Sequence analysis","uri":"http://edamontology.org/operation_2403"}],"output":[{"data":{"term":"Molecular property","uri":"http://edamontology.org/data_2087"}}]}],"name":"peptide-qc","operating_system":["Linux","Mac","Windows"],"owner":"peptidomexico","topic":[{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}]}}}