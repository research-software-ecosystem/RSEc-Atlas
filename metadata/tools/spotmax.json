{"tool_name":"spotmax","contents":["neubias","oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"spotmax","home":"https://github.com/SchmollerLab/SpotMAX","summary":"SpotMAX is an AI-driven framework for automated spot detection and quantification in microscopy data. It leverages multi-dimensional datasets and offers an easy-to-use interface with cell segmentation and tracking capabilities.","addition_date":"2026-01-15T10:43:27.387207Z","last_update_date":"2026-01-15T10:43:27.390029Z","biotools_curie":"biotools:spotmax","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Quantification","uri":"http://edamontology.org/operation_3799"}]}],"name":"SpotMAX","owner":"pub2tools2024","publication":[{"doi":"10.1101/2024.10.22.619610"}],"topic":[{"term":"Cell biology","uri":"http://edamontology.org/topic_2229"},{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]},"bioschemas":{"name":"SpotMAX","home":"https://bio.tools/spotmax","summary":"SpotMAX is an AI-driven framework for automated spot detection and quantification in microscopy data. It leverages multi-dimensional datasets and offers an easy-to-use interface with cell segmentation and tracking capabilities.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:spotmax/undefined/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1101/2024.10.22.619610","ref_count":0,"refs":[]}]}],"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}}]},"neubias":{"body":[{"format":"basic_html","processed":"<p>A generalist framework for multi-dimensional automatic spot detection and quantificat