{"tool_name":"puzzler","contents":["biotools"],"identifiers":["biotools:puzzler"],"fetched_metadata":{"biotools":{"id":"puzzler","home":"https://cloud.sylabs.io/library/merondun/default/puzzler","summary":"Puzzler is a containerized, scalable command-line workflow for chromosome-scale de novo genome assembly from PacBio HiFi and Hi-C data, automating contig assembly, duplicate purging, Hi-C-based scaffolding, synteny-based chromosome assignment, and integrated QC, distributed via Conda and Apptainer/Singularity containers.","addition_date":"2026-11-04T09:52:43.756795Z","last_update_date":"2026-11-04T09:52:43.758937Z","biotools_curie":"biotools:puzzler","credit":[{"email":"qingyi.yu@usda.gov","name":"Qingyi Yu","orcidid":"https://orcid.org/0000-0001-5393-5764","typeEntity":"Person"},{"name":"Justin Merondun","orcidid":"https://orcid.org/0000-0001-5077-4096","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genome assembly","uri":"http://edamontology.org/operation_0525"},{"term":"Mapping","uri":"http://edamontology.org/operation_2429"},{"term":"Scaffolding","uri":"http://edamontology.org/operation_3216"}]}],"name":"Puzzler","owner":"pub2tools2024","publication":[{"doi":"10.1093/BIOADV/VBAF329","pmcid":"PMC12820402","pmid":"41573168"}],"topic":[{"term":"Hi-C","uri":"http://edamontology.org/topic_4052"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]}}}