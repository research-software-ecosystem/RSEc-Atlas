{"tool_name":"genemania_plugin","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"genemania_plugin","home":"http://www.genemania.org/plugin/","summary":"The plugin brings fast gene function prediction capabilities to the desktop. It identifies the most related genes to a query gene set using a guilt-by-association approach. The plugin uses a large database of functional interaction networks from multiple organisms and each related gene is traceable to the source network used to make the prediction. Users may add their own interaction networks and expression profile data to complement or override the default data.","addition_date":"2017-05-01T15:56:18Z","last_update_date":"2024-11-25T15:19:14.468306Z","tool_type":["Web application"],"biotools_curie":"biotools:genemania_plugin","credit":[{"email":"gary.bader@utoronto.ca","name":"Gary Bader","typeEntity":"Person","typeRole":["Primary contact"]}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene expression profiling","uri":"http://edamontology.org/operation_0314"},{"term":"Gene prediction","uri":"http://edamontology.org/operation_2454"},{"term":"Pathway or network prediction","uri":"http://edamontology.org/operation_3439"}]}],"name":"GeneMania Cytoscape plugin","owner":"ELIXIR-EE","publication":[{"doi":"10.1093/bioinformatics/btq562","pmcid":"PMC2971582","pmid":"20926419"}],"topic":[{"term":"Function analysis","uri":"http://edamontology.org/topic_1775"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Protein interactions","uri":"http://edamontology.org/topic_0128"}],"validated":1},"bioschemas":{"name":"GeneMania Cytoscape plugin","home":"https://bio.tools/genemania_plugin","summary":"The plugin brings fast gene function prediction capabilities to the desktop. It ide