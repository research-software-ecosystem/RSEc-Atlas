{"tool_name":"customprodb","contents":["bioconda","bioconductor","bioschemas","biotools","oeb"],"identifiers":["biotools:customprodb","bioconductor:customprodb","bioconda:bioconductor-customprodb"],"fetched_metadata":{"biotools":{"id":"customprodb","home":"https://bioconductor.org/packages/customProDB","license":"Artistic-2.0","summary":"Database search is the most widely used approach for peptide and protein identification in mass spectrometry-based proteomics studies. Our previous study showed that sample-specific protein databases derived from RNA-Seq data can better approximate the real protein pools in the samples and thus improve protein identification. More importantly, single nucleotide variations, short insertion and deletions and novel junctions identified from RNA-Seq data make protein database more complete and sample-specific. Here, we report an R package customProDB that enables the easy generation of customized databases from RNA-Seq data for proteomics search. This work bridges genomics and proteomics studies and facilitates cross-omics data integration.","addition_date":"2017-01-17T14:55:28Z","last_update_date":"2026-09-01T06:39:24.493621Z","tool_type":["Command-line tool","Library"],"version":["1.51.0"],"collections":["BioConductor"],"biotools_curie":"biotools:customprodb","credit":[{"name":"Xiaojing Wang"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/customProDB"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Annotation track","uri":"http://edamontology.org/data_3002"},"format":[{"term":"BAM","uri":"http://edamontology.org/format_2572"},{"term":"FASTA","uri":"http://edamontology.org/format_1929"},{"term":"Textual format","uri":"http://edamontology.org/format_2330"},{"term":"VCF","uri":"http://edamontology.org/format_3016"}]},{"data":{"term":"COSMIC ID","uri":"http://edamontology.org/data_3264"},"format":[{"term":"BAM","uri":"http://edamontology.org/format_2572"},{"term":"FASTA","