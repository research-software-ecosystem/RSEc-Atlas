{"tool_name":"biotagme","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"biotagme","home":"https://biotagme.eu/","license":"Proprietary","summary":"BioTAGME framework which combinesTAGME annotation framework based on Wikipedia corpus, with DT-Hybrid methodology.","addition_date":"2022-08-11T08:39:26.225290Z","last_update_date":"2024-11-24T15:50:15.108184Z","tool_type":["Web application","Workbench"],"biotools_curie":"biotools:biotagme","credit":[{"email":"alfredo.pulvirenti@unict.it","name":"Alfredo Pulvirenti","typeEntity":"Person"},{"name":"Antonio Di Maria"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Network analysis","uri":"http://edamontology.org/operation_3927"},{"term":"Text annotation","uri":"http://edamontology.org/operation_3778"},{"term":"Text mining","uri":"http://edamontology.org/operation_0306"}]}],"name":"BioTAGME","operating_system":["Linux","Mac","Windows"],"owner":"Chan019","publication":[{"doi":"10.3389/fgene.2022.855739","metadata":{"abstract":"The inference of novel knowledge and new hypotheses from the current literature analysis is crucial in making new scientific discoveries. In bio-medicine, given the enormous amount of literature and knowledge bases available, the automatic gain of knowledge concerning relationships among biological elements, in the form of semantically related terms (or entities), is rising novel research challenges and corresponding applications. In this regard, we propose BioTAGME, a system that combines an entity-annotation framework based on Wikipedia corpus (i.e., TAGME tool) with a network-based inference methodology (i.e., DT-Hybrid). This integration aims to create an extensive Knowledge Graph modeling relations among biological terms and phrases extracted from titles and abstracts of papers available in PubMed. The framework consists of a back-end and a front-end. The back-end is entirely implemented in Scala and runs on top of a Spark cluster that distributes the computing effort among several machines. The front-end is released through the Laravel framework, connected with the Neo4j graph database to store the knowledge graph.","authors":[{"name":"Alaimo S."},{"name":"Bellomo L."},{"name":"Billeci F."},{"name":"Di Maria A."},{"name":"Ferragina P."},{"name":"Ferro A."},{"name":"Pulvirenti A."}],"date":"2022-04-28T00:00:00Z","journal":"Frontiers in Genetics","title":"BioTAGME: A Comprehensive Platform for Biological Knowledge Network Analysis"},"pmcid":"PMC9096447","pmid":"35571058"}],"topic":[{"term":"Biophysics","uri":"http://edamontology.org/topic_3306"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Natural language processing","uri":"http://edamontology.org/topic_0218"}],"validated":1},"bioschemas":{"name":"BioTAGME","home":"https://bio.tools/biotagme","license":"Proprietary","summary":"BioTAGME framework which combinesTAGME annotation framework based on Wikipedia corpus, with DT-Hybrid methodology.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:biotagme/web/biotagme.eu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.3389/fgene.2022.855739","pmcid":"PMC9096447","pmid":"35571058","ref_count":39,"refs":[{"count":1,"year":"-1"},{"count":1,"year":"2000"},{"count":1,"year":"2003"},{"count":1,"year":"2004"},{"count":1,"year":"2007"},{"count":1,"year":"2010"},{"count":1,"year":"2011"},{"count":1,"year":"2014"},{"count":1,"year":"2015"},{"count":2,"year":"2017"},{"count":2,"year":"2018"},{"count":2,"year":"2021"},{"count":3,"year":"2013"},{"count":3,"year":"