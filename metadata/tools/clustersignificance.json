{"tool_name":"clustersignificance","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-clustersignificance","version":"1.38.0","home":"https://bioconductor.org/packages/3.22/bioc/html/ClusterSignificance.html","license":"GPL-3","summary":"The ClusterSignificance package provides tools to assess if class clusters in dimensionality reduced data representations have a separation different from permuted data","identifiers":["biotools:clustersignificance","doi:10.1038/nmeth.3252"],"description":"The ClusterSignificance package provides tools to assess if class clusters in dimensionality reduced data representations have a separation different from permuted data. The term class clusters here refers to, clusters of points representing known classes in the data. This is particularly useful to determine if a subset of the variables, e.g. genes in a specific pathway, alone can separate samples into these established classes. ClusterSignificance accomplishes this by, projecting all points onto a one dimensional line. Cluster separations are then scored and the probability of the seen separation being due to chance is evaluated using a permutation method.","license_file":"/lib/R/share/licenses/GPL-3","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["r-base","r-pracma","r-princurve >=2.0.5","r-rcolorbrewer","r-scatterplot3d"],"run":["r-base","r-pracma","r-princurve >=2.0.5","r-rcolorbrewer","r-scatterplot3d"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/ClusterSignificance_1.38.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ClusterSignificance/ClusterSignificance_1.38.0.tar.gz","https://bioarchive.galaxyproject.org/ClusterSignificance_1.38.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-clustersignificance/bioconductor-clustersignificance_1.38.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('ClusterSignificance')\""]},"parent_recipe":{"name":"bioconductor-clustersignificance","path":"recipes/bioconductor-clustersignificance","version":"1.8.2"}},"biotools":{"id":"clustersignificance","home":"https://bioconductor.org/packages/ClusterSignificance","license":"GPL-3.0","summary":"The ClusterSignificance package provides tools to assess if class clusters in dimensionality reduced data representations have a separation different from permuted data. The term class clusters here refers to, clusters of points representing known classes in the data. This is particularly useful to determine if a subset of the variables, e.g. genes in a specific pathway, alone can separate samples into these established classes. ClusterSignificance accomplishes this by, projecting all points onto a one dimensional line. Cluster separations are then scored and the probability of the seen separation being due to chance is evaluated using a permutation method.","addition_date":"2017-01-17T15:00:09Z","last_update_date":"2026-09-01T06:37:20.275601Z","tool_type":["Command-line tool","Library"],"version":["1.40.0"],"collections":["BioConductor"],"biotools_curie":"biotools:clustersignificance","credit":[{"name":"Jason T. Serviss","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"name":"Jesper R. Gadin","typeEntity":"Person","typeRole":["Developer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/ClusterSignificance"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Comparison","uri":"http://edamontology.org/operation_2424"},{"term":"Sequence clustering","uri":"http://edamontology.org/operation_0291"}]}],"name":"ClusterSignificance","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.1093/bioinformatics/btx393"}],"topic":[{"term":"Gene and protein families","uri":"http://edamontology.org/topic_0623"}],"validated":1},"bioschemas":{"name":"ClusterSignificance","home