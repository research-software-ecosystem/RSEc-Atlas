{"tool_name":"skewit","contents":["biotools","oeb"],"identifiers":["biotools:skewit"],"fetched_metadata":{"biotools":{"id":"skewit","home":"https://github.com/jenniferlu717/SkewIT","license":"GPL-3.0","summary":"Skew Index Test for detecting mis-assembled bacterial genomes.\n\nSkewIT (Skew Index Test) is a tool for analyzing GC Skew in bacterial genomes. GC Skew is a phenomenon observed in many bacterial genomes wherein the two strands of the chromosome contain different proportions of guanine/cytosine nucleotides. SkewIT quantifies GC Skew using a single metric that can then be compared/analyzed across thousands of bacterial genomes.","addition_date":"2021-01-18T07:33:12Z","last_update_date":"2026-11-12T14:29:24.646398Z","biotools_curie":"biotools:skewit","credit":[{"email":"jennifer.lu717@gmail.com","name":"Jennifer Lu","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genome assembly","uri":"http://edamontology.org/operation_0525"},{"term":"Genome indexing","uri":"http://edamontology.org/operation_3211"},{"term":"Scaffolding","uri":"http://edamontology.org/operation_3216"}]}],"name":"SkewIT","owner":"zsmag19","publication":[{"doi":"10.1101/2020.02.27.968214","type":["Preprint"]},{"doi":"10.1371/journal.pcbi.1008439","type":["Primary"]}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Phylogenetics","uri":"http://edamontology.org/topic_3293"},{"term":"Sequence assembly","uri":"http://edamontology.org/topic_0196"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:skewit/undefined/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"