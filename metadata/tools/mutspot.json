{"tool_name":"mutspot","contents":["biotools","oeb"],"identifiers":["biotools:mutspot"],"fetched_metadata":{"biotools":{"id":"MutSpot","home":"https://github.com/skandlab/MutSpot/","summary":"Detection of non-coding mutation hotspots in cancer genomes | Non-coding MUTation hotSPOT dectection in cancer genomes | The MutSpot R package systematically and unbiasedly scans cancer whole genomes to detect mutation hotspots. MutSpot first builds a background mutation model that corrects for covariates of mutation probability, such as local nucleotide context, replication timing and epigenomic features. Then MutSpot evaluates the mutation recurrence of focal DNA regions using a Poisson binomial model to account for varying mutation rates across different tumors. Mutation hotspots identified have significantly higher mutation recurrence compared to the background genomic mutation rate, suggesting positive selection in cancer and involvement in tumorigenesis","addition_date":"2019-11-14T18:03:23Z","last_update_date":"2026-11-12T14:30:45.598335Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:MutSpot","edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Polymorphism detection","uri":"http://edamontology.org/operation_3202"},{"term":"Read binning","uri":"http://edamontology.org/operation_3798"}]}],"name":"MutSpot","owner":"Pub2Tools","publication":[{"doi":"10.1038/s41525-020-0133-4","type":["Primary"]},{"doi":"10.1101/740944","type":["Preprint"]}],"topic":[{"term":"Epigenomics","uri":"http://edamontology.org/topic_3173"},{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"Oncology","uri":"http://edamontology.org/topic_2640"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mutspot/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"pac