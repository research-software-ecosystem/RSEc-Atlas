{"tool_name":"omero-flimfit","contents":["neubias"],"fetched_metadata":{"neubias":{"body":[{"format":"markdown","processed":"","summary":"","value":"FLIMfit is an OMERO client-side MATLAB application for fitting and visualising time-resolved FLIM data. It supports key data formats including: \r\n\r\n- Becker and Hickl .sdt\r\n- LaVision BioTech .msr\r\n- PicoQuant .bin\r\n- OME-TIFF files; \r\n\r\nSeveral options for curve fitting are available. Results can be saved back in OMERO, which also facilitates working collaboratively on the data analysis."}],"changed":[{"format":"Y-m-d\\TH:i:sP","value":"2019-01-11T14:55:55+00:00"}],"created":[{"format":"Y-m-d\\TH:i:sP","value":"2013-10-15T10:45:49+00:00"}],"default_langcode":[{"value":true}],"attribution_instructions":[],"comments_2023":[],"free_tagging":[{"target_id":4360,"target_type":"taxonomy_term","target_uuid":"1f58bde4-1402-46f9-822b-d1099982b3b9","url":"/taxonomy/term/4360"},{"target_id":4663,"target_type":"taxonomy_term","target_uuid":"14418d25-6fc1-4409-824f-98b63d1ecc07","url":"/taxonomy/term/4663"}],"give_feedback_on_this_soft":[{"cid":0,"comment_count":0,"last_comment_name":null,"last_comment_timestamp":1505209250,"last_comment_uid":164,"status":2}],"has_author":[],"has_biological_terms":[],"has_comparison":[],"has_documentation":[{"options":[],"title":"","uri":"https://www.flimfit.org"},{"options":[],"title":"","uri":"https://docs.flimfit.org/"}],"has_doi":[],"has_entry_curator":[{"target_id":98,"target_type":"user","target_uuid":"2ae7ecac-ed23-4375-8a06-79f6a294e65b","url":"/user/98"}],"has_function":[],"has_implementation":[],"has_interaction_level":[{"target_id":3573,"target_type":"taxonomy_term","target_uuid":"43cf6a59-36ad-49c8-9baa-3c5494481f13","url":"/taxonomy/term/3573"}],"has_license":[],"has_location":[{"options":[],"title":"OMERO FLIMfit download page","uri":"https://www.flimfit.org/downloads/"}],"has_programming_language":[],"has_reference_publication":[],"has_usage_example":[],"image":[{"alt":"