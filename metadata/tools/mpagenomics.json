95"}],"output":[{"data":{"term":"Processed microarray data","uri":"http://edamontology.org/data_3111"}}]},{"input":[{"data":{"term":"Processed microarray data","uri":"http://edamontology.org/data_3111"}}],"note":"This function segments normalized profiles provided by the user and labels segments found int he copy-number profiles.","operation":[{"term":"Gene expression analysis","uri":"http://edamontology.org/operation_2495"}],"output":[{"data":{"term":"Processed microarray data","uri":"http://edamontology.org/data_3111"}}]},{"input":[{"data":{"term":"Processed microarray data","uri":"http://edamontology.org/data_3111"}}],"note":"This function segments the previously normalized profiles and labels segments found in the copy-number profiles.","operation":[{"term":"Microarray probe design","uri":"http://edamontology.org/operation_0309"},{"term":"Nucleic acid feature detection","uri":"http://edamontology.org/operation_0415"}],"output":[{"data":{"term":"Experiment report","uri":"http://edamontology.org/data_2531"}}]},{"input":[{"data":{"term":"Processed microarray data","uri":"http://edamontology.org/data_3111"}}],"note":"This function selects some relevant markers according to a response using penalized regression.","operation":[{"term":"Annotation","uri":"http://edamontology.org/operation_0226"}],"output":[{"data":{"term":"Sequence tag profile","uri":"http://edamontology.org/data_2535"}}]},{"input":[{"data":{"term":"Raw microarray data","uri":"http://edamontology.org/data_3110"}}],"note":"Data normalization is a preprocessing step that consists in a correction of biological and technical biaises due to the experiment. It is only available for Affymetrix arrays.","operation":[{"term":"Gene expression analysis","uri":"http://edamontology.org/operation_2495"}],"output":[{"data":{"term":"Processed microarray data","uri":"http://edamontology.org/data_3111"}}]}],"name":"MPAgenomics","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-FR","publication":[{"doi":"10.11