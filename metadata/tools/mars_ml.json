{"tool_name":"mars_ml","contents":["bioschemas","biotools","oeb"],"identifiers":["biotools:mars_ml"],"fetched_metadata":{"biotools":{"id":"mars_ml","home":"https://neuroethology.github.io/MARS/","summary":"A software pipeline for automated analysis of social behaviors in mice.\n\nAssessing Apps for Patients with Genitourinary Tumors Using the Mobile Application Rating Scale (MARS).\n\nThe Mouse Action Recognition System (MARS) is a deep learning based system for automated pose estimation and social behavior classification in pairs of interacting mice. It combines a user-friendly graphical user interface with fast and powerful computer vision and machine learning algorithms.\n\nMARS's novel approach to extracting features from the animals' poses and trajectories allows for highly accurate classification of social behavior.","addition_date":"2021-01-18T09:55:36Z","last_update_date":"2026-11-12T14:41:40.152490Z","biotools_curie":"biotools:mars_ml","credit":[{"email":"vicente.escudero@salud.madrid.org","name":"Vicente Escudero-Vilaplana","orcidid":"https://orcid.org/0000-0003-4417-8321","typeEntity":"Person"},{"email":"kennedya@caltech.edu","name":"Ann Kennedy","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"},{"term":"S/MAR prediction","uri":"http://edamontology.org/operation_0444"}]}],"name":"MARS_ML","owner":"Niclaskn","publication":[{"doi":"10.7554/elife.63720"},{"doi":"10.2196/17609","pmcid":"PMC7413276","pmid":"32706737"},{"doi":"10.1101/2020.07.26.222299","type":["Preprint"]}],"topic":[{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Neurobiology","uri":"http://edamontology.org/topic_3304"},{"term":"Oncology","uri":"http://edamontology.org/topic_2640"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"},{"term":"Zoology","uri":"http://ed