{"tool_name":"hiannotator","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-hiannotator","version":"1.40.0","home":"https://bioconductor.org/packages/3.20/bioc/html/hiAnnotator.html","license":"GPL (>= 2)","summary":"Functions for annotating GRanges objects","identifiers":["biotools:hiannotator","doi:10.1038/nmeth.3252"],"description":"hiAnnotator contains set of functions which allow users to annotate a GRanges object with custom set of annotations. The basic philosophy of this package is to take two GRanges objects (query & subject) with common set of seqnames (i.e. chromosomes) and return associated annotation per seqnames and rows from the query matching seqnames and rows from the subject (i.e. genes or cpg islands). The package comes with three types of annotation functions which calculates if a position from query is: within a feature, near a feature, or count features in defined window sizes. Moreover, each function is equipped with parallel backend to utilize the foreach package. In addition, the package is equipped with wrapper functions, which finds appropriate columns needed to make a GRanges object from a common data frame.","license_file":"/lib/R/share/licenses/GPL-3","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-bsgenome >=1.74.0,<1.75.0","bioconductor-genomicranges >=1.58.0,<1.59.0","bioconductor-rtracklayer >=1.66.0,<1.67.0","r-base","r-dplyr","r-foreach","r-ggplot2","r-iterators","r-scales"],"run":["bioconductor-bsgenome >=1.74.0,<1.75.0","bioconductor-genomicranges >=1.58.0,<1.59.0","bioconductor-rtracklayer >=1.66.0,<1.67.0","r-base","r-dplyr","r-foreach","r-ggplot2","r-iterators","r-scales"]},"source_url":["https://bioconductor.org/packages/3.20/bioc/src/contrib/hiAnnotator_1.40.0.tar.gz","https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/hiAnnotator/hiAnnotator_1.40.0.tar.gz","https://bioarchive.galaxyproject.org/hiAnnotator_1.40.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-hiannotator/bioconductor-hiannotator_1.40.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('hiAnnotator')\""]},"parent_recipe":{"name":"bioconductor-hiannotator","path":"recipes/bioconductor-hiannotator","version":"1.14.0"}},"biotools":{"id":"hiannotator","home":"http://bioconductor.org/packages/release/bioc/html/hiAnnotator.html","license":"GPL-2.0","summary":"Set of functions to annotate a GRanges object with custom set of annotations. This package takes two GRanges objects (query & subject) with a common set of seqnames (i.e. chromosomes) and returns associated annotation per seqnames and rows from the query matching seqnames and rows from the subject (i.e. genes or cpg islands).","addition_date":"2017-01-17T14:56:02Z","last_update_date":"2024-11-25T15:27:57.668629Z","tool_type":["Command-line tool","Library"],"version":["1.8.0"],"collections":["BioConductor"],"biotools_curie":"biotools:hiannotator","credit":[{"email":"malnirav@gmail.com","name":"Nirav V Malani","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/html/hiAnnotator.html"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Sequence features","uri":"http://edamontology.org/data_1255"},"format":[{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]}],"operation":[{"term":"Sequence annotation","uri":"http://edamontology.org/operation_0361"}],"output":[{"data":{"term":"Plot","uri":"http://edamontology.org/data_2884"},"format":[{"term":"Image format","uri":"http://edamontology.org/format_3547"},{"term":"Textual format","uri":"http://edamontology.org/format_2330"}]},{"data":{"term":"Sequence features","uri":"http://edamontology.org/data_1255"},"format":[{"term":"Image format","uri":"http://edamontology.org/format_3547"},{"term":"Textual format","uri":"http://edam