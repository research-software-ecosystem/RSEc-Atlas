{"tool_name":"sh_matching","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"sh_matching","home":"https://github.com/TU-NHM/sh_matching_pub","license":"CC-BY-SA-4.0","summary":"UNITE SH matching analysis is a digital service for the global species discovery from eDNA (environmental DNA). SH matching service is based on the UNITE (https://unite.ut.ee) datasets hosted in PlutoF (https://plutof.ut.ee). Its output includes information about what species are present in eDNA samples, are they potentially undescribed new species, where are they found in other studies, are they alien or threatened species, etc. The output will provide DOI (Digital Object Identifier) based stable identifiers for the communicating species found in eDNA. DOIs are connected to the taxonomic backbone of PlutoF and GBIF (https://gbif.org).","addition_date":"2022-05-05T10:09:54.211164Z","last_update_date":"2022-05-06T08:36:02.442080Z","tool_type":["Command-line tool"],"version":["1.0.0"],"accessibility":"Open access","biotools_curie":"biotools:sh_matching","cost":"Free of charge","edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Nucleic acid sequence record","uri":"http://edamontology.org/data_2887"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}],"operation":[{"term":"Taxonomic classification","uri":"http://edamontology.org/operation_3460"}],"output":[{"data":{"term":"Taxonomic classification","uri":"http://edamontology.org/data_1872"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"},{"term":"TSV","uri":"http://edamontology.org/format_3475"}]}]}],"maturity":"Emerging","name":"SH matching","operating_system":["Linux"],"owner":"kessy.abarenkov@ut.ee","topic":[{"term":"Biodiversity","uri":"http://edamontology.org/topic_3050"}]},"bioschemas":{"name":"SH matching","home":"https://bio.tools/sh_matching","license":"CC-BY-SA-4.0","version":"1.0.0","summary":"UNITE SH matching analysis is a digital service for the global species discovery from eDNA (environmental DNA). SH matching service is based on the UNITE (https://unite.ut.ee) datasets hosted in PlutoF (https://plutof.ut.ee). Its output includes information about what species are present in eDNA samples, are they potentially undescribed new species, where are they found in other studies, are they alien or threatened species, etc. The output will provide DOI (Digital Object Identifier) based stable identifiers for the communicating species found in eDNA. DOIs are connected to the taxonomic backbone of PlutoF and GBIF (https://gbif.org).","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:sh_matching:1.0.0/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":false},"publications":[],"readme":true,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}},"support":{"issue_tracking":{"public_tracker":true,"resolve_time":"PT1143360S"}}},{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:sh_matching:1.0.0/undefined/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"publications":[],"readme":true,"summary":{"description"