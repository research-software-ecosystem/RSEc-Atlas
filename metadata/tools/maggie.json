{"tool_name":"maggie","contents":["biotools","oeb"],"identifiers":["biotools:maggie"],"fetched_metadata":{"biotools":{"id":"maggie","home":"https://github.com/zeyang-shen/maggie","license":"GPL-3.0","summary":"Leveraging genetic variation to identify DNA sequence motifs mediating transcription factor binding and function.\n\nMAGGIE provides a framework for identifying DNA sequence motifs mediating transcription factor binding and function. By leveraging measurements and genetic variation information from different genotypes (human individuals, animal strains, or alleles), MAGGIE associates the mutation of DNA sequence motif with various types of epigenomic features, including but not limited to transcription factor binding, open chromatin, histone modification, and stimulus response of regulatory elements.","addition_date":"2021-01-18T07:31:04Z","last_update_date":"2026-11-12T14:36:44.900399Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:maggie","credit":[{"email":"ckg@ucsd.edu","name":"Christopher K Glass","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genotyping","uri":"http://edamontology.org/operation_3196"},{"term":"Peak calling","uri":"http://edamontology.org/operation_3222"},{"term":"Transcription factor binding site prediction","uri":"http://edamontology.org/operation_0445"}]}],"name":"MAGGIE","owner":"Niclaskn","publication":[{"doi":"10.1093/bioinformatics/btaa476","type":["Primary"]},{"doi":"10.1101/2020.01.30.925917","type":["Preprint"]}],"topic":[{"term":"ChIP-seq","uri":"http://edamontology.org/topic_3169"},{"term":"Epigenomics","uri":"http://edamontology.org/topic_3173"},{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"}]},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotool