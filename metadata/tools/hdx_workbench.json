doi":"10.1007/s13361-012-0419-6","metadata":{"abstract":"Hydrogen/deuterium exchange mass spectrometry (HDX-MS) is an established method for the interrogation of protein conformation and dynamics. While the data analysis challenge of HDXMS has been addressed by a number of software packages, new computational tools are needed to keep pace with the improved methods and throughput of this technique. To address these needs, we report an integrated desktop program titled HDX Workbench, which facilitates automation, management, visualization, and statistical cross-comparison of large HDX data sets. Using the software, validated data analysis can be achieved at the rate of generation. The application is available at the project home page http://hdx.florida.scripps.edu. \u00a9 American Society for Mass Spectrometry, 2012.","authors":[{"name":"Chalmers M.J."},{"name":"Goswami D."},{"name":"Griffin P.R."},{"name":"Landgraf R.R."},{"name":"Lauer J.L."},{"name":"Marciano D."},{"name":"Novick S."},{"name":"Pascal B.D."},{"name":"West G.M."},{"name":"Willis S."}],"citationCount":231,"date":"2012-09-01T00:00:00Z","journal":"Journal of the American Society for Mass Spectrometry","title":"HDXWorkbench: Software for the analysis of H/D exchange MS data"},"pmcid":"PMC3808162","pmid":"22692830"}],"topic":[{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"}],"validated":1},"bioschemas":{"name":"HDX WorkBench","home":"https://bio.tools/hdx_workbench","license":"Other","summary":"Integrated software platform for HDX data analysis.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:hdx_workbench/app/hdx.florida.scripps.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation