{"tool_name":"flowcatchr","contents":["bioconda","bioconductor","bioschemas","biotools","oeb"],"identifiers":["biotools:flowcatchr","bioconductor:flowcatchr","bioconda:bioconductor-flowcatchr"],"fetched_metadata":{"biotools":{"id":"flowcatchr","home":"https://bioconductor.org/packages/flowcatchR","license":"BSD-3-Clause","summary":"flowcatchR is a set of tools to analyze in vivo microscopy imaging data, focused on tracking flowing blood cells. It guides the steps from segmentation to calculation of features, filtering out particles not of interest, providing also a set of utilities to help checking the quality of the performed operations (e.g. how good the segmentation was). It allows investigating the issue of tracking flowing cells such as in blood vessels, to categorize the particles in flowing, rolling and adherent. This classification is applied in the study of phenomena such as hemostasis and study of thrombosis development. Moreover, flowcatchR presents an integrated workflow solution, based on the integration with a Shiny App and Jupyter notebooks, which is delivered alongside the package, and can enable fully reproducible bioimage analysis in the R environment.","addition_date":"2017-01-17T14:55:41Z","last_update_date":"2026-09-01T06:44:35.937751Z","tool_type":["Command-line tool","Library"],"version":["1.46.0"],"collections":["BioConductor"],"biotools_curie":"biotools:flowcatchr","credit":[{"name":"Federico Marini","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/flowcatchR"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Cell migration track image","uri":"http://edamontology.org/data_3449"},"format":[{"term":"Image format","uri":"http://edamontology.org/format_3547"},{"term":"JPG","uri":"http://edamontology.org/format_3579"},{"term":"PNG","uri":"http://edamontology.org/format_3603"},{"term":"TIFF","uri":"http://edamontology.org/form