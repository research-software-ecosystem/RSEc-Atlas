{"tool_name":"hgnc","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"hgnc","home":"http://www.genenames.org/","summary":"Database of unique and meaningful names for all human genes.","addition_date":"2015-09-19T13:34:16Z","last_update_date":"2021-04-16T05:56:21Z","tool_type":["Database portal"],"collections":["DRCAT"],"biotools_curie":"biotools:hgnc","credit":[{"email":"elspeth@ebi.ac.uk","name":"Elspeth A. Bruford","orcidid":"http://orcid.org/0000-0002-8380-5247","typeEntity":"Person","typeRole":["Contributor"]},{"name":"DRCAT","typeEntity":"Project","typeRole":["Documentor"]},{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.genenames.org/about/contact-details"}],"documentation":[{"type":["General"],"url":"http://www.genenames.org/help"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Gene ID (HGNC)","uri":"http://edamontology.org/data_2298"}}],"operation":[{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"}],"output":[{"data":{"term":"Gene report","uri":"http://edamontology.org/data_0916"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"}]}]}],"name":"Human gene nomenclature database (HGNC)","operating_system":["Linux","Mac","Windows"],"owner":"DRCAT","publication":[{"doi":"10.1093/nar/gku1071","metadata":{"abstract":"\u00a9 The Author(s) 2014.The HUGO Gene Nomenclature Committee (HGNC) based at the European Bioinformatics Institute (EMBL-EBI) assigns unique symbols and names to human genes. To date the HGNC have assigned over 39 000 gene names and, representing an increase of over 5000 entries in the past two years. As well as increasing the size of our database, we have continued redesigning our website http://www.genenames.org and have modified, updated and improved many aspects of the site including a faster and more powerful search, a vastly improved HCOP tool and a REST service to increase the number of ways users can retrieve our data. This article provides an overview of our current online data and resources, and highlights the changes we have made in recent years.","authors":[{"name":"Bruford E.A."},{"name":"Gray K.A."},{"name":"Seal R.L."},{"name":"Wright M.W."},{"name":"Yates B."}],"citationCount":352,"date":"2015-01-28T00:00:00Z","journal":"Nucleic Acids Research","title":"Genenames.org: The HGNC resources in 2015"},"pmcid":"PMC4383909","pmid":"25361968","type":["Primary"]}],"topic":[{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Human biology","uri":"http://edamontology.org/topic_2815"},{"term":"Ontology and terminology","uri":"http://edamontology.org/topic_0089"}],"validated":1},"bioschemas":{"name":"Human gene nomenclature database (HGNC)","home":"https://bio.tools/hgnc","summary":"Database of unique and meaningful names for all human genes.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:hgnc/db/www.genenames.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":305,"citations":[{"count":1,"year":"2014"},{"count":2,"year":"2025"},{"count":3,"year":"-1"},{"count":3,"year":"2023"},{"count":4,"year":"2026"},{"count":6,"year":"2024"},{"count":7,"year":"2022"},{"count":10,"year":"2021"},{"count":19,"year":"2020"},{"count":22,"year":"2019"},{"count":44,"year":"2015"},{"count":53,"year":"2018"},{"count":63,"year":"2017"},{"count":68,"year":"2016"}],"doi":"10.1093/nar/gku1071","pmcid":"PMC4383909","pmid":"25361968","ref_count":42,"refs":[{"count":1,"year":"2004"},{"count":2,"year":"2005"},{"count":2,"year":"2009"},{"count":2,"year":"2014"},{"count":3,"year":"2011"},{"count":4,"year":"2006"},{"count":5,"year":"2010"},{"count":5,"year":"2012"},{"count":18,"year":"2013"}],"title":"Genenames.org: the HGNC resources in 2015.","yea