{"tool_name":"vega_annotation_browser","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"vega_annotation_browser","home":"http://vega.sanger.ac.uk","summary":"In collaboration with the genome sequencing centres, Vega attempts to present consistent high-quality curation of finished sequence.","addition_date":"2017-04-21T12:12:34Z","last_update_date":"2018-12-10T12:58:54Z","tool_type":["Web application"],"biotools_curie":"biotools:vega_annotation_browser","credit":[{"name":"Contact form","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://vega.archive.ensembl.org/Help/Contact/"}],"documentation":[{"type":["User manual"],"url":"http://vega.archive.ensembl.org/info/website/archive.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genome annotation","uri":"http://edamontology.org/operation_0362"},{"term":"Genome visualisation","uri":"http://edamontology.org/operation_3208"},{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"Vega Annotation Browser","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-EE","publication":[{"metadata":{"abstract":"The Vertebrate Genome Annotation (Vega) database is a community resource for browsing manual annotation from a variety of vertebrate genomes of finished sequence (http: //vega.sanger.ac.uk). Vega is different from other genome browsers as it has a standardised classification of genes which encompasses pseudogenes and non-coding transcripts. The data is manually curated, which is more accurate at identifying splice variants, pseudogenes poly(A) features, non-coding and complex gene structures and arrangements than current automated methods. The database also contains annotation from regions, not just whole genomes, and displays multiple species annotation (human, mouse, dog and zebrafish) for comparative analysis. Vega encourages community feedback that results in annotation updates and manual annotation of finished vertebrate sequence. \u00a9 Henry Stewart Publications.","authors":[{"name":"Loveland J."}],"citationCount":13,"date":"2005-06-01T00:00:00Z","journal":"Briefings in Bioinformatics","title":"Vega, the genome browser with a difference"},"pmid":"15975227"}],"topic":[{"term":"Data submission, annotation and curation","uri":"http://edamontology.org/topic_0219"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Human biology","uri":"http://edamontology.org/topic_2815"},{"term":"Model organisms","uri":"http://edamontology.org/topic_0621"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:vega_annotation_browser/web/vega.sanger.ac.uk","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true,"help":true,"manual":true},"publications":[{"entries":[{"cit_count":8,"citations":[{"count":1,"year":"2009"},{"count":1,"year":"2012"},{"count":2,"year":"2007"},{"count":2,"year":"2008"},{"count":2,"year":"2013"}],"doi":"10.1093/bib/6.2.189","pmid":"15975227","ref_count":0,"refs":[],"title":"VEGA, the genome browser with a difference.","year":2005}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":true,"https":true,"license":false,"operational":503,"redirects":[{"status":301,"url":"https://vega.archive.ensembl.org/"}],"ssl":true,"ssl_err":null}},"support":{"email":false}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:vega_annotation_browser:1.1/cmd/CRAN.R-project.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":