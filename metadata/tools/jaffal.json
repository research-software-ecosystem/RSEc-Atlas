{"tool_name":"jaffal","contents":["biotools","oeb"],"identifiers":["biotools:jaffal"],"fetched_metadata":{"biotools":{"id":"jaffal","home":"https://github.com/Oshlack/JAFFA","summary":"JAFFA is a multi-step pipeline that takes either raw RNA-Seq reads, or pre-assembled transcripts, then searches for gene fusions. It will output the names and locations of candidate gene fusions along with the cDNA sequence of their breakpoints. JAFFA is based on the idea of comparing a transcriptome (e.g. in a cancer sample) against a reference transcriptome. In this way, it is a transcript-centric approach rather than a genome-centric approach like other fusion finders. In validation studies, JAFFA performed well over a range of read lengths - from 50bp to full-length transcripts and on single and paired-end reads. For more information please see one of the wiki pages below:","addition_date":"2021-10-04T07:58:23.206339Z","last_update_date":"2026-11-12T14:19:36.023526Z","tool_type":["Workflow"],"biotools_curie":"biotools:jaffal","credit":[{"email":"alicia.oshlack@petermac.org","name":"Alicia Oshlack","orcidid":"https://orcid.org/0000-0001-9788-5690","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"nadia.davidson@petermac.org","name":"Nadia M. Davidson","orcidid":"https://orcid.org/0000-0002-8461-7467","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/Oshlack/JAFFA/wiki"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Chimera detection","uri":"http://edamontology.org/operation_0450"},{"term":"Database search","uri":"http://edamontology.org/operation_2421"},{"term":"Read mapping","uri":"http://edamontology.org/operation_3198"}]}],"name":"JAFFAL","owner":"Kigaard","publication":[{"doi":"10.1101/2021.04.26.441398","type":["Preprint"]},{"doi":"10.1186/s13059-021-02588-5","type":["Primary"]}],"topic":[{"term":"Biomarkers","uri":"http://edamontology.org/topic_3360"},{"term":"Gene tra