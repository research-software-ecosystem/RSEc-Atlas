{"tool_name":"gmorse","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"gmorse","home":"http://www.genoscope.cns.fr/externe/gmorse/","summary":"G-Mo.R-Se is a method aimed at using RNA-Seq short reads to build de novo gene models. First, candidate exons are built directly from the positions of the reads mapped on the genome (without any ab initio assembly of the reads), and all the possible splice junctions between those exons are tested against unmapped reads : the testing of junctions is directed by the information available in the RNA-Seq dataset rather than a priori knowledge about the genome. Exons can thus be chained into stranded gene models.","addition_date":"2019-11-06T11:19:30Z","last_update_date":"2021-04-15T06:30:08Z","tool_type":["Library"],"biotools_curie":"biotools:gmorse","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"de Novo sequencing","uri":"http://edamontology.org/operation_3644"}]}],"name":"gmorse","owner":"jison","topic":[{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:gmorse/lib/www.genoscope.cns.fr","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://www.genoscope.cns.fr/externe/gmorse/"}],"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/gmorse","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":tr