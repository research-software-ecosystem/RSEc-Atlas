{"tool_name":"aperture","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"aperture","home":"https://github.com/liuhc8/Aperture","license":"Apache-2.0","summary":"Aperture is a new alignment-free SV caller designed for cfDNA dataset. Aperture applies a unique strategy of k-mer based searching, fast breakpoint detection using binary labels and candidates clustering to detect SVs and viral integrations in high sensitivity, especially when junctions span repetitive regions, followed by a barcode based filter to ensure specificity.\nAperture takes paired-end reads in fastq format as inputs and reports all SVs and viral integrations in VCF 4.2 format.","addition_date":"2021-01-18T12:12:28Z","last_update_date":"2021-01-24T18:45:14Z","tool_type":["Command-line tool"],"biotools_curie":"biotools:aperture","credit":[{"email":"lijunling@cicams.ac.cn","name":"Xiaoyue Wang","typeEntity":"Person"},{"email":"wxy@ibms.pumc.edu.cn","name":"Junling Li","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Filtering","uri":"http://edamontology.org/operation_3695"},{"term":"Sequence trimming","uri":"http://edamontology.org/operation_3192"},{"term":"Structural variation detection","uri":"http://edamontology.org/operation_3228"},{"term":"k-mer counting","uri":"http://edamontology.org/operation_3472"}]}],"name":"Aperture","owner":"Kigaard","publication":[{"doi":"10.1101/2020.12.04.409508"}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"DNA structural variation","uri":"http://edamontology.org/topic_3175"},{"term":"Gene transcripts","uri":"http://edamontology.org/topic_3512"},{"term":"Oncology","uri":"http://edamontology.org/topic_2640"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"bioschemas":{"name":"Aperture","home":"https://bio.tools/aperture","license":"Apache-2.0","summary":"Aperture is a new alignment-free SV caller designed for cfDNA