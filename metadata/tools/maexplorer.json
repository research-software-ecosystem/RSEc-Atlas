{"tool_name":"maexplorer","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"maexplorer","home":"http://maexplorer.sourceforge.net/","summary":"The MAExplorer is a Java-based bioinformatics exploratory data-analysis and data-mining program for analyzing sets of quantitative spotted cDNA or oligonucleotide microarray data . It includes data management, graphics, statistics, clustering, reports, gene data-filtering, user written MAEPlugins, documentation, tutorials, demo data. The exploratory data analysis environment provides tools for the data-mining of quantitative expression profiles across multiple microarrays.","addition_date":"2017-12-18T00:08:32Z","last_update_date":"2018-12-10T12:58:57Z","tool_type":["Desktop application"],"version":["0.96.34.01"],"biotools_curie":"biotools:maexplorer","credit":[{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.ccrnp.ncifcrf.gov/users/lemkin/lemkin.html"}],"documentation":[{"type":["User manual"],"url":"http://maexplorer.sourceforge.net/MaeRefMan/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Analysis","uri":"http://edamontology.org/operation_2945"}]},{"operation":[{"term":"Clustering","uri":"http://edamontology.org/operation_3432"}]},{"operation":[{"term":"Filtering","uri":"http://edamontology.org/operation_3695"}]}],"name":"MAExplorer","operating_system":["Linux","Mac","Windows"],"owner":"mbs_import","topic":[{"term":"Bioinformatics","uri":"http://edamontology.org/topic_0091"},{"term":"Documentation","uri":"http://edamontology.org/topic_3068"},{"term":"Microarrays","uri":"http://edamontology.org/topic_3518"},{"term":"Statistics","uri":"http://edamontology.org/topic_2269"},{"term":"cDNA","uri":"http://edamontology.org/topic_3512"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:maexplorer:0.96.34.01/app/maexplorer.sourceforge.net","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type"