{"tool_name":"thor","contents":["biotools","oeb"],"identifiers":["biotools:thor"],"fetched_metadata":{"biotools":{"id":"Thor","home":"https://github.com/GuangyuWangLab2021/Thor","summary":"Spatial transcriptomics integrates transcriptomics data with histological tissue images, offering deeper insights into cellular organization and molecular functions. However, existing computational platforms mainly focus on genomic analysis, leaving a gap in the seamless integration of genomic and imaging modalities. Thor is a comprehensive spatial transcriptomics analysis tool designed to bridge this gap by enabling efficient co-analysis of gene expression profiles and high-resolution tissue images. It provides scalable workflows for spatial feature extraction, cell segmentation, gene\u2013spatial correlation, and visualization, facilitating multi-omic insights into tissue architecture and cellular heterogeneity.","addition_date":"2025-10-27T16:15:48.531662Z","last_update_date":"2026-11-12T14:19:21.272421Z","biotools_curie":"biotools:Thor","credit":[{"name":"Pengzhi Zhang","orcidid":"https://orcid.org/0000-0001-6920-1490","typeEntity":"Person"},{"name":"Weiqing Chen","orcidid":"https://orcid.org/0000-0003-3539-9210","typeEntity":"Person"}],"documentation":[{"type":["Quick start guide"],"url":"https://wanglab.tech/thor/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Gene expression profiling","uri":"http://edamontology.org/operation_0314"},{"term":"Imputation","uri":"http://edamontology.org/operation_3557"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"Thor","owner":"udayaraja","publication":[{"doi":"10.21203/RS.3.RS-4909620/V1","pmcid":"PMC11952649","pmid":"40162205","type":["Preprint"]},{"doi":"10.1038/s41467-025-62593-1","type":["Primary"]}],"topic":[{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Molecular interact