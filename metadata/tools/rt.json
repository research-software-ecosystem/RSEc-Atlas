{"tool_name":"rt","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"rt","home":"http://www.ms-utils.org/rt.html","license":"GPL-3.0","summary":"Retention time prediction using LC-MS data. The latest version (4.0) has an improved user interface and can read pepXML files directly.","addition_date":"2017-01-17T14:51:08Z","last_update_date":"2024-11-25T13:58:57.760739Z","tool_type":["Command-line tool"],"collections":["Proteomics","ms-utils"],"biotools_curie":"biotools:rt","credit":[{"email":"magnus.palmblad@gmail.com","name":"Magnus Palmblad","typeEntity":"Person","typeRole":["Maintainer"]},{"email":"webmaster@ms-utils.org","typeEntity":"Person","typeRole":["Documentor"],"url":"http://ms-utils.org"}],"documentation":[{"type":["General"],"url":"http://www.ms-utils.org/rt4.html"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"input":[{"data":{"term":"Peptide identification","uri":"http://edamontology.org/data_0945"},"format":[{"term":"DSV","uri":"http://edamontology.org/format_3751"},{"term":"TSV","uri":"http://edamontology.org/format_3475"},{"term":"pepXML","uri":"http://edamontology.org/format_3655"}]}],"operation":[{"term":"Retention time prediction","uri":"http://edamontology.org/operation_3633"}],"output":[{"data":{"term":"Amino acid property","uri":"http://edamontology.org/data_2016"},"format":[{"term":"TSV","uri":"http://edamontology.org/format_3475"},{"term":"Textual format","uri":"http://edamontology.org/format_2330"},{"term":"XML","uri":"http://edamontology.org/format_2332"}]}]}],"name":"rt","operating_system":["Linux","Mac","Windows"],"owner":"msutils_import","publication":[{"doi":"10.1021/ac0256890","metadata":{"abstract":"Liquid chromatography coupled on- or off-line with mass spectrometry is rapidly advancing as a tool in proteomics capable of dealing with the inherent complexity in biology and complementing conventional approaches based on two-dimensional gel electrophoresis. Proteins can be identified by proteolytic digestion and peptide mass fingerprinting or by searching databases using short-sequence tags generated by tandem mass spectrometry. This paper shows that information on the chromatographic behavior of peptides can assist protein identification by peptide mass fingerprinting in liquid chromatography/mass spectrometry. This additional information is significant and already available at no extra experimental cost.","authors":[{"name":"Bergquist J."},{"name":"Hakansson P."},{"name":"Markides K.E."},{"name":"Palmblad M."},{"name":"Ramstrom M."}],"citationCount":133,"date":"2002-11-15T00:00:00Z","journal":"Analytical Chemistry","title":"Prediction of chromatographic retention and protein identification in liquid chromatography/mass spectrometry"},"pmid":"12463368"}],"topic":[{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"}],"validated":1},"bioschemas":{"name":"rt","home":"https://bio.tools/rt","license":"GPL-3.0","summary":"Retention time prediction using LC-MS data. The latest version (4.0) has an improved user interface and can read pepXML files directly.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:rt/cmd/www.ms-utils.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":24,"citations":[{"count":1,"year":"2012"},{"count":1,"year":"2015"},{"count":1,"year":"2019"},{"count":1,"year":"2026"},{"count":2,"year":"2006"},{"count":2,"year":"2007"},{"count":2,"year":"2008"},{"count":2,"year":"2009"},{"count":2,"year":"2010"},{"count":2,"year":"2021"},{"count":2,"year":"2023"},{"count":3,"year":"2011"},{"count":3,"year":"20