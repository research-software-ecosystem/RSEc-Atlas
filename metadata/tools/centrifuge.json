{"tool_name":"centrifuge","contents":["biocontainers","bioschemas","debian","biotools","bioconda","oeb"],"fetched_metadata":{"bioconda":{"name":"centrifuge","version":"1.0.4.2","home":"https://github.com/DaehwanKimLab/centrifuge","license":"GPL-3.0-only","summary":"Classifier for metagenomic sequences. Supports classifier scripts","identifiers":["biotools:Centrifuge","doi:10.1101/gr.210641.116"],"license_file":"LICENSE","build":{"number":1,"run_exports":[null],"skip":true},"requirements":{"build":["make",null],"host":["zlib"],"run":["zlib","perl","wget","tar","python"]},"source_url":"https://github.com/DaehwanKimLab/centrifuge/archive/refs/tags/v1.0.4.2.tar.gz","test":{"commands":["centrifuge --help"]}},"biocontainers":{"name":"centrifuge","identifiers":["biotools:Centrifuge","doi:10.1101/gr.210641.116"],"license":"GPL-3.0","summary":"A very rapid and memory-efficient system for the classification of dna sequences from microbial samples. the system uses a novel indexing scheme based on the burrows-wheeler transform and the ferragina-manzini index, optimized specifically for the metagenomic classification problem. together these advances enable timely and accurate analysis of large metagenomics data sets on conventional desktop computers.","home_url":"https://github.com/fbreitwieser/pavian","keywords":["Archaea","Bacteria","Computational Biology","Databases, Nucleic Acid","High-Throughput Nucleotide Sequencing","Metagenomics","Sequence Analysis, DNA","Microbiology","Genomics"],"manually_check":true,"total_pulls":6337},"biotools":{"id":"centrifuge","home":"https://ccb.jhu.edu/software/centrifuge/","license":"GPL-3.0","summary":"A very rapid and memory-efficient system for the classification of DNA sequences from microbial samples. The system uses a novel indexing scheme based on the Burrows-Wheeler transform and the Ferragina-Manzini index, optimized specifically for the metagenomic classification problem. Together these advances enable timely and accurate analysis of large metagenomics data sets on conventional desktop computers.","addition_date":"2017-08-20T15:18:33Z","last_update_date":"2024-11-25T14:05:54.460501Z","tool_type":["Command-line tool"],"collections":["Animal and Crop Genomics"],"biotools_curie":"biotools:centrifuge","credit":[{"email":"centrifuge.metagenomics@gmail.com","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"https://ccb.jhu.edu/software/centrifuge/manual.shtml"}],"edit_permission":{"authors":["animalandcropgenomics"],"type":"group"},"function":[{"operation":[{"term":"Nucleic acid sequence analysis","uri":"http://edamontology.org/operation_2478"}]}],"name":"Centrifuge","operating_system":["Linux","Mac"],"owner":"admin","publication":[{"doi":"10.1101/gr.210641.116","metadata":{"abstract":"Centrifuge is a novel microbial classification engine that enables rapid, accurate, and sensitive labeling of reads and quantification of species on desktop computers. The system uses an indexing scheme based on the Burrows-Wheeler transform (BWT) and the Ferragina-Manzini (FM) index, optimized specifically for the metagenomic classification problem. Centrifuge requires a relatively small index (4.2 GB for 4078 bacterial and 200 archaeal genomes) and classifies sequences at very high speed, allowing it to process the millions of reads from a typical high-throughput DNA sequencing run within a few minutes. Together, these advances enable timely and accurate analysis of large metagenomics data sets on conventional desktop computers. Because of its space-optimized indexing schemes, Centrifuge also makes it possible to index the entire NCBI nonredundant nucleotide sequence database (a total of 109 billion bases) with an index size of 69 GB, in contrast to k-mer-based indexing schemes, which require far more extensive space.","authors":[{"name":"Breitwieser F.P."},{"name":"Kim D."},{"name":"Salzberg S.L."},{"name":"Song L."}],"citationCount":821,"date":"2016-12-01T00:00:00Z","journal":"Genome Research","title":"Centrifuge: Rapid and sensitive classification of metagenomic sequences"},"pmcid":"PMC5131823","pmid":"27852649","type":["Primary"]}],"topic":[{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Microbiology","uri":"http://edamontology.org/topic_3301"}],"validated":1},"bioschemas":{"name":"Centrifuge","home":"https://bio.tools/centrifuge","license":"GPL-3.0","summary":"A very rapid and memory-efficient system for the classification of DNA sequences from microbial samples. The system uses a novel indexing scheme based on the Burrows-Wheeler transform and the Ferragina-Manzini index, optimized specifically for the metagenomic classification problem. Together these advances enable timely and accurate analysis of large metagenomics data sets on conventional desktop computers.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:centrifuge/cmd/ccb.jhu.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":765,"citations":[{"count":1,"year":"2016"},{"count":6,"year":"-1"},{"count":7,"year":"2017"},{"count":38,"year":"2018"},{"count":54,"year":"2019"},{"count":58,"year":"2026"},{"count":86,"year":"2023"},{"count":100,"year":"2021"},{"count":102,"year":"2020"},{"count":102,"year":"2022"},{"count":102,"year":"2024"},{"count":109,"year":"2025"}],"doi":"10.1101/gr.210641.116","pmcid":"PMC5131823","pmid":"27852649","ref_count":27,"refs":[{"count":1,"year":"-1"},{"count":1,"year":"1995"},{"count":1,"year":