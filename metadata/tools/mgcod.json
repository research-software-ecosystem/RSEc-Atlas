{"tool_name":"mgcod","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"mgcod","home":"https://github.com/gatech-genemark/MgCod","license":"GPL-3.0","summary":"Gene prediction in phage genomes with multiple genetic codes.","addition_date":"2024-01-03T15:47:07.822455Z","last_update_date":"2024-11-24T14:23:51.342549Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:mgcod","cost":"Free of charge","edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Codon usage table generation","uri":"http://edamontology.org/operation_0284"},{"term":"Gene prediction","uri":"http://edamontology.org/operation_2454"},{"term":"Genetic code prediction","uri":"http://edamontology.org/operation_0489"}]}],"name":"MgCod","operating_system":["Linux","Mac","Windows"],"owner":"Pub2Tools","publication":[{"doi":"10.1016/j.jmb.2023.168159","metadata":{"abstract":"Massive sequencing of microbiomes has led to the discovery of a large number of phage genomes with intermittent stop codon recoding. We have developed a computational tool, MgCod, that identifies genomic regions (blocks) with distinct stop codon recoding simultaneously with the prediction of protein-coding regions. When MgCod was used to scan a large volume of human metagenomic contigs hundreds of viral contigs with intermittent stop codon recoding were revealed. Many of these contigs originated from genomes of known crAssphages. Further analyses had shown that intermittent recoding was associated with subtle patterns in the organization of protein-coding genes, such as \u2018single-coding\u2019 and \u2018dual-coding\u2019. The dual-coding genes, clustered into blocks, could be translated by two alternative codes producing nearly identical proteins. It was observed that the dual-coded blocks were enriched with the early-stage phage genes, while the late-stage genes were residing in the single-coded blocks. MgCod can identify types of stop codon recoding in novel genomic sequences in parallel with gene prediction. It is available for download from https://github.com/gatech-genemark/MgCod.","authors":[{"name":"Borodovsky M."},{"name":"Lomsadze A."},{"name":"Pfennig A."}],"citationCount":2,"date":"2023-07-15T00:00:00Z","journal":"Journal of Molecular Biology","title":"MgCod: Gene Prediction in Phage Genomes with Multiple Genetic Codes"},"pmid":"37244571","type":["Primary"]}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Microbial ecology","uri":"http://edamontology.org/topic_3697"}]},"bioschemas":{"name":"MgCod","home":"https://bio.tools/mgcod","license":"GPL-3.0","summary":"Gene prediction in phage genomes with multiple genetic codes.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mgcod/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":7,"citations":[{"count":1,"year":"2022"},{"count":1,"year":"2023"},{"count":2,"year":"2025"},{"count":3,"year":"2024"}],"doi":"10.1016/j.jmb.2023.168159","pmid":"37244571","ref_count":0,"refs":[],"title":"MgCod: Gene Prediction in Phage Genomes with Multiple Genetic Codes.","year":2023}]}],"summary":{"description":true},"website":{"bioschemas":true,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:mgcod:1.0.1/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications"