{"tool_name":"phaser","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"phaser","home":"http://www.phaser.cimr.cam.ac.uk","summary":"A program for phasing macromolecular crystal structures with maximum likelihood methods.","addition_date":"2015-03-26T23:06:19Z","last_update_date":"2024-11-25T14:10:04.750303Z","tool_type":["Command-line tool","Desktop application"],"version":["2.5"],"collections":["CCP4"],"biotools_curie":"biotools:phaser","cost":"Free of charge","credit":[{"email":"ccisb@stfc.ac.uk","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"Instruct","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["User manual"],"url":"http://www.phaser.cimr.cam.ac.uk/index.php/Phaser-2.7.17:_Manual"}],"edit_permission":{"authors":["mwinn"],"type":"group"},"function":[{"note":"A program for phasing macromolecular crystal structures with maximum likelihood methods.","operation":[{"term":"Phasing","uri":"http://edamontology.org/operation_3454"}]}],"maturity":"Mature","name":"Phaser","operating_system":["Linux","Mac","Windows"],"owner":"Instruct","publication":[{"doi":"10.1107/s0021889807021206","metadata":{"abstract":"Phaser is a program for phasing macromolecular crystal structures by both molecular replacement and experimental phasing methods. The novel phasing algorithms implemented in Phaser have been developed using maximum likelihood and multivariate statistics. For molecular replacement, the new algorithms have proved to be significantly better than traditional methods in discriminating correct solutions from noise, and for single-wavelength anomalous dispersion experimental phasing, the new algorithms, which account for correlations between F+ and F -, give better phases (lower mean phase error with respect to the phases given by the refined structure) than those that use mean F and anomalous differences \u0394F. One of the design concepts of Phaser was that it be capable of a high degree of automation. To this end, Phaser (written in C++) can be called directly from Python, although it can also be called using traditional CCP4 keyword-style input. Phaser is a platform for future development of improved phasing methods and their release, including source code, to the crystallographic community. \u00a9 International Union of Crystallography 2007.","authors":[{"name":"Adams P.D."},{"name":"Grosse-Kunstleve R.W."},{"name":"McCoy A.J."},{"name":"Read R.J."},{"name":"Storoni L.C."},{"name":"Winn M.D."}],"citationCount":16313,"date":"2007-07-13T00:00:00Z","journal":"Journal of Applied Crystallography","title":"Phaser crystallographic software"},"pmcid":"PMC2483472","pmid":"19461840"}],"topic":[{"term":"Structural biology","uri":"http://edamontology.org/topic_1317"}],"validated":1},"bioschemas":{"name":"Phaser","home":"https://bio.tools/phaser","version":"2.5","summary":"A program for phasing macromolecular crystal structures with maximum likelihood methods.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:phaser:2.5/app/www.phaser.cimr.cam.ac.uk","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"manual":true},"publications":[{"entries":[{"cit_count":13116,"citations":[{"count":6,"year":"2007"},{"count":12,"year":"-1"},{"count":98,"year":"2008"},{"count":200,"year":"2009"},{"count":405,"year":"2010"},{"count":407,"year":"2026"},{"count":542,"year":"2011"},{"count":616,"year":"2012"},{"count":703,"year":"2024"},{"count":704,"year":"2025"},{"count":749,"year":"2014"},{"count":753,"year":"2023"},{"count":793,"year":"2013"},{"count":843,"year":"2022"},{"count":846,"year":"2021"},{"count":859,"year":"2015"},{"count":894,"year":"2018"},{"count":909,"year":"2016"},{"count":919,"year":"2019"},{"count":927,"year":"2020"},{"count":931,"year":"2017"}],"doi":"10.1107/S0021889807021206","pmcid":