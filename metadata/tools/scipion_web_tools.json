{"tool_name":"scipion_web_tools","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"scipion_web_tools","home":"http://scipion.cnb.csic.es/m/services/","summary":"Technological development over Scipion framework software (REF), offering  access to predefined image processing workflows over the Web.","addition_date":"2016-07-11T10:42:55Z","last_update_date":"2024-11-24T20:11:42.170137Z","tool_type":["Web application"],"version":["1"],"collections":["CNB-CSIC","ELIXIR-ES","INB"],"biotools_curie":"biotools:scipion_web_tools","credit":[{"email":"jsegura@cnb.csic.es","name":"Joan","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"jsegura@cnb.csic.es","name":"Joan","typeRole":["Support"]},{"name":"ELIXIR-ES","typeEntity":"Institute","typeRole":["Provider"]},{"name":"INB","typeEntity":"Institute","typeRole":["Provider"]},{"name":"cnb.csic.es","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["General"],"url":"http://scipion.cnb.csic.es/m/services/"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"3D EM Mask","uri":"http://edamontology.org/data_3806"}},{"data":{"term":"Protein structure","uri":"http://edamontology.org/data_1460"}}],"note":"3DEM Volume","operation":[{"term":"Protein geometry validation","uri":"http://edamontology.org/operation_1844"}],"output":[{"data":{"term":"Structural profile","uri":"http://edamontology.org/data_0889"}}]}],"name":"SCIPION WEB TOOLS","operating_system":["Linux","Mac","Windows"],"owner":"coss","publication":[{"doi":"10.1016/j.jsb.2016.04.010","metadata":{"abstract":"In the past few years, 3D electron microscopy (3DEM) has undergone a revolution in instrumentation and methodology. One of the central players in this wide-reaching change is the continuous development of image processing software. Here we present Scipion, a software framework for integrating several 3DEM software packages through a workflow-based approach. Scipion allows the exec