{"tool_name":"pharmgkb","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"pharmgkb","home":"http://www.pharmgkb.org","license":"CC-BY-NC-SA-4.0","summary":"Database on the impact of human genetic variations on drug response. PharmGKB curates primary genotype and phenotype data, annotate gene variants and gene-drug-disease relationships via literature review, and summarize important PGx genes and drug pathways.","addition_date":"2015-10-07T18:50:40Z","last_update_date":"2020-06-16T10:55:23Z","tool_type":["Database portal","Web application"],"collections":["DRCAT","Rare Disease"],"accessibility":"Open access","biotools_curie":"biotools:pharmgkb","cost":"Free of charge","credit":[{"email":"feedback@pharmgkb.org","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"DRCAT","typeEntity":"Project","typeRole":["Documentor"]}],"documentation":[{"type":["General"],"url":"https://www.pharmgkb.org/page/overview"}],"edit_permission":{"authors":["ELIXIR-EE"],"type":"group"},"function":[{"input":[{"data":{"term":"PharmGKB ID","uri":"http://edamontology.org/data_2649"}}],"operation":[{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"}],"output":[{"data":{"term":"Gene report","uri":"http://edamontology.org/data_0916"},"format":[{"term":"HTML","uri":"http://edamontology.org/format_2331"}]}]}],"maturity":"Mature","name":"PharmGKB","operating_system":["Linux","Mac","Windows"],"owner":"DRCAT","publication":[{"doi":"10.1038/clpt.2012.96","metadata":{"abstract":"The Pharmacogenomics Knowledgebase (PharmGKB) is a resource that collects, curates, and disseminates information about the impact of human genetic variation on drug responses. It provides clinically relevant information, including dosing guidelines, annotated drug labels, and potentially actionable gene-drug associations and genotype-phenotype relationships. Curators assign levels of evidence to variant-drug associations using well-defined criteria based on careful literature review. Thus, PharmGKB is a useful source of high-quality information supporting personalized medicine-implementation projects. \u00a9 2012 American Society for Clinical Pharmacology and Therapeutics.","authors":[{"name":"Altman R.B."},{"name":"Gong L."},{"name":"Hebert J.M."},{"name":"Klein T.E."},{"name":"McDonagh E.M."},{"name":"Sangkuhl K."},{"name":"Thorn C.F."},{"name":"Whirl-Carrillo M."}],"citationCount":992,"date":"2012-10-01T00:00:00Z","journal":"Clinical Pharmacology and Therapeutics","title":"Pharmacogenomics knowledge for personalized medicine"},"pmcid":"PMC3660037","pmid":"22992668","type":["Primary"]}],"topic":[{"term":"Genotype and phenotype","uri":"http://edamontology.org/topic_0625"},{"term":"Human biology","uri":"http://edamontology.org/topic_2815"},{"term":"Pharmacogenomics","uri":"http://edamontology.org/topic_0208"},{"term":"Pharmacology","uri":"http://edamontology.org/topic_0202"},{"term":"Rare diseases","uri":"http://edamontology.org/topic_3325"}],"validated":1},"bioschemas":{"name":"PharmGKB","home":"https://bio.tools/pharmgkb","license":"CC-BY-NC-SA-4.0","summary":"Database on the impact of human genetic variations on drug response. PharmGKB curates primary genotype and phenotype data, annotate gene variants and gene-drug-disease relationships via literature review, and summarize important PGx genes and drug pathways.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pharmgkb/web/www.pharmgkb.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":898,"citations":[{"count":3,"year":"2012"},{"count":6,"year":"-1"},{"count":15,"year":"2013"},{"count":26,"year":"2026"},{"count":31,"year":"2025"},{"count":43,"year":"2015"},{"count":44,"year":"2014"},{"cou