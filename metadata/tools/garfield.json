{"tool_name":"garfield","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"garfield","home":"https://bioconductor.org/packages/garfield","license":"GPL-3.0","summary":"GARFIELD is a non-parametric functional enrichment analysis approach described in the paper GARFIELD: GWAS analysis of regulatory or functional information enrichment with LD correction. Briefly, it is a method that leverages GWAS findings with regulatory or functional annotations (primarily from ENCODE and Roadmap epigenomics data) to find features relevant to a phenotype of interest. It performs greedy pruning of GWAS SNPs (LD r2 > 0.1) and then annotates them based on functional information overlap. Next, it quantifies Fold Enrichment (FE) at various GWAS significance cutoffs and assesses them by permutation testing, while matching for minor allele frequency, distance to nearest transcription start site and number of LD proxies (r2 > 0.8).","addition_date":"2017-01-17T14:55:47Z","last_update_date":"2018-12-10T12:58:53Z","tool_type":["Command-line tool","Library"],"version":["1.40.0"],"collections":["BioConductor"],"biotools_curie":"biotools:garfield","credit":[{"name":"Sandro Morganella"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/garfield"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Enrichment analysis","uri":"http://edamontology.org/operation_3501"}]}],"name":"garfield","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.18129/B9.bioc.garfield"}],"topic":[{"term":"GWAS study","uri":"http://edamontology.org/topic_3517"}],"validated":1},"bioschemas":{"name":"garfield","home":"https://bio.tools/garfield","license":"GPL-3.0-only","version":"1.40.0","summary":"GARFIELD is a non-parametric functional enrichment analysis approach described in the paper GARFIELD: GWAS analysis of regulatory or functional information enrichment with LD correction. Briefly, it