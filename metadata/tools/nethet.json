{"tool_name":"nethet","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"nethet","home":"https://bioconductor.org/packages/nethet","license":"GPL-2.0","summary":"Package nethet is an implementation of statistical solid methodology enabling the analysis of network heterogeneity from high-dimensional data. It combines several implementations of recent statistical innovations useful for estimation and comparison of networks in a heterogeneous, high-dimensional setting. In particular, we provide code for formal two-sample testing in Gaussian graphical models (differential network and GGM-GSA; Stadler and Mukherjee, 2013, 2014) and make a novel network-based clustering algorithm available (mixed graphical lasso, Stadler and Mukherjee, 2013).","addition_date":"2017-01-17T15:00:48Z","last_update_date":"2024-11-25T15:32:03.603547Z","tool_type":["Command-line tool","Library"],"version":["1.44.0"],"collections":["BioConductor"],"biotools_curie":"biotools:nethet","credit":[{"name":"Frank Dondelinger"},{"name":"Nicolas Staedler"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/nethet"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Pathway or network analysis","uri":"http://edamontology.org/operation_2497"}]}],"name":"nethet","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.18129/B9.bioc.nethet"}],"topic":[{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"}],"validated":1},"bioschemas":{"name":"nethet","home":"https://bio.tools/nethet","license":"GPL-2.0-only","version":"1.44.0","summary":"Package nethet is an implementation of statistical solid methodology enabling the analysis of network heterogeneity from high-dimensional data. It combines several implementations of recent statistical innovations useful for estimation and comparison of networks in a heterogeneous, high-dimensional settin