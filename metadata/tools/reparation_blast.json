esults and is slower than the original reparation software.","license_file":"License.txt","build":{"noarch":"generic","number":3},"requirements":{"host":["perl"],"run":["perl","perl-posix","perl-bioperl >=1.7.2","samtools","pysam =0.16.0.1","plastid","biopython =1.77","r-ggplot2","r-prroc","r-rocr","r-randomforest","r-sizer","prodigal","glimmer","blast","openssl"]},"source_url":"https://github.com/RickGelhausen/REPARATION_blast/archive/v1.0.9.tar.gz","test":{"commands":["reparation.pl --version"]}}}}