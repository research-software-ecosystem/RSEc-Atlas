{"tool_name":"algpred","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"algpred","home":"http://webs.iiitd.edu.in/raghava/algpred/","summary":"Predicts allergenic proteins and maps IgE epitopes on allergenic proteins using several different approaches.","addition_date":"2017-02-10T14:15:43Z","last_update_date":"2024-11-24T15:35:44.872808Z","tool_type":["Web application"],"biotools_curie":"biotools:algpred","credit":[{"email":"raghava@imtech.res.in","name":"G. P. S. Raghava","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"http://crdd.osdd.net/raghava/algpred/help.html"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Epitope mapping","uri":"http://edamontology.org/operation_0416"},{"term":"Generation","uri":"http://edamontology.org/operation_3429"},{"term":"Mapping","uri":"http://edamontology.org/operation_2429"},{"term":"Peptide immunogenicity prediction","uri":"http://edamontology.org/operation_0252"}]}],"name":"AlgPred","operating_system":["Linux","Mac","Windows"],"owner":"raghavagps","publication":[{"doi":"10.1093/nar/gkl343","metadata":{"abstract":"In this study a systematic attempt has been made to integrate various approaches in order to predict allergenic proteins with high accuracy. The dataset used for testing and training consists of 578 allergens and 700 non-allergens obtained from A. K. Bjorklund, D. Soeria-Atmadja, A. Zorzet, U. Hammerling and M. G. Gustafsson (2005) Bioinformatics, 21, 39-50. First, we developed methods based on support vector machine using amino acid and dipeptide composition and achieved an accuracy of 85.02 and 84.00%, respectively. Second, a motif-based method has been developed using MEME/MAST software that achieved sensitivity of 93.94 with 33.34% specificity. Third, a database of known IgE epitopes was searched and this predicted allergenic proteins with 17.47% sensitivity at specificity of 98.14%. Fourth, we predicted allergenic proteins by performing BLAST search against allergen representative peptides. Finally hybrid approaches have been developed, which combine two or more than two approaches. The performance of all these algorithms has been evaluated on an independent dataset of 323 allergens and on 101 725 non-allergens obtained from Swiss-Prot. A web server AlgPred has been developed for the predicting allergenic proteins and for mapping IgE epitopes on allergenic proteins (http://www.imtech.res.in/raghava/ algpred/). AlgPred is available at www.imtech.res.in/raghava/algpred/.","authors":[{"name":"Raghava G.P.S."},{"name":"Saha S."}],"citationCount":592,"date":"2006-07-01T00:00:00Z","journal":"Nucleic Acids Research","title":"AlgPred: Prediction of allergenic proteins and mapping of IgE epitopes"},"pmcid":"PMC1538830","pmid":"16844994"}],"topic":[{"term":"Function analysis","uri":"http://edamontology.org/topic_1775"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"},{"term":"Structure prediction","uri":"http://edamontology.org/topic_0082"}],"validated":1},"bioschemas":{"name":"AlgPred","home":"https://bio.tools/algpred","summary":"Predicts allergenic proteins and maps IgE epitopes on allergenic proteins using several different approaches.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:algpred/web/webs.iiitd.edu.in","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":294,"citations":[{"count":2,"year":"-1"},{"count":2,"year":"2011"},{"count":2,"year":"2012"},{"count":3,"year":"2007"},{"count":3,"year":"2014"},{"count":3,"year":"2015"},{"count":4,"year":"2008"},{"count":4,"year":"2013"},{"count":5