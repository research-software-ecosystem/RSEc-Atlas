{"tool_name":"clustergrammer","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"clustergrammer","identifiers":["biotools:clustergrammer","doi:10.1038/sdata.2017.151"],"license":"MIT","summary":"A python module for the clustergrammer visualization project","home_url":"https://github.com/MaayanLab/clustergrammer-py","keywords":["Animals","Electronic Data Processing","Gene Expression","Gene Expression Profiling","Humans","Proteomics","Data visualisation","Physiology","RNA","Clustering"],"manually_check":true,"total_pulls":0},"biotools":{"id":"clustergrammer","home":"https://maayanlab.github.io/CCLE_Clustergrammer/","license":"CC-BY-4.0","summary":"Web-based heatmap visualization and analysis tool for high-dimensional biological data.","addition_date":"2018-07-09T16:57:43Z","last_update_date":"2024-11-25T14:32:24.474871Z","tool_type":["Web application"],"biotools_curie":"biotools:clustergrammer","credit":[{"name":"Avi Ma\u2019ayan","typeEntity":"Person","typeRole":["Primary contact"],"url":"https://www.nature.com/articles/sdata2017151/email/correspondent/c1/new"}],"documentation":[{"type":["General"],"url":"https://maayanlab.github.io/CCLE_Clustergrammer/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Heat map generation","uri":"http://edamontology.org/operation_0531"}]}],"name":"Clustergrammer","operating_system":["Linux","Mac","Windows"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1038/sdata.2017.151","metadata":{"abstract":"Most tools developed to visualize hierarchically clustered heatmaps generate static images. Clustergrammer is a web-based visualization tool with interactive features such as: Zooming, panning, filtering, reordering, sharing, performing enrichment analysis, and providing dynamic gene annotations. Clustergrammer can be used to generate shareable interactive visualizations by uploading a data table to a web-site, or by embedding Clustergrammer in Jupyter Notebooks. The Clustergrammer core libraries can also be used as a toolkit by developers to generate visualizations within their own applications. Clustergrammer is demonstrated using gene expression data from the cancer cell line encyclopedia (CCLE), original post-translational modification data collected from lung cancer cells lines by a mass spectrometry approach, and original cytometry by time of flight (CyTOF) single-cell proteomics data from blood. Clustergrammer enables producing interactive web based visualizations for the analysis of diverse biological data.","authors":[{"name":"Fernandez N.F."},{"name":"Grimes M.L."},{"name":"Gundersen G.W."},{"name":"Hornbeck P."},{"name":"Maayan A."},{"name":"Rahman A."},{"name":"Rikova K."}],"citationCount":158,"date":"2017-10-10T00:00:00Z","journal":"Scientific Data","title":"Clustergrammer, a web-based heatmap visualization and analysis tool for high-dimensional biological data"},"pmcid":"PMC5634325","pmid":"28994825"}],"topic":[{"term":"Data visualisation","uri":"http://edamontology.org/topic_0092"},{"term":"Physiology","uri":"http://edamontology.org/topic_3300"},{"term":"RNA","uri":"http://edamontology.org/topic_0099"}],"validated":1},"bioschemas":{"name":"Clustergrammer","home":"https://bio.tools/clustergrammer","license":"CC-BY-4.0","summary":"Web-based heatmap visualization and analysis tool for high-dimensional biological data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:clustergrammer/web/maayanlab.github.io","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_sour