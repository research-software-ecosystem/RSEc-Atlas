{"tool_name":"deepimagej","contents":["biotools","oeb"],"identifiers":["biotools:deepimagej"],"fetched_metadata":{"biotools":{"id":"DeepImageJ","home":"https://deepimagej.github.io/deepimagej/","license":"GPL-3.0","summary":"A user-friendly plugin to run deep learning models in ImageJ. Websites for you and your projects, hosted directly from your GitHub repository. Just edit, push, and your changes are live.\n\nDeepImageJ is a user-friendly plugin that enables the use of a variety of pre-trained deep learning models in ImageJ and Fiji. The plugin bridges the gap between deep learning and standard life-science applications. DeepImageJ runs image-to-image operations on a standard CPU-based computer and does not require any deep learning expertise.","addition_date":"2020-01-09T17:54:30Z","last_update_date":"2020-12-20T10:44:02Z","tool_type":["Plug-in"],"biotools_curie":"biotools:DeepImageJ","edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Deisotoping","uri":"http://edamontology.org/operation_3629"},{"term":"Editing","uri":"http://edamontology.org/operation_3096"},{"term":"Standardisation and normalisation","uri":"http://edamontology.org/operation_3435"}]}],"name":"DeepImageJ","owner":"Pub2Tools","publication":[{"doi":"10.1101/799270"}],"topic":[{"term":"Bioengineering","uri":"http://edamontology.org/topic_3398"},{"term":"Imaging","uri":"http://edamontology.org/topic_3382"},{"term":"Informatics","uri":"http://edamontology.org/topic_0605"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:deepimagej/plugin/deepimagej.github.io","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpret