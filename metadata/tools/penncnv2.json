{"tool_name":"penncnv2","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"penncnv2","home":"https://github.com/WGLab/PennCNV2/","license":"Not licensed","summary":"A C++ software package for detection of copy number alterations on tumor samples from SNP arrays and NGS data.","addition_date":"2017-08-20T16:49:50Z","last_update_date":"2020-01-19T17:47:47Z","tool_type":["Command-line tool"],"collections":["Animal and Crop Genomics"],"biotools_curie":"biotools:penncnv2","credit":[{"email":"kai@openbioinformatics.org","typeEntity":"Person","typeRole":["Primary contact"]},{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://wglab.org/extra/contact"}],"documentation":[{"type":["General"],"url":"http://penncnv2.readthedocs.io/en/latest/"}],"edit_permission":{"authors":["animalandcropgenomics"],"type":"group"},"function":[{"operation":[{"term":"Structure analysis","uri":"http://edamontology.org/operation_2480"}]}],"name":"PennCNV2","operating_system":["Linux"],"owner":"admin","publication":[{"doi":"10.1093/bioinformatics/btt521","metadata":{"abstract":"Motivation: The accurate detection of copy number alterations (CNAs) in human genomes is important for understanding susceptibility to cancer and mechanisms of tumor progression. CNA detection in tumors from single nucleotide polymorphism (SNP) genotyping arrays is a challenging problem due to phenomena such as aneuploidy, stromal contamination, genomic waves and intra-tumor heterogeneity, issues that leading methods do not optimally address. Results: Here we introduce methods and software (PennCNV-tumor) for fast and accurate CNA detection using signal intensity data from SNP genotyping arrays. We estimate stromal contamination by applying a maximum likelihood approach over multiple discrete genomic intervals. By conditioning on signal intensity across the genome, our method accounts for both aneuploidy and genomic waves. Finally, our method uses a hidden Markov model to integrate multiple sources of information, including total and allele-specific signal intensity at each SNP, as well as physical maps to make posterior inferences of CNAs. Using real data from cancer cell-lines and patient tumors, we demonstrate substantial improvements in accuracy and computational efficiency compared with existing methods. \u00a9 The Author 2013. Published by Oxford University Press. All rights reserved.","authors":[{"name":"Chang X."},{"name":"Chen G.K."},{"name":"Curtis C."},{"name":"Wang K."}],"citationCount":7,"date":"2013-12-01T00:00:00Z","journal":"Bioinformatics","title":"Precise inference of copy number alterations in tumor samples from SNP arrays"},"pmcid":"PMC3834792","pmid":"24021380","type":["Primary"]}],"topic":[{"term":"DNA polymorphism","uri":"http://edamontology.org/topic_2885"},{"term":"DNA structural variation","uri":"http://edamontology.org/topic_3175"},{"term":"Medical informatics","uri":"http://edamontology.org/topic_3063"}],"validated":1},"bioschemas":{"name":"PennCNV2","home":"https://bio.tools/penncnv2","license":"Not licensed","summary":"A C++ software package for detection of copy number alterations on tumor samples from SNP arrays and NGS data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:penncnv2/cmd/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":false,"osi":false},"publications":[{"entries":[{"cit_count":10,"citations":[{"count":1,"year":"2014"},{"count":1,"year":"2015"},{"count":1,"year":"2019"},{"count":1,"year":"2024"},{"count":3,"year":"2016"},{"