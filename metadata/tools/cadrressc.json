{"tool_name":"cadrressc","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"cadrressc","home":"https://github.com/CSB5/CaDRReS-Sc","license":"GPL-3.0","summary":"Predicting heterogeneity in clone-specific therapeutic vulnerabilities using single-cell transcriptomic signatures.","addition_date":"2022-06-02T09:09:01.319833Z","last_update_date":"2022-06-02T09:09:01.322292Z","tool_type":["Library"],"accessibility":"Open access","biotools_curie":"biotools:cadrressc","cost":"Free of charge","credit":[{"email":"dasguptar@gis.a-star.edu.sg","name":"Ramanuj DasGupta","typeEntity":"Person"},{"email":"nagarajann@gis.a-star.edu.sg","name":"Niranjan Nagarajan","typeEntity":"Person"}],"edit_permission":{"type":"public"},"function":[{"operation":[{"term":"Aggregation","uri":"http://edamontology.org/operation_3436"},{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Small molecule design","uri":"http://edamontology.org/operation_4009"}]}],"name":"CaDRReS-Sc","operating_system":["Linux","Mac","Windows"],"owner":"Chan019","publication":[{"doi":"10.1186/S13073-021-01000-Y","metadata":{"abstract":"\u00a9 2021, The Author(s).While understanding molecular heterogeneity across patients underpins precision oncology, there is increasing appreciation for taking intra-tumor heterogeneity into account. Based on large-scale analysis of cancer omics datasets, we highlight the importance of intra-tumor transcriptomic heterogeneity (ITTH) for predicting clinical outcomes. Leveraging single-cell RNA-seq (scRNA-seq) with a recommender system (CaDRReS-Sc), we show that heterogeneous gene-expression signatures can predict drug response with high accuracy (80%). Using patient-proximal cell lines, we established the validity of CaDRReS-Sc\u2019s monotherapy (Pearson r>0.6) and combinatorial predictions targeting clone-specific vulnerabilities (>10% improvement). Applying CaDRReS-Sc to rapidly expanding scRNA-seq compendiums can serve as in silico screen to accelerate drug-repurposing studies. Availability: https://github.com/CSB5/CaDRReS-Sc.","authors":[{"name":"Chia S."},{"name":"Da Silva R.P."},{"name":"DasGupta R."},{"name":"Mongia A."},{"name":"Nagarajan N."},{"name":"Sharma A."},{"name":"Suphavilai C."},{"name":"Tu L."}],"date":"2021-12-01T00:00:00Z","journal":"Genome Medicine","title":"Predicting heterogeneity in clone-specific therapeutic vulnerabilities using single-cell transcriptomic signatures"},"pmcid":"PMC8680165","pmid":"34915921"}],"topic":[{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Oncology","uri":"http://edamontology.org/topic_2640"},{"term":"Pharmacogenomics","uri":"http://edamontology.org/topic_0208"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Transcriptomics","uri":"http://edamontology.org/topic_3308"}],"validated":1},"bioschemas":{"name":"CaDRReS-Sc","home":"https://bio.tools/cadrressc","license":"GPL-3.0","summary":"Predicting heterogeneity in clone-specific therapeutic vulnerabilities using single-cell transcriptomic signatures.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:cadrressc/lib/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":32,"citations":[{"count":1,"year":"2021"},{"count":3,"year":"2022"},{"count":3,"year":"2026"},{"count":6,"year":"2025"},{"count":9,"year":"2023"},{"count":10,"year":"2024"}],"doi":"10.1186/s13073-021-01000-y","pmcid":"PMC8680165","pmid":"34915921","ref_count":58,"refs":[{"count":1,"ye