{"tool_name":"humanmine","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"HumanMine","home":"https://www.humanmine.org/humanmine","license":"LGPL-2.1","summary":"HumanMine integrates many types of data for Homo sapiens and Mus musculus","addition_date":"2019-11-27T10:42:32Z","last_update_date":"2024-11-24T20:28:45.702446Z","tool_type":["Database portal","Web application","Web service"],"version":["6.0 2019 May"],"biotools_curie":"biotools:HumanMine","cost":"Free of charge","credit":[{"email":"support@intermine.org","typeEntity":"Person","typeRole":["Support"]}],"documentation":[{"type":["API documentation"],"url":"http://intermine.org/im-docs/docs/web-services/index"},{"type":["User manual"],"url":"http://intermine.org/intermine-user-docs"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Ontology data","uri":"http://edamontology.org/data_2353"}},{"data":{"term":"Sequence features","uri":"http://edamontology.org/data_1255"}}],"operation":[{"term":"Data retrieval","uri":"http://edamontology.org/operation_2422"},{"term":"Gene-set enrichment analysis","uri":"http://edamontology.org/operation_2436"},{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}],"output":[{"data":{"term":"Over-representation data","uri":"http://edamontology.org/data_3753"}},{"data":{"term":"Query script","uri":"http://edamontology.org/data_3786"}},{"data":{"term":"Sequence features","uri":"http://edamontology.org/data_1255"}}]}],"maturity":"Mature","name":"HumanMine","operating_system":["Linux","Mac"],"owner":"InterMine","publication":[{"doi":"10.1093/bioinformatics/bts577","metadata":{"abstract":"InterMine is an open-source data warehouse system that facilitates the building of databases with complex data integration requirements and a need for a fast customizable query facility. Using InterMine, large biological databases can be created from a range of heterogeneous data sources, and the extensible data model allows for easy integration of new data types. The analysis tools include a flexible query builder, genomic region search and a library of 'widgets' performing various statistical analyses. The results can be exported in many commonly used formats. InterMine is a fully extensible framework where developers can add new tools and functionality. Additionally, there is a comprehensive set of web services, for which client libraries are provided in five commonly used programming languages. \u00a9 The Author 2012. Published by Oxford University Press. All rights reserved.","authors":[{"name":"Aleksic J."},{"name":"Butano D."},{"name":"Carr A."},{"name":"Contrino S."},{"name":"Hu F."},{"name":"Kalderimis A."},{"name":"Lyne M."},{"name":"Lyne R."},{"name":"Micklem G."},{"name":"Rutherford K."},{"name":"Smith R.N."},{"name":"Stepan R."},{"name":"Sullivan J."},{"name":"Wakeling M."},{"name":"Watkins X."}],"citationCount":202,"date":"2012-12-01T00:00:00Z","journal":"Bioinformatics","title":"InterMine: A flexible data warehouse system for the integration and analysis of heterogeneous biological data"},"pmcid":"PMC3516146","pmid":"23023984","type":["Other"]}],"topic":[{"term":"Data management","uri":"http://edamontology.org/topic_3071"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"}],"validated":1},"bioschemas":{"name":"HumanMine","home":"https://bio.tools/HumanMine","license":"LGPL-2.1","version":"6.0 2019 May","summary":"HumanMine integrates many types of data for Homo sapiens and Mus musculus","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:humanmine:6.0_2019_May/db/www.humanmine.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"