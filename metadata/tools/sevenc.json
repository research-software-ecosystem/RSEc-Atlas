{"tool_name":"sevenc","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"sevenc","home":"https://bioconductor.org/packages/sevenC","license":"GPL-3.0","summary":"Chromatin looping is an essential feature of eukaryotic genomes and can bring regulatory sequences, such as enhancers or transcription factor binding sites, in the close physical proximity of regulated target genes. Here, we provide sevenC, an R package that uses protein binding signals from ChIP-seq and sequence motif information to predict chromatin looping events. Cross-linking of proteins that bind close to loop anchors result in ChIP-seq signals at both anchor loci. These signals are used at CTCF motif pairs together with their distance and orientation to each other to predict whether they interact or not. The resulting chromatin loops might be used to associate enhancers or transcription factor binding sites (e.g., ChIP-seq peaks) to regulated target genes.","addition_date":"2018-07-26T13:17:40Z","last_update_date":"2026-09-01T07:08:33.131427Z","tool_type":["Library"],"version":["1.32.0"],"collections":["BioConductor"],"biotools_curie":"biotools:sevenc","cost":"Free of charge","credit":[{"name":"Jonas Ibn-Salem","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/sevenC"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Annotation","uri":"http://edamontology.org/operation_0226"}]},{"operation":[{"term":"Classification","uri":"http://edamontology.org/operation_2990"}]},{"operation":[{"term":"Regression analysis","uri":"http://edamontology.org/operation_3659"}]}],"name":"sevenC","operating_system":["Linux","Mac","Windows"],"owner":"shadi.m","publication":[{"doi":"10.1186/s12864-019-6088-0"},{"doi":"10.1186/s12864-019-6088-0"}],"topic":[{"term":"ChIP-on-chip","uri":"http://edamontology.org/topic_3179"},{"term":"ChIP-seq","uri":"http://edamontology.org/topic_3169"},{"term":"Epigenetics","uri":"http://edamontology.org/topic_3295"},{"term":"Functional genomics","uri":"http://edamontology.org/topic_0085"}],"validated":1},"bioschemas":{"name":"sevenC","home":"https://bio.tools/sevenc","license":"GPL-3.0-only","version":"1.32.0","summary":"Chromatin looping is an essential feature of eukaryotic genomes and can bring regulatory sequences, such as enhancers or transcription factor binding sites, in the close physical proximity of regulated target genes. Here, we provide sevenC, an R package that uses protein binding signals from ChIP-seq and sequence motif information to predict chromatin looping events. Cross-linking of proteins that bind close to loop anchors result in ChIP-seq signals at both anchor loci. These signals are used at CTCF motif pairs together with their distance and orientation to each other to predict whether they interact or not. The resulting chromatin loops might be used to associate enhancers or transcription factor binding sites (e.g., ChIP-seq peaks) to regulated target genes.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:sevenc:1.0.0/lib/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"source_packages":true,"sourcecode":{"interpreted":true}},"project":{"build":{},"deployment":{},"documentation":{"manual":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":0,"citations":[],"doi":"10.1101/257584","pmcid":null,"pmid":null,"ref_count":0,"refs":[],"title":null,"year":null}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":301,"url":"https://bioconductor.org/packages/release/bioc/html/sevenC.html"}],"ssl":true,"ssl_err":null}},"support":{"email":true,"issue_tracking":{}}},{"@id":"https://openebench.bsc.es/mon