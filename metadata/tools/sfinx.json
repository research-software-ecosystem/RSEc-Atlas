{"tool_name":"sfinx","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"sfinx","home":"http://sfinx.ugent.be/","summary":"Straightforward filtering index for affinity purification mass spectrometry data analysis.","addition_date":"2016-05-17T10:19:00Z","last_update_date":"2024-11-24T20:58:26.427100Z","tool_type":["Web application"],"version":["1.04"],"collections":["BIG N2N","Proteomics","UGent","VIB"],"biotools_curie":"biotools:sfinx","credit":[{"email":"Sven.Eyckerman@UGent.be","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"ugent.be","typeEntity":"Institute","typeRole":["Provider"]}],"documentation":[{"type":["General"],"url":"http://sfinx.ugent.be/"}],"edit_permission":{"authors":["bits@vib.be","proteomics.bio.tools"],"type":"group"},"function":[{"input":[{"data":{"term":"Matrix","uri":"http://edamontology.org/data_2082"}}],"operation":[{"term":"Protein interaction analysis","uri":"http://edamontology.org/operation_2949"}],"output":[{"data":{"term":"Protein interaction data","uri":"http://edamontology.org/data_0906"}}]}],"name":"SFINX","operating_system":["Linux","Mac","Windows"],"owner":"Katrijn.Vannerum@ugent.be","publication":[{"doi":"10.1021/acs.jproteome.5b00666","metadata":{"abstract":"Affinity purification-mass spectrometry is one of the most common techniques for the analysis of protein-protein interactions, but inferring bona fide interactions from the resulting data sets remains notoriously difficult. We introduce SFINX, a Straightforward Filtering INdeX that identifies true-positive protein interactions in a fast, user-friendly, and highly accurate way. SFINX outperforms alternative techniques on two benchmark data sets and is available via the Web interface at http://sfinx.ugent.be/.","authors":[{"name":"Eyckerman S."},{"name":"Gevaert K."},{"name":"Laukens K."},{"name":"Martens L."},{"name":"Meysman P."},{"name":"Tavernier J."},{"name":"Titeca K."}],"citationCount":16,"date":"2016-01-04T00:00:00Z","journa