webchem.ncbr.muni.cz/Wiki/MotiveValidator:UserManual"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"PDB ID","uri":"http://edamontology.org/data_1127"},"format":[{"term":"PDB","uri":"http://edamontology.org/format_1476"}]},{"data":{"term":"Structure","uri":"http://edamontology.org/data_0883"},"format":[{"term":"PDB","uri":"http://edamontology.org/format_1476"},{"term":"mmCIF","uri":"http://edamontology.org/format_1477"}]}],"note":"Any 3D structure (protein/nucleic acid/carbohydrate/lipid/complexes) can serve as an input structure.","operation":[{"term":"Format validation","uri":"http://edamontology.org/operation_0336"}],"output":[{"data":{"term":"Protein structural quality report","uri":"http://edamontology.org/data_1539"}}]}],"maturity":"Mature","name":"MotiveValidator","operating_system":["Linux","Mac","Windows"],"owner":"ELIXIR-CZ","publication":[{"doi":"10.1093/nar/gku426","metadata":{"abstract":"Structure validation has become a major issue in the structural biology community, and an essential step is checking the ligand structure. This paper introduces MotiveValidator, a web-based application for the validation of ligands and residues in PDB or PDBx/mmCIF format files provided by the user. Specifically, MotiveValidator is able to evaluate in a straightforward manner whether the ligand or residue being studied has a correct annotation (3-letter code), i.e. if it has the same topology and stereochemistry as the model ligand or residue with this annotation. If not, MotiveValidator explicitly describes the differences. MotiveValidator offers a user-friendly, interactive and platform-independent environment for validating structures obtained by any type of experiment. The results of the validation are presented in both tabular and graphical form, facilitating their interpretation. MotiveValidator can process thousands of ligands or residues in a single validation run that takes no more than a few minutes. MotiveValidator can be used for testing single structures, or the analysis of large sets of ligands or fragments prepared for binding site analysis, docking or virtual screening. MotiveValidator is freely available via the Internet at http://ncbr.muni.cz/MotiveValidator. \u00a9 2014 The Author(s).","authors":[{"name":"Geidl S."},{"name":"Horsky V."},{"name":"Ionescu C.-M."},{"name":"Jaiswal D."},{"name":"Koca J."},{"name":"Pravda L."},{"name":"Sehnal D."},{"name":"Varekova R.S."},{"name":"Wimmerova M."}],"citationCount":10,"date":"2014-07-01T00:00:00Z","journal":"Nucleic Acids Research","title":"MotiveValidator: Interactive web-based validation of ligand and residue structure in biomolecular complexes"},"pmcid":"PMC4086108","pmid":"24848013","type":["Primary"]}],"topic":[{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"},{"term":"Structure analysis","uri":"http://edamontology.org/topic_0081"}],"validated":1},"bioschemas":{"name":"MotiveValidator","home":"https://bio.tools/motivevalidator","version":"1.1","summary":"A web application for validation of annotation of ligands and \nresidues.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:motivevalidator:1.1/cmd/webchem.ncbr.muni.cz","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{},"sourcecode":{"interpreted":false}},"project":{"build":{},"deployment":{},"documentation":{"citation":true,"general":true},"publications":[{"entries":[{"cit_count":7,"citations":[{"count":1,"year":"2014"},{"count":1,"year":"2015"},{"count":1,"year":"2016"},{"count":1,"year":"2017"},{"count":1,"year":"2019"},{"count":2,"year":"2020"}],"doi":"10.1093/nar/gku426","pmcid":"PMC4086108","pmid":"24848013","ref_count":24,"refs":[{"count":1,"year":"-1"},{"count":1,"year":"2000"},{"count":1,"year":"2003"},{"count":1,"year":"2010"},{"count":1,"year":"2013"},{"count":2,"year":"1996"},{"count":2,"year":"20