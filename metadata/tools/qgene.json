{"tool_name":"qgene","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"qgene","home":"http://www.qgene.org/","summary":"Comparative analyses of QTL (Quantitative Trait Locus) mapping data sets.","addition_date":"2017-12-18T00:11:32Z","last_update_date":"2024-11-24T20:26:25.190321Z","tool_type":["Desktop application"],"version":["4.3.10"],"biotools_curie":"biotools:qgene","credit":[{"typeEntity":"Person","typeRole":["Primary contact"],"url":"http://www.qgene.org/jcn/Nelson_home.html"}],"documentation":[{"type":["User manual"],"url":"http://www.qgene.org/qgene/current/docs/manual/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Mapping","uri":"http://edamontology.org/operation_2429"}]},{"operation":[{"term":"QTL mapping","uri":"http://edamontology.org/operation_0282"}]}],"name":"QGene","operating_system":["Linux","Mac","Windows"],"owner":"mbs_import","publication":[{"doi":"10.1093/bioinformatics/btn523","metadata":{"abstract":"Of many statistical methods developed to date for quantitative trait locus (QTL) analysis, only a limited subset are available in public software allowing their exploration, comparison and practical application by researchers. We have developed QGene 4.0, a plug-in platform that allows execution and comparison of a variety of modern QTL-mapping methods and supports third-party addition of new ones. The software accommodates line-cross mating designs consisting of any arbitrary sequence of selfing, backcrossing, intercrossing and haploid-doubling steps that includes map, population, and trait simulators; and is scriptable. \u00a9 The Author 2008. Published by Oxford University Press. All rights reserved.","authors":[{"name":"Joehanes R."},{"name":"Nelson J.C."}],"citationCount":306,"date":"2008-12-01T00:00:00Z","journal":"Bioinformatics","title":"QGene 4.0, an extensible Java QTL-analysis platform"},"pmid":"18940826","type":["Primary"]}],"topic":[{"term":"Genetics","uri":"http://edamontolo