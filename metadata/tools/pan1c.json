{"tool_name":"pan1c","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"pan1c","home":"https://forge.inrae.fr/genotoul-bioinfo/Pan1c/pan1c","license":"AGPL-3.0","summary":"Pan1c is a Snakemake workflow that simplifies the creation of pangenomes by focusing on the comparison of similar chromosomes, using either PGGB or Minigraph-Cactus.\nA pangenome graph is first generated individually for each chromosome, and then these chromosome-scale pangenomes are concatenated into a final graph. This approach reduces construction time through parallelization and facilitates interpretation as well as downstream analyses. Throughout the process, various graphs and statistics are produced to help users assess the quality of the pangenome graph and interpret the results.\nAll these visualizations and statistics are accessible via a web page generated by Pan1c-view.","addition_date":"2026-08-25T10:04:25.598750Z","last_update_date":"2026-08-25T11:40:00.095755Z","tool_type":["Workflow"],"version":["1.14"],"accessibility":"Open access","biotools_curie":"biotools:pan1c","cost":"Free of charge","credit":[{"email":"christophe.klopp@inrae.fr","name":"Christophe Klopp","orcidid":"https://orcid.org/0000-0001-7126-5477","typeEntity":"Person","typeRole":["Primary contact"]},{"name":"Philippe Bardou","orcidid":"https://orcid.org/0000-0002-0004-0251","typeEntity":"Person","typeRole":["Developer"]},{"name":"Alexis Mergez","typeEntity":"Person","typeRole":["Developer"]},{"name":"Martin Racoupeau","typeEntity":"Person","typeRole":["Developer"]},{"name":"GenoToul bioinformatics facility","typeEntity":"Institute","typeRole":["Provider"],"url":"https://bioinfo.genotoul.fr/"}],"documentation":[{"type":["General"],"url":"https://forge.inrae.fr/genotoul-bioinfo/Pan1c/pan1c/-/wikis/home"}],"edit_permission":{"type":"group"},"maturity":"Mature","name":"Pan1c","operating_system":["Linux"],"owner":"pbordron","publication":[{"doi":"10.64898/2026.04.17.719212","type":["Preprint"]}],"topic":[{