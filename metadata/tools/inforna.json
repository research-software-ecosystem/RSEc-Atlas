 and intuitively arranged and easy to use. The procedure is fast, as most applications are completed within seconds and it proceeds better and faster than other existing tools. The INFO-RNA web server is freely available at http://www.bioinf. uni-freiburg.de/Software/INFO-RNA/. \u00a9 2007 The Author(s).","authors":[{"name":"Backofen R."},{"name":"Busch A."}],"citationCount":23,"date":"2007-07-01T00:00:00Z","journal":"Nucleic Acids Research","title":"INFO-RNA-a server for fast inverse RNA folding satisfying sequence constraints"},"pmcid":"PMC1933236","pmid":"17452349","type":["Primary"]}],"topic":[{"term":"Sequence analysis","uri":"http://edamontology.org/topic_0080"}],"validated":1},"bioschemas":{"name":"INFORNA Sequence Design","home":"https://bio.tools/inforna","version":"2.2.0","summary":"RNA sequence design by inverse folding.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:inforna:2.2.0/web/rna.informatik.uni-freiburg.de","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true,"help":true},"publications":[{"entries":[{"cit_count":19,"citations":[{"count":1,"year":"2008"},{"count":1,"year":"2010"},{"count":1,"year":"2013"},{"count":1,"year":"2018"},{"count":1,"year":"2019"},{"count":1,"year":"2021"},{"count":1,"year":"2022"},{"count":1,"year":"2025"},{"count":2,"year":"2011"},{"count":2,"year":"2017"},{"count":3,"year":"2023"},{"count":4,"year":"2015"}],"doi":"10.1093/nar/gkm218","pmcid":"PMC1933236","pmid":"17452349","ref_count":11,"refs":[{"count":1,"year":"1994"},{"count":1,"year":"1997"},{"count":1,"year":"1998"},{"count":1,"year":"2000"},{"count":1,"year":"2003"},{"count":2,"year":"1996"},{"count":2,"year":"2002"},{"count":2,"year":"2006"}],"title":"INFO-RNA--a server for fast inverse RNA folding satisfying sequence constraints.","year":2007}]}],"summary":{"descrip