{"tool_name":"juicer","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"juicer","home":"https://github.com/aidenlab/juicer","license":"MIT","summary":"Juicer is a platform for analyzing kilobase resolution Hi-C data. In this distribution, we include the pipeline for generating Hi-C maps from fastq raw data files and command line tools for feature annotation on the Hi-C maps.","addition_date":"2021-05-26T20:31:17Z","last_update_date":"2024-11-24T20:21:30.131661Z","tool_type":["Script"],"biotools_curie":"biotools:juicer","credit":[{"email":"erez@erez.com","name":"Erez Lieberman Aiden","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://aidenlab.org/"},{"name":"The Center for Genome Architecture","typeEntity":"Division","typeRole":["Primary contact"],"url":"http://aidenlab.org/"}],"documentation":[{"type":["FAQ"],"url":"https://github.com/aidenlab/juicer/wiki/FAQ"},{"type":["General"],"url":"https://github.com/aidenlab/juicer/wiki"},{"type":["Installation instructions"],"url":"https://github.com/aidenlab/juicer/wiki/Installation"},{"type":["Quick start guide"],"url":"https://github.com/aidenlab/juicer/wiki/Installation#quick-start"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genome indexing","uri":"http://edamontology.org/operation_3211"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"Juicer","operating_system":["Linux","Mac","Windows"],"owner":"Kigaard","publication":[{"doi":"10.1016/j.cels.2016.07.002","metadata":{"abstract":"Hi-C experiments explore the 3D structure of the genome, generating terabases of data to create high-resolution contact maps. Here, we introduce Juicer, an open-source tool for analyzing terabase-scale Hi-C datasets. Juicer allows users without a computational background to transform raw sequence data into normalized contact maps with one click. Juicer produces a hic file containing compressed contact matrices at many resolutions, facilitating visualization and analysis at multiple scales. Structural features, such as loops and domains, are automatically annotated. Juicer is available as open source software at http://aidenlab.org/juicer/.","authors":[{"name":"Aiden E.L."},{"name":"Durand N.C."},{"name":"Huntley M.H."},{"name":"Lander E.S."},{"name":"Machol I."},{"name":"Rao S.S.P."},{"name":"Shamim M.S."}],"citationCount":1822,"date":"2016-07-27T00:00:00Z","journal":"Cell Systems","title":"Juicer Provides a One-Click System for Analyzing Loop-Resolution Hi-C Experiments"},"pmcid":"PMC5846465","pmid":"27467249","type":["Primary"]}],"topic":[{"term":"Epigenetics","uri":"http://edamontology.org/topic_3295"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Mapping","uri":"http://edamontology.org/topic_0102"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}]},"bioschemas":{"name":"Juicer","home":"https://bio.tools/juicer","license":"MIT","summary":"Juicer is a platform for analyzing kilobase resolution Hi-C data. In this distribution, we include the pipeline for generating Hi-C maps from fastq raw data files and command line tools for feature annotation on the Hi-C maps.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:juicer/script/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":true,"license":true,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"faq":true,"general":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":2562,"citations":[{"count":1,"year":"-1"},{"count":3,"year":"2016"},{"count":19,"year":"2017"},{"count":37,"year":"2018"},{"count":82,"year":"2019