{"tool_name":"rarevariantvis","contents":["bioconda","oeb","biotools"],"fetched_metadata":{"bioconda":{"name":"bioconductor-rarevariantvis","version":"2.38.0","home":"https://bioconductor.org/packages/3.22/bioc/html/RareVariantVis.html","license":"Artistic-2.0","summary":"A suite for analysis of rare genomic variants in whole genome sequencing data","identifiers":["biotools:rarevariantvis","doi:10.1093/bioinformatics/btw359"],"description":"Second version of RareVariantVis package aims to provide comprehensive information about rare variants for your genome data. It annotates, filters and presents genomic variants (especially rare ones) in a global, per chromosome way. For discovered rare variants CRISPR guide RNAs are designed, so the user can plan further functional studies. Large structural variants, including copy number variants are also supported. Package accepts variants directly from variant caller - for example GATK or Speedseq. Output of package are lists of variants together with adequate visualization. Visualization of variants is performed in two ways - standard that outputs png figures and interactive that uses JavaScript d3 package. Interactive visualization allows to analyze trio/family data, for example in search for causative variants in rare Mendelian diseases, in point-and-click interface. The package includes homozygous region caller and allows to analyse whole human genomes in less than 30 minutes on a desktop computer. RareVariantVis disclosed novel causes of several rare monogenic disorders, including one with non-coding causative variant - keratolythic winter erythema.","build":{"noarch":"generic","number":0,"rpaths":["lib/R/lib/","lib/"],"run_exports":""},"requirements":{"host":["bioconductor-biocgenerics >=0.56.0,<0.57.0","bioconductor-bsgenome >=1.78.0,<1.79.0","bioconductor-bsgenome.hsapiens.ucsc.hg19 >=1.4.0,<1.5.0","bioconductor-genomeinfodb >=1.46.0,<1.47.0","bioconductor-genomicfeatures >=1.62.0,<1.63.0","bioconductor-genomicranges >=1.62.0,<1.63.0","bioconductor-genomicscores >=2.22.0,<2.23.0","bioconductor-iranges >=2.44.0,<2.45.0","bioconductor-phastcons100way.ucsc.hg19 >=3.7.0,<3.8.0","bioconductor-s4vectors >=0.48.0,<0.49.0","bioconductor-summarizedexperiment >=1.40.0,<1.41.0","bioconductor-txdb.hsapiens.ucsc.hg19.knowngene >=3.22.0,<3.23.0","bioconductor-variantannotation >=1.56.0,<1.57.0","r-base","r-googlevis","r-gtools"],"run":["bioconductor-biocgenerics >=0.56.0,<0.57.0","bioconductor-bsgenome >=1.78.0,<1.79.0","bioconductor-bsgenome.hsapiens.ucsc.hg19 >=1.4.0,<1.5.0","bioconductor-genomeinfodb >=1.46.0,<1.47.0","bioconductor-genomicfeatures >=1.62.0,<1.63.0","bioconductor-genomicranges >=1.62.0,<1.63.0","bioconductor-genomicscores >=2.22.0,<2.23.0","bioconductor-iranges >=2.44.0,<2.45.0","bioconductor-phastcons100way.ucsc.hg19 >=3.7.0,<3.8.0","bioconductor-s4vectors >=0.48.0,<0.49.0","bioconductor-summarizedexperiment >=1.40.0,<1.41.0","bioconductor-txdb.hsapiens.ucsc.hg19.knowngene >=3.22.0,<3.23.0","bioconductor-variantannotation >=1.56.0,<1.57.0","r-base","r-googlevis","r-gtools"]},"source_url":["https://bioconductor.org/packages/3.22/bioc/src/contrib/RareVariantVis_2.38.0.tar.gz","https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RareVariantVis/RareVariantVis_2.38.0.tar.gz","https://bioarchive.galaxyproject.org/RareVariantVis_2.38.0.tar.gz","https://depot.galaxyproject.org/software/bioconductor-rarevariantvis/bioconductor-rarevariantvis_2.38.0_src_all.tar.gz"],"test":{"commands":["$R -e \"library('RareVariantVis')\""]},"parent_recipe":{"name":"bioconductor-rarevariantvis","path":"recipes/bioconductor-rarevariantvis","version":"2.8.0"}},"biotools":{"id":"rarevariantvis","home":"https://bioconductor.org/packages/RareVariantVis","license":"Artistic-2.0","summary":"Second version of RareVariantVis package aims to provide comprehensive information about rare variants for your genome data. It annotates, filters and presents genomic variants (especially rare ones) in a global, per chromosome way. For discovered rare variants CRISPR guide RNAs are designed, so the user can plan further functional studies. Large structural variants, including copy number variants are also supported. Package accepts variants directly from variant caller - for example GATK or Speedseq. Output of package are lists of variants together with adequate visualization. Visualization of variants is performed in two ways - standard that outputs png figures and interactive that uses JavaScript d3 package. Interactive visualization allows to analyze trio/family data, for example in search for causative variants in rare Mendelian diseases, in point-and-click interface. The package includes homozygous region caller and allows to analyse whole human genomes in less than 30 minutes on a desktop computer. RareVariantVis disclosed novel causes of several rare monogenic disorders, including one with non-coding causative variant - keratolythic winter erythema.","addition_date":"2017-01-17T15:04:00Z","last_update_date":"2024-11-25T13:46:08.109883Z","tool_type":["Command-line tool","Library"],"version":["2.40.0"],"collections":["BioConductor"],"accessibility":"Open access","biotools_curie":"biotools:rarevariantvis","cost":"Free of charge","credit":[{"name":"Adam Gudys and Tomasz Stokowy"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/RareVariantVis"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genetic variation analysis","uri":"http://edamontology.org/operation_3197"}]}],"maturity":"Mature","name":"RareVariantVis","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[],"topic":[{"term":"Genetic variation","uri":"http://edamontology.org/topic_0199"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Rare diseases","uri":"http://edamontology.org/topic_3325"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"oeb":{"metrics":[