{"tool_name":"sanxot","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"SanXoT","home":"https://www.cnic.es/wiki/proteomica/index.php/SanXoT_software_package","license":"Apache-2.0","summary":"Modular and versatile package for the quantitative analysis of high-throughput proteomics experiments.","addition_date":"2019-05-31T13:54:10Z","last_update_date":"2020-06-16T10:55:22Z","tool_type":["Script"],"accessibility":"Open access","biotools_curie":"biotools:SanXoT","cost":"Free of charge","credit":[{"email":"ebonzon@cnic.es","name":"E. Bonzon-Kulichenko","typeEntity":"Person","typeRole":["Primary contact"]},{"email":"jvazquez@cnic.es","name":"Jes\u00fas Mar\u00eda V\u00e1zquez Cobos","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"note":"Tutorial material","type":["Training material"],"url":"https://www.cnic.es/wiki/proteomica/index.php/How_to_use_SanXoT"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Quantification","uri":"http://edamontology.org/operation_3799"}]}],"maturity":"Mature","name":"SanXoT","operating_system":["Linux","Mac","Windows"],"owner":"Ruta","publication":[{"doi":"10.1093/bioinformatics/bty815","metadata":{"abstract":"\u00a9 The Author(s) 2018. Published by Oxford University Press. All rights reserved.Mass spectrometry-based proteomics has had a formidable development in recent years, increasing the amount of data handled and the complexity of the statistical resources needed. Here we present SanXoT, an open-source, standalone software package for the statistical analysis of high-throughput, quantitative proteomics experiments. SanXoT is based on our previously developed weighted spectrum, peptide and protein statistical model and has been specifically designed to be modular, scalable and user-configurable. SanXoT allows limitless workflows that adapt to most experimental setups, including quantitative protein analysis in multiple experiments, systems biology, quantification of post-translational modifications and comparison and merging of experimental data from technical or biological replicates.","authors":[{"name":"Bagwan N."},{"name":"Bonzon-Kulichenko E."},{"name":"Ezkurdia I."},{"name":"Garcia-Marques F."},{"name":"Jorge I."},{"name":"Rodriguez J.M."},{"name":"Trevisan-Herraz M."},{"name":"Vazquez J."}],"citationCount":18,"date":"2019-05-01T00:00:00Z","journal":"Bioinformatics","title":"SanXoT: A modular and versatile package for the quantitative analysis of high-throughput proteomics experiments"},"pmcid":"PMC6499250","pmid":"30252043","type":["Primary"]}],"topic":[{"term":"Protein modifications","uri":"http://edamontology.org/topic_0601"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"}],"validated":1},"bioschemas":{"name":"SanXoT","home":"https://bio.tools/SanXoT","license":"Apache-2.0","summary":"Modular and versatile package for the quantitative analysis of high-throughput proteomics experiments.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:sanxot/script/www.cnic.es","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"documentation":{"training_material":true},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":45,"citations":[{"count":2,"year":"2025"},{"count":3,"year":"2019"},{"count":3,"year":"2021"},{"count":6,"year":"2020"},{"count":7,"year":"2023"},{"count":7,"year":"2026"},{"count":8,"year":"2024"},{"count":9,"year":"2022"}],"doi":"10.1093/bioinformatics/bty815","pmcid":"PMC6499250","pm