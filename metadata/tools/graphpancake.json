{"tool_name":"graphpancake","contents":["biotools"],"identifiers":["biotools:graphpancake"],"fetched_metadata":{"biotools":{"id":"graphpancake","home":"https://graphpancake.readthedocs.io","license":"MIT","summary":"graphpancake is an open-source Python package that generates molecular graphs for small organic molecules by translating quantum mechanical data (DFT/WFT) into graph representations. It is designed for cheminformatics pipelines, enabling advanced predictive modeling like QSAR.","addition_date":"2026-11-04T14:48:51.556290Z","last_update_date":"2026-11-04T14:48:51.558342Z","biotools_curie":"biotools:graphpancake","credit":[{"email":"scheidt@northwestern.edu","name":"Karl A Scheidt","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Essential dynamics","uri":"http://edamontology.org/operation_3891"},{"term":"Quantification","uri":"http://edamontology.org/operation_3799"},{"term":"Regression analysis","uri":"http://edamontology.org/operation_3659"},{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"graphpancake","owner":"pub2tools2024","publication":[{"doi":"10.1186/S13321-026-01182-W","pmcid":"PMC13162441","pmid":"41917968"}],"topic":[{"term":"Cheminformatics","uri":"http://edamontology.org/topic_2258"},{"term":"Chemistry","uri":"http://edamontology.org/topic_3314"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Molecular biology","uri":"http://edamontology.org/topic_3047"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"}]}}}