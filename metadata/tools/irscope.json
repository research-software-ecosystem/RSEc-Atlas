{"tool_name":"irscope","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"irscope","home":"https://irscope.shinyapps.io/irapp/","summary":"Visualize the junction sites of chloroplast genomes.","addition_date":"2018-06-02T07:44:55Z","last_update_date":"2024-11-25T14:36:59.795448Z","tool_type":["Script","Web application"],"biotools_curie":"biotools:irscope","credit":[{"email":"ali.amiryousefi@helsinki.fi","name":"Ali Amiryousefi","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://github.com/Limpfrog/irscope"},{"type":["General"],"url":"https://irscope.shinyapps.io/irapp/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Genome visualisation","uri":"http://edamontology.org/operation_3208"}]}],"name":"IRscope","operating_system":["Linux","Mac","Windows"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1093/bioinformatics/bty220","metadata":{"abstract":"Motivation: Genome plotting is performed using a wide range of visualizations tools each with emphasis on a different informative dimension of the genome. These tools can provide a deeper insight into the genomic structure of the organism. Results: Here, we announce a new visualization tool that is specifically designed for chloroplast genomes. It allows the users to depict the genetic architecture of up to ten chloroplast genomes in the vicinity of the sites connecting the inverted repeats to the short and long single copy regions. The software and its dependent libraries are fully coded in R and the reflected plot is scaled up to realistic size of nucleotide base pairs in the vicinity of the junction sites. We introduce a website for easier use of the program and R source code of the software to be used in case of preferences to be changed and integrated into personal pipelines. The input of the program is an annotation GenBank (.gb) file, the accession or GI number of the sequence or a DOGMA output file. The software was tested using over a 100 embryophyte chloroplast genomes and in all cases a reliable output was obtained.","authors":[{"name":"Amiryousefi A."},{"name":"Hyvonen J."},{"name":"Poczai P."}],"citationCount":665,"date":"2018-09-01T00:00:00Z","journal":"Bioinformatics","title":"IRscope: an online program to visualize the junction sites of chloroplast genomes"},"pmid":"29659705"}],"topic":[{"term":"Data visualisation","uri":"http://edamontology.org/topic_0092"},{"term":"Genomics","uri":"http://edamontology.org/topic_0622"},{"term":"Plant biology","uri":"http://edamontology.org/topic_0780"}],"validated":1},"bioschemas":{"name":"IRscope","home":"https://bio.tools/irscope","summary":"Visualize the junction sites of chloroplast genomes.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:irscope/script/irscope.shinyapps.io","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":false,"sourcecode":{"free":null,"interpreted":true,"license":null,"public":true,"readme":false,"repository":{"anonymous":null,"online":null}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":651,"citations":[{"count":1,"year":"-1"},{"count":4,"year":"2018"},{"count":15,"year":"2019"},{"count":37,"year":"2020"},{"count":53,"year":"2026"},{"count":65,"year":"2021"},{"count":107,"year":"2023"},{"count":109,"year":"2025"},{"count":128,"year":"2022"},{"count":132,"year":"2024"}],"doi":"10.1093/bioinformatics/bty220","pmid":"29659705","ref_count":0,"refs":[],"title":"IRscope: an online program to visualize the junction sites of chloroplast genomes.","year":2018}]}],"readme":false,"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":202,"ssl":true,