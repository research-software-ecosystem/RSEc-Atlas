{"tool_name":"ampseek","contents":["biotools"],"identifiers":["biotools:ampseek"],"fetched_metadata":{"biotools":{"id":"ampseek","home":"https://github.com/bcgsc/AMPSeek","license":"GPL-3.0","summary":"AMPSeek is a workflow designed to predict the antimicrobial activity, toxicity, and three-dimensional structure of candidate antimicrobial peptides using in silico methods. It integrates several specialized tools (AMPlify, tAMPer, LocalColabFold) into a single command-line framework for efficient high-throughput screening.","addition_date":"2026-11-04T10:30:31.288302Z","last_update_date":"2026-11-04T10:30:31.291447Z","biotools_curie":"biotools:ampseek","credit":[{"email":"ezhang@bcgsc.ca","name":"Emily Zhang","orcidid":"https://orcid.org/0009-0007-7609-8971","typeEntity":"Person"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Antimicrobial resistance prediction","uri":"http://edamontology.org/operation_3482"}]}],"name":"AMPSeek: Antimicrobial Peptide Prediction Workflow","owner":"pub2tools2024","publication":[{"doi":"10.1002/CPZ1.70325","pmcid":"PMC12919377","pmid":"41711565"}],"topic":[{"term":"Antimicrobial resistance","uri":"http://edamontology.org/topic_4013"},{"term":"Machine learning","uri":"http://edamontology.org/topic_3474"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Small molecules","uri":"http://edamontology.org/topic_0154"},{"term":"Workflows","uri":"http://edamontology.org/topic_0769"}]}}}