{"tool_name":"pathfams","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"pathfams","home":"https://pathfams.uwaterloo.ca","summary":"Statistical detection of pathogen-associated protein domains.","addition_date":"2022-02-12T12:39:59.204406Z","last_update_date":"2022-02-12T12:39:59.207003Z","tool_type":["Database portal","Web application"],"accessibility":"Open access","biotools_curie":"biotools:pathfams","cost":"Free of charge","credit":[{"email":"acdoxey@uwaterloo.ca","name":"Andrew C. Doxey","typeEntity":"Person"},{"name":"Benjamin Jean-Marie Tremblay"},{"name":"Briallen Lobb"},{"name":"Gabriel Moreno-Hagelsieb"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Enrichment analysis","uri":"http://edamontology.org/operation_3501"},{"term":"Fold recognition","uri":"http://edamontology.org/operation_0303"},{"term":"Sequence assembly","uri":"http://edamontology.org/operation_0310"},{"term":"Virulence prediction","uri":"http://edamontology.org/operation_3461"}]}],"name":"PathFams","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1186/S12864-021-07982-8","metadata":{"abstract":"\u00a9 2021, The Author(s).Background: A substantial fraction of genes identified within bacterial genomes encode proteins of unknown function. Identifying which of these proteins represent potential virulence factors, and mapping their key virulence determinants, is a challenging but important goal. Results: To facilitate virulence factor discovery, we performed a comprehensive analysis of 17,929 protein domain families within the Pfam database, and scored them based on their overrepresentation in pathogenic versus non-pathogenic species, taxonomic distribution, relative abundance in metagenomic datasets, and other factors. Conclusions: We identify pathogen-associated domain families, candidate virulence factors in the human gut, and eukaryotic-like mimicry domains with likely roles in virulence. Furthermore, we provide an interactive database called PathFams to allow users to explore pathogen-associated domains as well as identify pathogen-associated domains and domain architectures in user-uploaded sequences of interest. PathFams is freely available at https://pathfams.uwaterloo.ca.","authors":[{"name":"Doxey A.C."},{"name":"Lobb B."},{"name":"Moreno-Hagelsieb G."},{"name":"Tremblay B.J.-M."}],"date":"2021-12-01T00:00:00Z","journal":"BMC Genomics","title":"PathFams: statistical detection of pathogen-associated protein domains"},"pmcid":"PMC8442362","pmid":"34521345"}],"topic":[{"term":"Gene and protein families","uri":"http://edamontology.org/topic_0623"},{"term":"Gene structure","uri":"http://edamontology.org/topic_0114"},{"term":"Metagenomics","uri":"http://edamontology.org/topic_3174"},{"term":"Protein folds and structural domains","uri":"http://edamontology.org/topic_0736"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"}],"validated":1},"bioschemas":{"name":"PathFams","home":"https://bio.tools/pathfams","summary":"Statistical detection of pathogen-associated protein domains.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pathfams/db/pathfams.uwaterloo.ca","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":6,"citations":[{"count":1,"year":"2023"},{"count":1,"year":"2026"},{"count":2,"year":"2024"},{"count":2,"year":"2025"}],"doi":"10.1186/s12864-021-07982-8","pmcid":"PMC8442362","pmid":"34521345","ref_count":48,"refs":[{"count":1,"year":"1999"},{"count":1,"year":"2009"},{"count":1,"year":"2020"},{"count":1,"year":"2021"},{"count":2,"year":"2001"},{"count":2,"year":"2005"},{"count":2,"year":"2006"},{"count":2,"year":"2007"},{"count":2,"year":"2008"},{"count":3,"year":"2012"},{"count":3,"year":"2013"},{"count":3,"year":"2017"},{"count":