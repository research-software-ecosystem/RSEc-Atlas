{"tool_name":"pathwaysplice","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"pathwaysplice","home":"https://bioconductor.org/packages/release/bioc/html/PathwaySplice.html","license":"LGPL-2.0","summary":"Unbiased pathway analysis of alternative splicing in RNA-Seq data.","addition_date":"2018-06-01T15:30:14Z","last_update_date":"2024-11-25T14:33:32.069819Z","tool_type":["Library"],"version":["1.4.0"],"collections":["BioConductor"],"biotools_curie":"biotools:pathwaysplice","credit":[{"email":"aimin.at.work@gmail.com","name":"Aimin Yan","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/release/bioc/manuals/PathwaySplice/man/PathwaySplice.pdf"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Gene-set enrichment analysis","uri":"http://edamontology.org/operation_2436"}]},{"operation":[{"term":"Regression analysis","uri":"http://edamontology.org/operation_3659"}]},{"operation":[{"term":"Splicing model analysis","uri":"http://edamontology.org/operation_2499"}]},{"operation":[{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"PathwaySplice","operating_system":["Linux","Mac","Windows"],"owner":"d.gabrielaitis","publication":[{"doi":"10.1093/bioinformatics/bty317","metadata":{"abstract":"Pathway analysis of alternative splicing would be biased without accounting for the different number of exons or junctions associated with each gene, because genes with higher number of exons or junctions are more likely to be included in the \u2018significant\u2019 gene list in alternative splicing. We present PathwaySplice, an R package that (i) Performs pathway analysis that explicitly adjusts for the number of exons or junctions associated with each gene; (ii) visualizes selection bias due to different number of exons or junctions for each gene and formally tests for presence of bias using logistic regression; (iii) supports gene sets based on the Gene Ontology terms, as well as more broadly defined gene sets (e.g. MSigDB) or user defined gene sets; (iv) identifies the significant genes driving pathway significance and (v) organizes significant pathways with an enrichment map, where pathways with large number of overlapping genes are grouped together in a network graph.","authors":[{"name":"Ban Y."},{"name":"Chen X."},{"name":"Gao Z."},{"name":"Wang L."},{"name":"Yan A."}],"citationCount":2,"date":"2018-09-15T00:00:00Z","journal":"Bioinformatics","title":"PathwaySplice: An R package for unbiased pathway analysis of alternative splicing in RNA-Seq data"},"pmcid":"PMC6137985","pmid":"29688305"}],"topic":[{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"RNA splicing","uri":"http://edamontology.org/topic_3320"},{"term":"RNA-Seq","uri":"http://edamontology.org/topic_3170"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"}],"validated":1},"bioschemas":{"name":"PathwaySplice","home":"https://bio.tools/pathwaysplice","license":"LGPL-2.0","version":"1.4.0","summary":"Unbiased pathway analysis of alternative splicing in RNA-Seq data.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:pathwaysplice/lib/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"source_packages":true,"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"documentation":{"general":true,"manual":true},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":2,"citations":[{"count":1,"year":"2019"},{"count":1,"year":"2023"}],"doi":"10.1093/bioinformatics/bty317","pmcid":"PMC6137985","pmid":"29688305","ref_count":8,"refs":[{"count":1,"year":"2003"},{"count":1,"year":"2005"},{"count":1,"year":"2012"},{"count":1,"year":"2014