{"tool_name":"bioconductor-tidyspatialexperiment","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bioconductor-tidyspatialexperiment","home":"https://bioconductor.org/packages/tidySingleCellExperiment","license":"GPL-3.0","summary":"'tidySingleCellExperiment' is an adapter that abstracts the 'SingleCellExperiment' container in the form of a 'tibble'. This allows *tidy* data manipulation, nesting, and plotting. For example, a 'tidySingleCellExperiment' is directly compatible with functions from 'tidyverse' packages `dplyr` and `tidyr`, as well as plotting with `ggplot2` and `plotly`. In addition, the package provides various utility functions specific to single-cell omics data analysis (e.g., aggregation of cell-level data to pseudobulks).","addition_date":"2026-08-31T21:26:15.718745Z","last_update_date":"2026-09-01T06:33:30.685846Z","tool_type":["Command-line tool","Library"],"version":["1.22.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-tidyspatialexperiment","credit":[{"name":"Stefano Mangiola","typeEntity":"Person","typeRole":["Developer","Maintainer"]}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/tidySingleCellExperiment"}],"edit_permission":{"type":"private"},"name":"tidySpatialExperiment","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.1038/s41592-024-02299-2"}]},"bioschemas":{"name":"tidySpatialExperiment","home":"https://bio.tools/bioconductor-tidyspatialexperiment","license":"GPL-3.0-or-later","version":"1.8.0","summary":"tidySpatialExperiment provides a bridge between the SpatialExperiment package and the tidyverse ecosystem. It creates an invisible layer that allows you to interact with a SpatialExperiment object as if it were a tibble; enabling the use of functions from dplyr, tidyr, ggplot2 and plotly. But, underneath, your data remains a SpatialExperiment object.","tool_type":"sc:SoftwareApplication"},"oeb":{"