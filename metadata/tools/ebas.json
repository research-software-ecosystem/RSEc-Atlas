{"tool_name":"ebas","contents":["oeb","biotools"],"fetched_metadata":{"biotools":{"id":"ebas","home":"http://motif.stanford.edu/distributions/emotif/","summary":"Analyze groups of proteins or entire proteomes for the presence of eMOTIFs in batch fashion.","addition_date":"2017-12-18T00:14:44Z","last_update_date":"2019-01-15T02:55:32Z","tool_type":["Command-line tool"],"version":["3.6"],"biotools_curie":"biotools:ebas","credit":[{"email":"yhuang@leland.stanford.edu","name":"Jimmy Y. Huang","typeEntity":"Person","typeRole":["Primary contact"],"url":"http://motif.stanford.edu/"}],"documentation":[{"type":["General"],"url":"http://motif.stanford.edu/distributions/emotif/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Database search","uri":"http://edamontology.org/operation_2421"}]}],"name":"eBAS","operating_system":["Linux","Mac"],"owner":"mbs_import","publication":[{"metadata":{"abstract":"The EMOTIF database is a collection of more than 170 000 highly specific and sensitive protein sequence motifs representing conserved biochemical properties and biological functions. These protein motifs are derived from 7697 sequence alignments in the BLOCKS+ database (released on June 23, 2000) and all 8244 protein sequence alignments in the PRINTS database (version 27.0) using the EMOTIF-MAKER algorithm developed by Nevill-Manning et al. (Nevill-Manning, C.G., Wu,T.D. and Brutlag,D.L. (1998) Proc. Natl Acad. Sci. USA, 95, 5865-5871; Nevill-Manning, C.G., Sethi,K.S., Wu,T.D. and Brutlag,D.L. (1997) ISMB-97, 5, 202-209). Since the amino acids and the groups of amino acids in these sequence motifs represent critical positions conserved in evolution, search algorithms employing the EMOTIF patterns can identify and classify more widely divergent sequences than methods based on global sequence similarity. The EMOTIF protein pattern database is available at http:// motif.stanford.edu/emotif/.","authors":[{"name":"Brutlag D.L."},{"name":"Huang J.Y."}],"citationCount":106,"date":"2001-01-01T00:00:00Z","journal":"Nucleic Acids Research","title":"The EMOTIF database"},"pmcid":"PMC29837","pmid":"11125091","type":["Primary"]}],"topic":[{"term":"DNA","uri":"http://edamontology.org/topic_0654"},{"term":"Proteins","uri":"http://edamontology.org/topic_0078"},{"term":"Sequences","uri":"http://edamontology.org/topic_0080"}],"validated":1},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:ebas:3.6/cmd/motif.stanford.edu","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":36,"citations":[{"count":1,"year":"2004"},{"count":1,"year":"2009"},{"count":1,"year":"2011"},{"count":1,"year":"2016"},{"count":1,"year":"2022"},{"count":2,"year":"2008"},{"count":2,"year":"2010"},{"count":3,"year":"2012"},{"count":4,"year":"2002"},{"count":4,"year":"2005"},{"count":5,"year":"2006"},{"count":5,"year":"2007"},{"count":6,"year":"2003"}],"doi":"10.1093/nar/29.1.202","pmcid":"PMC29837","pmid":"11125091","ref_count":6,"refs":[{"count":1,"year":"1997"},{"count":1,"year":"1998"},{"count":4,"year":"2000"}],"title":"The EMOTIF database.","year":2001}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":302,"url":"https://motif.stanford.edu/distributions/emotif/"}],"ssl":true,"ssl_err":null}},"support":{"email":true}},{"@id":"https://openebench.bsc.es/monitor/metrics/ebas","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"redirects":[{"status":302,"url":"https://motif.stanford.edu/distributions/emotif/"}],"ssl":true,"ssl_err":null}}}]}}}