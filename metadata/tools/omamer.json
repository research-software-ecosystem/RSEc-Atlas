{"tool_name":"omamer","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"omamer","home":"https://github.com/DessimozLab/omamer","license":"LGPL-3.0","summary":"Tree-driven and alignment-free protein assignment to subfamilies outperforms closest sequence approaches.\n\nOMAmer is a novel alignment-free protein family assignment method, which limits over-specific subfamily assignments and is suited to phylogenomic databases with thousands of genomes. It is based on an innovative method using subfamily-informed k-mers for alignment-free mapping to ancestral protein subfamilies. Whilst able to reject non-homologous family-level assignments, it has provided better and quicker subfamily-level assignments than a method based on closest sequences (using DIAMOND).","addition_date":"2021-01-18T08:58:11Z","last_update_date":"2025-10-06T10:22:09.299189Z","tool_type":["Command-line tool"],"version":["2.1.0","2.1.1"],"accessibility":"Open access","biotools_curie":"biotools:omamer","cost":"Free of charge","credit":[{"email":"nikolai.romashchenko@unil.ch","name":"Nikolai Romashchenko","orcidid":"https://orcid.org/0000-0002-2264-5219","typeEntity":"Person","typeRole":["Developer","Maintainer"]},{"email":"Christophe.Dessimoz@unil.ch","name":"Christophe Dessimoz","typeEntity":"Person"},{"email":"Marc.Robinson-Rechavi@unil.ch","name":"Marc Robinson-Rechavi","typeEntity":"Person"},{"name":"Alex Warwick Vesztrocy","orcidid":"https://orcid.org/0000-0002-4074-4261","typeEntity":"Person","typeRole":["Developer"]}],"edit_permission":{"authors":["nromashchenko"],"type":"group"},"function":[{"operation":[{"term":"Genome indexing","uri":"http://edamontology.org/operation_3211"},{"term":"Local alignment","uri":"http://edamontology.org/operation_0495"},{"term":"Query and retrieval","uri":"http://edamontology.org/operation_0224"},{"term":"Taxonomic classification","uri":"http://edamontology.org/operation_3460"},{"term":"k-mer counting","uri":"http://edamontology.org/op