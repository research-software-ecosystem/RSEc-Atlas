{"tool_name":"glanet","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"GLANET","home":"https://github.com/burcakotlu/GLANET","license":"Unlicense","summary":"Genomic loci annotation and enrichment tool.","addition_date":"2019-07-07T14:27:43Z","last_update_date":"2024-11-24T21:08:24.597012Z","tool_type":["Command-line tool","Desktop application"],"accessibility":"Open access","biotools_curie":"biotools:GLANET","cost":"Free of charge","credit":[{"email":"burcak@ceng.metu.edu.tr","name":"Bur\u00e7ak Otlu","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["General"],"url":"https://glanet.readthedocs.io/en/latest/"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Enrichment analysis","uri":"http://edamontology.org/operation_3501"},{"term":"Genetic variation analysis","uri":"http://edamontology.org/operation_3197"}]}],"maturity":"Mature","name":"GLANET","operating_system":["Linux","Mac","Windows"],"owner":"Ruta","publication":[{"doi":"10.1093/bioinformatics/btx326","metadata":{"abstract":"Motivation: Genomic studies identify genomic loci representing genetic variations, transcription factor (TF) occupancy, or histone modification through next generation sequencing (NGS) technologies. Interpreting these loci requires evaluating them with known genomic and epigenomic annotations. Results: We present GLANET as a comprehensive annotation and enrichment analysis tool which implements a sampling-based enrichment test that accounts for GC content and/or mappability biases, jointly or separately. GLANET annotates and performs enrichment analysis on these loci with a rich library. We introduce and perform novel data-driven computational experiments for assessing the power and Type-I error of its enrichment procedure which show that GLANET has attained high statistical power and well-controlled Type-I error rate. As a key feature, users can easily extend its library with new gene sets and genomic intervals. Other key features include assessment of impact of single nucleotide variants (SNPs) on TF binding sites and regulation based pathway enrichment analysis. Availability and implementation: GLANET can be run using its GUI or on command line. GLANET's source code is available at https://github.com/burcakotlu/GLANET. Tutorials are provided at https://glanet.readthedocs.org.","authors":[{"name":"Firtina C."},{"name":"Keles S."},{"name":"Otlu B."},{"name":"Tastan O."}],"citationCount":13,"date":"2017-09-15T00:00:00Z","journal":"Bioinformatics","title":"GLANET: Genomic loci annotation and enrichment tool"},"pmcid":"PMC6355098","pmid":"28541490","type":["Primary"]}],"topic":[{"term":"Epigenomics","uri":"http://edamontology.org/topic_3173"},{"term":"Sequencing","uri":"http://edamontology.org/topic_3168"},{"term":"Transcription factors and regulatory sites","uri":"http://edamontology.org/topic_0749"}],"validated":1},"bioschemas":{"name":"GLANET","home":"https://bio.tools/GLANET","license":"Unlicense","summary":"Genomic loci annotation and enrichment tool.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:glanet/app/github.com","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"binaries":{"freeness":null,"registration":null},"packages":null,"source_packages":true,"sourcecode":{"free":true,"interpreted":false,"license":false,"public":true,"readme":true,"repository":{"anonymous":true,"online":true}}},"project":{"build":{},"deployment":{},"documentation":{"general":true},"license":{"open_source":true,"osi":false},"publications":[{"entries":[{"cit_count":8,"citations":[{"count":1,"year":"2018"},{"count":1,"year":"2019"},{"count":1,"year":"2022"},{"count":2,"year":"2021"},{"count":3,"year":"2020"}],"doi":"10.1093/bioinformatics/btx326","pmcid":"PMC6355098","pmid":"28541490","ref_count":37,"refs":[{"count":1,"year":"-1"},{"coun