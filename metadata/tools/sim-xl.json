{"tool_name":"sim-xl","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"sim-xl","home":"http://patternlabforproteomics.org/sim-xl","summary":"Spectrum Identification Machine for Cross-Linked Peptides.","addition_date":"2017-01-17T14:51:43Z","last_update_date":"2024-11-25T14:11:09.993288Z","tool_type":["Desktop application"],"collections":["Proteomics","ms-utils"],"biotools_curie":"biotools:sim-xl","credit":[{"email":"webmaster@ms-utils.org","typeEntity":"Person","typeRole":["Documentor"],"url":"http://ms-utils.org"}],"documentation":[{"type":["General"],"url":"http://patternlabforproteomics.org/sim-xl/Work.html"}],"edit_permission":{"authors":["proteomics.bio.tools"],"type":"group"},"function":[{"input":[{"data":{"term":"Mass spectrometry spectra","uri":"http://edamontology.org/data_0943"},"format":[{"term":"Thermo RAW","uri":"http://edamontology.org/format_3712"}]},{"data":{"term":"Peptide mass fingerprint","uri":"http://edamontology.org/data_0944"},"format":[{"term":"MGF","uri":"http://edamontology.org/format_3651"},{"term":"mzML","uri":"http://edamontology.org/format_3244"}]},{"data":{"term":"Sequence set (protein)","uri":"http://edamontology.org/data_1233"},"format":[{"term":"FASTA","uri":"http://edamontology.org/format_1929"}]}],"operation":[{"term":"Heat map generation","uri":"http://edamontology.org/operation_0531"},{"term":"Mass spectrum visualisation","uri":"http://edamontology.org/operation_3694"},{"term":"Pathway or network visualisation","uri":"http://edamontology.org/operation_3083"},{"term":"Plotting","uri":"http://edamontology.org/operation_3441"},{"term":"Protein feature detection","uri":"http://edamontology.org/operation_3092"},{"term":"Protein interaction analysis","uri":"http://edamontology.org/operation_2949"},{"term":"Protein structure analysis","uri":"http://edamontology.org/operation_2406"},{"term":"Sequence database search","uri":"http://edamontology.org/operation_0338"}],"output":[{"data":{"term":"Protein interaction data","uri":"http://edamontology.org/data_0906"},"format":[{"term":"mzIdentML","uri":"http://edamontology.org/format_3247"}]}]}],"name":"SIM-XL","operating_system":["Windows"],"owner":"msutils_import","publication":[{"doi":"10.1016/j.jprot.2015.01.013","metadata":{"abstract":"Chemical cross-linking has emerged as a powerful approach for the structural characterization of proteins and protein complexes. However, the correct identification of covalently linked (cross-linked or XL) peptides analyzed by tandem mass spectrometry is still an open challenge. Here we present SIM-XL, a software tool that can analyze data generated through commonly used cross-linkers (e.g., BS3/DSS). Our software introduces a new paradigm for search-space reduction, which ultimately accounts for its increase in speed and sensitivity. Moreover, our search engine is the first to capitalize on reporter ions for selecting tandem mass spectra derived from cross-linked peptides. It also makes available a 2D interaction map and a spectrum-annotation tool unmatched by any of its kind. We show SIM-XL to be more sensitive and faster than a competing tool when analyzing a data set obtained from the human HSP90. The software is freely available for academic use at http://patternlabforproteomics.org/sim-xl. A video demonstrating the tool is available at http://patternlabforproteomics.org/sim-xl/video. SIM-XL is the first tool to support XL data in the mzIdentML format; all data are thus available from the ProteomeXchange consortium (identifier PXD001677).This article is part of a Special Issue entitled: Computational Proteomics.","authors":[{"name":"Balbuena T.S."},{"name":"Barbosa V.C."},{"name":"Carvalho P.C."},{"name":"Gozzo F.C."},{"name":"Lima D.B."},{"name":"Neves-Ferreira A.G.C."},{"name":"de Lima T.B."}],"citationCount":70,"date":"2014-12-17T00:00:00Z","journal":"Journal of Proteomics","title":"SIM-XL: A powerful and user-friendly tool for peptide cross-linking analysis"},"pmid":"25638023"}],"topic":[{"term":"Protein interactions","uri":"http://edamontology.org/topic_0128"},{"term":"Protein structure analysis","uri":"http://edamontology.org/topic_2814"},{"term":"Proteomics","uri":"http://edamontology.org/topic_0121"},{"term":"Proteomics experiment","uri":"http://edamontology.org/topic_3520"}],"validated":1},"bioschemas":{"name":"SIM-XL","home":"https://bio.tools/sim-xl","summary":"Spectrum Identification Machine for Cross-Linked Peptides.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:sim-xl/app/patternlabforproteomics.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"documentation":{"general":true},"publications":[{"entries":[{"cit_count":40,"citations":[{"count":1,"year":"2015"},{"count":1,"year":"2023"},{"count":1,"year":"2026"},{"count":2,"year":"2022"},{"count":2,"year":"2025"},{"count":3,"year":"2017"},{"count":4,"year":"2018"},{"count":4,"year":"2024"},{"count":5,"year":"2020"},{"count":5,"year":"2021"},{"count":6,"year":"2016"},{"count":6,"year":"2019"}],"doi":"10.1016/j.jprot.2015.01.013","pmid":"25638023","ref_count":0,"refs":[],"title":"SIM-XL: A powerful and user-friendly tool for peptide cross-linking analysis.","year":2015}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":200,"redirects":[{"status":301,"url":"http://patternlabforproteomics.org/sim-xl/"}],"ssl":null,"ssl_err":null}},"support":{"email":true}},{"@id":"https://openebench.bsc.es/monitor/metrics/sim-xl","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":null,"@type":"metrics","project":{"build":{},"deployment":{},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":false,"license":false,"operational":200,"redirects":[{"status":301,"url":"http://patternlabforprote