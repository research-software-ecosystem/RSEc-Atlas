{"tool_name":"souporcell","contents":["bioconda","oeb","bioschemas","biotools"],"fetched_metadata":{"bioconda":{"name":"souporcell","version":"2.5","home":"https://github.com/wheaton5/souporcell","license":"MIT","summary":"Clustering scRNAseq by genotypes.","identifiers":["doi:10.1101/699637v1","biotools:souporcell"],"license_file":["LICENSE","souporcell/souporcell-THIRDPARTY.yml","troublet/troublet-THIRDPARTY.yml"],"build":{"number":0,"run_exports":[null],"skip":true},"requirements":{"build":[null,null,"cargo-bundle-licenses"],"run":["python","pysam","pystan <3","pyvcf","numpy","pyfaidx","scipy","bcftools >=1.9","bedtools >=2.28","freebayes >=1.3","htslib >=1.9","hisat2","minimap2 >=2.26","samtools >=1.9","vartrix"]},"source_url":"https://github.com/wheaton5/souporcell/archive/refs/tags/v2.5.tar.gz","test":{"commands":["${PREFIX}/bin/souporcell/target/release/souporcell -h","${PREFIX}/bin/troublet/target/release/troublet -h","compile_stan_model.py -h","consensus.py -h","renamer.py -h","retag.py -h","shared_samples.py -h","souporcell_pipeline.py -h"]}},"biotools":{"id":"souporcell","home":"https://github.com/wheaton5/souporcell","license":"MIT","summary":"A method for clustering mixed-genotype scRNAseq experiments by individual.","addition_date":"2020-06-08T06:52:54Z","last_update_date":"2024-11-24T20:59:14.677604Z","tool_type":["Command-line tool"],"accessibility":"Open access","biotools_curie":"biotools:souporcell","cost":"Free of charge","documentation":[{"type":["Quick start guide"],"url":"https://github.com/wheaton5/souporcell/blob/master/README.md"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Identifier","uri":"http://edamontology.org/data_0842"},"format":[{"term":"TSV","uri":"http://edamontology.org/format_3475"}]},{"data":{"term":"Nucleic acid sequence alignment","uri":"http://edamontology.org/data_1383"},"format":[{"term":"BAM","uri":"http://edamontology.org/format_2572"}]}],"operation":[{"term":"Sequence clustering","uri":"http://edamontology.org/operation_0291"}],"output":[{"data":{"term":"Sequence variations","uri":"http://edamontology.org/data_3498"},"format":[{"term":"VCF","uri":"http://edamontology.org/format_3016"}]}]}],"maturity":"Emerging","name":"Souporcell","operating_system":["Linux"],"owner":"ELIXIR-EE","publication":[{"doi":"10.1038/s41592-020-0820-1","metadata":{"abstract":"Methods to deconvolve single-cell RNA-sequencing (scRNA-seq) data are necessary for samples containing a mixture of genotypes, whether they are natural or experimentally combined. Multiplexing across donors is a popular experimental design that can avoid batch effects, reduce costs and improve doublet detection. By using variants detected in scRNA-seq reads, it is possible to assign cells to their donor of origin and identify cross-genotype doublets that may have highly similar transcriptional profiles, precluding detection by transcriptional profile. More subtle cross-genotype variant contamination can be used to estimate the amount of ambient RNA. Ambient RNA is caused by cell lysis before droplet partitioning and is an important confounder of scRNA-seq analysis. Here we develop souporcell, a method to cluster cells using the genetic variants detected within the scRNA-seq reads. We show that it achieves high accuracy on genotype clustering, doublet detection and ambient RNA estimation, as demonstrated across a range of challenging scenarios.","authors":[{"name":"Durbin R."},{"name":"Gaffney D.J."},{"name":"Heaton H."},{"name":"Hemberg M."},{"name":"Imaz M."},{"name":"Knights A."},{"name":"Lawniczak M.K.N."},{"name":"Talman A.M."}],"citationCount":181,"date":"2020-06-01T00:00:00Z","journal":"Nature Methods","title":"Souporcell: robust clustering of single-cell RNA-seq data by genotype without reference genotypes"},"pmid":"32366989","type":["Primary"]}],"topic":[{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"}],"validated":1},"bioschemas":{"name":"Souporcell","home":"https://bio.t