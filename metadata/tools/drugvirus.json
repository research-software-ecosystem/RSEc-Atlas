{"tool_name":"drugvirus","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"drugvirus","home":"https://drugvirus.info/","summary":"Discovery and Development of Safe-in-Man Broad-Spectrum Antiviral Agents.","addition_date":"2020-01-14T20:14:13Z","last_update_date":"2020-12-09T15:39:42Z","tool_type":["Web application"],"collections":["COVID-19"],"accessibility":"Open access","biotools_curie":"biotools:drugvirus","edit_permission":{"type":"public"},"name":"DrugVirus","owner":"Pub2Tools","publication":[{"doi":"10.20944/preprints201910.0144.v1"},{"doi":"10.20944/preprints201910.0144.v2"},{"doi":"10.20944/preprints201910.0144.v3"},{"doi":"10.20944/preprints201910.0144.v4"},{"doi":"10.20944/preprints201910.0144.v5"},{"doi":"10.20944/preprints201910.0144.v6"},{"doi":"10.1016/j.ijid.2020.02.018","metadata":{"abstract":"\u00a9 2020 The AuthorsViral diseases are one of the leading causes of morbidity and mortality in the world. Virus-specific vaccines and antiviral drugs are the most powerful tools to combat viral diseases. However, broad-spectrum antiviral agents (BSAAs, i.e. compounds targeting viruses belonging to two or more viral families) could provide additional protection of the general population from emerging and re-emerging viral diseases, reinforcing the arsenal of available antiviral options. Here, we review discovery and development of BSAAs and summarize the information on 120 safe-in-man agents in a freely accessible database (https://drugvirus.info/). Future and ongoing pre-clinical and clinical studies will increase the number of BSAAs, expand the spectrum of their indications, and identify drug combinations for treatment of emerging and re-emerging viral infections as well as co-infections.","authors":[{"name":"Andersen P.I."},{"name":"Bjoras M."},{"name":"Dumpis U."},{"name":"Ianevski A."},{"name":"Irie Y."},{"name":"Kainov D.E."},{"name":"Kantele A."},{"name":"Lutsar I."},{"name":"Lysvand H."},{"name":"Oksenych V."},{"name":"Telling K."},{"name":"Tenson T."},{"name":"Vitkauskiene A."}],"citationCount":64,"date":"2020-04-01T00:00:00Z","journal":"International Journal of Infectious Diseases","title":"Discovery and development of safe-in-man broad-spectrum antiviral agents"},"pmcid":"PMC7128205","pmid":"32081774"}],"topic":[{"term":"Drug development","uri":"http://edamontology.org/topic_3373"},{"term":"Drug discovery","uri":"http://edamontology.org/topic_3336"},{"term":"Drug metabolism","uri":"http://edamontology.org/topic_3375"},{"term":"Infectious disease","uri":"http://edamontology.org/topic_3324"},{"term":"Preclinical and clinical studies","uri":"http://edamontology.org/topic_3379"}],"validated":1},"bioschemas":{"name":"DrugVirus","home":"https://bio.tools/drugvirus","summary":"Discovery and Development of Safe-in-Man Broad-Spectrum Antiviral Agents.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:drugvirus/web/drugvirus.info","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"project":{"build":{},"deployment":{},"publications":[{"entries":[{"cit_count":120,"citations":[{"count":2,"year":"2026"},{"count":12,"year":"2023"},{"count":12,"year":"2025"},{"count":14,"year":"2024"},{"count":21,"year":"2022"},{"count":26,"year":"2021"},{"count":33,"year":"2020"}],"doi":"10.1016/j.ijid.2020.02.018","pmcid":"PMC7128205","pmid":"32081774","ref_count":113,"refs":[{"count":1,"year":"-1"},{"count":1,"year":"1967"},{"count":1,"year":"1972"},{"count":1,"year":"1977"},{"count":1,"year":"1983"},{"count":1,"year":"1990"},{"count":1,"year":"2002"},{"count":1,"year":"2008"},{"count":1,"year":"2009"},{"count":2,"year":"2004"},{"count":2,"year":"2007"},{"count":2,"year":"2010"},{"count":2,"year":"2020"},{"count":4,"year":"2011"},{"count":5,"year":"2012"},{"count":5,"year":"2014"},{"count":6,"year":"2013"},{"count":6,"year":"2015"},{"count":14,"year":"2019"},{"count":17,"year":"201