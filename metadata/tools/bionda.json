{"tool_name":"bionda","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"bionda","home":"http://bionda.mpc.rub.de/start.php","license":"CC-BY-4.0","summary":"The BIONDA biomarker database provides structured information on all biomarker candidates published in PubMed articles. There is no limitation to any kind of diseases. To this end, PubMed article abstracts and renowned databases such as UniProt and Human Disease Ontology are used as sources for BIONDA\u2019s database entries. These are acquired automatically and updated regularly using text mining methods. BIONDA is available freely via a user-friendly web interface. As a specific characteristic, BIONDA\u2019s database entries are rated by a scoring approach estimating biomarker reliability.","addition_date":"2020-10-01T09:40:44Z","last_update_date":"2023-11-29T13:28:37.748525Z","tool_type":["Database portal","Web service"],"version":["1..1.10"],"collections":["BioInfra.Prot","COVID-19","de.NBI"],"accessibility":"Open access (with restrictions)","biotools_curie":"biotools:bionda","cost":"Free of charge","credit":[{"email":"anika.frericks@rub.de","name":"Ruhr-Universitaet Bochum, Medizinisches Proteom-Center (MPC)","typeRole":["Developer"]},{"email":"michael.turewicz@rub.de","name":"Ruhr-Universitaet Bochum, Medizinisches Proteom-Center (MPC)","typeRole":["Contributor"]},{"name":"bioinfoservice@rub.de","typeEntity":"Division","typeRole":["Primary contact"]}],"documentation":[{"note":"Documentation and help page for biomarker database BIONDA. The documentation contains general information, information about us and technical aspects as well as tutorials for search and curaation in BIONDA. The curation page and the feedback page can also be reached from there.","type":["Contributions policy","General","Training material","User manual"],"url":"http://bionda.mpc.ruhr-uni-bochum.de/help.php"}],"edit_permission":{"type":"private"},"function":[{"input":[{"data":{"term":"Accession","uri":"ht