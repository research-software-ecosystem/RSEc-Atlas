{"tool_name":"bioconductor-scope","contents":["bioschemas","biotools","oeb","biocontainers"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-scope","identifiers":["doi:10.18129/b9.bioc.scope"],"license":"GPL-2","summary":"A normalization and copy number estimation method for single-cell DNA sequencing","home_url":"https://bioconductor.org/packages/3.11/bioc/html/SCOPE.html","keywords":[],"manually_check":true,"total_pulls":4},"biotools":{"id":"bioconductor-scope","home":"https://bioconductor.org/packages/SCOPE","license":"GPL-2.0","summary":"Whole genome single-cell DNA sequencing (scDNA-seq) enables characterization of copy number profiles at the cellular level. This circumvents the averaging effects associated with bulk-tissue sequencing and has increased resolution yet decreased ambiguity in deconvolving cancer subclones and elucidating cancer evolutionary history. ScDNA-seq data is, however, sparse, noisy, and highly variable even within a homogeneous cell population, due to the biases and artifacts that are introduced during the library preparation and sequencing procedure. Here, we propose SCOPE, a normalization and copy number estimation method for scDNA-seq data.","addition_date":"2026-10-02T16:08:28.543512Z","last_update_date":"2026-10-02T16:08:28.545603Z","tool_type":["Command-line tool","Library"],"version":["1.24.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-scope","credit":[{"name":"Danyu Lin"},{"name":"Rujin Wang"},{"name":"Yuchao Jiang"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/SCOPE"}],"edit_permission":{"type":"private"},"name":"SCOPE","operating_system":["Linux","Mac","Windows"],"owner":"gh2biotools","publication":[{"doi":"10.18129/B9.bioc.SCOPE"}]},"bioschemas":{"name":"SCOPE","home":"https://bio.tools/bioconductor-scope","license":"GPL-2.0","version":"1.24.0","summary":"Whole genome single-cell DNA sequencing (scDNA-seq) enables characterization of copy number profil