{"tool_name":"bioconductor-pipeframe","contents":["biocontainers","oeb","bioschemas","biotools"],"fetched_metadata":{"biocontainers":{"name":"bioconductor-pipeframe","identifiers":["doi:10.18129/b9.bioc.pipeframe"],"license":"GPL-3","summary":"Pipeline framework for bioinformatics in R","home_url":"https://bioconductor.org/packages/3.9/bioc/html/pipeFrame.html","keywords":[],"manually_check":true,"total_pulls":3},"biotools":{"id":"bioconductor-pipeframe","home":"https://bioconductor.org/packages/pipeFrame","license":"GPL-3.0","summary":"pipeFrame is an R package for building a componentized bioinformatics pipeline. Each step in this pipeline is wrapped in the framework, so the connection among steps is created seamlessly and automatically. Users could focus more on fine-tuning arguments rather than spending a lot of time on transforming file format, passing task outputs to task inputs or installing the dependencies. Componentized step elements can be customized into other new pipelines flexibly as well. This pipeline can be split into several important functional steps, so it is much easier for users to understand the complex arguments from each step rather than parameter combination from the whole pipeline. At the same time, componentized pipeline can restart at the breakpoint and avoid rerunning the whole pipeline, which may save a lot of time for users on pipeline tuning or such issues as power off or process other interrupts.","tool_type":["Command-line tool","Library"],"version":["1.28.0"],"collections":["BioConductor"],"biotools_curie":"biotools:bioconductor-pipeframe","credit":[{"name":"Shining Ma"},{"name":"Zheng Wei"}],"documentation":[{"type":["User manual"],"url":"https://bioconductor.org/packages/pipeFrame"}],"name":"pipeFrame","operating_system":["Linux","Mac","Windows"],"owner":"bioconductor_import","publication":[{"doi":"10.18129/B9.bioc.pipeFrame"}]},"bioschemas":{"name":"pipeFrame","home":"https://bio.tools/bioconductor-pipeframe","license":"GPL-3.0-only","version":"1.28.0","summary":"pipeFrame is an R package for building a componentized bioinformatics pipeline. Each step in this pipeline is wrapped in the framework, so the connection among steps is created seamlessly and automatically. Users could focus more on fine-tuning arguments rather than spending a lot of time on transforming file format, passing task outputs to task inputs or installing the dependencies. Componentized step elements can be customized into other new pipelines flexibly as well. This pipeline can be split into several important functional steps, so it is much easier for users to understand the complex arguments from each step rather than parameter combination from the whole pipeline. At the same time, componentized pipeline can restart at the breakpoint and avoid rerunning the whole pipeline, which may save a lot of time for users on pipeline tuning or such issues as power off or process other interrupts.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-pipeframe:1.0.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl":true,"ssl_err":null}}},{"@id":"https://openebench.bsc.es/monitor/metrics/bioconda:bioconductor-pipeframe:1.10.0/cmd/bioconductor.org","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"bioconda","@type":"metrics","distribution":{"packages":true,"sourcecode":{}},"project":{"build":{},"deployment":{},"license":{"open_source":false,"osi":false},"publications":[],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operational":200,"ssl"