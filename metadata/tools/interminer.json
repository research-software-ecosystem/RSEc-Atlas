{"tool_name":"interminer","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"interminer","home":"http://bioconductor.org/packages/release/bioc/html/InterMineR.html","license":"LGPL-2.0","summary":"Databases based on the InterMine platform such as FlyMine, modMine (modENCODE), RatMine, YeastMine, HumanMine and TargetMine are integrated databases of genomic, expression and protein data for various organisms. Integrating data makes it possible to run sophisticated data mining queries that span domains of biological knowledge.","addition_date":"2018-07-10T11:01:53Z","last_update_date":"2019-11-21T17:07:28Z","tool_type":["Library"],"version":["1.2.0"],"collections":["BioConductor","Proteomics"],"biotools_curie":"biotools:interminer","credit":[{"email":"j.sullivan@gen.cam.ac.uk","name":"InterMine Team","typeEntity":"Person","typeRole":["Primary contact"]}],"documentation":[{"type":["User manual"],"url":"http://bioconductor.org/packages/release/bioc/manuals/InterMineR/man/InterMineR.pdf"}],"edit_permission":{"authors":["proteomics.bio.tools","yoyehudi"],"type":"group"},"function":[{"operation":[{"term":"Comparison","uri":"http://edamontology.org/operation_2424"}]},{"operation":[{"term":"Differential gene expression analysis","uri":"http://edamontology.org/operation_3223"}]},{"operation":[{"term":"Gene-set enrichment analysis","uri":"http://edamontology.org/operation_2436"}]},{"operation":[{"term":"Genome annotation","uri":"http://edamontology.org/operation_0362"}]},{"operation":[{"term":"Visualisation","uri":"http://edamontology.org/operation_0337"}]}],"name":"InterMineR","operating_system":["Linux","Mac","Windows"],"owner":"InterMine","publication":[{"doi":"10.1093/bioinformatics/bts577","metadata":{"abstract":"InterMine is an open-source data warehouse system that facilitates the building of databases with complex data integration requirements and a need for a fast customizable query facility. Using InterMine, large biological databases can 