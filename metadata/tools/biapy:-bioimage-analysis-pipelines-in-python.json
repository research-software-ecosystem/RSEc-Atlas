{"tool_name":"biapy:-bioimage-analysis-pipelines-in-python","contents":["neubias"],"fetched_metadata":{"neubias":{"body":[{"format":"basic_html","processed":"<blockquote>\n<p><a href=\"https://github.com/danifranco/BiaPy\">BiaPy</a>&nbsp;is an open source Python library for building bioimage analysis pipelines.&nbsp;</p>\n\n<p>BiaPy contains ready-to-use solutions for the tasks of&nbsp;<a href=\"https://biapy.readthedocs.io/en/latest/workflows/semantic_segmentation.html\">semantic segmentation</a>,&nbsp;<a href=\"https://biapy.readthedocs.io/en/latest/workflows/instance_segmentation.html\">instance segmentation</a>,&nbsp;<a href=\"https://biapy.readthedocs.io/en/latest/workflows/detection.html\">object detection</a>,&nbsp;<a href=\"https://biapy.readthedocs.io/en/latest/workflows/denoising.html\">image denoising</a>,&nbsp;<a href=\"https://biapy.readthedocs.io/en/latest/workflows/super_resolution.html\">single image super-resolution</a>,&nbsp;<a href=\"https://biapy.readthedocs.io/en/latest/workflows/self_supervision.html\">self-supervised learning</a>&nbsp;and&nbsp;<a href=\"https://biapy.readthedocs.io/en/latest/workflows/classification.html\">image classification</a>.&nbsp;</p>\n</blockquote>","summary":"","value":"<blockquote>\r\n<p><a href=\"https://github.com/danifranco/BiaPy\">BiaPy</a>&nbsp;is an open source Python library for building bioimage analysis pipelines.&nbsp;</p>\r\n\r\n<p>BiaPy contains ready-to-use solutions for the tasks of&nbsp;<a href=\"https://biapy.readthedocs.io/en/latest/workflows/semantic_segmentation.html\">semantic segmentation</a>,&nbsp;<a href=\"https://biapy.readthedocs.io/en/latest/workflows/instance_segmentation.html\">instance segmentation</a>,&nbsp;<a href=\"https://biapy.readthedocs.io/en/latest/workflows/detection.html\">object detection</a>,&nbsp;<a href=\"https://biapy.readthedocs.io/en/latest/workflows/denoising.html\">image denoising</a>,&nbsp;<a href=\"https://biapy.readthedocs.io/en/latest/workflows/super_resolution.html\">single image super-resolution</a>,&nbsp;<a href=\"https://biapy.readthedocs.io/en/latest/workflows/self_supervision.html\">self-supervised learning</a>&nbsp;and&nbsp;<a href=\"https://biapy.readthedocs.io/en/latest/workflows/classification.html\">image classification</a>.&nbsp;</p>\r\n</blockquote>\r\n"}],"changed":[{"format":"Y-m-d\\TH:i:sP","value":"2023-05-12T16:14:54+00:00"}],"created":[{"format":"Y-m-d\\TH:i:sP","value":"2023-05-12T16:04:58+00:00"}],"default_langcode":[{"value":true}],"attribution_instructions":[],"comments_2023":[],"free_tagging":[{"target_id":4372,"target_type":"taxonomy_term","target_uuid":"564b5f0b-e429-40c8-acbc-2ee6bcb29616","url":"/taxonomy/term/4372"},{"target_id":4696,"target_type":"taxonomy_term","target_uuid":"919df718-05ee-4d3d-b875-ca42f5f4f363","url":"/taxonomy/term/4696"}],"give_feedback_on_this_soft":[{"cid":0,"comment_count":0,"last_comment_name":null,"last_comment_timestamp":1683907635,"last_comment_uid":19,"status":2}],"has_author":[{"value":"Daniel Franco-Barranco"}],"has_biological_terms":[{"target_id":4544,"target_type":"taxonomy_term","target_uuid":"ff21ffcf-acd8-456a-a737-5d3d14a25b1f","url":"/taxonomy/term/4544"}],"has_comparison":[],"has_documentation":[],"has_doi":[],"has_entry_curator":[{"target_id":19,"target_type":"user","target_uuid":"a8a58b02-2abc-4749-8aea-b9a6e7086874","url":"/user/19"}],"has_function":[{"target_id":4016,"target_type":"taxonomy_term","target_uuid":"http://edamontology.org/operation_Image_classification","url":"/image-classification"},{"target_id":4004,"target_type":"taxonomy_term","target_uuid":"http://edamontology.org/operation_Image_segmentation","url":"/image-segmentation"},{"target_id":4083,"target_type":"taxonomy_term","target_uuid":"http://edamontology.org/operation_Cell_segmentation","url":"/cell-segmentation"},{"target_id":4072,"target_type":"taxonomy_term","target_uuid":"http://edamontology.org/operation__RBNng13hEB0CJD5VzSKqrfB","url":"/object-detection"},{"target_id":4147,"target_