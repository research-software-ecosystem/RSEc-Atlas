{"tool_name":"mio","contents":["oeb","bioschemas","biotools"],"fetched_metadata":{"biotools":{"id":"mio","home":"https://mio.icbi.at","license":"MIT","summary":"MicroRNA target analysis system for Immuno-Oncology.","addition_date":"2022-09-05T22:23:48.734268Z","last_update_date":"2024-11-24T15:41:48.915523Z","tool_type":["Command-line tool","Web application"],"accessibility":"Open access","biotools_curie":"biotools:mio","cost":"Free of charge","credit":[{"email":"hubert.hackl@i-med.ac.at","name":"Hubert Hackl","orcidid":"https://orcid.org/0000-0003-4055-3841","typeEntity":"Person"},{"name":"Christoph Schatz"},{"name":"Dietmar Rieder"},{"name":"Leonie Madersbacher"}],"edit_permission":{"type":"private"},"function":[{"operation":[{"term":"Peptide immunogenicity prediction","uri":"http://edamontology.org/operation_0252"},{"term":"Regression analysis","uri":"http://edamontology.org/operation_3659"},{"term":"miRNA expression analysis","uri":"http://edamontology.org/operation_3792"},{"term":"miRNA target prediction","uri":"http://edamontology.org/operation_0463"}]}],"name":"MIO","operating_system":["Linux","Mac","Windows"],"owner":"Jennifer","publication":[{"doi":"10.1093/bioinformatics/btac366","metadata":{"abstract":"MicroRNAs have been shown to be able to modulate the tumor microenvironment and the immune response and hence could be interesting biomarkers and therapeutic targets in immuno-oncology; however, dedicated analysis tools are missing. Here, we present a user-friendly web platform MIO and a Python toolkit miopy integrating various methods for visualization and analysis of provided or custom bulk microRNA and gene expression data. We include regularized regression and survival analysis and provide information of 40 microRNA target prediction tools as well as a collection of curated immune related gene and microRNA signatures and processed TCGA data including estimations of infiltrated immune cells and the immunophenoscore. The integration of several machine learning methods enables the selection of prognostic and predictive microRNAs and gene interaction network biomarkers.","authors":[{"name":"Gronauer R."},{"name":"Hackl H."},{"name":"Madersbacher L."},{"name":"Monfort-Lanzas P."},{"name":"Rieder D."},{"name":"Schatz C."}],"citationCount":1,"date":"2022-07-15T00:00:00Z","journal":"Bioinformatics","title":"MIO: microRNA target analysis system for immuno-oncology"},"pmcid":"PMC9272810","pmid":"35642895"}],"topic":[{"term":"Biomarkers","uri":"http://edamontology.org/topic_3360"},{"term":"Functional, regulatory and non-coding RNA","uri":"http://edamontology.org/topic_0659"},{"term":"Gene expression","uri":"http://edamontology.org/topic_0203"},{"term":"Molecular interactions, pathways and networks","uri":"http://edamontology.org/topic_0602"},{"term":"Oncology","uri":"http://edamontology.org/topic_2640"}],"validated":1},"bioschemas":{"name":"MIO","home":"https://bio.tools/mio","license":"MIT","summary":"MicroRNA target analysis system for Immuno-Oncology.","tool_type":"sc:SoftwareApplication"},"oeb":{"metrics":[{"@id":"https://openebench.bsc.es/monitor/metrics/biotools:mio/cmd/mio.icbi.at","@license":"https://creativecommons.org/licenses/by/4.0/","@nmsp":"biotools","@type":"metrics","deprecated":true,"distribution":{"sourcecode":{"interpreted":true,"repository":{}}},"project":{"build":{},"deployment":{},"license":{"open_source":true,"osi":true},"publications":[{"entries":[{"cit_count":1,"citations":[{"count":1,"year":"2025"}],"doi":"10.1093/bioinformatics/btac366","pmcid":"PMC9272810","pmid":"35642895","ref_count":14,"refs":[{"count":1,"year":"2011"},{"count":1,"year":"2012"},{"count":1,"year":"2017"},{"count":1,"year":"2020"},{"count":1,"year":"2021"},{"count":1,"year":"2022"},{"count":4,"year":"2018"},{"count":4,"year":"2019"}],"title":"MIO: microRNA target analysis system for immuno-oncology.","year":2022}]}],"summary":{"description":true},"website":{"bioschemas":false,"copyright":false,"https":true,"license":false,"operat